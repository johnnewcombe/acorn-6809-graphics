                      (    demo/ants.asm):00001         ; ===========================================================================
                      (    demo/ants.asm):00002         ; Marching ants demo for the teletext graphics library
                      (    demo/ants.asm):00003         ;
                      (    demo/ants.asm):00004         ;   A small scene (a ball and a box) with:
                      (    demo/ants.asm):00005         ;     - a dashed box round it, in SET mode: on, on, off (the default
                      (    demo/ants.asm):00006         ;       pattern), so its gaps clear any pixels they cross - it cuts into
                      (    demo/ants.asm):00007         ;       the ball
                      (    demo/ants.asm):00008         ;     - a second box inside with a longer pattern: 4 on, 4 off
                      (    demo/ants.asm):00009         ;     - a diagonal dashed line across everything in XOR mode, marching the
                      (    demo/ants.asm):00010         ;       other way
                      (    demo/ants.asm):00011         ;   Each frame the phase moves on by one, so the dashes march: forwards
                      (    demo/ants.asm):00012         ;   along a line, clockwise round a box. Press any key to exit.
                      (    demo/ants.asm):00013         ;
                      (    demo/ants.asm):00014         ;   Loading: tgl.bin at $1000 (TGL_BASE below), ants.bin at $2800.
                      (    demo/ants.asm):00015         ;   Run from START ($2800). Works with either machine's library build.
                      (    demo/ants.asm):00016         ;
                      (    demo/ants.asm):00017         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      (    demo/ants.asm):00018         ; ===========================================================================
                      (    demo/ants.asm):00019         
     1000             (    demo/ants.asm):00020         TGL_BASE        EQU     $1000
                      (    demo/ants.asm):00021                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
     1048             (      tgl_api.inc):00033         TGL_SETDASH     EQU     TGL_BASE+72     ; dash: A = pattern, B = length, X = phase
     104B             (      tgl_api.inc):00034         TGL_LINED       EQU     TGL_BASE+75     ; dashed line: as TGL_LINEC
     104E             (      tgl_api.inc):00035         TGL_RECTD       EQU     TGL_BASE+78     ; dashed rectangle outline: as TGL_RECT
                      (      tgl_api.inc):00036         
     03C0             (      tgl_api.inc):00037         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00038         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00039         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00040         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00041         
                      (      tgl_api.inc):00042         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00043         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00044         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00045         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00046         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00047         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00048         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00049         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00050         
                      (      tgl_api.inc):00051         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00052         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00053         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00054         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00055         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00056         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00057         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00058         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00059         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00060         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (    demo/ants.asm):00022         
     3800             (    demo/ants.asm):00023         BUFFER          EQU     $3800           ; off-screen buffer (960 bytes)
     0200             (    demo/ants.asm):00024         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
     0003             (    demo/ants.asm):00025         PACE_TICKS      EQU     3               ; 3 = about 17 frames per second
                      (    demo/ants.asm):00026         
     0080             (    demo/ants.asm):00027         PHASE           EQU     $80             ; marching phase, counts up forever
                      (    demo/ants.asm):00028         
                      (    demo/ants.asm):00029                         ORG     $2800
                      (    demo/ants.asm):00030         
2800 10CE0200         (    demo/ants.asm):00031         START           LDS     #STACK_TOP
2804 4F               (    demo/ants.asm):00032                         CLRA                    ; DP = $00 for the library
2805 1F8B             (    demo/ants.asm):00033                         TFR     A,DP
     00               (    demo/ants.asm):00034                         SETDP   $00
2807 1CEF             (    demo/ants.asm):00035                         ANDCC   #$EF            ; IRQs on (keyboard)
2809 BD1000           (    demo/ants.asm):00036                         JSR     TGL_INIT
280C 8E3800           (    demo/ants.asm):00037                         LDX     #BUFFER
280F BD1003           (    demo/ants.asm):00038                         JSR     TGL_SETBUF
2812 0F80             (    demo/ants.asm):00039                         CLR     <PHASE
2814 4F               (    demo/ants.asm):00040                         CLRA                    ; status row title
2815 8E2895           (    demo/ants.asm):00041                         LDX     #TITLE
2818 BD1030           (    demo/ants.asm):00042                         JSR     TGL_TEXT
                      (    demo/ants.asm):00043         
                      (    demo/ants.asm):00044         ; ---------------------------------------------------------------------------
                      (    demo/ants.asm):00045         ; Main loop
                      (    demo/ants.asm):00046         ; ---------------------------------------------------------------------------
281B BD1006           (    demo/ants.asm):00047         FRAME           JSR     TGL_CLS
281E 8600             (    demo/ants.asm):00048                         LDA     #TGL_MODE_SET   ; the scene
2820 BD1009           (    demo/ants.asm):00049                         JSR     TGL_SETMODE
2823 8610             (    demo/ants.asm):00050                         LDA     #16             ; a ball, partly inside the ants box
2825 C61E             (    demo/ants.asm):00051                         LDB     #30
2827 8E000A           (    demo/ants.asm):00052                         LDX     #10
282A BD102D           (    demo/ants.asm):00053                         JSR     TGL_CIRCF
282D 862A             (    demo/ants.asm):00054                         LDA     #42             ; a box
282F C61A             (    demo/ants.asm):00055                         LDB     #26
2831 8E3C30           (    demo/ants.asm):00056                         LDX     #$3C30          ;  (42,26)-(60,48)
2834 BD1027           (    demo/ants.asm):00057                         JSR     TGL_RECTF
                      (    demo/ants.asm):00058         
                      (    demo/ants.asm):00059         ; Outer box: the default pattern (on, on, off), SET mode, so the gaps clear.
                      (    demo/ants.asm):00060         ; TGL_SETDASH: A = pattern, B = length, X = phase. Moving the phase on by
                      (    demo/ants.asm):00061         ; one each frame marches the dashes clockwise.
2837 D680             (    demo/ants.asm):00062                         LDB     <PHASE          ; X = phase (in the low byte)
2839 4F               (    demo/ants.asm):00063                         CLRA
283A 1F01             (    demo/ants.asm):00064                         TFR     D,X
283C 8603             (    demo/ants.asm):00065                         LDA     #%011           ; A = pattern, B = length
283E C603             (    demo/ants.asm):00066                         LDB     #3
2840 BD1048           (    demo/ants.asm):00067                         JSR     TGL_SETDASH
2843 8614             (    demo/ants.asm):00068                         LDA     #20             ; (20,10)-(70,60)
2845 C60A             (    demo/ants.asm):00069                         LDB     #10
2847 8E463C           (    demo/ants.asm):00070                         LDX     #$463C
284A BD104E           (    demo/ants.asm):00071                         JSR     TGL_RECTD
                      (    demo/ants.asm):00072         
                      (    demo/ants.asm):00073         ; Inner box: 4 on, 4 off
284D D680             (    demo/ants.asm):00074                         LDB     <PHASE
284F 4F               (    demo/ants.asm):00075                         CLRA
2850 1F01             (    demo/ants.asm):00076                         TFR     D,X
2852 860F             (    demo/ants.asm):00077                         LDA     #%00001111
2854 C608             (    demo/ants.asm):00078                         LDB     #8
2856 BD1048           (    demo/ants.asm):00079                         JSR     TGL_SETDASH
2859 8624             (    demo/ants.asm):00080                         LDA     #36             ; (36,20)-(64,52)
285B C614             (    demo/ants.asm):00081                         LDB     #20
285D 8E4034           (    demo/ants.asm):00082                         LDX     #$4034
2860 BD104E           (    demo/ants.asm):00083                         JSR     TGL_RECTD
                      (    demo/ants.asm):00084         
                      (    demo/ants.asm):00085         ; The diagonal, in XOR: its gaps are left alone, so it runs over the scene
                      (    demo/ants.asm):00086         ; without damaging it. Its phase counts down, so it marches the other way
                      (    demo/ants.asm):00087         ; (from its end back towards its start).
2863 8602             (    demo/ants.asm):00088                         LDA     #TGL_MODE_XOR
2865 BD1009           (    demo/ants.asm):00089                         JSR     TGL_SETMODE
2868 D680             (    demo/ants.asm):00090                         LDB     <PHASE          ; X = -phase (low byte): counting
286A 50               (    demo/ants.asm):00091                         NEGB                    ;  down marches the other way
286B 4F               (    demo/ants.asm):00092                         CLRA
286C 1F01             (    demo/ants.asm):00093                         TFR     D,X
286E 8603             (    demo/ants.asm):00094                         LDA     #%011
2870 C603             (    demo/ants.asm):00095                         LDB     #3
2872 BD1048           (    demo/ants.asm):00096                         JSR     TGL_SETDASH
2875 8602             (    demo/ants.asm):00097                         LDA     #2              ; (2,69) up to (75,2)
2877 C645             (    demo/ants.asm):00098                         LDB     #69
2879 8E4B02           (    demo/ants.asm):00099                         LDX     #$4B02
287C BD104B           (    demo/ants.asm):00100                         JSR     TGL_LINED
                      (    demo/ants.asm):00101         
287F 8603             (    demo/ants.asm):00102                         LDA     #PACE_TICKS
2881 BD103C           (    demo/ants.asm):00103                         JSR     TGL_PACE
2884 BD1012           (    demo/ants.asm):00104                         JSR     TGL_BLIT
2887 0C80             (    demo/ants.asm):00105                         INC     <PHASE          ; march on one pixel
2889 BD101E           (    demo/ants.asm):00106                         JSR     TGL_INKEY       ; any key exits
288C 1026E791         (    demo/ants.asm):00107                         LBNE    TGL_EXIT
                      (    demo/ants.asm):00108                         IFDEF   TESTFRAMES      ; test builds stop after n frames
                      (    demo/ants.asm):00109                         LDA     <PHASE
                      (    demo/ants.asm):00110                         CMPA    #TESTFRAMES
                      (    demo/ants.asm):00111                         BEQ     DONE
                      (    demo/ants.asm):00112                         ENDC
2890 16FF88           (    demo/ants.asm):00113                         LBRA    FRAME
2893 20FE             (    demo/ants.asm):00114         DONE            BRA     DONE
                      (    demo/ants.asm):00115         
                      (    demo/ants.asm):00116         ; Status row title. $83 yellow, $86 cyan text codes.
2895 83               (    demo/ants.asm):00117         TITLE           FCB     $83
2896 4D41524348494E47 (    demo/ants.asm):00118                         FCC     "MARCHING ANTS"
     20414E5453
28A3 86               (    demo/ants.asm):00119                         FCB     $86
28A4 414E59204B455920 (    demo/ants.asm):00120                         FCC     "ANY KEY EXITS"
     4558495453
28B1 00               (    demo/ants.asm):00121                         FCB     0

