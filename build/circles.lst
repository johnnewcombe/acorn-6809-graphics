                      ( demo/circles.asm):00001         ; ===========================================================================
                      ( demo/circles.asm):00002         ; Circles demo for the teletext graphics library
                      ( demo/circles.asm):00003         ;
                      ( demo/circles.asm):00004         ;   A filled ball bounces around the screen, sliding partly off the edges
                      ( demo/circles.asm):00005         ;   (showing the clipping), while rings ripple outwards from the centre.
                      ( demo/circles.asm):00006         ;   Everything is drawn in XOR mode, so the rings invert where they cross
                      ( demo/circles.asm):00007         ;   the ball. The screen is coloured in six rainbow bands that scroll slowly
                      ( demo/circles.asm):00008         ;   downwards, and the status row shows a coloured title.
                      ( demo/circles.asm):00009         ;   Press any key to exit.
                      ( demo/circles.asm):00010         ;
                      ( demo/circles.asm):00011         ;   Teletext colours whole rows: each row of character cells starts with a
                      ( demo/circles.asm):00012         ;   colour code, which the library keeps in column 0. TGL_COLOUR sets it
                      ( demo/circles.asm):00013         ;   for a band of rows and the library remembers it, so TGL_CLS keeps the
                      ( demo/circles.asm):00014         ;   colours from frame to frame. Changing colours costs no drawing time.
                      ( demo/circles.asm):00015         ;
                      ( demo/circles.asm):00016         ;   Circles are corrected for the teletext pixel shape (pixels are wider
                      ( demo/circles.asm):00017         ;   than they are tall), so they look round on screen even though they are
                      ( demo/circles.asm):00018         ;   narrower than they are tall in pixels.
                      ( demo/circles.asm):00019         ;
                      ( demo/circles.asm):00020         ;   Loading: tgl.bin at $1000 (TGL_BASE below), circles.bin at $2800.
                      ( demo/circles.asm):00021         ;   Run from START ($2800). Works with either machine's library build.
                      ( demo/circles.asm):00022         ;
                      ( demo/circles.asm):00023         ;   Circle calls: A,B = centre x,y (signed), X = radius (0-127).
                      ( demo/circles.asm):00024         ;
                      ( demo/circles.asm):00025         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      ( demo/circles.asm):00026         ; ===========================================================================
                      ( demo/circles.asm):00027         
     1000             ( demo/circles.asm):00028         TGL_BASE        EQU     $1000
                      ( demo/circles.asm):00029                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
     1048             (      tgl_api.inc):00033         TGL_SETDASH     EQU     TGL_BASE+72     ; dash: A = pattern, B = length, X = phase
     104B             (      tgl_api.inc):00034         TGL_LINED       EQU     TGL_BASE+75     ; dashed line: as TGL_LINEC
     104E             (      tgl_api.inc):00035         TGL_RECTD       EQU     TGL_BASE+78     ; dashed rectangle outline: as TGL_RECT
                      (      tgl_api.inc):00036         
     03C0             (      tgl_api.inc):00037         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00038         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00039         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00040         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00041         
                      (      tgl_api.inc):00042         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00043         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00044         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00045         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00046         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00047         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00048         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00049         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00050         
                      (      tgl_api.inc):00051         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00052         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00053         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00054         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00055         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00056         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00057         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00058         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00059         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00060         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      ( demo/circles.asm):00030         
     3800             ( demo/circles.asm):00031         BUFFER          EQU     $3800           ; off-screen buffer (960 bytes)
     0200             ( demo/circles.asm):00032         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      ( demo/circles.asm):00033         
     0026             ( demo/circles.asm):00034         CX              EQU     38              ; centre of the ripples
     0023             ( demo/circles.asm):00035         CY              EQU     35
     0003             ( demo/circles.asm):00036         NRINGS          EQU     3               ; rings on screen at once
     000C             ( demo/circles.asm):00037         RING_GAP        EQU     12              ; spacing between rings (pixels)
     0024             ( demo/circles.asm):00038         RING_MAX        EQU     NRINGS*RING_GAP ; a ring restarts at the centre here
                      ( demo/circles.asm):00039         
     0008             ( demo/circles.asm):00040         BALL_R          EQU     8               ; ball radius
     FFFA             ( demo/circles.asm):00041         BX_LO           EQU     -6              ; ball centre limits: a little beyond
     0053             ( demo/circles.asm):00042         BX_HI           EQU     83              ;  the screen edges, so the ball
     FFFA             ( demo/circles.asm):00043         BY_LO           EQU     -6              ;  slides partly out of view
     004D             ( demo/circles.asm):00044         BY_HI           EQU     77
                      ( demo/circles.asm):00045         
                      ( demo/circles.asm):00046         ; Page-zero variables (the library uses $00-$37)
     0080             ( demo/circles.asm):00047         BALLX           EQU     $80             ; ball centre (signed)
     0081             ( demo/circles.asm):00048         BALLY           EQU     $81
     0082             ( demo/circles.asm):00049         BALLDX          EQU     $82             ; ball velocity (signed)
     0083             ( demo/circles.asm):00050         BALLDY          EQU     $83
     0084             ( demo/circles.asm):00051         PHASE           EQU     $84             ; ripple phase, 0 .. RING_GAP-1
     0085             ( demo/circles.asm):00052         RING            EQU     $85             ; radius of the ring being drawn
     0086             ( demo/circles.asm):00053         FRAMES          EQU     $86             ; frame counter (test builds)
     0087             ( demo/circles.asm):00054         SHIFT           EQU     $87             ; rainbow position, 0-5
     0088             ( demo/circles.asm):00055         CYC             EQU     $88             ; frames until the rainbow moves
     0089             ( demo/circles.asm):00056         BAND            EQU     $89             ; band being coloured, 0-5
                      ( demo/circles.asm):00057         
     0006             ( demo/circles.asm):00058         NBANDS          EQU     6               ; six bands of four rows = 24 rows
     0004             ( demo/circles.asm):00059         CYCLE           EQU     4               ; frames between rainbow moves
