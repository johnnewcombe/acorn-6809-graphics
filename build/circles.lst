                      ( demo/circles.asm):00001         ; ===========================================================================
                      ( demo/circles.asm):00002         ; Circles demo for the teletext graphics library
                      ( demo/circles.asm):00003         ;
                      ( demo/circles.asm):00004         ;   A filled ball bounces around the screen, sliding partly off the edges
                      ( demo/circles.asm):00005         ;   (showing the clipping), while rings ripple outwards from the centre.
                      ( demo/circles.asm):00006         ;   Everything is drawn in XOR mode, so the rings invert where they cross
                      ( demo/circles.asm):00007         ;   the ball. Press any key to exit.
                      ( demo/circles.asm):00008         ;
                      ( demo/circles.asm):00009         ;   Circles are corrected for the teletext pixel shape (pixels are wider
                      ( demo/circles.asm):00010         ;   than they are tall), so they look round on screen even though they are
                      ( demo/circles.asm):00011         ;   narrower than they are tall in pixels.
                      ( demo/circles.asm):00012         ;
                      ( demo/circles.asm):00013         ;   Loading: tgl.bin at $1000 (TGL_BASE below), circles.bin at $2000.
                      ( demo/circles.asm):00014         ;   Run from START ($2000). Works with either machine's library build.
                      ( demo/circles.asm):00015         ;
                      ( demo/circles.asm):00016         ;   Circle calls: A,B = centre x,y (signed), X = radius (0-127).
                      ( demo/circles.asm):00017         ;
                      ( demo/circles.asm):00018         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      ( demo/circles.asm):00019         ; ===========================================================================
                      ( demo/circles.asm):00020         
     1000             ( demo/circles.asm):00021         TGL_BASE        EQU     $1000
                      ( demo/circles.asm):00022                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
                      (      tgl_api.inc):00028         
     03C0             (      tgl_api.inc):00029         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00030         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00031         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00032         TGL_MODE_XOR    EQU     2
                      ( demo/circles.asm):00023         
     3000             ( demo/circles.asm):00024         BUFFER          EQU     $3000           ; off-screen buffer (960 bytes)
     0200             ( demo/circles.asm):00025         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      ( demo/circles.asm):00026         
     0026             ( demo/circles.asm):00027         CX              EQU     38              ; centre of the ripples
     0023             ( demo/circles.asm):00028         CY              EQU     35
     0003             ( demo/circles.asm):00029         NRINGS          EQU     3               ; rings on screen at once
     000C             ( demo/circles.asm):00030         RING_GAP        EQU     12              ; spacing between rings (pixels)
     0024             ( demo/circles.asm):00031         RING_MAX        EQU     NRINGS*RING_GAP ; a ring restarts at the centre here
                      ( demo/circles.asm):00032         
     0008             ( demo/circles.asm):00033         BALL_R          EQU     8               ; ball radius
     FFFA             ( demo/circles.asm):00034         BX_LO           EQU     -6              ; ball centre limits: a little beyond
     0053             ( demo/circles.asm):00035         BX_HI           EQU     83              ;  the screen edges, so the ball
     FFFA             ( demo/circles.asm):00036         BY_LO           EQU     -6              ;  slides partly out of view
     004D             ( demo/circles.asm):00037         BY_HI           EQU     77
                      ( demo/circles.asm):00038         
                      ( demo/circles.asm):00039         ; Page-zero variables (the library uses $00-$37)
     0080             ( demo/circles.asm):00040         BALLX           EQU     $80             ; ball centre (signed)
     0081             ( demo/circles.asm):00041         BALLY           EQU     $81
     0082             ( demo/circles.asm):00042         BALLDX          EQU     $82             ; ball velocity (signed)
     0083             ( demo/circles.asm):00043         BALLDY          EQU     $83
     0084             ( demo/circles.asm):00044         PHASE           EQU     $84             ; ripple phase, 0 .. RING_GAP-1
     0085             ( demo/circles.asm):00045         RING            EQU     $85             ; radius of the ring being drawn
     0086             ( demo/circles.asm):00046         FRAMES          EQU     $86             ; frame counter (test builds)
                      ( demo/circles.asm):00047         
                      ( demo/circles.asm):00048                         ORG     $2000
                      ( demo/circles.asm):00049         
2000 10CE0200         ( demo/circles.asm):00050         START           LDS     #STACK_TOP
2004 4F               ( demo/circles.asm):00051                         CLRA                    ; DP = $00 for the library
2005 1F8B             ( demo/circles.asm):00052                         TFR     A,DP
     00               ( demo/circles.asm):00053                         SETDP   $00
2007 1CEF             ( demo/circles.asm):00054                         ANDCC   #$EF            ; IRQs on (keyboard)
2009 BD1000           ( demo/circles.asm):00055                         JSR     TGL_INIT
200C 8E3000           ( demo/circles.asm):00056                         LDX     #BUFFER
200F BD1003           ( demo/circles.asm):00057                         JSR     TGL_SETBUF
2012 8602             ( demo/circles.asm):00058                         LDA     #TGL_MODE_XOR   ; everything is drawn in XOR
2014 BD1009           ( demo/circles.asm):00059                         JSR     TGL_SETMODE
2017 CC1410           ( demo/circles.asm):00060                         LDD     #$1410          ; ball starts at (20,16) ...
201A DD80             ( demo/circles.asm):00061                         STD     <BALLX
201C CC0201           ( demo/circles.asm):00062                         LDD     #$0201          ; ... moving right 2, down 1
201F DD82             ( demo/circles.asm):00063                         STD     <BALLDX
2021 0F84             ( demo/circles.asm):00064                         CLR     <PHASE
2023 0F86             ( demo/circles.asm):00065                         CLR     <FRAMES
                      ( demo/circles.asm):00066         
                      ( demo/circles.asm):00067         ; ---------------------------------------------------------------------------
                      ( demo/circles.asm):00068         ; Main loop
                      ( demo/circles.asm):00069         ; ---------------------------------------------------------------------------
2025 BD1006           ( demo/circles.asm):00070         FRAME           JSR     TGL_CLS
                      ( demo/circles.asm):00071         
                      ( demo/circles.asm):00072         ; The ball: move it (bouncing off the limits), then draw it filled
2028 9680             ( demo/circles.asm):00073                         LDA     <BALLX          ; new x = x + dx
202A 9B82             ( demo/circles.asm):00074                         ADDA    <BALLDX
202C 81FA             ( demo/circles.asm):00075                         CMPA    #BX_LO          ; outside the limits? (signed, as
202E 2D04             ( demo/circles.asm):00076                         BLT     BL_XF           ;  the centre can go negative)
2030 8153             ( demo/circles.asm):00077                         CMPA    #BX_HI
2032 2F06             ( demo/circles.asm):00078                         BLE     BL_XOK
2034 0082             ( demo/circles.asm):00079         BL_XF           NEG     <BALLDX         ; bounce: reverse, move the other way
2036 9680             ( demo/circles.asm):00080                         LDA     <BALLX
2038 9B82             ( demo/circles.asm):00081                         ADDA    <BALLDX
203A 9780             ( demo/circles.asm):00082         BL_XOK          STA     <BALLX
203C 9681             ( demo/circles.asm):00083                         LDA     <BALLY          ; the same for y
203E 9B83             ( demo/circles.asm):00084                         ADDA    <BALLDY
2040 81FA             ( demo/circles.asm):00085                         CMPA    #BY_LO
2042 2D04             ( demo/circles.asm):00086                         BLT     BL_YF
2044 814D             ( demo/circles.asm):00087                         CMPA    #BY_HI
2046 2F06             ( demo/circles.asm):00088                         BLE     BL_YOK
2048 0083             ( demo/circles.asm):00089         BL_YF           NEG     <BALLDY
204A 9681             ( demo/circles.asm):00090                         LDA     <BALLY
204C 9B83             ( demo/circles.asm):00091                         ADDA    <BALLDY
204E 9781             ( demo/circles.asm):00092         BL_YOK          STA     <BALLY
2050 9680             ( demo/circles.asm):00093                         LDA     <BALLX          ; A,B = centre
2052 D681             ( demo/circles.asm):00094                         LDB     <BALLY
2054 8E0008           ( demo/circles.asm):00095                         LDX     #BALL_R         ; X = radius
2057 BD102D           ( demo/circles.asm):00096                         JSR     TGL_CIRCF
                      ( demo/circles.asm):00097         
                      ( demo/circles.asm):00098         ; The rings: radii PHASE, PHASE+GAP, PHASE+2*GAP. As PHASE counts up to
                      ( demo/circles.asm):00099         ; GAP-1 and wraps to 0, every ring grows by one pixel per frame, and the
                      ( demo/circles.asm):00100         ; outermost one reappears at the centre - so the rings seem to ripple
                      ( demo/circles.asm):00101         ; outwards for ever.
205A 9684             ( demo/circles.asm):00102                         LDA     <PHASE
205C 9785             ( demo/circles.asm):00103                         STA     <RING
205E 4F               ( demo/circles.asm):00104         RG_LOOP         CLRA                    ; X = radius: D = 0:RING, then
205F D685             ( demo/circles.asm):00105                         LDB     <RING           ;  copied to X
2061 1F01             ( demo/circles.asm):00106                         TFR     D,X
2063 8626             ( demo/circles.asm):00107                         LDA     #CX             ; A,B = centre
2065 C623             ( demo/circles.asm):00108                         LDB     #CY
2067 BD102A           ( demo/circles.asm):00109                         JSR     TGL_CIRC
206A 9685             ( demo/circles.asm):00110                         LDA     <RING           ; next ring out
206C 8B0C             ( demo/circles.asm):00111                         ADDA    #RING_GAP
206E 9785             ( demo/circles.asm):00112                         STA     <RING
2070 8124             ( demo/circles.asm):00113                         CMPA    #RING_MAX
2072 25EA             ( demo/circles.asm):00114                         BLO     RG_LOOP
                      ( demo/circles.asm):00115         
2074 9684             ( demo/circles.asm):00116                         LDA     <PHASE          ; advance the ripple
2076 4C               ( demo/circles.asm):00117                         INCA
2077 810C             ( demo/circles.asm):00118                         CMPA    #RING_GAP
2079 2501             ( demo/circles.asm):00119                         BLO     PH_OK
207B 4F               ( demo/circles.asm):00120                         CLRA
207C 9784             ( demo/circles.asm):00121         PH_OK           STA     <PHASE
                      ( demo/circles.asm):00122         
207E BD1012           ( demo/circles.asm):00123                         JSR     TGL_BLIT        ; show the frame
2081 BD101E           ( demo/circles.asm):00124                         JSR     TGL_INKEY       ; any key exits
2084 1026EF99         ( demo/circles.asm):00125                         LBNE    TGL_EXIT
                      ( demo/circles.asm):00126                         IFDEF   TESTFRAMES
                      ( demo/circles.asm):00127                         INC     <FRAMES
                      ( demo/circles.asm):00128                         LDA     <FRAMES
                      ( demo/circles.asm):00129                         CMPA    #TESTFRAMES
                      ( demo/circles.asm):00130                         BEQ     DONE
                      ( demo/circles.asm):00131                         ENDC
2088 16FF9A           ( demo/circles.asm):00132                         LBRA    FRAME
208B 20FE             ( demo/circles.asm):00133         DONE            BRA     DONE

