                      ( demo/circles.asm):00117         ; The rings: radii PHASE, PHASE+GAP, PHASE+2*GAP. As PHASE counts up to
                      ( demo/circles.asm):00118         ; GAP-1 and wraps to 0, every ring grows by one pixel per frame, and the
                      ( demo/circles.asm):00119         ; outermost one reappears at the centre - so the rings seem to ripple
                      ( demo/circles.asm):00120         ; outwards for ever.
2867 9684             ( demo/circles.asm):00121                         LDA     <PHASE
2869 9785             ( demo/circles.asm):00122                         STA     <RING
286B 4F               ( demo/circles.asm):00123         RG_LOOP         CLRA                    ; X = radius: D = 0:RING, then
286C D685             ( demo/circles.asm):00124                         LDB     <RING           ;  copied to X
286E 1F01             ( demo/circles.asm):00125                         TFR     D,X
2870 8626             ( demo/circles.asm):00126                         LDA     #CX             ; A,B = centre
2872 C623             ( demo/circles.asm):00127                         LDB     #CY
2874 BD102A           ( demo/circles.asm):00128                         JSR     TGL_CIRC
2877 9685             ( demo/circles.asm):00129                         LDA     <RING           ; next ring out
2879 8B0C             ( demo/circles.asm):00130                         ADDA    #RING_GAP
287B 9785             ( demo/circles.asm):00131                         STA     <RING
287D 8124             ( demo/circles.asm):00132                         CMPA    #RING_MAX
287F 25EA             ( demo/circles.asm):00133                         BLO     RG_LOOP
                      ( demo/circles.asm):00134         
2881 9684             ( demo/circles.asm):00135                         LDA     <PHASE          ; advance the ripple
2883 4C               ( demo/circles.asm):00136                         INCA
2884 810C             ( demo/circles.asm):00137                         CMPA    #RING_GAP
2886 2501             ( demo/circles.asm):00138                         BLO     PH_OK
2888 4F               ( demo/circles.asm):00139                         CLRA
2889 9784             ( demo/circles.asm):00140         PH_OK           STA     <PHASE
                      ( demo/circles.asm):00141         
                      ( demo/circles.asm):00142         ; The rainbow. Every CYCLE frames each band takes the colour of the band
                      ( demo/circles.asm):00143         ; above it, so the colours scroll downwards. Band b (rows 4b to 4b+3) gets
                      ( demo/circles.asm):00144         ; RAINBOW[(b - SHIFT) mod 6]. The library remembers row colours, so this
                      ( demo/circles.asm):00145         ; only needs doing when they change.
288B 0A88             ( demo/circles.asm):00146                         DEC     <CYC
288D 2634             ( demo/circles.asm):00147                         BNE     RB_DONE
288F 8604             ( demo/circles.asm):00148                         LDA     #CYCLE
2891 9788             ( demo/circles.asm):00149                         STA     <CYC
2893 0F89             ( demo/circles.asm):00150                         CLR     <BAND
2895 9689             ( demo/circles.asm):00151         RB_LOOP         LDA     <BAND           ; colour index = (band - shift) mod 6
2897 9087             ( demo/circles.asm):00152                         SUBA    <SHIFT
2899 2A02             ( demo/circles.asm):00153                         BPL     RB_1
289B 8B06             ( demo/circles.asm):00154                         ADDA    #NBANDS
289D 308D0031         ( demo/circles.asm):00155         RB_1            LEAX    RAINBOW,PCR     ; B = colour for this band
28A1 E686             ( demo/circles.asm):00156                         LDB     A,X
28A3 4F               ( demo/circles.asm):00157                         CLRA                    ; X = colour
28A4 1F01             ( demo/circles.asm):00158                         TFR     D,X
28A6 9689             ( demo/circles.asm):00159                         LDA     <BAND           ; A = first row = band * 4
28A8 48               ( demo/circles.asm):00160                         ASLA
28A9 48               ( demo/circles.asm):00161                         ASLA
28AA 1F89             ( demo/circles.asm):00162                         TFR     A,B             ; B = last row = first + 3
28AC CB03             ( demo/circles.asm):00163                         ADDB    #3
28AE BD1039           ( demo/circles.asm):00164                         JSR     TGL_COLOUR
28B1 0C89             ( demo/circles.asm):00165                         INC     <BAND
28B3 9689             ( demo/circles.asm):00166                         LDA     <BAND
28B5 8106             ( demo/circles.asm):00167                         CMPA    #NBANDS
28B7 25DC             ( demo/circles.asm):00168                         BLO     RB_LOOP
28B9 9687             ( demo/circles.asm):00169                         LDA     <SHIFT          ; move the rainbow on for next time
28BB 4C               ( demo/circles.asm):00170                         INCA
28BC 8106             ( demo/circles.asm):00171                         CMPA    #NBANDS
28BE 2501             ( demo/circles.asm):00172                         BLO     RB_2
