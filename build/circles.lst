                      ( demo/circles.asm):00091         ; The ball: move it (bouncing off the limits), then draw it filled
2835 9680             ( demo/circles.asm):00092                         LDA     <BALLX          ; new x = x + dx
2837 9B82             ( demo/circles.asm):00093                         ADDA    <BALLDX
2839 81FA             ( demo/circles.asm):00094                         CMPA    #BX_LO          ; outside the limits? (signed, as
283B 2D04             ( demo/circles.asm):00095                         BLT     BL_XF           ;  the centre can go negative)
283D 8153             ( demo/circles.asm):00096                         CMPA    #BX_HI
283F 2F06             ( demo/circles.asm):00097                         BLE     BL_XOK
2841 0082             ( demo/circles.asm):00098         BL_XF           NEG     <BALLDX         ; bounce: reverse, move the other way
2843 9680             ( demo/circles.asm):00099                         LDA     <BALLX
2845 9B82             ( demo/circles.asm):00100                         ADDA    <BALLDX
2847 9780             ( demo/circles.asm):00101         BL_XOK          STA     <BALLX
2849 9681             ( demo/circles.asm):00102                         LDA     <BALLY          ; the same for y
284B 9B83             ( demo/circles.asm):00103                         ADDA    <BALLDY
284D 81FA             ( demo/circles.asm):00104                         CMPA    #BY_LO
284F 2D04             ( demo/circles.asm):00105                         BLT     BL_YF
2851 814D             ( demo/circles.asm):00106                         CMPA    #BY_HI
2853 2F06             ( demo/circles.asm):00107                         BLE     BL_YOK
2855 0083             ( demo/circles.asm):00108         BL_YF           NEG     <BALLDY
2857 9681             ( demo/circles.asm):00109                         LDA     <BALLY
2859 9B83             ( demo/circles.asm):00110                         ADDA    <BALLDY
285B 9781             ( demo/circles.asm):00111         BL_YOK          STA     <BALLY
285D 9680             ( demo/circles.asm):00112                         LDA     <BALLX          ; A,B = centre
285F D681             ( demo/circles.asm):00113                         LDB     <BALLY
