                      (    cube_core.asm):00311         ; VSUM - one rotated coordinate of one corner
                      (    cube_core.asm):00312         ;   Entry: U -> the three terms for this coordinate (TX, TY or TZ)
                      (    cube_core.asm):00313         ;          B = corner number: bit 0 set means x = +S, clear means x = -S;
                      (    cube_core.asm):00314         ;              bit 1 likewise for y, bit 2 for z
                      (    cube_core.asm):00315         ;   Exit:  A = term0 * (+/-1) + term1 * (+/-1) + term2 * (+/-1)
                      (    cube_core.asm):00316         ;          B preserved (so the caller can reuse it for the next coordinate)
                      (    cube_core.asm):00317         ; ---------------------------------------------------------------------------
2A2B 4F               (    cube_core.asm):00318         VSUM            CLRA                    ; running total
2A2C C501             (    cube_core.asm):00319                         BITB    #1              ; x sign: add or subtract term 0
2A2E 2704             (    cube_core.asm):00320                         BEQ     VS_1
2A30 ABC4             (    cube_core.asm):00321                         ADDA    ,U
2A32 2002             (    cube_core.asm):00322                         BRA     VS_2
2A34 A0C4             (    cube_core.asm):00323         VS_1            SUBA    ,U
2A36 C502             (    cube_core.asm):00324         VS_2            BITB    #2              ; y sign: term 1
2A38 2704             (    cube_core.asm):00325                         BEQ     VS_3
2A3A AB41             (    cube_core.asm):00326                         ADDA    1,U
2A3C 2002             (    cube_core.asm):00327                         BRA     VS_4
2A3E A041             (    cube_core.asm):00328         VS_3            SUBA    1,U
2A40 C504             (    cube_core.asm):00329         VS_4            BITB    #4              ; z sign: term 2
2A42 2703             (    cube_core.asm):00330                         BEQ     VS_5
2A44 AB42             (    cube_core.asm):00331                         ADDA    2,U
2A46 39               (    cube_core.asm):00332                         RTS
2A47 A042             (    cube_core.asm):00333         VS_5            SUBA    2,U
2A49 39               (    cube_core.asm):00334                         RTS
                      (    cube_core.asm):00335         
                      (    cube_core.asm):00336         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00337         ; PMUL - projection multiply: A = (A * B) / 128
                      (    cube_core.asm):00338         ;   Entry: A = coordinate (signed), B = scale from RXTAB/RYTAB (unsigned)
                      (    cube_core.asm):00339         ;   Exit:  A = result. B corrupted.
                      (    cube_core.asm):00340         ;
                      (    cube_core.asm):00341         ;   Like MULS7, but only A can be negative, so: make A positive, MUL,
                      (    cube_core.asm):00342         ;   divide by 128 the same way (ASLB/ROLA leaves D/128 in A), and negate
                      (    cube_core.asm):00343         ;   the answer if A was negative.
                      (    cube_core.asm):00344         ; ---------------------------------------------------------------------------
2A4A 4D               (    cube_core.asm):00345         PMUL            TSTA
2A4B 2A06             (    cube_core.asm):00346                         BPL     PM_1
2A4D 40               (    cube_core.asm):00347                         NEGA                    ; negative coordinate:
2A4E 3D               (    cube_core.asm):00348                         MUL                     ;  |A| * B
2A4F 58               (    cube_core.asm):00349                         ASLB                    ;  / 128
2A50 49               (    cube_core.asm):00350                         ROLA
2A51 40               (    cube_core.asm):00351                         NEGA                    ;  and make it negative again
2A52 39               (    cube_core.asm):00352                         RTS
2A53 3D               (    cube_core.asm):00353         PM_1            MUL                     ; positive coordinate: A * B
2A54 58               (    cube_core.asm):00354                         ASLB                    ;  / 128
2A55 49               (    cube_core.asm):00355                         ROLA
2A56 39               (    cube_core.asm):00356                         RTS
                      (    cube_core.asm):00357         
                      (    cube_core.asm):00358         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00359         ; EDGES - draw the 12 edges
                      (    cube_core.asm):00360         ;
                      (    cube_core.asm):00361         ;   EDGETAB lists the 12 edges as pairs of corner numbers. For each pair,
                      (    cube_core.asm):00362         ;   look up both corners' screen positions in PX/PY and draw a line.
                      (    cube_core.asm):00363         ;   TGL_LINEC (the clipped line) is used because, when the cube is zoomed
                      (    cube_core.asm):00364         ;   right in, some corners land off the screen.
                      (    cube_core.asm):00365         ;
                      (    cube_core.asm):00366         ;   Y walks through EDGETAB four bytes at a time: 0,Y is the start corner,
                      (    cube_core.asm):00367         ;   1,Y the end corner, and 2,Y and 3,Y the two faces the edge borders.
                      (    cube_core.asm):00368         ;   Unless WIRE is set (draw every edge), an edge is skipped if both its
                      (    cube_core.asm):00369         ;   faces are hidden. Edges use the current plot mode.
                      (    cube_core.asm):00370         ; ---------------------------------------------------------------------------
2A57 318D003C         (    cube_core.asm):00371         EDGES           LEAY    EDGETAB,PCR
2A5B 860C             (    cube_core.asm):00372                         LDA     #12             ; 12 edges to draw
2A5D 9792             (    cube_core.asm):00373                         STA     <EC
2A5F 0D99             (    cube_core.asm):00374         ED_LOOP         TST     <WIRE           ; wireframe: draw every edge
2A61 2612             (    cube_core.asm):00375                         BNE     ED_DRAW
2A63 8E00B0           (    cube_core.asm):00376                         LDX     #VIS            ; skip the edge unless one of its
2A66 E622             (    cube_core.asm):00377                         LDB     2,Y             ;  faces is visible
2A68 3A               (    cube_core.asm):00378                         ABX
2A69 A684             (    cube_core.asm):00379                         LDA     ,X
2A6B 8E00B0           (    cube_core.asm):00380                         LDX     #VIS
2A6E E623             (    cube_core.asm):00381                         LDB     3,Y
2A70 3A               (    cube_core.asm):00382                         ABX
2A71 AA84             (    cube_core.asm):00383                         ORA     ,X
2A73 271B             (    cube_core.asm):00384                         BEQ     ED_NEXT
2A75 8E00A0           (    cube_core.asm):00385         ED_DRAW         LDX     #PX             ; end corner's position -> U
2A78 E621             (    cube_core.asm):00386                         LDB     1,Y             ;  X -> PX + end corner
2A7A 3A               (    cube_core.asm):00387                         ABX
2A7B A684             (    cube_core.asm):00388                         LDA     ,X              ;  A = its x
2A7D E608             (    cube_core.asm):00389                         LDB     8,X             ;  B = its y (PY = PX + 8)
2A7F 1F03             (    cube_core.asm):00390                         TFR     D,U             ;  park x1:y1 in U for now
2A81 8E00A0           (    cube_core.asm):00391                         LDX     #PX             ; start corner's position -> A, B
2A84 E6A4             (    cube_core.asm):00392                         LDB     ,Y
2A86 3A               (    cube_core.asm):00393                         ABX
2A87 A684             (    cube_core.asm):00394                         LDA     ,X              ;  A = x0
2A89 E608             (    cube_core.asm):00395                         LDB     8,X             ;  B = y0
2A8B 1F31             (    cube_core.asm):00396                         TFR     U,X             ; X = x1:y1, the packed end point
2A8D BD1018           (    cube_core.asm):00397                         JSR     TGL_LINEC
2A90 3124             (    cube_core.asm):00398         ED_NEXT         LEAY    4,Y             ; next edge
2A92 0A92             (    cube_core.asm):00399                         DEC     <EC
2A94 26C9             (    cube_core.asm):00400                         BNE     ED_LOOP
2A96 39               (    cube_core.asm):00401                         RTS
                      (    cube_core.asm):00402         
                      (    cube_core.asm):00403         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00404         ; The 12 edges: start corner, end corner, and the two faces the edge
                      (    cube_core.asm):00405         ; borders (0 +x, 1 -x, 2 +y, 3 -y, 4 +z, 5 -z). The two corners differ in
                      (    cube_core.asm):00406         ; one bit, so the edge runs along that axis; its faces come from the other
                      (    cube_core.asm):00407         ; two bits (bit set: the + face, clear: the - face).
                      (    cube_core.asm):00408         ; ---------------------------------------------------------------------------
2A97                  (    cube_core.asm):00409         EDGETAB
2A97 00010305         (    cube_core.asm):00410                         FCB     0,1,3,5         ; along x: faces -y, -z
2A9B 02030205         (    cube_core.asm):00411                         FCB     2,3,2,5         ; along x: faces +y, -z
2A9F 04050304         (    cube_core.asm):00412                         FCB     4,5,3,4         ; along x: faces -y, +z
2AA3 06070204         (    cube_core.asm):00413                         FCB     6,7,2,4         ; along x: faces +y, +z
2AA7 00020105         (    cube_core.asm):00414                         FCB     0,2,1,5         ; along y: faces -x, -z
2AAB 01030005         (    cube_core.asm):00415                         FCB     1,3,0,5         ; along y: faces +x, -z
2AAF 04060104         (    cube_core.asm):00416                         FCB     4,6,1,4         ; along y: faces -x, +z
2AB3 05070004         (    cube_core.asm):00417                         FCB     5,7,0,4         ; along y: faces +x, +z
2AB7 00040103         (    cube_core.asm):00418                         FCB     0,4,1,3         ; along z: faces -x, -y
2ABB 01050003         (    cube_core.asm):00419                         FCB     1,5,0,3         ; along z: faces +x, -y
2ABF 02060102         (    cube_core.asm):00420                         FCB     2,6,1,2         ; along z: faces -x, +y
2AC3 03070002         (    cube_core.asm):00421                         FCB     3,7,0,2         ; along z: faces +x, +y
