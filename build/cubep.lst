                      (   demo/cubep.asm):00001         ; ===========================================================================
                      (   demo/cubep.asm):00002         ; Patterned cube demo for the teletext graphics library
                      (   demo/cubep.asm):00003         ;
                      (   demo/cubep.asm):00004         ;   The tumbling, zooming cube from cube.asm, drawn as a solid object: each
                      (   demo/cubep.asm):00005         ;   visible face is filled with its own pattern (TGL_POLYF and TGL_SETPAT),
                      (   demo/cubep.asm):00006         ;   so you can follow the faces round as it turns, with the edges drawn on
                      (   demo/cubep.asm):00007         ;   top. Press any key to exit.
                      (   demo/cubep.asm):00008         ;
                      (   demo/cubep.asm):00009         ;   Loading: tgl.bin at $1000, cubep.bin at $2800. Run from START ($2800).
                      (   demo/cubep.asm):00010         ;
                      (   demo/cubep.asm):00011         ;   Shares its code with cube.asm (see there for the list): the face
                      (   demo/cubep.asm):00012         ;   filling is in cube_fill.asm, the rest in cube_core.asm.
                      (   demo/cubep.asm):00013         ;
                      (   demo/cubep.asm):00014         ;   Each frame is as cube.asm's, with one addition: after working out which
                      (   demo/cubep.asm):00015         ;   faces can be seen, FILLS fills each visible face with its pattern from
                      (   demo/cubep.asm):00016         ;   FACEPAT, before the edges are drawn.
                      (   demo/cubep.asm):00017         ;
                      (   demo/cubep.asm):00018         ;   The patterns are fixed to the screen, not the faces: a face slides
                      (   demo/cubep.asm):00019         ;   across its pattern as it turns. (cubed.asm draws marks that turn with
                      (   demo/cubep.asm):00020         ;   the faces instead.)
                      (   demo/cubep.asm):00021         ;
                      (   demo/cubep.asm):00022         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      (   demo/cubep.asm):00023         ; ===========================================================================
                      (   demo/cubep.asm):00024                         INCLUDE "cube_defs.inc"
                      (    cube_defs.inc):00001         ; ===========================================================================
                      (    cube_defs.inc):00002         ; cube_defs.inc - settings and variables shared by the cube demos
                      (    cube_defs.inc):00003         ;   (cube.asm, cubep.asm, cubed.asm). Included at the top of each.
                      (    cube_defs.inc):00004         ; ===========================================================================
                      (    cube_defs.inc):00005         
                      (    cube_defs.inc):00006         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00007         ; Library entry points (see tgl_api.inc)
                      (    cube_defs.inc):00008         ; ---------------------------------------------------------------------------
     1000             (    cube_defs.inc):00009         TGL_BASE        EQU     $1000
                      (    cube_defs.inc):00010                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
                      (      tgl_api.inc):00033         
     03C0             (      tgl_api.inc):00034         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00035         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00036         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00037         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00038         
                      (      tgl_api.inc):00039         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00040         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00041         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00042         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00043         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00044         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00045         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00046         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00047         
                      (      tgl_api.inc):00048         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00049         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00050         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00051         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00052         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00053         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00054         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00055         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00056         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00057         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (    cube_defs.inc):00011         
                      (    cube_defs.inc):00012         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00013         ; Memory
                      (    cube_defs.inc):00014         ; ---------------------------------------------------------------------------
     3800             (    cube_defs.inc):00015         BUFFER          EQU     $3800           ; off-screen buffer (960 bytes)
     0200             (    cube_defs.inc):00016         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    cube_defs.inc):00017         
                      (    cube_defs.inc):00018         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00019         ; Settings you can change
                      (    cube_defs.inc):00020         ; ---------------------------------------------------------------------------
     0015             (    cube_defs.inc):00021         SIZE_MID        EQU     21              ; middle of the zoom range; the half
                      (    cube_defs.inc):00022                                                 ;  edge length pulses 5..36 around it
     0027             (    cube_defs.inc):00023         CX              EQU     39              ; screen position of the cube's centre
     0024             (    cube_defs.inc):00024         CY              EQU     36
     0002             (    cube_defs.inc):00025         STEP_A          EQU     2               ; rotation speed about x (per frame,
     0003             (    cube_defs.inc):00026         STEP_B          EQU     3               ;  and about y; 256 = a full turn)
     0001             (    cube_defs.inc):00027         STEP_Z          EQU     1               ; zoom speed (256 steps per in-and-out)
                      (    cube_defs.inc):00028         
                      (    cube_defs.inc):00029         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00030         ; Variables, in page zero so they can use fast direct addressing.
                      (    cube_defs.inc):00031         ; The library's own workspace is $00-$7F, so these start at $80.
                      (    cube_defs.inc):00032         ; ---------------------------------------------------------------------------
     0080             (    cube_defs.inc):00033         ANG_A           EQU     $80             ; rotation angle about x (0-255)
     0081             (    cube_defs.inc):00034         ANG_B           EQU     $81             ; rotation angle about y (0-255)
     0082             (    cube_defs.inc):00035         SA              EQU     $82             ; sin(ANG_A)   (127 = 1.0)
     0083             (    cube_defs.inc):00036         CA              EQU     $83             ; cos(ANG_A)
     0084             (    cube_defs.inc):00037         SB              EQU     $84             ; sin(ANG_B)
     0085             (    cube_defs.inc):00038         CB              EQU     $85             ; cos(ANG_B)
     0086             (    cube_defs.inc):00039         TX              EQU     $86             ; 3 bytes: terms for rotated x
     0089             (    cube_defs.inc):00040         TY              EQU     $89             ; 3 bytes: terms for rotated y
     008C             (    cube_defs.inc):00041         TZ              EQU     $8C             ; 3 bytes: terms for rotated z
     008F             (    cube_defs.inc):00042         VI              EQU     $8F             ; corner number being worked on (0-7)
     0090             (    cube_defs.inc):00043         VX              EQU     $90             ; that corner's rotated x
     0091             (    cube_defs.inc):00044         ZI              EQU     $91             ; its depth, as an index into RXTAB/RYTAB
     0092             (    cube_defs.inc):00045         EC              EQU     $92             ; edges left to draw
     0093             (    cube_defs.inc):00046         FRAMES          EQU     $93             ; frame counter (test builds only)
     0094             (    cube_defs.inc):00047         SIZE            EQU     $94             ; this frame's half edge length (S)
     0095             (    cube_defs.inc):00048         ZOOM            EQU     $95             ; zoom phase (0-255, like an angle)
     0096             (    cube_defs.inc):00049         EX              EQU     $96             ; the viewer's eye, in cube
     0097             (    cube_defs.inc):00050         EY              EQU     $97             ;  coordinates
     0098             (    cube_defs.inc):00051         EZ              EQU     $98
     0099             (    cube_defs.inc):00052         WIRE            EQU     $99             ; 0: skip hidden edges, else draw all
     00A0             (    cube_defs.inc):00053         PX              EQU     $A0             ; 8 bytes: screen x of corners 0-7
     00A8             (    cube_defs.inc):00054         PY              EQU     $A8             ; 8 bytes: screen y of corners 0-7.
                      (    cube_defs.inc):00055                                                 ;  PY is exactly PX+8, so if X points
                      (    cube_defs.inc):00056                                                 ;  at a corner's PX entry, its PY is
                      (    cube_defs.inc):00057                                                 ;  at 8,X
     00B0             (    cube_defs.inc):00058         VIS             EQU     $B0             ; 6 bytes: per face, $FF if visible.
                      (    cube_defs.inc):00059                                                 ;  Faces: 0 +x, 1 -x, 2 +y, 3 -y,
                      (    cube_defs.inc):00060                                                 ;  4 +z, 5 -z
     00B8             (    cube_defs.inc):00061         POLY            EQU     $B8             ; 9 bytes: corner list for TGL_POLYF
                      (    cube_defs.inc):00062                                                 ;  (count, then 4 x,y pairs)
     00C2             (    cube_defs.inc):00063         FACEN           EQU     $C2             ; face being filled or spotted
                      (    cube_defs.inc):00064         ; (the die demo uses $C6-$DB for its own variables)
                      (   demo/cubep.asm):00025         
     0003             (   demo/cubep.asm):00026         PACE_TICKS      EQU     3               ; frame length in 50Hz ticks: 3 =
                      (   demo/cubep.asm):00027                                                 ;  about 17 frames per second
                      (   demo/cubep.asm):00028         
                      (   demo/cubep.asm):00029                         ORG     $2800
                      (   demo/cubep.asm):00030         
                      (   demo/cubep.asm):00031         ; ---------------------------------------------------------------------------
                      (   demo/cubep.asm):00032         ; Set up
                      (   demo/cubep.asm):00033         ; ---------------------------------------------------------------------------
2800 10CE0200         (   demo/cubep.asm):00034         START           LDS     #STACK_TOP
2804 4F               (   demo/cubep.asm):00035                         CLRA                    ; DP = $00: the library (and our
2805 1F8B             (   demo/cubep.asm):00036                         TFR     A,DP            ;  variables) use direct addressing
     00               (   demo/cubep.asm):00037                         SETDP   $00             ;  in page zero
2807 1CEF             (   demo/cubep.asm):00038                         ANDCC   #$EF            ; enable IRQs: the keyboard is read
                      (   demo/cubep.asm):00039                                                 ;  under interrupt
2809 BD1000           (   demo/cubep.asm):00040                         JSR     TGL_INIT        ; reset CRTC start, hide cursor
280C 8E3800           (   demo/cubep.asm):00041                         LDX     #BUFFER         ; draw into our buffer at $3800
280F BD1003           (   demo/cubep.asm):00042                         JSR     TGL_SETBUF
2812 0F80             (   demo/cubep.asm):00043                         CLR     <ANG_A          ; start square-on, mid zoom
2814 0F81             (   demo/cubep.asm):00044                         CLR     <ANG_B
2816 0F93             (   demo/cubep.asm):00045                         CLR     <FRAMES
2818 0F95             (   demo/cubep.asm):00046                         CLR     <ZOOM
281A 0F99             (   demo/cubep.asm):00047                         CLR     <WIRE           ; edges of hidden faces are skipped
281C 4F               (   demo/cubep.asm):00048                         CLRA                    ; status row title
281D 8E2864           (   demo/cubep.asm):00049                         LDX     #TITLE
2820 BD1030           (   demo/cubep.asm):00050                         JSR     TGL_TEXT
                      (   demo/cubep.asm):00051         
                      (   demo/cubep.asm):00052         ; ---------------------------------------------------------------------------
                      (   demo/cubep.asm):00053         ; Main loop: one pass per frame
                      (   demo/cubep.asm):00054         ; ---------------------------------------------------------------------------
2823 BD1006           (   demo/cubep.asm):00055         FRAME           JSR     TGL_CLS
2826 1700BE           (   demo/cubep.asm):00056                         LBSR    ZOOMSZ
2829 1700CC           (   demo/cubep.asm):00057                         LBSR    MATRIX
282C 1701AE           (   demo/cubep.asm):00058                         LBSR    CORNERS
282F 170166           (   demo/cubep.asm):00059                         LBSR    FACES
2832 17004D           (   demo/cubep.asm):00060                         LBSR    FILLS           ; fill the visible faces
2835 17021F           (   demo/cubep.asm):00061                         LBSR    EDGES           ; then the edges on top
2838 8603             (   demo/cubep.asm):00062                         LDA     #PACE_TICKS
283A BD103C           (   demo/cubep.asm):00063                         JSR     TGL_PACE
283D BD1012           (   demo/cubep.asm):00064                         JSR     TGL_BLIT
                      (   demo/cubep.asm):00065         
                      (   demo/cubep.asm):00066         ; Advance the angles and zoom phase. Being bytes, they wrap from 255 back
                      (   demo/cubep.asm):00067         ; to 0 by themselves, which is exactly one full turn.
2840 9680             (   demo/cubep.asm):00068                         LDA     <ANG_A
2842 8B02             (   demo/cubep.asm):00069                         ADDA    #STEP_A
2844 9780             (   demo/cubep.asm):00070                         STA     <ANG_A
2846 9681             (   demo/cubep.asm):00071                         LDA     <ANG_B
2848 8B03             (   demo/cubep.asm):00072                         ADDA    #STEP_B
284A 9781             (   demo/cubep.asm):00073                         STA     <ANG_B
284C 9695             (   demo/cubep.asm):00074                         LDA     <ZOOM
284E 8B01             (   demo/cubep.asm):00075                         ADDA    #STEP_Z
2850 9795             (   demo/cubep.asm):00076                         STA     <ZOOM
                      (   demo/cubep.asm):00077         
2852 BD101E           (   demo/cubep.asm):00078                         JSR     TGL_INKEY       ; any key exits
2855 1026E7C8         (   demo/cubep.asm):00079                         LBNE    TGL_EXIT
                      (   demo/cubep.asm):00080         ; Test builds stop after TESTFRAMES frames so the emulator can inspect
                      (   demo/cubep.asm):00081         ; the result. Normal builds skip this.
                      (   demo/cubep.asm):00082                         IFDEF   TESTFRAMES
                      (   demo/cubep.asm):00083                         INC     <FRAMES
                      (   demo/cubep.asm):00084                         LDA     <FRAMES
                      (   demo/cubep.asm):00085                         CMPA    #TESTFRAMES
                      (   demo/cubep.asm):00086                         BEQ     DONE
                      (   demo/cubep.asm):00087                         ENDC
2859 16FFC7           (   demo/cubep.asm):00088                         LBRA    FRAME
285C 20FE             (   demo/cubep.asm):00089         DONE            BRA     DONE
                      (   demo/cubep.asm):00090         
                      (   demo/cubep.asm):00091         ; Each face's fill pattern. A cube never shows two opposite faces at once,
                      (   demo/cubep.asm):00092         ; so the faces in view are always neighbours; each face is paired with a
                      (   demo/cubep.asm):00093         ; contrasting opposite (dense with sparse, horizontal with vertical) so the
                      (   demo/cubep.asm):00094         ; three faces you can see always look clearly different.
285E 0F               (   demo/cubep.asm):00095         FACEPAT         FCB     TGL_PAT_SOLID           ; +x
285F 01               (   demo/cubep.asm):00096                         FCB     TGL_PAT_25              ; -x
2860 03               (   demo/cubep.asm):00097                         FCB     TGL_PAT_HLINES          ; +y
2861 05               (   demo/cubep.asm):00098                         FCB     TGL_PAT_VLINES          ; -y
2862 09               (   demo/cubep.asm):00099                         FCB     TGL_PAT_50              ; +z
2863 0B               (   demo/cubep.asm):00100                         FCB     TGL_PAT_75              ; -z
                      (   demo/cubep.asm):00101         
                      (   demo/cubep.asm):00102         ; Status row title. $86 cyan, $83 yellow text codes.
2864 86               (   demo/cubep.asm):00103         TITLE           FCB     $86
2865 5041545445524E45 (   demo/cubep.asm):00104                         FCC     "PATTERNED CUBE"
     442043554245
2873 83               (   demo/cubep.asm):00105                         FCB     $83
2874 414E59204B455920 (   demo/cubep.asm):00106                         FCC     "ANY KEY EXITS"
     4558495453
2881 00               (   demo/cubep.asm):00107                         FCB     0
                      (   demo/cubep.asm):00108         
                      (   demo/cubep.asm):00109                         INCLUDE "cube_fill.asm"
                      (    cube_fill.asm):00001         ; ===========================================================================
                      (    cube_fill.asm):00002         ; cube_fill.asm - fill the cube's visible faces (used by cubep.asm and
                      (    cube_fill.asm):00003         ;   cubed.asm). FILLS sets each face's pattern from the demo's FACEPAT
                      (    cube_fill.asm):00004         ;   table, so the demo must provide one.
                      (    cube_fill.asm):00005         ; ===========================================================================
                      (    cube_fill.asm):00006         
                      (    cube_fill.asm):00007         ; ---------------------------------------------------------------------------
                      (    cube_fill.asm):00008         ; FILLS - fill each visible face with its pattern
                      (    cube_fill.asm):00009         ;   For each visible face: select its pattern from the demo's FACEPAT
                      (    cube_fill.asm):00010         ;   table, copy its four corners' screen positions into the POLY corner
                      (    cube_fill.asm):00011         ;   list, and fill it with TGL_POLYF. FACETAB gives each face's corners in
                      (    cube_fill.asm):00012         ;   order round the face. Visible faces never overlap on a convex shape,
                      (    cube_fill.asm):00013         ;   so they can be filled in any order.
                      (    cube_fill.asm):00014         ; ---------------------------------------------------------------------------
2882 318D0049         (    cube_fill.asm):00015         FILLS           LEAY    FACETAB,PCR
2886 0FC2             (    cube_fill.asm):00016                         CLR     <FACEN
2888 8E00B0           (    cube_fill.asm):00017         FL_LOOP         LDX     #VIS            ; skip faces that can't be seen
288B D6C2             (    cube_fill.asm):00018                         LDB     <FACEN
288D 3A               (    cube_fill.asm):00019                         ABX
288E 6D84             (    cube_fill.asm):00020                         TST     ,X
2890 2727             (    cube_fill.asm):00021                         BEQ     FL_NEXT
2892 308CC9           (    cube_fill.asm):00022                         LEAX    FACEPAT,PCR     ; this face's pattern
2895 D6C2             (    cube_fill.asm):00023                         LDB     <FACEN
2897 A685             (    cube_fill.asm):00024                         LDA     B,X
2899 BD1042           (    cube_fill.asm):00025                         JSR     TGL_SETPAT
289C 8604             (    cube_fill.asm):00026                         LDA     #4              ; corner list: 4 corners ...
289E 97B8             (    cube_fill.asm):00027                         STA     <POLY
28A0 CE00B9           (    cube_fill.asm):00028                         LDU     #POLY+1
28A3 E6A4             (    cube_fill.asm):00029                         LDB     ,Y              ; ... each copied from PX, PY
28A5 8D1D             (    cube_fill.asm):00030                         BSR     FL_CORNER
28A7 E621             (    cube_fill.asm):00031                         LDB     1,Y
28A9 8D19             (    cube_fill.asm):00032                         BSR     FL_CORNER
28AB E622             (    cube_fill.asm):00033                         LDB     2,Y
28AD 8D15             (    cube_fill.asm):00034                         BSR     FL_CORNER
28AF E623             (    cube_fill.asm):00035                         LDB     3,Y
28B1 8D11             (    cube_fill.asm):00036                         BSR     FL_CORNER
28B3 8E00B8           (    cube_fill.asm):00037                         LDX     #POLY
28B6 BD103F           (    cube_fill.asm):00038                         JSR     TGL_POLYF
28B9 3124             (    cube_fill.asm):00039         FL_NEXT         LEAY    4,Y             ; next face
28BB 0CC2             (    cube_fill.asm):00040                         INC     <FACEN
28BD 96C2             (    cube_fill.asm):00041                         LDA     <FACEN
28BF 8106             (    cube_fill.asm):00042                         CMPA    #6
28C1 25C5             (    cube_fill.asm):00043                         BLO     FL_LOOP
28C3 39               (    cube_fill.asm):00044                         RTS
                      (    cube_fill.asm):00045         
                      (    cube_fill.asm):00046         ; FL_CORNER - Entry: B = corner number, U -> next slot in POLY.
                      (    cube_fill.asm):00047         ;   Stores that corner's screen x, y; U += 2.
28C4 8E00A0           (    cube_fill.asm):00048         FL_CORNER       LDX     #PX
28C7 3A               (    cube_fill.asm):00049                         ABX
28C8 A684             (    cube_fill.asm):00050                         LDA     ,X              ; x
28CA E608             (    cube_fill.asm):00051                         LDB     8,X             ; y (PY = PX + 8)
28CC EDC1             (    cube_fill.asm):00052                         STD     ,U++
28CE 39               (    cube_fill.asm):00053                         RTS
                      (    cube_fill.asm):00054         
                      (    cube_fill.asm):00055         ; The six faces' corners, in order round each face (for TGL_POLYF):
                      (    cube_fill.asm):00056         ; the four corners sharing the face's bit, going round.
28CF 01030705         (    cube_fill.asm):00057         FACETAB         FCB     1,3,7,5                 ; +x (bit 0 set)
28D3 00020604         (    cube_fill.asm):00058                         FCB     0,2,6,4                 ; -x (bit 0 clear)
28D7 02030706         (    cube_fill.asm):00059                         FCB     2,3,7,6                 ; +y (bit 1 set)
28DB 00010504         (    cube_fill.asm):00060                         FCB     0,1,5,4                 ; -y (bit 1 clear)
28DF 04050706         (    cube_fill.asm):00061                         FCB     4,5,7,6                 ; +z (bit 2 set)
28E3 00010302         (    cube_fill.asm):00062                         FCB     0,1,3,2                 ; -z (bit 2 clear)
                      (    cube_fill.asm):00063         
                      (   demo/cubep.asm):00110                         INCLUDE "cube_core.asm"
                      (    cube_core.asm):00001         ; ===========================================================================
                      (    cube_core.asm):00002         ; cube_core.asm - the routines and tables shared by the cube demos
                      (    cube_core.asm):00003         ;   (cube.asm, cubep.asm, cubed.asm): zoom, rotation, projection, which
                      (    cube_core.asm):00004         ;   faces can be seen, and the edges. Included after each demo's own code.
                      (    cube_core.asm):00005         ;
                      (    cube_core.asm):00006         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00007         ; The maths, and how it is kept cheap on an 8-bit CPU
                      (    cube_core.asm):00008         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00009         ;
                      (    cube_core.asm):00010         ;   Fixed point. Sines and cosines are stored as signed bytes where 127
                      (    cube_core.asm):00011         ;   stands for 1.0 (so 64 is about 0.5, -127 is -1.0). Multiplying two such
                      (    cube_core.asm):00012         ;   numbers gives a result 128 times too big, so products are divided by
                      (    cube_core.asm):00013         ;   128 afterwards (see MULS7).
                      (    cube_core.asm):00014         ;
                      (    cube_core.asm):00015         ;   Angles. A full circle is 256 steps instead of 360 degrees, so an angle
                      (    cube_core.asm):00016         ;   fits in one byte and wraps round by itself when it overflows. A quarter
                      (    cube_core.asm):00017         ;   turn is 64 steps, which gives cos(a) = sin(a + 64): one sine table
                      (    cube_core.asm):00018         ;   serves for both.
                      (    cube_core.asm):00019         ;
                      (    cube_core.asm):00020         ;   Rotation. The cube is centred on the origin, so its corners are every
                      (    cube_core.asm):00021         ;   combination of (+S or -S, +S or -S, +S or -S), where S is half the edge
                      (    cube_core.asm):00022         ;   length. Rotating a point means multiplying it by a 3x3 matrix:
                      (    cube_core.asm):00023         ;
                      (    cube_core.asm):00024         ;       rotated x = m00*x + m01*y + m02*z      (and similarly for y, z)
                      (    cube_core.asm):00025         ;
                      (    cube_core.asm):00026         ;   With every coordinate being +S or -S, each product is just +/-(m * S).
                      (    cube_core.asm):00027         ;   So once per frame we work out the nine values m*S (the "terms" TX, TY,
                      (    cube_core.asm):00028         ;   TZ), and then every rotated corner coordinate is three of those terms
                      (    cube_core.asm):00029         ;   added or subtracted according to the corner's signs. That's 8 multiplies
                      (    cube_core.asm):00030         ;   per frame for the whole cube, instead of 9 per corner.
                      (    cube_core.asm):00031         ;
                      (    cube_core.asm):00032         ;   Perspective. Further-away points should be drawn closer to the centre:
                      (    cube_core.asm):00033         ;
                      (    cube_core.asm):00034         ;       screen x = centre + x * F / (distance + z)
                      (    cube_core.asm):00035         ;
                      (    cube_core.asm):00036         ;   Dividing is slow on a 6809, so the value F / (distance + z), suitably
                      (    cube_core.asm):00037         ;   scaled, is precomputed for every possible z and stored in a table
                      (    cube_core.asm):00038         ;   (RXTAB, RYTAB). Projecting is then one table lookup and one MUL.
                      (    cube_core.asm):00039         ;   The x table uses a smaller F than the y table because teletext pixels
                      (    cube_core.asm):00040         ;   are wider than they are tall; this keeps the cube looking square.
                      (    cube_core.asm):00041         ;
                      (    cube_core.asm):00042         ;   Hidden faces. A face is visible when it points back towards the viewer.
                      (    cube_core.asm):00043         ;   Rather than rotate the faces, FACES works out where the viewer's eye
                      (    cube_core.asm):00044         ;   is in the cube's own coordinates (as the ship demo does). The cube's
                      (    cube_core.asm):00045         ;   faces are the six sides of a box, so the test is then trivial: the +x
                      (    cube_core.asm):00046         ;   face is visible when the eye's x is beyond +S, the -x face when it is
                      (    cube_core.asm):00047         ;   below -S, and likewise for y and z. The eye sits 100 units in front of
                      (    cube_core.asm):00048         ;   the viewer's screen, the distance the projection tables assume; in
                      (    cube_core.asm):00049         ;   cube coordinates it is -100 * (z row of the rotation matrix).
                      (    cube_core.asm):00050         ;   Each edge borders two faces and is drawn if either is visible.
                      (    cube_core.asm):00051         ;
                      (    cube_core.asm):00052         ;   Corner numbering. Corners are numbered 0-7. Bit 0 of the number says
                      (    cube_core.asm):00053         ;   whether the corner's x is +S (bit set) or -S (bit clear); bit 1 does
                      (    cube_core.asm):00054         ;   the same for y and bit 2 for z. Two corners are joined by an edge when
                      (    cube_core.asm):00055         ;   their numbers differ in exactly one bit (see EDGETAB).
                      (    cube_core.asm):00056         ; ===========================================================================
                      (    cube_core.asm):00057         
                      (    cube_core.asm):00058         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00059         ; ZOOMSZ - set SIZE from the zoom phase
                      (    cube_core.asm):00060         ;
                      (    cube_core.asm):00061         ;   SIZE = SIZE_MID + sin(ZOOM)/8, which swings smoothly between 5 and 36
                      (    cube_core.asm):00062         ;   as ZOOM goes round. From about 26 upwards the cube overhangs the screen
                      (    cube_core.asm):00063         ;   and TGL_LINEC clips it. Don't go above 36: beyond that the depth no
                      (    cube_core.asm):00064         ;   longer fits the projection tables (-64..63), and projected points no
                      (    cube_core.asm):00065         ;   longer fit the signed -128..127 that TGL_LINEC accepts.
                      (    cube_core.asm):00066         ; ---------------------------------------------------------------------------
28E7 308D01DC         (    cube_core.asm):00067         ZOOMSZ          LEAX    SINTAB,PCR      ; X -> sine table
28EB D695             (    cube_core.asm):00068                         LDB     <ZOOM           ; X -> sin(ZOOM). ABX adds B as an
28ED 3A               (    cube_core.asm):00069                         ABX                     ;  UNSIGNED byte (0-255). "LDA B,X"
                      (    cube_core.asm):00070                                                 ;  would treat B as signed and read
                      (    cube_core.asm):00071                                                 ;  before the table for B >= 128
28EE A684             (    cube_core.asm):00072                         LDA     ,X              ; A = sin(ZOOM), -127..127
28F0 47               (    cube_core.asm):00073                         ASRA                    ; divide by 8. ASR keeps the sign bit,
28F1 47               (    cube_core.asm):00074                         ASRA                    ;  so negative numbers stay negative:
28F2 47               (    cube_core.asm):00075                         ASRA                    ;  -127..127 becomes -16..15
28F3 8B15             (    cube_core.asm):00076                         ADDA    #SIZE_MID       ; 5..36
28F5 9794             (    cube_core.asm):00077                         STA     <SIZE
28F7 39               (    cube_core.asm):00078                         RTS
                      (    cube_core.asm):00079         
                      (    cube_core.asm):00080         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00081         ; MATRIX - work out this frame's nine terms
                      (    cube_core.asm):00082         ;
                      (    cube_core.asm):00083         ;   The cube is turned first about the y axis (angle B), then about the x
                      (    cube_core.asm):00084         ;   axis (angle A). Multiplying those two rotations together gives this
                      (    cube_core.asm):00085         ;   matrix (each entry scaled so 127 = 1.0):
                      (    cube_core.asm):00086         ;
                      (    cube_core.asm):00087         ;               x part      y part     z part
                      (    cube_core.asm):00088         ;     row x: [  cb,         0,         sb       ]
                      (    cube_core.asm):00089         ;     row y: [  sb*sa,      ca,       -cb*sa    ]
                      (    cube_core.asm):00090         ;     row z: [ -sb*ca,      sa,        cb*ca    ]
                      (    cube_core.asm):00091         ;
                      (    cube_core.asm):00092         ;   Each entry is then multiplied by SIZE to give the terms, e.g.
                      (    cube_core.asm):00093         ;   TX = [ cb*S, 0, sb*S ]. Two-factor entries like sb*sa need two
                      (    cube_core.asm):00094         ;   multiplies: first sb*sa, then that result * S.
                      (    cube_core.asm):00095         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00096         
                      (    cube_core.asm):00097         ; Look up the four sines and cosines. Each lookup: X -> table, add the
                      (    cube_core.asm):00098         ; angle (unsigned, via ABX), read the byte. cos uses angle + 64.
28F8 308D01CB         (    cube_core.asm):00099         MATRIX          LEAX    SINTAB,PCR      ; SA = sin(ANG_A)
28FC D680             (    cube_core.asm):00100                         LDB     <ANG_A
28FE 3A               (    cube_core.asm):00101                         ABX
28FF A684             (    cube_core.asm):00102                         LDA     ,X
2901 9782             (    cube_core.asm):00103                         STA     <SA
2903 308D01C0         (    cube_core.asm):00104                         LEAX    SINTAB,PCR      ; CA = cos(ANG_A) = sin(ANG_A + 64)
2907 D680             (    cube_core.asm):00105                         LDB     <ANG_A
2909 CB40             (    cube_core.asm):00106                         ADDB    #64             ; (wraps round past 255 correctly)
290B 3A               (    cube_core.asm):00107                         ABX
290C A684             (    cube_core.asm):00108                         LDA     ,X
290E 9783             (    cube_core.asm):00109                         STA     <CA
2910 308D01B3         (    cube_core.asm):00110                         LEAX    SINTAB,PCR      ; SB = sin(ANG_B)
2914 D681             (    cube_core.asm):00111                         LDB     <ANG_B
2916 3A               (    cube_core.asm):00112                         ABX
2917 A684             (    cube_core.asm):00113                         LDA     ,X
2919 9784             (    cube_core.asm):00114                         STA     <SB
291B 308D01A8         (    cube_core.asm):00115                         LEAX    SINTAB,PCR      ; CB = cos(ANG_B)
291F D681             (    cube_core.asm):00116                         LDB     <ANG_B
2921 CB40             (    cube_core.asm):00117                         ADDB    #64
2923 3A               (    cube_core.asm):00118                         ABX
2924 A684             (    cube_core.asm):00119                         LDA     ,X
2926 9785             (    cube_core.asm):00120                         STA     <CB
                      (    cube_core.asm):00121         
                      (    cube_core.asm):00122         ; Row x: TX = S * [ cb, 0, sb ]
2928 9685             (    cube_core.asm):00123                         LDA     <CB             ; TX+0 = cb * S
292A D694             (    cube_core.asm):00124                         LDB     <SIZE
292C 8D4F             (    cube_core.asm):00125                         BSR     MULS7
292E 9786             (    cube_core.asm):00126                         STA     <TX
2930 0F87             (    cube_core.asm):00127                         CLR     <TX+1           ; TX+1 = 0 (this entry is always 0)
2932 9684             (    cube_core.asm):00128                         LDA     <SB             ; TX+2 = sb * S
2934 D694             (    cube_core.asm):00129                         LDB     <SIZE
2936 8D45             (    cube_core.asm):00130                         BSR     MULS7
2938 9788             (    cube_core.asm):00131                         STA     <TX+2
                      (    cube_core.asm):00132         
                      (    cube_core.asm):00133         ; Row y: TY = S * [ sb*sa, ca, -cb*sa ]
293A 9684             (    cube_core.asm):00134                         LDA     <SB             ; TY+0 = (sb * sa) * S
293C D682             (    cube_core.asm):00135                         LDB     <SA
293E 8D3D             (    cube_core.asm):00136                         BSR     MULS7           ;  A = sb * sa
2940 D694             (    cube_core.asm):00137                         LDB     <SIZE
2942 8D39             (    cube_core.asm):00138                         BSR     MULS7           ;  A = that * S
2944 9789             (    cube_core.asm):00139                         STA     <TY
2946 9683             (    cube_core.asm):00140                         LDA     <CA             ; TY+1 = ca * S
2948 D694             (    cube_core.asm):00141                         LDB     <SIZE
294A 8D31             (    cube_core.asm):00142                         BSR     MULS7
294C 978A             (    cube_core.asm):00143                         STA     <TY+1
294E 9685             (    cube_core.asm):00144                         LDA     <CB             ; TY+2 = -(cb * sa) * S
2950 D682             (    cube_core.asm):00145                         LDB     <SA
2952 8D29             (    cube_core.asm):00146                         BSR     MULS7
2954 40               (    cube_core.asm):00147                         NEGA
2955 D694             (    cube_core.asm):00148                         LDB     <SIZE
2957 8D24             (    cube_core.asm):00149                         BSR     MULS7
2959 978B             (    cube_core.asm):00150                         STA     <TY+2
                      (    cube_core.asm):00151         
                      (    cube_core.asm):00152         ; Row z: TZ = S * [ -sb*ca, sa, cb*ca ]
295B 9684             (    cube_core.asm):00153                         LDA     <SB             ; TZ+0 = -(sb * ca) * S
295D D683             (    cube_core.asm):00154                         LDB     <CA
295F 8D1C             (    cube_core.asm):00155                         BSR     MULS7
2961 40               (    cube_core.asm):00156                         NEGA
2962 D694             (    cube_core.asm):00157                         LDB     <SIZE
2964 8D17             (    cube_core.asm):00158                         BSR     MULS7
2966 978C             (    cube_core.asm):00159                         STA     <TZ
2968 9682             (    cube_core.asm):00160                         LDA     <SA             ; TZ+1 = sa * S
296A D694             (    cube_core.asm):00161                         LDB     <SIZE
296C 8D0F             (    cube_core.asm):00162                         BSR     MULS7
296E 978D             (    cube_core.asm):00163                         STA     <TZ+1
2970 9685             (    cube_core.asm):00164                         LDA     <CB             ; TZ+2 = (cb * ca) * S
2972 D683             (    cube_core.asm):00165                         LDB     <CA
2974 8D07             (    cube_core.asm):00166                         BSR     MULS7
2976 D694             (    cube_core.asm):00167                         LDB     <SIZE
2978 8D03             (    cube_core.asm):00168                         BSR     MULS7
297A 978E             (    cube_core.asm):00169                         STA     <TZ+2
297C 39               (    cube_core.asm):00170                         RTS
                      (    cube_core.asm):00171         
                      (    cube_core.asm):00172         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00173         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    cube_core.asm):00174         ;   Entry: A, B signed (-127..127)
                      (    cube_core.asm):00175         ;   Exit:  A = result. B corrupted.
                      (    cube_core.asm):00176         ;
                      (    cube_core.asm):00177         ;   The 6809's MUL only does unsigned A * B -> D. So: remember the signs,
                      (    cube_core.asm):00178         ;   multiply the sizes (absolute values), then put the sign back.
                      (    cube_core.asm):00179         ;   The result's sign is negative when exactly one input is negative,
                      (    cube_core.asm):00180         ;   which is what the top bit of (A EOR B) tells us.
                      (    cube_core.asm):00181         ;
                      (    cube_core.asm):00182         ;   Dividing D by 128: shifting D left once (ASLB then ROLA, which carries
                      (    cube_core.asm):00183         ;   B's top bit into A) gives D * 2, and the high byte of D * 2 is D / 128.
                      (    cube_core.asm):00184         ;   So after the shift the answer is simply in A.
                      (    cube_core.asm):00185         ; ---------------------------------------------------------------------------
297D 3406             (    cube_core.asm):00186         MULS7           PSHS    D               ; save the originals: 0,S = A, 1,S = B
297F 4D               (    cube_core.asm):00187                         TSTA                    ; make A positive
2980 2A01             (    cube_core.asm):00188                         BPL     MS_1
2982 40               (    cube_core.asm):00189                         NEGA
2983 5D               (    cube_core.asm):00190         MS_1            TSTB                    ; make B positive
2984 2A01             (    cube_core.asm):00191                         BPL     MS_2
2986 50               (    cube_core.asm):00192                         NEGB
2987 3D               (    cube_core.asm):00193         MS_2            MUL                     ; D = |A| * |B|
2988 58               (    cube_core.asm):00194                         ASLB                    ; D * 2 ...
2989 49               (    cube_core.asm):00195                         ROLA                    ; ... so A = D / 128
298A 3402             (    cube_core.asm):00196                         PSHS    A               ; keep the result. The originals are
                      (    cube_core.asm):00197                                                 ;  now at 1,S (A) and 2,S (B)
298C A661             (    cube_core.asm):00198                         LDA     1,S             ; sign of result = top bit of A EOR B
298E A862             (    cube_core.asm):00199                         EORA    2,S             ;  (sets N flag)
2990 3502             (    cube_core.asm):00200                         PULS    A               ; result back in A. PULS doesn't
                      (    cube_core.asm):00201                                                 ;  change the flags, so N survives
2992 2A01             (    cube_core.asm):00202                         BPL     MS_3            ; positive: done
2994 40               (    cube_core.asm):00203                         NEGA                    ; negative: negate the result
2995 3262             (    cube_core.asm):00204         MS_3            LEAS    2,S             ; discard the saved originals
2997 39               (    cube_core.asm):00205                         RTS
                      (    cube_core.asm):00206         
                      (    cube_core.asm):00207         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00208         ; FACES - which of the six faces point towards the viewer
                      (    cube_core.asm):00209         ;
                      (    cube_core.asm):00210         ;   The eye in cube coordinates is -100 * (z row of the rotation matrix),
                      (    cube_core.asm):00211         ;   using the unscaled matrix entries (127 = 1.0) from MATRIX:
                      (    cube_core.asm):00212         ;       z row = [ -sb*ca, sa, cb*ca ]
                      (    cube_core.asm):00213         ;   Multiplying by -101 and dividing by 128 (MULS7) gives -100 * row / 127.
                      (    cube_core.asm):00214         ;   Then, for each axis, the + face is visible if the eye is beyond +S and
                      (    cube_core.asm):00215         ;   the - face if it is beyond -S.
                      (    cube_core.asm):00216         ; ---------------------------------------------------------------------------
2998 9684             (    cube_core.asm):00217         FACES           LDA     <SB             ; EX = -100 * (-sb*ca)
299A D683             (    cube_core.asm):00218                         LDB     <CA
299C 17FFDE           (    cube_core.asm):00219                         LBSR    MULS7
299F 40               (    cube_core.asm):00220                         NEGA
29A0 C69B             (    cube_core.asm):00221                         LDB     #-101
29A2 17FFD8           (    cube_core.asm):00222                         LBSR    MULS7
29A5 9796             (    cube_core.asm):00223                         STA     <EX
29A7 9682             (    cube_core.asm):00224                         LDA     <SA             ; EY = -100 * sa
29A9 C69B             (    cube_core.asm):00225                         LDB     #-101
29AB 17FFCF           (    cube_core.asm):00226                         LBSR    MULS7
29AE 9797             (    cube_core.asm):00227                         STA     <EY
29B0 9685             (    cube_core.asm):00228                         LDA     <CB             ; EZ = -100 * (cb*ca)
29B2 D683             (    cube_core.asm):00229                         LDB     <CA
29B4 17FFC6           (    cube_core.asm):00230                         LBSR    MULS7
29B7 C69B             (    cube_core.asm):00231                         LDB     #-101
29B9 17FFC1           (    cube_core.asm):00232                         LBSR    MULS7
29BC 9798             (    cube_core.asm):00233                         STA     <EZ
29BE CE00B0           (    cube_core.asm):00234                         LDU     #VIS            ; set VIS for the six faces
29C1 9696             (    cube_core.asm):00235                         LDA     <EX
29C3 8D06             (    cube_core.asm):00236                         BSR     FACEPAIR        ;  +x, -x
29C5 9697             (    cube_core.asm):00237                         LDA     <EY
29C7 8D02             (    cube_core.asm):00238                         BSR     FACEPAIR        ;  +y, -y
29C9 9698             (    cube_core.asm):00239                         LDA     <EZ
                      (    cube_core.asm):00240                         ; fall into FACEPAIR    ;  +z, -z
                      (    cube_core.asm):00241         
                      (    cube_core.asm):00242         ; FACEPAIR - Entry: A = one coordinate of the eye, U -> VIS slot for the
                      (    cube_core.asm):00243         ;   + face. Sets that slot and the next ($FF visible, 0 hidden), U += 2.
29CB 5F               (    cube_core.asm):00244         FACEPAIR        CLRB                    ; + face: visible if eye > S
29CC 9194             (    cube_core.asm):00245                         CMPA    <SIZE           ;  (signed compare)
29CE 2F01             (    cube_core.asm):00246                         BLE     FP_1
29D0 5A               (    cube_core.asm):00247                         DECB                    ;  B = $FF
29D1 E7C0             (    cube_core.asm):00248         FP_1            STB     ,U+
29D3 5F               (    cube_core.asm):00249                         CLRB                    ; - face: visible if eye < -S,
29D4 40               (    cube_core.asm):00250                         NEGA                    ;  i.e. -eye > S (the eye stays
29D5 9194             (    cube_core.asm):00251                         CMPA    <SIZE           ;  within +/-101, so NEGA can't
29D7 2F01             (    cube_core.asm):00252                         BLE     FP_2            ;  overflow)
29D9 5A               (    cube_core.asm):00253                         DECB
29DA E7C0             (    cube_core.asm):00254         FP_2            STB     ,U+
29DC 39               (    cube_core.asm):00255                         RTS
                      (    cube_core.asm):00256         
                      (    cube_core.asm):00257         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00258         ; CORNERS - rotate and project all 8 corners into PX/PY
                      (    cube_core.asm):00259         ;
                      (    cube_core.asm):00260         ;   For each corner number VI (0-7):
                      (    cube_core.asm):00261         ;     rotated x = signed sum of the TX terms       (VSUM)
                      (    cube_core.asm):00262         ;     rotated z = signed sum of the TZ terms, turned into a table index
                      (    cube_core.asm):00263         ;     rotated y = signed sum of the TY terms
                      (    cube_core.asm):00264         ;     screen y  = CY + y * RYTAB[z] / 128         (PMUL)
