                      (   demo/boxes.asm):00095         
286E 9E82             (   demo/boxes.asm):00096                         LDX     <FCOUNT         ; count the frame and show it on the
2870 3001             (   demo/boxes.asm):00097                         LEAX    1,X             ;  status row (straight to the screen,
2872 9F82             (   demo/boxes.asm):00098                         STX     <FCOUNT         ;  five characters, right-aligned)
2874 8617             (   demo/boxes.asm):00099                         LDA     #NUMCOL
2876 BD1036           (   demo/boxes.asm):00100                         JSR     TGL_TNUM
                      (   demo/boxes.asm):00101         
