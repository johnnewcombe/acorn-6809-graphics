                      (   demo/boxes.asm):00114         ; MOVEBOX - move the box at U by its velocity, bouncing off the limits
                      (   demo/boxes.asm):00115         ;   A box bounces by reversing its velocity (NEG) and moving the other way
                      (   demo/boxes.asm):00116         ;   instead. The right/bottom limits depend on the box's size, so they are
                      (   demo/boxes.asm):00117         ;   worked out as limit - size and compared signed (BLT/BGT), since the
                      (   demo/boxes.asm):00118         ;   positions can be negative.
                      (   demo/boxes.asm):00119         ;   Entry: U -> box record    Exit: A, B corrupted
                      (   demo/boxes.asm):00120         ; ---------------------------------------------------------------------------
2084 A6C90000         (   demo/boxes.asm):00121         MOVEBOX         LDA     BX_X,U          ; new x = x + dx
2088 ABC90002         (   demo/boxes.asm):00122                         ADDA    BX_DX,U
208C 81F4             (   demo/boxes.asm):00123                         CMPA    #X_LO           ; past the left limit?
208E 2D0C             (   demo/boxes.asm):00124                         BLT     MB_XFLIP
2090 C65A             (   demo/boxes.asm):00125                         LDB     #X_HI           ; past the right limit? (x > X_HI - w)
2092 E0C90004         (   demo/boxes.asm):00126                         SUBB    BX_W,U
2096 3404             (   demo/boxes.asm):00127                         PSHS    B
2098 A1E0             (   demo/boxes.asm):00128                         CMPA    ,S+
209A 2F0C             (   demo/boxes.asm):00129                         BLE     MB_XOK
209C 60C90002         (   demo/boxes.asm):00130         MB_XFLIP        NEG     BX_DX,U         ; bounce: reverse, move the other way
20A0 A6C90000         (   demo/boxes.asm):00131                         LDA     BX_X,U
20A4 ABC90002         (   demo/boxes.asm):00132                         ADDA    BX_DX,U
20A8 A7C90000         (   demo/boxes.asm):00133         MB_XOK          STA     BX_X,U
                      (   demo/boxes.asm):00134         
20AC A6C90001         (   demo/boxes.asm):00135                         LDA     BX_Y,U          ; the same for y
20B0 ABC90003         (   demo/boxes.asm):00136                         ADDA    BX_DY,U
20B4 81F7             (   demo/boxes.asm):00137                         CMPA    #Y_LO
20B6 2D0C             (   demo/boxes.asm):00138                         BLT     MB_YFLIP
20B8 C651             (   demo/boxes.asm):00139                         LDB     #Y_HI
20BA E0C90005         (   demo/boxes.asm):00140                         SUBB    BX_H,U
20BE 3404             (   demo/boxes.asm):00141                         PSHS    B
20C0 A1E0             (   demo/boxes.asm):00142                         CMPA    ,S+
