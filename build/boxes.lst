                      (   demo/boxes.asm):00001         ; ===========================================================================
                      (   demo/boxes.asm):00002         ; Rectangles demo for the teletext graphics library
                      (   demo/boxes.asm):00003         ;
                      (   demo/boxes.asm):00004         ;   Four filled boxes drift around the screen and bounce, drawn in XOR mode:
                      (   demo/boxes.asm):00005         ;   where boxes overlap, their pixels cancel out, so the overlaps show as
                      (   demo/boxes.asm):00006         ;   holes and the pattern keeps changing. The boxes bounce off limits a
                      (   demo/boxes.asm):00007         ;   little beyond the screen edges, so they keep sliding partly out of view
                      (   demo/boxes.asm):00008         ;   (showing the clipping). Two fixed outline frames, also in XOR, invert
                      (   demo/boxes.asm):00009         ;   wherever a box crosses them. The status row below the graphics shows a
                      (   demo/boxes.asm):00010         ;   coloured title and a frame counter. Press any key to exit.
                      (   demo/boxes.asm):00011         ;
                      (   demo/boxes.asm):00012         ;   Loading: tgl.bin at $1000 (TGL_BASE below), boxes.bin at $2800.
                      (   demo/boxes.asm):00013         ;   Run from START ($2800). Works with either machine's library build.
                      (   demo/boxes.asm):00014         ;
                      (   demo/boxes.asm):00015         ;   Rectangle calls take two opposite corners: A,B = x0,y0 and
                      (   demo/boxes.asm):00016         ;   X = x1:y1 (x1 in the high byte), signed, in any order.
                      (   demo/boxes.asm):00017         ;
                      (   demo/boxes.asm):00018         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      (   demo/boxes.asm):00019         ; ===========================================================================
                      (   demo/boxes.asm):00020         
     1000             (   demo/boxes.asm):00021         TGL_BASE        EQU     $1000
                      (   demo/boxes.asm):00022                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
                      (      tgl_api.inc):00033         
     03C0             (      tgl_api.inc):00034         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00035         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00036         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00037         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00038         
                      (      tgl_api.inc):00039         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00040         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00041         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00042         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00043         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00044         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00045         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00046         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00047         
                      (      tgl_api.inc):00048         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00049         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00050         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00051         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00052         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00053         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00054         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00055         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00056         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00057         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (   demo/boxes.asm):00023         
     3800             (   demo/boxes.asm):00024         BUFFER          EQU     $3800           ; off-screen buffer (960 bytes)
     0200             (   demo/boxes.asm):00025         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (   demo/boxes.asm):00026         
                      (   demo/boxes.asm):00027         ; How far beyond the screen the boxes may travel before bouncing
     FFF4             (   demo/boxes.asm):00028         X_LO            EQU     -12             ; left limit for a box's left edge
     005A             (   demo/boxes.asm):00029         X_HI            EQU     78+12           ; right limit for its right edge + 1
     FFF7             (   demo/boxes.asm):00030         Y_LO            EQU     -9              ; top limit for its top edge
     0051             (   demo/boxes.asm):00031         Y_HI            EQU     72+9            ; bottom limit for its bottom edge + 1
                      (   demo/boxes.asm):00032         
                      (   demo/boxes.asm):00033         ; Page-zero variables (the library uses $00-$2B)
     0080             (   demo/boxes.asm):00034         BOXN            EQU     $80             ; boxes left to process
     0081             (   demo/boxes.asm):00035         FRAMES          EQU     $81             ; frame counter (test builds)
     0082             (   demo/boxes.asm):00036         FCOUNT          EQU     $82             ; frame counter shown on the status
                      (   demo/boxes.asm):00037                                                 ;  row (16 bits, $82-$83)
                      (   demo/boxes.asm):00038         
                      (   demo/boxes.asm):00039                         ORG     $2800
                      (   demo/boxes.asm):00040         
2800 10CE0200         (   demo/boxes.asm):00041         START           LDS     #STACK_TOP
2804 4F               (   demo/boxes.asm):00042                         CLRA                    ; DP = $00 for the library
2805 1F8B             (   demo/boxes.asm):00043                         TFR     A,DP
     00               (   demo/boxes.asm):00044                         SETDP   $00
2807 1CEF             (   demo/boxes.asm):00045                         ANDCC   #$EF            ; IRQs on (keyboard)
2809 BD1000           (   demo/boxes.asm):00046                         JSR     TGL_INIT
280C 8E3800           (   demo/boxes.asm):00047                         LDX     #BUFFER
280F BD1003           (   demo/boxes.asm):00048                         JSR     TGL_SETBUF
2812 0F81             (   demo/boxes.asm):00049                         CLR     <FRAMES
2814 8E0000           (   demo/boxes.asm):00050                         LDX     #0              ; frame counter starts at 0
2817 9F82             (   demo/boxes.asm):00051                         STX     <FCOUNT
                      (   demo/boxes.asm):00052         
                      (   demo/boxes.asm):00053         ; The status row: written once, since the blit never touches it
2819 4F               (   demo/boxes.asm):00054                         CLRA                    ; column 0
281A 8E28D5           (   demo/boxes.asm):00055                         LDX     #TITLE
281D BD1030           (   demo/boxes.asm):00056                         JSR     TGL_TEXT
                      (   demo/boxes.asm):00057         
                      (   demo/boxes.asm):00058         ; ---------------------------------------------------------------------------
                      (   demo/boxes.asm):00059         ; Main loop
                      (   demo/boxes.asm):00060         ; ---------------------------------------------------------------------------
2820 BD1006           (   demo/boxes.asm):00061         FRAME           JSR     TGL_CLS
2823 8602             (   demo/boxes.asm):00062                         LDA     #TGL_MODE_XOR   ; everything this frame is XORed
2825 BD1009           (   demo/boxes.asm):00063                         JSR     TGL_SETMODE
                      (   demo/boxes.asm):00064         
                      (   demo/boxes.asm):00065         ; Move and draw each box. U walks through the box table, one record per box.
2828 338D00C0         (   demo/boxes.asm):00066                         LEAU    BOXES,PCR
282C 8604             (   demo/boxes.asm):00067                         LDA     #NBOXES
282E 9780             (   demo/boxes.asm):00068                         STA     <BOXN
2830 8D52             (   demo/boxes.asm):00069         BX_LOOP         BSR     MOVEBOX         ; update position, bouncing
2832 A6C90000         (   demo/boxes.asm):00070                         LDA     BX_X,U          ; draw it: corner (x, y) ...
2836 ABC90004         (   demo/boxes.asm):00071                         ADDA    BX_W,U          ; ... to (x+w-1, y+h-1)
283A 4A               (   demo/boxes.asm):00072                         DECA
283B E6C90001         (   demo/boxes.asm):00073                         LDB     BX_Y,U
283F EBC90005         (   demo/boxes.asm):00074                         ADDB    BX_H,U
2843 5A               (   demo/boxes.asm):00075                         DECB
2844 1F01             (   demo/boxes.asm):00076                         TFR     D,X             ; X = x1:y1
2846 A6C90000         (   demo/boxes.asm):00077                         LDA     BX_X,U          ; A,B = x0,y0
284A E6C90001         (   demo/boxes.asm):00078                         LDB     BX_Y,U
284E BD1027           (   demo/boxes.asm):00079                         JSR     TGL_RECTF
2851 33C90006         (   demo/boxes.asm):00080                         LEAU    BX_SIZE,U       ; next box
2855 0A80             (   demo/boxes.asm):00081                         DEC     <BOXN
2857 26D7             (   demo/boxes.asm):00082                         BNE     BX_LOOP
                      (   demo/boxes.asm):00083         
                      (   demo/boxes.asm):00084         ; Two fixed outline frames, also in XOR
2859 4F               (   demo/boxes.asm):00085                         CLRA                    ; round the whole screen: (0,0)
285A 5F               (   demo/boxes.asm):00086                         CLRB
285B 8E4D47           (   demo/boxes.asm):00087                         LDX     #$4D47          ;  to (77,71)
285E BD1024           (   demo/boxes.asm):00088                         JSR     TGL_RECT
2861 860C             (   demo/boxes.asm):00089                         LDA     #12             ; and an inner frame: (12,9)
2863 C609             (   demo/boxes.asm):00090                         LDB     #9
2865 8E413E           (   demo/boxes.asm):00091                         LDX     #$413E          ;  to (65,62)
2868 BD1024           (   demo/boxes.asm):00092                         JSR     TGL_RECT
                      (   demo/boxes.asm):00093         
