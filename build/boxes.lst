                      (   demo/boxes.asm):00059         ; Main loop
                      (   demo/boxes.asm):00060         ; ---------------------------------------------------------------------------
2020 BD1006           (   demo/boxes.asm):00061         FRAME           JSR     TGL_CLS
2023 8602             (   demo/boxes.asm):00062                         LDA     #TGL_MODE_XOR   ; everything this frame is XORed
2025 BD1009           (   demo/boxes.asm):00063                         JSR     TGL_SETMODE
                      (   demo/boxes.asm):00064         
                      (   demo/boxes.asm):00065         ; Move and draw each box. U walks through the box table, one record per box.
2028 338D00C0         (   demo/boxes.asm):00066                         LEAU    BOXES,PCR
202C 8604             (   demo/boxes.asm):00067                         LDA     #NBOXES
202E 9780             (   demo/boxes.asm):00068                         STA     <BOXN
2030 8D52             (   demo/boxes.asm):00069         BX_LOOP         BSR     MOVEBOX         ; update position, bouncing
2032 A6C90000         (   demo/boxes.asm):00070                         LDA     BX_X,U          ; draw it: corner (x, y) ...
2036 ABC90004         (   demo/boxes.asm):00071                         ADDA    BX_W,U          ; ... to (x+w-1, y+h-1)
203A 4A               (   demo/boxes.asm):00072                         DECA
203B E6C90001         (   demo/boxes.asm):00073                         LDB     BX_Y,U
203F EBC90005         (   demo/boxes.asm):00074                         ADDB    BX_H,U
2043 5A               (   demo/boxes.asm):00075                         DECB
2044 1F01             (   demo/boxes.asm):00076                         TFR     D,X             ; X = x1:y1
2046 A6C90000         (   demo/boxes.asm):00077                         LDA     BX_X,U          ; A,B = x0,y0
204A E6C90001         (   demo/boxes.asm):00078                         LDB     BX_Y,U
204E BD1027           (   demo/boxes.asm):00079                         JSR     TGL_RECTF
2051 33C90006         (   demo/boxes.asm):00080                         LEAU    BX_SIZE,U       ; next box
2055 0A80             (   demo/boxes.asm):00081                         DEC     <BOXN
2057 26D7             (   demo/boxes.asm):00082                         BNE     BX_LOOP
                      (   demo/boxes.asm):00083         
                      (   demo/boxes.asm):00084         ; Two fixed outline frames, also in XOR
2059 4F               (   demo/boxes.asm):00085                         CLRA                    ; round the whole screen: (0,0)
205A 5F               (   demo/boxes.asm):00086                         CLRB
205B 8E4D47           (   demo/boxes.asm):00087                         LDX     #$4D47          ;  to (77,71)
205E BD1024           (   demo/boxes.asm):00088                         JSR     TGL_RECT
2061 860C             (   demo/boxes.asm):00089                         LDA     #12             ; and an inner frame: (12,9)
2063 C609             (   demo/boxes.asm):00090                         LDB     #9
2065 8E413E           (   demo/boxes.asm):00091                         LDX     #$413E          ;  to (65,62)
