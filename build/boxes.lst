                      (   demo/boxes.asm):00113         ; ---------------------------------------------------------------------------
                      (   demo/boxes.asm):00114         ; MOVEBOX - move the box at U by its velocity, bouncing off the limits
                      (   demo/boxes.asm):00115         ;   A box bounces by reversing its velocity (NEG) and moving the other way
                      (   demo/boxes.asm):00116         ;   instead. The right/bottom limits depend on the box's size, so they are
                      (   demo/boxes.asm):00117         ;   worked out as limit - size and compared signed (BLT/BGT), since the
                      (   demo/boxes.asm):00118         ;   positions can be negative.
                      (   demo/boxes.asm):00119         ;   Entry: U -> box record    Exit: A, B corrupted
                      (   demo/boxes.asm):00120         ; ---------------------------------------------------------------------------
2884 A6C90000         (   demo/boxes.asm):00121         MOVEBOX         LDA     BX_X,U          ; new x = x + dx
2888 ABC90002         (   demo/boxes.asm):00122                         ADDA    BX_DX,U
288C 81F4             (   demo/boxes.asm):00123                         CMPA    #X_LO           ; past the left limit?
288E 2D0C             (   demo/boxes.asm):00124                         BLT     MB_XFLIP
2890 C65A             (   demo/boxes.asm):00125                         LDB     #X_HI           ; past the right limit? (x > X_HI - w)
2892 E0C90004         (   demo/boxes.asm):00126                         SUBB    BX_W,U
2896 3404             (   demo/boxes.asm):00127                         PSHS    B
2898 A1E0             (   demo/boxes.asm):00128                         CMPA    ,S+
289A 2F0C             (   demo/boxes.asm):00129                         BLE     MB_XOK
289C 60C90002         (   demo/boxes.asm):00130         MB_XFLIP        NEG     BX_DX,U         ; bounce: reverse, move the other way
28A0 A6C90000         (   demo/boxes.asm):00131                         LDA     BX_X,U
28A4 ABC90002         (   demo/boxes.asm):00132                         ADDA    BX_DX,U
28A8 A7C90000         (   demo/boxes.asm):00133         MB_XOK          STA     BX_X,U
                      (   demo/boxes.asm):00134         
28AC A6C90001         (   demo/boxes.asm):00135                         LDA     BX_Y,U          ; the same for y
28B0 ABC90003         (   demo/boxes.asm):00136                         ADDA    BX_DY,U
28B4 81F7             (   demo/boxes.asm):00137                         CMPA    #Y_LO
28B6 2D0C             (   demo/boxes.asm):00138                         BLT     MB_YFLIP
28B8 C651             (   demo/boxes.asm):00139                         LDB     #Y_HI
28BA E0C90005         (   demo/boxes.asm):00140                         SUBB    BX_H,U
28BE 3404             (   demo/boxes.asm):00141                         PSHS    B
28C0 A1E0             (   demo/boxes.asm):00142                         CMPA    ,S+
28C2 2F0C             (   demo/boxes.asm):00143                         BLE     MB_YOK
28C4 60C90003         (   demo/boxes.asm):00144         MB_YFLIP        NEG     BX_DY,U
28C8 A6C90001         (   demo/boxes.asm):00145                         LDA     BX_Y,U
28CC ABC90003         (   demo/boxes.asm):00146                         ADDA    BX_DY,U
