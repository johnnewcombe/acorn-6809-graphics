                      (   demo/boxes.asm):00150         ; ---------------------------------------------------------------------------
                      (   demo/boxes.asm):00151         ; The boxes. Each record: x, y (top-left, signed), dx, dy (velocity per
                      (   demo/boxes.asm):00152         ; frame, signed), w, h (size in pixels). Positions and velocities change as
                      (   demo/boxes.asm):00153         ; the demo runs.
                      (   demo/boxes.asm):00154         ; ---------------------------------------------------------------------------
     0000             (   demo/boxes.asm):00155         BX_X            EQU     0
     0001             (   demo/boxes.asm):00156         BX_Y            EQU     1
     0002             (   demo/boxes.asm):00157         BX_DX           EQU     2
     0003             (   demo/boxes.asm):00158         BX_DY           EQU     3
     0004             (   demo/boxes.asm):00159         BX_W            EQU     4
     0005             (   demo/boxes.asm):00160         BX_H            EQU     5
     0006             (   demo/boxes.asm):00161         BX_SIZE         EQU     6
                      (   demo/boxes.asm):00162         
