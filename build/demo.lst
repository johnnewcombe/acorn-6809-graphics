                      (    demo/demo.asm):00001         ; ===========================================================================
                      (    demo/demo.asm):00002         ; Demo / smoke test for the teletext graphics library
                      (    demo/demo.asm):00003         ;
                      (    demo/demo.asm):00004         ;   Draws a border round the screen and a starburst of lines from the centre
                      (    demo/demo.asm):00005         ;   to points round the edge, shows it, then waits for a key and exits.
                      (    demo/demo.asm):00006         ;
                      (    demo/demo.asm):00007         ;   Loading: tgl.bin at $1000 (TGL_BASE below), demo.bin at $2800 (its ORG).
                      (    demo/demo.asm):00008         ;   Run from START ($2800). Press any key to exit.
                      (    demo/demo.asm):00009         ;
                      (    demo/demo.asm):00010         ;   The same demo.bin works on both machines: everything machine-specific
                      (    demo/demo.asm):00011         ;   (screen address, CRTC, monitor vectors) lives inside the library build.
                      (    demo/demo.asm):00012         ;
                      (    demo/demo.asm):00013         ;   How drawing works with this library:
                      (    demo/demo.asm):00014         ;     1. TGL_INIT / TGL_SETBUF  set things up and choose an off-screen buffer
                      (    demo/demo.asm):00015         ;     2. TGL_CLS               blank the buffer
                      (    demo/demo.asm):00016         ;     3. TGL_PLOT / TGL_LINE   draw into the buffer (nothing visible yet)
                      (    demo/demo.asm):00017         ;     4. TGL_BLIT              copy the finished buffer to the screen at once
                      (    demo/demo.asm):00018         ;   Because all the drawing happens off-screen, you never see a half-drawn
                      (    demo/demo.asm):00019         ;   picture.
                      (    demo/demo.asm):00020         ;
                      (    demo/demo.asm):00021         ;   Screen coordinates: x 0-77 (left to right), y 0-71 (top to bottom).
                      (    demo/demo.asm):00022         ;   Each teletext character cell holds a 2 x 3 block of these pixels.
                      (    demo/demo.asm):00023         ; ===========================================================================
                      (    demo/demo.asm):00024         
                      (    demo/demo.asm):00025         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00026         ; Library entry points
                      (    demo/demo.asm):00027         ;   TGL_BASE is where tgl.bin is loaded. tgl_api.inc turns that into the
                      (    demo/demo.asm):00028         ;   address of each routine (TGL_INIT = TGL_BASE+0, TGL_LINE = +15, ...),
                      (    demo/demo.asm):00029         ;   so this program just does JSR TGL_LINE etc.
                      (    demo/demo.asm):00030         ; ---------------------------------------------------------------------------
     1000             (    demo/demo.asm):00031         TGL_BASE        EQU     $1000
                      (    demo/demo.asm):00032                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
     1048             (      tgl_api.inc):00033         TGL_SETDASH     EQU     TGL_BASE+72     ; dash: A = pattern, B = length, X = phase
     104B             (      tgl_api.inc):00034         TGL_LINED       EQU     TGL_BASE+75     ; dashed line: as TGL_LINEC
     104E             (      tgl_api.inc):00035         TGL_RECTD       EQU     TGL_BASE+78     ; dashed rectangle outline: as TGL_RECT
                      (      tgl_api.inc):00036         
     03C0             (      tgl_api.inc):00037         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00038         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00039         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00040         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00041         
                      (      tgl_api.inc):00042         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00043         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00044         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00045         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00046         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00047         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00048         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00049         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00050         
                      (      tgl_api.inc):00051         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00052         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00053         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00054         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00055         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00056         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00057         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00058         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00059         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00060         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (    demo/demo.asm):00033         
                      (    demo/demo.asm):00034         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00035         ; Memory and constants
                      (    demo/demo.asm):00036         ; ---------------------------------------------------------------------------
     3800             (    demo/demo.asm):00037         DEMOBUF         EQU     $3800           ; off-screen buffer: 960 bytes
                      (    demo/demo.asm):00038                                                 ;  (24 rows x 40 characters)
     0200             (    demo/demo.asm):00039         STACK_TOP       EQU     $0200           ; stack occupies $0100-$01FF; the 6809
                      (    demo/demo.asm):00040                                                 ;  pre-decrements, so the first push
                      (    demo/demo.asm):00041                                                 ;  lands at $01FF
     0080             (    demo/demo.asm):00042         D_N             EQU     $80             ; loop counter, in page zero. The
                      (    demo/demo.asm):00043                                                 ;  library's own workspace is $00-$17,
                      (    demo/demo.asm):00044                                                 ;  so $80 upwards is safe for us
     0026             (    demo/demo.asm):00045         CX              EQU     38              ; centre of the starburst
     0023             (    demo/demo.asm):00046         CY              EQU     35
                      (    demo/demo.asm):00047         
                      (    demo/demo.asm):00048                         ORG     $2800
                      (    demo/demo.asm):00049         
                      (    demo/demo.asm):00050         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00051         ; Set up
                      (    demo/demo.asm):00052         ; ---------------------------------------------------------------------------
2800 10CE0200         (    demo/demo.asm):00053         START           LDS     #STACK_TOP      ; our own stack
                      (    demo/demo.asm):00054         
                      (    demo/demo.asm):00055         ; The library keeps its variables in page zero and uses direct addressing
                      (    demo/demo.asm):00056         ; ("<name") to reach them quickly, so every library call must be made with
                      (    demo/demo.asm):00057         ; the direct page register DP = $00.
2804 4F               (    demo/demo.asm):00058                         CLRA
2805 1F8B             (    demo/demo.asm):00059                         TFR     A,DP            ; DP = $00 (there is no LDDP, so via A)
     00               (    demo/demo.asm):00060                         SETDP   $00             ; tell the assembler, so "<D_N" etc.
                      (    demo/demo.asm):00061                                                 ;  assemble as direct-page addresses
                      (    demo/demo.asm):00062         
                      (    demo/demo.asm):00063         ; The monitor reads the keyboard from an interrupt, so IRQs must be enabled
                      (    demo/demo.asm):00064         ; for TGL_INKEY to see key presses. ANDCC #$EF clears the I (IRQ mask) bit.
2807 1CEF             (    demo/demo.asm):00065                         ANDCC   #$EF
                      (    demo/demo.asm):00066         
2809 BD1000           (    demo/demo.asm):00067                         JSR     TGL_INIT        ; reset the 6845 start address, hide
                      (    demo/demo.asm):00068                                                 ;  the cursor, select SET plot mode
280C 8E3800           (    demo/demo.asm):00069                         LDX     #DEMOBUF        ; use our own buffer at $3800
280F BD1003           (    demo/demo.asm):00070                         JSR     TGL_SETBUF
2812 BD1006           (    demo/demo.asm):00071                         JSR     TGL_CLS         ; blank it
                      (    demo/demo.asm):00072         
                      (    demo/demo.asm):00073         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00074         ; Border round the whole graphics area
                      (    demo/demo.asm):00075         ;
                      (    demo/demo.asm):00076         ; TGL_LINE takes the start point in A (x) and B (y), and the end point
                      (    demo/demo.asm):00077         ; packed into X: x1 in the high byte, y1 in the low byte. So LDX #$4D00
                      (    demo/demo.asm):00078         ; means x1 = $4D (77), y1 = $00 (0).
                      (    demo/demo.asm):00079         ;
                      (    demo/demo.asm):00080         ; Library routines preserve all registers, so after one line A and B still
                      (    demo/demo.asm):00081         ; hold the same start point and can be reused for the next line.
                      (    demo/demo.asm):00082         ; ---------------------------------------------------------------------------
2815 4F               (    demo/demo.asm):00083                         CLRA                    ; start (0,0): top-left corner
2816 5F               (    demo/demo.asm):00084                         CLRB
2817 8E4D00           (    demo/demo.asm):00085                         LDX     #$4D00          ; to (77,0): top edge
281A BD100F           (    demo/demo.asm):00086                         JSR     TGL_LINE
281D 8E0047           (    demo/demo.asm):00087                         LDX     #$0047          ; to (0,71): left edge ($47 = 71)
2820 BD100F           (    demo/demo.asm):00088                         JSR     TGL_LINE
2823 864D             (    demo/demo.asm):00089                         LDA     #77             ; start (77,71): bottom-right corner
2825 C647             (    demo/demo.asm):00090                         LDB     #71
2827 8E4D00           (    demo/demo.asm):00091                         LDX     #$4D00          ; to (77,0): right edge
282A BD100F           (    demo/demo.asm):00092                         JSR     TGL_LINE
282D 8E0047           (    demo/demo.asm):00093                         LDX     #$0047          ; to (0,71): bottom edge
2830 BD100F           (    demo/demo.asm):00094                         JSR     TGL_LINE
                      (    demo/demo.asm):00095         
                      (    demo/demo.asm):00096         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00097         ; Starburst: lines from the centre (CX,CY) out to every 7th point round
                      (    demo/demo.asm):00098         ; the border.
                      (    demo/demo.asm):00099         ;
                      (    demo/demo.asm):00100         ; Building the packed end point: put x in A and y in B, then TFR D,X.
                      (    demo/demo.asm):00101         ; D is simply A:B as one 16-bit register (A is the high byte), so this
                      (    demo/demo.asm):00102         ; gives X = x:y in a single instruction.
                      (    demo/demo.asm):00103         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00104         
                      (    demo/demo.asm):00105         ; First pass: top and bottom edges. D_N steps along x: 0, 7, 14 ... 77.
2833 0F80             (    demo/demo.asm):00106                         CLR     <D_N            ; n = 0
2835 9680             (    demo/demo.asm):00107         D_TB            LDA     <D_N            ; end point (n, 0) on the top edge
2837 5F               (    demo/demo.asm):00108                         CLRB
2838 1F01             (    demo/demo.asm):00109                         TFR     D,X             ; X = n:0
283A 8626             (    demo/demo.asm):00110                         LDA     #CX             ; start at the centre
283C C623             (    demo/demo.asm):00111                         LDB     #CY
283E BD100F           (    demo/demo.asm):00112                         JSR     TGL_LINE
2841 9680             (    demo/demo.asm):00113                         LDA     <D_N            ; end point (n, 71) on the bottom edge
2843 C647             (    demo/demo.asm):00114                         LDB     #71
2845 1F01             (    demo/demo.asm):00115                         TFR     D,X
2847 8626             (    demo/demo.asm):00116                         LDA     #CX
2849 C623             (    demo/demo.asm):00117                         LDB     #CY
284B BD100F           (    demo/demo.asm):00118                         JSR     TGL_LINE
284E 9680             (    demo/demo.asm):00119                         LDA     <D_N            ; n = n + 7
2850 8B07             (    demo/demo.asm):00120                         ADDA    #7
2852 9780             (    demo/demo.asm):00121                         STA     <D_N
2854 814E             (    demo/demo.asm):00122                         CMPA    #78             ; carry on while n < 78 (BLO is an
2856 25DD             (    demo/demo.asm):00123                         BLO     D_TB            ;  unsigned "branch if lower")
                      (    demo/demo.asm):00124         
                      (    demo/demo.asm):00125         ; Second pass: left and right edges. D_N steps down y: 0, 7, 14 ... 70.
2858 0F80             (    demo/demo.asm):00126                         CLR     <D_N
285A 4F               (    demo/demo.asm):00127         D_LR            CLRA                    ; end point (0, n) on the left edge
285B D680             (    demo/demo.asm):00128                         LDB     <D_N
285D 1F01             (    demo/demo.asm):00129                         TFR     D,X
285F 8626             (    demo/demo.asm):00130                         LDA     #CX
2861 C623             (    demo/demo.asm):00131                         LDB     #CY
2863 BD100F           (    demo/demo.asm):00132                         JSR     TGL_LINE
2866 864D             (    demo/demo.asm):00133                         LDA     #77             ; end point (77, n) on the right edge
2868 D680             (    demo/demo.asm):00134                         LDB     <D_N
286A 1F01             (    demo/demo.asm):00135                         TFR     D,X
286C 8626             (    demo/demo.asm):00136                         LDA     #CX
286E C623             (    demo/demo.asm):00137                         LDB     #CY
2870 BD100F           (    demo/demo.asm):00138                         JSR     TGL_LINE
2873 9680             (    demo/demo.asm):00139                         LDA     <D_N            ; n = n + 7, while n < 72
2875 8B07             (    demo/demo.asm):00140                         ADDA    #7
2877 9780             (    demo/demo.asm):00141                         STA     <D_N
2879 8148             (    demo/demo.asm):00142                         CMPA    #72
287B 25DD             (    demo/demo.asm):00143                         BLO     D_LR
                      (    demo/demo.asm):00144         
                      (    demo/demo.asm):00145         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00146         ; Everything so far was drawn into the buffer. Now copy it to the screen.
                      (    demo/demo.asm):00147         ; ---------------------------------------------------------------------------
287D BD1012           (    demo/demo.asm):00148                         JSR     TGL_BLIT
                      (    demo/demo.asm):00149         
                      (    demo/demo.asm):00150         ; ---------------------------------------------------------------------------
                      (    demo/demo.asm):00151         ; Wait for a key, then exit.
                      (    demo/demo.asm):00152         ;   TGL_INKEY doesn't wait: it returns Z set if no key is waiting, or Z clear
                      (    demo/demo.asm):00153         ;   with the key in A. So loop until Z is clear.
                      (    demo/demo.asm):00154         ;   TGL_EXIT restores the normal text display and returns to FLEX (or the
                      (    demo/demo.asm):00155         ;   monitor on a standard System 3). It never comes back, so JMP not JSR.
                      (    demo/demo.asm):00156         ; ---------------------------------------------------------------------------
2880 BD101E           (    demo/demo.asm):00157         DONE            JSR     TGL_INKEY
2883 27FB             (    demo/demo.asm):00158                         BEQ     DONE            ; no key yet: keep checking
2885 7E1021           (    demo/demo.asm):00159                         JMP     TGL_EXIT

