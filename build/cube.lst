                      (    demo/cube.asm):00001         ; ===========================================================================
                      (    demo/cube.asm):00002         ; Rotating cube demo for the teletext graphics library
                      (    demo/cube.asm):00003         ;
                      (    demo/cube.asm):00004         ;   A wireframe cube that tumbles about two axes and slowly zooms in and out,
                      (    demo/cube.asm):00005         ;   drawn in perspective. Press any key to exit.
                      (    demo/cube.asm):00006         ;
                      (    demo/cube.asm):00007         ;   Loading: tgl.bin at $1000 (TGL_BASE below), cube.bin at $2000 (its ORG).
                      (    demo/cube.asm):00008         ;   Run from START ($2000). Works with either machine's library build.
                      (    demo/cube.asm):00009         ;
                      (    demo/cube.asm):00010         ;   Each frame:
                      (    demo/cube.asm):00011         ;     1. clear the off-screen buffer                       (TGL_CLS)
                      (    demo/cube.asm):00012         ;     2. work out this frame's size from the zoom phase    (ZOOMSZ)
                      (    demo/cube.asm):00013         ;     3. build the rotation for this frame's angles        (MATRIX)
                      (    demo/cube.asm):00014         ;     4. rotate the 8 corners and project them to screen   (CORNERS)
                      (    demo/cube.asm):00015         ;     5. draw the 12 edges between corners                 (EDGES)
                      (    demo/cube.asm):00016         ;     6. copy the buffer to the screen                     (TGL_BLIT)
                      (    demo/cube.asm):00017         ;     7. advance the angles and zoom, check for a key, repeat
                      (    demo/cube.asm):00018         ;   Drawing off-screen and blitting the finished frame means no flicker.
                      (    demo/cube.asm):00019         ;
                      (    demo/cube.asm):00020         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00021         ; The maths, and how it is kept cheap on an 8-bit CPU
                      (    demo/cube.asm):00022         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00023         ;
                      (    demo/cube.asm):00024         ;   Fixed point. Sines and cosines are stored as signed bytes where 127
                      (    demo/cube.asm):00025         ;   stands for 1.0 (so 64 is about 0.5, -127 is -1.0). Multiplying two such
                      (    demo/cube.asm):00026         ;   numbers gives a result 128 times too big, so products are divided by
                      (    demo/cube.asm):00027         ;   128 afterwards (see MULS7).
                      (    demo/cube.asm):00028         ;
                      (    demo/cube.asm):00029         ;   Angles. A full circle is 256 steps instead of 360 degrees, so an angle
                      (    demo/cube.asm):00030         ;   fits in one byte and wraps round by itself when it overflows. A quarter
                      (    demo/cube.asm):00031         ;   turn is 64 steps, which gives cos(a) = sin(a + 64): one sine table
                      (    demo/cube.asm):00032         ;   serves for both.
                      (    demo/cube.asm):00033         ;
                      (    demo/cube.asm):00034         ;   Rotation. The cube is centred on the origin, so its corners are every
                      (    demo/cube.asm):00035         ;   combination of (+S or -S, +S or -S, +S or -S), where S is half the edge
                      (    demo/cube.asm):00036         ;   length. Rotating a point means multiplying it by a 3x3 matrix:
                      (    demo/cube.asm):00037         ;
                      (    demo/cube.asm):00038         ;       rotated x = m00*x + m01*y + m02*z      (and similarly for y, z)
                      (    demo/cube.asm):00039         ;
                      (    demo/cube.asm):00040         ;   With every coordinate being +S or -S, each product is just +/-(m * S).
                      (    demo/cube.asm):00041         ;   So once per frame we work out the nine values m*S (the "terms" TX, TY,
                      (    demo/cube.asm):00042         ;   TZ), and then every rotated corner coordinate is three of those terms
                      (    demo/cube.asm):00043         ;   added or subtracted according to the corner's signs. That's 8 multiplies
                      (    demo/cube.asm):00044         ;   per frame for the whole cube, instead of 9 per corner.
                      (    demo/cube.asm):00045         ;
                      (    demo/cube.asm):00046         ;   Perspective. Further-away points should be drawn closer to the centre:
                      (    demo/cube.asm):00047         ;
                      (    demo/cube.asm):00048         ;       screen x = centre + x * F / (distance + z)
                      (    demo/cube.asm):00049         ;
                      (    demo/cube.asm):00050         ;   Dividing is slow on a 6809, so the value F / (distance + z), suitably
                      (    demo/cube.asm):00051         ;   scaled, is precomputed for every possible z and stored in a table
                      (    demo/cube.asm):00052         ;   (RXTAB, RYTAB). Projecting is then one table lookup and one MUL.
                      (    demo/cube.asm):00053         ;   The x table uses a smaller F than the y table because teletext pixels
                      (    demo/cube.asm):00054         ;   are wider than they are tall; this keeps the cube looking square.
                      (    demo/cube.asm):00055         ;
                      (    demo/cube.asm):00056         ;   Corner numbering. Corners are numbered 0-7. Bit 0 of the number says
                      (    demo/cube.asm):00057         ;   whether the corner's x is +S (bit set) or -S (bit clear); bit 1 does
                      (    demo/cube.asm):00058         ;   the same for y and bit 2 for z. Two corners are joined by an edge when
                      (    demo/cube.asm):00059         ;   their numbers differ in exactly one bit (see EDGETAB).
                      (    demo/cube.asm):00060         ;
                      (    demo/cube.asm):00061         ;   Build with -D TESTFRAMES=n to stop after n frames (used by the emulator
                      (    demo/cube.asm):00062         ;   tests; a normal build runs until a key is pressed).
                      (    demo/cube.asm):00063         ; ===========================================================================
                      (    demo/cube.asm):00064         
                      (    demo/cube.asm):00065         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00066         ; Library entry points (see tgl_api.inc)
                      (    demo/cube.asm):00067         ; ---------------------------------------------------------------------------
     1000             (    demo/cube.asm):00068         TGL_BASE        EQU     $1000
                      (    demo/cube.asm):00069                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
                      (      tgl_api.inc):00023         
     03C0             (      tgl_api.inc):00024         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00025         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00026         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00027         TGL_MODE_XOR    EQU     2
                      (    demo/cube.asm):00070         
                      (    demo/cube.asm):00071         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00072         ; Memory
                      (    demo/cube.asm):00073         ; ---------------------------------------------------------------------------
     3000             (    demo/cube.asm):00074         BUFFER          EQU     $3000           ; off-screen buffer (960 bytes)
     0200             (    demo/cube.asm):00075         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    demo/cube.asm):00076         
                      (    demo/cube.asm):00077         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00078         ; Settings you can change
                      (    demo/cube.asm):00079         ; ---------------------------------------------------------------------------
     0015             (    demo/cube.asm):00080         SIZE_MID        EQU     21              ; middle of the zoom range; the half
                      (    demo/cube.asm):00081                                                 ;  edge length pulses 5..36 around it
     0027             (    demo/cube.asm):00082         CX              EQU     39              ; screen position of the cube's centre
     0024             (    demo/cube.asm):00083         CY              EQU     36
     0002             (    demo/cube.asm):00084         STEP_A          EQU     2               ; rotation speed about x (per frame,
     0003             (    demo/cube.asm):00085         STEP_B          EQU     3               ;  and about y; 256 = a full turn)
     0001             (    demo/cube.asm):00086         STEP_Z          EQU     1               ; zoom speed (256 steps per in-and-out)
                      (    demo/cube.asm):00087         
                      (    demo/cube.asm):00088         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00089         ; Variables, in page zero so they can use fast direct addressing.
                      (    demo/cube.asm):00090         ; The library's own workspace is $00-$17, so these start at $80.
                      (    demo/cube.asm):00091         ; ---------------------------------------------------------------------------
     0080             (    demo/cube.asm):00092         ANG_A           EQU     $80             ; rotation angle about x (0-255)
     0081             (    demo/cube.asm):00093         ANG_B           EQU     $81             ; rotation angle about y (0-255)
     0082             (    demo/cube.asm):00094         SA              EQU     $82             ; sin(ANG_A)   (127 = 1.0)
     0083             (    demo/cube.asm):00095         CA              EQU     $83             ; cos(ANG_A)
     0084             (    demo/cube.asm):00096         SB              EQU     $84             ; sin(ANG_B)
     0085             (    demo/cube.asm):00097         CB              EQU     $85             ; cos(ANG_B)
     0086             (    demo/cube.asm):00098         TX              EQU     $86             ; 3 bytes: terms for rotated x
     0089             (    demo/cube.asm):00099         TY              EQU     $89             ; 3 bytes: terms for rotated y
     008C             (    demo/cube.asm):00100         TZ              EQU     $8C             ; 3 bytes: terms for rotated z
     008F             (    demo/cube.asm):00101         VI              EQU     $8F             ; corner number being worked on (0-7)
     0090             (    demo/cube.asm):00102         VX              EQU     $90             ; that corner's rotated x
     0091             (    demo/cube.asm):00103         ZI              EQU     $91             ; its depth, as an index into RXTAB/RYTAB
     0092             (    demo/cube.asm):00104         EC              EQU     $92             ; edges left to draw
     0093             (    demo/cube.asm):00105         FRAMES          EQU     $93             ; frame counter (test builds only)
     0094             (    demo/cube.asm):00106         SIZE            EQU     $94             ; this frame's half edge length (S)
     0095             (    demo/cube.asm):00107         ZOOM            EQU     $95             ; zoom phase (0-255, like an angle)
     00A0             (    demo/cube.asm):00108         PX              EQU     $A0             ; 8 bytes: screen x of corners 0-7
     00A8             (    demo/cube.asm):00109         PY              EQU     $A8             ; 8 bytes: screen y of corners 0-7.
                      (    demo/cube.asm):00110                                                 ;  PY is exactly PX+8, so if X points
                      (    demo/cube.asm):00111                                                 ;  at a corner's PX entry, its PY is
                      (    demo/cube.asm):00112                                                 ;  at 8,X
                      (    demo/cube.asm):00113         
                      (    demo/cube.asm):00114                         ORG     $2000
                      (    demo/cube.asm):00115         
                      (    demo/cube.asm):00116         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00117         ; Set up
                      (    demo/cube.asm):00118         ; ---------------------------------------------------------------------------
2000 10CE0200         (    demo/cube.asm):00119         START           LDS     #STACK_TOP
2004 4F               (    demo/cube.asm):00120                         CLRA                    ; DP = $00: the library (and our
2005 1F8B             (    demo/cube.asm):00121                         TFR     A,DP            ;  variables) use direct addressing
     00               (    demo/cube.asm):00122                         SETDP   $00             ;  in page zero
2007 1CEF             (    demo/cube.asm):00123                         ANDCC   #$EF            ; enable IRQs: the keyboard is read
                      (    demo/cube.asm):00124                                                 ;  under interrupt
2009 BD1000           (    demo/cube.asm):00125                         JSR     TGL_INIT        ; reset CRTC start, hide cursor
200C 8E3000           (    demo/cube.asm):00126                         LDX     #BUFFER         ; draw into our buffer at $3000
200F BD1003           (    demo/cube.asm):00127                         JSR     TGL_SETBUF
2012 0F80             (    demo/cube.asm):00128                         CLR     <ANG_A          ; start square-on, mid zoom
2014 0F81             (    demo/cube.asm):00129                         CLR     <ANG_B
2016 0F93             (    demo/cube.asm):00130                         CLR     <FRAMES
2018 0F95             (    demo/cube.asm):00131                         CLR     <ZOOM
                      (    demo/cube.asm):00132         
                      (    demo/cube.asm):00133         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00134         ; Main loop: one pass per frame
                      (    demo/cube.asm):00135         ; ---------------------------------------------------------------------------
201A BD1006           (    demo/cube.asm):00136         FRAME           JSR     TGL_CLS         ; blank the buffer
201D 8D29             (    demo/cube.asm):00137                         BSR     ZOOMSZ          ; SIZE for this frame
201F 170037           (    demo/cube.asm):00138                         LBSR    MATRIX          ; terms TX, TY, TZ for this frame
2022 1700D4           (    demo/cube.asm):00139                         LBSR    CORNERS         ; screen positions PX, PY
2025 17014B           (    demo/cube.asm):00140                         LBSR    EDGES           ; draw into the buffer
2028 BD1012           (    demo/cube.asm):00141                         JSR     TGL_BLIT        ; show it
                      (    demo/cube.asm):00142         
                      (    demo/cube.asm):00143         ; Advance the angles and zoom phase. Being bytes, they wrap from 255 back
                      (    demo/cube.asm):00144         ; to 0 by themselves, which is exactly one full turn.
202B 9680             (    demo/cube.asm):00145                         LDA     <ANG_A
202D 8B02             (    demo/cube.asm):00146                         ADDA    #STEP_A
202F 9780             (    demo/cube.asm):00147                         STA     <ANG_A
2031 9681             (    demo/cube.asm):00148                         LDA     <ANG_B
2033 8B03             (    demo/cube.asm):00149                         ADDA    #STEP_B
2035 9781             (    demo/cube.asm):00150                         STA     <ANG_B
2037 9695             (    demo/cube.asm):00151                         LDA     <ZOOM
2039 8B01             (    demo/cube.asm):00152                         ADDA    #STEP_Z
203B 9795             (    demo/cube.asm):00153                         STA     <ZOOM
                      (    demo/cube.asm):00154         
                      (    demo/cube.asm):00155         ; Any key exits. TGL_INKEY returns Z clear if a key was pressed, and
                      (    demo/cube.asm):00156         ; TGL_EXIT never returns, so a long branch straight to it is enough.
203D BD101E           (    demo/cube.asm):00157                         JSR     TGL_INKEY
2040 1026EFDD         (    demo/cube.asm):00158                         LBNE    TGL_EXIT
                      (    demo/cube.asm):00159         
                      (    demo/cube.asm):00160         ; Test builds stop after TESTFRAMES frames so the emulator can inspect
                      (    demo/cube.asm):00161         ; the result. Normal builds skip this.
                      (    demo/cube.asm):00162                         IFDEF   TESTFRAMES
                      (    demo/cube.asm):00163                         INC     <FRAMES
                      (    demo/cube.asm):00164                         LDA     <FRAMES
                      (    demo/cube.asm):00165                         CMPA    #TESTFRAMES
                      (    demo/cube.asm):00166                         BEQ     DONE
                      (    demo/cube.asm):00167                         ENDC
2044 20D4             (    demo/cube.asm):00168                         BRA     FRAME
2046 20FE             (    demo/cube.asm):00169         DONE            BRA     DONE
                      (    demo/cube.asm):00170         
                      (    demo/cube.asm):00171         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00172         ; ZOOMSZ - set SIZE from the zoom phase
                      (    demo/cube.asm):00173         ;
                      (    demo/cube.asm):00174         ;   SIZE = SIZE_MID + sin(ZOOM)/8, which swings smoothly between 5 and 36
                      (    demo/cube.asm):00175         ;   as ZOOM goes round. From about 26 upwards the cube overhangs the screen
                      (    demo/cube.asm):00176         ;   and TGL_LINEC clips it. Don't go above 36: beyond that the depth no
                      (    demo/cube.asm):00177         ;   longer fits the projection tables (-64..63), and projected points no
                      (    demo/cube.asm):00178         ;   longer fit the signed -128..127 that TGL_LINEC accepts.
                      (    demo/cube.asm):00179         ; ---------------------------------------------------------------------------
2048 308D0169         (    demo/cube.asm):00180         ZOOMSZ          LEAX    SINTAB,PCR      ; X -> sine table
204C D695             (    demo/cube.asm):00181                         LDB     <ZOOM           ; X -> sin(ZOOM). ABX adds B as an
204E 3A               (    demo/cube.asm):00182                         ABX                     ;  UNSIGNED byte (0-255). "LDA B,X"
                      (    demo/cube.asm):00183                                                 ;  would treat B as signed and read
                      (    demo/cube.asm):00184                                                 ;  before the table for B >= 128
204F A684             (    demo/cube.asm):00185                         LDA     ,X              ; A = sin(ZOOM), -127..127
2051 47               (    demo/cube.asm):00186                         ASRA                    ; divide by 8. ASR keeps the sign bit,
2052 47               (    demo/cube.asm):00187                         ASRA                    ;  so negative numbers stay negative:
2053 47               (    demo/cube.asm):00188                         ASRA                    ;  -127..127 becomes -16..15
2054 8B15             (    demo/cube.asm):00189                         ADDA    #SIZE_MID       ; 5..36
2056 9794             (    demo/cube.asm):00190                         STA     <SIZE
2058 39               (    demo/cube.asm):00191                         RTS
                      (    demo/cube.asm):00192         
                      (    demo/cube.asm):00193         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00194         ; MATRIX - work out this frame's nine terms
                      (    demo/cube.asm):00195         ;
                      (    demo/cube.asm):00196         ;   The cube is turned first about the y axis (angle B), then about the x
                      (    demo/cube.asm):00197         ;   axis (angle A). Multiplying those two rotations together gives this
                      (    demo/cube.asm):00198         ;   matrix (each entry scaled so 127 = 1.0):
                      (    demo/cube.asm):00199         ;
                      (    demo/cube.asm):00200         ;               x part      y part     z part
                      (    demo/cube.asm):00201         ;     row x: [  cb,         0,         sb       ]
                      (    demo/cube.asm):00202         ;     row y: [  sb*sa,      ca,       -cb*sa    ]
                      (    demo/cube.asm):00203         ;     row z: [ -sb*ca,      sa,        cb*ca    ]
                      (    demo/cube.asm):00204         ;
                      (    demo/cube.asm):00205         ;   Each entry is then multiplied by SIZE to give the terms, e.g.
                      (    demo/cube.asm):00206         ;   TX = [ cb*S, 0, sb*S ]. Two-factor entries like sb*sa need two
                      (    demo/cube.asm):00207         ;   multiplies: first sb*sa, then that result * S.
                      (    demo/cube.asm):00208         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00209         
                      (    demo/cube.asm):00210         ; Look up the four sines and cosines. Each lookup: X -> table, add the
                      (    demo/cube.asm):00211         ; angle (unsigned, via ABX), read the byte. cos uses angle + 64.
2059 308D0158         (    demo/cube.asm):00212         MATRIX          LEAX    SINTAB,PCR      ; SA = sin(ANG_A)
205D D680             (    demo/cube.asm):00213                         LDB     <ANG_A
205F 3A               (    demo/cube.asm):00214                         ABX
2060 A684             (    demo/cube.asm):00215                         LDA     ,X
2062 9782             (    demo/cube.asm):00216                         STA     <SA
2064 308D014D         (    demo/cube.asm):00217                         LEAX    SINTAB,PCR      ; CA = cos(ANG_A) = sin(ANG_A + 64)
2068 D680             (    demo/cube.asm):00218                         LDB     <ANG_A
206A CB40             (    demo/cube.asm):00219                         ADDB    #64             ; (wraps round past 255 correctly)
206C 3A               (    demo/cube.asm):00220                         ABX
206D A684             (    demo/cube.asm):00221                         LDA     ,X
206F 9783             (    demo/cube.asm):00222                         STA     <CA
2071 308D0140         (    demo/cube.asm):00223                         LEAX    SINTAB,PCR      ; SB = sin(ANG_B)
2075 D681             (    demo/cube.asm):00224                         LDB     <ANG_B
2077 3A               (    demo/cube.asm):00225                         ABX
2078 A684             (    demo/cube.asm):00226                         LDA     ,X
207A 9784             (    demo/cube.asm):00227                         STA     <SB
207C 308D0135         (    demo/cube.asm):00228                         LEAX    SINTAB,PCR      ; CB = cos(ANG_B)
2080 D681             (    demo/cube.asm):00229                         LDB     <ANG_B
2082 CB40             (    demo/cube.asm):00230                         ADDB    #64
2084 3A               (    demo/cube.asm):00231                         ABX
2085 A684             (    demo/cube.asm):00232                         LDA     ,X
2087 9785             (    demo/cube.asm):00233                         STA     <CB
                      (    demo/cube.asm):00234         
                      (    demo/cube.asm):00235         ; Row x: TX = S * [ cb, 0, sb ]
2089 9685             (    demo/cube.asm):00236                         LDA     <CB             ; TX+0 = cb * S
208B D694             (    demo/cube.asm):00237                         LDB     <SIZE
208D 8D4F             (    demo/cube.asm):00238                         BSR     MULS7
208F 9786             (    demo/cube.asm):00239                         STA     <TX
2091 0F87             (    demo/cube.asm):00240                         CLR     <TX+1           ; TX+1 = 0 (this entry is always 0)
2093 9684             (    demo/cube.asm):00241                         LDA     <SB             ; TX+2 = sb * S
2095 D694             (    demo/cube.asm):00242                         LDB     <SIZE
2097 8D45             (    demo/cube.asm):00243                         BSR     MULS7
2099 9788             (    demo/cube.asm):00244                         STA     <TX+2
                      (    demo/cube.asm):00245         
                      (    demo/cube.asm):00246         ; Row y: TY = S * [ sb*sa, ca, -cb*sa ]
209B 9684             (    demo/cube.asm):00247                         LDA     <SB             ; TY+0 = (sb * sa) * S
209D D682             (    demo/cube.asm):00248                         LDB     <SA
209F 8D3D             (    demo/cube.asm):00249                         BSR     MULS7           ;  A = sb * sa
20A1 D694             (    demo/cube.asm):00250                         LDB     <SIZE
20A3 8D39             (    demo/cube.asm):00251                         BSR     MULS7           ;  A = that * S
20A5 9789             (    demo/cube.asm):00252                         STA     <TY
20A7 9683             (    demo/cube.asm):00253                         LDA     <CA             ; TY+1 = ca * S
20A9 D694             (    demo/cube.asm):00254                         LDB     <SIZE
20AB 8D31             (    demo/cube.asm):00255                         BSR     MULS7
20AD 978A             (    demo/cube.asm):00256                         STA     <TY+1
20AF 9685             (    demo/cube.asm):00257                         LDA     <CB             ; TY+2 = -(cb * sa) * S
20B1 D682             (    demo/cube.asm):00258                         LDB     <SA
20B3 8D29             (    demo/cube.asm):00259                         BSR     MULS7
20B5 40               (    demo/cube.asm):00260                         NEGA
20B6 D694             (    demo/cube.asm):00261                         LDB     <SIZE
20B8 8D24             (    demo/cube.asm):00262                         BSR     MULS7
20BA 978B             (    demo/cube.asm):00263                         STA     <TY+2
                      (    demo/cube.asm):00264         
                      (    demo/cube.asm):00265         ; Row z: TZ = S * [ -sb*ca, sa, cb*ca ]
20BC 9684             (    demo/cube.asm):00266                         LDA     <SB             ; TZ+0 = -(sb * ca) * S
20BE D683             (    demo/cube.asm):00267                         LDB     <CA
20C0 8D1C             (    demo/cube.asm):00268                         BSR     MULS7
20C2 40               (    demo/cube.asm):00269                         NEGA
20C3 D694             (    demo/cube.asm):00270                         LDB     <SIZE
20C5 8D17             (    demo/cube.asm):00271                         BSR     MULS7
20C7 978C             (    demo/cube.asm):00272                         STA     <TZ
20C9 9682             (    demo/cube.asm):00273                         LDA     <SA             ; TZ+1 = sa * S
20CB D694             (    demo/cube.asm):00274                         LDB     <SIZE
20CD 8D0F             (    demo/cube.asm):00275                         BSR     MULS7
20CF 978D             (    demo/cube.asm):00276                         STA     <TZ+1
20D1 9685             (    demo/cube.asm):00277                         LDA     <CB             ; TZ+2 = (cb * ca) * S
20D3 D683             (    demo/cube.asm):00278                         LDB     <CA
20D5 8D07             (    demo/cube.asm):00279                         BSR     MULS7
20D7 D694             (    demo/cube.asm):00280                         LDB     <SIZE
20D9 8D03             (    demo/cube.asm):00281                         BSR     MULS7
20DB 978E             (    demo/cube.asm):00282                         STA     <TZ+2
20DD 39               (    demo/cube.asm):00283                         RTS
                      (    demo/cube.asm):00284         
                      (    demo/cube.asm):00285         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00286         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    demo/cube.asm):00287         ;   Entry: A, B signed (-127..127)
                      (    demo/cube.asm):00288         ;   Exit:  A = result. B corrupted.
                      (    demo/cube.asm):00289         ;
                      (    demo/cube.asm):00290         ;   The 6809's MUL only does unsigned A * B -> D. So: remember the signs,
                      (    demo/cube.asm):00291         ;   multiply the sizes (absolute values), then put the sign back.
                      (    demo/cube.asm):00292         ;   The result's sign is negative when exactly one input is negative,
                      (    demo/cube.asm):00293         ;   which is what the top bit of (A EOR B) tells us.
                      (    demo/cube.asm):00294         ;
                      (    demo/cube.asm):00295         ;   Dividing D by 128: shifting D left once (ASLB then ROLA, which carries
                      (    demo/cube.asm):00296         ;   B's top bit into A) gives D * 2, and the high byte of D * 2 is D / 128.
                      (    demo/cube.asm):00297         ;   So after the shift the answer is simply in A.
                      (    demo/cube.asm):00298         ; ---------------------------------------------------------------------------
20DE 3406             (    demo/cube.asm):00299         MULS7           PSHS    D               ; save the originals: 0,S = A, 1,S = B
20E0 4D               (    demo/cube.asm):00300                         TSTA                    ; make A positive
20E1 2A01             (    demo/cube.asm):00301                         BPL     MS_1
20E3 40               (    demo/cube.asm):00302                         NEGA
20E4 5D               (    demo/cube.asm):00303         MS_1            TSTB                    ; make B positive
20E5 2A01             (    demo/cube.asm):00304                         BPL     MS_2
20E7 50               (    demo/cube.asm):00305                         NEGB
20E8 3D               (    demo/cube.asm):00306         MS_2            MUL                     ; D = |A| * |B|
20E9 58               (    demo/cube.asm):00307                         ASLB                    ; D * 2 ...
20EA 49               (    demo/cube.asm):00308                         ROLA                    ; ... so A = D / 128
20EB 3402             (    demo/cube.asm):00309                         PSHS    A               ; keep the result. The originals are
                      (    demo/cube.asm):00310                                                 ;  now at 1,S (A) and 2,S (B)
20ED A661             (    demo/cube.asm):00311                         LDA     1,S             ; sign of result = top bit of A EOR B
20EF A862             (    demo/cube.asm):00312                         EORA    2,S             ;  (sets N flag)
20F1 3502             (    demo/cube.asm):00313                         PULS    A               ; result back in A. PULS doesn't
                      (    demo/cube.asm):00314                                                 ;  change the flags, so N survives
20F3 2A01             (    demo/cube.asm):00315                         BPL     MS_3            ; positive: done
20F5 40               (    demo/cube.asm):00316                         NEGA                    ; negative: negate the result
20F6 3262             (    demo/cube.asm):00317         MS_3            LEAS    2,S             ; discard the saved originals
20F8 39               (    demo/cube.asm):00318                         RTS
                      (    demo/cube.asm):00319         
                      (    demo/cube.asm):00320         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00321         ; CORNERS - rotate and project all 8 corners into PX/PY
                      (    demo/cube.asm):00322         ;
                      (    demo/cube.asm):00323         ;   For each corner number VI (0-7):
                      (    demo/cube.asm):00324         ;     rotated x = signed sum of the TX terms       (VSUM)
                      (    demo/cube.asm):00325         ;     rotated z = signed sum of the TZ terms, turned into a table index
                      (    demo/cube.asm):00326         ;     rotated y = signed sum of the TY terms
                      (    demo/cube.asm):00327         ;     screen y  = CY + y * RYTAB[z] / 128         (PMUL)
                      (    demo/cube.asm):00328         ;     screen x  = CX + x * RXTAB[z] / 128
                      (    demo/cube.asm):00329         ; ---------------------------------------------------------------------------
20F9 0F8F             (    demo/cube.asm):00330         CORNERS         CLR     <VI             ; start with corner 0
20FB D68F             (    demo/cube.asm):00331         CN_LOOP         LDB     <VI             ; B = corner number, used by VSUM
20FD CE0086           (    demo/cube.asm):00332                         LDU     #TX             ;  to pick + or - for each term
2100 8D45             (    demo/cube.asm):00333                         BSR     VSUM
2102 9790             (    demo/cube.asm):00334                         STA     <VX             ; rotated x
2104 CE008C           (    demo/cube.asm):00335                         LDU     #TZ             ; (B is preserved by VSUM)
2107 8D3E             (    demo/cube.asm):00336                         BSR     VSUM            ; rotated z, range about -60..60
2109 8B40             (    demo/cube.asm):00337                         ADDA    #64             ; shift to 0..127 to index the tables
210B 9791             (    demo/cube.asm):00338                         STA     <ZI
210D CE0089           (    demo/cube.asm):00339                         LDU     #TY
2110 8D35             (    demo/cube.asm):00340                         BSR     VSUM            ; rotated y, left in A
                      (    demo/cube.asm):00341         
                      (    demo/cube.asm):00342         ; screen y = CY + y * RYTAB[z] / 128
2112 308D021F         (    demo/cube.asm):00343                         LEAX    RYTAB,PCR       ; B = RYTAB[ZI]
2116 D691             (    demo/cube.asm):00344                         LDB     <ZI
2118 3A               (    demo/cube.asm):00345                         ABX
2119 E684             (    demo/cube.asm):00346                         LDB     ,X
211B 8D49             (    demo/cube.asm):00347                         BSR     PMUL            ; A = y * RYTAB[z] / 128
211D 8B24             (    demo/cube.asm):00348                         ADDA    #CY
211F 8E00A8           (    demo/cube.asm):00349                         LDX     #PY             ; store at PY + VI
2122 D68F             (    demo/cube.asm):00350                         LDB     <VI
2124 3A               (    demo/cube.asm):00351                         ABX
2125 A784             (    demo/cube.asm):00352                         STA     ,X
                      (    demo/cube.asm):00353         
                      (    demo/cube.asm):00354         ; screen x = CX + x * RXTAB[z] / 128
2127 308D018A         (    demo/cube.asm):00355                         LEAX    RXTAB,PCR       ; B = RXTAB[ZI]
212B D691             (    demo/cube.asm):00356                         LDB     <ZI
212D 3A               (    demo/cube.asm):00357                         ABX
212E E684             (    demo/cube.asm):00358                         LDB     ,X
2130 9690             (    demo/cube.asm):00359                         LDA     <VX             ; A = rotated x
2132 8D32             (    demo/cube.asm):00360                         BSR     PMUL
2134 8B27             (    demo/cube.asm):00361                         ADDA    #CX
2136 8E00A0           (    demo/cube.asm):00362                         LDX     #PX             ; store at PX + VI
2139 D68F             (    demo/cube.asm):00363                         LDB     <VI
213B 3A               (    demo/cube.asm):00364                         ABX
213C A784             (    demo/cube.asm):00365                         STA     ,X
                      (    demo/cube.asm):00366         
213E 0C8F             (    demo/cube.asm):00367                         INC     <VI             ; next corner, until all 8 done
2140 968F             (    demo/cube.asm):00368                         LDA     <VI
2142 8108             (    demo/cube.asm):00369                         CMPA    #8
2144 26B5             (    demo/cube.asm):00370                         BNE     CN_LOOP
2146 39               (    demo/cube.asm):00371                         RTS
                      (    demo/cube.asm):00372         
                      (    demo/cube.asm):00373         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00374         ; VSUM - one rotated coordinate of one corner
                      (    demo/cube.asm):00375         ;   Entry: U -> the three terms for this coordinate (TX, TY or TZ)
                      (    demo/cube.asm):00376         ;          B = corner number: bit 0 set means x = +S, clear means x = -S;
                      (    demo/cube.asm):00377         ;              bit 1 likewise for y, bit 2 for z
                      (    demo/cube.asm):00378         ;   Exit:  A = term0 * (+/-1) + term1 * (+/-1) + term2 * (+/-1)
                      (    demo/cube.asm):00379         ;          B preserved (so the caller can reuse it for the next coordinate)
                      (    demo/cube.asm):00380         ; ---------------------------------------------------------------------------
2147 4F               (    demo/cube.asm):00381         VSUM            CLRA                    ; running total
2148 C501             (    demo/cube.asm):00382                         BITB    #1              ; x sign: add or subtract term 0
214A 2704             (    demo/cube.asm):00383                         BEQ     VS_1
214C ABC4             (    demo/cube.asm):00384                         ADDA    ,U
214E 2002             (    demo/cube.asm):00385                         BRA     VS_2
2150 A0C4             (    demo/cube.asm):00386         VS_1            SUBA    ,U
2152 C502             (    demo/cube.asm):00387         VS_2            BITB    #2              ; y sign: term 1
2154 2704             (    demo/cube.asm):00388                         BEQ     VS_3
2156 AB41             (    demo/cube.asm):00389                         ADDA    1,U
2158 2002             (    demo/cube.asm):00390                         BRA     VS_4
215A A041             (    demo/cube.asm):00391         VS_3            SUBA    1,U
215C C504             (    demo/cube.asm):00392         VS_4            BITB    #4              ; z sign: term 2
215E 2703             (    demo/cube.asm):00393                         BEQ     VS_5
2160 AB42             (    demo/cube.asm):00394                         ADDA    2,U
2162 39               (    demo/cube.asm):00395                         RTS
2163 A042             (    demo/cube.asm):00396         VS_5            SUBA    2,U
2165 39               (    demo/cube.asm):00397                         RTS
                      (    demo/cube.asm):00398         
                      (    demo/cube.asm):00399         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00400         ; PMUL - projection multiply: A = (A * B) / 128
                      (    demo/cube.asm):00401         ;   Entry: A = coordinate (signed), B = scale from RXTAB/RYTAB (unsigned)
                      (    demo/cube.asm):00402         ;   Exit:  A = result. B corrupted.
                      (    demo/cube.asm):00403         ;
                      (    demo/cube.asm):00404         ;   Like MULS7, but only A can be negative, so: make A positive, MUL,
                      (    demo/cube.asm):00405         ;   divide by 128 the same way (ASLB/ROLA leaves D/128 in A), and negate
                      (    demo/cube.asm):00406         ;   the answer if A was negative.
                      (    demo/cube.asm):00407         ; ---------------------------------------------------------------------------
2166 4D               (    demo/cube.asm):00408         PMUL            TSTA
2167 2A06             (    demo/cube.asm):00409                         BPL     PM_1
2169 40               (    demo/cube.asm):00410                         NEGA                    ; negative coordinate:
216A 3D               (    demo/cube.asm):00411                         MUL                     ;  |A| * B
216B 58               (    demo/cube.asm):00412                         ASLB                    ;  / 128
216C 49               (    demo/cube.asm):00413                         ROLA
216D 40               (    demo/cube.asm):00414                         NEGA                    ;  and make it negative again
216E 39               (    demo/cube.asm):00415                         RTS
216F 3D               (    demo/cube.asm):00416         PM_1            MUL                     ; positive coordinate: A * B
2170 58               (    demo/cube.asm):00417                         ASLB                    ;  / 128
2171 49               (    demo/cube.asm):00418                         ROLA
2172 39               (    demo/cube.asm):00419                         RTS
                      (    demo/cube.asm):00420         
                      (    demo/cube.asm):00421         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00422         ; EDGES - draw the 12 edges
                      (    demo/cube.asm):00423         ;
                      (    demo/cube.asm):00424         ;   EDGETAB lists the 12 edges as pairs of corner numbers. For each pair,
                      (    demo/cube.asm):00425         ;   look up both corners' screen positions in PX/PY and draw a line.
                      (    demo/cube.asm):00426         ;   TGL_LINEC (the clipped line) is used because, when the cube is zoomed
                      (    demo/cube.asm):00427         ;   right in, some corners land off the screen.
                      (    demo/cube.asm):00428         ;
                      (    demo/cube.asm):00429         ;   Y walks through EDGETAB two bytes at a time: 0,Y is the start corner,
                      (    demo/cube.asm):00430         ;   1,Y the end corner.
                      (    demo/cube.asm):00431         ; ---------------------------------------------------------------------------
2173 318D0026         (    demo/cube.asm):00432         EDGES           LEAY    EDGETAB,PCR
2177 860C             (    demo/cube.asm):00433                         LDA     #12             ; 12 edges to draw
2179 9792             (    demo/cube.asm):00434                         STA     <EC
217B 8E00A0           (    demo/cube.asm):00435         ED_LOOP         LDX     #PX             ; end corner's position -> U
217E E621             (    demo/cube.asm):00436                         LDB     1,Y             ;  X -> PX + end corner
2180 3A               (    demo/cube.asm):00437                         ABX
2181 A684             (    demo/cube.asm):00438                         LDA     ,X              ;  A = its x
2183 E608             (    demo/cube.asm):00439                         LDB     8,X             ;  B = its y (PY = PX + 8)
2185 1F03             (    demo/cube.asm):00440                         TFR     D,U             ;  park x1:y1 in U for now
2187 8E00A0           (    demo/cube.asm):00441                         LDX     #PX             ; start corner's position -> A, B
218A E6A4             (    demo/cube.asm):00442                         LDB     ,Y
218C 3A               (    demo/cube.asm):00443                         ABX
218D A684             (    demo/cube.asm):00444                         LDA     ,X              ;  A = x0
218F E608             (    demo/cube.asm):00445                         LDB     8,X             ;  B = y0
2191 1F31             (    demo/cube.asm):00446                         TFR     U,X             ; X = x1:y1, the packed end point
2193 BD1018           (    demo/cube.asm):00447                         JSR     TGL_LINEC
2196 3122             (    demo/cube.asm):00448                         LEAY    2,Y             ; next pair
2198 0A92             (    demo/cube.asm):00449                         DEC     <EC
219A 26DF             (    demo/cube.asm):00450                         BNE     ED_LOOP
219C 39               (    demo/cube.asm):00451                         RTS
                      (    demo/cube.asm):00452         
                      (    demo/cube.asm):00453         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00454         ; The 12 edges, as pairs of corner numbers. Corners differing only in bit 0
                      (    demo/cube.asm):00455         ; are joined by an edge running along x; bit 1 along y; bit 2 along z.
                      (    demo/cube.asm):00456         ; ---------------------------------------------------------------------------
219D 0001020304050607 (    demo/cube.asm):00457         EDGETAB         FCB     0,1,2,3,4,5,6,7         ; edges along x
21A5 0002010304060507 (    demo/cube.asm):00458                         FCB     0,2,1,3,4,6,5,7         ; edges along y
21AD 0004010502060307 (    demo/cube.asm):00459                         FCB     0,4,1,5,2,6,3,7         ; edges along z
                      (    demo/cube.asm):00460         
