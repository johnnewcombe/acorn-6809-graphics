                      (    demo/cube.asm):00001         ; ===========================================================================
                      (    demo/cube.asm):00002         ; Rotating cube demo for the teletext graphics library
                      (    demo/cube.asm):00003         ;
                      (    demo/cube.asm):00004         ;   A wireframe cube that tumbles about two axes and slowly zooms in and out,
                      (    demo/cube.asm):00005         ;   drawn in perspective. Press any key to exit.
                      (    demo/cube.asm):00006         ;
                      (    demo/cube.asm):00007         ;   Loading: tgl.bin at $1000 (TGL_BASE below), cube.bin at $2000 (its ORG).
                      (    demo/cube.asm):00008         ;   Run from START ($2000). Works with either machine's library build.
                      (    demo/cube.asm):00009         ;
                      (    demo/cube.asm):00010         ;   Each frame:
                      (    demo/cube.asm):00011         ;     1. clear the off-screen buffer                       (TGL_CLS)
                      (    demo/cube.asm):00012         ;     2. work out this frame's size from the zoom phase    (ZOOMSZ)
                      (    demo/cube.asm):00013         ;     3. build the rotation for this frame's angles        (MATRIX)
                      (    demo/cube.asm):00014         ;     4. rotate the 8 corners and project them to screen   (CORNERS)
                      (    demo/cube.asm):00015         ;     5. draw the 12 edges between corners                 (EDGES)
                      (    demo/cube.asm):00016         ;     6. wait for the frame period to run out              (TGL_PACE)
                      (    demo/cube.asm):00017         ;     7. copy the buffer to the screen                     (TGL_BLIT)
                      (    demo/cube.asm):00018         ;     8. advance the angles and zoom, check for a key, repeat
                      (    demo/cube.asm):00019         ;   TGL_PACE keeps every frame the same length, so the cube turns at an
                      (    demo/cube.asm):00020         ;   even speed instead of slowing down as it zooms in.
                      (    demo/cube.asm):00021         ;   Drawing off-screen and blitting the finished frame means no flicker.
                      (    demo/cube.asm):00022         ;
                      (    demo/cube.asm):00023         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00024         ; The maths, and how it is kept cheap on an 8-bit CPU
                      (    demo/cube.asm):00025         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00026         ;
                      (    demo/cube.asm):00027         ;   Fixed point. Sines and cosines are stored as signed bytes where 127
                      (    demo/cube.asm):00028         ;   stands for 1.0 (so 64 is about 0.5, -127 is -1.0). Multiplying two such
                      (    demo/cube.asm):00029         ;   numbers gives a result 128 times too big, so products are divided by
                      (    demo/cube.asm):00030         ;   128 afterwards (see MULS7).
                      (    demo/cube.asm):00031         ;
                      (    demo/cube.asm):00032         ;   Angles. A full circle is 256 steps instead of 360 degrees, so an angle
                      (    demo/cube.asm):00033         ;   fits in one byte and wraps round by itself when it overflows. A quarter
                      (    demo/cube.asm):00034         ;   turn is 64 steps, which gives cos(a) = sin(a + 64): one sine table
                      (    demo/cube.asm):00035         ;   serves for both.
                      (    demo/cube.asm):00036         ;
                      (    demo/cube.asm):00037         ;   Rotation. The cube is centred on the origin, so its corners are every
                      (    demo/cube.asm):00038         ;   combination of (+S or -S, +S or -S, +S or -S), where S is half the edge
                      (    demo/cube.asm):00039         ;   length. Rotating a point means multiplying it by a 3x3 matrix:
                      (    demo/cube.asm):00040         ;
                      (    demo/cube.asm):00041         ;       rotated x = m00*x + m01*y + m02*z      (and similarly for y, z)
                      (    demo/cube.asm):00042         ;
                      (    demo/cube.asm):00043         ;   With every coordinate being +S or -S, each product is just +/-(m * S).
                      (    demo/cube.asm):00044         ;   So once per frame we work out the nine values m*S (the "terms" TX, TY,
                      (    demo/cube.asm):00045         ;   TZ), and then every rotated corner coordinate is three of those terms
                      (    demo/cube.asm):00046         ;   added or subtracted according to the corner's signs. That's 8 multiplies
                      (    demo/cube.asm):00047         ;   per frame for the whole cube, instead of 9 per corner.
                      (    demo/cube.asm):00048         ;
                      (    demo/cube.asm):00049         ;   Perspective. Further-away points should be drawn closer to the centre:
                      (    demo/cube.asm):00050         ;
                      (    demo/cube.asm):00051         ;       screen x = centre + x * F / (distance + z)
                      (    demo/cube.asm):00052         ;
                      (    demo/cube.asm):00053         ;   Dividing is slow on a 6809, so the value F / (distance + z), suitably
                      (    demo/cube.asm):00054         ;   scaled, is precomputed for every possible z and stored in a table
                      (    demo/cube.asm):00055         ;   (RXTAB, RYTAB). Projecting is then one table lookup and one MUL.
                      (    demo/cube.asm):00056         ;   The x table uses a smaller F than the y table because teletext pixels
                      (    demo/cube.asm):00057         ;   are wider than they are tall; this keeps the cube looking square.
                      (    demo/cube.asm):00058         ;
                      (    demo/cube.asm):00059         ;   Corner numbering. Corners are numbered 0-7. Bit 0 of the number says
                      (    demo/cube.asm):00060         ;   whether the corner's x is +S (bit set) or -S (bit clear); bit 1 does
                      (    demo/cube.asm):00061         ;   the same for y and bit 2 for z. Two corners are joined by an edge when
                      (    demo/cube.asm):00062         ;   their numbers differ in exactly one bit (see EDGETAB).
                      (    demo/cube.asm):00063         ;
                      (    demo/cube.asm):00064         ;   Build with -D TESTFRAMES=n to stop after n frames (used by the emulator
                      (    demo/cube.asm):00065         ;   tests; a normal build runs until a key is pressed).
                      (    demo/cube.asm):00066         ; ===========================================================================
                      (    demo/cube.asm):00067         
                      (    demo/cube.asm):00068         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00069         ; Library entry points (see tgl_api.inc)
                      (    demo/cube.asm):00070         ; ---------------------------------------------------------------------------
     1000             (    demo/cube.asm):00071         TGL_BASE        EQU     $1000
                      (    demo/cube.asm):00072                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
                      (      tgl_api.inc):00030         
     03C0             (      tgl_api.inc):00031         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00032         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00033         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00034         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00035         
                      (      tgl_api.inc):00036         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00037         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00038         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00039         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00040         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00041         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00042         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00043         TGL_WHITE       EQU     7
                      (    demo/cube.asm):00073         
                      (    demo/cube.asm):00074         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00075         ; Memory
                      (    demo/cube.asm):00076         ; ---------------------------------------------------------------------------
     3000             (    demo/cube.asm):00077         BUFFER          EQU     $3000           ; off-screen buffer (960 bytes)
     0200             (    demo/cube.asm):00078         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    demo/cube.asm):00079         
                      (    demo/cube.asm):00080         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00081         ; Settings you can change
                      (    demo/cube.asm):00082         ; ---------------------------------------------------------------------------
     0015             (    demo/cube.asm):00083         SIZE_MID        EQU     21              ; middle of the zoom range; the half
                      (    demo/cube.asm):00084                                                 ;  edge length pulses 5..36 around it
     0027             (    demo/cube.asm):00085         CX              EQU     39              ; screen position of the cube's centre
     0024             (    demo/cube.asm):00086         CY              EQU     36
     0002             (    demo/cube.asm):00087         STEP_A          EQU     2               ; rotation speed about x (per frame,
     0003             (    demo/cube.asm):00088         STEP_B          EQU     3               ;  and about y; 256 = a full turn)
     0001             (    demo/cube.asm):00089         STEP_Z          EQU     1               ; zoom speed (256 steps per in-and-out)
     0002             (    demo/cube.asm):00090         PACE_TICKS      EQU     2               ; frame length in 50Hz ticks: 2 = 25
                      (    demo/cube.asm):00091                                                 ;  frames per second. If the cube
                      (    demo/cube.asm):00092                                                 ;  slows when zoomed in, try 3
                      (    demo/cube.asm):00093         
                      (    demo/cube.asm):00094         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00095         ; Variables, in page zero so they can use fast direct addressing.
                      (    demo/cube.asm):00096         ; The library's own workspace is $00-$17, so these start at $80.
                      (    demo/cube.asm):00097         ; ---------------------------------------------------------------------------
     0080             (    demo/cube.asm):00098         ANG_A           EQU     $80             ; rotation angle about x (0-255)
     0081             (    demo/cube.asm):00099         ANG_B           EQU     $81             ; rotation angle about y (0-255)
     0082             (    demo/cube.asm):00100         SA              EQU     $82             ; sin(ANG_A)   (127 = 1.0)
     0083             (    demo/cube.asm):00101         CA              EQU     $83             ; cos(ANG_A)
     0084             (    demo/cube.asm):00102         SB              EQU     $84             ; sin(ANG_B)
     0085             (    demo/cube.asm):00103         CB              EQU     $85             ; cos(ANG_B)
     0086             (    demo/cube.asm):00104         TX              EQU     $86             ; 3 bytes: terms for rotated x
     0089             (    demo/cube.asm):00105         TY              EQU     $89             ; 3 bytes: terms for rotated y
     008C             (    demo/cube.asm):00106         TZ              EQU     $8C             ; 3 bytes: terms for rotated z
     008F             (    demo/cube.asm):00107         VI              EQU     $8F             ; corner number being worked on (0-7)
     0090             (    demo/cube.asm):00108         VX              EQU     $90             ; that corner's rotated x
     0091             (    demo/cube.asm):00109         ZI              EQU     $91             ; its depth, as an index into RXTAB/RYTAB
     0092             (    demo/cube.asm):00110         EC              EQU     $92             ; edges left to draw
     0093             (    demo/cube.asm):00111         FRAMES          EQU     $93             ; frame counter (test builds only)
     0094             (    demo/cube.asm):00112         SIZE            EQU     $94             ; this frame's half edge length (S)
     0095             (    demo/cube.asm):00113         ZOOM            EQU     $95             ; zoom phase (0-255, like an angle)
     00A0             (    demo/cube.asm):00114         PX              EQU     $A0             ; 8 bytes: screen x of corners 0-7
     00A8             (    demo/cube.asm):00115         PY              EQU     $A8             ; 8 bytes: screen y of corners 0-7.
                      (    demo/cube.asm):00116                                                 ;  PY is exactly PX+8, so if X points
                      (    demo/cube.asm):00117                                                 ;  at a corner's PX entry, its PY is
                      (    demo/cube.asm):00118                                                 ;  at 8,X
                      (    demo/cube.asm):00119         
                      (    demo/cube.asm):00120                         ORG     $2000
                      (    demo/cube.asm):00121         
                      (    demo/cube.asm):00122         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00123         ; Set up
                      (    demo/cube.asm):00124         ; ---------------------------------------------------------------------------
2000 10CE0200         (    demo/cube.asm):00125         START           LDS     #STACK_TOP
2004 4F               (    demo/cube.asm):00126                         CLRA                    ; DP = $00: the library (and our
2005 1F8B             (    demo/cube.asm):00127                         TFR     A,DP            ;  variables) use direct addressing
     00               (    demo/cube.asm):00128                         SETDP   $00             ;  in page zero
2007 1CEF             (    demo/cube.asm):00129                         ANDCC   #$EF            ; enable IRQs: the keyboard is read
                      (    demo/cube.asm):00130                                                 ;  under interrupt
2009 BD1000           (    demo/cube.asm):00131                         JSR     TGL_INIT        ; reset CRTC start, hide cursor
200C 8E3000           (    demo/cube.asm):00132                         LDX     #BUFFER         ; draw into our buffer at $3000
200F BD1003           (    demo/cube.asm):00133                         JSR     TGL_SETBUF
2012 0F80             (    demo/cube.asm):00134                         CLR     <ANG_A          ; start square-on, mid zoom
2014 0F81             (    demo/cube.asm):00135                         CLR     <ANG_B
2016 0F93             (    demo/cube.asm):00136                         CLR     <FRAMES
2018 0F95             (    demo/cube.asm):00137                         CLR     <ZOOM
                      (    demo/cube.asm):00138         
                      (    demo/cube.asm):00139         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00140         ; Main loop: one pass per frame
                      (    demo/cube.asm):00141         ; ---------------------------------------------------------------------------
201A BD1006           (    demo/cube.asm):00142         FRAME           JSR     TGL_CLS         ; blank the buffer
201D 8D2E             (    demo/cube.asm):00143                         BSR     ZOOMSZ          ; SIZE for this frame
201F 17003C           (    demo/cube.asm):00144                         LBSR    MATRIX          ; terms TX, TY, TZ for this frame
2022 1700D9           (    demo/cube.asm):00145                         LBSR    CORNERS         ; screen positions PX, PY
2025 170150           (    demo/cube.asm):00146                         LBSR    EDGES           ; draw into the buffer
2028 8602             (    demo/cube.asm):00147                         LDA     #PACE_TICKS     ; wait for the frame period, so every
202A BD103C           (    demo/cube.asm):00148                         JSR     TGL_PACE        ;  frame takes the same time
202D BD1012           (    demo/cube.asm):00149                         JSR     TGL_BLIT        ; show it
                      (    demo/cube.asm):00150         
                      (    demo/cube.asm):00151         ; Advance the angles and zoom phase. Being bytes, they wrap from 255 back
                      (    demo/cube.asm):00152         ; to 0 by themselves, which is exactly one full turn.
2030 9680             (    demo/cube.asm):00153                         LDA     <ANG_A
2032 8B02             (    demo/cube.asm):00154                         ADDA    #STEP_A
2034 9780             (    demo/cube.asm):00155                         STA     <ANG_A
2036 9681             (    demo/cube.asm):00156                         LDA     <ANG_B
2038 8B03             (    demo/cube.asm):00157                         ADDA    #STEP_B
203A 9781             (    demo/cube.asm):00158                         STA     <ANG_B
203C 9695             (    demo/cube.asm):00159                         LDA     <ZOOM
203E 8B01             (    demo/cube.asm):00160                         ADDA    #STEP_Z
2040 9795             (    demo/cube.asm):00161                         STA     <ZOOM
                      (    demo/cube.asm):00162         
                      (    demo/cube.asm):00163         ; Any key exits. TGL_INKEY returns Z clear if a key was pressed, and
                      (    demo/cube.asm):00164         ; TGL_EXIT never returns, so a long branch straight to it is enough.
2042 BD101E           (    demo/cube.asm):00165                         JSR     TGL_INKEY
2045 1026EFD8         (    demo/cube.asm):00166                         LBNE    TGL_EXIT
                      (    demo/cube.asm):00167         
                      (    demo/cube.asm):00168         ; Test builds stop after TESTFRAMES frames so the emulator can inspect
                      (    demo/cube.asm):00169         ; the result. Normal builds skip this.
                      (    demo/cube.asm):00170                         IFDEF   TESTFRAMES
                      (    demo/cube.asm):00171                         INC     <FRAMES
                      (    demo/cube.asm):00172                         LDA     <FRAMES
                      (    demo/cube.asm):00173                         CMPA    #TESTFRAMES
                      (    demo/cube.asm):00174                         BEQ     DONE
                      (    demo/cube.asm):00175                         ENDC
2049 20CF             (    demo/cube.asm):00176                         BRA     FRAME
204B 20FE             (    demo/cube.asm):00177         DONE            BRA     DONE
                      (    demo/cube.asm):00178         
                      (    demo/cube.asm):00179         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00180         ; ZOOMSZ - set SIZE from the zoom phase
                      (    demo/cube.asm):00181         ;
                      (    demo/cube.asm):00182         ;   SIZE = SIZE_MID + sin(ZOOM)/8, which swings smoothly between 5 and 36
                      (    demo/cube.asm):00183         ;   as ZOOM goes round. From about 26 upwards the cube overhangs the screen
                      (    demo/cube.asm):00184         ;   and TGL_LINEC clips it. Don't go above 36: beyond that the depth no
                      (    demo/cube.asm):00185         ;   longer fits the projection tables (-64..63), and projected points no
                      (    demo/cube.asm):00186         ;   longer fit the signed -128..127 that TGL_LINEC accepts.
                      (    demo/cube.asm):00187         ; ---------------------------------------------------------------------------
204D 308D0169         (    demo/cube.asm):00188         ZOOMSZ          LEAX    SINTAB,PCR      ; X -> sine table
2051 D695             (    demo/cube.asm):00189                         LDB     <ZOOM           ; X -> sin(ZOOM). ABX adds B as an
2053 3A               (    demo/cube.asm):00190                         ABX                     ;  UNSIGNED byte (0-255). "LDA B,X"
                      (    demo/cube.asm):00191                                                 ;  would treat B as signed and read
                      (    demo/cube.asm):00192                                                 ;  before the table for B >= 128
2054 A684             (    demo/cube.asm):00193                         LDA     ,X              ; A = sin(ZOOM), -127..127
2056 47               (    demo/cube.asm):00194                         ASRA                    ; divide by 8. ASR keeps the sign bit,
2057 47               (    demo/cube.asm):00195                         ASRA                    ;  so negative numbers stay negative:
2058 47               (    demo/cube.asm):00196                         ASRA                    ;  -127..127 becomes -16..15
2059 8B15             (    demo/cube.asm):00197                         ADDA    #SIZE_MID       ; 5..36
205B 9794             (    demo/cube.asm):00198                         STA     <SIZE
205D 39               (    demo/cube.asm):00199                         RTS
                      (    demo/cube.asm):00200         
                      (    demo/cube.asm):00201         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00202         ; MATRIX - work out this frame's nine terms
                      (    demo/cube.asm):00203         ;
                      (    demo/cube.asm):00204         ;   The cube is turned first about the y axis (angle B), then about the x
                      (    demo/cube.asm):00205         ;   axis (angle A). Multiplying those two rotations together gives this
                      (    demo/cube.asm):00206         ;   matrix (each entry scaled so 127 = 1.0):
                      (    demo/cube.asm):00207         ;
                      (    demo/cube.asm):00208         ;               x part      y part     z part
                      (    demo/cube.asm):00209         ;     row x: [  cb,         0,         sb       ]
                      (    demo/cube.asm):00210         ;     row y: [  sb*sa,      ca,       -cb*sa    ]
                      (    demo/cube.asm):00211         ;     row z: [ -sb*ca,      sa,        cb*ca    ]
                      (    demo/cube.asm):00212         ;
                      (    demo/cube.asm):00213         ;   Each entry is then multiplied by SIZE to give the terms, e.g.
                      (    demo/cube.asm):00214         ;   TX = [ cb*S, 0, sb*S ]. Two-factor entries like sb*sa need two
                      (    demo/cube.asm):00215         ;   multiplies: first sb*sa, then that result * S.
                      (    demo/cube.asm):00216         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00217         
                      (    demo/cube.asm):00218         ; Look up the four sines and cosines. Each lookup: X -> table, add the
                      (    demo/cube.asm):00219         ; angle (unsigned, via ABX), read the byte. cos uses angle + 64.
205E 308D0158         (    demo/cube.asm):00220         MATRIX          LEAX    SINTAB,PCR      ; SA = sin(ANG_A)
2062 D680             (    demo/cube.asm):00221                         LDB     <ANG_A
2064 3A               (    demo/cube.asm):00222                         ABX
2065 A684             (    demo/cube.asm):00223                         LDA     ,X
2067 9782             (    demo/cube.asm):00224                         STA     <SA
2069 308D014D         (    demo/cube.asm):00225                         LEAX    SINTAB,PCR      ; CA = cos(ANG_A) = sin(ANG_A + 64)
206D D680             (    demo/cube.asm):00226                         LDB     <ANG_A
206F CB40             (    demo/cube.asm):00227                         ADDB    #64             ; (wraps round past 255 correctly)
2071 3A               (    demo/cube.asm):00228                         ABX
2072 A684             (    demo/cube.asm):00229                         LDA     ,X
2074 9783             (    demo/cube.asm):00230                         STA     <CA
2076 308D0140         (    demo/cube.asm):00231                         LEAX    SINTAB,PCR      ; SB = sin(ANG_B)
207A D681             (    demo/cube.asm):00232                         LDB     <ANG_B
207C 3A               (    demo/cube.asm):00233                         ABX
207D A684             (    demo/cube.asm):00234                         LDA     ,X
207F 9784             (    demo/cube.asm):00235                         STA     <SB
2081 308D0135         (    demo/cube.asm):00236                         LEAX    SINTAB,PCR      ; CB = cos(ANG_B)
2085 D681             (    demo/cube.asm):00237                         LDB     <ANG_B
2087 CB40             (    demo/cube.asm):00238                         ADDB    #64
2089 3A               (    demo/cube.asm):00239                         ABX
208A A684             (    demo/cube.asm):00240                         LDA     ,X
208C 9785             (    demo/cube.asm):00241                         STA     <CB
                      (    demo/cube.asm):00242         
                      (    demo/cube.asm):00243         ; Row x: TX = S * [ cb, 0, sb ]
208E 9685             (    demo/cube.asm):00244                         LDA     <CB             ; TX+0 = cb * S
2090 D694             (    demo/cube.asm):00245                         LDB     <SIZE
2092 8D4F             (    demo/cube.asm):00246                         BSR     MULS7
2094 9786             (    demo/cube.asm):00247                         STA     <TX
2096 0F87             (    demo/cube.asm):00248                         CLR     <TX+1           ; TX+1 = 0 (this entry is always 0)
2098 9684             (    demo/cube.asm):00249                         LDA     <SB             ; TX+2 = sb * S
209A D694             (    demo/cube.asm):00250                         LDB     <SIZE
209C 8D45             (    demo/cube.asm):00251                         BSR     MULS7
209E 9788             (    demo/cube.asm):00252                         STA     <TX+2
                      (    demo/cube.asm):00253         
                      (    demo/cube.asm):00254         ; Row y: TY = S * [ sb*sa, ca, -cb*sa ]
20A0 9684             (    demo/cube.asm):00255                         LDA     <SB             ; TY+0 = (sb * sa) * S
20A2 D682             (    demo/cube.asm):00256                         LDB     <SA
20A4 8D3D             (    demo/cube.asm):00257                         BSR     MULS7           ;  A = sb * sa
20A6 D694             (    demo/cube.asm):00258                         LDB     <SIZE
20A8 8D39             (    demo/cube.asm):00259                         BSR     MULS7           ;  A = that * S
20AA 9789             (    demo/cube.asm):00260                         STA     <TY
20AC 9683             (    demo/cube.asm):00261                         LDA     <CA             ; TY+1 = ca * S
20AE D694             (    demo/cube.asm):00262                         LDB     <SIZE
20B0 8D31             (    demo/cube.asm):00263                         BSR     MULS7
20B2 978A             (    demo/cube.asm):00264                         STA     <TY+1
20B4 9685             (    demo/cube.asm):00265                         LDA     <CB             ; TY+2 = -(cb * sa) * S
20B6 D682             (    demo/cube.asm):00266                         LDB     <SA
20B8 8D29             (    demo/cube.asm):00267                         BSR     MULS7
20BA 40               (    demo/cube.asm):00268                         NEGA
20BB D694             (    demo/cube.asm):00269                         LDB     <SIZE
20BD 8D24             (    demo/cube.asm):00270                         BSR     MULS7
20BF 978B             (    demo/cube.asm):00271                         STA     <TY+2
                      (    demo/cube.asm):00272         
                      (    demo/cube.asm):00273         ; Row z: TZ = S * [ -sb*ca, sa, cb*ca ]
20C1 9684             (    demo/cube.asm):00274                         LDA     <SB             ; TZ+0 = -(sb * ca) * S
20C3 D683             (    demo/cube.asm):00275                         LDB     <CA
20C5 8D1C             (    demo/cube.asm):00276                         BSR     MULS7
20C7 40               (    demo/cube.asm):00277                         NEGA
20C8 D694             (    demo/cube.asm):00278                         LDB     <SIZE
20CA 8D17             (    demo/cube.asm):00279                         BSR     MULS7
20CC 978C             (    demo/cube.asm):00280                         STA     <TZ
20CE 9682             (    demo/cube.asm):00281                         LDA     <SA             ; TZ+1 = sa * S
20D0 D694             (    demo/cube.asm):00282                         LDB     <SIZE
20D2 8D0F             (    demo/cube.asm):00283                         BSR     MULS7
20D4 978D             (    demo/cube.asm):00284                         STA     <TZ+1
20D6 9685             (    demo/cube.asm):00285                         LDA     <CB             ; TZ+2 = (cb * ca) * S
20D8 D683             (    demo/cube.asm):00286                         LDB     <CA
20DA 8D07             (    demo/cube.asm):00287                         BSR     MULS7
20DC D694             (    demo/cube.asm):00288                         LDB     <SIZE
20DE 8D03             (    demo/cube.asm):00289                         BSR     MULS7
20E0 978E             (    demo/cube.asm):00290                         STA     <TZ+2
20E2 39               (    demo/cube.asm):00291                         RTS
                      (    demo/cube.asm):00292         
                      (    demo/cube.asm):00293         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00294         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    demo/cube.asm):00295         ;   Entry: A, B signed (-127..127)
                      (    demo/cube.asm):00296         ;   Exit:  A = result. B corrupted.
                      (    demo/cube.asm):00297         ;
                      (    demo/cube.asm):00298         ;   The 6809's MUL only does unsigned A * B -> D. So: remember the signs,
                      (    demo/cube.asm):00299         ;   multiply the sizes (absolute values), then put the sign back.
                      (    demo/cube.asm):00300         ;   The result's sign is negative when exactly one input is negative,
                      (    demo/cube.asm):00301         ;   which is what the top bit of (A EOR B) tells us.
                      (    demo/cube.asm):00302         ;
                      (    demo/cube.asm):00303         ;   Dividing D by 128: shifting D left once (ASLB then ROLA, which carries
                      (    demo/cube.asm):00304         ;   B's top bit into A) gives D * 2, and the high byte of D * 2 is D / 128.
                      (    demo/cube.asm):00305         ;   So after the shift the answer is simply in A.
                      (    demo/cube.asm):00306         ; ---------------------------------------------------------------------------
20E3 3406             (    demo/cube.asm):00307         MULS7           PSHS    D               ; save the originals: 0,S = A, 1,S = B
20E5 4D               (    demo/cube.asm):00308                         TSTA                    ; make A positive
20E6 2A01             (    demo/cube.asm):00309                         BPL     MS_1
20E8 40               (    demo/cube.asm):00310                         NEGA
20E9 5D               (    demo/cube.asm):00311         MS_1            TSTB                    ; make B positive
20EA 2A01             (    demo/cube.asm):00312                         BPL     MS_2
20EC 50               (    demo/cube.asm):00313                         NEGB
20ED 3D               (    demo/cube.asm):00314         MS_2            MUL                     ; D = |A| * |B|
20EE 58               (    demo/cube.asm):00315                         ASLB                    ; D * 2 ...
20EF 49               (    demo/cube.asm):00316                         ROLA                    ; ... so A = D / 128
20F0 3402             (    demo/cube.asm):00317                         PSHS    A               ; keep the result. The originals are
                      (    demo/cube.asm):00318                                                 ;  now at 1,S (A) and 2,S (B)
20F2 A661             (    demo/cube.asm):00319                         LDA     1,S             ; sign of result = top bit of A EOR B
20F4 A862             (    demo/cube.asm):00320                         EORA    2,S             ;  (sets N flag)
20F6 3502             (    demo/cube.asm):00321                         PULS    A               ; result back in A. PULS doesn't
                      (    demo/cube.asm):00322                                                 ;  change the flags, so N survives
20F8 2A01             (    demo/cube.asm):00323                         BPL     MS_3            ; positive: done
20FA 40               (    demo/cube.asm):00324                         NEGA                    ; negative: negate the result
20FB 3262             (    demo/cube.asm):00325         MS_3            LEAS    2,S             ; discard the saved originals
20FD 39               (    demo/cube.asm):00326                         RTS
                      (    demo/cube.asm):00327         
                      (    demo/cube.asm):00328         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00329         ; CORNERS - rotate and project all 8 corners into PX/PY
                      (    demo/cube.asm):00330         ;
                      (    demo/cube.asm):00331         ;   For each corner number VI (0-7):
                      (    demo/cube.asm):00332         ;     rotated x = signed sum of the TX terms       (VSUM)
                      (    demo/cube.asm):00333         ;     rotated z = signed sum of the TZ terms, turned into a table index
                      (    demo/cube.asm):00334         ;     rotated y = signed sum of the TY terms
                      (    demo/cube.asm):00335         ;     screen y  = CY + y * RYTAB[z] / 128         (PMUL)
                      (    demo/cube.asm):00336         ;     screen x  = CX + x * RXTAB[z] / 128
                      (    demo/cube.asm):00337         ; ---------------------------------------------------------------------------
20FE 0F8F             (    demo/cube.asm):00338         CORNERS         CLR     <VI             ; start with corner 0
2100 D68F             (    demo/cube.asm):00339         CN_LOOP         LDB     <VI             ; B = corner number, used by VSUM
2102 CE0086           (    demo/cube.asm):00340                         LDU     #TX             ;  to pick + or - for each term
2105 8D45             (    demo/cube.asm):00341                         BSR     VSUM
2107 9790             (    demo/cube.asm):00342                         STA     <VX             ; rotated x
2109 CE008C           (    demo/cube.asm):00343                         LDU     #TZ             ; (B is preserved by VSUM)
210C 8D3E             (    demo/cube.asm):00344                         BSR     VSUM            ; rotated z, range about -60..60
210E 8B40             (    demo/cube.asm):00345                         ADDA    #64             ; shift to 0..127 to index the tables
2110 9791             (    demo/cube.asm):00346                         STA     <ZI
2112 CE0089           (    demo/cube.asm):00347                         LDU     #TY
2115 8D35             (    demo/cube.asm):00348                         BSR     VSUM            ; rotated y, left in A
                      (    demo/cube.asm):00349         
                      (    demo/cube.asm):00350         ; screen y = CY + y * RYTAB[z] / 128
2117 308D021F         (    demo/cube.asm):00351                         LEAX    RYTAB,PCR       ; B = RYTAB[ZI]
211B D691             (    demo/cube.asm):00352                         LDB     <ZI
211D 3A               (    demo/cube.asm):00353                         ABX
211E E684             (    demo/cube.asm):00354                         LDB     ,X
2120 8D49             (    demo/cube.asm):00355                         BSR     PMUL            ; A = y * RYTAB[z] / 128
2122 8B24             (    demo/cube.asm):00356                         ADDA    #CY
2124 8E00A8           (    demo/cube.asm):00357                         LDX     #PY             ; store at PY + VI
2127 D68F             (    demo/cube.asm):00358                         LDB     <VI
2129 3A               (    demo/cube.asm):00359                         ABX
212A A784             (    demo/cube.asm):00360                         STA     ,X
                      (    demo/cube.asm):00361         
                      (    demo/cube.asm):00362         ; screen x = CX + x * RXTAB[z] / 128
212C 308D018A         (    demo/cube.asm):00363                         LEAX    RXTAB,PCR       ; B = RXTAB[ZI]
2130 D691             (    demo/cube.asm):00364                         LDB     <ZI
2132 3A               (    demo/cube.asm):00365                         ABX
2133 E684             (    demo/cube.asm):00366                         LDB     ,X
2135 9690             (    demo/cube.asm):00367                         LDA     <VX             ; A = rotated x
2137 8D32             (    demo/cube.asm):00368                         BSR     PMUL
2139 8B27             (    demo/cube.asm):00369                         ADDA    #CX
213B 8E00A0           (    demo/cube.asm):00370                         LDX     #PX             ; store at PX + VI
213E D68F             (    demo/cube.asm):00371                         LDB     <VI
2140 3A               (    demo/cube.asm):00372                         ABX
2141 A784             (    demo/cube.asm):00373                         STA     ,X
                      (    demo/cube.asm):00374         
2143 0C8F             (    demo/cube.asm):00375                         INC     <VI             ; next corner, until all 8 done
2145 968F             (    demo/cube.asm):00376                         LDA     <VI
2147 8108             (    demo/cube.asm):00377                         CMPA    #8
2149 26B5             (    demo/cube.asm):00378                         BNE     CN_LOOP
214B 39               (    demo/cube.asm):00379                         RTS
                      (    demo/cube.asm):00380         
                      (    demo/cube.asm):00381         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00382         ; VSUM - one rotated coordinate of one corner
                      (    demo/cube.asm):00383         ;   Entry: U -> the three terms for this coordinate (TX, TY or TZ)
                      (    demo/cube.asm):00384         ;          B = corner number: bit 0 set means x = +S, clear means x = -S;
                      (    demo/cube.asm):00385         ;              bit 1 likewise for y, bit 2 for z
                      (    demo/cube.asm):00386         ;   Exit:  A = term0 * (+/-1) + term1 * (+/-1) + term2 * (+/-1)
                      (    demo/cube.asm):00387         ;          B preserved (so the caller can reuse it for the next coordinate)
                      (    demo/cube.asm):00388         ; ---------------------------------------------------------------------------
214C 4F               (    demo/cube.asm):00389         VSUM            CLRA                    ; running total
214D C501             (    demo/cube.asm):00390                         BITB    #1              ; x sign: add or subtract term 0
214F 2704             (    demo/cube.asm):00391                         BEQ     VS_1
2151 ABC4             (    demo/cube.asm):00392                         ADDA    ,U
2153 2002             (    demo/cube.asm):00393                         BRA     VS_2
2155 A0C4             (    demo/cube.asm):00394         VS_1            SUBA    ,U
2157 C502             (    demo/cube.asm):00395         VS_2            BITB    #2              ; y sign: term 1
2159 2704             (    demo/cube.asm):00396                         BEQ     VS_3
215B AB41             (    demo/cube.asm):00397                         ADDA    1,U
215D 2002             (    demo/cube.asm):00398                         BRA     VS_4
215F A041             (    demo/cube.asm):00399         VS_3            SUBA    1,U
2161 C504             (    demo/cube.asm):00400         VS_4            BITB    #4              ; z sign: term 2
2163 2703             (    demo/cube.asm):00401                         BEQ     VS_5
2165 AB42             (    demo/cube.asm):00402                         ADDA    2,U
2167 39               (    demo/cube.asm):00403                         RTS
2168 A042             (    demo/cube.asm):00404         VS_5            SUBA    2,U
216A 39               (    demo/cube.asm):00405                         RTS
                      (    demo/cube.asm):00406         
                      (    demo/cube.asm):00407         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00408         ; PMUL - projection multiply: A = (A * B) / 128
                      (    demo/cube.asm):00409         ;   Entry: A = coordinate (signed), B = scale from RXTAB/RYTAB (unsigned)
                      (    demo/cube.asm):00410         ;   Exit:  A = result. B corrupted.
                      (    demo/cube.asm):00411         ;
                      (    demo/cube.asm):00412         ;   Like MULS7, but only A can be negative, so: make A positive, MUL,
                      (    demo/cube.asm):00413         ;   divide by 128 the same way (ASLB/ROLA leaves D/128 in A), and negate
                      (    demo/cube.asm):00414         ;   the answer if A was negative.
                      (    demo/cube.asm):00415         ; ---------------------------------------------------------------------------
216B 4D               (    demo/cube.asm):00416         PMUL            TSTA
216C 2A06             (    demo/cube.asm):00417                         BPL     PM_1
216E 40               (    demo/cube.asm):00418                         NEGA                    ; negative coordinate:
216F 3D               (    demo/cube.asm):00419                         MUL                     ;  |A| * B
2170 58               (    demo/cube.asm):00420                         ASLB                    ;  / 128
2171 49               (    demo/cube.asm):00421                         ROLA
2172 40               (    demo/cube.asm):00422                         NEGA                    ;  and make it negative again
2173 39               (    demo/cube.asm):00423                         RTS
2174 3D               (    demo/cube.asm):00424         PM_1            MUL                     ; positive coordinate: A * B
2175 58               (    demo/cube.asm):00425                         ASLB                    ;  / 128
2176 49               (    demo/cube.asm):00426                         ROLA
2177 39               (    demo/cube.asm):00427                         RTS
                      (    demo/cube.asm):00428         
                      (    demo/cube.asm):00429         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00430         ; EDGES - draw the 12 edges
                      (    demo/cube.asm):00431         ;
                      (    demo/cube.asm):00432         ;   EDGETAB lists the 12 edges as pairs of corner numbers. For each pair,
                      (    demo/cube.asm):00433         ;   look up both corners' screen positions in PX/PY and draw a line.
                      (    demo/cube.asm):00434         ;   TGL_LINEC (the clipped line) is used because, when the cube is zoomed
                      (    demo/cube.asm):00435         ;   right in, some corners land off the screen.
                      (    demo/cube.asm):00436         ;
                      (    demo/cube.asm):00437         ;   Y walks through EDGETAB two bytes at a time: 0,Y is the start corner,
                      (    demo/cube.asm):00438         ;   1,Y the end corner.
                      (    demo/cube.asm):00439         ; ---------------------------------------------------------------------------
2178 318D0026         (    demo/cube.asm):00440         EDGES           LEAY    EDGETAB,PCR
217C 860C             (    demo/cube.asm):00441                         LDA     #12             ; 12 edges to draw
217E 9792             (    demo/cube.asm):00442                         STA     <EC
2180 8E00A0           (    demo/cube.asm):00443         ED_LOOP         LDX     #PX             ; end corner's position -> U
2183 E621             (    demo/cube.asm):00444                         LDB     1,Y             ;  X -> PX + end corner
2185 3A               (    demo/cube.asm):00445                         ABX
2186 A684             (    demo/cube.asm):00446                         LDA     ,X              ;  A = its x
2188 E608             (    demo/cube.asm):00447                         LDB     8,X             ;  B = its y (PY = PX + 8)
218A 1F03             (    demo/cube.asm):00448                         TFR     D,U             ;  park x1:y1 in U for now
218C 8E00A0           (    demo/cube.asm):00449                         LDX     #PX             ; start corner's position -> A, B
218F E6A4             (    demo/cube.asm):00450                         LDB     ,Y
2191 3A               (    demo/cube.asm):00451                         ABX
2192 A684             (    demo/cube.asm):00452                         LDA     ,X              ;  A = x0
2194 E608             (    demo/cube.asm):00453                         LDB     8,X             ;  B = y0
2196 1F31             (    demo/cube.asm):00454                         TFR     U,X             ; X = x1:y1, the packed end point
2198 BD1018           (    demo/cube.asm):00455                         JSR     TGL_LINEC
219B 3122             (    demo/cube.asm):00456                         LEAY    2,Y             ; next pair
219D 0A92             (    demo/cube.asm):00457                         DEC     <EC
219F 26DF             (    demo/cube.asm):00458                         BNE     ED_LOOP
21A1 39               (    demo/cube.asm):00459                         RTS
                      (    demo/cube.asm):00460         
                      (    demo/cube.asm):00461         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00462         ; The 12 edges, as pairs of corner numbers. Corners differing only in bit 0
                      (    demo/cube.asm):00463         ; are joined by an edge running along x; bit 1 along y; bit 2 along z.
                      (    demo/cube.asm):00464         ; ---------------------------------------------------------------------------
21A2 0001020304050607 (    demo/cube.asm):00465         EDGETAB         FCB     0,1,2,3,4,5,6,7         ; edges along x
21AA 0002010304060507 (    demo/cube.asm):00466                         FCB     0,2,1,3,4,6,5,7         ; edges along y
21B2 0004010502060307 (    demo/cube.asm):00467                         FCB     0,4,1,5,2,6,3,7         ; edges along z
                      (    demo/cube.asm):00468         
