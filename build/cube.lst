                      (    demo/cube.asm):00001         ; ===========================================================================
                      (    demo/cube.asm):00002         ; Rotating cube demo for the teletext graphics library
                      (    demo/cube.asm):00003         ;
                      (    demo/cube.asm):00004         ;   A wireframe cube that tumbles about two axes and slowly zooms in and
                      (    demo/cube.asm):00005         ;   out, drawn in perspective with its hidden lines removed, so it looks
                      (    demo/cube.asm):00006         ;   solid. Press the space bar to switch hidden-line removal off and on
                      (    demo/cube.asm):00007         ;   (to see the full wireframe); any other key exits.
                      (    demo/cube.asm):00008         ;
                      (    demo/cube.asm):00009         ;   Loading: tgl.bin at $1000 (TGL_BASE in cube_defs.inc), cube.bin at
                      (    demo/cube.asm):00010         ;   $2800 (its ORG). Run from START ($2800). Works with either machine's
                      (    demo/cube.asm):00011         ;   library build.
                      (    demo/cube.asm):00012         ;
                      (    demo/cube.asm):00013         ;   This is the simplest of three cube demos sharing the same code:
                      (    demo/cube.asm):00014         ;     cube.asm   - this one: edges only, hidden lines removed
                      (    demo/cube.asm):00015         ;     cubep.asm  - each face filled with its own pattern
                      (    demo/cube.asm):00016         ;     cubed.asm  - a die: white faces, black spots and edges
                      (    demo/cube.asm):00017         ;   The shared settings and variables are in cube_defs.inc, and the
                      (    demo/cube.asm):00018         ;   rotation, projection, face visibility and edge drawing in cube_core.asm,
                      (    demo/cube.asm):00019         ;   which also explains the maths.
                      (    demo/cube.asm):00020         ;
                      (    demo/cube.asm):00021         ;   Each frame:
                      (    demo/cube.asm):00022         ;     1. clear the off-screen buffer                       (TGL_CLS)
                      (    demo/cube.asm):00023         ;     2. work out this frame's size from the zoom phase    (ZOOMSZ)
                      (    demo/cube.asm):00024         ;     3. build the rotation for this frame's angles        (MATRIX)
                      (    demo/cube.asm):00025         ;     4. rotate the 8 corners and project them to screen   (CORNERS)
                      (    demo/cube.asm):00026         ;     5. work out which of the 6 faces point at the viewer (FACES)
                      (    demo/cube.asm):00027         ;     6. draw the 12 edges, skipping edges whose two faces
                      (    demo/cube.asm):00028         ;        are both hidden (unless in wireframe)             (EDGES)
                      (    demo/cube.asm):00029         ;     7. wait for the frame period to run out              (TGL_PACE)
                      (    demo/cube.asm):00030         ;     8. copy the buffer to the screen                     (TGL_BLIT)
                      (    demo/cube.asm):00031         ;     9. advance the angles and zoom, check for a key, repeat
                      (    demo/cube.asm):00032         ;
                      (    demo/cube.asm):00033         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests), and
                      (    demo/cube.asm):00034         ;   -D WIREFRAME to start with hidden-line removal off.
                      (    demo/cube.asm):00035         ; ===========================================================================
                      (    demo/cube.asm):00036                         INCLUDE "cube_defs.inc"
                      (    cube_defs.inc):00001         ; ===========================================================================
                      (    cube_defs.inc):00002         ; cube_defs.inc - settings and variables shared by the cube demos
                      (    cube_defs.inc):00003         ;   (cube.asm, cubep.asm, cubed.asm). Included at the top of each.
                      (    cube_defs.inc):00004         ; ===========================================================================
                      (    cube_defs.inc):00005         
                      (    cube_defs.inc):00006         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00007         ; Library entry points (see tgl_api.inc)
                      (    cube_defs.inc):00008         ; ---------------------------------------------------------------------------
     1000             (    cube_defs.inc):00009         TGL_BASE        EQU     $1000
                      (    cube_defs.inc):00010                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
     1048             (      tgl_api.inc):00033         TGL_SETDASH     EQU     TGL_BASE+72     ; dash: A = pattern, B = length, X = phase
     104B             (      tgl_api.inc):00034         TGL_LINED       EQU     TGL_BASE+75     ; dashed line: as TGL_LINEC
     104E             (      tgl_api.inc):00035         TGL_RECTD       EQU     TGL_BASE+78     ; dashed rectangle outline: as TGL_RECT
                      (      tgl_api.inc):00036         
     03C0             (      tgl_api.inc):00037         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00038         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00039         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00040         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00041         
                      (      tgl_api.inc):00042         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00043         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00044         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00045         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00046         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00047         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00048         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00049         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00050         
                      (      tgl_api.inc):00051         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00052         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00053         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00054         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00055         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00056         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00057         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00058         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00059         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00060         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (    cube_defs.inc):00011         
                      (    cube_defs.inc):00012         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00013         ; Memory
                      (    cube_defs.inc):00014         ; ---------------------------------------------------------------------------
     3800             (    cube_defs.inc):00015         BUFFER          EQU     $3800           ; off-screen buffer (960 bytes)
     0200             (    cube_defs.inc):00016         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    cube_defs.inc):00017         
                      (    cube_defs.inc):00018         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00019         ; Settings you can change
                      (    cube_defs.inc):00020         ; ---------------------------------------------------------------------------
     0015             (    cube_defs.inc):00021         SIZE_MID        EQU     21              ; middle of the zoom range; the half
                      (    cube_defs.inc):00022                                                 ;  edge length pulses 5..36 around it
     0027             (    cube_defs.inc):00023         CX              EQU     39              ; screen position of the cube's centre
     0024             (    cube_defs.inc):00024         CY              EQU     36
     0002             (    cube_defs.inc):00025         STEP_A          EQU     2               ; rotation speed about x (per frame,
     0003             (    cube_defs.inc):00026         STEP_B          EQU     3               ;  and about y; 256 = a full turn)
     0001             (    cube_defs.inc):00027         STEP_Z          EQU     1               ; zoom speed (256 steps per in-and-out)
                      (    cube_defs.inc):00028         
                      (    cube_defs.inc):00029         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00030         ; Variables, in page zero so they can use fast direct addressing.
                      (    cube_defs.inc):00031         ; The library's own workspace is $00-$7F, so these start at $80.
                      (    cube_defs.inc):00032         ; ---------------------------------------------------------------------------
     0080             (    cube_defs.inc):00033         ANG_A           EQU     $80             ; rotation angle about x (0-255)
     0081             (    cube_defs.inc):00034         ANG_B           EQU     $81             ; rotation angle about y (0-255)
     0082             (    cube_defs.inc):00035         SA              EQU     $82             ; sin(ANG_A)   (127 = 1.0)
     0083             (    cube_defs.inc):00036         CA              EQU     $83             ; cos(ANG_A)
     0084             (    cube_defs.inc):00037         SB              EQU     $84             ; sin(ANG_B)
     0085             (    cube_defs.inc):00038         CB              EQU     $85             ; cos(ANG_B)
     0086             (    cube_defs.inc):00039         TX              EQU     $86             ; 3 bytes: terms for rotated x
     0089             (    cube_defs.inc):00040         TY              EQU     $89             ; 3 bytes: terms for rotated y
     008C             (    cube_defs.inc):00041         TZ              EQU     $8C             ; 3 bytes: terms for rotated z
     008F             (    cube_defs.inc):00042         VI              EQU     $8F             ; corner number being worked on (0-7)
     0090             (    cube_defs.inc):00043         VX              EQU     $90             ; that corner's rotated x
     0091             (    cube_defs.inc):00044         ZI              EQU     $91             ; its depth, as an index into RXTAB/RYTAB
     0092             (    cube_defs.inc):00045         EC              EQU     $92             ; edges left to draw
     0093             (    cube_defs.inc):00046         FRAMES          EQU     $93             ; frame counter (test builds only)
     0094             (    cube_defs.inc):00047         SIZE            EQU     $94             ; this frame's half edge length (S)
     0095             (    cube_defs.inc):00048         ZOOM            EQU     $95             ; zoom phase (0-255, like an angle)
     0096             (    cube_defs.inc):00049         EX              EQU     $96             ; the viewer's eye, in cube
     0097             (    cube_defs.inc):00050         EY              EQU     $97             ;  coordinates
     0098             (    cube_defs.inc):00051         EZ              EQU     $98
     0099             (    cube_defs.inc):00052         WIRE            EQU     $99             ; 0: skip hidden edges, else draw all
     00A0             (    cube_defs.inc):00053         PX              EQU     $A0             ; 8 bytes: screen x of corners 0-7
     00A8             (    cube_defs.inc):00054         PY              EQU     $A8             ; 8 bytes: screen y of corners 0-7.
                      (    cube_defs.inc):00055                                                 ;  PY is exactly PX+8, so if X points
                      (    cube_defs.inc):00056                                                 ;  at a corner's PX entry, its PY is
                      (    cube_defs.inc):00057                                                 ;  at 8,X
     00B0             (    cube_defs.inc):00058         VIS             EQU     $B0             ; 6 bytes: per face, $FF if visible.
                      (    cube_defs.inc):00059                                                 ;  Faces: 0 +x, 1 -x, 2 +y, 3 -y,
                      (    cube_defs.inc):00060                                                 ;  4 +z, 5 -z
     00B8             (    cube_defs.inc):00061         POLY            EQU     $B8             ; 9 bytes: corner list for TGL_POLYF
                      (    cube_defs.inc):00062                                                 ;  (count, then 4 x,y pairs)
     00C2             (    cube_defs.inc):00063         FACEN           EQU     $C2             ; face being filled or spotted
                      (    cube_defs.inc):00064         ; (the die demo uses $C6-$DB for its own variables)
                      (    demo/cube.asm):00037         
     0002             (    demo/cube.asm):00038         PACE_TICKS      EQU     2               ; frame length in 50Hz ticks: 2 = 25
                      (    demo/cube.asm):00039                                                 ;  frames per second
                      (    demo/cube.asm):00040         
                      (    demo/cube.asm):00041                         ORG     $2800
                      (    demo/cube.asm):00042         
                      (    demo/cube.asm):00043         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00044         ; Set up
                      (    demo/cube.asm):00045         ; ---------------------------------------------------------------------------
2800 10CE0200         (    demo/cube.asm):00046         START           LDS     #STACK_TOP
2804 4F               (    demo/cube.asm):00047                         CLRA                    ; DP = $00: the library (and our
2805 1F8B             (    demo/cube.asm):00048                         TFR     A,DP            ;  variables) use direct addressing
     00               (    demo/cube.asm):00049                         SETDP   $00             ;  in page zero
2807 1CEF             (    demo/cube.asm):00050                         ANDCC   #$EF            ; enable IRQs: the keyboard is read
                      (    demo/cube.asm):00051                                                 ;  under interrupt
2809 BD1000           (    demo/cube.asm):00052                         JSR     TGL_INIT        ; reset CRTC start, hide cursor
280C 8E3800           (    demo/cube.asm):00053                         LDX     #BUFFER         ; draw into our buffer at $3800
280F BD1003           (    demo/cube.asm):00054                         JSR     TGL_SETBUF
2812 0F80             (    demo/cube.asm):00055                         CLR     <ANG_A          ; start square-on, mid zoom
2814 0F81             (    demo/cube.asm):00056                         CLR     <ANG_B
2816 0F93             (    demo/cube.asm):00057                         CLR     <FRAMES
2818 0F95             (    demo/cube.asm):00058                         CLR     <ZOOM
                      (    demo/cube.asm):00059                         IFDEF   WIREFRAME
                      (    demo/cube.asm):00060                         LDA     #$FF            ; start showing every edge
                      (    demo/cube.asm):00061                         ELSE
281A 4F               (    demo/cube.asm):00062                         CLRA                    ; start with hidden lines removed
                      (    demo/cube.asm):00063                         ENDC
281B 9799             (    demo/cube.asm):00064                         STA     <WIRE
281D 4F               (    demo/cube.asm):00065                         CLRA                    ; status row: how to use the keys
281E 8E2862           (    demo/cube.asm):00066                         LDX     #KEYHELP
2821 BD1030           (    demo/cube.asm):00067                         JSR     TGL_TEXT
                      (    demo/cube.asm):00068         
                      (    demo/cube.asm):00069         ; ---------------------------------------------------------------------------
                      (    demo/cube.asm):00070         ; Main loop: one pass per frame
                      (    demo/cube.asm):00071         ; ---------------------------------------------------------------------------
2824 BD1006           (    demo/cube.asm):00072         FRAME           JSR     TGL_CLS         ; blank the buffer
2827 170059           (    demo/cube.asm):00073                         LBSR    ZOOMSZ          ; SIZE for this frame
282A 170067           (    demo/cube.asm):00074                         LBSR    MATRIX          ; terms TX, TY, TZ for this frame
282D 170149           (    demo/cube.asm):00075                         LBSR    CORNERS         ; screen positions PX, PY
2830 170101           (    demo/cube.asm):00076                         LBSR    FACES           ; which faces can be seen
2833 1701BD           (    demo/cube.asm):00077                         LBSR    EDGES           ; draw into the buffer
2836 8602             (    demo/cube.asm):00078                         LDA     #PACE_TICKS     ; wait for the frame period, so every
2838 BD103C           (    demo/cube.asm):00079                         JSR     TGL_PACE        ;  frame takes the same time
283B BD1012           (    demo/cube.asm):00080                         JSR     TGL_BLIT        ; show it
                      (    demo/cube.asm):00081         
                      (    demo/cube.asm):00082         ; Advance the angles and zoom phase. Being bytes, they wrap from 255 back
                      (    demo/cube.asm):00083         ; to 0 by themselves, which is exactly one full turn.
283E 9680             (    demo/cube.asm):00084                         LDA     <ANG_A
2840 8B02             (    demo/cube.asm):00085                         ADDA    #STEP_A
2842 9780             (    demo/cube.asm):00086                         STA     <ANG_A
2844 9681             (    demo/cube.asm):00087                         LDA     <ANG_B
2846 8B03             (    demo/cube.asm):00088                         ADDA    #STEP_B
2848 9781             (    demo/cube.asm):00089                         STA     <ANG_B
284A 9695             (    demo/cube.asm):00090                         LDA     <ZOOM
284C 8B01             (    demo/cube.asm):00091                         ADDA    #STEP_Z
284E 9795             (    demo/cube.asm):00092                         STA     <ZOOM
                      (    demo/cube.asm):00093         
                      (    demo/cube.asm):00094         ; Keys: space toggles hidden-line removal, anything else exits.
                      (    demo/cube.asm):00095         ; TGL_INKEY returns Z set if no key is waiting, else the key in A.
2850 BD101E           (    demo/cube.asm):00096                         JSR     TGL_INKEY
2853 2708             (    demo/cube.asm):00097                         BEQ     NOKEY
2855 8120             (    demo/cube.asm):00098                         CMPA    #' '
2857 1026E7C6         (    demo/cube.asm):00099                         LBNE    TGL_EXIT        ; not space: exit (never returns)
285B 0399             (    demo/cube.asm):00100                         COM     <WIRE           ; space: 0 <-> $FF
285D                  (    demo/cube.asm):00101         NOKEY
                      (    demo/cube.asm):00102         ; Test builds stop after TESTFRAMES frames so the emulator can inspect
                      (    demo/cube.asm):00103         ; the result. Normal builds skip this.
                      (    demo/cube.asm):00104                         IFDEF   TESTFRAMES
                      (    demo/cube.asm):00105                         INC     <FRAMES
                      (    demo/cube.asm):00106                         LDA     <FRAMES
                      (    demo/cube.asm):00107                         CMPA    #TESTFRAMES
                      (    demo/cube.asm):00108                         BEQ     DONE
                      (    demo/cube.asm):00109                         ENDC
285D 16FFC4           (    demo/cube.asm):00110                         LBRA    FRAME
2860 20FE             (    demo/cube.asm):00111         DONE            BRA     DONE
                      (    demo/cube.asm):00112         
                      (    demo/cube.asm):00113         ; Status row help. $83 yellow, $87 white, $86 cyan text codes.
2862 83               (    demo/cube.asm):00114         KEYHELP         FCB     $83
2863 5350414345       (    demo/cube.asm):00115                         FCC     "SPACE"
2868 87               (    demo/cube.asm):00116                         FCB     $87
2869 574952454652414D (    demo/cube.asm):00117                         FCC     "WIREFRAME"
     45
2872 86               (    demo/cube.asm):00118                         FCB     $86
2873 4F54484552204B45 (    demo/cube.asm):00119                         FCC     "OTHER KEY EXITS"
     59204558495453
2882 00               (    demo/cube.asm):00120                         FCB     0
                      (    demo/cube.asm):00121         
                      (    demo/cube.asm):00122                         INCLUDE "cube_core.asm"
                      (    cube_core.asm):00001         ; ===========================================================================
                      (    cube_core.asm):00002         ; cube_core.asm - the routines and tables shared by the cube demos
                      (    cube_core.asm):00003         ;   (cube.asm, cubep.asm, cubed.asm): zoom, rotation, projection, which
                      (    cube_core.asm):00004         ;   faces can be seen, and the edges. Included after each demo's own code.
                      (    cube_core.asm):00005         ;
                      (    cube_core.asm):00006         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00007         ; The maths, and how it is kept cheap on an 8-bit CPU
                      (    cube_core.asm):00008         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00009         ;
                      (    cube_core.asm):00010         ;   Fixed point. Sines and cosines are stored as signed bytes where 127
                      (    cube_core.asm):00011         ;   stands for 1.0 (so 64 is about 0.5, -127 is -1.0). Multiplying two such
                      (    cube_core.asm):00012         ;   numbers gives a result 128 times too big, so products are divided by
                      (    cube_core.asm):00013         ;   128 afterwards (see MULS7).
                      (    cube_core.asm):00014         ;
                      (    cube_core.asm):00015         ;   Angles. A full circle is 256 steps instead of 360 degrees, so an angle
                      (    cube_core.asm):00016         ;   fits in one byte and wraps round by itself when it overflows. A quarter
                      (    cube_core.asm):00017         ;   turn is 64 steps, which gives cos(a) = sin(a + 64): one sine table
                      (    cube_core.asm):00018         ;   serves for both.
                      (    cube_core.asm):00019         ;
                      (    cube_core.asm):00020         ;   Rotation. The cube is centred on the origin, so its corners are every
                      (    cube_core.asm):00021         ;   combination of (+S or -S, +S or -S, +S or -S), where S is half the edge
                      (    cube_core.asm):00022         ;   length. Rotating a point means multiplying it by a 3x3 matrix:
                      (    cube_core.asm):00023         ;
                      (    cube_core.asm):00024         ;       rotated x = m00*x + m01*y + m02*z      (and similarly for y, z)
                      (    cube_core.asm):00025         ;
                      (    cube_core.asm):00026         ;   With every coordinate being +S or -S, each product is just +/-(m * S).
                      (    cube_core.asm):00027         ;   So once per frame we work out the nine values m*S (the "terms" TX, TY,
                      (    cube_core.asm):00028         ;   TZ), and then every rotated corner coordinate is three of those terms
                      (    cube_core.asm):00029         ;   added or subtracted according to the corner's signs. That's 8 multiplies
                      (    cube_core.asm):00030         ;   per frame for the whole cube, instead of 9 per corner.
                      (    cube_core.asm):00031         ;
                      (    cube_core.asm):00032         ;   Perspective. Further-away points should be drawn closer to the centre:
                      (    cube_core.asm):00033         ;
                      (    cube_core.asm):00034         ;       screen x = centre + x * F / (distance + z)
                      (    cube_core.asm):00035         ;
                      (    cube_core.asm):00036         ;   Dividing is slow on a 6809, so the value F / (distance + z), suitably
                      (    cube_core.asm):00037         ;   scaled, is precomputed for every possible z and stored in a table
                      (    cube_core.asm):00038         ;   (RXTAB, RYTAB). Projecting is then one table lookup and one MUL.
                      (    cube_core.asm):00039         ;   The x table uses a smaller F than the y table because teletext pixels
                      (    cube_core.asm):00040         ;   are wider than they are tall; this keeps the cube looking square.
                      (    cube_core.asm):00041         ;
                      (    cube_core.asm):00042         ;   Hidden faces. A face is visible when it points back towards the viewer.
                      (    cube_core.asm):00043         ;   Rather than rotate the faces, FACES works out where the viewer's eye
                      (    cube_core.asm):00044         ;   is in the cube's own coordinates (as the ship demo does). The cube's
                      (    cube_core.asm):00045         ;   faces are the six sides of a box, so the test is then trivial: the +x
                      (    cube_core.asm):00046         ;   face is visible when the eye's x is beyond +S, the -x face when it is
                      (    cube_core.asm):00047         ;   below -S, and likewise for y and z. The eye sits 100 units in front of
                      (    cube_core.asm):00048         ;   the viewer's screen, the distance the projection tables assume; in
                      (    cube_core.asm):00049         ;   cube coordinates it is -100 * (z row of the rotation matrix).
                      (    cube_core.asm):00050         ;   Each edge borders two faces and is drawn if either is visible.
                      (    cube_core.asm):00051         ;
                      (    cube_core.asm):00052         ;   Corner numbering. Corners are numbered 0-7. Bit 0 of the number says
                      (    cube_core.asm):00053         ;   whether the corner's x is +S (bit set) or -S (bit clear); bit 1 does
                      (    cube_core.asm):00054         ;   the same for y and bit 2 for z. Two corners are joined by an edge when
                      (    cube_core.asm):00055         ;   their numbers differ in exactly one bit (see EDGETAB).
                      (    cube_core.asm):00056         ; ===========================================================================
                      (    cube_core.asm):00057         
                      (    cube_core.asm):00058         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00059         ; ZOOMSZ - set SIZE from the zoom phase
                      (    cube_core.asm):00060         ;
                      (    cube_core.asm):00061         ;   SIZE = SIZE_MID + sin(ZOOM)/8, which swings smoothly between 5 and 36
                      (    cube_core.asm):00062         ;   as ZOOM goes round. From about 26 upwards the cube overhangs the screen
                      (    cube_core.asm):00063         ;   and TGL_LINEC clips it. Don't go above 36: beyond that the depth no
                      (    cube_core.asm):00064         ;   longer fits the projection tables (-64..63), and projected points no
                      (    cube_core.asm):00065         ;   longer fit the signed -128..127 that TGL_LINEC accepts.
                      (    cube_core.asm):00066         ; ---------------------------------------------------------------------------
2883 308D01DC         (    cube_core.asm):00067         ZOOMSZ          LEAX    SINTAB,PCR      ; X -> sine table
2887 D695             (    cube_core.asm):00068                         LDB     <ZOOM           ; X -> sin(ZOOM). ABX adds B as an
2889 3A               (    cube_core.asm):00069                         ABX                     ;  UNSIGNED byte (0-255). "LDA B,X"
                      (    cube_core.asm):00070                                                 ;  would treat B as signed and read
                      (    cube_core.asm):00071                                                 ;  before the table for B >= 128
288A A684             (    cube_core.asm):00072                         LDA     ,X              ; A = sin(ZOOM), -127..127
288C 47               (    cube_core.asm):00073                         ASRA                    ; divide by 8. ASR keeps the sign bit,
288D 47               (    cube_core.asm):00074                         ASRA                    ;  so negative numbers stay negative:
288E 47               (    cube_core.asm):00075                         ASRA                    ;  -127..127 becomes -16..15
288F 8B15             (    cube_core.asm):00076                         ADDA    #SIZE_MID       ; 5..36
2891 9794             (    cube_core.asm):00077                         STA     <SIZE
2893 39               (    cube_core.asm):00078                         RTS
                      (    cube_core.asm):00079         
                      (    cube_core.asm):00080         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00081         ; MATRIX - work out this frame's nine terms
                      (    cube_core.asm):00082         ;
                      (    cube_core.asm):00083         ;   The cube is turned first about the y axis (angle B), then about the x
                      (    cube_core.asm):00084         ;   axis (angle A). Multiplying those two rotations together gives this
                      (    cube_core.asm):00085         ;   matrix (each entry scaled so 127 = 1.0):
                      (    cube_core.asm):00086         ;
                      (    cube_core.asm):00087         ;               x part      y part     z part
                      (    cube_core.asm):00088         ;     row x: [  cb,         0,         sb       ]
                      (    cube_core.asm):00089         ;     row y: [  sb*sa,      ca,       -cb*sa    ]
                      (    cube_core.asm):00090         ;     row z: [ -sb*ca,      sa,        cb*ca    ]
                      (    cube_core.asm):00091         ;
                      (    cube_core.asm):00092         ;   Each entry is then multiplied by SIZE to give the terms, e.g.
                      (    cube_core.asm):00093         ;   TX = [ cb*S, 0, sb*S ]. Two-factor entries like sb*sa need two
                      (    cube_core.asm):00094         ;   multiplies: first sb*sa, then that result * S.
                      (    cube_core.asm):00095         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00096         
                      (    cube_core.asm):00097         ; Look up the four sines and cosines. Each lookup: X -> table, add the
                      (    cube_core.asm):00098         ; angle (unsigned, via ABX), read the byte. cos uses angle + 64.
2894 308D01CB         (    cube_core.asm):00099         MATRIX          LEAX    SINTAB,PCR      ; SA = sin(ANG_A)
2898 D680             (    cube_core.asm):00100                         LDB     <ANG_A
289A 3A               (    cube_core.asm):00101                         ABX
289B A684             (    cube_core.asm):00102                         LDA     ,X
289D 9782             (    cube_core.asm):00103                         STA     <SA
289F 308D01C0         (    cube_core.asm):00104                         LEAX    SINTAB,PCR      ; CA = cos(ANG_A) = sin(ANG_A + 64)
28A3 D680             (    cube_core.asm):00105                         LDB     <ANG_A
28A5 CB40             (    cube_core.asm):00106                         ADDB    #64             ; (wraps round past 255 correctly)
28A7 3A               (    cube_core.asm):00107                         ABX
28A8 A684             (    cube_core.asm):00108                         LDA     ,X
28AA 9783             (    cube_core.asm):00109                         STA     <CA
28AC 308D01B3         (    cube_core.asm):00110                         LEAX    SINTAB,PCR      ; SB = sin(ANG_B)
28B0 D681             (    cube_core.asm):00111                         LDB     <ANG_B
28B2 3A               (    cube_core.asm):00112                         ABX
28B3 A684             (    cube_core.asm):00113                         LDA     ,X
28B5 9784             (    cube_core.asm):00114                         STA     <SB
28B7 308D01A8         (    cube_core.asm):00115                         LEAX    SINTAB,PCR      ; CB = cos(ANG_B)
28BB D681             (    cube_core.asm):00116                         LDB     <ANG_B
28BD CB40             (    cube_core.asm):00117                         ADDB    #64
28BF 3A               (    cube_core.asm):00118                         ABX
28C0 A684             (    cube_core.asm):00119                         LDA     ,X
28C2 9785             (    cube_core.asm):00120                         STA     <CB
                      (    cube_core.asm):00121         
                      (    cube_core.asm):00122         ; Row x: TX = S * [ cb, 0, sb ]
28C4 9685             (    cube_core.asm):00123                         LDA     <CB             ; TX+0 = cb * S
28C6 D694             (    cube_core.asm):00124                         LDB     <SIZE
28C8 8D4F             (    cube_core.asm):00125                         BSR     MULS7
28CA 9786             (    cube_core.asm):00126                         STA     <TX
28CC 0F87             (    cube_core.asm):00127                         CLR     <TX+1           ; TX+1 = 0 (this entry is always 0)
28CE 9684             (    cube_core.asm):00128                         LDA     <SB             ; TX+2 = sb * S
28D0 D694             (    cube_core.asm):00129                         LDB     <SIZE
28D2 8D45             (    cube_core.asm):00130                         BSR     MULS7
28D4 9788             (    cube_core.asm):00131                         STA     <TX+2
                      (    cube_core.asm):00132         
                      (    cube_core.asm):00133         ; Row y: TY = S * [ sb*sa, ca, -cb*sa ]
28D6 9684             (    cube_core.asm):00134                         LDA     <SB             ; TY+0 = (sb * sa) * S
28D8 D682             (    cube_core.asm):00135                         LDB     <SA
28DA 8D3D             (    cube_core.asm):00136                         BSR     MULS7           ;  A = sb * sa
28DC D694             (    cube_core.asm):00137                         LDB     <SIZE
28DE 8D39             (    cube_core.asm):00138                         BSR     MULS7           ;  A = that * S
28E0 9789             (    cube_core.asm):00139                         STA     <TY
28E2 9683             (    cube_core.asm):00140                         LDA     <CA             ; TY+1 = ca * S
28E4 D694             (    cube_core.asm):00141                         LDB     <SIZE
28E6 8D31             (    cube_core.asm):00142                         BSR     MULS7
28E8 978A             (    cube_core.asm):00143                         STA     <TY+1
28EA 9685             (    cube_core.asm):00144                         LDA     <CB             ; TY+2 = -(cb * sa) * S
28EC D682             (    cube_core.asm):00145                         LDB     <SA
28EE 8D29             (    cube_core.asm):00146                         BSR     MULS7
28F0 40               (    cube_core.asm):00147                         NEGA
28F1 D694             (    cube_core.asm):00148                         LDB     <SIZE
28F3 8D24             (    cube_core.asm):00149                         BSR     MULS7
28F5 978B             (    cube_core.asm):00150                         STA     <TY+2
                      (    cube_core.asm):00151         
                      (    cube_core.asm):00152         ; Row z: TZ = S * [ -sb*ca, sa, cb*ca ]
28F7 9684             (    cube_core.asm):00153                         LDA     <SB             ; TZ+0 = -(sb * ca) * S
28F9 D683             (    cube_core.asm):00154                         LDB     <CA
28FB 8D1C             (    cube_core.asm):00155                         BSR     MULS7
28FD 40               (    cube_core.asm):00156                         NEGA
28FE D694             (    cube_core.asm):00157                         LDB     <SIZE
2900 8D17             (    cube_core.asm):00158                         BSR     MULS7
2902 978C             (    cube_core.asm):00159                         STA     <TZ
2904 9682             (    cube_core.asm):00160                         LDA     <SA             ; TZ+1 = sa * S
2906 D694             (    cube_core.asm):00161                         LDB     <SIZE
2908 8D0F             (    cube_core.asm):00162                         BSR     MULS7
290A 978D             (    cube_core.asm):00163                         STA     <TZ+1
290C 9685             (    cube_core.asm):00164                         LDA     <CB             ; TZ+2 = (cb * ca) * S
290E D683             (    cube_core.asm):00165                         LDB     <CA
2910 8D07             (    cube_core.asm):00166                         BSR     MULS7
2912 D694             (    cube_core.asm):00167                         LDB     <SIZE
2914 8D03             (    cube_core.asm):00168                         BSR     MULS7
2916 978E             (    cube_core.asm):00169                         STA     <TZ+2
2918 39               (    cube_core.asm):00170                         RTS
                      (    cube_core.asm):00171         
                      (    cube_core.asm):00172         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00173         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    cube_core.asm):00174         ;   Entry: A, B signed (-127..127)
                      (    cube_core.asm):00175         ;   Exit:  A = result. B corrupted.
                      (    cube_core.asm):00176         ;
                      (    cube_core.asm):00177         ;   The 6809's MUL only does unsigned A * B -> D. So: remember the signs,
                      (    cube_core.asm):00178         ;   multiply the sizes (absolute values), then put the sign back.
                      (    cube_core.asm):00179         ;   The result's sign is negative when exactly one input is negative,
                      (    cube_core.asm):00180         ;   which is what the top bit of (A EOR B) tells us.
                      (    cube_core.asm):00181         ;
                      (    cube_core.asm):00182         ;   Dividing D by 128: shifting D left once (ASLB then ROLA, which carries
                      (    cube_core.asm):00183         ;   B's top bit into A) gives D * 2, and the high byte of D * 2 is D / 128.
                      (    cube_core.asm):00184         ;   So after the shift the answer is simply in A.
                      (    cube_core.asm):00185         ; ---------------------------------------------------------------------------
2919 3406             (    cube_core.asm):00186         MULS7           PSHS    D               ; save the originals: 0,S = A, 1,S = B
291B 4D               (    cube_core.asm):00187                         TSTA                    ; make A positive
291C 2A01             (    cube_core.asm):00188                         BPL     MS_1
291E 40               (    cube_core.asm):00189                         NEGA
291F 5D               (    cube_core.asm):00190         MS_1            TSTB                    ; make B positive
2920 2A01             (    cube_core.asm):00191                         BPL     MS_2
2922 50               (    cube_core.asm):00192                         NEGB
2923 3D               (    cube_core.asm):00193         MS_2            MUL                     ; D = |A| * |B|
2924 58               (    cube_core.asm):00194                         ASLB                    ; D * 2 ...
2925 49               (    cube_core.asm):00195                         ROLA                    ; ... so A = D / 128
2926 3402             (    cube_core.asm):00196                         PSHS    A               ; keep the result. The originals are
                      (    cube_core.asm):00197                                                 ;  now at 1,S (A) and 2,S (B)
2928 A661             (    cube_core.asm):00198                         LDA     1,S             ; sign of result = top bit of A EOR B
292A A862             (    cube_core.asm):00199                         EORA    2,S             ;  (sets N flag)
292C 3502             (    cube_core.asm):00200                         PULS    A               ; result back in A. PULS doesn't
                      (    cube_core.asm):00201                                                 ;  change the flags, so N survives
292E 2A01             (    cube_core.asm):00202                         BPL     MS_3            ; positive: done
2930 40               (    cube_core.asm):00203                         NEGA                    ; negative: negate the result
2931 3262             (    cube_core.asm):00204         MS_3            LEAS    2,S             ; discard the saved originals
2933 39               (    cube_core.asm):00205                         RTS
                      (    cube_core.asm):00206         
                      (    cube_core.asm):00207         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00208         ; FACES - which of the six faces point towards the viewer
                      (    cube_core.asm):00209         ;
                      (    cube_core.asm):00210         ;   The eye in cube coordinates is -100 * (z row of the rotation matrix),
                      (    cube_core.asm):00211         ;   using the unscaled matrix entries (127 = 1.0) from MATRIX:
                      (    cube_core.asm):00212         ;       z row = [ -sb*ca, sa, cb*ca ]
                      (    cube_core.asm):00213         ;   Multiplying by -101 and dividing by 128 (MULS7) gives -100 * row / 127.
                      (    cube_core.asm):00214         ;   Then, for each axis, the + face is visible if the eye is beyond +S and
                      (    cube_core.asm):00215         ;   the - face if it is beyond -S.
                      (    cube_core.asm):00216         ; ---------------------------------------------------------------------------
2934 9684             (    cube_core.asm):00217         FACES           LDA     <SB             ; EX = -100 * (-sb*ca)
2936 D683             (    cube_core.asm):00218                         LDB     <CA
2938 17FFDE           (    cube_core.asm):00219                         LBSR    MULS7
293B 40               (    cube_core.asm):00220                         NEGA
293C C69B             (    cube_core.asm):00221                         LDB     #-101
293E 17FFD8           (    cube_core.asm):00222                         LBSR    MULS7
2941 9796             (    cube_core.asm):00223                         STA     <EX
2943 9682             (    cube_core.asm):00224                         LDA     <SA             ; EY = -100 * sa
2945 C69B             (    cube_core.asm):00225                         LDB     #-101
2947 17FFCF           (    cube_core.asm):00226                         LBSR    MULS7
294A 9797             (    cube_core.asm):00227                         STA     <EY
294C 9685             (    cube_core.asm):00228                         LDA     <CB             ; EZ = -100 * (cb*ca)
294E D683             (    cube_core.asm):00229                         LDB     <CA
2950 17FFC6           (    cube_core.asm):00230                         LBSR    MULS7
2953 C69B             (    cube_core.asm):00231                         LDB     #-101
2955 17FFC1           (    cube_core.asm):00232                         LBSR    MULS7
2958 9798             (    cube_core.asm):00233                         STA     <EZ
295A CE00B0           (    cube_core.asm):00234                         LDU     #VIS            ; set VIS for the six faces
295D 9696             (    cube_core.asm):00235                         LDA     <EX
295F 8D06             (    cube_core.asm):00236                         BSR     FACEPAIR        ;  +x, -x
2961 9697             (    cube_core.asm):00237                         LDA     <EY
2963 8D02             (    cube_core.asm):00238                         BSR     FACEPAIR        ;  +y, -y
2965 9698             (    cube_core.asm):00239                         LDA     <EZ
                      (    cube_core.asm):00240                         ; fall into FACEPAIR    ;  +z, -z
                      (    cube_core.asm):00241         
                      (    cube_core.asm):00242         ; FACEPAIR - Entry: A = one coordinate of the eye, U -> VIS slot for the
                      (    cube_core.asm):00243         ;   + face. Sets that slot and the next ($FF visible, 0 hidden), U += 2.
2967 5F               (    cube_core.asm):00244         FACEPAIR        CLRB                    ; + face: visible if eye > S
2968 9194             (    cube_core.asm):00245                         CMPA    <SIZE           ;  (signed compare)
296A 2F01             (    cube_core.asm):00246                         BLE     FP_1
296C 5A               (    cube_core.asm):00247                         DECB                    ;  B = $FF
296D E7C0             (    cube_core.asm):00248         FP_1            STB     ,U+
296F 5F               (    cube_core.asm):00249                         CLRB                    ; - face: visible if eye < -S,
2970 40               (    cube_core.asm):00250                         NEGA                    ;  i.e. -eye > S (the eye stays
2971 9194             (    cube_core.asm):00251                         CMPA    <SIZE           ;  within +/-101, so NEGA can't
2973 2F01             (    cube_core.asm):00252                         BLE     FP_2            ;  overflow)
2975 5A               (    cube_core.asm):00253                         DECB
2976 E7C0             (    cube_core.asm):00254         FP_2            STB     ,U+
2978 39               (    cube_core.asm):00255                         RTS
                      (    cube_core.asm):00256         
                      (    cube_core.asm):00257         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00258         ; CORNERS - rotate and project all 8 corners into PX/PY
                      (    cube_core.asm):00259         ;
                      (    cube_core.asm):00260         ;   For each corner number VI (0-7):
                      (    cube_core.asm):00261         ;     rotated x = signed sum of the TX terms       (VSUM)
                      (    cube_core.asm):00262         ;     rotated z = signed sum of the TZ terms, turned into a table index
                      (    cube_core.asm):00263         ;     rotated y = signed sum of the TY terms
                      (    cube_core.asm):00264         ;     screen y  = CY + y * RYTAB[z] / 128         (PMUL)
                      (    cube_core.asm):00265         ;     screen x  = CX + x * RXTAB[z] / 128
                      (    cube_core.asm):00266         ; ---------------------------------------------------------------------------
2979 0F8F             (    cube_core.asm):00267         CORNERS         CLR     <VI             ; start with corner 0
297B D68F             (    cube_core.asm):00268         CN_LOOP         LDB     <VI             ; B = corner number, used by VSUM
297D CE0086           (    cube_core.asm):00269                         LDU     #TX             ;  to pick + or - for each term
2980 8D45             (    cube_core.asm):00270                         BSR     VSUM
2982 9790             (    cube_core.asm):00271                         STA     <VX             ; rotated x
2984 CE008C           (    cube_core.asm):00272                         LDU     #TZ             ; (B is preserved by VSUM)
2987 8D3E             (    cube_core.asm):00273                         BSR     VSUM            ; rotated z, range about -60..60
2989 8B40             (    cube_core.asm):00274                         ADDA    #64             ; shift to 0..127 to index the tables
298B 9791             (    cube_core.asm):00275                         STA     <ZI
298D CE0089           (    cube_core.asm):00276                         LDU     #TY
2990 8D35             (    cube_core.asm):00277                         BSR     VSUM            ; rotated y, left in A
                      (    cube_core.asm):00278         
                      (    cube_core.asm):00279         ; screen y = CY + y * RYTAB[z] / 128
2992 308D024D         (    cube_core.asm):00280                         LEAX    RYTAB,PCR       ; B = RYTAB[ZI]
2996 D691             (    cube_core.asm):00281                         LDB     <ZI
2998 3A               (    cube_core.asm):00282                         ABX
2999 E684             (    cube_core.asm):00283                         LDB     ,X
299B 8D49             (    cube_core.asm):00284                         BSR     PMUL            ; A = y * RYTAB[z] / 128
299D 8B24             (    cube_core.asm):00285                         ADDA    #CY
299F 8E00A8           (    cube_core.asm):00286                         LDX     #PY             ; store at PY + VI
29A2 D68F             (    cube_core.asm):00287                         LDB     <VI
29A4 3A               (    cube_core.asm):00288                         ABX
29A5 A784             (    cube_core.asm):00289                         STA     ,X
                      (    cube_core.asm):00290         
                      (    cube_core.asm):00291         ; screen x = CX + x * RXTAB[z] / 128
29A7 308D01B8         (    cube_core.asm):00292                         LEAX    RXTAB,PCR       ; B = RXTAB[ZI]
29AB D691             (    cube_core.asm):00293                         LDB     <ZI
29AD 3A               (    cube_core.asm):00294                         ABX
29AE E684             (    cube_core.asm):00295                         LDB     ,X
29B0 9690             (    cube_core.asm):00296                         LDA     <VX             ; A = rotated x
29B2 8D32             (    cube_core.asm):00297                         BSR     PMUL
29B4 8B27             (    cube_core.asm):00298                         ADDA    #CX
29B6 8E00A0           (    cube_core.asm):00299                         LDX     #PX             ; store at PX + VI
29B9 D68F             (    cube_core.asm):00300                         LDB     <VI
29BB 3A               (    cube_core.asm):00301                         ABX
29BC A784             (    cube_core.asm):00302                         STA     ,X
                      (    cube_core.asm):00303         
29BE 0C8F             (    cube_core.asm):00304                         INC     <VI             ; next corner, until all 8 done
29C0 968F             (    cube_core.asm):00305                         LDA     <VI
29C2 8108             (    cube_core.asm):00306                         CMPA    #8
29C4 26B5             (    cube_core.asm):00307                         BNE     CN_LOOP
29C6 39               (    cube_core.asm):00308                         RTS
                      (    cube_core.asm):00309         
                      (    cube_core.asm):00310         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00311         ; VSUM - one rotated coordinate of one corner
                      (    cube_core.asm):00312         ;   Entry: U -> the three terms for this coordinate (TX, TY or TZ)
                      (    cube_core.asm):00313         ;          B = corner number: bit 0 set means x = +S, clear means x = -S;
                      (    cube_core.asm):00314         ;              bit 1 likewise for y, bit 2 for z
                      (    cube_core.asm):00315         ;   Exit:  A = term0 * (+/-1) + term1 * (+/-1) + term2 * (+/-1)
                      (    cube_core.asm):00316         ;          B preserved (so the caller can reuse it for the next coordinate)
                      (    cube_core.asm):00317         ; ---------------------------------------------------------------------------
29C7 4F               (    cube_core.asm):00318         VSUM            CLRA                    ; running total
29C8 C501             (    cube_core.asm):00319                         BITB    #1              ; x sign: add or subtract term 0
29CA 2704             (    cube_core.asm):00320                         BEQ     VS_1
29CC ABC4             (    cube_core.asm):00321                         ADDA    ,U
29CE 2002             (    cube_core.asm):00322                         BRA     VS_2
29D0 A0C4             (    cube_core.asm):00323         VS_1            SUBA    ,U
29D2 C502             (    cube_core.asm):00324         VS_2            BITB    #2              ; y sign: term 1
29D4 2704             (    cube_core.asm):00325                         BEQ     VS_3
29D6 AB41             (    cube_core.asm):00326                         ADDA    1,U
29D8 2002             (    cube_core.asm):00327                         BRA     VS_4
29DA A041             (    cube_core.asm):00328         VS_3            SUBA    1,U
29DC C504             (    cube_core.asm):00329         VS_4            BITB    #4              ; z sign: term 2
29DE 2703             (    cube_core.asm):00330                         BEQ     VS_5
29E0 AB42             (    cube_core.asm):00331                         ADDA    2,U
29E2 39               (    cube_core.asm):00332                         RTS
29E3 A042             (    cube_core.asm):00333         VS_5            SUBA    2,U
29E5 39               (    cube_core.asm):00334                         RTS
                      (    cube_core.asm):00335         
                      (    cube_core.asm):00336         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00337         ; PMUL - projection multiply: A = (A * B) / 128
                      (    cube_core.asm):00338         ;   Entry: A = coordinate (signed), B = scale from RXTAB/RYTAB (unsigned)
                      (    cube_core.asm):00339         ;   Exit:  A = result. B corrupted.
                      (    cube_core.asm):00340         ;
                      (    cube_core.asm):00341         ;   Like MULS7, but only A can be negative, so: make A positive, MUL,
                      (    cube_core.asm):00342         ;   divide by 128 the same way (ASLB/ROLA leaves D/128 in A), and negate
                      (    cube_core.asm):00343         ;   the answer if A was negative.
                      (    cube_core.asm):00344         ; ---------------------------------------------------------------------------
29E6 4D               (    cube_core.asm):00345         PMUL            TSTA
29E7 2A06             (    cube_core.asm):00346                         BPL     PM_1
29E9 40               (    cube_core.asm):00347                         NEGA                    ; negative coordinate:
29EA 3D               (    cube_core.asm):00348                         MUL                     ;  |A| * B
29EB 58               (    cube_core.asm):00349                         ASLB                    ;  / 128
29EC 49               (    cube_core.asm):00350                         ROLA
29ED 40               (    cube_core.asm):00351                         NEGA                    ;  and make it negative again
29EE 39               (    cube_core.asm):00352                         RTS
29EF 3D               (    cube_core.asm):00353         PM_1            MUL                     ; positive coordinate: A * B
29F0 58               (    cube_core.asm):00354                         ASLB                    ;  / 128
29F1 49               (    cube_core.asm):00355                         ROLA
29F2 39               (    cube_core.asm):00356                         RTS
                      (    cube_core.asm):00357         
                      (    cube_core.asm):00358         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00359         ; EDGES - draw the 12 edges
                      (    cube_core.asm):00360         ;
                      (    cube_core.asm):00361         ;   EDGETAB lists the 12 edges as pairs of corner numbers. For each pair,
                      (    cube_core.asm):00362         ;   look up both corners' screen positions in PX/PY and draw a line.
                      (    cube_core.asm):00363         ;   TGL_LINEC (the clipped line) is used because, when the cube is zoomed
                      (    cube_core.asm):00364         ;   right in, some corners land off the screen.
                      (    cube_core.asm):00365         ;
                      (    cube_core.asm):00366         ;   Y walks through EDGETAB four bytes at a time: 0,Y is the start corner,
                      (    cube_core.asm):00367         ;   1,Y the end corner, and 2,Y and 3,Y the two faces the edge borders.
                      (    cube_core.asm):00368         ;   Unless WIRE is set (draw every edge), an edge is skipped if both its
                      (    cube_core.asm):00369         ;   faces are hidden. Edges use the current plot mode.
                      (    cube_core.asm):00370         ; ---------------------------------------------------------------------------
29F3 318D003C         (    cube_core.asm):00371         EDGES           LEAY    EDGETAB,PCR
29F7 860C             (    cube_core.asm):00372                         LDA     #12             ; 12 edges to draw
29F9 9792             (    cube_core.asm):00373                         STA     <EC
29FB 0D99             (    cube_core.asm):00374         ED_LOOP         TST     <WIRE           ; wireframe: draw every edge
29FD 2612             (    cube_core.asm):00375                         BNE     ED_DRAW
29FF 8E00B0           (    cube_core.asm):00376                         LDX     #VIS            ; skip the edge unless one of its
2A02 E622             (    cube_core.asm):00377                         LDB     2,Y             ;  faces is visible
2A04 3A               (    cube_core.asm):00378                         ABX
2A05 A684             (    cube_core.asm):00379                         LDA     ,X
2A07 8E00B0           (    cube_core.asm):00380                         LDX     #VIS
2A0A E623             (    cube_core.asm):00381                         LDB     3,Y
2A0C 3A               (    cube_core.asm):00382                         ABX
2A0D AA84             (    cube_core.asm):00383                         ORA     ,X
2A0F 271B             (    cube_core.asm):00384                         BEQ     ED_NEXT
2A11 8E00A0           (    cube_core.asm):00385         ED_DRAW         LDX     #PX             ; end corner's position -> U
2A14 E621             (    cube_core.asm):00386                         LDB     1,Y             ;  X -> PX + end corner
2A16 3A               (    cube_core.asm):00387                         ABX
2A17 A684             (    cube_core.asm):00388                         LDA     ,X              ;  A = its x
2A19 E608             (    cube_core.asm):00389                         LDB     8,X             ;  B = its y (PY = PX + 8)
2A1B 1F03             (    cube_core.asm):00390                         TFR     D,U             ;  park x1:y1 in U for now
2A1D 8E00A0           (    cube_core.asm):00391                         LDX     #PX             ; start corner's position -> A, B
2A20 E6A4             (    cube_core.asm):00392                         LDB     ,Y
2A22 3A               (    cube_core.asm):00393                         ABX
2A23 A684             (    cube_core.asm):00394                         LDA     ,X              ;  A = x0
2A25 E608             (    cube_core.asm):00395                         LDB     8,X             ;  B = y0
2A27 1F31             (    cube_core.asm):00396                         TFR     U,X             ; X = x1:y1, the packed end point
2A29 BD1018           (    cube_core.asm):00397                         JSR     TGL_LINEC
2A2C 3124             (    cube_core.asm):00398         ED_NEXT         LEAY    4,Y             ; next edge
2A2E 0A92             (    cube_core.asm):00399                         DEC     <EC
2A30 26C9             (    cube_core.asm):00400                         BNE     ED_LOOP
2A32 39               (    cube_core.asm):00401                         RTS
                      (    cube_core.asm):00402         
                      (    cube_core.asm):00403         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00404         ; The 12 edges: start corner, end corner, and the two faces the edge
                      (    cube_core.asm):00405         ; borders (0 +x, 1 -x, 2 +y, 3 -y, 4 +z, 5 -z). The two corners differ in
                      (    cube_core.asm):00406         ; one bit, so the edge runs along that axis; its faces come from the other
                      (    cube_core.asm):00407         ; two bits (bit set: the + face, clear: the - face).
                      (    cube_core.asm):00408         ; ---------------------------------------------------------------------------
2A33                  (    cube_core.asm):00409         EDGETAB
2A33 00010305         (    cube_core.asm):00410                         FCB     0,1,3,5         ; along x: faces -y, -z
2A37 02030205         (    cube_core.asm):00411                         FCB     2,3,2,5         ; along x: faces +y, -z
2A3B 04050304         (    cube_core.asm):00412                         FCB     4,5,3,4         ; along x: faces -y, +z
2A3F 06070204         (    cube_core.asm):00413                         FCB     6,7,2,4         ; along x: faces +y, +z
2A43 00020105         (    cube_core.asm):00414                         FCB     0,2,1,5         ; along y: faces -x, -z
2A47 01030005         (    cube_core.asm):00415                         FCB     1,3,0,5         ; along y: faces +x, -z
2A4B 04060104         (    cube_core.asm):00416                         FCB     4,6,1,4         ; along y: faces -x, +z
2A4F 05070004         (    cube_core.asm):00417                         FCB     5,7,0,4         ; along y: faces +x, +z
2A53 00040103         (    cube_core.asm):00418                         FCB     0,4,1,3         ; along z: faces -x, -y
2A57 01050003         (    cube_core.asm):00419                         FCB     1,5,0,3         ; along z: faces +x, -y
2A5B 02060102         (    cube_core.asm):00420                         FCB     2,6,1,2         ; along z: faces -x, +y
2A5F 03070002         (    cube_core.asm):00421                         FCB     3,7,0,2         ; along z: faces +x, +y
