                      (      src/tgl.asm):00092                         INCLUDE "circle.asm"
                      (       circle.asm):00001         ; ---------------------------------------------------------------------------
                      (       circle.asm):00002         ; Circles - outlined and filled, corrected for the pixel shape
                      (       circle.asm):00003         ;   Entry: A = centre x, B = centre y (signed, -128..127),
                      (       circle.asm):00004         ;          X = radius in vertical pixels (0-127; larger values count as 127)
                      (       circle.asm):00005         ;          DP = $00
                      (       circle.asm):00006         ;   Exit:  all registers preserved
                      (       circle.asm):00007         ;   Both clip to the screen and use the current plot mode.
                      (       circle.asm):00008         ;
                      (       circle.asm):00009         ;   Teletext pixels are about 1.2 times wider than they are tall, so a
                      (       circle.asm):00010         ;   shape that is round in pixels looks squashed. Every half-width is
                      (       circle.asm):00011         ;   therefore scaled by 13/16 (0.81), the same correction the cube demo's
                      (       circle.asm):00012         ;   projection uses, so circles look round on screen.
                      (       circle.asm):00013         ;
                      (       circle.asm):00014         ;   The circle is worked out a row at a time, from the centre row outwards.
                      (       circle.asm):00015         ;   For row offset y, the unscaled half-width x is the largest x with
                      (       circle.asm):00016         ;   x^2 + y^2 <= r^2 + r (the midpoint rule, which rounds to the nearest
                      (       circle.asm):00017         ;   pixel). Moving to the next row only ever shrinks x, and the test can be
                      (       circle.asm):00018         ;   kept up to date with additions alone:
                      (       circle.asm):00019         ;       f = x^2 + y^2 - r^2 - r       (start: x = r, y = 0, so f = -r)
                      (       circle.asm):00020         ;       next row:     f = f + 2y + 1, then y = y + 1
                      (       circle.asm):00021         ;       while f > 0:  f = f - (2x - 1), x = x - 1
                      (       circle.asm):00022         ;
                      (       circle.asm):00023         ;   Outline: each row draws the run of pixels from just beyond the next
                      (       circle.asm):00024         ;   row's edge out to this row's edge (at least one pixel), on both sides,
                      (       circle.asm):00025         ;   for the rows above and below the centre. That joins the rows into an
                      (       circle.asm):00026         ;   unbroken outline and draws every pixel exactly once, so XOR works.
                      (       circle.asm):00027         ;   Filled: each row draws one span from edge to edge.
                      (       circle.asm):00028         ;   Runs and spans are drawn by HSPAN, a lean one-row fill.
                      (       circle.asm):00029         ; ---------------------------------------------------------------------------
                      (       circle.asm):00030         
1641 3476             (       circle.asm):00031         T_CIRC          PSHS    D,X,Y,U
1643 1701AA           (       circle.asm):00032                         LBSR    CI_SETUP
1646 0F37             (       circle.asm):00033                         CLR     <C_FILL         ; outline
1648 2009             (       circle.asm):00034                         BRA     CI_RUN
                      (       circle.asm):00035         
164A 3476             (       circle.asm):00036         T_CIRCF         PSHS    D,X,Y,U
164C 1701A1           (       circle.asm):00037                         LBSR    CI_SETUP
164F 8601             (       circle.asm):00038                         LDA     #1              ; filled
1651 9737             (       circle.asm):00039                         STA     <C_FILL
                      (       circle.asm):00040         
1653 0F2F             (       circle.asm):00041         CI_RUN          CLR     <C_ROW          ; start at the centre row
1655 D62E             (       circle.asm):00042                         LDB     <C_R            ; x = r
1657 D730             (       circle.asm):00043                         STB     <C_X
1659 4F               (       circle.asm):00044                         CLRA                    ; f = -r
165A 43               (       circle.asm):00045                         COMA                    ;  (negate D: complement, add 1)
165B 53               (       circle.asm):00046                         COMB
165C C30001           (       circle.asm):00047                         ADDD    #1
165F DD31             (       circle.asm):00048                         STD     <C_F
1661 9630             (       circle.asm):00049                         LDA     <C_X            ; half-width of the centre row
1663 170179           (       circle.asm):00050                         LBSR    SCALEX
1666 9733             (       circle.asm):00051                         STA     <C_HC
                      (       circle.asm):00052         
1668 962F             (       circle.asm):00053         CI_LOOP         LDA     <C_ROW          ; on the outermost row there is no
166A 912E             (       circle.asm):00054                         CMPA    <C_R            ;  next row: draw it edge to edge
166C 2710             (       circle.asm):00055                         BEQ     CI_TOP
166E 170144           (       circle.asm):00056                         LBSR    NEXTX           ; next row's half-width
1671 9734             (       circle.asm):00057                         STA     <C_HN
1673 4C               (       circle.asm):00058                         INCA                    ; this row's run starts just beyond
1674 9133             (       circle.asm):00059                         CMPA    <C_HC           ;  the next row's edge, but never
1676 2302             (       circle.asm):00060                         BLS     CI_S1           ;  past this row's own edge
1678 9633             (       circle.asm):00061                         LDA     <C_HC
167A 9735             (       circle.asm):00062         CI_S1           STA     <C_ST
167C 2002             (       circle.asm):00063                         BRA     CI_DRAW
167E 0F35             (       circle.asm):00064         CI_TOP          CLR     <C_ST           ; start 0 = one span, edge to edge
                      (       circle.asm):00065         
1680 0D37             (       circle.asm):00066         CI_DRAW         TST     <C_FILL         ; filled circles always draw the
1682 2702             (       circle.asm):00067                         BEQ     CI_ROWS         ;  full span
1684 0F35             (       circle.asm):00068                         CLR     <C_ST
                      (       circle.asm):00069         
1686 962D             (       circle.asm):00070         CI_ROWS         LDA     <C_CY           ; the row below the centre (screen y
1688 9B2F             (       circle.asm):00071                         ADDA    <C_ROW          ;  grows downwards). Saturate rather
168A 2802             (       circle.asm):00072                         BVC     CI_Y1           ;  than wrap: a row that far out is
168C 867F             (       circle.asm):00073                         LDA     #127            ;  off screen and gets clipped anyway
168E 9736             (       circle.asm):00074         CI_Y1           STA     <C_Y
1690 8D20             (       circle.asm):00075                         BSR     CI_ROWDRAW
1692 0D2F             (       circle.asm):00076                         TST     <C_ROW          ; the row above, except for the
1694 270C             (       circle.asm):00077                         BEQ     CI_NEXT         ;  centre row itself
1696 962D             (       circle.asm):00078                         LDA     <C_CY
1698 902F             (       circle.asm):00079                         SUBA    <C_ROW
169A 2802             (       circle.asm):00080                         BVC     CI_Y2
169C 8680             (       circle.asm):00081                         LDA     #-128
169E 9736             (       circle.asm):00082         CI_Y2           STA     <C_Y
16A0 8D10             (       circle.asm):00083                         BSR     CI_ROWDRAW
                      (       circle.asm):00084         
16A2 962F             (       circle.asm):00085         CI_NEXT         LDA     <C_ROW          ; done the outermost row?
16A4 912E             (       circle.asm):00086                         CMPA    <C_R
16A6 2708             (       circle.asm):00087                         BEQ     CI_END
16A8 0C2F             (       circle.asm):00088                         INC     <C_ROW
16AA 9634             (       circle.asm):00089                         LDA     <C_HN           ; next row's half-width becomes
16AC 9733             (       circle.asm):00090                         STA     <C_HC           ;  this row's
16AE 20B8             (       circle.asm):00091                         BRA     CI_LOOP
16B0 35F6             (       circle.asm):00092         CI_END          PULS    D,X,Y,U,PC
                      (       circle.asm):00093         
                      (       circle.asm):00094         ; ---------------------------------------------------------------------------
                      (       circle.asm):00095         ; CI_ROWDRAW - draw one row (screen y in C_Y)
                      (       circle.asm):00096         ;   C_ST = 0: one span from cx - half-width to cx + half-width.
                      (       circle.asm):00097         ;   C_ST > 0: two runs, cx + C_ST .. cx + half-width on the right and its
                      (       circle.asm):00098         ;   mirror image on the left.
                      (       circle.asm):00099         ;   Screen x values saturate at -128 / 127 instead of wrapping; anything
                      (       circle.asm):00100         ;   that far out is off screen and clipped anyway.
                      (       circle.asm):00101         ; ---------------------------------------------------------------------------
16B2 0D35             (       circle.asm):00102         CI_ROWDRAW      TST     <C_ST
16B4 2618             (       circle.asm):00103                         BNE     RD_TWO
16B6 962C             (       circle.asm):00104                         LDA     <C_CX           ; one span: left end ...
16B8 9033             (       circle.asm):00105                         SUBA    <C_HC
16BA 2802             (       circle.asm):00106                         BVC     RD_1
16BC 8680             (       circle.asm):00107                         LDA     #-128
16BE 3402             (       circle.asm):00108         RD_1            PSHS    A
16C0 962C             (       circle.asm):00109                         LDA     <C_CX           ; ... right end
16C2 9B33             (       circle.asm):00110                         ADDA    <C_HC
16C4 2802             (       circle.asm):00111                         BVC     RD_2
16C6 867F             (       circle.asm):00112                         LDA     #127
16C8 1F89             (       circle.asm):00113         RD_2            TFR     A,B
16CA 3502             (       circle.asm):00114                         PULS    A
16CC 202E             (       circle.asm):00115                         BRA     DRUN
                      (       circle.asm):00116         
16CE 962C             (       circle.asm):00117         RD_TWO          LDA     <C_CX           ; right-hand run: cx + start ...
16D0 9B35             (       circle.asm):00118                         ADDA    <C_ST
16D2 2802             (       circle.asm):00119                         BVC     RD_3
16D4 867F             (       circle.asm):00120                         LDA     #127
16D6 3402             (       circle.asm):00121         RD_3            PSHS    A
16D8 962C             (       circle.asm):00122                         LDA     <C_CX           ; ... to cx + half-width
16DA 9B33             (       circle.asm):00123                         ADDA    <C_HC
16DC 2802             (       circle.asm):00124                         BVC     RD_4
16DE 867F             (       circle.asm):00125                         LDA     #127
16E0 1F89             (       circle.asm):00126         RD_4            TFR     A,B
16E2 3502             (       circle.asm):00127                         PULS    A
16E4 8D16             (       circle.asm):00128                         BSR     DRUN
16E6 962C             (       circle.asm):00129                         LDA     <C_CX           ; left-hand run: cx - half-width ...
16E8 9033             (       circle.asm):00130                         SUBA    <C_HC
16EA 2802             (       circle.asm):00131                         BVC     RD_5
16EC 8680             (       circle.asm):00132                         LDA     #-128
16EE 3402             (       circle.asm):00133         RD_5            PSHS    A
16F0 962C             (       circle.asm):00134                         LDA     <C_CX           ; ... to cx - start
16F2 9035             (       circle.asm):00135                         SUBA    <C_ST
16F4 2802             (       circle.asm):00136                         BVC     RD_6
16F6 8680             (       circle.asm):00137                         LDA     #-128
16F8 1F89             (       circle.asm):00138         RD_6            TFR     A,B
16FA 3502             (       circle.asm):00139                         PULS    A
                      (       circle.asm):00140                         ; fall into DRUN
                      (       circle.asm):00141         
                      (       circle.asm):00142         ; ---------------------------------------------------------------------------
                      (       circle.asm):00143         ; DRUN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00144         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00145         ;   A single pixel (most of an outline) goes to the clipped plot, which is
                      (       circle.asm):00146         ;   cheaper; anything longer goes to HSPAN.
                      (       circle.asm):00147         ; ---------------------------------------------------------------------------
16FC 3404             (       circle.asm):00148         DRUN            PSHS    B
16FE A1E0             (       circle.asm):00149                         CMPA    ,S+
1700 2605             (       circle.asm):00150                         BNE     HSPAN
1702 D636             (       circle.asm):00151                         LDB     <C_Y            ; one pixel: A,B = x,y
1704 16FC7B           (       circle.asm):00152                         LBRA    T_PLOTC
                      (       circle.asm):00153         
                      (       circle.asm):00154         ; ---------------------------------------------------------------------------
                      (       circle.asm):00155         ; HSPAN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00156         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00157         ;   Exit:  A, B, X, U corrupted
                      (       circle.asm):00158         ;
                      (       circle.asm):00159         ;   A lean, single-row version of the rectangle fill. The row's left and
                      (       circle.asm):00160         ;   right pixel masks come straight from PTAB, so there is no sorting, no
                      (       circle.asm):00161         ;   multiply and no mask lookup: clip, find the cells, then
                      (       circle.asm):00162         ;     - if the run starts on a right-hand pixel, that cell gets only its
                      (       circle.asm):00163         ;       right pixel
                      (       circle.asm):00164         ;     - whole cells in between get both pixels, via the shared FILLSEG loop
                      (       circle.asm):00165         ;     - if the run ends on a left-hand pixel, that cell gets only its left
                      (       circle.asm):00166         ;   (or, when the run lies within one cell, whichever of its pixels count).
                      (       circle.asm):00167         ; ---------------------------------------------------------------------------
1707 3406             (       circle.asm):00168         HSPAN           PSHS    A,B             ; 0,S = left x, 1,S = right x
1709 D636             (       circle.asm):00169                         LDB     <C_Y            ; row off screen? (unsigned compare
170B C147             (       circle.asm):00170                         CMPB    #YMAX           ;  catches negative rows too)
170D 102200A2         (       circle.asm):00171                         LBHI    HS_X
1711 A661             (       circle.asm):00172                         LDA     1,S             ; run entirely left of the screen?
1713 102B009C         (       circle.asm):00173                         LBMI    HS_X
1717 A6E4             (       circle.asm):00174                         LDA     ,S              ; entirely right of it?
1719 814D             (       circle.asm):00175                         CMPA    #XMAX
171B 102E0094         (       circle.asm):00176                         LBGT    HS_X
171F 4D               (       circle.asm):00177                         TSTA                    ; clip the left end
1720 2A02             (       circle.asm):00178                         BPL     HS_1
1722 6FE4             (       circle.asm):00179                         CLR     ,S
1724 A661             (       circle.asm):00180         HS_1            LDA     1,S             ; clip the right end
1726 814D             (       circle.asm):00181                         CMPA    #XMAX
1728 2F04             (       circle.asm):00182                         BLE     HS_2
172A 864D             (       circle.asm):00183                         LDA     #XMAX
172C A761             (       circle.asm):00184                         STA     1,S
                      (       circle.asm):00185         
172E 17FEF6           (       circle.asm):00186         HS_2            LBSR    PT_ENTRY        ; U -> PTAB entry for this row (B = y)
1731 ECC4             (       circle.asm):00187                         LDD     ,U              ; X -> first cell of the cell row
1733 D300             (       circle.asm):00188                         ADDD    <W_BUF
1735 1F01             (       circle.asm):00189                         TFR     D,X
1737 A642             (       circle.asm):00190                         LDA     2,U             ; this sixel row's masks
1739 9725             (       circle.asm):00191                         STA     <F_ML
173B A643             (       circle.asm):00192                         LDA     3,U
173D 9726             (       circle.asm):00193                         STA     <F_MR
                      (       circle.asm):00194         
173F A6E4             (       circle.asm):00195                         LDA     ,S              ; first cell, and does the run start
1741 44               (       circle.asm):00196                         LSRA                    ;  on its right pixel (x odd)?
1742 971C             (       circle.asm):00197                         STA     <F_CX0
1744 8600             (       circle.asm):00198                         LDA     #0              ; (not CLRA: keep the carry)
1746 49               (       circle.asm):00199                         ROLA
1747 971E             (       circle.asm):00200                         STA     <F_PL
1749 A661             (       circle.asm):00201                         LDA     1,S             ; last cell, and does the run end
174B 44               (       circle.asm):00202                         LSRA                    ;  on its left pixel (x even)?
174C 971D             (       circle.asm):00203                         STA     <F_CX1
174E 8600             (       circle.asm):00204                         LDA     #0
1750 49               (       circle.asm):00205                         ROLA
1751 8801             (       circle.asm):00206                         EORA    #1
1753 971F             (       circle.asm):00207                         STA     <F_PR
                      (       circle.asm):00208         
1755 961C             (       circle.asm):00209                         LDA     <F_CX0          ; all within one cell?
1757 911D             (       circle.asm):00210                         CMPA    <F_CX1
1759 2617             (       circle.asm):00211                         BNE     HS_MULTI
175B 4F               (       circle.asm):00212                         CLRA                    ; its left pixel counts if the run
175C 0D1E             (       circle.asm):00213                         TST     <F_PL           ;  starts on it, its right pixel
175E 2602             (       circle.asm):00214                         BNE     HS_3            ;  if the run ends on it
1760 9A25             (       circle.asm):00215                         ORA     <F_ML
1762 0D1F             (       circle.asm):00216         HS_3            TST     <F_PR
1764 2602             (       circle.asm):00217                         BNE     HS_4
1766 9A26             (       circle.asm):00218                         ORA     <F_MR
1768 D61C             (       circle.asm):00219         HS_4            LDB     <F_CX0
176A 3A               (       circle.asm):00220                         ABX
176B C601             (       circle.asm):00221                         LDB     #1
176D 17FE8D           (       circle.asm):00222                         LBSR    FILLSEG
1770 2041             (       circle.asm):00223                         BRA     HS_X
                      (       circle.asm):00224         
1772 0D1E             (       circle.asm):00225         HS_MULTI        TST     <F_PL           ; partial first cell: right pixel
1774 270E             (       circle.asm):00226                         BEQ     HS_5
1776 3410             (       circle.asm):00227                         PSHS    X
1778 D61C             (       circle.asm):00228                         LDB     <F_CX0
177A 3A               (       circle.asm):00229                         ABX
177B 9626             (       circle.asm):00230                         LDA     <F_MR
177D C601             (       circle.asm):00231                         LDB     #1
177F 17FE7B           (       circle.asm):00232                         LBSR    FILLSEG
1782 3510             (       circle.asm):00233                         PULS    X
1784 961C             (       circle.asm):00234         HS_5            LDA     <F_CX0          ; whole cells: from the first (or the
1786 9B1E             (       circle.asm):00235                         ADDA    <F_PL           ;  one after) to the last (or the
1788 9721             (       circle.asm):00236                         STA     <F_RS           ;  one before)
178A 961D             (       circle.asm):00237                         LDA     <F_CX1
178C 901F             (       circle.asm):00238                         SUBA    <F_PR
178E 9021             (       circle.asm):00239                         SUBA    <F_RS
1790 4C               (       circle.asm):00240                         INCA
1791 2712             (       circle.asm):00241                         BEQ     HS_6            ; none
1793 9722             (       circle.asm):00242                         STA     <F_RN
1795 3410             (       circle.asm):00243                         PSHS    X
1797 D621             (       circle.asm):00244                         LDB     <F_RS
1799 3A               (       circle.asm):00245                         ABX
179A 9625             (       circle.asm):00246                         LDA     <F_ML
179C 9A26             (       circle.asm):00247                         ORA     <F_MR
179E D622             (       circle.asm):00248                         LDB     <F_RN
17A0 17FE5A           (       circle.asm):00249                         LBSR    FILLSEG
17A3 3510             (       circle.asm):00250                         PULS    X
17A5 0D1F             (       circle.asm):00251         HS_6            TST     <F_PR           ; partial last cell: left pixel
17A7 270A             (       circle.asm):00252                         BEQ     HS_X
17A9 D61D             (       circle.asm):00253                         LDB     <F_CX1
17AB 3A               (       circle.asm):00254                         ABX
17AC 9625             (       circle.asm):00255                         LDA     <F_ML
17AE C601             (       circle.asm):00256                         LDB     #1
17B0 17FE4A           (       circle.asm):00257                         LBSR    FILLSEG
17B3 3586             (       circle.asm):00258         HS_X            PULS    A,B,PC
