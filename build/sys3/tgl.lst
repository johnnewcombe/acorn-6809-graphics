                      (       circle.asm):00260         ; ---------------------------------------------------------------------------
                      (       circle.asm):00261         ; NEXTX - move on to the next row: update f and x, return the next row's
                      (       circle.asm):00262         ;   scaled half-width in A. (C_ROW still holds the current row offset y.)
                      (       circle.asm):00263         ; ---------------------------------------------------------------------------
17B5 D62F             (       circle.asm):00264         NEXTX           LDB     <C_ROW          ; f = f + 2y + 1
17B7 4F               (       circle.asm):00265                         CLRA
17B8 58               (       circle.asm):00266                         ASLB
17B9 49               (       circle.asm):00267                         ROLA
17BA C30001           (       circle.asm):00268                         ADDD    #1
17BD D331             (       circle.asm):00269                         ADDD    <C_F
17BF DD31             (       circle.asm):00270                         STD     <C_F
17C1 DC31             (       circle.asm):00271         NX_LOOP         LDD     <C_F            ; while f > 0 (and x > 0) ...
17C3 2F18             (       circle.asm):00272                         BLE     NX_DONE
17C5 0D30             (       circle.asm):00273                         TST     <C_X
17C7 2714             (       circle.asm):00274                         BEQ     NX_DONE
17C9 D630             (       circle.asm):00275                         LDB     <C_X            ; ... f = f - (2x - 1)
17CB 4F               (       circle.asm):00276                         CLRA
17CC 58               (       circle.asm):00277                         ASLB
17CD 49               (       circle.asm):00278                         ROLA
17CE 830001           (       circle.asm):00279                         SUBD    #1
17D1 3406             (       circle.asm):00280                         PSHS    D
17D3 DC31             (       circle.asm):00281                         LDD     <C_F
17D5 A3E1             (       circle.asm):00282                         SUBD    ,S++
17D7 DD31             (       circle.asm):00283                         STD     <C_F
17D9 0A30             (       circle.asm):00284                         DEC     <C_X            ; ... x = x - 1
17DB 20E4             (       circle.asm):00285                         BRA     NX_LOOP
17DD 9630             (       circle.asm):00286         NX_DONE         LDA     <C_X
                      (       circle.asm):00287                         ; fall into SCALEX
                      (       circle.asm):00288         
                      (       circle.asm):00289         ; ---------------------------------------------------------------------------
                      (       circle.asm):00290         ; SCALEX - aspect correction: A = (A * 13 + 8) / 16, rounded
                      (       circle.asm):00291         ;   Entry: A = 0-127   Exit: A = 0-103. B corrupted.
                      (       circle.asm):00292         ; ---------------------------------------------------------------------------
17DF C60D             (       circle.asm):00293         SCALEX          LDB     #13
17E1 3D               (       circle.asm):00294                         MUL                     ; D = x * 13
17E2 C30008           (       circle.asm):00295                         ADDD    #8              ; round
17E5 44               (       circle.asm):00296                         LSRA                    ; divide by 16
17E6 56               (       circle.asm):00297                         RORB
17E7 44               (       circle.asm):00298                         LSRA
17E8 56               (       circle.asm):00299                         RORB
17E9 44               (       circle.asm):00300                         LSRA
17EA 56               (       circle.asm):00301                         RORB
17EB 44               (       circle.asm):00302                         LSRA
17EC 56               (       circle.asm):00303                         RORB
17ED 1F98             (       circle.asm):00304                         TFR     B,A
17EF 39               (       circle.asm):00305                         RTS
                      (       circle.asm):00306         
                      (       circle.asm):00307         ; ---------------------------------------------------------------------------
                      (       circle.asm):00308         ; CI_SETUP - store the centre and radius (radius clamped to 0-127)
                      (       circle.asm):00309         ; ---------------------------------------------------------------------------
17F0 972C             (       circle.asm):00310         CI_SETUP        STA     <C_CX
17F2 D72D             (       circle.asm):00311                         STB     <C_CY
17F4 1F10             (       circle.asm):00312                         TFR     X,D             ; radius is X; anything over 127
17F6 4D               (       circle.asm):00313                         TSTA                    ;  becomes 127
17F7 2603             (       circle.asm):00314                         BNE     CS_BIG
17F9 5D               (       circle.asm):00315                         TSTB
17FA 2A02             (       circle.asm):00316                         BPL     CS_OK
17FC C67F             (       circle.asm):00317         CS_BIG          LDB     #127
17FE D72E             (       circle.asm):00318         CS_OK           STB     <C_R
