                      (       circle.asm):00140                         ; fall into DRUN
                      (       circle.asm):00141         
                      (       circle.asm):00142         ; ---------------------------------------------------------------------------
                      (       circle.asm):00143         ; DRUN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00144         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00145         ;   A single pixel (most of an outline) goes to the clipped plot, which is
                      (       circle.asm):00146         ;   cheaper; anything longer goes to HSPAN.
                      (       circle.asm):00147         ; ---------------------------------------------------------------------------
16B0 3404             (       circle.asm):00148         DRUN            PSHS    B
16B2 A1E0             (       circle.asm):00149                         CMPA    ,S+
16B4 2605             (       circle.asm):00150                         BNE     HSPAN
16B6 D636             (       circle.asm):00151                         LDB     <C_Y            ; one pixel: A,B = x,y
16B8 16FC7B           (       circle.asm):00152                         LBRA    T_PLOTC
                      (       circle.asm):00153         
                      (       circle.asm):00154         ; ---------------------------------------------------------------------------
                      (       circle.asm):00155         ; HSPAN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00156         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00157         ;   Exit:  A, B, X, U corrupted
                      (       circle.asm):00158         ;
                      (       circle.asm):00159         ;   A lean, single-row version of the rectangle fill. The row's left and
                      (       circle.asm):00160         ;   right pixel masks come straight from PTAB, so there is no sorting, no
                      (       circle.asm):00161         ;   multiply and no mask lookup: clip, find the cells, then
                      (       circle.asm):00162         ;     - if the run starts on a right-hand pixel, that cell gets only its
                      (       circle.asm):00163         ;       right pixel
                      (       circle.asm):00164         ;     - whole cells in between get both pixels, via the shared FILLSEG loop
                      (       circle.asm):00165         ;     - if the run ends on a left-hand pixel, that cell gets only its left
                      (       circle.asm):00166         ;   (or, when the run lies within one cell, whichever of its pixels count).
                      (       circle.asm):00167         ; ---------------------------------------------------------------------------
16BB 3406             (       circle.asm):00168         HSPAN           PSHS    A,B             ; 0,S = left x, 1,S = right x
16BD D636             (       circle.asm):00169                         LDB     <C_Y            ; row off screen? (unsigned compare
16BF C147             (       circle.asm):00170                         CMPB    #YMAX           ;  catches negative rows too)
16C1 102200A2         (       circle.asm):00171                         LBHI    HS_X
16C5 A661             (       circle.asm):00172                         LDA     1,S             ; run entirely left of the screen?
16C7 102B009C         (       circle.asm):00173                         LBMI    HS_X
16CB A6E4             (       circle.asm):00174                         LDA     ,S              ; entirely right of it?
16CD 814D             (       circle.asm):00175                         CMPA    #XMAX
16CF 102E0094         (       circle.asm):00176                         LBGT    HS_X
16D3 4D               (       circle.asm):00177                         TSTA                    ; clip the left end
16D4 2A02             (       circle.asm):00178                         BPL     HS_1
16D6 6FE4             (       circle.asm):00179                         CLR     ,S
16D8 A661             (       circle.asm):00180         HS_1            LDA     1,S             ; clip the right end
16DA 814D             (       circle.asm):00181                         CMPA    #XMAX
16DC 2F04             (       circle.asm):00182                         BLE     HS_2
16DE 864D             (       circle.asm):00183                         LDA     #XMAX
16E0 A761             (       circle.asm):00184                         STA     1,S
                      (       circle.asm):00185         
