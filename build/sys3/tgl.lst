                      (         clip.asm):00123         ; ---------------------------------------------------------------------------
                      (         clip.asm):00124         ; ISECT - A = u0 + (u1-u0) * (e-v0) / (v1-v0)
                      (         clip.asm):00125         ;   Rounded to the nearest pixel, which keeps trimmed lines closer to the
                      (         clip.asm):00126         ;   path the unclipped line would take (never more than one pixel off).
                      (         clip.asm):00127         ;   Worked in sign and magnitude: each difference is at most 255, and
                      (         clip.asm):00128         ;   |e-v0| <= |v1-v0| because the edge lies between the endpoints, so the
                      (         clip.asm):00129         ;   product fits 16 bits and the quotient fits 8. The result lies between
                      (         clip.asm):00130         ;   u0 and u1, so plain 8-bit addition gives the right signed value.
                      (         clip.asm):00131         ;   B corrupted.
                      (         clip.asm):00132         ; ---------------------------------------------------------------------------
13D8 0F14             (         clip.asm):00133         ISECT           CLR     <I_SGN
13DA 9610             (         clip.asm):00134                         LDA     <I_U1           ; |u1-u0|
13DC 900F             (         clip.asm):00135                         SUBA    <I_U0
13DE D610             (         clip.asm):00136                         LDB     <I_U1
13E0 D10F             (         clip.asm):00137                         CMPB    <I_U0
13E2 2C03             (         clip.asm):00138                         BGE     IS_1
13E4 40               (         clip.asm):00139                         NEGA
13E5 0314             (         clip.asm):00140                         COM     <I_SGN
13E7 9715             (         clip.asm):00141         IS_1            STA     <I_DU
13E9 9613             (         clip.asm):00142                         LDA     <I_E            ; |e-v0|
13EB 9011             (         clip.asm):00143                         SUBA    <I_V0
13ED D613             (         clip.asm):00144                         LDB     <I_E
13EF D111             (         clip.asm):00145                         CMPB    <I_V0
13F1 2C03             (         clip.asm):00146                         BGE     IS_2
13F3 40               (         clip.asm):00147                         NEGA
13F4 0314             (         clip.asm):00148                         COM     <I_SGN
13F6 D615             (         clip.asm):00149         IS_2            LDB     <I_DU
13F8 3D               (         clip.asm):00150                         MUL                     ; D = |u1-u0| * |e-v0|
13F9 3406             (         clip.asm):00151                         PSHS    D
13FB 9612             (         clip.asm):00152                         LDA     <I_V1           ; |v1-v0|
13FD 9011             (         clip.asm):00153                         SUBA    <I_V0
