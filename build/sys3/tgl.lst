10BB 9648             (          cls.asm):00042                         LDA     <ROWCOL+5
10BD A7C900C8         (          cls.asm):00043                         STA     5*COLS,U
10C1 9649             (          cls.asm):00044                         LDA     <ROWCOL+6
10C3 A7C900F0         (          cls.asm):00045                         STA     6*COLS,U
10C7 964A             (          cls.asm):00046                         LDA     <ROWCOL+7
10C9 A7C90118         (          cls.asm):00047                         STA     7*COLS,U
10CD 964B             (          cls.asm):00048                         LDA     <ROWCOL+8
10CF A7C90140         (          cls.asm):00049                         STA     8*COLS,U
10D3 964C             (          cls.asm):00050                         LDA     <ROWCOL+9
10D5 A7C90168         (          cls.asm):00051                         STA     9*COLS,U
10D9 964D             (          cls.asm):00052                         LDA     <ROWCOL+10
10DB A7C90190         (          cls.asm):00053                         STA     10*COLS,U
10DF 964E             (          cls.asm):00054                         LDA     <ROWCOL+11
10E1 A7C901B8         (          cls.asm):00055                         STA     11*COLS,U
10E5 964F             (          cls.asm):00056                         LDA     <ROWCOL+12
10E7 A7C901E0         (          cls.asm):00057                         STA     12*COLS,U
10EB 9650             (          cls.asm):00058                         LDA     <ROWCOL+13
10ED A7C90208         (          cls.asm):00059                         STA     13*COLS,U
10F1 9651             (          cls.asm):00060                         LDA     <ROWCOL+14
10F3 A7C90230         (          cls.asm):00061                         STA     14*COLS,U
10F7 9652             (          cls.asm):00062                         LDA     <ROWCOL+15
10F9 A7C90258         (          cls.asm):00063                         STA     15*COLS,U
10FD 9653             (          cls.asm):00064                         LDA     <ROWCOL+16
10FF A7C90280         (          cls.asm):00065                         STA     16*COLS,U
