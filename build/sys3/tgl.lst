                      (         rect.asm):00264         ;   Entry: A = x0, B = y0, X = x1:y1 (signed)    Exit: A, B corrupted
                      (         rect.asm):00265         ; ---------------------------------------------------------------------------
160A DD18             (         rect.asm):00266         R_SORT          STD     <R_X0
160C 9F1A             (         rect.asm):00267                         STX     <R_X1
160E 9618             (         rect.asm):00268                         LDA     <R_X0
1610 911A             (         rect.asm):00269                         CMPA    <R_X1
1612 2F06             (         rect.asm):00270                         BLE     RS_1
1614 D61A             (         rect.asm):00271                         LDB     <R_X1           ; swap the x coordinates
1616 D718             (         rect.asm):00272                         STB     <R_X0
1618 971A             (         rect.asm):00273                         STA     <R_X1
161A 9619             (         rect.asm):00274         RS_1            LDA     <R_Y0
161C 911B             (         rect.asm):00275                         CMPA    <R_Y1
