                      (         plot.asm):00001         ; ---------------------------------------------------------------------------
                      (         plot.asm):00002         ; T_SETMODE - select plot mode
                      (         plot.asm):00003         ;   Patches the pre-op and operation bytes in T_PLOT, the four T_LINE
                      (         plot.asm):00004         ;   loops and the rectangle fill, so pixel writes never test the mode.
                      (         plot.asm):00005         ;   Out-of-range modes are ignored.
                      (         plot.asm):00006         ;   Entry: A = MODE_SET, MODE_CLEAR or MODE_XOR, DP = $00
                      (         plot.asm):00007         ;   Exit:  all registers preserved
                      (         plot.asm):00008         ; ---------------------------------------------------------------------------
10E3 8102             (         plot.asm):00009         T_SETMODE       CMPA    #MODE_XOR
10E5 223F             (         plot.asm):00010                         BHI     SETM_X
10E7 3416             (         plot.asm):00011                         PSHS    D,X
10E9 9705             (         plot.asm):00012                         STA     <W_MODE
10EB 308D0808         (         plot.asm):00013                         LEAX    MODETAB,PCR
10EF 48               (         plot.asm):00014                         ASLA
10F0 EC86             (         plot.asm):00015                         LDD     A,X             ; A = pre-op byte, B = opcode
10F2 A78D0050         (         plot.asm):00016                         STA     PLOT_PRE,PCR
10F6 E78D004D         (         plot.asm):00017                         STB     PLOT_OP,PCR
10FA A78D0102         (         plot.asm):00018                         STA     LXD_PRE,PCR
10FE E78D00FF         (         plot.asm):00019                         STB     LXD_OP,PCR
1102 A78D0130         (         plot.asm):00020                         STA     LXU_PRE,PCR
1106 E78D012D         (         plot.asm):00021                         STB     LXU_OP,PCR
110A A78D015E         (         plot.asm):00022                         STA     LYR_PRE,PCR
110E E78D015B         (         plot.asm):00023                         STB     LYR_OP,PCR
1112 A78D018C         (         plot.asm):00024                         STA     LYL_PRE,PCR
1116 E78D0189         (         plot.asm):00025                         STB     LYL_OP,PCR
111A A78D0493         (         plot.asm):00026                         STA     FS_PRE,PCR      ; rectangle fill: the same pre-op,
111E C010             (         plot.asm):00027                         SUBB    #$10            ;  but its operation uses direct
1120 E78D0492         (         plot.asm):00028                         STB     FS_OP,PCR       ;  addressing (opcode $10 lower)
1124 3516             (         plot.asm):00029                         PULS    D,X
1126 39               (         plot.asm):00030         SETM_X          RTS
                      (         plot.asm):00031         
                      (         plot.asm):00032         ; ---------------------------------------------------------------------------
                      (         plot.asm):00033         ; T_PLOT - plot one sixel pixel in the off-screen buffer
                      (         plot.asm):00034         ;   Entry: A = x (0-77), B = y (0-71), DP = $00
                      (         plot.asm):00035         ;   Exit:  all registers preserved
                      (         plot.asm):00036         ;   No range checking in a normal build - out-of-range coordinates write
                      (         plot.asm):00037         ;   outside the buffer. A TGL_SAFE build ignores off-screen points instead.
                      (         plot.asm):00038         ;
                      (         plot.asm):00039         ;   cell = buffer + (y/3)*40 + 1 + x/2,  mask from (x&1, y%3)
                      (         plot.asm):00040         ; ---------------------------------------------------------------------------
1127                  (         plot.asm):00041         T_PLOT
                      (         plot.asm):00042                         IFDEF   TGL_SAFE
                      (         plot.asm):00043                         CMPA    #XMAX           ; off screen: do nothing
                      (         plot.asm):00044                         BHI     PLOT_RTS
                      (         plot.asm):00045                         CMPB    #YMAX
                      (         plot.asm):00046                         BHI     PLOT_RTS
                      (         plot.asm):00047                         ENDC
1127 3436             (         plot.asm):00048                         PSHS    D,X,Y
1129 318D06AA         (         plot.asm):00049                         LEAY    PTAB,PCR
112D 4F               (         plot.asm):00050                         CLRA                    ; D = y
112E 58               (         plot.asm):00051                         ASLB                    ; D = y*4 (entries are 4 bytes)
112F 49               (         plot.asm):00052                         ROLA
1130 58               (         plot.asm):00053                         ASLB
1131 49               (         plot.asm):00054                         ROLA
1132 31AB             (         plot.asm):00055                         LEAY    D,Y             ; Y -> PTAB entry for this y
1134 ECA4             (         plot.asm):00056                         LDD     ,Y              ; offset of column 1 of the cell row
1136 D300             (         plot.asm):00057                         ADDD    <W_BUF
1138 1F01             (         plot.asm):00058                         TFR     D,X
113A E6E4             (         plot.asm):00059                         LDB     ,S              ; x (caller's A, saved on the stack)
113C 54               (         plot.asm):00060                         LSRB                    ; B = x/2, C = x&1
113D 3A               (         plot.asm):00061                         ABX                     ; X -> cell (ABX leaves C alone)
113E 2504             (         plot.asm):00062                         BCS     PLOT_R
1140 A622             (         plot.asm):00063                         LDA     2,Y             ; left pixel mask
1142 2002             (         plot.asm):00064                         BRA     PLOT_PRE
1144 A623             (         plot.asm):00065         PLOT_R          LDA     3,Y             ; right pixel mask
1146 12               (         plot.asm):00066         PLOT_PRE        NOP                     ; patched: NOP or COMA
1147 AA84             (         plot.asm):00067         PLOT_OP         ORA     ,X              ; patched: ORA / ANDA / EORA ,X
1149 A784             (         plot.asm):00068                         STA     ,X
114B 35B6             (         plot.asm):00069                         PULS    D,X,Y,PC
                      (         plot.asm):00070                         IFDEF   TGL_SAFE
114D                  (         plot.asm):00071         PLOT_RTS        RTS
                      (         plot.asm):00072                         ENDC
                      (      src/tgl.asm):00077                         INCLUDE "line.asm"
                      (         line.asm):00001         ; ---------------------------------------------------------------------------
                      (         line.asm):00002         ; T_LINE - draw a line in the off-screen buffer (Bresenham)
                      (         line.asm):00003         ;   Entry: A = x0, B = y0, X = x1 (high byte) : y1 (low byte), DP = $00
                      (         line.asm):00004         ;          x 0-77, y 0-71. Uses the current plot mode.
                      (         line.asm):00005         ;          No range checking in a normal build. A TGL_SAFE build draws
                      (         line.asm):00006         ;          nothing if either endpoint is off screen.
                      (         line.asm):00007         ;   Exit:  all registers preserved
                      (         line.asm):00008         ;
                      (         line.asm):00009         ;   Rather than calling the plot routine per pixel, the loop tracks the
                      (         line.asm):00010         ;   cell pointer (X) and an internal pixel mask (B) and steps them directly.
                      (         line.asm):00011         ;   Internal masks put the bottom-right pixel in bit 5, so every step is a
                      (         line.asm):00012         ;   plain shift:
                      (         line.asm):00013         ;
                      (         line.asm):00014         ;        left right                 x step: shift 1   (cross cell: X +/- 1)
                      (         line.asm):00015         ;   top     1    2                  y step: shift 2   (cross row:  X +/- 40)
                      (         line.asm):00016         ;   middle  4    8
                      (         line.asm):00017         ;   bottom 16   32 (screen bit 6)   MASKREAL converts internal -> screen
                      (         line.asm):00018         ;
                      (         line.asm):00019         ;   Endpoints are swapped so the major axis always runs positive, leaving
                      (         line.asm):00020         ;   four loops: x-major with y up/down, y-major with x left/right. The
                      (         line.asm):00021         ;   chosen loop's |dx| and |dy| are patched into it as immediates, and
                      (         line.asm):00022         ;   T_SETMODE patches each loop's pixel operation.
                      (         line.asm):00023         ;   Error term stays within -77..+77, so it fits a signed byte.
                      (         line.asm):00024         ; ---------------------------------------------------------------------------
                      (         line.asm):00025         
                      (         line.asm):00026         ; Write the pixel at X with internal mask B (U -> MASKREAL)
114D                  (         line.asm):00027         LN_PIXEL        MACRO
                      (         line.asm):00028                         LDA     B,U             ; screen mask
114D                  (         line.asm):00029         \1_PRE          NOP                     ; patched by T_SETMODE
114D                  (         line.asm):00030         \1_OP           ORA     ,X              ; patched by T_SETMODE
                      (         line.asm):00031                         STA     ,X
                      (         line.asm):00032                         ENDM
                      (         line.asm):00033         
                      (         line.asm):00034         ; Step one pixel right / left / down / up
114D                  (         line.asm):00035         LN_RIGHT        MACRO
                      (         line.asm):00036                         BITB    #$15            ; left pixel?
                      (         line.asm):00037                         BEQ     \1_RN
                      (         line.asm):00038                         ASLB                    ; -> right pixel, same cell
                      (         line.asm):00039                         BRA     \1_RD
114D                  (         line.asm):00040         \1_RN           LSRB                    ; -> left pixel of next cell
                      (         line.asm):00041                         LEAX    1,X
114D                  (         line.asm):00042         \1_RD
                      (         line.asm):00043                         ENDM
                      (         line.asm):00044         
114D                  (         line.asm):00045         LN_LEFT         MACRO
                      (         line.asm):00046                         BITB    #$2A            ; right pixel?
                      (         line.asm):00047                         BEQ     \1_LN
                      (         line.asm):00048                         LSRB                    ; -> left pixel, same cell
                      (         line.asm):00049                         BRA     \1_LD
114D                  (         line.asm):00050         \1_LN           ASLB                    ; -> right pixel of previous cell
                      (         line.asm):00051                         LEAX    -1,X
114D                  (         line.asm):00052         \1_LD
                      (         line.asm):00053                         ENDM
                      (         line.asm):00054         
114D                  (         line.asm):00055         LN_DOWN         MACRO
                      (         line.asm):00056                         BITB    #$30            ; bottom sixel row?
                      (         line.asm):00057                         BNE     \1_DN
                      (         line.asm):00058                         ASLB                    ; -> next sixel row, same cell
                      (         line.asm):00059                         ASLB
                      (         line.asm):00060                         BRA     \1_DD
114D                  (         line.asm):00061         \1_DN           LSRB                    ; -> top sixel row, cell below
                      (         line.asm):00062                         LSRB
                      (         line.asm):00063                         LSRB
                      (         line.asm):00064                         LSRB
                      (         line.asm):00065                         LEAX    COLS,X
114D                  (         line.asm):00066         \1_DD
                      (         line.asm):00067                         ENDM
                      (         line.asm):00068         
114D                  (         line.asm):00069         LN_UP           MACRO
                      (         line.asm):00070                         BITB    #$03            ; top sixel row?
                      (         line.asm):00071                         BNE     \1_UN
                      (         line.asm):00072                         LSRB                    ; -> previous sixel row, same cell
                      (         line.asm):00073                         LSRB
                      (         line.asm):00074                         BRA     \1_UD
114D                  (         line.asm):00075         \1_UN           ASLB                    ; -> bottom sixel row, cell above
                      (         line.asm):00076                         ASLB
                      (         line.asm):00077                         ASLB
                      (         line.asm):00078                         ASLB
                      (         line.asm):00079                         LEAX    -COLS,X
114D                  (         line.asm):00080         \1_UD
                      (         line.asm):00081                         ENDM
                      (         line.asm):00082         
                      (         line.asm):00083         ; One loop: \1 = name, \2 = major step, \3 = minor step
114D                  (         line.asm):00084         LN_LOOP         MACRO
114D                  (         line.asm):00085         \1              LN_PIXEL \1
                      (         line.asm):00086                         LEAY    -1,Y
                      (         line.asm):00087                         BEQ     \1_X           ; local exit keeps this a short branch
                      (         line.asm):00088                         \2      \1
                      (         line.asm):00089                         LDA     <W_ERR
114D                  (         line.asm):00090         \1_SUB          SUBA    #0              ; patched: minor length
                      (         line.asm):00091                         BPL     \1_NS
114D                  (         line.asm):00092         \1_ADD          ADDA    #0              ; patched: major length
                      (         line.asm):00093                         STA     <W_ERR
                      (         line.asm):00094                         \3      \1
                      (         line.asm):00095                         BRA     \1
114D                  (         line.asm):00096         \1_NS           STA     <W_ERR
                      (         line.asm):00097                         BRA     \1
114D                  (         line.asm):00098         \1_X            PULS    D,X,Y,U,PC
                      (         line.asm):00099                         ENDM
                      (         line.asm):00100         
                      (         line.asm):00101         ; ---------------------------------------------------------------------------
114D                  (         line.asm):00102         T_LINE
                      (         line.asm):00103                         IFDEF   TGL_SAFE
                      (         line.asm):00104                         CMPA    #XMAX           ; start point off screen?
                      (         line.asm):00105                         BHI     LN_RTS
                      (         line.asm):00106                         CMPB    #YMAX
                      (         line.asm):00107                         BHI     LN_RTS
                      (         line.asm):00108                         PSHS    D,X             ; end point: 2,S = x1, 3,S = y1
                      (         line.asm):00109                         LDA     2,S
                      (         line.asm):00110                         CMPA    #XMAX
                      (         line.asm):00111                         BHI     LN_BAD
                      (         line.asm):00112                         LDA     3,S
                      (         line.asm):00113                         CMPA    #YMAX
                      (         line.asm):00114                         BHI     LN_BAD
                      (         line.asm):00115                         PULS    D,X
                      (         line.asm):00116                         BRA     LN_GO
114D                  (         line.asm):00117         LN_BAD          PULS    D,X
114D                  (         line.asm):00118         LN_RTS          RTS
114D                  (         line.asm):00119         LN_GO
                      (         line.asm):00120                         ENDC
