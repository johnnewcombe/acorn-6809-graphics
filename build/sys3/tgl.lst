                      (      src/tgl.asm):00093                         INCLUDE "text.asm"
                      (         text.asm):00001         ; ---------------------------------------------------------------------------
                      (         text.asm):00002         ; Status row text
                      (         text.asm):00003         ;   The status row is screen row 24, below the 24 rows of graphics. The
                      (         text.asm):00004         ;   blit never touches it, so text written there stays put while the
                      (         text.asm):00005         ;   graphics above it change. Text is written straight to the screen (not
                      (         text.asm):00006         ;   the off-screen buffer), so it appears immediately.
                      (         text.asm):00007         ;
                      (         text.asm):00008         ;   Strings are zero-terminated and may contain teletext control codes to
                      (         text.asm):00009         ;   colour the text that follows them on the row, e.g. $81 red, $82 green,
                      (         text.asm):00010         ;   $83 yellow, $84 blue, $85 magenta, $86 cyan, $87 white ($01-$07 work
                      (         text.asm):00011         ;   too: the SAA5050 ignores the top bit). Each control code takes up one
                      (         text.asm):00012         ;   character position and shows as a space. Text starts white at the
                      (         text.asm):00013         ;   left of the row.
                      (         text.asm):00014         ; ---------------------------------------------------------------------------
                      (         text.asm):00015         
     07C0             (         text.asm):00016         STATUS          EQU     VDU_BASE+STATUS_ROW*COLS        ; first byte of row 24
                      (         text.asm):00017         
                      (         text.asm):00018         ; ---------------------------------------------------------------------------
                      (         text.asm):00019         ; T_TEXT - write a string to the status row
                      (         text.asm):00020         ;   Entry: A = column (0-39), X -> zero-terminated string, DP = $00
                      (         text.asm):00021         ;   Exit:  all registers preserved
                      (         text.asm):00022         ;   Stops at the right-hand edge rather than wrapping. A column beyond 39
                      (         text.asm):00023         ;   writes nothing.
                      (         text.asm):00024         ; ---------------------------------------------------------------------------
1801 3456             (         text.asm):00025         T_TEXT          PSHS    D,X,U
1803 8127             (         text.asm):00026                         CMPA    #COLS-1         ; column off the end of the row?
1805 2212             (         text.asm):00027                         BHI     TX_X
1807 CE07C0           (         text.asm):00028                         LDU     #STATUS         ; U -> screen position
180A 33C6             (         text.asm):00029                         LEAU    A,U             ;  (A is 0-39, so the add is safe)
180C 1F89             (         text.asm):00030                         TFR     A,B             ; B = column, to stop at the edge
180E A680             (         text.asm):00031         TX_LOOP         LDA     ,X+             ; next character
1810 2707             (         text.asm):00032                         BEQ     TX_X            ; zero: end of string
1812 A7C0             (         text.asm):00033                         STA     ,U+
1814 5C               (         text.asm):00034                         INCB
1815 C128             (         text.asm):00035                         CMPB    #COLS           ; reached the right-hand edge?
1817 25F5             (         text.asm):00036                         BLO     TX_LOOP
1819 35D6             (         text.asm):00037         TX_X            PULS    D,X,U,PC
                      (         text.asm):00038         
                      (         text.asm):00039         ; ---------------------------------------------------------------------------
                      (         text.asm):00040         ; T_TCLR - clear the status row to spaces
                      (         text.asm):00041         ;   Entry: DP = $00    Exit: all registers preserved
                      (         text.asm):00042         ; ---------------------------------------------------------------------------
181B 3416             (         text.asm):00043         T_TCLR          PSHS    D,X
181D 8E07C0           (         text.asm):00044                         LDX     #STATUS
1820 CC2020           (         text.asm):00045                         LDD     #$2020          ; two spaces at a time
1823 ED81             (         text.asm):00046         TC_LOOP         STD     ,X++
1825 8C07E8           (         text.asm):00047                         CMPX    #STATUS+COLS
1828 25F9             (         text.asm):00048                         BLO     TC_LOOP
182A 3596             (         text.asm):00049                         PULS    D,X,PC
                      (         text.asm):00050         
                      (         text.asm):00051         ; ---------------------------------------------------------------------------
                      (         text.asm):00052         ; T_TNUM - write a number to the status row
                      (         text.asm):00053         ;   Entry: A = column (0-39), X = value (0-65535, unsigned), DP = $00
                      (         text.asm):00054         ;   Exit:  all registers preserved
                      (         text.asm):00055         ;   Always five characters, right-aligned with leading spaces, so a value
                      (         text.asm):00056         ;   that shrinks (e.g. from 100 to 99) leaves no stray digits behind.
                      (         text.asm):00057         ;
                      (         text.asm):00058         ;   Each digit is found by counting how many times the matching power of
                      (         text.asm):00059         ;   ten can be subtracted (10000, 1000, 100, 10); what is left is the last
                      (         text.asm):00060         ;   digit. Leading zeros become spaces; the last digit is always shown.
                      (         text.asm):00061         ; ---------------------------------------------------------------------------
182C 3476             (         text.asm):00062         T_TNUM          PSHS    D,X,Y,U
182E 1F10             (         text.asm):00063                         TFR     X,D             ; D = value
1830 338D0045         (         text.asm):00064                         LEAU    POW10,PCR       ; U -> 10000, 1000, 100, 10
1834 108E0038         (         text.asm):00065                         LDY     #T_BUF          ; Y -> where the characters go
1838 0F3F             (         text.asm):00066                         CLR     <T_LEAD         ; no non-zero digit yet
183A 0F3E             (         text.asm):00067         TN_DIGIT        CLR     <T_DIG
183C 10A3C4           (         text.asm):00068         TN_SUB          CMPD    ,U              ; can this power be subtracted?
183F 2506             (         text.asm):00069                         BLO     TN_PUT          ;  (unsigned compare)
1841 A3C4             (         text.asm):00070                         SUBD    ,U
1843 0C3E             (         text.asm):00071                         INC     <T_DIG
1845 20F5             (         text.asm):00072                         BRA     TN_SUB
1847 3406             (         text.asm):00073         TN_PUT          PSHS    D               ; keep the remainder
1849 963E             (         text.asm):00074                         LDA     <T_DIG
184B 2608             (         text.asm):00075                         BNE     TN_NZ           ; a zero before any other digit
184D 0D3F             (         text.asm):00076                         TST     <T_LEAD         ;  is a leading zero: a space
184F 2606             (         text.asm):00077                         BNE     TN_CH
1851 8620             (         text.asm):00078                         LDA     #' '
1853 2004             (         text.asm):00079                         BRA     TN_ST
1855 0C3F             (         text.asm):00080         TN_NZ           INC     <T_LEAD
1857 8B30             (         text.asm):00081         TN_CH           ADDA    #'0'
1859 A7A0             (         text.asm):00082         TN_ST           STA     ,Y+
185B 3506             (         text.asm):00083                         PULS    D
185D 3342             (         text.asm):00084                         LEAU    2,U             ; next power of ten
185F 308D001E         (         text.asm):00085                         LEAX    POW10E,PCR
1863 3410             (         text.asm):00086                         PSHS    X
1865 11A3E1           (         text.asm):00087                         CMPU    ,S++            ; done all four powers?
1868 25D0             (         text.asm):00088                         BLO     TN_DIGIT
186A CB30             (         text.asm):00089                         ADDB    #'0'            ; the last digit, always shown
186C E7A0             (         text.asm):00090                         STB     ,Y+
186E 6FA4             (         text.asm):00091                         CLR     ,Y              ; end of string
1870 A6E4             (         text.asm):00092                         LDA     ,S              ; column (caller's A, on the stack)
1872 8E0038           (         text.asm):00093                         LDX     #T_BUF
1875 8D8A             (         text.asm):00094                         BSR     T_TEXT
1877 35F6             (         text.asm):00095                         PULS    D,X,Y,U,PC
                      (         text.asm):00096         
1879 271003E80064000A (         text.asm):00097         POW10           FDB     10000,1000,100,10
1881                  (         text.asm):00098         POW10E
                      (      src/tgl.asm):00094                         INCLUDE "colour.asm"
                      (       colour.asm):00001         ; ---------------------------------------------------------------------------
                      (       colour.asm):00002         ; T_COLOUR - set the graphics colour of a band of rows
                      (       colour.asm):00003         ;   Entry: A = first row, B = last row (0-23, cell rows: row r covers
                      (       colour.asm):00004         ;          pixel rows y = 3r to 3r+2), X = colour (1 red, 2 green,
                      (       colour.asm):00005         ;          3 yellow, 4 blue, 5 magenta, 6 cyan, 7 white; only the low
                      (       colour.asm):00006         ;          3 bits are used, and 0 counts as white), DP = $00
                      (       colour.asm):00007         ;   Exit:  all registers preserved
                      (       colour.asm):00008         ;
                      (       colour.asm):00009         ;   Teletext colours a row by the control code at its start: $91-$97 mean
                      (       colour.asm):00010         ;   "graphics in red ... white from here on". The library keeps column 0
                      (       colour.asm):00011         ;   of every buffer row for that code, so changing a row's colour costs no
                      (       colour.asm):00012         ;   pixels and no drawing time. The new code is written into the buffer
                      (       colour.asm):00013         ;   straight away (it shows at the next blit) and remembered in ROWCOL, so
                      (       colour.asm):00014         ;   TGL_CLS keeps it.
                      (       colour.asm):00015         ;   A first row beyond 23 does nothing; a last row beyond 23 counts as 23;
                      (       colour.asm):00016         ;   if first > last nothing changes.
                      (       colour.asm):00017         ; ---------------------------------------------------------------------------
1881 3456             (       colour.asm):00018         T_COLOUR        PSHS    D,X,U
1883 8117             (       colour.asm):00019                         CMPA    #ROWS-1         ; first row off the bottom?
1885 2238             (       colour.asm):00020                         BHI     CO_X
1887 C117             (       colour.asm):00021                         CMPB    #ROWS-1         ; clamp the last row
1889 2302             (       colour.asm):00022                         BLS     CO_1
188B C617             (       colour.asm):00023                         LDB     #ROWS-1
188D 9740             (       colour.asm):00024         CO_1            STA     <K_FIRST
188F D741             (       colour.asm):00025                         STB     <K_LAST
1891 9141             (       colour.asm):00026                         CMPA    <K_LAST         ; empty band?
1893 222A             (       colour.asm):00027                         BHI     CO_X
1895 1F10             (       colour.asm):00028                         TFR     X,D             ; B = colour
1897 C407             (       colour.asm):00029                         ANDB    #7
1899 2602             (       colour.asm):00030                         BNE     CO_2
189B C607             (       colour.asm):00031                         LDB     #7              ; 0 counts as white
189D CA90             (       colour.asm):00032         CO_2            ORB     #$90            ; $91-$97: graphics colour codes
189F D742             (       colour.asm):00033                         STB     <K_CODE
                      (       colour.asm):00034         
18A1 9640             (       colour.asm):00035                         LDA     <K_FIRST        ; U -> ROWCOL entry for the first row
18A3 CE0043           (       colour.asm):00036                         LDU     #ROWCOL
18A6 33C6             (       colour.asm):00037                         LEAU    A,U
18A8 C628             (       colour.asm):00038                         LDB     #COLS           ; X -> column 0 of that buffer row
18AA 3D               (       colour.asm):00039                         MUL                     ;  (first row * 40)
18AB D300             (       colour.asm):00040                         ADDD    <W_BUF
18AD 1F01             (       colour.asm):00041                         TFR     D,X
18AF D640             (       colour.asm):00042                         LDB     <K_FIRST        ; B counts rows
18B1 9642             (       colour.asm):00043         CO_LOOP         LDA     <K_CODE
18B3 A7C0             (       colour.asm):00044                         STA     ,U+             ; remember it ...
18B5 A784             (       colour.asm):00045                         STA     ,X              ; ... and put it in the buffer
18B7 308828           (       colour.asm):00046                         LEAX    COLS,X          ; next buffer row
18BA D141             (       colour.asm):00047                         CMPB    <K_LAST         ; was that the last row? (carry set
18BC 5C               (       colour.asm):00048                         INCB                    ;  if not; INCB leaves the carry
18BD 25F2             (       colour.asm):00049                         BLO     CO_LOOP         ;  alone, so BLO still sees it)
18BF 35D6             (       colour.asm):00050         CO_X            PULS    D,X,U,PC
                      (      src/tgl.asm):00095                         INCLUDE "pace.asm"
                      (         pace.asm):00001         ; ---------------------------------------------------------------------------
                      (         pace.asm):00002         ; T_PACE - keep a steady frame rate
                      (         pace.asm):00003         ;   Entry: A = frame length in 50Hz ticks: 1 = 50 fps, 2 = 25 fps,
                      (         pace.asm):00004         ;          3 = about 17 fps (0 counts as 1, more than 3 counts as 3)
                      (         pace.asm):00005         ;          DP = $00
                      (         pace.asm):00006         ;   Exit:  all registers preserved
                      (         pace.asm):00007         ;
                      (         pace.asm):00008         ;   Call once per frame, just before TGL_BLIT. It waits until the frame
                      (         pace.asm):00009         ;   period started by the previous call has run out, then starts the next
                      (         pace.asm):00010         ;   one, so every frame takes the same time however much was drawn. If a
                      (         pace.asm):00011         ;   frame took longer than its period it carries straight on, so the frame
                      (         pace.asm):00012         ;   rate falls gracefully rather than stalling. The first call after
                      (         pace.asm):00013         ;   TGL_INIT starts timing without waiting.
                      (         pace.asm):00014         ;
                      (         pace.asm):00015         ;   The period is timed with Timer 2 of the main VIA, in one-shot mode:
                      (         pace.asm):00016         ;   writing its high byte loads the count and starts it, and IFR bit 5 sets
                      (         pace.asm):00017         ;   when it reaches zero. Only the flag is polled - the timer's interrupt is
                      (         pace.asm):00018         ;   never enabled - and nothing else in the library touches the VIA. A
                      (         pace.asm):00019         ;   program that needs Timer 2 for itself simply doesn't call TGL_PACE, or
                      (         pace.asm):00020         ;   builds the library with NOPACE=1, which reduces this routine to RTS.
                      (         pace.asm):00021         ;
                      (         pace.asm):00022         ;   Timer 2's longest count is 65535 clocks (65ms at 1MHz), which is why
                      (         pace.asm):00023         ;   periods stop at three ticks (60ms).
                      (         pace.asm):00024         ;
                      (         pace.asm):00025         ;   This keeps animation smooth and even, but cannot stop tearing: the
                      (         pace.asm):00026         ;   timer is not locked to the display, as the 6845's vertical sync is not
                      (         pace.asm):00027         ;   connected to anything the CPU can read.
                      (         pace.asm):00028         ; ---------------------------------------------------------------------------
                      (         pace.asm):00029                         IFDEF   TGL_NOPACE
18C1                  (         pace.asm):00030         T_PACE          RTS                     ; NOPACE build: does nothing
                      (         pace.asm):00031                         ELSE
                      (         pace.asm):00032         
18C1 3416             (         pace.asm):00033         T_PACE          PSHS    D,X
18C3 4D               (         pace.asm):00034                         TSTA                    ; ticks: 0 counts as 1 ...
18C4 2601             (         pace.asm):00035                         BNE     PA_1
18C6 4C               (         pace.asm):00036                         INCA
18C7 8103             (         pace.asm):00037         PA_1            CMPA    #3              ; ... more than 3 counts as 3
18C9 2302             (         pace.asm):00038                         BLS     PA_2
18CB 8603             (         pace.asm):00039                         LDA     #3
18CD 8E0980           (         pace.asm):00040         PA_2            LDX     #VIA_BASE
18D0 0D5B             (         pace.asm):00041                         TST     <P_RUN          ; a period running? wait for it to
18D2 2706             (         pace.asm):00042                         BEQ     PA_START        ;  finish (first call: no waiting)
18D4 E60D             (         pace.asm):00043         PA_WAIT         LDB     VIA_IFR,X
18D6 C520             (         pace.asm):00044                         BITB    #T2_FLAG
18D8 27FA             (         pace.asm):00045                         BEQ     PA_WAIT
                      (         pace.asm):00046         
18DA E60B             (         pace.asm):00047         PA_START        LDB     VIA_ACR,X       ; make sure Timer 2 is a one-shot
18DC C4DF             (         pace.asm):00048                         ANDB    #~ACR_T2COUNT&$FF   ;  timer, leaving the rest of the
18DE E70B             (         pace.asm):00049                         STB     VIA_ACR,X       ;  ACR alone
18E0 308D000E         (         pace.asm):00050                         LEAX    PA_TAB-2,PCR    ; X -> period for A ticks (2 bytes
18E4 48               (         pace.asm):00051                         ASLA                    ;  each, A = 1-3)
