                      (      src/tgl.asm):00001         ; ===========================================================================
                      (      src/tgl.asm):00002         ; Acorn System 3 Teletext Graphics Library (working name)
                      (      src/tgl.asm):00003         ; 6809 sixel graphics for the Acorn teletext VDU (6845 + SAA5050)
                      (      src/tgl.asm):00004         ;
                      (      src/tgl.asm):00005         ; Build with -D TARGET_FLEX for the FLEX machine; default is a standard
                      (      src/tgl.asm):00006         ; System 3. The binary is position-independent: load it anywhere and call
                      (      src/tgl.asm):00007         ; the entry points as fixed offsets from the load address (tgl_api.inc).
                      (      src/tgl.asm):00008         ;
                      (      src/tgl.asm):00009         ; Rules that keep it position-independent:
                      (      src/tgl.asm):00010         ;   - references to the library's own code/data use ,PCR
                      (      src/tgl.asm):00011         ;   - the jump table uses LBRA
                      (      src/tgl.asm):00012         ;   - only hardware (VDU, CRTC) and page-zero workspace are absolute
                      (      src/tgl.asm):00013         ; The Makefile assembles at two origins and fails if the binaries differ.
                      (      src/tgl.asm):00014         ; ===========================================================================
                      (      src/tgl.asm):00015         
                      (      src/tgl.asm):00016                         IFDEF   TARGET_FLEX
                      (      src/tgl.asm):00017                         INCLUDE "target/flex.inc"
                      (      src/tgl.asm):00018                         ELSE
                      (      src/tgl.asm):00019                         INCLUDE "target/sys3.inc"
                      (  target/sys3.inc):00001         ; ---------------------------------------------------------------------------
                      (  target/sys3.inc):00002         ; Target: standard Acorn System 3 with 6809 CPU card
                      (  target/sys3.inc):00003         ; ---------------------------------------------------------------------------
     0400             (  target/sys3.inc):00004         VDU_BASE        EQU     $0400           ; teletext VDU screen RAM
     0800             (  target/sys3.inc):00005         CRTC_ADDR       EQU     $0800           ; 6845 address register
     0801             (  target/sys3.inc):00006         CRTC_DATA       EQU     $0801           ; 6845 data register
                      (  target/sys3.inc):00007         
                      (  target/sys3.inc):00008         ; Default load address. Override with: lwasm -D TGL_ORG=0x2000
                      (  target/sys3.inc):00009         ; (The code is position-independent; this only sets where the
                      (  target/sys3.inc):00010         ; listing and the default build place it.)
                      (  target/sys3.inc):00011                         IFNDEF  TGL_ORG
     1000             (  target/sys3.inc):00012         TGL_ORG         EQU     $1000
                      (  target/sys3.inc):00013                         ENDC
                      (  target/sys3.inc):00014         
                      (  target/sys3.inc):00015         ; Monitor RAM vectors and keyboard buffer pointers (monitor RAM at $0300)
                      (  target/sys3.inc):00016         ; Checked against the standard ROM listing (monitor source with BASE=$0000).
     0365             (  target/sys3.inc):00017         MON_COPADR      EQU     $0365           ; console output routine address
     0367             (  target/sys3.inc):00018         MON_CINADR      EQU     $0367           ; console input routine address
     0387             (  target/sys3.inc):00019         MON_HEADST      EQU     $0387           ; keyboard buffer: static head
     038B             (  target/sys3.inc):00020         MON_TAIL        EQU     $038B           ; keyboard buffer: tail
                      (      src/tgl.asm):00020                         ENDC
                      (      src/tgl.asm):00021         
                      (      src/tgl.asm):00022                         INCLUDE "consts.inc"
                      (       consts.inc):00001         ; ---------------------------------------------------------------------------
                      (       consts.inc):00002         ; Screen geometry and teletext constants (target independent)
                      (       consts.inc):00003         ; ---------------------------------------------------------------------------
     0028             (       consts.inc):00004         COLS            EQU     40              ; characters per row
     0018             (       consts.inc):00005         ROWS            EQU     24              ; graphics rows (row 24 left for status)
     03C0             (       consts.inc):00006         BUFSIZE         EQU     COLS*ROWS       ; 960 bytes - off-screen buffer size
                      (       consts.inc):00007         
     0097             (       consts.inc):00008         GFX_WHITE       EQU     $97             ; white graphics control code
     0020             (       consts.inc):00009         SIXEL_BLANK     EQU     $20             ; graphics cell, no pixels set
     007F             (       consts.inc):00010         SIXEL_FULL      EQU     $7F             ; graphics cell, all six pixels set
                      (       consts.inc):00011         
                      (       consts.inc):00012         ; Plot modes (see TGL_SETMODE)
     0000             (       consts.inc):00013         MODE_SET        EQU     0
     0001             (       consts.inc):00014         MODE_CLEAR      EQU     1
     0002             (       consts.inc):00015         MODE_XOR        EQU     2
                      (       consts.inc):00016         
     004D             (       consts.inc):00017         XMAX            EQU     77              ; largest visible x
     0047             (       consts.inc):00018         YMAX            EQU     71              ; largest visible y
                      (      src/tgl.asm):00023                         INCLUDE "ws.inc"
                      (           ws.inc):00001         ; ---------------------------------------------------------------------------
                      (           ws.inc):00002         ; Workspace - lives in the direct page. Callers must enter every library
                      (           ws.inc):00003         ; routine with DP = $00.
                      (           ws.inc):00004         ; ---------------------------------------------------------------------------
     0000             (           ws.inc):00005         WS              EQU     $00             ; workspace base within page zero
                      (           ws.inc):00006         
     0000             (           ws.inc):00007         W_BUF           EQU     WS+0            ; 2  off-screen buffer address
     0002             (           ws.inc):00008         W_SAVSP         EQU     WS+2            ; 2  caller's S, saved during blit
     0004             (           ws.inc):00009         W_COUNT         EQU     WS+4            ; 1  general loop counter
     0005             (           ws.inc):00010         W_MODE          EQU     WS+5            ; 1  current plot mode
     0006             (           ws.inc):00011         W_X0            EQU     WS+6            ; 1  line start x  } W_X0/W_Y0 and
     0007             (           ws.inc):00012         W_Y0            EQU     WS+7            ; 1  line start y  } W_X1/W_Y1 are
     0008             (           ws.inc):00013         W_X1            EQU     WS+8            ; 1  line end x    } used as 16-bit
     0009             (           ws.inc):00014         W_Y1            EQU     WS+9            ; 1  line end y    } pairs
     000A             (           ws.inc):00015         W_ADX           EQU     WS+10           ; 1  |dx|
     000B             (           ws.inc):00016         W_ADY           EQU     WS+11           ; 1  |dy|
     000C             (           ws.inc):00017         W_ERR           EQU     WS+12           ; 1  Bresenham error term
     000D             (           ws.inc):00018         W_C0            EQU     WS+13           ; 1  clip: outcode of start point
     000E             (           ws.inc):00019         W_C1            EQU     WS+14           ; 1  clip: outcode of end point
     000F             (           ws.inc):00020         I_U0            EQU     WS+15           ; 1  clip intersection: u0, u1, v0, v1
     0010             (           ws.inc):00021         I_U1            EQU     WS+16           ; 1    (u = axis being solved for,
     0011             (           ws.inc):00022         I_V0            EQU     WS+17           ; 1     v = axis of the edge)
     0012             (           ws.inc):00023         I_V1            EQU     WS+18           ; 1
     0013             (           ws.inc):00024         I_E             EQU     WS+19           ; 1  clip: edge position
     0014             (           ws.inc):00025         I_SGN           EQU     WS+20           ; 1  clip: sign of the result offset
     0015             (           ws.inc):00026         I_DU            EQU     WS+21           ; 1  clip: |u1-u0|
     0016             (           ws.inc):00027         I_DV            EQU     WS+22           ; 1  clip: |v1-v0| (divisor)
     0017             (           ws.inc):00028         I_CNT           EQU     WS+23           ; 1  clip: divide loop counter
     0018             (           ws.inc):00029         WS_SIZE         EQU     24
                      (      src/tgl.asm):00024         
     00               (      src/tgl.asm):00025                         SETDP   $00
                      (      src/tgl.asm):00026                         ORG     TGL_ORG
                      (      src/tgl.asm):00027         
                      (      src/tgl.asm):00028         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00029         ; Jump table - order and offsets must match tgl_api.inc
                      (      src/tgl.asm):00030         ; ---------------------------------------------------------------------------
1000                  (      src/tgl.asm):00031         TGL_START
1000 160021           (      src/tgl.asm):00032         J_INIT          LBRA    T_INIT          ; +0
1003 160048           (      src/tgl.asm):00033         J_SETBUF        LBRA    T_SETBUF        ; +3
1006 160048           (      src/tgl.asm):00034         J_CLS           LBRA    T_CLS           ; +6
1009 1600CB           (      src/tgl.asm):00035         J_SETMODE       LBRA    T_SETMODE       ; +9
100C 160102           (      src/tgl.asm):00036         J_PLOT          LBRA    T_PLOT          ; +12
100F 160125           (      src/tgl.asm):00037         J_LINE          LBRA    T_LINE          ; +15
1012 1602D9           (      src/tgl.asm):00038         J_BLIT          LBRA    T_BLIT          ; +18
1015 160308           (      src/tgl.asm):00039         J_PLOTC         LBRA    T_PLOTC         ; +21
1018 160311           (      src/tgl.asm):00040         J_LINEC         LBRA    T_LINEC         ; +24
101B 160407           (      src/tgl.asm):00041         J_DONE          LBRA    T_DONE          ; +27
101E 16040E           (      src/tgl.asm):00042         J_INKEY         LBRA    T_INKEY         ; +30
1021 160420           (      src/tgl.asm):00043         J_EXIT          LBRA    T_EXIT          ; +33
                      (      src/tgl.asm):00044         
                      (      src/tgl.asm):00045         ; Check the table against the published interface
     1000             (      src/tgl.asm):00046         TGL_BASE        EQU     TGL_START
                      (      src/tgl.asm):00047                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
                      (      tgl_api.inc):00021         
     03C0             (      tgl_api.inc):00022         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00023         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00024         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00025         TGL_MODE_XOR    EQU     2
                      (      src/tgl.asm):00048                         IFNE    (J_SETBUF-TGL_SETBUF)|(J_CLS-TGL_CLS)|(J_SETMODE-TGL_SETMODE)
                      (      src/tgl.asm):00049                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00050                         ENDC
                      (      src/tgl.asm):00051                         IFNE    (J_PLOT-TGL_PLOT)|(J_LINE-TGL_LINE)|(J_BLIT-TGL_BLIT)
                      (      src/tgl.asm):00052                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00053                         ENDC
                      (      src/tgl.asm):00054                         IFNE    (J_PLOTC-TGL_PLOTC)|(J_LINEC-TGL_LINEC)
                      (      src/tgl.asm):00055                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00056                         ENDC
                      (      src/tgl.asm):00057                         IFNE    (J_DONE-TGL_DONE)|(J_INKEY-TGL_INKEY)|(J_EXIT-TGL_EXIT)
                      (      src/tgl.asm):00058                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00059                         ENDC
                      (      src/tgl.asm):00060         
                      (      src/tgl.asm):00061         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00062         ; Modules
                      (      src/tgl.asm):00063         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00064                         INCLUDE "init.asm"
                      (         init.asm):00001         ; ---------------------------------------------------------------------------
                      (         init.asm):00002         ; T_INIT - initialise the library
                      (         init.asm):00003         ;   Resets the 6845 display start address (R12/R13) to zero so the visible
                      (         init.asm):00004         ;   screen begins at VDU_BASE. The monitor and FLEX VDU drivers scroll in
                      (         init.asm):00005         ;   hardware, which can leave the start address anywhere in the 1K.
                      (         init.asm):00006         ;   Hides the hardware cursor (R10 = $20, the "no cursor" mode bits).
                      (         init.asm):00007         ;   Sets the off-screen buffer to the memory immediately after the library
                      (         init.asm):00008         ;   (BUFSIZE bytes must be free there) and the plot mode to MODE_SET.
                      (         init.asm):00009         ;   Entry: DP = $00            Exit: all registers preserved
                      (         init.asm):00010         ; ---------------------------------------------------------------------------
1024 3416             (         init.asm):00011         T_INIT          PSHS    D,X
1026 5F               (         init.asm):00012                         CLRB
1027 860C             (         init.asm):00013                         LDA     #12             ; R12 - start address high
1029 B70800           (         init.asm):00014                         STA     CRTC_ADDR
102C F70801           (         init.asm):00015                         STB     CRTC_DATA
102F 860D             (         init.asm):00016                         LDA     #13             ; R13 - start address low
1031 B70800           (         init.asm):00017                         STA     CRTC_ADDR
1034 F70801           (         init.asm):00018                         STB     CRTC_DATA
1037 860A             (         init.asm):00019                         LDA     #10             ; R10 - cursor start / blink mode
1039 B70800           (         init.asm):00020                         STA     CRTC_ADDR
103C 8620             (         init.asm):00021                         LDA     #$20            ; bits 6-5 = 01: no cursor
103E B70801           (         init.asm):00022                         STA     CRTC_DATA
1041 308D0549         (         init.asm):00023                         LEAX    TGL_END,PCR
1045 9F00             (         init.asm):00024                         STX     <W_BUF
1047 8600             (         init.asm):00025                         LDA     #MODE_SET
1049 17008B           (         init.asm):00026                         LBSR    T_SETMODE       ; patches T_PLOT for MODE_SET
104C 3596             (         init.asm):00027                         PULS    D,X,PC
                      (         init.asm):00028         
                      (         init.asm):00029         ; ---------------------------------------------------------------------------
                      (         init.asm):00030         ; T_SETBUF - use a caller-supplied off-screen buffer
                      (         init.asm):00031         ;   Entry: X = buffer address (BUFSIZE bytes), DP = $00
                      (         init.asm):00032         ;   Exit:  all registers preserved
                      (         init.asm):00033         ; ---------------------------------------------------------------------------
104E 9F00             (         init.asm):00034         T_SETBUF        STX     <W_BUF
1050 39               (         init.asm):00035                         RTS
                      (      src/tgl.asm):00065                         INCLUDE "cls.asm"
                      (          cls.asm):00001         ; ---------------------------------------------------------------------------
                      (          cls.asm):00002         ; T_CLS - clear the off-screen buffer
                      (          cls.asm):00003         ;   Each row: white graphics code in column 0, blank sixel cells in 1-39.
                      (          cls.asm):00004         ;   Fills the whole buffer with blank cells using PSHU from three registers
                      (          cls.asm):00005         ;   (six bytes per instruction, working down from the end), then writes the
                      (          cls.asm):00006         ;   graphics code into column 0 of each row. Roughly 2,100 cycles, about a
                      (          cls.asm):00007         ;   fifth of a simple byte loop.
                      (          cls.asm):00008         ;   Entry: DP = $00            Exit: all registers preserved
                      (          cls.asm):00009         ; ---------------------------------------------------------------------------
1051 3476             (          cls.asm):00010         T_CLS           PSHS    D,X,Y,U
1053 8614             (          cls.asm):00011                         LDA     #BUFSIZE/48     ; 20 iterations x 48 bytes
1055 9704             (          cls.asm):00012                         STA     <W_COUNT
1057 DE00             (          cls.asm):00013                         LDU     <W_BUF
1059 33C903C0         (          cls.asm):00014                         LEAU    BUFSIZE,U       ; PSHU fills downwards from the end
105D CC2020           (          cls.asm):00015                         LDD     #SIXEL_BLANK*$101
1060 1F01             (          cls.asm):00016                         TFR     D,X
1062 1F02             (          cls.asm):00017                         TFR     D,Y
1064                  (          cls.asm):00018         CLS_FILL
1064 3636             (          cls.asm):00019                         PSHU    D,X,Y
1066 3636             (          cls.asm):00020                         PSHU    D,X,Y
1068 3636             (          cls.asm):00021                         PSHU    D,X,Y
106A 3636             (          cls.asm):00022                         PSHU    D,X,Y
106C 3636             (          cls.asm):00023                         PSHU    D,X,Y
106E 3636             (          cls.asm):00024                         PSHU    D,X,Y
1070 3636             (          cls.asm):00025                         PSHU    D,X,Y
1072 3636             (          cls.asm):00026                         PSHU    D,X,Y
1074 0A04             (          cls.asm):00027                         DEC     <W_COUNT
1076 26EC             (          cls.asm):00028                         BNE     CLS_FILL
1078 8697             (          cls.asm):00029                         LDA     #GFX_WHITE      ; U = buffer start
107A A7C4             (          cls.asm):00030                         STA     0*COLS,U
107C A7C828           (          cls.asm):00031                         STA     1*COLS,U
107F A7C850           (          cls.asm):00032                         STA     2*COLS,U
1082 A7C878           (          cls.asm):00033                         STA     3*COLS,U
1085 A7C900A0         (          cls.asm):00034                         STA     4*COLS,U
1089 A7C900C8         (          cls.asm):00035                         STA     5*COLS,U
108D A7C900F0         (          cls.asm):00036                         STA     6*COLS,U
1091 A7C90118         (          cls.asm):00037                         STA     7*COLS,U
1095 A7C90140         (          cls.asm):00038                         STA     8*COLS,U
1099 A7C90168         (          cls.asm):00039                         STA     9*COLS,U
109D A7C90190         (          cls.asm):00040                         STA     10*COLS,U
10A1 A7C901B8         (          cls.asm):00041                         STA     11*COLS,U
10A5 A7C901E0         (          cls.asm):00042                         STA     12*COLS,U
10A9 A7C90208         (          cls.asm):00043                         STA     13*COLS,U
10AD A7C90230         (          cls.asm):00044                         STA     14*COLS,U
10B1 A7C90258         (          cls.asm):00045                         STA     15*COLS,U
10B5 A7C90280         (          cls.asm):00046                         STA     16*COLS,U
10B9 A7C902A8         (          cls.asm):00047                         STA     17*COLS,U
10BD A7C902D0         (          cls.asm):00048                         STA     18*COLS,U
10C1 A7C902F8         (          cls.asm):00049                         STA     19*COLS,U
10C5 A7C90320         (          cls.asm):00050                         STA     20*COLS,U
10C9 A7C90348         (          cls.asm):00051                         STA     21*COLS,U
10CD A7C90370         (          cls.asm):00052                         STA     22*COLS,U
10D1 A7C90398         (          cls.asm):00053                         STA     23*COLS,U
10D5 35F6             (          cls.asm):00054                         PULS    D,X,Y,U,PC
                      (      src/tgl.asm):00066                         INCLUDE "plot.asm"
                      (         plot.asm):00001         ; ---------------------------------------------------------------------------
                      (         plot.asm):00002         ; T_SETMODE - select plot mode
                      (         plot.asm):00003         ;   Patches the pre-op and operation bytes in T_PLOT and the four T_LINE
                      (         plot.asm):00004         ;   loops, so pixel writes never test the mode. Out-of-range modes are
                      (         plot.asm):00005         ;   ignored.
                      (         plot.asm):00006         ;   Entry: A = MODE_SET, MODE_CLEAR or MODE_XOR, DP = $00
                      (         plot.asm):00007         ;   Exit:  all registers preserved
                      (         plot.asm):00008         ; ---------------------------------------------------------------------------
10D7 8102             (         plot.asm):00009         T_SETMODE       CMPA    #MODE_XOR
10D9 2235             (         plot.asm):00010                         BHI     SETM_X
10DB 3416             (         plot.asm):00011                         PSHS    D,X
10DD 9705             (         plot.asm):00012                         STA     <W_MODE
10DF 308D0484         (         plot.asm):00013                         LEAX    MODETAB,PCR
10E3 48               (         plot.asm):00014                         ASLA
10E4 EC86             (         plot.asm):00015                         LDD     A,X             ; A = pre-op byte, B = opcode
10E6 A78D0046         (         plot.asm):00016                         STA     PLOT_PRE,PCR
10EA E78D0043         (         plot.asm):00017                         STB     PLOT_OP,PCR
10EE A78D00F8         (         plot.asm):00018                         STA     LXD_PRE,PCR
10F2 E78D00F5         (         plot.asm):00019                         STB     LXD_OP,PCR
10F6 A78D0126         (         plot.asm):00020                         STA     LXU_PRE,PCR
10FA E78D0123         (         plot.asm):00021                         STB     LXU_OP,PCR
10FE A78D0154         (         plot.asm):00022                         STA     LYR_PRE,PCR
1102 E78D0151         (         plot.asm):00023                         STB     LYR_OP,PCR
1106 A78D0182         (         plot.asm):00024                         STA     LYL_PRE,PCR
110A E78D017F         (         plot.asm):00025                         STB     LYL_OP,PCR
110E 3516             (         plot.asm):00026                         PULS    D,X
1110 39               (         plot.asm):00027         SETM_X          RTS
                      (         plot.asm):00028         
                      (         plot.asm):00029         ; ---------------------------------------------------------------------------
                      (         plot.asm):00030         ; T_PLOT - plot one sixel pixel in the off-screen buffer
                      (         plot.asm):00031         ;   Entry: A = x (0-77), B = y (0-71), DP = $00
                      (         plot.asm):00032         ;   Exit:  all registers preserved
                      (         plot.asm):00033         ;   No range checking in a normal build - out-of-range coordinates write
                      (         plot.asm):00034         ;   outside the buffer. A TGL_SAFE build ignores off-screen points instead.
                      (         plot.asm):00035         ;
                      (         plot.asm):00036         ;   cell = buffer + (y/3)*40 + 1 + x/2,  mask from (x&1, y%3)
                      (         plot.asm):00037         ; ---------------------------------------------------------------------------
1111                  (         plot.asm):00038         T_PLOT
                      (         plot.asm):00039                         IFDEF   TGL_SAFE
                      (         plot.asm):00040                         CMPA    #XMAX           ; off screen: do nothing
                      (         plot.asm):00041                         BHI     PLOT_RTS
                      (         plot.asm):00042                         CMPB    #YMAX
                      (         plot.asm):00043                         BHI     PLOT_RTS
                      (         plot.asm):00044                         ENDC
1111 3436             (         plot.asm):00045                         PSHS    D,X,Y
1113 318D0330         (         plot.asm):00046                         LEAY    PTAB,PCR
1117 4F               (         plot.asm):00047                         CLRA                    ; D = y
1118 58               (         plot.asm):00048                         ASLB                    ; D = y*4 (entries are 4 bytes)
1119 49               (         plot.asm):00049                         ROLA
111A 58               (         plot.asm):00050                         ASLB
111B 49               (         plot.asm):00051                         ROLA
111C 31AB             (         plot.asm):00052                         LEAY    D,Y             ; Y -> PTAB entry for this y
