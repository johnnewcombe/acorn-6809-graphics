                      (      src/tgl.asm):00089                         INCLUDE "blit.asm"
                      (         blit.asm):00001         ; ---------------------------------------------------------------------------
                      (         blit.asm):00002         ; T_BLIT - copy the off-screen buffer to screen rows 0-23 (960 bytes)
                      (         blit.asm):00003         ;   Stack-blast copy: PULU six bytes from the buffer, PSHS them to the
                      (         blit.asm):00004         ;   screen. S is borrowed, so IRQ and FIRQ are masked for the duration
                      (         blit.asm):00005         ;   (roughly 5ms at 1MHz).
                      (         blit.asm):00006         ;   Entry: DP = $00            Exit: all registers preserved
                      (         blit.asm):00007         ; ---------------------------------------------------------------------------
1350                  (         blit.asm):00008         BLAST6          MACRO
                      (         blit.asm):00009                         PULU    D,X,Y
                      (         blit.asm):00010                         PSHS    D,X,Y
                      (         blit.asm):00011                         LEAS    12,S
                      (         blit.asm):00012                         ENDM
                      (         blit.asm):00013         
1350 347F             (         blit.asm):00014         T_BLIT          PSHS    CC,D,DP,X,Y,U
1352 1A50             (         blit.asm):00015                         ORCC    #$50            ; mask IRQ and FIRQ
1354 10DF02           (         blit.asm):00016                         STS     <W_SAVSP
1357 8628             (         blit.asm):00017                         LDA     #BUFSIZE/24     ; 40 iterations x 24 bytes
1359 9704             (         blit.asm):00018                         STA     <W_COUNT
135B DE00             (         blit.asm):00019                         LDU     <W_BUF
