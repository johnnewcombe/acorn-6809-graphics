                      (          cls.asm):00002         ; T_CLS - clear the off-screen buffer
                      (          cls.asm):00003         ;   Each row: its graphics colour code in column 0 (white unless changed
                      (          cls.asm):00004         ;   with TGL_COLOUR), blank sixel cells in 1-39.
                      (          cls.asm):00005         ;   Fills the whole buffer with blank cells using PSHU from three registers
                      (          cls.asm):00006         ;   (six bytes per instruction, working down from the end), then writes the
                      (          cls.asm):00007         ;   colour code into column 0 of each row. Roughly 2,100 cycles, about a
                      (          cls.asm):00008         ;   fifth of a simple byte loop.
                      (          cls.asm):00009         ;   Entry: DP = $00            Exit: all registers preserved
                      (          cls.asm):00010         ; ---------------------------------------------------------------------------
107B 3476             (          cls.asm):00011         T_CLS           PSHS    D,X,Y,U
107D 8614             (          cls.asm):00012                         LDA     #BUFSIZE/48     ; 20 iterations x 48 bytes
107F 9704             (          cls.asm):00013                         STA     <W_COUNT
1081 DE00             (          cls.asm):00014                         LDU     <W_BUF
1083 33C903C0         (          cls.asm):00015                         LEAU    BUFSIZE,U       ; PSHU fills downwards from the end
1087 CC2020           (          cls.asm):00016                         LDD     #SIXEL_BLANK*$101
108A 1F01             (          cls.asm):00017                         TFR     D,X
108C 1F02             (          cls.asm):00018                         TFR     D,Y
108E                  (          cls.asm):00019         CLS_FILL
108E 3636             (          cls.asm):00020                         PSHU    D,X,Y
1090 3636             (          cls.asm):00021                         PSHU    D,X,Y
1092 3636             (          cls.asm):00022                         PSHU    D,X,Y
1094 3636             (          cls.asm):00023                         PSHU    D,X,Y
1096 3636             (          cls.asm):00024                         PSHU    D,X,Y
1098 3636             (          cls.asm):00025                         PSHU    D,X,Y
109A 3636             (          cls.asm):00026                         PSHU    D,X,Y
109C 3636             (          cls.asm):00027                         PSHU    D,X,Y
109E 0A04             (          cls.asm):00028                         DEC     <W_COUNT
10A0 26EC             (          cls.asm):00029                         BNE     CLS_FILL
                      (          cls.asm):00030                                                 ; U = buffer start: put each row's
                      (          cls.asm):00031                                                 ;  colour code in column 0
10A2 9643             (          cls.asm):00032                         LDA     <ROWCOL+0
10A4 A7C4             (          cls.asm):00033                         STA     0*COLS,U
10A6 9644             (          cls.asm):00034                         LDA     <ROWCOL+1
10A8 A7C828           (          cls.asm):00035                         STA     1*COLS,U
10AB 9645             (          cls.asm):00036                         LDA     <ROWCOL+2
10AD A7C850           (          cls.asm):00037                         STA     2*COLS,U
10B0 9646             (          cls.asm):00038                         LDA     <ROWCOL+3
