13AF DC06             (         clip.asm):00112                         LDD     <W_X0
13B1 9711             (         clip.asm):00113                         STA     <I_V0
13B3 D70F             (         clip.asm):00114                         STB     <I_U0
13B5 DC08             (         clip.asm):00115                         LDD     <W_X1
13B7 9712             (         clip.asm):00116                         STA     <I_V1
13B9 D710             (         clip.asm):00117                         STB     <I_U1
