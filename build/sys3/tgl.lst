15C0 9F1A             (         rect.asm):00267                         STX     <R_X1
15C2 9618             (         rect.asm):00268                         LDA     <R_X0
15C4 911A             (         rect.asm):00269                         CMPA    <R_X1
15C6 2F06             (         rect.asm):00270                         BLE     RS_1
15C8 D61A             (         rect.asm):00271                         LDB     <R_X1           ; swap the x coordinates
15CA D718             (         rect.asm):00272                         STB     <R_X0
15CC 971A             (         rect.asm):00273                         STA     <R_X1
15CE 9619             (         rect.asm):00274         RS_1            LDA     <R_Y0
