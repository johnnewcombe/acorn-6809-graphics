                      (      src/tgl.asm):00090                         INCLUDE "clip.asm"
                      (         clip.asm):00001         ; ---------------------------------------------------------------------------
                      (         clip.asm):00002         ; Clipped drawing - coordinates are signed bytes (-128..127); anything
                      (         clip.asm):00003         ; outside x 0-77, y 0-71 is not drawn.
                      (         clip.asm):00004         ; ---------------------------------------------------------------------------
                      (         clip.asm):00005         
                      (         clip.asm):00006         ; ---------------------------------------------------------------------------
                      (         clip.asm):00007         ; T_PLOTC - plot a pixel if it is on screen
                      (         clip.asm):00008         ;   Entry: A = x, B = y (signed), DP = $00
                      (         clip.asm):00009         ;   Exit:  all registers preserved
                      (         clip.asm):00010         ;   A negative signed value is above XMAX/YMAX when compared unsigned, so
                      (         clip.asm):00011         ;   one unsigned compare per axis rejects both sides.
                      (         clip.asm):00012         ; ---------------------------------------------------------------------------
1382 814D             (         clip.asm):00013         T_PLOTC         CMPA    #XMAX
1384 2207             (         clip.asm):00014                         BHI     PC_X
1386 C147             (         clip.asm):00015                         CMPB    #YMAX
1388 2203             (         clip.asm):00016                         BHI     PC_X
138A 16FDE6           (         clip.asm):00017                         LBRA    T_PLOT          ; tail call
138D 39               (         clip.asm):00018         PC_X            RTS
                      (         clip.asm):00019         
                      (         clip.asm):00020         ; ---------------------------------------------------------------------------
                      (         clip.asm):00021         ; T_LINEC - draw the visible part of a line (Cohen-Sutherland)
                      (         clip.asm):00022         ;   Entry: A = x0, B = y0, X = x1 (high byte) : y1 (low byte), all signed
                      (         clip.asm):00023         ;          DP = $00
                      (         clip.asm):00024         ;   Exit:  all registers preserved
                      (         clip.asm):00025         ;
                      (         clip.asm):00026         ;   Each endpoint gets an outcode (bit 0 left, 1 right, 2 top, 3 bottom).
                      (         clip.asm):00027         ;   Both zero: draw. Common bit: entirely off one side, nothing to draw.
                      (         clip.asm):00028         ;   Otherwise move an outside endpoint onto the edge it is beyond, and
                      (         clip.asm):00029         ;   repeat. The intersection always interpolates between the two current
                      (         clip.asm):00030         ;   endpoints, so a point never moves back outside an edge already
                      (         clip.asm):00031         ;   satisfied, and the loop ends after at most four moves per endpoint.
                      (         clip.asm):00032         ;   The trimmed line is drawn by T_LINE.
                      (         clip.asm):00033         ; ---------------------------------------------------------------------------
138E 3476             (         clip.asm):00034         T_LINEC         PSHS    D,X,Y,U
1390 DD06             (         clip.asm):00035                         STD     <W_X0
1392 9F08             (         clip.asm):00036                         STX     <W_X1
1394 DC06             (         clip.asm):00037         LC_LOOP         LDD     <W_X0
1396 8D2D             (         clip.asm):00038                         BSR     OUTCODE
1398 970D             (         clip.asm):00039                         STA     <W_C0
139A DC08             (         clip.asm):00040                         LDD     <W_X1
139C 8D27             (         clip.asm):00041                         BSR     OUTCODE
139E 970E             (         clip.asm):00042                         STA     <W_C1
13A0 9A0D             (         clip.asm):00043                         ORA     <W_C0
13A2 2718             (         clip.asm):00044                         BEQ     LC_DRAW         ; both inside
13A4 960D             (         clip.asm):00045                         LDA     <W_C0
13A6 940E             (         clip.asm):00046                         ANDA    <W_C1
13A8 2619             (         clip.asm):00047                         BNE     LC_EXIT         ; both beyond the same edge
13AA 960D             (         clip.asm):00048                         LDA     <W_C0
13AC 2706             (         clip.asm):00049                         BEQ     LC_P1
13AE 8D36             (         clip.asm):00050                         BSR     LC_CLIP         ; move the start point
13B0 DD06             (         clip.asm):00051                         STD     <W_X0
13B2 20E0             (         clip.asm):00052                         BRA     LC_LOOP
13B4 960E             (         clip.asm):00053         LC_P1           LDA     <W_C1
13B6 8D2E             (         clip.asm):00054                         BSR     LC_CLIP         ; move the end point
13B8 DD08             (         clip.asm):00055                         STD     <W_X1
13BA 20D8             (         clip.asm):00056                         BRA     LC_LOOP
