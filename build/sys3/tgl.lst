13A6 2704             (         clip.asm):00107                         BEQ     LCC_3
13A8 C64D             (         clip.asm):00108                         LDB     #XMAX           ; right edge
13AA 2001             (         clip.asm):00109                         BRA     LCC_V
13AC 5F               (         clip.asm):00110         LCC_3           CLRB                    ; left edge, x = 0
