1354 9A0D             (         clip.asm):00043                         ORA     <W_C0
1356 2718             (         clip.asm):00044                         BEQ     LC_DRAW         ; both inside
1358 960D             (         clip.asm):00045                         LDA     <W_C0
135A 940E             (         clip.asm):00046                         ANDA    <W_C1
135C 2619             (         clip.asm):00047                         BNE     LC_EXIT         ; both beyond the same edge
135E 960D             (         clip.asm):00048                         LDA     <W_C0
1360 2706             (         clip.asm):00049                         BEQ     LC_P1
1362 8D36             (         clip.asm):00050                         BSR     LC_CLIP         ; move the start point
1364 DD06             (         clip.asm):00051                         STD     <W_X0
