                      (      src/tgl.asm):00001         ; ===========================================================================
                      (      src/tgl.asm):00002         ; Acorn System 3 Teletext Graphics Library (working name)
                      (      src/tgl.asm):00003         ; 6809 sixel graphics for the Acorn teletext VDU (6845 + SAA5050)
                      (      src/tgl.asm):00004         ;
                      (      src/tgl.asm):00005         ; Build with -D TARGET_FLEX for the FLEX machine; default is a standard
                      (      src/tgl.asm):00006         ; System 3. The binary is position-independent: load it anywhere and call
                      (      src/tgl.asm):00007         ; the entry points as fixed offsets from the load address (tgl_api.inc).
                      (      src/tgl.asm):00008         ;
                      (      src/tgl.asm):00009         ; Rules that keep it position-independent:
                      (      src/tgl.asm):00010         ;   - references to the library's own code/data use ,PCR
                      (      src/tgl.asm):00011         ;   - the jump table uses LBRA
                      (      src/tgl.asm):00012         ;   - only hardware (VDU, CRTC) and page-zero workspace are absolute
                      (      src/tgl.asm):00013         ; The Makefile assembles at two origins and fails if the binaries differ.
                      (      src/tgl.asm):00014         ; ===========================================================================
                      (      src/tgl.asm):00015         
                      (      src/tgl.asm):00016                         IFDEF   TARGET_FLEX
                      (      src/tgl.asm):00017                         INCLUDE "target/flex.inc"
                      (      src/tgl.asm):00018                         ELSE
                      (      src/tgl.asm):00019                         INCLUDE "target/sys3.inc"
                      (  target/sys3.inc):00001         ; ---------------------------------------------------------------------------
                      (  target/sys3.inc):00002         ; Target: standard Acorn System 3 with 6809 CPU card
                      (  target/sys3.inc):00003         ; ---------------------------------------------------------------------------
     0400             (  target/sys3.inc):00004         VDU_BASE        EQU     $0400           ; teletext VDU screen RAM
     0800             (  target/sys3.inc):00005         CRTC_ADDR       EQU     $0800           ; 6845 address register
     0801             (  target/sys3.inc):00006         CRTC_DATA       EQU     $0801           ; 6845 data register
                      (  target/sys3.inc):00007         
                      (  target/sys3.inc):00008         ; Default load address. Override with: lwasm -D TGL_ORG=0x2000
                      (  target/sys3.inc):00009         ; (The code is position-independent; this only sets where the
                      (  target/sys3.inc):00010         ; listing and the default build place it.)
                      (  target/sys3.inc):00011                         IFNDEF  TGL_ORG
     1000             (  target/sys3.inc):00012         TGL_ORG         EQU     $1000
                      (  target/sys3.inc):00013                         ENDC
                      (  target/sys3.inc):00014         
                      (  target/sys3.inc):00015         ; Monitor RAM vectors and keyboard buffer pointers (monitor RAM at $0300)
                      (  target/sys3.inc):00016         ; Checked against the standard ROM listing (monitor source with BASE=$0000).
     0365             (  target/sys3.inc):00017         MON_COPADR      EQU     $0365           ; console output routine address
     0367             (  target/sys3.inc):00018         MON_CINADR      EQU     $0367           ; console input routine address
     0387             (  target/sys3.inc):00019         MON_HEADST      EQU     $0387           ; keyboard buffer: static head
     038B             (  target/sys3.inc):00020         MON_TAIL        EQU     $038B           ; keyboard buffer: tail
                      (      src/tgl.asm):00020                         ENDC
                      (      src/tgl.asm):00021         
                      (      src/tgl.asm):00022                         INCLUDE "consts.inc"
                      (       consts.inc):00001         ; ---------------------------------------------------------------------------
                      (       consts.inc):00002         ; Screen geometry and teletext constants (target independent)
                      (       consts.inc):00003         ; ---------------------------------------------------------------------------
     0028             (       consts.inc):00004         COLS            EQU     40              ; characters per row
     0018             (       consts.inc):00005         ROWS            EQU     24              ; graphics rows (row 24 left for status)
     03C0             (       consts.inc):00006         BUFSIZE         EQU     COLS*ROWS       ; 960 bytes - off-screen buffer size
                      (       consts.inc):00007         
     0097             (       consts.inc):00008         GFX_WHITE       EQU     $97             ; white graphics control code
     0020             (       consts.inc):00009         SIXEL_BLANK     EQU     $20             ; graphics cell, no pixels set
     007F             (       consts.inc):00010         SIXEL_FULL      EQU     $7F             ; graphics cell, all six pixels set
                      (       consts.inc):00011         
                      (       consts.inc):00012         ; Plot modes (see TGL_SETMODE)
     0000             (       consts.inc):00013         MODE_SET        EQU     0
     0001             (       consts.inc):00014         MODE_CLEAR      EQU     1
     0002             (       consts.inc):00015         MODE_XOR        EQU     2
                      (       consts.inc):00016         
     004D             (       consts.inc):00017         XMAX            EQU     77              ; largest visible x
     0047             (       consts.inc):00018         YMAX            EQU     71              ; largest visible y
                      (      src/tgl.asm):00023                         INCLUDE "ws.inc"
                      (           ws.inc):00001         ; ---------------------------------------------------------------------------
                      (           ws.inc):00002         ; Workspace - lives in the direct page. Callers must enter every library
                      (           ws.inc):00003         ; routine with DP = $00.
                      (           ws.inc):00004         ; ---------------------------------------------------------------------------
     0000             (           ws.inc):00005         WS              EQU     $00             ; workspace base within page zero
                      (           ws.inc):00006         
     0000             (           ws.inc):00007         W_BUF           EQU     WS+0            ; 2  off-screen buffer address
     0002             (           ws.inc):00008         W_SAVSP         EQU     WS+2            ; 2  caller's S, saved during blit
     0004             (           ws.inc):00009         W_COUNT         EQU     WS+4            ; 1  general loop counter
     0005             (           ws.inc):00010         W_MODE          EQU     WS+5            ; 1  current plot mode
     0006             (           ws.inc):00011         W_X0            EQU     WS+6            ; 1  line start x  } W_X0/W_Y0 and
     0007             (           ws.inc):00012         W_Y0            EQU     WS+7            ; 1  line start y  } W_X1/W_Y1 are
     0008             (           ws.inc):00013         W_X1            EQU     WS+8            ; 1  line end x    } used as 16-bit
     0009             (           ws.inc):00014         W_Y1            EQU     WS+9            ; 1  line end y    } pairs
     000A             (           ws.inc):00015         W_ADX           EQU     WS+10           ; 1  |dx|
     000B             (           ws.inc):00016         W_ADY           EQU     WS+11           ; 1  |dy|
     000C             (           ws.inc):00017         W_ERR           EQU     WS+12           ; 1  Bresenham error term
     000D             (           ws.inc):00018         W_C0            EQU     WS+13           ; 1  clip: outcode of start point
     000E             (           ws.inc):00019         W_C1            EQU     WS+14           ; 1  clip: outcode of end point
     000F             (           ws.inc):00020         I_U0            EQU     WS+15           ; 1  clip intersection: u0, u1, v0, v1
     0010             (           ws.inc):00021         I_U1            EQU     WS+16           ; 1    (u = axis being solved for,
     0011             (           ws.inc):00022         I_V0            EQU     WS+17           ; 1     v = axis of the edge)
     0012             (           ws.inc):00023         I_V1            EQU     WS+18           ; 1
     0013             (           ws.inc):00024         I_E             EQU     WS+19           ; 1  clip: edge position
     0014             (           ws.inc):00025         I_SGN           EQU     WS+20           ; 1  clip: sign of the result offset
     0015             (           ws.inc):00026         I_DU            EQU     WS+21           ; 1  clip: |u1-u0|
     0016             (           ws.inc):00027         I_DV            EQU     WS+22           ; 1  clip: |v1-v0| (divisor)
     0017             (           ws.inc):00028         I_CNT           EQU     WS+23           ; 1  clip: divide loop counter
     0018             (           ws.inc):00029         R_X0            EQU     WS+24           ; 1  rectangle corners, sorted so
     0019             (           ws.inc):00030         R_Y0            EQU     WS+25           ; 1   R_X0 <= R_X1 and R_Y0 <= R_Y1
     001A             (           ws.inc):00031         R_X1            EQU     WS+26           ; 1   (R_X0/R_Y0 and R_X1/R_Y1 are
     001B             (           ws.inc):00032         R_Y1            EQU     WS+27           ; 1    used as 16-bit pairs)
     001C             (           ws.inc):00033         F_CX0           EQU     WS+28           ; 1  fill: first cell column
     001D             (           ws.inc):00034         F_CX1           EQU     WS+29           ; 1  fill: last cell column
     001E             (           ws.inc):00035         F_PL            EQU     WS+30           ; 1  fill: first cell is right pixel only
     001F             (           ws.inc):00036         F_PR            EQU     WS+31           ; 1  fill: last cell is left pixel only
     0020             (           ws.inc):00037         F_SGL           EQU     WS+32           ; 1  fill: whole width is one cell
     0021             (           ws.inc):00038         F_RS            EQU     WS+33           ; 1  fill: first full-width cell
     0022             (           ws.inc):00039         F_RN            EQU     WS+34           ; 1  fill: number of full-width cells
     0023             (           ws.inc):00040         F_TOP           EQU     WS+35           ; 1  fill: top sixel row in this cell row
     0024             (           ws.inc):00041         F_BOTL          EQU     WS+36           ; 1  fill: bottom sixel row of last row
     0025             (           ws.inc):00042         F_ML            EQU     WS+37           ; 1  fill: left-pixel mask for this row
     0026             (           ws.inc):00043         F_MR            EQU     WS+38           ; 1  fill: right-pixel mask for this row
     0027             (           ws.inc):00044         W_FM            EQU     WS+39           ; 1  fill: mask being applied
     0028             (           ws.inc):00045         F_ROW           EQU     WS+40           ; 2  fill: address of this cell row
     002A             (           ws.inc):00046         F_LAST          EQU     WS+42           ; 2  fill: address of the last cell row
     002C             (           ws.inc):00047         C_CX            EQU     WS+44           ; 1  circle: centre x (signed)
     002D             (           ws.inc):00048         C_CY            EQU     WS+45           ; 1  circle: centre y (signed)
     002E             (           ws.inc):00049         C_R             EQU     WS+46           ; 1  circle: radius (0-127)
     002F             (           ws.inc):00050         C_ROW           EQU     WS+47           ; 1  circle: row offset being drawn
     0030             (           ws.inc):00051         C_X             EQU     WS+48           ; 1  circle: unscaled half-width
     0031             (           ws.inc):00052         C_F             EQU     WS+49           ; 2  circle: midpoint error term
     0033             (           ws.inc):00053         C_HC            EQU     WS+51           ; 1  circle: scaled half-width, this row
     0034             (           ws.inc):00054         C_HN            EQU     WS+52           ; 1  circle: scaled half-width, next row
     0035             (           ws.inc):00055         C_ST            EQU     WS+53           ; 1  circle: where this row's run starts
     0036             (           ws.inc):00056         C_Y             EQU     WS+54           ; 1  circle: screen y being drawn
     0037             (           ws.inc):00057         C_FILL          EQU     WS+55           ; 1  circle: 0 outline, else filled
     0038             (           ws.inc):00058         WS_SIZE         EQU     56
                      (      src/tgl.asm):00024         
     00               (      src/tgl.asm):00025                         SETDP   $00
                      (      src/tgl.asm):00026                         ORG     TGL_ORG
                      (      src/tgl.asm):00027         
                      (      src/tgl.asm):00028         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00029         ; Jump table - order and offsets must match tgl_api.inc
                      (      src/tgl.asm):00030         ; ---------------------------------------------------------------------------
1000                  (      src/tgl.asm):00031         TGL_START
1000 16002D           (      src/tgl.asm):00032         J_INIT          LBRA    T_INIT          ; +0
1003 160054           (      src/tgl.asm):00033         J_SETBUF        LBRA    T_SETBUF        ; +3
1006 160054           (      src/tgl.asm):00034         J_CLS           LBRA    T_CLS           ; +6
1009 1600D7           (      src/tgl.asm):00035         J_SETMODE       LBRA    T_SETMODE       ; +9
100C 160118           (      src/tgl.asm):00036         J_PLOT          LBRA    T_PLOT          ; +12
100F 16013B           (      src/tgl.asm):00037         J_LINE          LBRA    T_LINE          ; +15
1012 1602EF           (      src/tgl.asm):00038         J_BLIT          LBRA    T_BLIT          ; +18
1015 16031E           (      src/tgl.asm):00039         J_PLOTC         LBRA    T_PLOTC         ; +21
1018 160327           (      src/tgl.asm):00040         J_LINEC         LBRA    T_LINEC         ; +24
101B 160797           (      src/tgl.asm):00041         J_DONE          LBRA    T_DONE          ; +27
101E 16079E           (      src/tgl.asm):00042         J_INKEY         LBRA    T_INKEY         ; +30
1021 1607B0           (      src/tgl.asm):00043         J_EXIT          LBRA    T_EXIT          ; +33
1024 160414           (      src/tgl.asm):00044         J_RECT          LBRA    T_RECT          ; +36
1027 160461           (      src/tgl.asm):00045         J_RECTF         LBRA    T_RECTF         ; +39
102A 1605C8           (      src/tgl.asm):00046         J_CIRC          LBRA    T_CIRC          ; +42
102D 1605CE           (      src/tgl.asm):00047         J_CIRCF         LBRA    T_CIRCF         ; +45
                      (      src/tgl.asm):00048         
                      (      src/tgl.asm):00049         ; Check the table against the published interface
     1000             (      src/tgl.asm):00050         TGL_BASE        EQU     TGL_START
                      (      src/tgl.asm):00051                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
                      (      tgl_api.inc):00025         
     03C0             (      tgl_api.inc):00026         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00027         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00028         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00029         TGL_MODE_XOR    EQU     2
                      (      src/tgl.asm):00052                         IFNE    (J_SETBUF-TGL_SETBUF)|(J_CLS-TGL_CLS)|(J_SETMODE-TGL_SETMODE)
                      (      src/tgl.asm):00053                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00054                         ENDC
                      (      src/tgl.asm):00055                         IFNE    (J_PLOT-TGL_PLOT)|(J_LINE-TGL_LINE)|(J_BLIT-TGL_BLIT)
                      (      src/tgl.asm):00056                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00057                         ENDC
                      (      src/tgl.asm):00058                         IFNE    (J_PLOTC-TGL_PLOTC)|(J_LINEC-TGL_LINEC)
                      (      src/tgl.asm):00059                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00060                         ENDC
                      (      src/tgl.asm):00061                         IFNE    (J_DONE-TGL_DONE)|(J_INKEY-TGL_INKEY)|(J_EXIT-TGL_EXIT)
                      (      src/tgl.asm):00062                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00063                         ENDC
                      (      src/tgl.asm):00064                         IFNE    (J_RECT-TGL_RECT)|(J_RECTF-TGL_RECTF)
                      (      src/tgl.asm):00065                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00066                         ENDC
                      (      src/tgl.asm):00067                         IFNE    (J_CIRC-TGL_CIRC)|(J_CIRCF-TGL_CIRCF)
                      (      src/tgl.asm):00068                         ERROR   "Jump table does not match tgl_api.inc"
                      (      src/tgl.asm):00069                         ENDC
                      (      src/tgl.asm):00070         
                      (      src/tgl.asm):00071         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00072         ; Modules
                      (      src/tgl.asm):00073         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00074                         INCLUDE "init.asm"
                      (         init.asm):00001         ; ---------------------------------------------------------------------------
                      (         init.asm):00002         ; T_INIT - initialise the library
                      (         init.asm):00003         ;   Resets the 6845 display start address (R12/R13) to zero so the visible
                      (         init.asm):00004         ;   screen begins at VDU_BASE. The monitor and FLEX VDU drivers scroll in
                      (         init.asm):00005         ;   hardware, which can leave the start address anywhere in the 1K.
                      (         init.asm):00006         ;   Hides the hardware cursor (R10 = $20, the "no cursor" mode bits).
                      (         init.asm):00007         ;   Sets the off-screen buffer to the memory immediately after the library
                      (         init.asm):00008         ;   (BUFSIZE bytes must be free there) and the plot mode to MODE_SET.
                      (         init.asm):00009         ;   Entry: DP = $00            Exit: all registers preserved
                      (         init.asm):00010         ; ---------------------------------------------------------------------------
1030 3416             (         init.asm):00011         T_INIT          PSHS    D,X
1032 5F               (         init.asm):00012                         CLRB
1033 860C             (         init.asm):00013                         LDA     #12             ; R12 - start address high
1035 B70800           (         init.asm):00014                         STA     CRTC_ADDR
1038 F70801           (         init.asm):00015                         STB     CRTC_DATA
103B 860D             (         init.asm):00016                         LDA     #13             ; R13 - start address low
103D B70800           (         init.asm):00017                         STA     CRTC_ADDR
1040 F70801           (         init.asm):00018                         STB     CRTC_DATA
1043 860A             (         init.asm):00019                         LDA     #10             ; R10 - cursor start / blink mode
1045 B70800           (         init.asm):00020                         STA     CRTC_ADDR
1048 8620             (         init.asm):00021                         LDA     #$20            ; bits 6-5 = 01: no cursor
104A B70801           (         init.asm):00022                         STA     CRTC_DATA
104D 308D08DF         (         init.asm):00023                         LEAX    TGL_END,PCR
1051 9F00             (         init.asm):00024                         STX     <W_BUF
1053 8600             (         init.asm):00025                         LDA     #MODE_SET
1055 17008B           (         init.asm):00026                         LBSR    T_SETMODE       ; patches T_PLOT for MODE_SET
1058 3596             (         init.asm):00027                         PULS    D,X,PC
                      (         init.asm):00028         
                      (         init.asm):00029         ; ---------------------------------------------------------------------------
                      (         init.asm):00030         ; T_SETBUF - use a caller-supplied off-screen buffer
                      (         init.asm):00031         ;   Entry: X = buffer address (BUFSIZE bytes), DP = $00
                      (         init.asm):00032         ;   Exit:  all registers preserved
                      (         init.asm):00033         ; ---------------------------------------------------------------------------
105A 9F00             (         init.asm):00034         T_SETBUF        STX     <W_BUF
105C 39               (         init.asm):00035                         RTS
                      (      src/tgl.asm):00075                         INCLUDE "cls.asm"
                      (          cls.asm):00001         ; ---------------------------------------------------------------------------
                      (          cls.asm):00002         ; T_CLS - clear the off-screen buffer
                      (          cls.asm):00003         ;   Each row: white graphics code in column 0, blank sixel cells in 1-39.
                      (          cls.asm):00004         ;   Fills the whole buffer with blank cells using PSHU from three registers
                      (          cls.asm):00005         ;   (six bytes per instruction, working down from the end), then writes the
                      (          cls.asm):00006         ;   graphics code into column 0 of each row. Roughly 2,100 cycles, about a
                      (          cls.asm):00007         ;   fifth of a simple byte loop.
                      (          cls.asm):00008         ;   Entry: DP = $00            Exit: all registers preserved
                      (          cls.asm):00009         ; ---------------------------------------------------------------------------
105D 3476             (          cls.asm):00010         T_CLS           PSHS    D,X,Y,U
105F 8614             (          cls.asm):00011                         LDA     #BUFSIZE/48     ; 20 iterations x 48 bytes
1061 9704             (          cls.asm):00012                         STA     <W_COUNT
1063 DE00             (          cls.asm):00013                         LDU     <W_BUF
1065 33C903C0         (          cls.asm):00014                         LEAU    BUFSIZE,U       ; PSHU fills downwards from the end
1069 CC2020           (          cls.asm):00015                         LDD     #SIXEL_BLANK*$101
106C 1F01             (          cls.asm):00016                         TFR     D,X
106E 1F02             (          cls.asm):00017                         TFR     D,Y
1070                  (          cls.asm):00018         CLS_FILL
1070 3636             (          cls.asm):00019                         PSHU    D,X,Y
1072 3636             (          cls.asm):00020                         PSHU    D,X,Y
1074 3636             (          cls.asm):00021                         PSHU    D,X,Y
1076 3636             (          cls.asm):00022                         PSHU    D,X,Y
1078 3636             (          cls.asm):00023                         PSHU    D,X,Y
107A 3636             (          cls.asm):00024                         PSHU    D,X,Y
107C 3636             (          cls.asm):00025                         PSHU    D,X,Y
107E 3636             (          cls.asm):00026                         PSHU    D,X,Y
1080 0A04             (          cls.asm):00027                         DEC     <W_COUNT
1082 26EC             (          cls.asm):00028                         BNE     CLS_FILL
1084 8697             (          cls.asm):00029                         LDA     #GFX_WHITE      ; U = buffer start
1086 A7C4             (          cls.asm):00030                         STA     0*COLS,U
1088 A7C828           (          cls.asm):00031                         STA     1*COLS,U
108B A7C850           (          cls.asm):00032                         STA     2*COLS,U
108E A7C878           (          cls.asm):00033                         STA     3*COLS,U
1091 A7C900A0         (          cls.asm):00034                         STA     4*COLS,U
1095 A7C900C8         (          cls.asm):00035                         STA     5*COLS,U
1099 A7C900F0         (          cls.asm):00036                         STA     6*COLS,U
109D A7C90118         (          cls.asm):00037                         STA     7*COLS,U
10A1 A7C90140         (          cls.asm):00038                         STA     8*COLS,U
10A5 A7C90168         (          cls.asm):00039                         STA     9*COLS,U
10A9 A7C90190         (          cls.asm):00040                         STA     10*COLS,U
10AD A7C901B8         (          cls.asm):00041                         STA     11*COLS,U
10B1 A7C901E0         (          cls.asm):00042                         STA     12*COLS,U
10B5 A7C90208         (          cls.asm):00043                         STA     13*COLS,U
10B9 A7C90230         (          cls.asm):00044                         STA     14*COLS,U
