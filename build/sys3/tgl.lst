                      (      src/tgl.asm):00091                         INCLUDE "rect.asm"
                      (         rect.asm):00001         ; ---------------------------------------------------------------------------
                      (         rect.asm):00002         ; Rectangles - outlined and filled
                      (         rect.asm):00003         ;   Both take two opposite corners in the same registers as TGL_LINEC:
                      (         rect.asm):00004         ;   A = x0, B = y0, X = x1 (high byte) : y1 (low byte). Coordinates are
                      (         rect.asm):00005         ;   signed (-128..127), the corners can be in any order, and anything off
                      (         rect.asm):00006         ;   screen is clipped. Both use the current plot mode.
                      (         rect.asm):00007         ; ---------------------------------------------------------------------------
                      (         rect.asm):00008         
                      (         rect.asm):00009         ; ---------------------------------------------------------------------------
                      (         rect.asm):00010         ; T_RECT - outlined rectangle
                      (         rect.asm):00011         ;   Entry: A = x0, B = y0, X = x1:y1 (signed), DP = $00
                      (         rect.asm):00012         ;   Exit:  all registers preserved
                      (         rect.asm):00013         ;
                      (         rect.asm):00014         ;   Drawn as up to four thin filled rectangles that never overlap, so every
                      (         rect.asm):00015         ;   pixel is drawn exactly once (XOR mode can then remove the rectangle
                      (         rect.asm):00016         ;   again), and the fill's cell-at-a-time speed and clipping come for free:
                      (         rect.asm):00017         ;     top     (x0,y0)   - (x1,y0)
                      (         rect.asm):00018         ;     bottom  (x0,y1)   - (x1,y1)     only if y1 > y0
                      (         rect.asm):00019         ;     left    (x0,y0+1) - (x0,y1-1)   only if y1 - y0 >= 2
                      (         rect.asm):00020         ;     right   (x1,y0+1) - (x1,y1-1)   likewise, and only if x1 > x0
                      (         rect.asm):00021         ;   T_RECTF reuses the R_ variables, so the sorted corners are kept on the
                      (         rect.asm):00022         ;   stack: 0,S = x0, 1,S = y0, 2,S = x1, 3,S = y1.
                      (         rect.asm):00023         ; ---------------------------------------------------------------------------
1487 3476             (         rect.asm):00024         T_RECT          PSHS    D,X,Y,U
1489 17017E           (         rect.asm):00025                         LBSR    R_SORT          ; corners sorted into R_X0..R_Y1
148C DC18             (         rect.asm):00026                         LDD     <R_X0           ; keep a copy on the stack
148E 9E1A             (         rect.asm):00027                         LDX     <R_X1
1490 3416             (         rect.asm):00028                         PSHS    D,X
                      (         rect.asm):00029         
1492 A662             (         rect.asm):00030                         LDA     2,S             ; top edge
1494 E661             (         rect.asm):00031                         LDB     1,S
1496 1F01             (         rect.asm):00032                         TFR     D,X             ; X = x1:y0
1498 A6E4             (         rect.asm):00033                         LDA     ,S              ; A,B = x0,y0
149A 17003A           (         rect.asm):00034                         LBSR    T_RECTF
                      (         rect.asm):00035         
149D A663             (         rect.asm):00036                         LDA     3,S             ; bottom edge, if a different row
149F A161             (         rect.asm):00037                         CMPA    1,S
14A1 2F30             (         rect.asm):00038                         BLE     RC_X
14A3 A662             (         rect.asm):00039                         LDA     2,S
14A5 E663             (         rect.asm):00040                         LDB     3,S
14A7 1F01             (         rect.asm):00041                         TFR     D,X             ; X = x1:y1
14A9 A6E4             (         rect.asm):00042                         LDA     ,S              ; A,B = x0,y1
14AB 170029           (         rect.asm):00043                         LBSR    T_RECTF
                      (         rect.asm):00044         
14AE A663             (         rect.asm):00045                         LDA     3,S             ; sides, only if there is a gap
14B0 4A               (         rect.asm):00046                         DECA                    ;  between top and bottom
14B1 A161             (         rect.asm):00047                         CMPA    1,S             ;  (y1-1 > y0; no overflow, as
14B3 2F1E             (         rect.asm):00048                         BLE     RC_X            ;  y1 > y0 here)
14B5 A6E4             (         rect.asm):00049                         LDA     ,S              ; left side
14B7 E663             (         rect.asm):00050                         LDB     3,S
14B9 5A               (         rect.asm):00051                         DECB
14BA 1F01             (         rect.asm):00052                         TFR     D,X             ; X = x0:y1-1
14BC E661             (         rect.asm):00053                         LDB     1,S
14BE 5C               (         rect.asm):00054                         INCB                    ; A,B = x0,y0+1
14BF 170015           (         rect.asm):00055                         LBSR    T_RECTF
                      (         rect.asm):00056         
14C2 A662             (         rect.asm):00057                         LDA     2,S             ; right side, if a different column
14C4 A1E4             (         rect.asm):00058                         CMPA    ,S
14C6 2F0B             (         rect.asm):00059                         BLE     RC_X
14C8 E663             (         rect.asm):00060                         LDB     3,S
14CA 5A               (         rect.asm):00061                         DECB
14CB 1F01             (         rect.asm):00062                         TFR     D,X             ; X = x1:y1-1
14CD E661             (         rect.asm):00063                         LDB     1,S
14CF 5C               (         rect.asm):00064                         INCB                    ; A,B = x1,y0+1
14D0 170004           (         rect.asm):00065                         LBSR    T_RECTF
14D3 3264             (         rect.asm):00066         RC_X            LEAS    4,S             ; drop the copy
14D5 35F6             (         rect.asm):00067                         PULS    D,X,Y,U,PC
                      (         rect.asm):00068         
                      (         rect.asm):00069         ; ---------------------------------------------------------------------------
                      (         rect.asm):00070         ; T_RECTF - filled rectangle
                      (         rect.asm):00071         ;   Entry: A = x0, B = y0, X = x1:y1 (signed), DP = $00
                      (         rect.asm):00072         ;   Exit:  all registers preserved
                      (         rect.asm):00073         ;
                      (         rect.asm):00074         ;   Works a cell row (three sixel rows) at a time. In each cell row the
                      (         rect.asm):00075         ;   rectangle covers sixel rows top..bottom of every cell, which gives a
                      (         rect.asm):00076         ;   mask for the cell's left pixels (F_ML) and right pixels (F_MR). Along
                      (         rect.asm):00077         ;   the row:
                      (         rect.asm):00078         ;     - if x0 is odd, the first cell gets only its right pixels
                      (         rect.asm):00079         ;     - the cells in between get both: F_ML | F_MR, applied as one run
                      (         rect.asm):00080         ;     - if x1 is even, the last cell gets only its left pixels
                      (         rect.asm):00081         ;     - if the whole width falls in one cell, that cell gets whichever of
                      (         rect.asm):00082         ;       its pixels are inside
                      (         rect.asm):00083         ;   Only the first and last cell rows can be partial vertically (top > 0
                      (         rect.asm):00084         ;   or bottom < 2); every row in between covers all three sixel rows, so
                      (         rect.asm):00085         ;   its masks are constants and need no lookup.
                      (         rect.asm):00086         ; ---------------------------------------------------------------------------
14D7 3476             (         rect.asm):00087         T_RECTF         PSHS    D,X,Y,U
14D9 17012E           (         rect.asm):00088                         LBSR    R_SORT
                      (         rect.asm):00089         
                      (         rect.asm):00090         ; Nothing to do if the rectangle is entirely off one side of the screen
14DC 961A             (         rect.asm):00091                         LDA     <R_X1
14DE 102B0119         (         rect.asm):00092                         LBMI    RF_X            ; right edge left of the screen
14E2 961B             (         rect.asm):00093                         LDA     <R_Y1
14E4 102B0113         (         rect.asm):00094                         LBMI    RF_X            ; bottom edge above the screen
14E8 9618             (         rect.asm):00095                         LDA     <R_X0
14EA 814D             (         rect.asm):00096                         CMPA    #XMAX
14EC 102E010B         (         rect.asm):00097                         LBGT    RF_X            ; left edge right of the screen
14F0 9619             (         rect.asm):00098                         LDA     <R_Y0
14F2 8147             (         rect.asm):00099                         CMPA    #YMAX
14F4 102E0103         (         rect.asm):00100                         LBGT    RF_X            ; top edge below the screen
                      (         rect.asm):00101         
                      (         rect.asm):00102         ; Clip by clamping the edges to the screen
14F8 9618             (         rect.asm):00103                         LDA     <R_X0
14FA 2A02             (         rect.asm):00104                         BPL     RF_1
14FC 0F18             (         rect.asm):00105                         CLR     <R_X0
14FE 9619             (         rect.asm):00106         RF_1            LDA     <R_Y0
1500 2A02             (         rect.asm):00107                         BPL     RF_2
1502 0F19             (         rect.asm):00108                         CLR     <R_Y0
1504 961A             (         rect.asm):00109         RF_2            LDA     <R_X1
1506 814D             (         rect.asm):00110                         CMPA    #XMAX
1508 2F04             (         rect.asm):00111                         BLE     RF_3
150A 864D             (         rect.asm):00112                         LDA     #XMAX
150C 971A             (         rect.asm):00113                         STA     <R_X1
150E 961B             (         rect.asm):00114         RF_3            LDA     <R_Y1
1510 8147             (         rect.asm):00115                         CMPA    #YMAX
1512 2F04             (         rect.asm):00116                         BLE     RF_4
1514 8647             (         rect.asm):00117                         LDA     #YMAX
1516 971B             (         rect.asm):00118                         STA     <R_Y1
                      (         rect.asm):00119         
                      (         rect.asm):00120         ; Work out the column plan once: it is the same for every row
1518 9618             (         rect.asm):00121         RF_4            LDA     <R_X0           ; first cell = x0/2, and is x0 odd?
151A 44               (         rect.asm):00122                         LSRA
151B 971C             (         rect.asm):00123                         STA     <F_CX0
151D 8600             (         rect.asm):00124                         LDA     #0              ; (not CLRA: that would clear carry)
151F 49               (         rect.asm):00125                         ROLA                    ; carry (x0 odd) -> bit 0
1520 971E             (         rect.asm):00126                         STA     <F_PL
1522 961A             (         rect.asm):00127                         LDA     <R_X1           ; last cell = x1/2, and is x1 even?
1524 44               (         rect.asm):00128                         LSRA
1525 971D             (         rect.asm):00129                         STA     <F_CX1
1527 8600             (         rect.asm):00130                         LDA     #0              ; keep carry (x1 odd)
1529 49               (         rect.asm):00131                         ROLA
152A 8801             (         rect.asm):00132                         EORA    #1              ; 1 if x1 even
152C 971F             (         rect.asm):00133                         STA     <F_PR
152E 0F20             (         rect.asm):00134                         CLR     <F_SGL
1530 961C             (         rect.asm):00135                         LDA     <F_CX0
1532 911D             (         rect.asm):00136                         CMPA    <F_CX1
1534 2604             (         rect.asm):00137                         BNE     RF_5
1536 0C20             (         rect.asm):00138                         INC     <F_SGL          ; one cell wide
1538 200F             (         rect.asm):00139                         BRA     RF_6
153A 961C             (         rect.asm):00140         RF_5            LDA     <F_CX0          ; full-width run: from the first cell
153C 9B1E             (         rect.asm):00141                         ADDA    <F_PL           ;  (or the one after, if partial)
153E 9721             (         rect.asm):00142                         STA     <F_RS
1540 961D             (         rect.asm):00143                         LDA     <F_CX1          ;  to the last (or the one before)
1542 901F             (         rect.asm):00144                         SUBA    <F_PR
1544 9021             (         rect.asm):00145                         SUBA    <F_RS
1546 4C               (         rect.asm):00146                         INCA
1547 9722             (         rect.asm):00147                         STA     <F_RN           ; number of cells, may be 0
                      (         rect.asm):00148         
                      (         rect.asm):00149         ; Find the first and last cell rows, and where y0 and y1 fall within them
1549 D619             (         rect.asm):00150         RF_6            LDB     <R_Y0
154B 1700D9           (         rect.asm):00151                         LBSR    PT_ENTRY        ; U -> PTAB entry for y0
154E ECC4             (         rect.asm):00152                         LDD     ,U
1550 D300             (         rect.asm):00153                         ADDD    <W_BUF
1552 DD28             (         rect.asm):00154                         STD     <F_ROW          ; first cell row (column 1)
1554 A642             (         rect.asm):00155                         LDA     2,U
1556 1700DA           (         rect.asm):00156                         LBSR    SUBROW
1559 9723             (         rect.asm):00157                         STA     <F_TOP          ; y0 mod 3
155B D61B             (         rect.asm):00158                         LDB     <R_Y1
155D 1700C7           (         rect.asm):00159                         LBSR    PT_ENTRY
1560 ECC4             (         rect.asm):00160                         LDD     ,U
1562 D300             (         rect.asm):00161                         ADDD    <W_BUF
1564 DD2A             (         rect.asm):00162                         STD     <F_LAST         ; last cell row
1566 A642             (         rect.asm):00163                         LDA     2,U
1568 1700C8           (         rect.asm):00164                         LBSR    SUBROW
156B 9724             (         rect.asm):00165                         STA     <F_BOTL         ; y1 mod 3
                      (         rect.asm):00166         
                      (         rect.asm):00167         ; One cell row per pass
156D 9E28             (         rect.asm):00168         RF_ROW          LDX     <F_ROW          ; is this the last cell row?
156F 9C2A             (         rect.asm):00169                         CMPX    <F_LAST
1571 2712             (         rect.asm):00170                         BEQ     RF_LASTR
1573 0D23             (         rect.asm):00171                         TST     <F_TOP          ; a middle row: all three sixel rows
1575 260A             (         rect.asm):00172                         BNE     RF_FIRST        ;  are covered, so the masks are
1577 8615             (         rect.asm):00173                         LDA     #$15            ;  constants (left pixels 1+4+16,
1579 9725             (         rect.asm):00174                         STA     <F_ML           ;  right pixels 2+8+64) - no need
157B 864A             (         rect.asm):00175                         LDA     #$4A            ;  to look them up
157D 9726             (         rect.asm):00176                         STA     <F_MR
157F 201F             (         rect.asm):00177                         BRA     RF_COLS
1581 C602             (         rect.asm):00178         RF_FIRST        LDB     #2              ; first row (starts part-way down):
1583 2002             (         rect.asm):00179                         BRA     RF_7            ;  sixel rows top..2
1585 D624             (         rect.asm):00180         RF_LASTR        LDB     <F_BOTL         ; last row: sixel rows top..y1 mod 3
1587 9623             (         rect.asm):00181         RF_7            LDA     <F_TOP          ; index = top*3 + bottom
1589 3404             (         rect.asm):00182                         PSHS    B
