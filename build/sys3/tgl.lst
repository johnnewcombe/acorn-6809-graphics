                      (         clip.asm):00122         
                      (         clip.asm):00123         ; ---------------------------------------------------------------------------
                      (         clip.asm):00124         ; ISECT - A = u0 + (u1-u0) * (e-v0) / (v1-v0)
                      (         clip.asm):00125         ;   Rounded to the nearest pixel, which keeps trimmed lines closer to the
                      (         clip.asm):00126         ;   path the unclipped line would take (never more than one pixel off).
                      (         clip.asm):00127         ;   Worked in sign and magnitude: each difference is at most 255, and
                      (         clip.asm):00128         ;   |e-v0| <= |v1-v0| because the edge lies between the endpoints, so the
                      (         clip.asm):00129         ;   product fits 16 bits and the quotient fits 8. The result lies between
                      (         clip.asm):00130         ;   u0 and u1, so plain 8-bit addition gives the right signed value.
                      (         clip.asm):00131         ;   B corrupted.
                      (         clip.asm):00132         ; ---------------------------------------------------------------------------
13C2 0F14             (         clip.asm):00133         ISECT           CLR     <I_SGN
13C4 9610             (         clip.asm):00134                         LDA     <I_U1           ; |u1-u0|
13C6 900F             (         clip.asm):00135                         SUBA    <I_U0
13C8 D610             (         clip.asm):00136                         LDB     <I_U1
13CA D10F             (         clip.asm):00137                         CMPB    <I_U0
13CC 2C03             (         clip.asm):00138                         BGE     IS_1
13CE 40               (         clip.asm):00139                         NEGA
13CF 0314             (         clip.asm):00140                         COM     <I_SGN
13D1 9715             (         clip.asm):00141         IS_1            STA     <I_DU
13D3 9613             (         clip.asm):00142                         LDA     <I_E            ; |e-v0|
13D5 9011             (         clip.asm):00143                         SUBA    <I_V0
13D7 D613             (         clip.asm):00144                         LDB     <I_E
13D9 D111             (         clip.asm):00145                         CMPB    <I_V0
13DB 2C03             (         clip.asm):00146                         BGE     IS_2
13DD 40               (         clip.asm):00147                         NEGA
13DE 0314             (         clip.asm):00148                         COM     <I_SGN
13E0 D615             (         clip.asm):00149         IS_2            LDB     <I_DU
13E2 3D               (         clip.asm):00150                         MUL                     ; D = |u1-u0| * |e-v0|
13E3 3406             (         clip.asm):00151                         PSHS    D
13E5 9612             (         clip.asm):00152                         LDA     <I_V1           ; |v1-v0|
13E7 9011             (         clip.asm):00153                         SUBA    <I_V0
13E9 D612             (         clip.asm):00154                         LDB     <I_V1
13EB D111             (         clip.asm):00155                         CMPB    <I_V0
13ED 2C03             (         clip.asm):00156                         BGE     IS_3
13EF 40               (         clip.asm):00157                         NEGA
13F0 0314             (         clip.asm):00158                         COM     <I_SGN
13F2 9716             (         clip.asm):00159         IS_3            STA     <I_DV
13F4 44               (         clip.asm):00160                         LSRA                    ; round: add |v1-v0|/2 before dividing
13F5 9717             (         clip.asm):00161                         STA     <I_CNT          ;  (I_CNT as a temporary; DIV8 resets it)
13F7 3506             (         clip.asm):00162                         PULS    D
13F9 DB17             (         clip.asm):00163                         ADDB    <I_CNT
13FB 8900             (         clip.asm):00164                         ADCA    #0
13FD 8D0E             (         clip.asm):00165                         BSR     DIV8            ; B = rounded quotient
13FF 960F             (         clip.asm):00166                         LDA     <I_U0
1401 3404             (         clip.asm):00167                         PSHS    B
1403 0D14             (         clip.asm):00168                         TST     <I_SGN
1405 2603             (         clip.asm):00169                         BNE     IS_4
1407 ABE0             (         clip.asm):00170                         ADDA    ,S+
1409 39               (         clip.asm):00171                         RTS
140A A0E0             (         clip.asm):00172         IS_4            SUBA    ,S+
140C 39               (         clip.asm):00173                         RTS
                      (         clip.asm):00174         
                      (         clip.asm):00175         ; ---------------------------------------------------------------------------
                      (         clip.asm):00176         ; DIV8 - unsigned D / I_DV, needs A < I_DV (quotient fits 8 bits)
                      (         clip.asm):00177         ;   Exit: B = quotient, A = remainder
                      (         clip.asm):00178         ; ---------------------------------------------------------------------------
140D 3402             (         clip.asm):00179         DIV8            PSHS    A
140F 8608             (         clip.asm):00180                         LDA     #8
1411 9717             (         clip.asm):00181                         STA     <I_CNT
1413 3502             (         clip.asm):00182                         PULS    A
1415 58               (         clip.asm):00183         DV_LOOP         ASLB                    ; shift dividend left; quotient
1416 49               (         clip.asm):00184                         ROLA                    ;  bits enter B from the right
1417 2504             (         clip.asm):00185                         BCS     DV_SUB
1419 9116             (         clip.asm):00186                         CMPA    <I_DV
141B 2503             (         clip.asm):00187                         BLO     DV_NEXT
141D 9016             (         clip.asm):00188         DV_SUB          SUBA    <I_DV
141F 5C               (         clip.asm):00189                         INCB
1420 0A17             (         clip.asm):00190         DV_NEXT         DEC     <I_CNT
1422 26F1             (         clip.asm):00191                         BNE     DV_LOOP
1424 39               (         clip.asm):00192                         RTS
                      (      src/tgl.asm):00070                         INCLUDE "system.asm"
                      (       system.asm):00001         ; ---------------------------------------------------------------------------
                      (       system.asm):00002         ; System services: restoring the display, reading the keyboard, exiting.
                      (       system.asm):00003         ; These go through the monitor's RAM vectors (target/*.inc), so they work
                      (       system.asm):00004         ; whichever monitor version is fitted.
                      (       system.asm):00005         ; ---------------------------------------------------------------------------
                      (       system.asm):00006         
                      (       system.asm):00007         ; ---------------------------------------------------------------------------
                      (       system.asm):00008         ; T_DONE - give the display back to the monitor / FLEX
                      (       system.asm):00009         ;   Sends a form feed through the monitor's console output vector. The
                      (       system.asm):00010         ;   monitor's form-feed handler (CRTCI) re-detects the 6845 type, reloads
                      (       system.asm):00011         ;   all its registers (restoring the cursor and start address), resets the
                      (       system.asm):00012         ;   driver's row, column and scroll position, homes the cursor and clears
                      (       system.asm):00013         ;   the screen.
                      (       system.asm):00014         ;   Entry: any DP              Exit: all registers preserved
                      (       system.asm):00015         ; ---------------------------------------------------------------------------
1425 3402             (       system.asm):00016         T_DONE          PSHS    A
1427 860C             (       system.asm):00017                         LDA     #$0C            ; form feed
1429 AD9F0365         (       system.asm):00018                         JSR     [MON_COPADR]
142D 3582             (       system.asm):00019                         PULS    A,PC
                      (       system.asm):00020         
                      (       system.asm):00021         ; ---------------------------------------------------------------------------
                      (       system.asm):00022         ; T_INKEY - check for a key without waiting
                      (       system.asm):00023         ;   The monitor's IRQ handler buffers keypresses; a key is waiting when the
                      (       system.asm):00024         ;   buffer's tail and static head differ. Needs IRQs enabled.
                      (       system.asm):00025         ;   Entry: any DP
                      (       system.asm):00026         ;   Exit:  Z set, A = 0 if no key; Z clear, A = key if there was one.
                      (       system.asm):00027         ;          Other registers preserved.
                      (       system.asm):00028         ; ---------------------------------------------------------------------------
142F 3410             (       system.asm):00029         T_INKEY         PSHS    X
1431 BE038B           (       system.asm):00030                         LDX     MON_TAIL
1434 BC0387           (       system.asm):00031                         CMPX    MON_HEADST
1437 2708             (       system.asm):00032                         BEQ     IK_NONE
1439 AD9F0367         (       system.asm):00033                         JSR     [MON_CINADR]    ; returns at once: a key is waiting
143D 1CFB             (       system.asm):00034                         ANDCC   #$FB            ; Z clear: key in A
143F 3590             (       system.asm):00035                         PULS    X,PC
