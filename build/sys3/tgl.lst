                      (         line.asm):00116                         BRA     LN_GO
1137                  (         line.asm):00117         LN_BAD          PULS    D,X
1137                  (         line.asm):00118         LN_RTS          RTS
1137                  (         line.asm):00119         LN_GO
                      (         line.asm):00120                         ENDC
