                      (    demo/logo.asm):00001         ; ===========================================================================
                      (    demo/logo.asm):00002         ; Splash-screen demo: an existing teletext screen, turned over with
                      (    demo/logo.asm):00003         ; TGL_FLIPH
                      (    demo/logo.asm):00004         ;
                      (    demo/logo.asm):00005         ;   Shows a teletext graphics screen converted by tools/screen2tgl.py, then
                      (    demo/logo.asm):00006         ;   turns it over every couple of seconds: it narrows to the centre line
                      (    demo/logo.asm):00007         ;   and opens out again mirror-reversed, like a card. Press any key to exit.
                      (    demo/logo.asm):00008         ;
                      (    demo/logo.asm):00009         ;   The picture is in logo_screen.asm, in the library's buffer layout: 24
                      (    demo/logo.asm):00010         ;   rows of 39 cells (columns 1-39) then the 24 row colours. To use your
                      (    demo/logo.asm):00011         ;   own screen, regenerate it from a hex listing of the screen memory:
                      (    demo/logo.asm):00012         ;
                      (    demo/logo.asm):00013         ;       python3 tools/screen2tgl.py listing.txt --label LOGO \
                      (    demo/logo.asm):00014         ;               -o demo/logo_screen.asm
                      (    demo/logo.asm):00015         ;
                      (    demo/logo.asm):00016         ;   (add --first-row 1 if graphics row 0 is screen row 1, and so on).
                      (    demo/logo.asm):00017         ;   The library draws contiguous graphics, so a separated-graphics screen
                      (    demo/logo.asm):00018         ;   shows as solid blocks.
                      (    demo/logo.asm):00019         ;
                      (    demo/logo.asm):00020         ;   Loading: tgls.bin (or tgl.bin) at $1000 (TGL_BASE below), logo.bin at
                      (    demo/logo.asm):00021         ;   $2800.
                      (    demo/logo.asm):00022         ;   Run from START ($2800). Works with either machine's library build.
                      (    demo/logo.asm):00023         ; ===========================================================================
                      (    demo/logo.asm):00024         
     1000             (    demo/logo.asm):00025         TGL_BASE        EQU     $1000
                      (    demo/logo.asm):00026                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
     1045             (      tgl_api.inc):00032         TGL_FLIPH       EQU     TGL_BASE+69     ; card-turn flip: A = ticks per frame
     1048             (      tgl_api.inc):00033         TGL_SETDASH     EQU     TGL_BASE+72     ; dash: A = pattern, B = length, X = phase
     104B             (      tgl_api.inc):00034         TGL_LINED       EQU     TGL_BASE+75     ; dashed line: as TGL_LINEC
     104E             (      tgl_api.inc):00035         TGL_RECTD       EQU     TGL_BASE+78     ; dashed rectangle outline: as TGL_RECT
                      (      tgl_api.inc):00036         
     03C0             (      tgl_api.inc):00037         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00038         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00039         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00040         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00041         
                      (      tgl_api.inc):00042         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00043         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00044         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00045         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00046         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00047         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00048         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00049         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00050         
                      (      tgl_api.inc):00051         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00052         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00053         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00054         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00055         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00056         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00057         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00058         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00059         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00060         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (    demo/logo.asm):00027         
     3800             (    demo/logo.asm):00028         BUFFER          EQU     $3800           ; off-screen buffer (960 bytes)
     0200             (    demo/logo.asm):00029         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    demo/logo.asm):00030         
     0002             (    demo/logo.asm):00031         FLIP_TICKS      EQU     2               ; flip speed: 50Hz ticks per frame
                      (    demo/logo.asm):00032                                                 ;  (2 = about 0.7 s, 3 = about 1 s)
     0064             (    demo/logo.asm):00033         PAUSE           EQU     100             ; pause between flips, in 50Hz ticks
                      (    demo/logo.asm):00034         
     0080             (    demo/logo.asm):00035         WAITN           EQU     $80             ; pause counter
     0081             (    demo/logo.asm):00036         ROW             EQU     $81             ; row being copied
                      (    demo/logo.asm):00037         
                      (    demo/logo.asm):00038                         ORG     $2800
                      (    demo/logo.asm):00039         
2800 10CE0200         (    demo/logo.asm):00040         START           LDS     #STACK_TOP
2804 4F               (    demo/logo.asm):00041                         CLRA                    ; DP = $00 for the library
2805 1F8B             (    demo/logo.asm):00042                         TFR     A,DP
     00               (    demo/logo.asm):00043                         SETDP   $00
2807 1CEF             (    demo/logo.asm):00044                         ANDCC   #$EF            ; IRQs on (keyboard)
2809 BD1000           (    demo/logo.asm):00045                         JSR     TGL_INIT
280C 8E3800           (    demo/logo.asm):00046                         LDX     #BUFFER
280F BD1003           (    demo/logo.asm):00047                         JSR     TGL_SETBUF
2812 BD1006           (    demo/logo.asm):00048                         JSR     TGL_CLS
2815 4F               (    demo/logo.asm):00049                         CLRA                    ; status row title
2816 8E286A           (    demo/logo.asm):00050                         LDX     #TITLE
2819 BD1030           (    demo/logo.asm):00051                         JSR     TGL_TEXT
                      (    demo/logo.asm):00052         
                      (    demo/logo.asm):00053         ; ---------------------------------------------------------------------------
                      (    demo/logo.asm):00054         ; Copy the picture into the buffer: for each row, its cells into columns
                      (    demo/logo.asm):00055         ; LOGO_COL1-39, then its colour with TGL_COLOUR (which writes column 0 and
                      (    demo/logo.asm):00056         ; remembers it, so TGL_CLS would keep it)
                      (    demo/logo.asm):00057         ; ---------------------------------------------------------------------------
281C 108E2887         (    demo/logo.asm):00058                         LDY     #LOGO           ; Y -> the picture's cells
2820 CE3802           (    demo/logo.asm):00059                         LDU     #BUFFER+LOGO_COL1 ; U -> first picture column, row 0
2823 0F81             (    demo/logo.asm):00060                         CLR     <ROW
2825 C626             (    demo/logo.asm):00061         COPYROW         LDB     #LOGO_CELLS     ; this row's cells
2827 A6A0             (    demo/logo.asm):00062         COPYCELL        LDA     ,Y+
2829 A7C0             (    demo/logo.asm):00063                         STA     ,U+
282B 5A               (    demo/logo.asm):00064                         DECB
282C 26F9             (    demo/logo.asm):00065                         BNE     COPYCELL
282E 33C90002         (    demo/logo.asm):00066                         LEAU    LOGO_COL1,U     ; skip the next row's control columns
2832 8E2C17           (    demo/logo.asm):00067                         LDX     #LOGO_COL       ; this row's colour (1-7)
2835 D681             (    demo/logo.asm):00068                         LDB     <ROW
2837 3A               (    demo/logo.asm):00069                         ABX
2838 E684             (    demo/logo.asm):00070                         LDB     ,X
283A 4F               (    demo/logo.asm):00071                         CLRA
283B 1F01             (    demo/logo.asm):00072                         TFR     D,X             ; X = colour
283D 9681             (    demo/logo.asm):00073                         LDA     <ROW            ; A = B = this row
283F D681             (    demo/logo.asm):00074                         LDB     <ROW
2841 BD1039           (    demo/logo.asm):00075                         JSR     TGL_COLOUR
2844 0C81             (    demo/logo.asm):00076                         INC     <ROW
2846 9681             (    demo/logo.asm):00077                         LDA     <ROW
2848 8118             (    demo/logo.asm):00078                         CMPA    #24
284A 25D9             (    demo/logo.asm):00079                         BLO     COPYROW
284C BD1012           (    demo/logo.asm):00080                         JSR     TGL_BLIT
                      (    demo/logo.asm):00081         
                      (    demo/logo.asm):00082         ; ---------------------------------------------------------------------------
                      (    demo/logo.asm):00083         ; Pause, flip, repeat (any key exits)
                      (    demo/logo.asm):00084         ; ---------------------------------------------------------------------------
284F 8664             (    demo/logo.asm):00085         LOOP            LDA     #PAUSE          ; pause, checking for a key
2851 9780             (    demo/logo.asm):00086                         STA     <WAITN
2853 BD101E           (    demo/logo.asm):00087         WAIT            JSR     TGL_INKEY
2856 1026E7C7         (    demo/logo.asm):00088                         LBNE    TGL_EXIT
285A 8601             (    demo/logo.asm):00089                         LDA     #1              ; one 50Hz tick
285C BD103C           (    demo/logo.asm):00090                         JSR     TGL_PACE
285F 0A80             (    demo/logo.asm):00091                         DEC     <WAITN
2861 26F0             (    demo/logo.asm):00092                         BNE     WAIT
2863 8602             (    demo/logo.asm):00093                         LDA     #FLIP_TICKS     ; turn the picture over
2865 BD1045           (    demo/logo.asm):00094                         JSR     TGL_FLIPH
2868 20E5             (    demo/logo.asm):00095                         BRA     LOOP
                      (    demo/logo.asm):00096         
                      (    demo/logo.asm):00097         ; Status row title. $86 cyan, $83 yellow text codes.
286A 86               (    demo/logo.asm):00098         TITLE           FCB     $86
286B 53504C4153482053 (    demo/logo.asm):00099                         FCC     "SPLASH SCREEN"
     435245454E
2878 83               (    demo/logo.asm):00100                         FCB     $83
2879 414E59204B455920 (    demo/logo.asm):00101                         FCC     "ANY KEY EXITS"
     4558495453
2886 00               (    demo/logo.asm):00102                         FCB     0
                      (    demo/logo.asm):00103         
                      (    demo/logo.asm):00104         ; The picture (generated by tools/screen2tgl.py)
                      (    demo/logo.asm):00105                         INCLUDE "logo_screen.asm"
                      (  logo_screen.asm):00001         ; LOGO - generated by tools/screen2tgl.py from download.txt (the editor's screen file)
                      (  logo_screen.asm):00002         ;   24 rows x 38 cells (columns 2-39, the library's buffer layout),
                      (  logo_screen.asm):00003         ;   then each row's graphics colour (LOGO_COL, 1-7)
     0002             (  logo_screen.asm):00004         LOGO_COL1        EQU     2               ; first picture column
     0026             (  logo_screen.asm):00005         LOGO_CELLS       EQU     38              ; cells per row
