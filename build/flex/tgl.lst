                      (      src/tgl.asm):00088                         INCLUDE "text.asm"
                      (         text.asm):00001         ; ---------------------------------------------------------------------------
                      (         text.asm):00002         ; Status row text
                      (         text.asm):00003         ;   The status row is screen row 24, below the 24 rows of graphics. The
                      (         text.asm):00004         ;   blit never touches it, so text written there stays put while the
                      (         text.asm):00005         ;   graphics above it change. Text is written straight to the screen (not
                      (         text.asm):00006         ;   the off-screen buffer), so it appears immediately.
                      (         text.asm):00007         ;
                      (         text.asm):00008         ;   Strings are zero-terminated and may contain teletext control codes to
                      (         text.asm):00009         ;   colour the text that follows them on the row, e.g. $81 red, $82 green,
                      (         text.asm):00010         ;   $83 yellow, $84 blue, $85 magenta, $86 cyan, $87 white ($01-$07 work
                      (         text.asm):00011         ;   too: the SAA5050 ignores the top bit). Each control code takes up one
                      (         text.asm):00012         ;   character position and shows as a space. Text starts white at the
                      (         text.asm):00013         ;   left of the row.
                      (         text.asm):00014         ; ---------------------------------------------------------------------------
                      (         text.asm):00015         
     E7C0             (         text.asm):00016         STATUS          EQU     VDU_BASE+STATUS_ROW*COLS        ; first byte of row 24
                      (         text.asm):00017         
                      (         text.asm):00018         ; ---------------------------------------------------------------------------
                      (         text.asm):00019         ; T_TEXT - write a string to the status row
                      (         text.asm):00020         ;   Entry: A = column (0-39), X -> zero-terminated string, DP = $00
                      (         text.asm):00021         ;   Exit:  all registers preserved
                      (         text.asm):00022         ;   Stops at the right-hand edge rather than wrapping. A column beyond 39
                      (         text.asm):00023         ;   writes nothing.
                      (         text.asm):00024         ; ---------------------------------------------------------------------------
17C1 3456             (         text.asm):00025         T_TEXT          PSHS    D,X,U
17C3 8127             (         text.asm):00026                         CMPA    #COLS-1         ; column off the end of the row?
17C5 2212             (         text.asm):00027                         BHI     TX_X
17C7 CEE7C0           (         text.asm):00028                         LDU     #STATUS         ; U -> screen position
17CA 33C6             (         text.asm):00029                         LEAU    A,U             ;  (A is 0-39, so the add is safe)
17CC 1F89             (         text.asm):00030                         TFR     A,B             ; B = column, to stop at the edge
17CE A680             (         text.asm):00031         TX_LOOP         LDA     ,X+             ; next character
17D0 2707             (         text.asm):00032                         BEQ     TX_X            ; zero: end of string
17D2 A7C0             (         text.asm):00033                         STA     ,U+
17D4 5C               (         text.asm):00034                         INCB
17D5 C128             (         text.asm):00035                         CMPB    #COLS           ; reached the right-hand edge?
17D7 25F5             (         text.asm):00036                         BLO     TX_LOOP
17D9 35D6             (         text.asm):00037         TX_X            PULS    D,X,U,PC
                      (         text.asm):00038         
                      (         text.asm):00039         ; ---------------------------------------------------------------------------
                      (         text.asm):00040         ; T_TCLR - clear the status row to spaces
                      (         text.asm):00041         ;   Entry: DP = $00    Exit: all registers preserved
                      (         text.asm):00042         ; ---------------------------------------------------------------------------
17DB 3416             (         text.asm):00043         T_TCLR          PSHS    D,X
17DD 8EE7C0           (         text.asm):00044                         LDX     #STATUS
17E0 CC2020           (         text.asm):00045                         LDD     #$2020          ; two spaces at a time
17E3 ED81             (         text.asm):00046         TC_LOOP         STD     ,X++
17E5 8CE7E8           (         text.asm):00047                         CMPX    #STATUS+COLS
17E8 25F9             (         text.asm):00048                         BLO     TC_LOOP
17EA 3596             (         text.asm):00049                         PULS    D,X,PC
                      (         text.asm):00050         
                      (         text.asm):00051         ; ---------------------------------------------------------------------------
                      (         text.asm):00052         ; T_TNUM - write a number to the status row
                      (         text.asm):00053         ;   Entry: A = column (0-39), X = value (0-65535, unsigned), DP = $00
                      (         text.asm):00054         ;   Exit:  all registers preserved
                      (         text.asm):00055         ;   Always five characters, right-aligned with leading spaces, so a value
                      (         text.asm):00056         ;   that shrinks (e.g. from 100 to 99) leaves no stray digits behind.
                      (         text.asm):00057         ;
                      (         text.asm):00058         ;   Each digit is found by counting how many times the matching power of
                      (         text.asm):00059         ;   ten can be subtracted (10000, 1000, 100, 10); what is left is the last
                      (         text.asm):00060         ;   digit. Leading zeros become spaces; the last digit is always shown.
                      (         text.asm):00061         ; ---------------------------------------------------------------------------
17EC 3476             (         text.asm):00062         T_TNUM          PSHS    D,X,Y,U
17EE 1F10             (         text.asm):00063                         TFR     X,D             ; D = value
17F0 338D0045         (         text.asm):00064                         LEAU    POW10,PCR       ; U -> 10000, 1000, 100, 10
17F4 108E0038         (         text.asm):00065                         LDY     #T_BUF          ; Y -> where the characters go
17F8 0F3F             (         text.asm):00066                         CLR     <T_LEAD         ; no non-zero digit yet
17FA 0F3E             (         text.asm):00067         TN_DIGIT        CLR     <T_DIG
17FC 10A3C4           (         text.asm):00068         TN_SUB          CMPD    ,U              ; can this power be subtracted?
17FF 2506             (         text.asm):00069                         BLO     TN_PUT          ;  (unsigned compare)
1801 A3C4             (         text.asm):00070                         SUBD    ,U
1803 0C3E             (         text.asm):00071                         INC     <T_DIG
1805 20F5             (         text.asm):00072                         BRA     TN_SUB
1807 3406             (         text.asm):00073         TN_PUT          PSHS    D               ; keep the remainder
1809 963E             (         text.asm):00074                         LDA     <T_DIG
180B 2608             (         text.asm):00075                         BNE     TN_NZ           ; a zero before any other digit
180D 0D3F             (         text.asm):00076                         TST     <T_LEAD         ;  is a leading zero: a space
180F 2606             (         text.asm):00077                         BNE     TN_CH
1811 8620             (         text.asm):00078                         LDA     #' '
1813 2004             (         text.asm):00079                         BRA     TN_ST
1815 0C3F             (         text.asm):00080         TN_NZ           INC     <T_LEAD
1817 8B30             (         text.asm):00081         TN_CH           ADDA    #'0'
1819 A7A0             (         text.asm):00082         TN_ST           STA     ,Y+
181B 3506             (         text.asm):00083                         PULS    D
181D 3342             (         text.asm):00084                         LEAU    2,U             ; next power of ten
181F 308D001E         (         text.asm):00085                         LEAX    POW10E,PCR
1823 3410             (         text.asm):00086                         PSHS    X
1825 11A3E1           (         text.asm):00087                         CMPU    ,S++            ; done all four powers?
1828 25D0             (         text.asm):00088                         BLO     TN_DIGIT
182A CB30             (         text.asm):00089                         ADDB    #'0'            ; the last digit, always shown
182C E7A0             (         text.asm):00090                         STB     ,Y+
182E 6FA4             (         text.asm):00091                         CLR     ,Y              ; end of string
1830 A6E4             (         text.asm):00092                         LDA     ,S              ; column (caller's A, on the stack)
1832 8E0038           (         text.asm):00093                         LDX     #T_BUF
1835 8D8A             (         text.asm):00094                         BSR     T_TEXT
1837 35F6             (         text.asm):00095                         PULS    D,X,Y,U,PC
                      (         text.asm):00096         
1839 271003E80064000A (         text.asm):00097         POW10           FDB     10000,1000,100,10
1841                  (         text.asm):00098         POW10E
                      (      src/tgl.asm):00089                         INCLUDE "system.asm"
                      (       system.asm):00001         ; ---------------------------------------------------------------------------
                      (       system.asm):00002         ; System services: restoring the display, reading the keyboard, exiting.
                      (       system.asm):00003         ; These go through the monitor's RAM vectors (target/*.inc), so they work
                      (       system.asm):00004         ; whichever monitor version is fitted.
                      (       system.asm):00005         ; ---------------------------------------------------------------------------
                      (       system.asm):00006         
                      (       system.asm):00007         ; ---------------------------------------------------------------------------
                      (       system.asm):00008         ; T_DONE - give the display back to the monitor / FLEX
                      (       system.asm):00009         ;   Sends a form feed through the monitor's console output vector. The
                      (       system.asm):00010         ;   monitor's form-feed handler (CRTCI) re-detects the 6845 type, reloads
                      (       system.asm):00011         ;   all its registers (restoring the cursor and start address), resets the
                      (       system.asm):00012         ;   driver's row, column and scroll position, homes the cursor and clears
                      (       system.asm):00013         ;   the screen.
                      (       system.asm):00014         ;   Entry: any DP              Exit: all registers preserved
                      (       system.asm):00015         ; ---------------------------------------------------------------------------
1841 3402             (       system.asm):00016         T_DONE          PSHS    A
1843 860C             (       system.asm):00017                         LDA     #$0C            ; form feed
1845 AD9FE365         (       system.asm):00018                         JSR     [MON_COPADR]
1849 3582             (       system.asm):00019                         PULS    A,PC
                      (       system.asm):00020         
                      (       system.asm):00021         ; ---------------------------------------------------------------------------
                      (       system.asm):00022         ; T_INKEY - check for a key without waiting
                      (       system.asm):00023         ;   The monitor's IRQ handler buffers keypresses; a key is waiting when the
                      (       system.asm):00024         ;   buffer's tail and static head differ. Needs IRQs enabled.
                      (       system.asm):00025         ;   Entry: any DP
                      (       system.asm):00026         ;   Exit:  Z set, A = 0 if no key; Z clear, A = key if there was one.
                      (       system.asm):00027         ;          Other registers preserved.
                      (       system.asm):00028         ; ---------------------------------------------------------------------------
184B 3410             (       system.asm):00029         T_INKEY         PSHS    X
184D BEE38B           (       system.asm):00030                         LDX     MON_TAIL
1850 BCE387           (       system.asm):00031                         CMPX    MON_HEADST
1853 2708             (       system.asm):00032                         BEQ     IK_NONE
1855 AD9FE367         (       system.asm):00033                         JSR     [MON_CINADR]    ; returns at once: a key is waiting
1859 1CFB             (       system.asm):00034                         ANDCC   #$FB            ; Z clear: key in A
185B 3590             (       system.asm):00035                         PULS    X,PC
185D 4F               (       system.asm):00036         IK_NONE         CLRA                    ; Z set (PULS leaves flags alone)
185E 3590             (       system.asm):00037                         PULS    X,PC
                      (       system.asm):00038         
                      (       system.asm):00039         ; ---------------------------------------------------------------------------
                      (       system.asm):00040         ; T_EXIT - restore the display and return to the operating system
                      (       system.asm):00041         ;   FLEX machine: FLEX warm start. Standard System 3: SWI into the monitor
                      (       system.asm):00042         ;   (it shows the registers and stays in the monitor; proceeding just
                      (       system.asm):00043         ;   re-executes the SWI).
                      (       system.asm):00044         ;   Does not return.
                      (       system.asm):00045         ; ---------------------------------------------------------------------------
1860 8DDF             (       system.asm):00046         T_EXIT          BSR     T_DONE
                      (       system.asm):00047                         IFDEF   TARGET_FLEX
1862 7ECD03           (       system.asm):00048                         JMP     FLEX_WARMS
                      (       system.asm):00049                         ELSE
                      (       system.asm):00050                         SWI
                      (       system.asm):00051                         ENDC
