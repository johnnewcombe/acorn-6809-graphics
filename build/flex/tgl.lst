1C75 C30001           (      polygon.asm):00566                         ADDD    #1
1C78 39               (      polygon.asm):00567         CE_X            RTS
                      (      polygon.asm):00568         
                      (      polygon.asm):00569         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00570         ; CH_STEP - move the walker's crossing down one row:
                      (      polygon.asm):00571         ;   q = q + qd, r = r + rd, and if r reaches dy, r = r - dy and q = q + 1
