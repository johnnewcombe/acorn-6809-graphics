                      (         flip.asm):00231         ; FL_MIRROR - mirror the buffer left-to-right in place: in each row, swap
                      (         flip.asm):00232         ;   cells 1-19 with 39-21, mirroring each (its left and right pixels
                      (         flip.asm):00233         ;   swapped), and mirror cell 20 where it is
                      (         flip.asm):00234         ; ---------------------------------------------------------------------------
1E20 9E00             (         flip.asm):00235         FL_MIRROR       LDX     <W_BUF
1E22 8618             (         flip.asm):00236                         LDA     #ROWS
1E24 9715             (         flip.asm):00237                         STA     <FL_CNT
1E26 3410             (         flip.asm):00238         MR_ROW          PSHS    X
1E28 318827           (         flip.asm):00239                         LEAY    39,X            ; Y -> column 39
1E2B 3001             (         flip.asm):00240                         LEAX    1,X             ; X -> column 1
1E2D 8613             (         flip.asm):00241                         LDA     #19
1E2F 9713             (         flip.asm):00242                         STA     <FL_J
1E31 E6A4             (         flip.asm):00243         MR_LOOP         LDB     ,Y              ; mirror of the right-hand cell ...
1E33 8D22             (         flip.asm):00244                         BSR     MIRB
1E35 3402             (         flip.asm):00245                         PSHS    A
1E37 E684             (         flip.asm):00246                         LDB     ,X              ; ... and of the left-hand one
1E39 8D1C             (         flip.asm):00247                         BSR     MIRB
1E3B A7A4             (         flip.asm):00248                         STA     ,Y              ; swap them
1E3D 3502             (         flip.asm):00249                         PULS    A
1E3F A780             (         flip.asm):00250                         STA     ,X+
1E41 313F             (         flip.asm):00251                         LEAY    -1,Y
1E43 0A13             (         flip.asm):00252                         DEC     <FL_J
1E45 26EA             (         flip.asm):00253                         BNE     MR_LOOP
1E47 E684             (         flip.asm):00254                         LDB     ,X              ; the middle cell (column 20)
1E49 8D0C             (         flip.asm):00255                         BSR     MIRB
1E4B A784             (         flip.asm):00256                         STA     ,X
1E4D 3510             (         flip.asm):00257                         PULS    X
1E4F 308828           (         flip.asm):00258                         LEAX    COLS,X
1E52 0A15             (         flip.asm):00259                         DEC     <FL_CNT
1E54 26D0             (         flip.asm):00260                         BNE     MR_ROW
1E56 39               (         flip.asm):00261                         RTS
                      (         flip.asm):00262         
                      (         flip.asm):00263         ; MIRB - Entry: B = sixel cell   Exit: A = its mirror image
1E57 3440             (         flip.asm):00264         MIRB            PSHS    U
