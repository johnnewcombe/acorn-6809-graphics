16B2 9035             (       circle.asm):00135                         SUBA    <C_ST
16B4 2802             (       circle.asm):00136                         BVC     RD_6
16B6 8680             (       circle.asm):00137                         LDA     #-128
16B8 1F89             (       circle.asm):00138         RD_6            TFR     A,B
16BA 3502             (       circle.asm):00139                         PULS    A
                      (       circle.asm):00140                         ; fall into DRUN
