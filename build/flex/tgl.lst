1639 4F               (         rect.asm):00286                         CLRA
163A 58               (         rect.asm):00287                         ASLB                    ; D = y * 4
163B 49               (         rect.asm):00288                         ROLA
163C 58               (         rect.asm):00289                         ASLB
163D 49               (         rect.asm):00290                         ROLA
163E 33CB             (         rect.asm):00291                         LEAU    D,U
1640 39               (         rect.asm):00292                         RTS
                      (         rect.asm):00293         
                      (         rect.asm):00294         ; ---------------------------------------------------------------------------
                      (         rect.asm):00295         ; SUBROW - which sixel row a left-pixel mask is on
