1437 9610             (         clip.asm):00134                         LDA     <I_U1           ; |u1-u0|
1439 900F             (         clip.asm):00135                         SUBA    <I_U0
143B D610             (         clip.asm):00136                         LDB     <I_U1
143D D10F             (         clip.asm):00137                         CMPB    <I_U0
143F 2C03             (         clip.asm):00138                         BGE     IS_1
