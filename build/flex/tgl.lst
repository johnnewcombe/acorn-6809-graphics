1A79 6FC4             (      polygon.asm):00244                         CLR     ,U
1A7B 8501             (      polygon.asm):00245                         BITA    #1              ; left pixels allowed?
1A7D 2708             (      polygon.asm):00246                         BEQ     PM_1
1A7F 3402             (      polygon.asm):00247                         PSHS    A
1A81 A685             (      polygon.asm):00248                         LDA     B,X
1A83 A7C4             (      polygon.asm):00249                         STA     ,U
1A85 3502             (      polygon.asm):00250                         PULS    A
1A87 6F43             (      polygon.asm):00251         PM_1            CLR     3,U
1A89 8502             (      polygon.asm):00252                         BITA    #2              ; right pixels allowed?
1A8B 2708             (      polygon.asm):00253                         BEQ     PM_2
1A8D 308D014B         (      polygon.asm):00254                         LEAX    CW_RBIT,PCR
1A91 A685             (      polygon.asm):00255                         LDA     B,X
