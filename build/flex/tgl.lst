                      (      polygon.asm):00479         ;   (xn,yn): dy = yn - yc, and the crossing moves by dx/dy = qd + rd/dy
                      (      polygon.asm):00480         ;   per row, where qd and rd come from one division (rounded down, so rd
                      (      polygon.asm):00481         ;   is never negative).
                      (      polygon.asm):00482         ; ---------------------------------------------------------------------------
1BE1 9660             (      polygon.asm):00483         CH_SETUP        LDA     <P_N            ; guard: never skip more than n flat
1BE3 9713             (      polygon.asm):00484                         STA     <P_CNT          ;  edges
1BE5 A6C4             (      polygon.asm):00485         CS_LOOP         LDA     CH_CUR,U        ; next corner = cur + dir, wrapping
1BE7 AB4A             (      polygon.asm):00486                         ADDA    CH_DIR,U        ;  round the list
1BE9 2A02             (      polygon.asm):00487                         BPL     CS_1
1BEB 9B60             (      polygon.asm):00488                         ADDA    <P_N
1BED 9160             (      polygon.asm):00489         CS_1            CMPA    <P_N
