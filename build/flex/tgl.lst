13E8 2006             (         clip.asm):00092                         BRA     LCC_H
13EA 8508             (         clip.asm):00093         LCC_1           BITA    #8
13EC 2715             (         clip.asm):00094                         BEQ     LCC_2
13EE C647             (         clip.asm):00095                         LDB     #YMAX           ; bottom edge
13F0 D713             (         clip.asm):00096         LCC_H           STB     <I_E            ; horizontal edge: solve for x
13F2 DC06             (         clip.asm):00097                         LDD     <W_X0
