                      (         plot.asm):00032         ; ---------------------------------------------------------------------------
                      (         plot.asm):00033         ; T_PLOT - plot one sixel pixel in the off-screen buffer
                      (         plot.asm):00034         ;   Entry: A = x (0-77), B = y (0-71), DP = $00
                      (         plot.asm):00035         ;   Exit:  all registers preserved
                      (         plot.asm):00036         ;   No range checking in a normal build - out-of-range coordinates write
                      (         plot.asm):00037         ;   outside the buffer. A TGL_SAFE build ignores off-screen points instead.
                      (         plot.asm):00038         ;
                      (         plot.asm):00039         ;   cell = buffer + (y/3)*40 + 1 + x/2,  mask from (x&1, y%3)
                      (         plot.asm):00040         ; ---------------------------------------------------------------------------
1121                  (         plot.asm):00041         T_PLOT
                      (         plot.asm):00042                         IFDEF   TGL_SAFE
                      (         plot.asm):00043                         CMPA    #XMAX           ; off screen: do nothing
                      (         plot.asm):00044                         BHI     PLOT_RTS
                      (         plot.asm):00045                         CMPB    #YMAX
                      (         plot.asm):00046                         BHI     PLOT_RTS
                      (         plot.asm):00047                         ENDC
1121 3436             (         plot.asm):00048                         PSHS    D,X,Y
1123 318D04EC         (         plot.asm):00049                         LEAY    PTAB,PCR
1127 4F               (         plot.asm):00050                         CLRA                    ; D = y
1128 58               (         plot.asm):00051                         ASLB                    ; D = y*4 (entries are 4 bytes)
1129 49               (         plot.asm):00052                         ROLA
112A 58               (         plot.asm):00053                         ASLB
112B 49               (         plot.asm):00054                         ROLA
112C 31AB             (         plot.asm):00055                         LEAY    D,Y             ; Y -> PTAB entry for this y
112E ECA4             (         plot.asm):00056                         LDD     ,Y              ; offset of column 1 of the cell row
1130 D300             (         plot.asm):00057                         ADDD    <W_BUF
1132 1F01             (         plot.asm):00058                         TFR     D,X
1134 E6E4             (         plot.asm):00059                         LDB     ,S              ; x (caller's A, saved on the stack)
1136 54               (         plot.asm):00060                         LSRB                    ; B = x/2, C = x&1
1137 3A               (         plot.asm):00061                         ABX                     ; X -> cell (ABX leaves C alone)
1138 2504             (         plot.asm):00062                         BCS     PLOT_R
113A A622             (         plot.asm):00063                         LDA     2,Y             ; left pixel mask
113C 2002             (         plot.asm):00064                         BRA     PLOT_PRE
113E A623             (         plot.asm):00065         PLOT_R          LDA     3,Y             ; right pixel mask
1140 12               (         plot.asm):00066         PLOT_PRE        NOP                     ; patched: NOP or COMA
1141 AA84             (         plot.asm):00067         PLOT_OP         ORA     ,X              ; patched: ORA / ANDA / EORA ,X
1143 A784             (         plot.asm):00068                         STA     ,X
