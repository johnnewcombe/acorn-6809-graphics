1E5D A6C5             (         flip.asm):00266                         LDA     B,U             ;  bit 5) ...
1E5F 338D0182         (         flip.asm):00267                         LEAU    FL_LRT-$20,PCR  ; ... and left pixels moved right
1E63 AAC5             (         flip.asm):00268                         ORA     B,U
1E65 35C0             (         flip.asm):00269                         PULS    U,PC
                      (         flip.asm):00270         
