                      (         rect.asm):00208         
157C 0D1E             (         rect.asm):00209         RF_MULTI        TST     <F_PL           ; partial first cell: right pixels
157E 270B             (         rect.asm):00210                         BEQ     RF_10
1580 9E28             (         rect.asm):00211                         LDX     <F_ROW
1582 D61C             (         rect.asm):00212                         LDB     <F_CX0
1584 3A               (         rect.asm):00213                         ABX
1585 9626             (         rect.asm):00214                         LDA     <F_MR
1587 C601             (         rect.asm):00215                         LDB     #1
1589 8D32             (         rect.asm):00216                         BSR     FILLSEG
158B D622             (         rect.asm):00217         RF_10           LDB     <F_RN           ; the full-width run
