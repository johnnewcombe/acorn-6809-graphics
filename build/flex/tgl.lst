                      (      src/tgl.asm):00089                         INCLUDE "clip.asm"
                      (         clip.asm):00001         ; ---------------------------------------------------------------------------
                      (         clip.asm):00002         ; Clipped drawing - coordinates are signed bytes (-128..127); anything
                      (         clip.asm):00003         ; outside x 0-77, y 0-71 is not drawn.
                      (         clip.asm):00004         ; ---------------------------------------------------------------------------
                      (         clip.asm):00005         
                      (         clip.asm):00006         ; ---------------------------------------------------------------------------
                      (         clip.asm):00007         ; T_PLOTC - plot a pixel if it is on screen
                      (         clip.asm):00008         ;   Entry: A = x, B = y (signed), DP = $00
                      (         clip.asm):00009         ;   Exit:  all registers preserved
                      (         clip.asm):00010         ;   A negative signed value is above XMAX/YMAX when compared unsigned, so
                      (         clip.asm):00011         ;   one unsigned compare per axis rejects both sides.
                      (         clip.asm):00012         ; ---------------------------------------------------------------------------
137F 814D             (         clip.asm):00013         T_PLOTC         CMPA    #XMAX
1381 2207             (         clip.asm):00014                         BHI     PC_X
1383 C147             (         clip.asm):00015                         CMPB    #YMAX
1385 2203             (         clip.asm):00016                         BHI     PC_X
1387 16FDE6           (         clip.asm):00017                         LBRA    T_PLOT          ; tail call
138A 39               (         clip.asm):00018         PC_X            RTS
                      (         clip.asm):00019         
                      (         clip.asm):00020         ; ---------------------------------------------------------------------------
                      (         clip.asm):00021         ; T_LINEC - draw the visible part of a line (Cohen-Sutherland)
                      (         clip.asm):00022         ;   Entry: A = x0, B = y0, X = x1 (high byte) : y1 (low byte), all signed
                      (         clip.asm):00023         ;          DP = $00
                      (         clip.asm):00024         ;   Exit:  all registers preserved
                      (         clip.asm):00025         ;
                      (         clip.asm):00026         ;   Each endpoint gets an outcode (bit 0 left, 1 right, 2 top, 3 bottom).
                      (         clip.asm):00027         ;   Both zero: draw. Common bit: entirely off one side, nothing to draw.
                      (         clip.asm):00028         ;   Otherwise move an outside endpoint onto the edge it is beyond, and
                      (         clip.asm):00029         ;   repeat. The intersection always interpolates between the two current
                      (         clip.asm):00030         ;   endpoints, so a point never moves back outside an edge already
                      (         clip.asm):00031         ;   satisfied, and the loop ends after at most four moves per endpoint.
                      (         clip.asm):00032         ;   The trimmed line is drawn by T_LINE.
                      (         clip.asm):00033         ; ---------------------------------------------------------------------------
138B 3476             (         clip.asm):00034         T_LINEC         PSHS    D,X,Y,U
138D DD06             (         clip.asm):00035                         STD     <W_X0
138F 9F08             (         clip.asm):00036                         STX     <W_X1
1391 DC06             (         clip.asm):00037         LC_LOOP         LDD     <W_X0
1393 8D2D             (         clip.asm):00038                         BSR     OUTCODE
1395 970D             (         clip.asm):00039                         STA     <W_C0
1397 DC08             (         clip.asm):00040                         LDD     <W_X1
1399 8D27             (         clip.asm):00041                         BSR     OUTCODE
139B 970E             (         clip.asm):00042                         STA     <W_C1
139D 9A0D             (         clip.asm):00043                         ORA     <W_C0
139F 2718             (         clip.asm):00044                         BEQ     LC_DRAW         ; both inside
13A1 960D             (         clip.asm):00045                         LDA     <W_C0
13A3 940E             (         clip.asm):00046                         ANDA    <W_C1
13A5 2619             (         clip.asm):00047                         BNE     LC_EXIT         ; both beyond the same edge
13A7 960D             (         clip.asm):00048                         LDA     <W_C0
13A9 2706             (         clip.asm):00049                         BEQ     LC_P1
13AB 8D36             (         clip.asm):00050                         BSR     LC_CLIP         ; move the start point
13AD DD06             (         clip.asm):00051                         STD     <W_X0
13AF 20E0             (         clip.asm):00052                         BRA     LC_LOOP
13B1 960E             (         clip.asm):00053         LC_P1           LDA     <W_C1
13B3 8D2E             (         clip.asm):00054                         BSR     LC_CLIP         ; move the end point
13B5 DD08             (         clip.asm):00055                         STD     <W_X1
13B7 20D8             (         clip.asm):00056                         BRA     LC_LOOP
13B9 DC06             (         clip.asm):00057         LC_DRAW         LDD     <W_X0
13BB 9E08             (         clip.asm):00058                         LDX     <W_X1
13BD 17FDD6           (         clip.asm):00059                         LBSR    T_LINE
13C0 35F6             (         clip.asm):00060         LC_EXIT         PULS    D,X,Y,U,PC
                      (         clip.asm):00061         
                      (         clip.asm):00062         ; ---------------------------------------------------------------------------
                      (         clip.asm):00063         ; OUTCODE - Entry: A = x, B = y (signed)   Exit: A = outcode, B corrupted
                      (         clip.asm):00064         ; ---------------------------------------------------------------------------
13C2 3404             (         clip.asm):00065         OUTCODE         PSHS    B
13C4 5F               (         clip.asm):00066                         CLRB
13C5 4D               (         clip.asm):00067                         TSTA
13C6 2A04             (         clip.asm):00068                         BPL     OC_1
13C8 CA01             (         clip.asm):00069                         ORB     #1              ; left
13CA 2006             (         clip.asm):00070                         BRA     OC_2
13CC 814D             (         clip.asm):00071         OC_1            CMPA    #XMAX
13CE 2302             (         clip.asm):00072                         BLS     OC_2
13D0 CA02             (         clip.asm):00073                         ORB     #2              ; right
13D2 A6E0             (         clip.asm):00074         OC_2            LDA     ,S+             ; y
13D4 2A04             (         clip.asm):00075                         BPL     OC_3
13D6 CA04             (         clip.asm):00076                         ORB     #4              ; top
13D8 2006             (         clip.asm):00077                         BRA     OC_4
13DA 8147             (         clip.asm):00078         OC_3            CMPA    #YMAX
13DC 2302             (         clip.asm):00079                         BLS     OC_4
13DE CA08             (         clip.asm):00080                         ORB     #8              ; bottom
13E0 1F98             (         clip.asm):00081         OC_4            TFR     B,A
13E2 39               (         clip.asm):00082                         RTS
                      (         clip.asm):00083         
