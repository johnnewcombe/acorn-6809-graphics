                      (      src/tgl.asm):00092         ; Modules
                      (      src/tgl.asm):00093         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00094                         INCLUDE "init.asm"
                      (         init.asm):00001         ; ---------------------------------------------------------------------------
                      (         init.asm):00002         ; T_INIT - initialise the library
                      (         init.asm):00003         ;   Resets the 6845 display start address (R12/R13) to zero so the visible
                      (         init.asm):00004         ;   screen begins at VDU_BASE. The monitor and FLEX VDU drivers scroll in
                      (         init.asm):00005         ;   hardware, which can leave the start address anywhere in the 1K.
                      (         init.asm):00006         ;   Hides the hardware cursor (R10 = $20, the "no cursor" mode bits).
                      (         init.asm):00007         ;   Clears the status row (row 24) and sets every row's colour to white.
                      (         init.asm):00008         ;   Sets the off-screen buffer to the memory immediately after the library
                      (         init.asm):00009         ;   (BUFSIZE bytes must be free there) and the plot mode to MODE_SET.
                      (         init.asm):00010         ;   Entry: DP = $00            Exit: all registers preserved
                      (         init.asm):00011         ; ---------------------------------------------------------------------------
1051 3416             (         init.asm):00012         T_INIT          PSHS    D,X
1053 5F               (         init.asm):00013                         CLRB
1054 860C             (         init.asm):00014                         LDA     #12             ; R12 - start address high
1056 B7E800           (         init.asm):00015                         STA     CRTC_ADDR
1059 F7E801           (         init.asm):00016                         STB     CRTC_DATA
105C 860D             (         init.asm):00017                         LDA     #13             ; R13 - start address low
105E B7E800           (         init.asm):00018                         STA     CRTC_ADDR
1061 F7E801           (         init.asm):00019                         STB     CRTC_DATA
1064 860A             (         init.asm):00020                         LDA     #10             ; R10 - cursor start / blink mode
1066 B7E800           (         init.asm):00021                         STA     CRTC_ADDR
1069 8620             (         init.asm):00022                         LDA     #$20            ; bits 6-5 = 01: no cursor
106B B7E801           (         init.asm):00023                         STA     CRTC_DATA
106E 1707FE           (         init.asm):00024                         LBSR    T_TCLR          ; blank the status row
1071 0F5B             (         init.asm):00025                         CLR     <P_RUN          ; no frame period running yet (the
                      (         init.asm):00026                                                 ;  timer itself is not touched)
1073 860F             (         init.asm):00027                         LDA     #$0F            ; fills are solid until TGL_SETPAT
1075 975D             (         init.asm):00028                         STA     <U_PAT
1077 975C             (         init.asm):00029                         STA     <H_PAT
1079 8603             (         init.asm):00030                         LDA     #%011           ; default dashes: on, on, off
107B C603             (         init.asm):00031                         LDB     #3
107D 8E0000           (         init.asm):00032                         LDX     #0
1080 171058           (         init.asm):00033                         LBSR    T_SETDASH
1083 8E0043           (         init.asm):00034                         LDX     #ROWCOL         ; every row white
1086 8697             (         init.asm):00035                         LDA     #GFX_WHITE
1088 A780             (         init.asm):00036         IN_COL          STA     ,X+
108A 8C005B           (         init.asm):00037                         CMPX    #ROWCOL+ROWS
108D 25F9             (         init.asm):00038                         BLO     IN_COL
108F 308D1421         (         init.asm):00039                         LEAX    TGL_END,PCR
1093 9F00             (         init.asm):00040                         STX     <W_BUF
1095 8600             (         init.asm):00041                         LDA     #MODE_SET
1097 1700B9           (         init.asm):00042                         LBSR    T_SETMODE       ; patches T_PLOT for MODE_SET
109A 3596             (         init.asm):00043                         PULS    D,X,PC
                      (         init.asm):00044         
                      (         init.asm):00045         ; ---------------------------------------------------------------------------
                      (         init.asm):00046         ; T_SETBUF - use a caller-supplied off-screen buffer
                      (         init.asm):00047         ;   Entry: X = buffer address (BUFSIZE bytes), DP = $00
                      (         init.asm):00048         ;   Exit:  all registers preserved
                      (         init.asm):00049         ; ---------------------------------------------------------------------------
109C 9F00             (         init.asm):00050         T_SETBUF        STX     <W_BUF
109E 39               (         init.asm):00051                         RTS
                      (      src/tgl.asm):00095                         INCLUDE "cls.asm"
                      (          cls.asm):00001         ; ---------------------------------------------------------------------------
                      (          cls.asm):00002         ; T_CLS - clear the off-screen buffer
                      (          cls.asm):00003         ;   Each row: its graphics colour code in column 0 (white unless changed
                      (          cls.asm):00004         ;   with TGL_COLOUR), blank sixel cells in 1-39. In a separated build,
                      (          cls.asm):00005         ;   column 1 holds the separated-graphics code instead.
                      (          cls.asm):00006         ;   Fills the whole buffer with blank cells using PSHU from three registers
                      (          cls.asm):00007         ;   (six bytes per instruction, working down from the end), then writes the
                      (          cls.asm):00008         ;   colour code into column 0 of each row. Roughly 2,100 cycles, about a
                      (          cls.asm):00009         ;   fifth of a simple byte loop.
                      (          cls.asm):00010         ;   Entry: DP = $00            Exit: all registers preserved
                      (          cls.asm):00011         ; ---------------------------------------------------------------------------
109F 3476             (          cls.asm):00012         T_CLS           PSHS    D,X,Y,U
10A1 8614             (          cls.asm):00013                         LDA     #BUFSIZE/48     ; 20 iterations x 48 bytes
10A3 9704             (          cls.asm):00014                         STA     <W_COUNT
10A5 DE00             (          cls.asm):00015                         LDU     <W_BUF
10A7 33C903C0         (          cls.asm):00016                         LEAU    BUFSIZE,U       ; PSHU fills downwards from the end
10AB CC2020           (          cls.asm):00017                         LDD     #SIXEL_BLANK*$101
10AE 1F01             (          cls.asm):00018                         TFR     D,X
10B0 1F02             (          cls.asm):00019                         TFR     D,Y
10B2                  (          cls.asm):00020         CLS_FILL
10B2 3636             (          cls.asm):00021                         PSHU    D,X,Y
10B4 3636             (          cls.asm):00022                         PSHU    D,X,Y
10B6 3636             (          cls.asm):00023                         PSHU    D,X,Y
10B8 3636             (          cls.asm):00024                         PSHU    D,X,Y
10BA 3636             (          cls.asm):00025                         PSHU    D,X,Y
10BC 3636             (          cls.asm):00026                         PSHU    D,X,Y
10BE 3636             (          cls.asm):00027                         PSHU    D,X,Y
10C0 3636             (          cls.asm):00028                         PSHU    D,X,Y
10C2 0A04             (          cls.asm):00029                         DEC     <W_COUNT
10C4 26EC             (          cls.asm):00030                         BNE     CLS_FILL
                      (          cls.asm):00031                                                 ; U = buffer start: put each row's
                      (          cls.asm):00032                                                 ;  colour code in column 0
10C6 9643             (          cls.asm):00033                         LDA     <ROWCOL+0
10C8 A7C4             (          cls.asm):00034                         STA     0*COLS,U
10CA 9644             (          cls.asm):00035                         LDA     <ROWCOL+1
10CC A7C828           (          cls.asm):00036                         STA     1*COLS,U
10CF 9645             (          cls.asm):00037                         LDA     <ROWCOL+2
10D1 A7C850           (          cls.asm):00038                         STA     2*COLS,U
10D4 9646             (          cls.asm):00039                         LDA     <ROWCOL+3
10D6 A7C878           (          cls.asm):00040                         STA     3*COLS,U
10D9 9647             (          cls.asm):00041                         LDA     <ROWCOL+4
10DB A7C900A0         (          cls.asm):00042                         STA     4*COLS,U
10DF 9648             (          cls.asm):00043                         LDA     <ROWCOL+5
10E1 A7C900C8         (          cls.asm):00044                         STA     5*COLS,U
10E5 9649             (          cls.asm):00045                         LDA     <ROWCOL+6
10E7 A7C900F0         (          cls.asm):00046                         STA     6*COLS,U
10EB 964A             (          cls.asm):00047                         LDA     <ROWCOL+7
10ED A7C90118         (          cls.asm):00048                         STA     7*COLS,U
10F1 964B             (          cls.asm):00049                         LDA     <ROWCOL+8
10F3 A7C90140         (          cls.asm):00050                         STA     8*COLS,U
10F7 964C             (          cls.asm):00051                         LDA     <ROWCOL+9
10F9 A7C90168         (          cls.asm):00052                         STA     9*COLS,U
10FD 964D             (          cls.asm):00053                         LDA     <ROWCOL+10
10FF A7C90190         (          cls.asm):00054                         STA     10*COLS,U
1103 964E             (          cls.asm):00055                         LDA     <ROWCOL+11
1105 A7C901B8         (          cls.asm):00056                         STA     11*COLS,U
1109 964F             (          cls.asm):00057                         LDA     <ROWCOL+12
110B A7C901E0         (          cls.asm):00058                         STA     12*COLS,U
110F 9650             (          cls.asm):00059                         LDA     <ROWCOL+13
1111 A7C90208         (          cls.asm):00060                         STA     13*COLS,U
1115 9651             (          cls.asm):00061                         LDA     <ROWCOL+14
1117 A7C90230         (          cls.asm):00062                         STA     14*COLS,U
111B 9652             (          cls.asm):00063                         LDA     <ROWCOL+15
111D A7C90258         (          cls.asm):00064                         STA     15*COLS,U
1121 9653             (          cls.asm):00065                         LDA     <ROWCOL+16
1123 A7C90280         (          cls.asm):00066                         STA     16*COLS,U
1127 9654             (          cls.asm):00067                         LDA     <ROWCOL+17
1129 A7C902A8         (          cls.asm):00068                         STA     17*COLS,U
112D 9655             (          cls.asm):00069                         LDA     <ROWCOL+18
112F A7C902D0         (          cls.asm):00070                         STA     18*COLS,U
1133 9656             (          cls.asm):00071                         LDA     <ROWCOL+19
1135 A7C902F8         (          cls.asm):00072                         STA     19*COLS,U
1139 9657             (          cls.asm):00073                         LDA     <ROWCOL+20
113B A7C90320         (          cls.asm):00074                         STA     20*COLS,U
113F 9658             (          cls.asm):00075                         LDA     <ROWCOL+21
1141 A7C90348         (          cls.asm):00076                         STA     21*COLS,U
1145 9659             (          cls.asm):00077                         LDA     <ROWCOL+22
1147 A7C90370         (          cls.asm):00078                         STA     22*COLS,U
114B 965A             (          cls.asm):00079                         LDA     <ROWCOL+23
114D A7C90398         (          cls.asm):00080                         STA     23*COLS,U
                      (          cls.asm):00081                         IFDEF   TGL_SEPARATED   ; and the separated code in column 1
                      (          cls.asm):00082                         LDA     #GFX_SEP
                      (          cls.asm):00083                         STA     0*COLS+1,U
                      (          cls.asm):00084                         STA     1*COLS+1,U
                      (          cls.asm):00085                         STA     2*COLS+1,U
                      (          cls.asm):00086                         STA     3*COLS+1,U
                      (          cls.asm):00087                         STA     4*COLS+1,U
                      (          cls.asm):00088                         STA     5*COLS+1,U
                      (          cls.asm):00089                         STA     6*COLS+1,U
                      (          cls.asm):00090                         STA     7*COLS+1,U
                      (          cls.asm):00091                         STA     8*COLS+1,U
                      (          cls.asm):00092                         STA     9*COLS+1,U
                      (          cls.asm):00093                         STA     10*COLS+1,U
                      (          cls.asm):00094                         STA     11*COLS+1,U
                      (          cls.asm):00095                         STA     12*COLS+1,U
                      (          cls.asm):00096                         STA     13*COLS+1,U
                      (          cls.asm):00097                         STA     14*COLS+1,U
                      (          cls.asm):00098                         STA     15*COLS+1,U
                      (          cls.asm):00099                         STA     16*COLS+1,U
                      (          cls.asm):00100                         STA     17*COLS+1,U
                      (          cls.asm):00101                         STA     18*COLS+1,U
                      (          cls.asm):00102                         STA     19*COLS+1,U
                      (          cls.asm):00103                         STA     20*COLS+1,U
                      (          cls.asm):00104                         STA     21*COLS+1,U
                      (          cls.asm):00105                         STA     22*COLS+1,U
                      (          cls.asm):00106                         STA     23*COLS+1,U
                      (          cls.asm):00107                         ENDC
1151 35F6             (          cls.asm):00108                         PULS    D,X,Y,U,PC
                      (      src/tgl.asm):00096                         INCLUDE "plot.asm"
                      (         plot.asm):00001         ; ---------------------------------------------------------------------------
                      (         plot.asm):00002         ; T_SETMODE - select plot mode
                      (         plot.asm):00003         ;   Patches the pre-op and operation bytes in T_PLOT, the four T_LINE
                      (         plot.asm):00004         ;   loops and the rectangle fill, so pixel writes never test the mode.
                      (         plot.asm):00005         ;   Out-of-range modes are ignored.
                      (         plot.asm):00006         ;   Entry: A = MODE_SET, MODE_CLEAR or MODE_XOR, DP = $00
                      (         plot.asm):00007         ;   Exit:  all registers preserved
                      (         plot.asm):00008         ; ---------------------------------------------------------------------------
1153 8102             (         plot.asm):00009         T_SETMODE       CMPA    #MODE_XOR
1155 223F             (         plot.asm):00010                         BHI     SETM_X
1157 3416             (         plot.asm):00011                         PSHS    D,X
1159 9705             (         plot.asm):00012                         STA     <W_MODE
115B 308D131C         (         plot.asm):00013                         LEAX    MODETAB,PCR
115F 48               (         plot.asm):00014                         ASLA
1160 EC86             (         plot.asm):00015                         LDD     A,X             ; A = pre-op byte, B = opcode
1162 A78D0050         (         plot.asm):00016                         STA     PLOT_PRE,PCR
1166 E78D004D         (         plot.asm):00017                         STB     PLOT_OP,PCR
116A A78D0102         (         plot.asm):00018                         STA     LXD_PRE,PCR
116E E78D00FF         (         plot.asm):00019                         STB     LXD_OP,PCR
1172 A78D0130         (         plot.asm):00020                         STA     LXU_PRE,PCR
1176 E78D012D         (         plot.asm):00021                         STB     LXU_OP,PCR
117A A78D015E         (         plot.asm):00022                         STA     LYR_PRE,PCR
117E E78D015B         (         plot.asm):00023                         STB     LYR_OP,PCR
1182 A78D018C         (         plot.asm):00024                         STA     LYL_PRE,PCR
1186 E78D0189         (         plot.asm):00025                         STB     LYL_OP,PCR
118A A78D0493         (         plot.asm):00026                         STA     FS_PRE,PCR      ; rectangle fill: the same pre-op,
118E C010             (         plot.asm):00027                         SUBB    #$10            ;  but its operation uses direct
1190 E78D0492         (         plot.asm):00028                         STB     FS_OP,PCR       ;  addressing (opcode $10 lower)
1194 3516             (         plot.asm):00029                         PULS    D,X
1196 39               (         plot.asm):00030         SETM_X          RTS
                      (         plot.asm):00031         
                      (         plot.asm):00032         ; ---------------------------------------------------------------------------
                      (         plot.asm):00033         ; T_PLOT - plot one sixel pixel in the off-screen buffer
                      (         plot.asm):00034         ;   Entry: A = x (0-77), B = y (0-71), DP = $00
                      (         plot.asm):00035         ;   Exit:  all registers preserved
                      (         plot.asm):00036         ;   No range checking in a normal build - out-of-range coordinates write
                      (         plot.asm):00037         ;   outside the buffer. A TGL_SAFE build ignores off-screen points instead.
                      (         plot.asm):00038         ;
                      (         plot.asm):00039         ;   cell = buffer + (y/3)*40 + 1 + x/2,  mask from (x&1, y%3)
                      (         plot.asm):00040         ; ---------------------------------------------------------------------------
1197                  (         plot.asm):00041         T_PLOT
                      (         plot.asm):00042                         IFDEF   TGL_SAFE
                      (         plot.asm):00043                         CMPA    #XMAX           ; off screen: do nothing
                      (         plot.asm):00044                         BHI     PLOT_RTS
                      (         plot.asm):00045                         CMPB    #YMAX
                      (         plot.asm):00046                         BHI     PLOT_RTS
                      (         plot.asm):00047                         ENDC
1197 3436             (         plot.asm):00048                         PSHS    D,X,Y
1199 318D11BE         (         plot.asm):00049                         LEAY    PTAB,PCR
119D 4F               (         plot.asm):00050                         CLRA                    ; D = y
119E 58               (         plot.asm):00051                         ASLB                    ; D = y*4 (entries are 4 bytes)
119F 49               (         plot.asm):00052                         ROLA
11A0 58               (         plot.asm):00053                         ASLB
11A1 49               (         plot.asm):00054                         ROLA
11A2 31AB             (         plot.asm):00055                         LEAY    D,Y             ; Y -> PTAB entry for this y
11A4 ECA4             (         plot.asm):00056                         LDD     ,Y              ; offset of column 1 of the cell row
11A6 D300             (         plot.asm):00057                         ADDD    <W_BUF
11A8 1F01             (         plot.asm):00058                         TFR     D,X
11AA E6E4             (         plot.asm):00059                         LDB     ,S              ; x (caller's A, saved on the stack)
11AC 54               (         plot.asm):00060                         LSRB                    ; B = x/2, C = x&1
11AD 3A               (         plot.asm):00061                         ABX                     ; X -> cell (ABX leaves C alone)
11AE 2504             (         plot.asm):00062                         BCS     PLOT_R
11B0 A622             (         plot.asm):00063                         LDA     2,Y             ; left pixel mask
11B2 2002             (         plot.asm):00064                         BRA     PLOT_PRE
11B4 A623             (         plot.asm):00065         PLOT_R          LDA     3,Y             ; right pixel mask
11B6 12               (         plot.asm):00066         PLOT_PRE        NOP                     ; patched: NOP or COMA
11B7 AA84             (         plot.asm):00067         PLOT_OP         ORA     ,X              ; patched: ORA / ANDA / EORA ,X
11B9 A784             (         plot.asm):00068                         STA     ,X
11BB 35B6             (         plot.asm):00069                         PULS    D,X,Y,PC
                      (         plot.asm):00070                         IFDEF   TGL_SAFE
11BD                  (         plot.asm):00071         PLOT_RTS        RTS
                      (         plot.asm):00072                         ENDC
                      (      src/tgl.asm):00097                         INCLUDE "line.asm"
                      (         line.asm):00001         ; ---------------------------------------------------------------------------
                      (         line.asm):00002         ; T_LINE - draw a line in the off-screen buffer (Bresenham)
                      (         line.asm):00003         ;   Entry: A = x0, B = y0, X = x1 (high byte) : y1 (low byte), DP = $00
                      (         line.asm):00004         ;          x 0-77, y 0-71. Uses the current plot mode.
                      (         line.asm):00005         ;          No range checking in a normal build. A TGL_SAFE build draws
                      (         line.asm):00006         ;          nothing if either endpoint is off screen.
                      (         line.asm):00007         ;   Exit:  all registers preserved
                      (         line.asm):00008         ;
                      (         line.asm):00009         ;   Rather than calling the plot routine per pixel, the loop tracks the
                      (         line.asm):00010         ;   cell pointer (X) and an internal pixel mask (B) and steps them directly.
                      (         line.asm):00011         ;   Internal masks put the bottom-right pixel in bit 5, so every step is a
                      (         line.asm):00012         ;   plain shift:
                      (         line.asm):00013         ;
                      (         line.asm):00014         ;        left right                 x step: shift 1   (cross cell: X +/- 1)
                      (         line.asm):00015         ;   top     1    2                  y step: shift 2   (cross row:  X +/- 40)
                      (         line.asm):00016         ;   middle  4    8
                      (         line.asm):00017         ;   bottom 16   32 (screen bit 6)   MASKREAL converts internal -> screen
                      (         line.asm):00018         ;
                      (         line.asm):00019         ;   Endpoints are swapped so the major axis always runs positive, leaving
                      (         line.asm):00020         ;   four loops: x-major with y up/down, y-major with x left/right. The
                      (         line.asm):00021         ;   chosen loop's |dx| and |dy| are patched into it as immediates, and
                      (         line.asm):00022         ;   T_SETMODE patches each loop's pixel operation.
                      (         line.asm):00023         ;   Error term stays within -77..+77, so it fits a signed byte.
                      (         line.asm):00024         ; ---------------------------------------------------------------------------
                      (         line.asm):00025         
                      (         line.asm):00026         ; Write the pixel at X with internal mask B (U -> MASKREAL)
11BD                  (         line.asm):00027         LN_PIXEL        MACRO
                      (         line.asm):00028                         LDA     B,U             ; screen mask
11BD                  (         line.asm):00029         \1_PRE          NOP                     ; patched by T_SETMODE
11BD                  (         line.asm):00030         \1_OP           ORA     ,X              ; patched by T_SETMODE
                      (         line.asm):00031                         STA     ,X
                      (         line.asm):00032                         ENDM
                      (         line.asm):00033         
                      (         line.asm):00034         ; Step one pixel right / left / down / up
11BD                  (         line.asm):00035         LN_RIGHT        MACRO
                      (         line.asm):00036                         BITB    #$15            ; left pixel?
                      (         line.asm):00037                         BEQ     \1_RN
