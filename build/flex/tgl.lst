1400 D613             (         clip.asm):00104                         LDB     <I_E
1402 39               (         clip.asm):00105                         RTS
1403 8502             (         clip.asm):00106         LCC_2           BITA    #2
1405 2704             (         clip.asm):00107                         BEQ     LCC_3
1407 C64D             (         clip.asm):00108                         LDB     #XMAX           ; right edge
1409 2001             (         clip.asm):00109                         BRA     LCC_V
140B 5F               (         clip.asm):00110         LCC_3           CLRB                    ; left edge, x = 0
140C D713             (         clip.asm):00111         LCC_V           STB     <I_E            ; vertical edge: solve for y
140E DC06             (         clip.asm):00112                         LDD     <W_X0
1410 9711             (         clip.asm):00113                         STA     <I_V0
1412 D70F             (         clip.asm):00114                         STB     <I_U0
1414 DC08             (         clip.asm):00115                         LDD     <W_X1
1416 9712             (         clip.asm):00116                         STA     <I_V1
1418 D710             (         clip.asm):00117                         STB     <I_U1
141A 8D05             (         clip.asm):00118                         BSR     ISECT
141C 1F89             (         clip.asm):00119                         TFR     A,B
141E 9613             (         clip.asm):00120                         LDA     <I_E
