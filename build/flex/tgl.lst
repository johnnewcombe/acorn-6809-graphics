158C 270B             (         rect.asm):00227                         BEQ     RF_NEXT
158E 9E28             (         rect.asm):00228                         LDX     <F_ROW
1590 D61D             (         rect.asm):00229                         LDB     <F_CX1
1592 3A               (         rect.asm):00230                         ABX
