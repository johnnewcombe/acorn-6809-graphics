                      (         rect.asm):00208         
156A 0D1E             (         rect.asm):00209         RF_MULTI        TST     <F_PL           ; partial first cell: right pixels
156C 270B             (         rect.asm):00210                         BEQ     RF_10
156E 9E28             (         rect.asm):00211                         LDX     <F_ROW
1570 D61C             (         rect.asm):00212                         LDB     <F_CX0
1572 3A               (         rect.asm):00213                         ABX
1573 9626             (         rect.asm):00214                         LDA     <F_MR
1575 C601             (         rect.asm):00215                         LDB     #1
1577 8D32             (         rect.asm):00216                         BSR     FILLSEG
