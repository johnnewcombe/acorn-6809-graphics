                      (      polygon.asm):00476         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00477         ; CH_SETUP - start the walker at U on the edge leaving corner CH_CUR in
                      (      polygon.asm):00478         ;   direction CH_DIR, skipping flat edges. For an edge from (xc,yc) down to
                      (      polygon.asm):00479         ;   (xn,yn): dy = yn - yc, and the crossing moves by dx/dy = qd + rd/dy
                      (      polygon.asm):00480         ;   per row, where qd and rd come from one division (rounded down, so rd
                      (      polygon.asm):00481         ;   is never negative).
                      (      polygon.asm):00482         ; ---------------------------------------------------------------------------
1BE4 9660             (      polygon.asm):00483         CH_SETUP        LDA     <P_N            ; guard: never skip more than n flat
1BE6 9713             (      polygon.asm):00484                         STA     <P_CNT          ;  edges
1BE8 A6C4             (      polygon.asm):00485         CS_LOOP         LDA     CH_CUR,U        ; next corner = cur + dir, wrapping
1BEA AB4A             (      polygon.asm):00486                         ADDA    CH_DIR,U        ;  round the list
1BEC 2A02             (      polygon.asm):00487                         BPL     CS_1
1BEE 9B60             (      polygon.asm):00488                         ADDA    <P_N
1BF0 9160             (      polygon.asm):00489         CS_1            CMPA    <P_N
1BF2 2502             (      polygon.asm):00490                         BLO     CS_2
1BF4 9060             (      polygon.asm):00491                         SUBA    <P_N
1BF6 A741             (      polygon.asm):00492         CS_2            STA     CH_NXT,U
1BF8 E641             (      polygon.asm):00493                         LDB     CH_NXT,U        ; fetch both corners
1BFA 8DD0             (      polygon.asm):00494                         BSR     VTX
1BFC 9710             (      polygon.asm):00495                         STA     <P_XN
1BFE D712             (      polygon.asm):00496                         STB     <P_YN
1C00 E6C4             (      polygon.asm):00497                         LDB     CH_CUR,U
1C02 8DC8             (      polygon.asm):00498                         BSR     VTX
1C04 970F             (      polygon.asm):00499                         STA     <P_XC
1C06 D711             (      polygon.asm):00500                         STB     <P_YC
1C08 D112             (      polygon.asm):00501                         CMPB    <P_YN           ; does the edge go down?
1C0A 2D21             (      polygon.asm):00502                         BLT     CS_DOWN
1C0C 2E08             (      polygon.asm):00503                         BGT     CS_STOP         ; going up: no more edges this side
1C0E A641             (      polygon.asm):00504                         LDA     CH_NXT,U        ; flat: skip it
1C10 A7C4             (      polygon.asm):00505                         STA     CH_CUR,U
1C12 0A13             (      polygon.asm):00506                         DEC     <P_CNT
1C14 26D2             (      polygon.asm):00507                         BNE     CS_LOOP
1C16 867F             (      polygon.asm):00508         CS_STOP         LDA     #127            ; no edge: freeze this walker, so it
1C18 A742             (      polygon.asm):00509                         STA     CH_YB,U         ;  never moves on again
1C1A D60F             (      polygon.asm):00510                         LDB     <P_XC
1C1C 1D               (      polygon.asm):00511                         SEX
1C1D ED43             (      polygon.asm):00512                         STD     CH_Q,U
1C1F CC0000           (      polygon.asm):00513                         LDD     #0
1C22 ED45             (      polygon.asm):00514                         STD     CH_QD,U
1C24 A747             (      polygon.asm):00515                         STA     CH_R,U
1C26 A748             (      polygon.asm):00516                         STA     CH_RD,U
1C28 8601             (      polygon.asm):00517                         LDA     #1
1C2A A749             (      polygon.asm):00518                         STA     CH_DY,U
1C2C 39               (      polygon.asm):00519                         RTS
                      (      polygon.asm):00520         
1C2D 9612             (      polygon.asm):00521         CS_DOWN         LDA     <P_YN           ; end of the edge, and its height
1C2F A742             (      polygon.asm):00522                         STA     CH_YB,U
1C31 9011             (      polygon.asm):00523                         SUBA    <P_YC
1C33 A749             (      polygon.asm):00524                         STA     CH_DY,U         ; dy = 1..255
1C35 9716             (      polygon.asm):00525                         STA     <I_DV           ;  (the divisor, for DIV8)
1C37 D60F             (      polygon.asm):00526                         LDB     <P_XC           ; crossing starts at xc exactly
1C39 1D               (      polygon.asm):00527                         SEX
1C3A ED43             (      polygon.asm):00528                         STD     CH_Q,U
1C3C 6F47             (      polygon.asm):00529                         CLR     CH_R,U
1C3E D610             (      polygon.asm):00530                         LDB     <P_XN           ; D = dx = xn - xc (-255..255)
1C40 1D               (      polygon.asm):00531                         SEX
1C41 A343             (      polygon.asm):00532                         SUBD    CH_Q,U
1C43 2B09             (      polygon.asm):00533                         BMI     CS_NEG
1C45 17F838           (      polygon.asm):00534                         LBSR    DIV8            ; dx >= 0: qd = dx / dy, rd = dx mod dy
1C48 A748             (      polygon.asm):00535                         STA     CH_RD,U         ;  (B = quotient, A = remainder)
1C4A 4F               (      polygon.asm):00536                         CLRA
1C4B ED45             (      polygon.asm):00537                         STD     CH_QD,U
1C4D 39               (      polygon.asm):00538                         RTS
1C4E 43               (      polygon.asm):00539         CS_NEG          COMA                    ; dx < 0: divide |dx| ...
1C4F 53               (      polygon.asm):00540                         COMB
1C50 C30001           (      polygon.asm):00541                         ADDD    #1
1C53 17F82A           (      polygon.asm):00542                         LBSR    DIV8            ; B = |dx| / dy, A = remainder
1C56 4D               (      polygon.asm):00543                         TSTA
1C57 270B             (      polygon.asm):00544                         BEQ     CS_EXACT
1C59 3402             (      polygon.asm):00545                         PSHS    A               ; ... and round down: qd = -(q+1),
1C5B A649             (      polygon.asm):00546                         LDA     CH_DY,U         ;  rd = dy - remainder
1C5D A0E0             (      polygon.asm):00547                         SUBA    ,S+
1C5F A748             (      polygon.asm):00548                         STA     CH_RD,U
1C61 5C               (      polygon.asm):00549                         INCB                    ; (q + 1 is at most 128 here)
1C62 2002             (      polygon.asm):00550                         BRA     CS_NEGQ
1C64 6F48             (      polygon.asm):00551         CS_EXACT        CLR     CH_RD,U         ; divides exactly: qd = -q, rd = 0
1C66 4F               (      polygon.asm):00552         CS_NEGQ         CLRA                    ; qd = -B
1C67 43               (      polygon.asm):00553                         COMA
1C68 53               (      polygon.asm):00554                         COMB
1C69 C30001           (      polygon.asm):00555                         ADDD    #1
1C6C ED45             (      polygon.asm):00556                         STD     CH_QD,U
1C6E 39               (      polygon.asm):00557                         RTS
                      (      polygon.asm):00558         
                      (      polygon.asm):00559         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00560         ; CH_CEIL - the walker's crossing, rounded up: B = q + (r > 0 ? 1 : 0)
                      (      polygon.asm):00561         ;   (A corrupted; the value always fits a signed byte)
                      (      polygon.asm):00562         ; ---------------------------------------------------------------------------
1C6F EC43             (      polygon.asm):00563         CH_CEIL         LDD     CH_Q,U
