10BA A7C900C8         (          cls.asm):00043                         STA     5*COLS,U
10BE 9649             (          cls.asm):00044                         LDA     <ROWCOL+6
10C0 A7C900F0         (          cls.asm):00045                         STA     6*COLS,U
10C4 964A             (          cls.asm):00046                         LDA     <ROWCOL+7
10C6 A7C90118         (          cls.asm):00047                         STA     7*COLS,U
10CA 964B             (          cls.asm):00048                         LDA     <ROWCOL+8
10CC A7C90140         (          cls.asm):00049                         STA     8*COLS,U
10D0 964C             (          cls.asm):00050                         LDA     <ROWCOL+9
10D2 A7C90168         (          cls.asm):00051                         STA     9*COLS,U
10D6 964D             (          cls.asm):00052                         LDA     <ROWCOL+10
10D8 A7C90190         (          cls.asm):00053                         STA     10*COLS,U
