                      (      src/tgl.asm):00085         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00086         ; Modules
                      (      src/tgl.asm):00087         ; ---------------------------------------------------------------------------
                      (      src/tgl.asm):00088                         INCLUDE "init.asm"
                      (         init.asm):00001         ; ---------------------------------------------------------------------------
                      (         init.asm):00002         ; T_INIT - initialise the library
                      (         init.asm):00003         ;   Resets the 6845 display start address (R12/R13) to zero so the visible
                      (         init.asm):00004         ;   screen begins at VDU_BASE. The monitor and FLEX VDU drivers scroll in
                      (         init.asm):00005         ;   hardware, which can leave the start address anywhere in the 1K.
                      (         init.asm):00006         ;   Hides the hardware cursor (R10 = $20, the "no cursor" mode bits).
                      (         init.asm):00007         ;   Clears the status row (row 24) and sets every row's colour to white.
                      (         init.asm):00008         ;   Sets the off-screen buffer to the memory immediately after the library
                      (         init.asm):00009         ;   (BUFSIZE bytes must be free there) and the plot mode to MODE_SET.
                      (         init.asm):00010         ;   Entry: DP = $00            Exit: all registers preserved
                      (         init.asm):00011         ; ---------------------------------------------------------------------------
1048 3416             (         init.asm):00012         T_INIT          PSHS    D,X
104A 5F               (         init.asm):00013                         CLRB
104B 860C             (         init.asm):00014                         LDA     #12             ; R12 - start address high
104D B7E800           (         init.asm):00015                         STA     CRTC_ADDR
1050 F7E801           (         init.asm):00016                         STB     CRTC_DATA
1053 860D             (         init.asm):00017                         LDA     #13             ; R13 - start address low
1055 B7E800           (         init.asm):00018                         STA     CRTC_ADDR
1058 F7E801           (         init.asm):00019                         STB     CRTC_DATA
105B 860A             (         init.asm):00020                         LDA     #10             ; R10 - cursor start / blink mode
105D B7E800           (         init.asm):00021                         STA     CRTC_ADDR
1060 8620             (         init.asm):00022                         LDA     #$20            ; bits 6-5 = 01: no cursor
1062 B7E801           (         init.asm):00023                         STA     CRTC_DATA
1065 1707F4           (         init.asm):00024                         LBSR    T_TCLR          ; blank the status row
1068 0F5B             (         init.asm):00025                         CLR     <P_RUN          ; no frame period running yet (the
                      (         init.asm):00026                                                 ;  timer itself is not touched)
106A 860F             (         init.asm):00027                         LDA     #$0F            ; fills are solid until TGL_SETPAT
106C 975D             (         init.asm):00028                         STA     <U_PAT
106E 975C             (         init.asm):00029                         STA     <H_PAT
1070 8E0043           (         init.asm):00030                         LDX     #ROWCOL         ; every row white
1073 8697             (         init.asm):00031                         LDA     #GFX_WHITE
1075 A780             (         init.asm):00032         IN_COL          STA     ,X+
1077 8C005B           (         init.asm):00033                         CMPX    #ROWCOL+ROWS
107A 25F9             (         init.asm):00034                         BLO     IN_COL
107C 308D11C2         (         init.asm):00035                         LEAX    TGL_END,PCR
1080 9F00             (         init.asm):00036                         STX     <W_BUF
1082 8600             (         init.asm):00037                         LDA     #MODE_SET
1084 1700B9           (         init.asm):00038                         LBSR    T_SETMODE       ; patches T_PLOT for MODE_SET
1087 3596             (         init.asm):00039                         PULS    D,X,PC
                      (         init.asm):00040         
                      (         init.asm):00041         ; ---------------------------------------------------------------------------
                      (         init.asm):00042         ; T_SETBUF - use a caller-supplied off-screen buffer
                      (         init.asm):00043         ;   Entry: X = buffer address (BUFSIZE bytes), DP = $00
                      (         init.asm):00044         ;   Exit:  all registers preserved
                      (         init.asm):00045         ; ---------------------------------------------------------------------------
1089 9F00             (         init.asm):00046         T_SETBUF        STX     <W_BUF
108B 39               (         init.asm):00047                         RTS
                      (      src/tgl.asm):00089                         INCLUDE "cls.asm"
                      (          cls.asm):00001         ; ---------------------------------------------------------------------------
                      (          cls.asm):00002         ; T_CLS - clear the off-screen buffer
                      (          cls.asm):00003         ;   Each row: its graphics colour code in column 0 (white unless changed
                      (          cls.asm):00004         ;   with TGL_COLOUR), blank sixel cells in 1-39.
                      (          cls.asm):00005         ;   Fills the whole buffer with blank cells using PSHU from three registers
                      (          cls.asm):00006         ;   (six bytes per instruction, working down from the end), then writes the
                      (          cls.asm):00007         ;   colour code into column 0 of each row. Roughly 2,100 cycles, about a
                      (          cls.asm):00008         ;   fifth of a simple byte loop.
                      (          cls.asm):00009         ;   Entry: DP = $00            Exit: all registers preserved
                      (          cls.asm):00010         ; ---------------------------------------------------------------------------
108C 3476             (          cls.asm):00011         T_CLS           PSHS    D,X,Y,U
108E 8614             (          cls.asm):00012                         LDA     #BUFSIZE/48     ; 20 iterations x 48 bytes
1090 9704             (          cls.asm):00013                         STA     <W_COUNT
1092 DE00             (          cls.asm):00014                         LDU     <W_BUF
1094 33C903C0         (          cls.asm):00015                         LEAU    BUFSIZE,U       ; PSHU fills downwards from the end
1098 CC2020           (          cls.asm):00016                         LDD     #SIXEL_BLANK*$101
109B 1F01             (          cls.asm):00017                         TFR     D,X
109D 1F02             (          cls.asm):00018                         TFR     D,Y
109F                  (          cls.asm):00019         CLS_FILL
109F 3636             (          cls.asm):00020                         PSHU    D,X,Y
10A1 3636             (          cls.asm):00021                         PSHU    D,X,Y
10A3 3636             (          cls.asm):00022                         PSHU    D,X,Y
10A5 3636             (          cls.asm):00023                         PSHU    D,X,Y
10A7 3636             (          cls.asm):00024                         PSHU    D,X,Y
10A9 3636             (          cls.asm):00025                         PSHU    D,X,Y
10AB 3636             (          cls.asm):00026                         PSHU    D,X,Y
10AD 3636             (          cls.asm):00027                         PSHU    D,X,Y
10AF 0A04             (          cls.asm):00028                         DEC     <W_COUNT
10B1 26EC             (          cls.asm):00029                         BNE     CLS_FILL
                      (          cls.asm):00030                                                 ; U = buffer start: put each row's
                      (          cls.asm):00031                                                 ;  colour code in column 0
10B3 9643             (          cls.asm):00032                         LDA     <ROWCOL+0
10B5 A7C4             (          cls.asm):00033                         STA     0*COLS,U
10B7 9644             (          cls.asm):00034                         LDA     <ROWCOL+1
10B9 A7C828           (          cls.asm):00035                         STA     1*COLS,U
10BC 9645             (          cls.asm):00036                         LDA     <ROWCOL+2
10BE A7C850           (          cls.asm):00037                         STA     2*COLS,U
10C1 9646             (          cls.asm):00038                         LDA     <ROWCOL+3
10C3 A7C878           (          cls.asm):00039                         STA     3*COLS,U
10C6 9647             (          cls.asm):00040                         LDA     <ROWCOL+4
10C8 A7C900A0         (          cls.asm):00041                         STA     4*COLS,U
10CC 9648             (          cls.asm):00042                         LDA     <ROWCOL+5
10CE A7C900C8         (          cls.asm):00043                         STA     5*COLS,U
10D2 9649             (          cls.asm):00044                         LDA     <ROWCOL+6
10D4 A7C900F0         (          cls.asm):00045                         STA     6*COLS,U
10D8 964A             (          cls.asm):00046                         LDA     <ROWCOL+7
10DA A7C90118         (          cls.asm):00047                         STA     7*COLS,U
10DE 964B             (          cls.asm):00048                         LDA     <ROWCOL+8
10E0 A7C90140         (          cls.asm):00049                         STA     8*COLS,U
10E4 964C             (          cls.asm):00050                         LDA     <ROWCOL+9
10E6 A7C90168         (          cls.asm):00051                         STA     9*COLS,U
10EA 964D             (          cls.asm):00052                         LDA     <ROWCOL+10
10EC A7C90190         (          cls.asm):00053                         STA     10*COLS,U
10F0 964E             (          cls.asm):00054                         LDA     <ROWCOL+11
10F2 A7C901B8         (          cls.asm):00055                         STA     11*COLS,U
10F6 964F             (          cls.asm):00056                         LDA     <ROWCOL+12
10F8 A7C901E0         (          cls.asm):00057                         STA     12*COLS,U
10FC 9650             (          cls.asm):00058                         LDA     <ROWCOL+13
10FE A7C90208         (          cls.asm):00059                         STA     13*COLS,U
1102 9651             (          cls.asm):00060                         LDA     <ROWCOL+14
1104 A7C90230         (          cls.asm):00061                         STA     14*COLS,U
1108 9652             (          cls.asm):00062                         LDA     <ROWCOL+15
110A A7C90258         (          cls.asm):00063                         STA     15*COLS,U
110E 9653             (          cls.asm):00064                         LDA     <ROWCOL+16
1110 A7C90280         (          cls.asm):00065                         STA     16*COLS,U
1114 9654             (          cls.asm):00066                         LDA     <ROWCOL+17
1116 A7C902A8         (          cls.asm):00067                         STA     17*COLS,U
111A 9655             (          cls.asm):00068                         LDA     <ROWCOL+18
111C A7C902D0         (          cls.asm):00069                         STA     18*COLS,U
1120 9656             (          cls.asm):00070                         LDA     <ROWCOL+19
1122 A7C902F8         (          cls.asm):00071                         STA     19*COLS,U
1126 9657             (          cls.asm):00072                         LDA     <ROWCOL+20
1128 A7C90320         (          cls.asm):00073                         STA     20*COLS,U
112C 9658             (          cls.asm):00074                         LDA     <ROWCOL+21
112E A7C90348         (          cls.asm):00075                         STA     21*COLS,U
1132 9659             (          cls.asm):00076                         LDA     <ROWCOL+22
1134 A7C90370         (          cls.asm):00077                         STA     22*COLS,U
1138 965A             (          cls.asm):00078                         LDA     <ROWCOL+23
113A A7C90398         (          cls.asm):00079                         STA     23*COLS,U
113E 35F6             (          cls.asm):00080                         PULS    D,X,Y,U,PC
                      (      src/tgl.asm):00090                         INCLUDE "plot.asm"
                      (         plot.asm):00001         ; ---------------------------------------------------------------------------
                      (         plot.asm):00002         ; T_SETMODE - select plot mode
                      (         plot.asm):00003         ;   Patches the pre-op and operation bytes in T_PLOT, the four T_LINE
                      (         plot.asm):00004         ;   loops and the rectangle fill, so pixel writes never test the mode.
                      (         plot.asm):00005         ;   Out-of-range modes are ignored.
                      (         plot.asm):00006         ;   Entry: A = MODE_SET, MODE_CLEAR or MODE_XOR, DP = $00
                      (         plot.asm):00007         ;   Exit:  all registers preserved
                      (         plot.asm):00008         ; ---------------------------------------------------------------------------
1140 8102             (         plot.asm):00009         T_SETMODE       CMPA    #MODE_XOR
1142 223F             (         plot.asm):00010                         BHI     SETM_X
1144 3416             (         plot.asm):00011                         PSHS    D,X
1146 9705             (         plot.asm):00012                         STA     <W_MODE
1148 308D10BD         (         plot.asm):00013                         LEAX    MODETAB,PCR
114C 48               (         plot.asm):00014                         ASLA
114D EC86             (         plot.asm):00015                         LDD     A,X             ; A = pre-op byte, B = opcode
114F A78D0050         (         plot.asm):00016                         STA     PLOT_PRE,PCR
1153 E78D004D         (         plot.asm):00017                         STB     PLOT_OP,PCR
1157 A78D0102         (         plot.asm):00018                         STA     LXD_PRE,PCR
115B E78D00FF         (         plot.asm):00019                         STB     LXD_OP,PCR
115F A78D0130         (         plot.asm):00020                         STA     LXU_PRE,PCR
1163 E78D012D         (         plot.asm):00021                         STB     LXU_OP,PCR
1167 A78D015E         (         plot.asm):00022                         STA     LYR_PRE,PCR
116B E78D015B         (         plot.asm):00023                         STB     LYR_OP,PCR
116F A78D018C         (         plot.asm):00024                         STA     LYL_PRE,PCR
1173 E78D0189         (         plot.asm):00025                         STB     LYL_OP,PCR
1177 A78D0493         (         plot.asm):00026                         STA     FS_PRE,PCR      ; rectangle fill: the same pre-op,
117B C010             (         plot.asm):00027                         SUBB    #$10            ;  but its operation uses direct
117D E78D0492         (         plot.asm):00028                         STB     FS_OP,PCR       ;  addressing (opcode $10 lower)
1181 3516             (         plot.asm):00029                         PULS    D,X
1183 39               (         plot.asm):00030         SETM_X          RTS
                      (         plot.asm):00031         
                      (         plot.asm):00032         ; ---------------------------------------------------------------------------
                      (         plot.asm):00033         ; T_PLOT - plot one sixel pixel in the off-screen buffer
                      (         plot.asm):00034         ;   Entry: A = x (0-77), B = y (0-71), DP = $00
                      (         plot.asm):00035         ;   Exit:  all registers preserved
                      (         plot.asm):00036         ;   No range checking in a normal build - out-of-range coordinates write
                      (         plot.asm):00037         ;   outside the buffer. A TGL_SAFE build ignores off-screen points instead.
                      (         plot.asm):00038         ;
                      (         plot.asm):00039         ;   cell = buffer + (y/3)*40 + 1 + x/2,  mask from (x&1, y%3)
                      (         plot.asm):00040         ; ---------------------------------------------------------------------------
1184                  (         plot.asm):00041         T_PLOT
                      (         plot.asm):00042                         IFDEF   TGL_SAFE
                      (         plot.asm):00043                         CMPA    #XMAX           ; off screen: do nothing
                      (         plot.asm):00044                         BHI     PLOT_RTS
                      (         plot.asm):00045                         CMPB    #YMAX
                      (         plot.asm):00046                         BHI     PLOT_RTS
                      (         plot.asm):00047                         ENDC
1184 3436             (         plot.asm):00048                         PSHS    D,X,Y
1186 318D0F5F         (         plot.asm):00049                         LEAY    PTAB,PCR
118A 4F               (         plot.asm):00050                         CLRA                    ; D = y
118B 58               (         plot.asm):00051                         ASLB                    ; D = y*4 (entries are 4 bytes)
118C 49               (         plot.asm):00052                         ROLA
118D 58               (         plot.asm):00053                         ASLB
118E 49               (         plot.asm):00054                         ROLA
118F 31AB             (         plot.asm):00055                         LEAY    D,Y             ; Y -> PTAB entry for this y
1191 ECA4             (         plot.asm):00056                         LDD     ,Y              ; offset of column 1 of the cell row
1193 D300             (         plot.asm):00057                         ADDD    <W_BUF
1195 1F01             (         plot.asm):00058                         TFR     D,X
1197 E6E4             (         plot.asm):00059                         LDB     ,S              ; x (caller's A, saved on the stack)
1199 54               (         plot.asm):00060                         LSRB                    ; B = x/2, C = x&1
119A 3A               (         plot.asm):00061                         ABX                     ; X -> cell (ABX leaves C alone)
119B 2504             (         plot.asm):00062                         BCS     PLOT_R
119D A622             (         plot.asm):00063                         LDA     2,Y             ; left pixel mask
119F 2002             (         plot.asm):00064                         BRA     PLOT_PRE
11A1 A623             (         plot.asm):00065         PLOT_R          LDA     3,Y             ; right pixel mask
11A3 12               (         plot.asm):00066         PLOT_PRE        NOP                     ; patched: NOP or COMA
11A4 AA84             (         plot.asm):00067         PLOT_OP         ORA     ,X              ; patched: ORA / ANDA / EORA ,X
11A6 A784             (         plot.asm):00068                         STA     ,X
11A8 35B6             (         plot.asm):00069                         PULS    D,X,Y,PC
                      (         plot.asm):00070                         IFDEF   TGL_SAFE
11AA                  (         plot.asm):00071         PLOT_RTS        RTS
                      (         plot.asm):00072                         ENDC
                      (      src/tgl.asm):00091                         INCLUDE "line.asm"
                      (         line.asm):00001         ; ---------------------------------------------------------------------------
                      (         line.asm):00002         ; T_LINE - draw a line in the off-screen buffer (Bresenham)
                      (         line.asm):00003         ;   Entry: A = x0, B = y0, X = x1 (high byte) : y1 (low byte), DP = $00
                      (         line.asm):00004         ;          x 0-77, y 0-71. Uses the current plot mode.
                      (         line.asm):00005         ;          No range checking in a normal build. A TGL_SAFE build draws
                      (         line.asm):00006         ;          nothing if either endpoint is off screen.
                      (         line.asm):00007         ;   Exit:  all registers preserved
                      (         line.asm):00008         ;
                      (         line.asm):00009         ;   Rather than calling the plot routine per pixel, the loop tracks the
                      (         line.asm):00010         ;   cell pointer (X) and an internal pixel mask (B) and steps them directly.
                      (         line.asm):00011         ;   Internal masks put the bottom-right pixel in bit 5, so every step is a
                      (         line.asm):00012         ;   plain shift:
                      (         line.asm):00013         ;
                      (         line.asm):00014         ;        left right                 x step: shift 1   (cross cell: X +/- 1)
                      (         line.asm):00015         ;   top     1    2                  y step: shift 2   (cross row:  X +/- 40)
                      (         line.asm):00016         ;   middle  4    8
                      (         line.asm):00017         ;   bottom 16   32 (screen bit 6)   MASKREAL converts internal -> screen
                      (         line.asm):00018         ;
                      (         line.asm):00019         ;   Endpoints are swapped so the major axis always runs positive, leaving
                      (         line.asm):00020         ;   four loops: x-major with y up/down, y-major with x left/right. The
                      (         line.asm):00021         ;   chosen loop's |dx| and |dy| are patched into it as immediates, and
                      (         line.asm):00022         ;   T_SETMODE patches each loop's pixel operation.
                      (         line.asm):00023         ;   Error term stays within -77..+77, so it fits a signed byte.
                      (         line.asm):00024         ; ---------------------------------------------------------------------------
                      (         line.asm):00025         
                      (         line.asm):00026         ; Write the pixel at X with internal mask B (U -> MASKREAL)
11AA                  (         line.asm):00027         LN_PIXEL        MACRO
                      (         line.asm):00028                         LDA     B,U             ; screen mask
11AA                  (         line.asm):00029         \1_PRE          NOP                     ; patched by T_SETMODE
11AA                  (         line.asm):00030         \1_OP           ORA     ,X              ; patched by T_SETMODE
                      (         line.asm):00031                         STA     ,X
                      (         line.asm):00032                         ENDM
                      (         line.asm):00033         
                      (         line.asm):00034         ; Step one pixel right / left / down / up
11AA                  (         line.asm):00035         LN_RIGHT        MACRO
                      (         line.asm):00036                         BITB    #$15            ; left pixel?
                      (         line.asm):00037                         BEQ     \1_RN
                      (         line.asm):00038                         ASLB                    ; -> right pixel, same cell
                      (         line.asm):00039                         BRA     \1_RD
11AA                  (         line.asm):00040         \1_RN           LSRB                    ; -> left pixel of next cell
                      (         line.asm):00041                         LEAX    1,X
11AA                  (         line.asm):00042         \1_RD
                      (         line.asm):00043                         ENDM
                      (         line.asm):00044         
11AA                  (         line.asm):00045         LN_LEFT         MACRO
                      (         line.asm):00046                         BITB    #$2A            ; right pixel?
                      (         line.asm):00047                         BEQ     \1_LN
                      (         line.asm):00048                         LSRB                    ; -> left pixel, same cell
                      (         line.asm):00049                         BRA     \1_LD
11AA                  (         line.asm):00050         \1_LN           ASLB                    ; -> right pixel of previous cell
                      (         line.asm):00051                         LEAX    -1,X
11AA                  (         line.asm):00052         \1_LD
                      (         line.asm):00053                         ENDM
                      (         line.asm):00054         
11AA                  (         line.asm):00055         LN_DOWN         MACRO
                      (         line.asm):00056                         BITB    #$30            ; bottom sixel row?
                      (         line.asm):00057                         BNE     \1_DN
                      (         line.asm):00058                         ASLB                    ; -> next sixel row, same cell
                      (         line.asm):00059                         ASLB
                      (         line.asm):00060                         BRA     \1_DD
11AA                  (         line.asm):00061         \1_DN           LSRB                    ; -> top sixel row, cell below
                      (         line.asm):00062                         LSRB
                      (         line.asm):00063                         LSRB
                      (         line.asm):00064                         LSRB
                      (         line.asm):00065                         LEAX    COLS,X
11AA                  (         line.asm):00066         \1_DD
                      (         line.asm):00067                         ENDM
                      (         line.asm):00068         
11AA                  (         line.asm):00069         LN_UP           MACRO
                      (         line.asm):00070                         BITB    #$03            ; top sixel row?
                      (         line.asm):00071                         BNE     \1_UN
                      (         line.asm):00072                         LSRB                    ; -> previous sixel row, same cell
                      (         line.asm):00073                         LSRB
                      (         line.asm):00074                         BRA     \1_UD
11AA                  (         line.asm):00075         \1_UN           ASLB                    ; -> bottom sixel row, cell above
                      (         line.asm):00076                         ASLB
                      (         line.asm):00077                         ASLB
                      (         line.asm):00078                         ASLB
                      (         line.asm):00079                         LEAX    -COLS,X
11AA                  (         line.asm):00080         \1_UD
                      (         line.asm):00081                         ENDM
                      (         line.asm):00082         
                      (         line.asm):00083         ; One loop: \1 = name, \2 = major step, \3 = minor step
11AA                  (         line.asm):00084         LN_LOOP         MACRO
11AA                  (         line.asm):00085         \1              LN_PIXEL \1
                      (         line.asm):00086                         LEAY    -1,Y
                      (         line.asm):00087                         BEQ     \1_X           ; local exit keeps this a short branch
                      (         line.asm):00088                         \2      \1
                      (         line.asm):00089                         LDA     <W_ERR
11AA                  (         line.asm):00090         \1_SUB          SUBA    #0              ; patched: minor length
                      (         line.asm):00091                         BPL     \1_NS
11AA                  (         line.asm):00092         \1_ADD          ADDA    #0              ; patched: major length
                      (         line.asm):00093                         STA     <W_ERR
                      (         line.asm):00094                         \3      \1
                      (         line.asm):00095                         BRA     \1
11AA                  (         line.asm):00096         \1_NS           STA     <W_ERR
                      (         line.asm):00097                         BRA     \1
11AA                  (         line.asm):00098         \1_X            PULS    D,X,Y,U,PC
                      (         line.asm):00099                         ENDM
                      (         line.asm):00100         
                      (         line.asm):00101         ; ---------------------------------------------------------------------------
11AA                  (         line.asm):00102         T_LINE
                      (         line.asm):00103                         IFDEF   TGL_SAFE
                      (         line.asm):00104                         CMPA    #XMAX           ; start point off screen?
                      (         line.asm):00105                         BHI     LN_RTS
