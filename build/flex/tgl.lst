142B 2503             (         clip.asm):00187                         BLO     DV_NEXT
142D 9016             (         clip.asm):00188         DV_SUB          SUBA    <I_DV
142F 5C               (         clip.asm):00189                         INCB
1430 0A17             (         clip.asm):00190         DV_NEXT         DEC     <I_CNT
1432 26F1             (         clip.asm):00191                         BNE     DV_LOOP
