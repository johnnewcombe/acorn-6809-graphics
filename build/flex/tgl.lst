                      (         rect.asm):00243         
                      (         rect.asm):00244         ; ---------------------------------------------------------------------------
                      (         rect.asm):00245         ; FILLSEG - apply a mask to a run of cells
                      (         rect.asm):00246         ;   Entry: X -> first cell, B = number of cells (1 or more), A = mask
                      (         rect.asm):00247         ;   Exit:  X -> cell after the run. A, B corrupted.
                      (         rect.asm):00248         ;   T_SETMODE patches the pre-op (NOP, or COMA for CLEAR) and the operation
                      (         rect.asm):00249         ;   (ORA / ANDA / EORA), so the loop never tests the mode. About 19 cycles
                      (         rect.asm):00250         ;   per cell, i.e. roughly 3 cycles per pixel.
                      (         rect.asm):00251         ; ---------------------------------------------------------------------------
15BD                  (         rect.asm):00252         FILLSEG
15BD 12               (         rect.asm):00253         FS_PRE          NOP                     ; patched: NOP or COMA
15BE 9727             (         rect.asm):00254                         STA     <W_FM
15C0 A684             (         rect.asm):00255         FS_LOOP         LDA     ,X
15C2 9A27             (         rect.asm):00256         FS_OP           ORA     <W_FM           ; patched: ORA / ANDA / EORA <W_FM
15C4 A780             (         rect.asm):00257                         STA     ,X+
15C6 5A               (         rect.asm):00258                         DECB
15C7 26F7             (         rect.asm):00259                         BNE     FS_LOOP
15C9 39               (         rect.asm):00260                         RTS
                      (         rect.asm):00261         
