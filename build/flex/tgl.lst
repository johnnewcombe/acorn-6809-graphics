                      (      src/tgl.asm):00091                         INCLUDE "circle.asm"
                      (       circle.asm):00001         ; ---------------------------------------------------------------------------
                      (       circle.asm):00002         ; Circles - outlined and filled, corrected for the pixel shape
                      (       circle.asm):00003         ;   Entry: A = centre x, B = centre y (signed, -128..127),
                      (       circle.asm):00004         ;          X = radius in vertical pixels (0-127; larger values count as 127)
                      (       circle.asm):00005         ;          DP = $00
                      (       circle.asm):00006         ;   Exit:  all registers preserved
                      (       circle.asm):00007         ;   Both clip to the screen and use the current plot mode.
                      (       circle.asm):00008         ;
                      (       circle.asm):00009         ;   Teletext pixels are about 1.2 times wider than they are tall, so a
                      (       circle.asm):00010         ;   shape that is round in pixels looks squashed. Every half-width is
                      (       circle.asm):00011         ;   therefore scaled by 13/16 (0.81), the same correction the cube demo's
                      (       circle.asm):00012         ;   projection uses, so circles look round on screen.
                      (       circle.asm):00013         ;
                      (       circle.asm):00014         ;   The circle is worked out a row at a time, from the centre row outwards.
                      (       circle.asm):00015         ;   For row offset y, the unscaled half-width x is the largest x with
                      (       circle.asm):00016         ;   x^2 + y^2 <= r^2 + r (the midpoint rule, which rounds to the nearest
                      (       circle.asm):00017         ;   pixel). Moving to the next row only ever shrinks x, and the test can be
                      (       circle.asm):00018         ;   kept up to date with additions alone:
                      (       circle.asm):00019         ;       f = x^2 + y^2 - r^2 - r       (start: x = r, y = 0, so f = -r)
                      (       circle.asm):00020         ;       next row:     f = f + 2y + 1, then y = y + 1
                      (       circle.asm):00021         ;       while f > 0:  f = f - (2x - 1), x = x - 1
                      (       circle.asm):00022         ;
                      (       circle.asm):00023         ;   Outline: each row draws the run of pixels from just beyond the next
                      (       circle.asm):00024         ;   row's edge out to this row's edge (at least one pixel), on both sides,
                      (       circle.asm):00025         ;   for the rows above and below the centre. That joins the rows into an
                      (       circle.asm):00026         ;   unbroken outline and draws every pixel exactly once, so XOR works.
                      (       circle.asm):00027         ;   Filled: each row draws one span from edge to edge.
                      (       circle.asm):00028         ;   Runs and spans are drawn by HSPAN, a lean one-row fill.
                      (       circle.asm):00029         ; ---------------------------------------------------------------------------
                      (       circle.asm):00030         
163E 3476             (       circle.asm):00031         T_CIRC          PSHS    D,X,Y,U
1640 1701AA           (       circle.asm):00032                         LBSR    CI_SETUP
1643 0F37             (       circle.asm):00033                         CLR     <C_FILL         ; outline
1645 2009             (       circle.asm):00034                         BRA     CI_RUN
                      (       circle.asm):00035         
1647 3476             (       circle.asm):00036         T_CIRCF         PSHS    D,X,Y,U
1649 1701A1           (       circle.asm):00037                         LBSR    CI_SETUP
164C 8601             (       circle.asm):00038                         LDA     #1              ; filled
164E 9737             (       circle.asm):00039                         STA     <C_FILL
                      (       circle.asm):00040         
1650 0F2F             (       circle.asm):00041         CI_RUN          CLR     <C_ROW          ; start at the centre row
1652 D62E             (       circle.asm):00042                         LDB     <C_R            ; x = r
1654 D730             (       circle.asm):00043                         STB     <C_X
1656 4F               (       circle.asm):00044                         CLRA                    ; f = -r
1657 43               (       circle.asm):00045                         COMA                    ;  (negate D: complement, add 1)
1658 53               (       circle.asm):00046                         COMB
1659 C30001           (       circle.asm):00047                         ADDD    #1
165C DD31             (       circle.asm):00048                         STD     <C_F
165E 9630             (       circle.asm):00049                         LDA     <C_X            ; half-width of the centre row
1660 170179           (       circle.asm):00050                         LBSR    SCALEX
1663 9733             (       circle.asm):00051                         STA     <C_HC
                      (       circle.asm):00052         
1665 962F             (       circle.asm):00053         CI_LOOP         LDA     <C_ROW          ; on the outermost row there is no
1667 912E             (       circle.asm):00054                         CMPA    <C_R            ;  next row: draw it edge to edge
1669 2710             (       circle.asm):00055                         BEQ     CI_TOP
166B 170144           (       circle.asm):00056                         LBSR    NEXTX           ; next row's half-width
166E 9734             (       circle.asm):00057                         STA     <C_HN
1670 4C               (       circle.asm):00058                         INCA                    ; this row's run starts just beyond
1671 9133             (       circle.asm):00059                         CMPA    <C_HC           ;  the next row's edge, but never
1673 2302             (       circle.asm):00060                         BLS     CI_S1           ;  past this row's own edge
1675 9633             (       circle.asm):00061                         LDA     <C_HC
1677 9735             (       circle.asm):00062         CI_S1           STA     <C_ST
1679 2002             (       circle.asm):00063                         BRA     CI_DRAW
167B 0F35             (       circle.asm):00064         CI_TOP          CLR     <C_ST           ; start 0 = one span, edge to edge
                      (       circle.asm):00065         
167D 0D37             (       circle.asm):00066         CI_DRAW         TST     <C_FILL         ; filled circles always draw the
167F 2702             (       circle.asm):00067                         BEQ     CI_ROWS         ;  full span
1681 0F35             (       circle.asm):00068                         CLR     <C_ST
                      (       circle.asm):00069         
1683 962D             (       circle.asm):00070         CI_ROWS         LDA     <C_CY           ; the row below the centre (screen y
1685 9B2F             (       circle.asm):00071                         ADDA    <C_ROW          ;  grows downwards). Saturate rather
1687 2802             (       circle.asm):00072                         BVC     CI_Y1           ;  than wrap: a row that far out is
1689 867F             (       circle.asm):00073                         LDA     #127            ;  off screen and gets clipped anyway
168B 9736             (       circle.asm):00074         CI_Y1           STA     <C_Y
