108D 3636             (          cls.asm):00021                         PSHU    D,X,Y
108F 3636             (          cls.asm):00022                         PSHU    D,X,Y
1091 3636             (          cls.asm):00023                         PSHU    D,X,Y
1093 3636             (          cls.asm):00024                         PSHU    D,X,Y
1095 3636             (          cls.asm):00025                         PSHU    D,X,Y
1097 3636             (          cls.asm):00026                         PSHU    D,X,Y
1099 3636             (          cls.asm):00027                         PSHU    D,X,Y
109B 0A04             (          cls.asm):00028                         DEC     <W_COUNT
109D 26EC             (          cls.asm):00029                         BNE     CLS_FILL
                      (          cls.asm):00030                                                 ; U = buffer start: put each row's
                      (          cls.asm):00031                                                 ;  colour code in column 0
109F 9643             (          cls.asm):00032                         LDA     <ROWCOL+0
