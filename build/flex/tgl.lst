                      (      polygon.asm):00207         ; PF_MASKS - work out the pattern's masks for even and odd character rows
                      (      polygon.asm):00208         ;   Pixel row s of character row r is screen row 3r + s, which is odd when
                      (      polygon.asm):00209         ;   r + s is odd. The pattern uses bits 0-1 on even screen rows and bits
                      (      polygon.asm):00210         ;   2-3 on odd ones (left pixel, right pixel). For each kind of character
                      (      polygon.asm):00211         ;   row this gives 3 left-pixel masks then 3 right-pixel masks.
                      (      polygon.asm):00212         ; ---------------------------------------------------------------------------
1A46 CE007A           (      polygon.asm):00213         PF_MASKS        LDU     #P_MEVEN        ; even character rows: screen rows
1A49 965C             (      polygon.asm):00214                         LDA     <H_PAT          ;  even, odd, even
1A4B 8D23             (      polygon.asm):00215                         BSR     PM_ROW0
1A4D 965C             (      polygon.asm):00216                         LDA     <H_PAT
1A4F 44               (      polygon.asm):00217                         LSRA
1A50 44               (      polygon.asm):00218                         LSRA
1A51 8D19             (      polygon.asm):00219                         BSR     PM_ROW1
1A53 965C             (      polygon.asm):00220                         LDA     <H_PAT
1A55 8D11             (      polygon.asm):00221                         BSR     PM_ROW2
1A57 CE0032           (      polygon.asm):00222                         LDU     #P_MODD         ; odd character rows: odd, even, odd
1A5A 965C             (      polygon.asm):00223                         LDA     <H_PAT
1A5C 44               (      polygon.asm):00224                         LSRA
1A5D 44               (      polygon.asm):00225                         LSRA
1A5E 8D10             (      polygon.asm):00226                         BSR     PM_ROW0
1A60 965C             (      polygon.asm):00227                         LDA     <H_PAT
1A62 8D08             (      polygon.asm):00228                         BSR     PM_ROW1
1A64 965C             (      polygon.asm):00229                         LDA     <H_PAT
1A66 44               (      polygon.asm):00230                         LSRA
1A67 44               (      polygon.asm):00231                         LSRA
                      (      polygon.asm):00232                         ; fall into PM_ROW2
                      (      polygon.asm):00233         
                      (      polygon.asm):00234         ; PM_ROWn - Entry: A = pattern bits for the screen row (bit 0 left, bit 1
                      (      polygon.asm):00235         ;   right), U -> mask set. Sets that pixel row's left and right masks.
1A68 C602             (      polygon.asm):00236         PM_ROW2         LDB     #2
1A6A 2005             (      polygon.asm):00237                         BRA     PM_ROW
