1BF5 E641             (      polygon.asm):00493                         LDB     CH_NXT,U        ; fetch both corners
1BF7 8DD0             (      polygon.asm):00494                         BSR     VTX
1BF9 9710             (      polygon.asm):00495                         STA     <P_XN
1BFB D712             (      polygon.asm):00496                         STB     <P_YN
1BFD E6C4             (      polygon.asm):00497                         LDB     CH_CUR,U
1BFF 8DC8             (      polygon.asm):00498                         BSR     VTX
1C01 970F             (      polygon.asm):00499                         STA     <P_XC
1C03 D711             (      polygon.asm):00500                         STB     <P_YC
1C05 D112             (      polygon.asm):00501                         CMPB    <P_YN           ; does the edge go down?
1C07 2D21             (      polygon.asm):00502                         BLT     CS_DOWN
1C09 2E08             (      polygon.asm):00503                         BGT     CS_STOP         ; going up: no more edges this side
1C0B A641             (      polygon.asm):00504                         LDA     CH_NXT,U        ; flat: skip it
1C0D A7C4             (      polygon.asm):00505                         STA     CH_CUR,U
1C0F 0A13             (      polygon.asm):00506                         DEC     <P_CNT
1C11 26D2             (      polygon.asm):00507                         BNE     CS_LOOP
