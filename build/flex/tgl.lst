164E 39               (         rect.asm):00306                         RTS
                      (      src/tgl.asm):00094                         INCLUDE "circle.asm"
                      (       circle.asm):00001         ; ---------------------------------------------------------------------------
                      (       circle.asm):00002         ; Circles - outlined and filled, corrected for the pixel shape
                      (       circle.asm):00003         ;   Entry: A = centre x, B = centre y (signed, -128..127),
                      (       circle.asm):00004         ;          X = radius in vertical pixels (0-127; larger values count as 127)
                      (       circle.asm):00005         ;          DP = $00
                      (       circle.asm):00006         ;   Exit:  all registers preserved
                      (       circle.asm):00007         ;   Both clip to the screen and use the current plot mode.
                      (       circle.asm):00008         ;
                      (       circle.asm):00009         ;   Teletext pixels are about 1.2 times wider than they are tall, so a
                      (       circle.asm):00010         ;   shape that is round in pixels looks squashed. Every half-width is
                      (       circle.asm):00011         ;   therefore scaled by 13/16 (0.81), the same correction the cube demo's
                      (       circle.asm):00012         ;   projection uses, so circles look round on screen.
                      (       circle.asm):00013         ;
                      (       circle.asm):00014         ;   The circle is worked out a row at a time, from the centre row outwards.
                      (       circle.asm):00015         ;   For row offset y, the unscaled half-width x is the largest x with
                      (       circle.asm):00016         ;   x^2 + y^2 <= r^2 + r (the midpoint rule, which rounds to the nearest
                      (       circle.asm):00017         ;   pixel). Moving to the next row only ever shrinks x, and the test can be
                      (       circle.asm):00018         ;   kept up to date with additions alone:
                      (       circle.asm):00019         ;       f = x^2 + y^2 - r^2 - r       (start: x = r, y = 0, so f = -r)
                      (       circle.asm):00020         ;       next row:     f = f + 2y + 1, then y = y + 1
                      (       circle.asm):00021         ;       while f > 0:  f = f - (2x - 1), x = x - 1
                      (       circle.asm):00022         ;
                      (       circle.asm):00023         ;   Outline: each row draws the run of pixels from just beyond the next
                      (       circle.asm):00024         ;   row's edge out to this row's edge (at least one pixel), on both sides,
                      (       circle.asm):00025         ;   for the rows above and below the centre. That joins the rows into an
                      (       circle.asm):00026         ;   unbroken outline and draws every pixel exactly once, so XOR works.
                      (       circle.asm):00027         ;   Filled: each row draws one span from edge to edge.
                      (       circle.asm):00028         ;   Runs and spans are drawn by HSPAN, a lean one-row fill.
                      (       circle.asm):00029         ; ---------------------------------------------------------------------------
                      (       circle.asm):00030         
164F 3476             (       circle.asm):00031         T_CIRC          PSHS    D,X,Y,U
1651 1701DA           (       circle.asm):00032                         LBSR    CI_SETUP
1654 0F37             (       circle.asm):00033                         CLR     <C_FILL         ; outline
1656 860F             (       circle.asm):00034                         LDA     #$0F            ; outlines are always solid
1658 975C             (       circle.asm):00035                         STA     <H_PAT
165A 200D             (       circle.asm):00036                         BRA     CI_RUN
                      (       circle.asm):00037         
165C 3476             (       circle.asm):00038         T_CIRCF         PSHS    D,X,Y,U
165E 1701CD           (       circle.asm):00039                         LBSR    CI_SETUP
1661 8601             (       circle.asm):00040                         LDA     #1              ; filled
1663 9737             (       circle.asm):00041                         STA     <C_FILL
1665 965D             (       circle.asm):00042                         LDA     <U_PAT          ; filled circles use the fill pattern
1667 975C             (       circle.asm):00043                         STA     <H_PAT
                      (       circle.asm):00044         
1669 0F2F             (       circle.asm):00045         CI_RUN          CLR     <C_ROW          ; start at the centre row
166B D62E             (       circle.asm):00046                         LDB     <C_R            ; x = r
166D D730             (       circle.asm):00047                         STB     <C_X
166F 4F               (       circle.asm):00048                         CLRA                    ; f = -r
1670 43               (       circle.asm):00049                         COMA                    ;  (negate D: complement, add 1)
1671 53               (       circle.asm):00050                         COMB
1672 C30001           (       circle.asm):00051                         ADDD    #1
1675 DD31             (       circle.asm):00052                         STD     <C_F
1677 9630             (       circle.asm):00053                         LDA     <C_X            ; half-width of the centre row
1679 1701A1           (       circle.asm):00054                         LBSR    SCALEX
167C 9733             (       circle.asm):00055                         STA     <C_HC
                      (       circle.asm):00056         
167E 962F             (       circle.asm):00057         CI_LOOP         LDA     <C_ROW          ; on the outermost row there is no
1680 912E             (       circle.asm):00058                         CMPA    <C_R            ;  next row: draw it edge to edge
1682 2710             (       circle.asm):00059                         BEQ     CI_TOP
1684 17016C           (       circle.asm):00060                         LBSR    NEXTX           ; next row's half-width
1687 9734             (       circle.asm):00061                         STA     <C_HN
1689 4C               (       circle.asm):00062                         INCA                    ; this row's run starts just beyond
168A 9133             (       circle.asm):00063                         CMPA    <C_HC           ;  the next row's edge, but never
168C 2302             (       circle.asm):00064                         BLS     CI_S1           ;  past this row's own edge
168E 9633             (       circle.asm):00065                         LDA     <C_HC
1690 9735             (       circle.asm):00066         CI_S1           STA     <C_ST
1692 2002             (       circle.asm):00067                         BRA     CI_DRAW
1694 0F35             (       circle.asm):00068         CI_TOP          CLR     <C_ST           ; start 0 = one span, edge to edge
                      (       circle.asm):00069         
1696 0D37             (       circle.asm):00070         CI_DRAW         TST     <C_FILL         ; filled circles always draw the
1698 2702             (       circle.asm):00071                         BEQ     CI_ROWS         ;  full span
169A 0F35             (       circle.asm):00072                         CLR     <C_ST
                      (       circle.asm):00073         
169C 962D             (       circle.asm):00074         CI_ROWS         LDA     <C_CY           ; the row below the centre (screen y
169E 9B2F             (       circle.asm):00075                         ADDA    <C_ROW          ;  grows downwards). Saturate rather
16A0 2802             (       circle.asm):00076                         BVC     CI_Y1           ;  than wrap: a row that far out is
16A2 867F             (       circle.asm):00077                         LDA     #127            ;  off screen and gets clipped anyway
16A4 9736             (       circle.asm):00078         CI_Y1           STA     <C_Y
16A6 8D20             (       circle.asm):00079                         BSR     CI_ROWDRAW
16A8 0D2F             (       circle.asm):00080                         TST     <C_ROW          ; the row above, except for the
16AA 270C             (       circle.asm):00081                         BEQ     CI_NEXT         ;  centre row itself
16AC 962D             (       circle.asm):00082                         LDA     <C_CY
16AE 902F             (       circle.asm):00083                         SUBA    <C_ROW
16B0 2802             (       circle.asm):00084                         BVC     CI_Y2
16B2 8680             (       circle.asm):00085                         LDA     #-128
16B4 9736             (       circle.asm):00086         CI_Y2           STA     <C_Y
16B6 8D10             (       circle.asm):00087                         BSR     CI_ROWDRAW
                      (       circle.asm):00088         
16B8 962F             (       circle.asm):00089         CI_NEXT         LDA     <C_ROW          ; done the outermost row?
16BA 912E             (       circle.asm):00090                         CMPA    <C_R
16BC 2708             (       circle.asm):00091                         BEQ     CI_END
16BE 0C2F             (       circle.asm):00092                         INC     <C_ROW
16C0 9634             (       circle.asm):00093                         LDA     <C_HN           ; next row's half-width becomes
16C2 9733             (       circle.asm):00094                         STA     <C_HC           ;  this row's
16C4 20B8             (       circle.asm):00095                         BRA     CI_LOOP
16C6 35F6             (       circle.asm):00096         CI_END          PULS    D,X,Y,U,PC
                      (       circle.asm):00097         
                      (       circle.asm):00098         ; ---------------------------------------------------------------------------
                      (       circle.asm):00099         ; CI_ROWDRAW - draw one row (screen y in C_Y)
                      (       circle.asm):00100         ;   C_ST = 0: one span from cx - half-width to cx + half-width.
                      (       circle.asm):00101         ;   C_ST > 0: two runs, cx + C_ST .. cx + half-width on the right and its
                      (       circle.asm):00102         ;   mirror image on the left.
                      (       circle.asm):00103         ;   Screen x values saturate at -128 / 127 instead of wrapping; anything
                      (       circle.asm):00104         ;   that far out is off screen and clipped anyway.
                      (       circle.asm):00105         ; ---------------------------------------------------------------------------
16C8 0D35             (       circle.asm):00106         CI_ROWDRAW      TST     <C_ST
16CA 2618             (       circle.asm):00107                         BNE     RD_TWO
16CC 962C             (       circle.asm):00108                         LDA     <C_CX           ; one span: left end ...
16CE 9033             (       circle.asm):00109                         SUBA    <C_HC
16D0 2802             (       circle.asm):00110                         BVC     RD_1
16D2 8680             (       circle.asm):00111                         LDA     #-128
16D4 3402             (       circle.asm):00112         RD_1            PSHS    A
16D6 962C             (       circle.asm):00113                         LDA     <C_CX           ; ... right end
16D8 9B33             (       circle.asm):00114                         ADDA    <C_HC
16DA 2802             (       circle.asm):00115                         BVC     RD_2
16DC 867F             (       circle.asm):00116                         LDA     #127
16DE 1F89             (       circle.asm):00117         RD_2            TFR     A,B
16E0 3502             (       circle.asm):00118                         PULS    A
16E2 202E             (       circle.asm):00119                         BRA     DRUN
                      (       circle.asm):00120         
16E4 962C             (       circle.asm):00121         RD_TWO          LDA     <C_CX           ; right-hand run: cx + start ...
16E6 9B35             (       circle.asm):00122                         ADDA    <C_ST
16E8 2802             (       circle.asm):00123                         BVC     RD_3
16EA 867F             (       circle.asm):00124                         LDA     #127
16EC 3402             (       circle.asm):00125         RD_3            PSHS    A
16EE 962C             (       circle.asm):00126                         LDA     <C_CX           ; ... to cx + half-width
16F0 9B33             (       circle.asm):00127                         ADDA    <C_HC
16F2 2802             (       circle.asm):00128                         BVC     RD_4
16F4 867F             (       circle.asm):00129                         LDA     #127
16F6 1F89             (       circle.asm):00130         RD_4            TFR     A,B
16F8 3502             (       circle.asm):00131                         PULS    A
16FA 8D16             (       circle.asm):00132                         BSR     DRUN
16FC 962C             (       circle.asm):00133                         LDA     <C_CX           ; left-hand run: cx - half-width ...
16FE 9033             (       circle.asm):00134                         SUBA    <C_HC
1700 2802             (       circle.asm):00135                         BVC     RD_5
1702 8680             (       circle.asm):00136                         LDA     #-128
1704 3402             (       circle.asm):00137         RD_5            PSHS    A
1706 962C             (       circle.asm):00138                         LDA     <C_CX           ; ... to cx - start
1708 9035             (       circle.asm):00139                         SUBA    <C_ST
170A 2802             (       circle.asm):00140                         BVC     RD_6
170C 8680             (       circle.asm):00141                         LDA     #-128
170E 1F89             (       circle.asm):00142         RD_6            TFR     A,B
1710 3502             (       circle.asm):00143                         PULS    A
                      (       circle.asm):00144                         ; fall into DRUN
                      (       circle.asm):00145         
                      (       circle.asm):00146         ; ---------------------------------------------------------------------------
                      (       circle.asm):00147         ; DRUN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00148         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00149         ;   A single pixel (most of an outline) goes to the clipped plot, which is
                      (       circle.asm):00150         ;   cheaper; anything longer, or anything patterned, goes to HSPAN.
                      (       circle.asm):00151         ; ---------------------------------------------------------------------------
1712 3404             (       circle.asm):00152         DRUN            PSHS    B
1714 A1E0             (       circle.asm):00153                         CMPA    ,S+
1716 260F             (       circle.asm):00154                         BNE     HSPAN
1718 3404             (       circle.asm):00155                         PSHS    B               ; patterned: HSPAN applies the pattern
171A D65C             (       circle.asm):00156                         LDB     <H_PAT          ;  (keep B, the run's right end;
171C C10F             (       circle.asm):00157                         CMPB    #$0F            ;  PULS leaves the flags alone)
171E 3504             (       circle.asm):00158                         PULS    B
1720 2605             (       circle.asm):00159                         BNE     HSPAN
1722 D636             (       circle.asm):00160                         LDB     <C_Y            ; one solid pixel: A,B = x,y
1724 16FC69           (       circle.asm):00161                         LBRA    T_PLOTC
                      (       circle.asm):00162         
                      (       circle.asm):00163         ; ---------------------------------------------------------------------------
                      (       circle.asm):00164         ; HSPAN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00165         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00166         ;   Exit:  A, B, X, U corrupted
                      (       circle.asm):00167         ;
                      (       circle.asm):00168         ;   A lean, single-row version of the rectangle fill, which also applies
                      (       circle.asm):00169         ;   the fill pattern in H_PAT (15 = solid). Used by the circles and the
                      (       circle.asm):00170         ;   polygon fill; the caller sets H_PAT. The row's left and
                      (       circle.asm):00171         ;   right pixel masks come straight from PTAB, so there is no sorting, no
                      (       circle.asm):00172         ;   multiply and no mask lookup: clip, find the cells, then
                      (       circle.asm):00173         ;     - if the run starts on a right-hand pixel, that cell gets only its
                      (       circle.asm):00174         ;       right pixel
                      (       circle.asm):00175         ;     - whole cells in between get both pixels, via the shared FILLSEG loop
                      (       circle.asm):00176         ;     - if the run ends on a left-hand pixel, that cell gets only its left
                      (       circle.asm):00177         ;   (or, when the run lies within one cell, whichever of its pixels count).
                      (       circle.asm):00178         ; ---------------------------------------------------------------------------
1727 3406             (       circle.asm):00179         HSPAN           PSHS    A,B             ; 0,S = left x, 1,S = right x
1729 D636             (       circle.asm):00180                         LDB     <C_Y            ; row off screen? (unsigned compare
172B C147             (       circle.asm):00181                         CMPB    #YMAX           ;  catches negative rows too)
172D 102200C0         (       circle.asm):00182                         LBHI    HS_X
1731 A661             (       circle.asm):00183                         LDA     1,S             ; run entirely left of the screen?
1733 102B00BA         (       circle.asm):00184                         LBMI    HS_X
1737 A6E4             (       circle.asm):00185                         LDA     ,S              ; entirely right of it?
1739 814D             (       circle.asm):00186                         CMPA    #XMAX
173B 102E00B2         (       circle.asm):00187                         LBGT    HS_X
173F 4D               (       circle.asm):00188                         TSTA                    ; clip the left end
1740 2A02             (       circle.asm):00189                         BPL     HS_1
1742 6FE4             (       circle.asm):00190                         CLR     ,S
1744 A661             (       circle.asm):00191         HS_1            LDA     1,S             ; clip the right end
1746 814D             (       circle.asm):00192                         CMPA    #XMAX
1748 2F04             (       circle.asm):00193                         BLE     HS_2
174A 864D             (       circle.asm):00194                         LDA     #XMAX
174C A761             (       circle.asm):00195                         STA     1,S
                      (       circle.asm):00196         
174E 17FEE4           (       circle.asm):00197         HS_2            LBSR    PT_ENTRY        ; U -> PTAB entry for this row (B = y)
1751 ECC4             (       circle.asm):00198                         LDD     ,U              ; X -> first cell of the cell row
1753 D300             (       circle.asm):00199                         ADDD    <W_BUF
1755 1F01             (       circle.asm):00200                         TFR     D,X
1757 A642             (       circle.asm):00201                         LDA     2,U             ; this sixel row's masks
1759 9725             (       circle.asm):00202                         STA     <F_ML
175B A643             (       circle.asm):00203                         LDA     3,U
175D 9726             (       circle.asm):00204                         STA     <F_MR
                      (       circle.asm):00205         
175F D65C             (       circle.asm):00206                         LDB     <H_PAT          ; apply the fill pattern: odd rows use
1761 9636             (       circle.asm):00207                         LDA     <C_Y            ;  bits 2-3, even rows bits 0-1;
1763 8501             (       circle.asm):00208                         BITA    #1              ;  the low bit is for left (even x)
1765 2702             (       circle.asm):00209                         BEQ     HS_P1           ;  pixels, the next for right (odd x)
1767 54               (       circle.asm):00210                         LSRB
1768 54               (       circle.asm):00211                         LSRB
1769 C501             (       circle.asm):00212         HS_P1           BITB    #1
176B 2602             (       circle.asm):00213                         BNE     HS_P2
176D 0F25             (       circle.asm):00214                         CLR     <F_ML
176F C502             (       circle.asm):00215         HS_P2           BITB    #2
1771 2602             (       circle.asm):00216                         BNE     HS_P3
1773 0F26             (       circle.asm):00217                         CLR     <F_MR
1775 9625             (       circle.asm):00218         HS_P3           LDA     <F_ML           ; nothing left to draw on this row?
1777 9A26             (       circle.asm):00219                         ORA     <F_MR
1779 10270074         (       circle.asm):00220                         LBEQ    HS_X
                      (       circle.asm):00221         
177D A6E4             (       circle.asm):00222                         LDA     ,S              ; first cell, and does the run start
177F 44               (       circle.asm):00223                         LSRA                    ;  on its right pixel (x odd)?
1780 971C             (       circle.asm):00224                         STA     <F_CX0
1782 8600             (       circle.asm):00225                         LDA     #0              ; (not CLRA: keep the carry)
1784 49               (       circle.asm):00226                         ROLA
1785 971E             (       circle.asm):00227                         STA     <F_PL
1787 A661             (       circle.asm):00228                         LDA     1,S             ; last cell, and does the run end
1789 44               (       circle.asm):00229                         LSRA                    ;  on its left pixel (x even)?
178A 971D             (       circle.asm):00230                         STA     <F_CX1
178C 8600             (       circle.asm):00231                         LDA     #0
178E 49               (       circle.asm):00232                         ROLA
178F 8801             (       circle.asm):00233                         EORA    #1
1791 971F             (       circle.asm):00234                         STA     <F_PR
                      (       circle.asm):00235         
1793 961C             (       circle.asm):00236                         LDA     <F_CX0          ; all within one cell?
1795 911D             (       circle.asm):00237                         CMPA    <F_CX1
1797 2617             (       circle.asm):00238                         BNE     HS_MULTI
1799 4F               (       circle.asm):00239                         CLRA                    ; its left pixel counts if the run
179A 0D1E             (       circle.asm):00240                         TST     <F_PL           ;  starts on it, its right pixel
179C 2602             (       circle.asm):00241                         BNE     HS_3            ;  if the run ends on it
179E 9A25             (       circle.asm):00242                         ORA     <F_ML
17A0 0D1F             (       circle.asm):00243         HS_3            TST     <F_PR
17A2 2602             (       circle.asm):00244                         BNE     HS_4
17A4 9A26             (       circle.asm):00245                         ORA     <F_MR
17A6 D61C             (       circle.asm):00246         HS_4            LDB     <F_CX0
17A8 3A               (       circle.asm):00247                         ABX
17A9 C601             (       circle.asm):00248                         LDB     #1
17AB 17FE5D           (       circle.asm):00249                         LBSR    FILLSEG
17AE 2041             (       circle.asm):00250                         BRA     HS_X
                      (       circle.asm):00251         
17B0 0D1E             (       circle.asm):00252         HS_MULTI        TST     <F_PL           ; partial first cell: right pixel
17B2 270E             (       circle.asm):00253                         BEQ     HS_5
17B4 3410             (       circle.asm):00254                         PSHS    X
17B6 D61C             (       circle.asm):00255                         LDB     <F_CX0
17B8 3A               (       circle.asm):00256                         ABX
17B9 9626             (       circle.asm):00257                         LDA     <F_MR
17BB C601             (       circle.asm):00258                         LDB     #1
17BD 17FE4B           (       circle.asm):00259                         LBSR    FILLSEG
17C0 3510             (       circle.asm):00260                         PULS    X
17C2 961C             (       circle.asm):00261         HS_5            LDA     <F_CX0          ; whole cells: from the first (or the
17C4 9B1E             (       circle.asm):00262                         ADDA    <F_PL           ;  one after) to the last (or the
17C6 9721             (       circle.asm):00263                         STA     <F_RS           ;  one before)
17C8 961D             (       circle.asm):00264                         LDA     <F_CX1
17CA 901F             (       circle.asm):00265                         SUBA    <F_PR
17CC 9021             (       circle.asm):00266                         SUBA    <F_RS
17CE 4C               (       circle.asm):00267                         INCA
17CF 2712             (       circle.asm):00268                         BEQ     HS_6            ; none
17D1 9722             (       circle.asm):00269                         STA     <F_RN
17D3 3410             (       circle.asm):00270                         PSHS    X
17D5 D621             (       circle.asm):00271                         LDB     <F_RS
17D7 3A               (       circle.asm):00272                         ABX
17D8 9625             (       circle.asm):00273                         LDA     <F_ML
17DA 9A26             (       circle.asm):00274                         ORA     <F_MR
17DC D622             (       circle.asm):00275                         LDB     <F_RN
17DE 17FE2A           (       circle.asm):00276                         LBSR    FILLSEG
17E1 3510             (       circle.asm):00277                         PULS    X
17E3 0D1F             (       circle.asm):00278         HS_6            TST     <F_PR           ; partial last cell: left pixel
17E5 270A             (       circle.asm):00279                         BEQ     HS_X
17E7 D61D             (       circle.asm):00280                         LDB     <F_CX1
17E9 3A               (       circle.asm):00281                         ABX
17EA 9625             (       circle.asm):00282                         LDA     <F_ML
17EC C601             (       circle.asm):00283                         LDB     #1
17EE 17FE1A           (       circle.asm):00284                         LBSR    FILLSEG
17F1 3586             (       circle.asm):00285         HS_X            PULS    A,B,PC
                      (       circle.asm):00286         
                      (       circle.asm):00287         ; ---------------------------------------------------------------------------
                      (       circle.asm):00288         ; NEXTX - move on to the next row: update f and x, return the next row's
                      (       circle.asm):00289         ;   scaled half-width in A. (C_ROW still holds the current row offset y.)
                      (       circle.asm):00290         ; ---------------------------------------------------------------------------
17F3 D62F             (       circle.asm):00291         NEXTX           LDB     <C_ROW          ; f = f + 2y + 1
17F5 4F               (       circle.asm):00292                         CLRA
17F6 58               (       circle.asm):00293                         ASLB
17F7 49               (       circle.asm):00294                         ROLA
17F8 C30001           (       circle.asm):00295                         ADDD    #1
17FB D331             (       circle.asm):00296                         ADDD    <C_F
17FD DD31             (       circle.asm):00297                         STD     <C_F
17FF DC31             (       circle.asm):00298         NX_LOOP         LDD     <C_F            ; while f > 0 (and x > 0) ...
1801 2F18             (       circle.asm):00299                         BLE     NX_DONE
1803 0D30             (       circle.asm):00300                         TST     <C_X
1805 2714             (       circle.asm):00301                         BEQ     NX_DONE
1807 D630             (       circle.asm):00302                         LDB     <C_X            ; ... f = f - (2x - 1)
1809 4F               (       circle.asm):00303                         CLRA
180A 58               (       circle.asm):00304                         ASLB
180B 49               (       circle.asm):00305                         ROLA
180C 830001           (       circle.asm):00306                         SUBD    #1
180F 3406             (       circle.asm):00307                         PSHS    D
1811 DC31             (       circle.asm):00308                         LDD     <C_F
1813 A3E1             (       circle.asm):00309                         SUBD    ,S++
1815 DD31             (       circle.asm):00310                         STD     <C_F
1817 0A30             (       circle.asm):00311                         DEC     <C_X            ; ... x = x - 1
1819 20E4             (       circle.asm):00312                         BRA     NX_LOOP
181B 9630             (       circle.asm):00313         NX_DONE         LDA     <C_X
                      (       circle.asm):00314                         ; fall into SCALEX
                      (       circle.asm):00315         
                      (       circle.asm):00316         ; ---------------------------------------------------------------------------
                      (       circle.asm):00317         ; SCALEX - aspect correction: A = (A * 13 + 8) / 16, rounded
                      (       circle.asm):00318         ;   Entry: A = 0-127   Exit: A = 0-103. B corrupted.
                      (       circle.asm):00319         ; ---------------------------------------------------------------------------
181D C60D             (       circle.asm):00320         SCALEX          LDB     #13
181F 3D               (       circle.asm):00321                         MUL                     ; D = x * 13
1820 C30008           (       circle.asm):00322                         ADDD    #8              ; round
1823 44               (       circle.asm):00323                         LSRA                    ; divide by 16
1824 56               (       circle.asm):00324                         RORB
1825 44               (       circle.asm):00325                         LSRA
1826 56               (       circle.asm):00326                         RORB
1827 44               (       circle.asm):00327                         LSRA
1828 56               (       circle.asm):00328                         RORB
1829 44               (       circle.asm):00329                         LSRA
182A 56               (       circle.asm):00330                         RORB
182B 1F98             (       circle.asm):00331                         TFR     B,A
182D 39               (       circle.asm):00332                         RTS
                      (       circle.asm):00333         
                      (       circle.asm):00334         ; ---------------------------------------------------------------------------
                      (       circle.asm):00335         ; CI_SETUP - store the centre and radius (radius clamped to 0-127)
                      (       circle.asm):00336         ; ---------------------------------------------------------------------------
182E 972C             (       circle.asm):00337         CI_SETUP        STA     <C_CX
1830 D72D             (       circle.asm):00338                         STB     <C_CY
1832 1F10             (       circle.asm):00339                         TFR     X,D             ; radius is X; anything over 127
1834 4D               (       circle.asm):00340                         TSTA                    ;  becomes 127
1835 2603             (       circle.asm):00341                         BNE     CS_BIG
1837 5D               (       circle.asm):00342                         TSTB
1838 2A02             (       circle.asm):00343                         BPL     CS_OK
183A C67F             (       circle.asm):00344         CS_BIG          LDB     #127
183C D72E             (       circle.asm):00345         CS_OK           STB     <C_R
183E 39               (       circle.asm):00346                         RTS
                      (      src/tgl.asm):00095                         INCLUDE "text.asm"
                      (         text.asm):00001         ; ---------------------------------------------------------------------------
                      (         text.asm):00002         ; Status row text
                      (         text.asm):00003         ;   The status row is screen row 24, below the 24 rows of graphics. The
                      (         text.asm):00004         ;   blit never touches it, so text written there stays put while the
                      (         text.asm):00005         ;   graphics above it change. Text is written straight to the screen (not
                      (         text.asm):00006         ;   the off-screen buffer), so it appears immediately.
                      (         text.asm):00007         ;
                      (         text.asm):00008         ;   Strings are zero-terminated and may contain teletext control codes to
                      (         text.asm):00009         ;   colour the text that follows them on the row, e.g. $81 red, $82 green,
                      (         text.asm):00010         ;   $83 yellow, $84 blue, $85 magenta, $86 cyan, $87 white ($01-$07 work
                      (         text.asm):00011         ;   too: the SAA5050 ignores the top bit). Each control code takes up one
                      (         text.asm):00012         ;   character position and shows as a space. Text starts white at the
                      (         text.asm):00013         ;   left of the row.
                      (         text.asm):00014         ; ---------------------------------------------------------------------------
                      (         text.asm):00015         
     E7C0             (         text.asm):00016         STATUS          EQU     VDU_BASE+STATUS_ROW*COLS        ; first byte of row 24
                      (         text.asm):00017         
                      (         text.asm):00018         ; ---------------------------------------------------------------------------
                      (         text.asm):00019         ; T_TEXT - write a string to the status row
                      (         text.asm):00020         ;   Entry: A = column (0-39), X -> zero-terminated string, DP = $00
                      (         text.asm):00021         ;   Exit:  all registers preserved
                      (         text.asm):00022         ;   Stops at the right-hand edge rather than wrapping. A column beyond 39
                      (         text.asm):00023         ;   writes nothing.
                      (         text.asm):00024         ; ---------------------------------------------------------------------------
183F 3456             (         text.asm):00025         T_TEXT          PSHS    D,X,U
1841 8127             (         text.asm):00026                         CMPA    #COLS-1         ; column off the end of the row?
1843 2212             (         text.asm):00027                         BHI     TX_X
1845 CEE7C0           (         text.asm):00028                         LDU     #STATUS         ; U -> screen position
1848 33C6             (         text.asm):00029                         LEAU    A,U             ;  (A is 0-39, so the add is safe)
184A 1F89             (         text.asm):00030                         TFR     A,B             ; B = column, to stop at the edge
184C A680             (         text.asm):00031         TX_LOOP         LDA     ,X+             ; next character
184E 2707             (         text.asm):00032                         BEQ     TX_X            ; zero: end of string
1850 A7C0             (         text.asm):00033                         STA     ,U+
1852 5C               (         text.asm):00034                         INCB
1853 C128             (         text.asm):00035                         CMPB    #COLS           ; reached the right-hand edge?
1855 25F5             (         text.asm):00036                         BLO     TX_LOOP
1857 35D6             (         text.asm):00037         TX_X            PULS    D,X,U,PC
                      (         text.asm):00038         
                      (         text.asm):00039         ; ---------------------------------------------------------------------------
                      (         text.asm):00040         ; T_TCLR - clear the status row to spaces
                      (         text.asm):00041         ;   Entry: DP = $00    Exit: all registers preserved
                      (         text.asm):00042         ; ---------------------------------------------------------------------------
1859 3416             (         text.asm):00043         T_TCLR          PSHS    D,X
185B 8EE7C0           (         text.asm):00044                         LDX     #STATUS
185E CC2020           (         text.asm):00045                         LDD     #$2020          ; two spaces at a time
1861 ED81             (         text.asm):00046         TC_LOOP         STD     ,X++
1863 8CE7E8           (         text.asm):00047                         CMPX    #STATUS+COLS
1866 25F9             (         text.asm):00048                         BLO     TC_LOOP
1868 3596             (         text.asm):00049                         PULS    D,X,PC
                      (         text.asm):00050         
                      (         text.asm):00051         ; ---------------------------------------------------------------------------
                      (         text.asm):00052         ; T_TNUM - write a number to the status row
                      (         text.asm):00053         ;   Entry: A = column (0-39), X = value (0-65535, unsigned), DP = $00
                      (         text.asm):00054         ;   Exit:  all registers preserved
                      (         text.asm):00055         ;   Always five characters, right-aligned with leading spaces, so a value
                      (         text.asm):00056         ;   that shrinks (e.g. from 100 to 99) leaves no stray digits behind.
                      (         text.asm):00057         ;
                      (         text.asm):00058         ;   Each digit is found by counting how many times the matching power of
                      (         text.asm):00059         ;   ten can be subtracted (10000, 1000, 100, 10); what is left is the last
                      (         text.asm):00060         ;   digit. Leading zeros become spaces; the last digit is always shown.
                      (         text.asm):00061         ; ---------------------------------------------------------------------------
186A 3476             (         text.asm):00062         T_TNUM          PSHS    D,X,Y,U
186C 1F10             (         text.asm):00063                         TFR     X,D             ; D = value
186E 338D0045         (         text.asm):00064                         LEAU    POW10,PCR       ; U -> 10000, 1000, 100, 10
1872 108E0038         (         text.asm):00065                         LDY     #T_BUF          ; Y -> where the characters go
1876 0F3F             (         text.asm):00066                         CLR     <T_LEAD         ; no non-zero digit yet
1878 0F3E             (         text.asm):00067         TN_DIGIT        CLR     <T_DIG
187A 10A3C4           (         text.asm):00068         TN_SUB          CMPD    ,U              ; can this power be subtracted?
187D 2506             (         text.asm):00069                         BLO     TN_PUT          ;  (unsigned compare)
187F A3C4             (         text.asm):00070                         SUBD    ,U
1881 0C3E             (         text.asm):00071                         INC     <T_DIG
1883 20F5             (         text.asm):00072                         BRA     TN_SUB
1885 3406             (         text.asm):00073         TN_PUT          PSHS    D               ; keep the remainder
1887 963E             (         text.asm):00074                         LDA     <T_DIG
1889 2608             (         text.asm):00075                         BNE     TN_NZ           ; a zero before any other digit
188B 0D3F             (         text.asm):00076                         TST     <T_LEAD         ;  is a leading zero: a space
188D 2606             (         text.asm):00077                         BNE     TN_CH
188F 8620             (         text.asm):00078                         LDA     #' '
1891 2004             (         text.asm):00079                         BRA     TN_ST
1893 0C3F             (         text.asm):00080         TN_NZ           INC     <T_LEAD
1895 8B30             (         text.asm):00081         TN_CH           ADDA    #'0'
1897 A7A0             (         text.asm):00082         TN_ST           STA     ,Y+
1899 3506             (         text.asm):00083                         PULS    D
189B 3342             (         text.asm):00084                         LEAU    2,U             ; next power of ten
189D 308D001E         (         text.asm):00085                         LEAX    POW10E,PCR
18A1 3410             (         text.asm):00086                         PSHS    X
18A3 11A3E1           (         text.asm):00087                         CMPU    ,S++            ; done all four powers?
18A6 25D0             (         text.asm):00088                         BLO     TN_DIGIT
18A8 CB30             (         text.asm):00089                         ADDB    #'0'            ; the last digit, always shown
18AA E7A0             (         text.asm):00090                         STB     ,Y+
18AC 6FA4             (         text.asm):00091                         CLR     ,Y              ; end of string
18AE A6E4             (         text.asm):00092                         LDA     ,S              ; column (caller's A, on the stack)
18B0 8E0038           (         text.asm):00093                         LDX     #T_BUF
18B3 8D8A             (         text.asm):00094                         BSR     T_TEXT
18B5 35F6             (         text.asm):00095                         PULS    D,X,Y,U,PC
                      (         text.asm):00096         
18B7 271003E80064000A (         text.asm):00097         POW10           FDB     10000,1000,100,10
18BF                  (         text.asm):00098         POW10E
                      (      src/tgl.asm):00096                         INCLUDE "colour.asm"
                      (       colour.asm):00001         ; ---------------------------------------------------------------------------
                      (       colour.asm):00002         ; T_COLOUR - set the graphics colour of a band of rows
                      (       colour.asm):00003         ;   Entry: A = first row, B = last row (0-23, cell rows: row r covers
                      (       colour.asm):00004         ;          pixel rows y = 3r to 3r+2), X = colour (1 red, 2 green,
                      (       colour.asm):00005         ;          3 yellow, 4 blue, 5 magenta, 6 cyan, 7 white; only the low
                      (       colour.asm):00006         ;          3 bits are used, and 0 counts as white), DP = $00
                      (       colour.asm):00007         ;   Exit:  all registers preserved
                      (       colour.asm):00008         ;
                      (       colour.asm):00009         ;   Teletext colours a row by the control code at its start: $91-$97 mean
                      (       colour.asm):00010         ;   "graphics in red ... white from here on". The library keeps column 0
                      (       colour.asm):00011         ;   of every buffer row for that code, so changing a row's colour costs no
                      (       colour.asm):00012         ;   pixels and no drawing time. The new code is written into the buffer
                      (       colour.asm):00013         ;   straight away (it shows at the next blit) and remembered in ROWCOL, so
                      (       colour.asm):00014         ;   TGL_CLS keeps it.
                      (       colour.asm):00015         ;   A first row beyond 23 does nothing; a last row beyond 23 counts as 23;
                      (       colour.asm):00016         ;   if first > last nothing changes.
                      (       colour.asm):00017         ; ---------------------------------------------------------------------------
18BF 3456             (       colour.asm):00018         T_COLOUR        PSHS    D,X,U
18C1 8117             (       colour.asm):00019                         CMPA    #ROWS-1         ; first row off the bottom?
18C3 2238             (       colour.asm):00020                         BHI     CO_X
18C5 C117             (       colour.asm):00021                         CMPB    #ROWS-1         ; clamp the last row
18C7 2302             (       colour.asm):00022                         BLS     CO_1
18C9 C617             (       colour.asm):00023                         LDB     #ROWS-1
18CB 9740             (       colour.asm):00024         CO_1            STA     <K_FIRST
18CD D741             (       colour.asm):00025                         STB     <K_LAST
18CF 9141             (       colour.asm):00026                         CMPA    <K_LAST         ; empty band?
18D1 222A             (       colour.asm):00027                         BHI     CO_X
18D3 1F10             (       colour.asm):00028                         TFR     X,D             ; B = colour
18D5 C407             (       colour.asm):00029                         ANDB    #7
18D7 2602             (       colour.asm):00030                         BNE     CO_2
18D9 C607             (       colour.asm):00031                         LDB     #7              ; 0 counts as white
18DB CA90             (       colour.asm):00032         CO_2            ORB     #$90            ; $91-$97: graphics colour codes
18DD D742             (       colour.asm):00033                         STB     <K_CODE
                      (       colour.asm):00034         
18DF 9640             (       colour.asm):00035                         LDA     <K_FIRST        ; U -> ROWCOL entry for the first row
18E1 CE0043           (       colour.asm):00036                         LDU     #ROWCOL
18E4 33C6             (       colour.asm):00037                         LEAU    A,U
18E6 C628             (       colour.asm):00038                         LDB     #COLS           ; X -> column 0 of that buffer row
18E8 3D               (       colour.asm):00039                         MUL                     ;  (first row * 40)
18E9 D300             (       colour.asm):00040                         ADDD    <W_BUF
18EB 1F01             (       colour.asm):00041                         TFR     D,X
18ED D640             (       colour.asm):00042                         LDB     <K_FIRST        ; B counts rows
18EF 9642             (       colour.asm):00043         CO_LOOP         LDA     <K_CODE
18F1 A7C0             (       colour.asm):00044                         STA     ,U+             ; remember it ...
18F3 A784             (       colour.asm):00045                         STA     ,X              ; ... and put it in the buffer
18F5 308828           (       colour.asm):00046                         LEAX    COLS,X          ; next buffer row
18F8 D141             (       colour.asm):00047                         CMPB    <K_LAST         ; was that the last row? (carry set
18FA 5C               (       colour.asm):00048                         INCB                    ;  if not; INCB leaves the carry
18FB 25F2             (       colour.asm):00049                         BLO     CO_LOOP         ;  alone, so BLO still sees it)
18FD 35D6             (       colour.asm):00050         CO_X            PULS    D,X,U,PC
                      (      src/tgl.asm):00097                         INCLUDE "pace.asm"
                      (         pace.asm):00001         ; ---------------------------------------------------------------------------
                      (         pace.asm):00002         ; T_PACE - keep a steady frame rate
                      (         pace.asm):00003         ;   Entry: A = frame length in 50Hz ticks: 1 = 50 fps, 2 = 25 fps,
                      (         pace.asm):00004         ;          3 = about 17 fps (0 counts as 1, more than 3 counts as 3)
                      (         pace.asm):00005         ;          DP = $00
                      (         pace.asm):00006         ;   Exit:  all registers preserved
                      (         pace.asm):00007         ;
                      (         pace.asm):00008         ;   Call once per frame, just before TGL_BLIT. It waits until the frame
                      (         pace.asm):00009         ;   period started by the previous call has run out, then starts the next
                      (         pace.asm):00010         ;   one, so every frame takes the same time however much was drawn. If a
                      (         pace.asm):00011         ;   frame took longer than its period it carries straight on, so the frame
                      (         pace.asm):00012         ;   rate falls gracefully rather than stalling. The first call after
                      (         pace.asm):00013         ;   TGL_INIT starts timing without waiting.
                      (         pace.asm):00014         ;
                      (         pace.asm):00015         ;   The period is timed with Timer 2 of the main VIA, in one-shot mode:
                      (         pace.asm):00016         ;   writing its high byte loads the count and starts it, and IFR bit 5 sets
                      (         pace.asm):00017         ;   when it reaches zero. Only the flag is polled - the timer's interrupt is
                      (         pace.asm):00018         ;   never enabled - and nothing else in the library touches the VIA. A
                      (         pace.asm):00019         ;   program that needs Timer 2 for itself simply doesn't call TGL_PACE, or
                      (         pace.asm):00020         ;   builds the library with NOPACE=1, which reduces this routine to RTS.
                      (         pace.asm):00021         ;
                      (         pace.asm):00022         ;   Timer 2's longest count is 65535 clocks (65ms at 1MHz), which is why
                      (         pace.asm):00023         ;   periods stop at three ticks (60ms).
                      (         pace.asm):00024         ;
                      (         pace.asm):00025         ;   This keeps animation smooth and even, but cannot stop tearing: the
                      (         pace.asm):00026         ;   timer is not locked to the display, as the 6845's vertical sync is not
                      (         pace.asm):00027         ;   connected to anything the CPU can read.
                      (         pace.asm):00028         ; ---------------------------------------------------------------------------
                      (         pace.asm):00029                         IFDEF   TGL_NOPACE
18FF                  (         pace.asm):00030         T_PACE          RTS                     ; NOPACE build: does nothing
                      (         pace.asm):00031                         ELSE
                      (         pace.asm):00032         
18FF 3416             (         pace.asm):00033         T_PACE          PSHS    D,X
1901 4D               (         pace.asm):00034                         TSTA                    ; ticks: 0 counts as 1 ...
1902 2601             (         pace.asm):00035                         BNE     PA_1
1904 4C               (         pace.asm):00036                         INCA
1905 8103             (         pace.asm):00037         PA_1            CMPA    #3              ; ... more than 3 counts as 3
1907 2302             (         pace.asm):00038                         BLS     PA_2
1909 8603             (         pace.asm):00039                         LDA     #3
190B 8EE980           (         pace.asm):00040         PA_2            LDX     #VIA_BASE
190E 0D5B             (         pace.asm):00041                         TST     <P_RUN          ; a period running? wait for it to
1910 2706             (         pace.asm):00042                         BEQ     PA_START        ;  finish (first call: no waiting)
1912 E60D             (         pace.asm):00043         PA_WAIT         LDB     VIA_IFR,X
1914 C520             (         pace.asm):00044                         BITB    #T2_FLAG
1916 27FA             (         pace.asm):00045                         BEQ     PA_WAIT
                      (         pace.asm):00046         
1918 E60B             (         pace.asm):00047         PA_START        LDB     VIA_ACR,X       ; make sure Timer 2 is a one-shot
191A C4DF             (         pace.asm):00048                         ANDB    #~ACR_T2COUNT&$FF   ;  timer, leaving the rest of the
191C E70B             (         pace.asm):00049                         STB     VIA_ACR,X       ;  ACR alone
191E 308D000E         (         pace.asm):00050                         LEAX    PA_TAB-2,PCR    ; X -> period for A ticks (2 bytes
1922 48               (         pace.asm):00051                         ASLA                    ;  each, A = 1-3)
1923 EC86             (         pace.asm):00052                         LDD     A,X
1925 8EE980           (         pace.asm):00053                         LDX     #VIA_BASE
1928 E708             (         pace.asm):00054                         STB     VIA_T2L,X       ; low byte into the latch ...
192A A709             (         pace.asm):00055                         STA     VIA_T2H,X       ; ... high byte starts the count and
                      (         pace.asm):00056                                                 ;  clears the timed-out flag
192C 8601             (         pace.asm):00057                         LDA     #1
192E 975B             (         pace.asm):00058                         STA     <P_RUN
1930 3596             (         pace.asm):00059                         PULS    D,X,PC
                      (         pace.asm):00060         
1932 4E209C40EA60     (         pace.asm):00061         PA_TAB          FDB     TICK,2*TICK,3*TICK
                      (         pace.asm):00062                         ENDC
                      (      src/tgl.asm):00098                         INCLUDE "polygon.asm"
                      (      polygon.asm):00001         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00002         ; Filled convex polygons, and fill patterns
                      (      polygon.asm):00003         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00004         
                      (      polygon.asm):00005         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00006         ; T_SETPAT - choose the fill pattern for TGL_POLYF and TGL_CIRCF
                      (      polygon.asm):00007         ;   Entry: A = pattern (only the low 4 bits are used), DP = $00
                      (      polygon.asm):00008         ;   Exit:  all registers preserved
                      (      polygon.asm):00009         ;   The pattern is a 2x2 block of pixels repeated across the screen:
                      (      polygon.asm):00010         ;     bit 0 = even x, even y    bit 1 = odd x, even y
                      (      polygon.asm):00011         ;     bit 2 = even x, odd y     bit 3 = odd x, odd y
                      (      polygon.asm):00012         ;   15 is solid, 9 a checkerboard, 0 draws nothing. Outlines, lines,
                      (      polygon.asm):00013         ;   plots and rectangles are not affected.
                      (      polygon.asm):00014         ; ---------------------------------------------------------------------------
1938 3402             (      polygon.asm):00015         T_SETPAT        PSHS    A
193A 840F             (      polygon.asm):00016                         ANDA    #$0F
193C 975D             (      polygon.asm):00017                         STA     <U_PAT
193E 3582             (      polygon.asm):00018                         PULS    A,PC
                      (      polygon.asm):00019         
                      (      polygon.asm):00020         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00021         ; T_POLYF - filled convex polygon
                      (      polygon.asm):00022         ;   Entry: X -> corner count n (3 or more), then n pairs x, y (signed bytes,
                      (      polygon.asm):00023         ;          -128..127), in either winding order. DP = $00
                      (      polygon.asm):00024         ;   Exit:  all registers preserved
                      (      polygon.asm):00025         ;   Clips to the screen; uses the current plot mode and fill pattern.
                      (      polygon.asm):00026         ;   The polygon must be convex (every corner pointing outwards); anything
                      (      polygon.asm):00027         ;   else gives an odd-looking but harmless result.
                      (      polygon.asm):00028         ;
                      (      polygon.asm):00029         ;   Fill rule: a pixel is filled when its top-left corner is inside the
                      (      polygon.asm):00030         ;   polygon, i.e. the polygon includes its top and left edges but not its
                      (      polygon.asm):00031         ;   bottom and right ones. Polygons that share an edge therefore neither
                      (      polygon.asm):00032         ;   overlap nor leave a gap, so faces fit together exactly and XOR works
                      (      polygon.asm):00033         ;   across shared edges. (A square from (0,0) to (10,10) fills 10 x 10
                      (      polygon.asm):00034         ;   pixels.)
                      (      polygon.asm):00035         ;
                      (      polygon.asm):00036         ;   How it works: the fill sweeps down a row at a time from the top corner.
                      (      polygon.asm):00037         ;   Two edge walkers set off from the top corner, one going forwards round
                      (      polygon.asm):00038         ;   the corner list and one going backwards; for a convex polygon one runs
                      (      polygon.asm):00039         ;   down the left side and one down the right. Each walker tracks where its
                      (      polygon.asm):00040         ;   edge crosses the current row as a whole part q and a remainder r (the
                      (      polygon.asm):00041         ;   crossing is exactly q + r/dy), so it needs one division when it starts
                      (      polygon.asm):00042         ;   an edge and only additions after that, with no rounding drift. On each
                      (      polygon.asm):00043         ;   row the span runs from the smaller crossing (rounded up) to just before
                      (      polygon.asm):00044         ;   the larger.
                      (      polygon.asm):00045         ;
                      (      polygon.asm):00046         ;   Spans are not drawn a pixel row at a time, which would write every
                      (      polygon.asm):00047         ;   character cell three times. The three spans of a character row are
                      (      polygon.asm):00048         ;   collected first, then CELLROW writes each cell once: the cells all
                      (      polygon.asm):00049         ;   three rows cover completely get one combined mask in a single fast run,
                      (      polygon.asm):00050         ;   and the few cells at the ends get a mask built from exactly the pixels
                      (      polygon.asm):00051         ;   the spans cover.
                      (      polygon.asm):00052         ;
                      (      polygon.asm):00053         ;   Edge walker layout (at CHA and CHB):
     0000             (      polygon.asm):00054         CH_CUR          EQU     0               ; corner the current edge starts at
     0001             (      polygon.asm):00055         CH_NXT          EQU     1               ; corner it ends at
     0002             (      polygon.asm):00056         CH_YB           EQU     2               ; y of the end corner
     0003             (      polygon.asm):00057         CH_Q            EQU     3               ; 2  crossing: whole part (signed)
     0005             (      polygon.asm):00058         CH_QD           EQU     5               ; 2  added to q each row
     0007             (      polygon.asm):00059         CH_R            EQU     7               ; 1  crossing: remainder, 0..dy-1
     0008             (      polygon.asm):00060         CH_RD           EQU     8               ; 1  added to r each row
     0009             (      polygon.asm):00061         CH_DY           EQU     9               ; 1  edge height
     000A             (      polygon.asm):00062         CH_DIR          EQU     10              ; 1  +1 forwards, -1 backwards
                      (      polygon.asm):00063         ; Temporaries borrowed from the clipping code:
     000F             (      polygon.asm):00064         P_XC            EQU     I_U0            ; corner x/y while setting up an edge
     0010             (      polygon.asm):00065         P_XN            EQU     I_U1
     0011             (      polygon.asm):00066         P_YC            EQU     I_V0
     0012             (      polygon.asm):00067         P_YN            EQU     I_V1
     0013             (      polygon.asm):00068         P_CNT           EQU     I_E             ; guard count while skipping
     0018             (      polygon.asm):00069         P_CA            EQU     R_X0            ; the two crossings on this row
     0019             (      polygon.asm):00070         P_CB            EQU     R_Y0
                      (      polygon.asm):00071         ; Character-row compositor (CELLROW) temporaries, also borrowed:
     0038             (      polygon.asm):00072         S_A             EQU     T_BUF           ; 3  left end of each pixel row's span
     003B             (      polygon.asm):00073         S_B             EQU     T_BUF+3         ; 3  right end (S_A + 3)
     003E             (      polygon.asm):00074         S_P             EQU     T_DIG           ; 3  span present? (S_A + 6: T_DIG,
                      (      polygon.asm):00075                                                 ;    T_LEAD, K_FIRST)
     002C             (      polygon.asm):00076         S_ML            EQU     C_CX            ; 3  left-pixel mask of each pixel row
     002F             (      polygon.asm):00077         S_MR            EQU     C_CX+3          ; 3  right-pixel mask (S_ML + 3)
     0032             (      polygon.asm):00078         P_MODD          EQU     C_CX+6          ; 6  pattern masks for odd character
                      (      polygon.asm):00079                                                 ;    rows (C_F+1 .. C_FILL)
     001C             (      polygon.asm):00080         CR_C0           EQU     F_CX0           ; first cell all three rows cover
     001D             (      polygon.asm):00081         CR_C1           EQU     F_CX1           ; last cell all three rows cover
     001E             (      polygon.asm):00082         CR_CMIN         EQU     F_PL            ; first cell any row touches
     001F             (      polygon.asm):00083         CR_CMAX         EQU     F_PR            ; last cell any row touches
     0021             (      polygon.asm):00084         CR_C            EQU     F_RS            ; cell being worked on
     0022             (      polygon.asm):00085         CR_END          EQU     F_RN            ; last cell of the current range
     0023             (      polygon.asm):00086         CR_IDX          EQU     F_TOP           ; character row number
     0024             (      polygon.asm):00087         CR_S            EQU     F_BOTL          ; pixel row within it, $FF = none yet
     0028             (      polygon.asm):00088         CR_ROW          EQU     F_ROW           ; 2  address of the character row
                      (      polygon.asm):00089         ; ---------------------------------------------------------------------------
1940 3476             (      polygon.asm):00090         T_POLYF         PSHS    D,X,Y,U
1942 9F5E             (      polygon.asm):00091                         STX     <P_PTR
1944 A684             (      polygon.asm):00092                         LDA     ,X              ; fewer than 3 corners: nothing
1946 9760             (      polygon.asm):00093                         STA     <P_N
1948 8103             (      polygon.asm):00094                         CMPA    #3
194A 102500E0         (      polygon.asm):00095                         LBLO    PF_X
194E 965D             (      polygon.asm):00096                         LDA     <U_PAT          ; polygons use the fill pattern
1950 975C             (      polygon.asm):00097                         STA     <H_PAT
1952 1700DB           (      polygon.asm):00098                         LBSR    PF_MASKS        ; work out its masks once
                      (      polygon.asm):00099         
                      (      polygon.asm):00100         ; Find the top corner (smallest y) and the bottom y
1955 867F             (      polygon.asm):00101                         LDA     #127
1957 9762             (      polygon.asm):00102                         STA     <P_Y
1959 8680             (      polygon.asm):00103                         LDA     #-128
195B 9761             (      polygon.asm):00104                         STA     <P_YMAX
195D 5F               (      polygon.asm):00105                         CLRB                    ; B = corner index
195E 3404             (      polygon.asm):00106         PF_FIND         PSHS    B
1960 170266           (      polygon.asm):00107                         LBSR    VTX             ; A,B = x,y of corner B
1963 D162             (      polygon.asm):00108                         CMPB    <P_Y            ; higher than the top so far?
1965 2C06             (      polygon.asm):00109                         BGE     PF_F1
1967 D762             (      polygon.asm):00110                         STB     <P_Y
1969 A6E4             (      polygon.asm):00111                         LDA     ,S
196B 9763             (      polygon.asm):00112                         STA     <P_TOP
196D D161             (      polygon.asm):00113         PF_F1           CMPB    <P_YMAX         ; lower than the bottom so far?
196F 2F02             (      polygon.asm):00114                         BLE     PF_F2
1971 D761             (      polygon.asm):00115                         STB     <P_YMAX
1973 3504             (      polygon.asm):00116         PF_F2           PULS    B
1975 5C               (      polygon.asm):00117                         INCB
1976 D160             (      polygon.asm):00118                         CMPB    <P_N
1978 25E4             (      polygon.asm):00119                         BLO     PF_FIND
                      (      polygon.asm):00120         
                      (      polygon.asm):00121         ; Start both edge walkers at the top corner
197A CE0064           (      polygon.asm):00122                         LDU     #CHA
197D 9663             (      polygon.asm):00123                         LDA     <P_TOP
197F A7C4             (      polygon.asm):00124                         STA     CH_CUR,U
1981 8601             (      polygon.asm):00125                         LDA     #1              ; forwards round the list
1983 A74A             (      polygon.asm):00126                         STA     CH_DIR,U
1985 170259           (      polygon.asm):00127                         LBSR    CH_SETUP
1988 CE006F           (      polygon.asm):00128                         LDU     #CHB
198B 9663             (      polygon.asm):00129                         LDA     <P_TOP
198D A7C4             (      polygon.asm):00130                         STA     CH_CUR,U
198F 86FF             (      polygon.asm):00131                         LDA     #-1             ; backwards
1991 A74A             (      polygon.asm):00132                         STA     CH_DIR,U
1993 17024B           (      polygon.asm):00133                         LBSR    CH_SETUP
1996 86FF             (      polygon.asm):00134                         LDA     #$FF            ; no character row started yet
1998 9724             (      polygon.asm):00135                         STA     <CR_S
                      (      polygon.asm):00136         
                      (      polygon.asm):00137         ; One pixel row per pass, from the top corner down to (not including) the
                      (      polygon.asm):00138         ; bottom corner
199A 9662             (      polygon.asm):00139         PF_ROW          LDA     <P_Y
199C 9161             (      polygon.asm):00140                         CMPA    <P_YMAX         ; reached the bottom corner?
199E 102C0083         (      polygon.asm):00141                         LBGE    PF_END
19A2 8147             (      polygon.asm):00142                         CMPA    #YMAX           ; gone off the bottom of the screen?
19A4 102E007D         (      polygon.asm):00143                         LBGT    PF_END
19A8 CE0064           (      polygon.asm):00144                         LDU     #CHA            ; move each walker on to its next
19AB 170224           (      polygon.asm):00145                         LBSR    CH_CHECK        ;  edge if this one has ended
19AE CE006F           (      polygon.asm):00146                         LDU     #CHB
19B1 17021E           (      polygon.asm):00147                         LBSR    CH_CHECK
19B4 CE0064           (      polygon.asm):00148                         LDU     #CHA            ; the two crossings, rounded up
19B7 1702B2           (      polygon.asm):00149                         LBSR    CH_CEIL
19BA D718             (      polygon.asm):00150                         STB     <P_CA
19BC CE006F           (      polygon.asm):00151                         LDU     #CHB
19BF 1702AA           (      polygon.asm):00152                         LBSR    CH_CEIL
19C2 D719             (      polygon.asm):00153                         STB     <P_CB
19C4 9662             (      polygon.asm):00154                         LDA     <P_Y            ; rows above the screen: just step
19C6 102B004A         (      polygon.asm):00155                         LBMI    PF_STEP
19CA 9624             (      polygon.asm):00156                         LDA     <CR_S           ; first row on screen: start the
19CC 81FF             (      polygon.asm):00157                         CMPA    #$FF            ;  character row it falls in
19CE 2603             (      polygon.asm):00158                         BNE     PF_HAVE
19D0 1700AE           (      polygon.asm):00159                         LBSR    CR_START
19D3 9618             (      polygon.asm):00160         PF_HAVE         LDA     <P_CA           ; span from the smaller crossing ...
19D5 D619             (      polygon.asm):00161                         LDB     <P_CB
19D7 3404             (      polygon.asm):00162                         PSHS    B
19D9 A1E0             (      polygon.asm):00163                         CMPA    ,S+
19DB 2727             (      polygon.asm):00164                         BEQ     PF_NEXTS        ; equal: nothing on this row
19DD 2D02             (      polygon.asm):00165                         BLT     PF_1
19DF 1E89             (      polygon.asm):00166                         EXG     A,B             ; A = smaller, B = larger
19E1 5A               (      polygon.asm):00167         PF_1            DECB                    ; ... to just before the larger (no
19E2 4D               (      polygon.asm):00168                         TSTA                    ;  overflow: larger > smaller)
19E3 2A01             (      polygon.asm):00169                         BPL     PF_2            ; clip to the screen: left end ...
19E5 4F               (      polygon.asm):00170                         CLRA
19E6 C14D             (      polygon.asm):00171         PF_2            CMPB    #XMAX           ; ... right end
19E8 2F02             (      polygon.asm):00172                         BLE     PF_3
19EA C64D             (      polygon.asm):00173                         LDB     #XMAX
19EC 3404             (      polygon.asm):00174         PF_3            PSHS    B               ; anything left on screen?
19EE A1E0             (      polygon.asm):00175                         CMPA    ,S+
19F0 2E12             (      polygon.asm):00176                         BGT     PF_NEXTS
19F2 8E0038           (      polygon.asm):00177                         LDX     #S_A            ; keep it as this pixel row's span:
19F5 3404             (      polygon.asm):00178                         PSHS    B               ;  X -> S_A[s]
19F7 D624             (      polygon.asm):00179                         LDB     <CR_S
19F9 3A               (      polygon.asm):00180                         ABX
19FA 3504             (      polygon.asm):00181                         PULS    B
19FC A784             (      polygon.asm):00182                         STA     ,X              ;  S_A[s] = left
19FE E703             (      polygon.asm):00183                         STB     3,X             ;  S_B[s] = right
1A00 8601             (      polygon.asm):00184                         LDA     #1
1A02 A706             (      polygon.asm):00185                         STA     6,X             ;  S_P[s] = present
1A04 9624             (      polygon.asm):00186         PF_NEXTS        LDA     <CR_S           ; next pixel row; after the third,
1A06 4C               (      polygon.asm):00187                         INCA                    ;  write the character row and move
1A07 8103             (      polygon.asm):00188                         CMPA    #3              ;  on to the next one
1A09 2507             (      polygon.asm):00189                         BLO     PF_4
1A0B 17009F           (      polygon.asm):00190                         LBSR    CELLROW
1A0E 17008C           (      polygon.asm):00191                         LBSR    CR_NEXT
1A11 4F               (      polygon.asm):00192                         CLRA
1A12 9724             (      polygon.asm):00193         PF_4            STA     <CR_S
1A14 CE0064           (      polygon.asm):00194         PF_STEP         LDU     #CHA            ; both walkers down a row
1A17 17025C           (      polygon.asm):00195                         LBSR    CH_STEP
1A1A CE006F           (      polygon.asm):00196                         LDU     #CHB
1A1D 170256           (      polygon.asm):00197                         LBSR    CH_STEP
1A20 0C62             (      polygon.asm):00198                         INC     <P_Y
1A22 16FF75           (      polygon.asm):00199                         LBRA    PF_ROW
1A25 9624             (      polygon.asm):00200         PF_END          LDA     <CR_S           ; write the last, partly collected,
1A27 81FF             (      polygon.asm):00201                         CMPA    #$FF            ;  character row (if any)
1A29 2703             (      polygon.asm):00202                         BEQ     PF_X
1A2B 17007F           (      polygon.asm):00203                         LBSR    CELLROW
1A2E 35F6             (      polygon.asm):00204         PF_X            PULS    D,X,Y,U,PC
                      (      polygon.asm):00205         
                      (      polygon.asm):00206         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00207         ; PF_MASKS - work out the pattern's masks for even and odd character rows
                      (      polygon.asm):00208         ;   Pixel row s of character row r is screen row 3r + s, which is odd when
                      (      polygon.asm):00209         ;   r + s is odd. The pattern uses bits 0-1 on even screen rows and bits
                      (      polygon.asm):00210         ;   2-3 on odd ones (left pixel, right pixel). For each kind of character
                      (      polygon.asm):00211         ;   row this gives 3 left-pixel masks then 3 right-pixel masks.
                      (      polygon.asm):00212         ; ---------------------------------------------------------------------------
