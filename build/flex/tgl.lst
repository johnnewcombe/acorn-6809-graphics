1C81 4F               (      polygon.asm):00577                         CLRA                    ;  worked in 16 bits)
1C82 EB48             (      polygon.asm):00578                         ADDB    CH_RD,U
1C84 8900             (      polygon.asm):00579                         ADCA    #0
1C86 4D               (      polygon.asm):00580                         TSTA                    ; 256 or more: certainly >= dy
1C87 2604             (      polygon.asm):00581                         BNE     ST_SUB
1C89 E149             (      polygon.asm):00582                         CMPB    CH_DY,U
