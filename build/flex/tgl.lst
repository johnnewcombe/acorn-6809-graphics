                      (         plot.asm):00002         ; T_SETMODE - select plot mode
                      (         plot.asm):00003         ;   Patches the pre-op and operation bytes in T_PLOT, the four T_LINE
                      (         plot.asm):00004         ;   loops and the rectangle fill, so pixel writes never test the mode.
                      (         plot.asm):00005         ;   Out-of-range modes are ignored.
                      (         plot.asm):00006         ;   Entry: A = MODE_SET, MODE_CLEAR or MODE_XOR, DP = $00
                      (         plot.asm):00007         ;   Exit:  all registers preserved
                      (         plot.asm):00008         ; ---------------------------------------------------------------------------
10EF 8102             (         plot.asm):00009         T_SETMODE       CMPA    #MODE_XOR
10F1 223F             (         plot.asm):00010                         BHI     SETM_X
10F3 3416             (         plot.asm):00011                         PSHS    D,X
10F5 9705             (         plot.asm):00012                         STA     <W_MODE
10F7 308D088A         (         plot.asm):00013                         LEAX    MODETAB,PCR
10FB 48               (         plot.asm):00014                         ASLA
10FC EC86             (         plot.asm):00015                         LDD     A,X             ; A = pre-op byte, B = opcode
10FE A78D0050         (         plot.asm):00016                         STA     PLOT_PRE,PCR
1102 E78D004D         (         plot.asm):00017                         STB     PLOT_OP,PCR
