13C6 2718             (         clip.asm):00044                         BEQ     LC_DRAW         ; both inside
13C8 960D             (         clip.asm):00045                         LDA     <W_C0
13CA 940E             (         clip.asm):00046                         ANDA    <W_C1
13CC 2619             (         clip.asm):00047                         BNE     LC_EXIT         ; both beyond the same edge
13CE 960D             (         clip.asm):00048                         LDA     <W_C0
13D0 2706             (         clip.asm):00049                         BEQ     LC_P1
