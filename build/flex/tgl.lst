                      (         clip.asm):00123         ; ---------------------------------------------------------------------------
                      (         clip.asm):00124         ; ISECT - A = u0 + (u1-u0) * (e-v0) / (v1-v0)
                      (         clip.asm):00125         ;   Rounded to the nearest pixel, which keeps trimmed lines closer to the
                      (         clip.asm):00126         ;   path the unclipped line would take (never more than one pixel off).
                      (         clip.asm):00127         ;   Worked in sign and magnitude: each difference is at most 255, and
                      (         clip.asm):00128         ;   |e-v0| <= |v1-v0| because the edge lies between the endpoints, so the
                      (         clip.asm):00129         ;   product fits 16 bits and the quotient fits 8. The result lies between
                      (         clip.asm):00130         ;   u0 and u1, so plain 8-bit addition gives the right signed value.
                      (         clip.asm):00131         ;   B corrupted.
                      (         clip.asm):00132         ; ---------------------------------------------------------------------------
1421 0F14             (         clip.asm):00133         ISECT           CLR     <I_SGN
1423 9610             (         clip.asm):00134                         LDA     <I_U1           ; |u1-u0|
1425 900F             (         clip.asm):00135                         SUBA    <I_U0
1427 D610             (         clip.asm):00136                         LDB     <I_U1
1429 D10F             (         clip.asm):00137                         CMPB    <I_U0
142B 2C03             (         clip.asm):00138                         BGE     IS_1
142D 40               (         clip.asm):00139                         NEGA
142E 0314             (         clip.asm):00140                         COM     <I_SGN
1430 9715             (         clip.asm):00141         IS_1            STA     <I_DU
1432 9613             (         clip.asm):00142                         LDA     <I_E            ; |e-v0|
1434 9011             (         clip.asm):00143                         SUBA    <I_V0
1436 D613             (         clip.asm):00144                         LDB     <I_E
1438 D111             (         clip.asm):00145                         CMPB    <I_V0
143A 2C03             (         clip.asm):00146                         BGE     IS_2
143C 40               (         clip.asm):00147                         NEGA
143D 0314             (         clip.asm):00148                         COM     <I_SGN
143F D615             (         clip.asm):00149         IS_2            LDB     <I_DU
1441 3D               (         clip.asm):00150                         MUL                     ; D = |u1-u0| * |e-v0|
1442 3406             (         clip.asm):00151                         PSHS    D
1444 9612             (         clip.asm):00152                         LDA     <I_V1           ; |v1-v0|
1446 9011             (         clip.asm):00153                         SUBA    <I_V0
1448 D612             (         clip.asm):00154                         LDB     <I_V1
144A D111             (         clip.asm):00155                         CMPB    <I_V0
144C 2C03             (         clip.asm):00156                         BGE     IS_3
144E 40               (         clip.asm):00157                         NEGA
144F 0314             (         clip.asm):00158                         COM     <I_SGN
1451 9716             (         clip.asm):00159         IS_3            STA     <I_DV
1453 44               (         clip.asm):00160                         LSRA                    ; round: add |v1-v0|/2 before dividing
1454 9717             (         clip.asm):00161                         STA     <I_CNT          ;  (I_CNT as a temporary; DIV8 resets it)
1456 3506             (         clip.asm):00162                         PULS    D
1458 DB17             (         clip.asm):00163                         ADDB    <I_CNT
145A 8900             (         clip.asm):00164                         ADCA    #0
145C 8D0E             (         clip.asm):00165                         BSR     DIV8            ; B = rounded quotient
145E 960F             (         clip.asm):00166                         LDA     <I_U0
1460 3404             (         clip.asm):00167                         PSHS    B
1462 0D14             (         clip.asm):00168                         TST     <I_SGN
1464 2603             (         clip.asm):00169                         BNE     IS_4
1466 ABE0             (         clip.asm):00170                         ADDA    ,S+
1468 39               (         clip.asm):00171                         RTS
1469 A0E0             (         clip.asm):00172         IS_4            SUBA    ,S+
146B 39               (         clip.asm):00173                         RTS
                      (         clip.asm):00174         
                      (         clip.asm):00175         ; ---------------------------------------------------------------------------
                      (         clip.asm):00176         ; DIV8 - unsigned D / I_DV, needs A < I_DV (quotient fits 8 bits)
                      (         clip.asm):00177         ;   Exit: B = quotient, A = remainder
                      (         clip.asm):00178         ; ---------------------------------------------------------------------------
146C 3402             (         clip.asm):00179         DIV8            PSHS    A
146E 8608             (         clip.asm):00180                         LDA     #8
1470 9717             (         clip.asm):00181                         STA     <I_CNT
1472 3502             (         clip.asm):00182                         PULS    A
1474 58               (         clip.asm):00183         DV_LOOP         ASLB                    ; shift dividend left; quotient
1475 49               (         clip.asm):00184                         ROLA                    ;  bits enter B from the right
1476 2504             (         clip.asm):00185                         BCS     DV_SUB
1478 9116             (         clip.asm):00186                         CMPA    <I_DV
147A 2503             (         clip.asm):00187                         BLO     DV_NEXT
147C 9016             (         clip.asm):00188         DV_SUB          SUBA    <I_DV
147E 5C               (         clip.asm):00189                         INCB
147F 0A17             (         clip.asm):00190         DV_NEXT         DEC     <I_CNT
1481 26F1             (         clip.asm):00191                         BNE     DV_LOOP
1483 39               (         clip.asm):00192                         RTS
                      (      src/tgl.asm):00090                         INCLUDE "rect.asm"
                      (         rect.asm):00001         ; ---------------------------------------------------------------------------
                      (         rect.asm):00002         ; Rectangles - outlined and filled
                      (         rect.asm):00003         ;   Both take two opposite corners in the same registers as TGL_LINEC:
                      (         rect.asm):00004         ;   A = x0, B = y0, X = x1 (high byte) : y1 (low byte). Coordinates are
                      (         rect.asm):00005         ;   signed (-128..127), the corners can be in any order, and anything off
                      (         rect.asm):00006         ;   screen is clipped. Both use the current plot mode.
                      (         rect.asm):00007         ; ---------------------------------------------------------------------------
                      (         rect.asm):00008         
                      (         rect.asm):00009         ; ---------------------------------------------------------------------------
                      (         rect.asm):00010         ; T_RECT - outlined rectangle
                      (         rect.asm):00011         ;   Entry: A = x0, B = y0, X = x1:y1 (signed), DP = $00
                      (         rect.asm):00012         ;   Exit:  all registers preserved
                      (         rect.asm):00013         ;
                      (         rect.asm):00014         ;   Drawn as up to four thin filled rectangles that never overlap, so every
                      (         rect.asm):00015         ;   pixel is drawn exactly once (XOR mode can then remove the rectangle
                      (         rect.asm):00016         ;   again), and the fill's cell-at-a-time speed and clipping come for free:
                      (         rect.asm):00017         ;     top     (x0,y0)   - (x1,y0)
                      (         rect.asm):00018         ;     bottom  (x0,y1)   - (x1,y1)     only if y1 > y0
                      (         rect.asm):00019         ;     left    (x0,y0+1) - (x0,y1-1)   only if y1 - y0 >= 2
                      (         rect.asm):00020         ;     right   (x1,y0+1) - (x1,y1-1)   likewise, and only if x1 > x0
                      (         rect.asm):00021         ;   T_RECTF reuses the R_ variables, so the sorted corners are kept on the
                      (         rect.asm):00022         ;   stack: 0,S = x0, 1,S = y0, 2,S = x1, 3,S = y1.
                      (         rect.asm):00023         ; ---------------------------------------------------------------------------
1484 3476             (         rect.asm):00024         T_RECT          PSHS    D,X,Y,U
1486 17017E           (         rect.asm):00025                         LBSR    R_SORT          ; corners sorted into R_X0..R_Y1
1489 DC18             (         rect.asm):00026                         LDD     <R_X0           ; keep a copy on the stack
148B 9E1A             (         rect.asm):00027                         LDX     <R_X1
148D 3416             (         rect.asm):00028                         PSHS    D,X
                      (         rect.asm):00029         
148F A662             (         rect.asm):00030                         LDA     2,S             ; top edge
1491 E661             (         rect.asm):00031                         LDB     1,S
1493 1F01             (         rect.asm):00032                         TFR     D,X             ; X = x1:y0
1495 A6E4             (         rect.asm):00033                         LDA     ,S              ; A,B = x0,y0
1497 17003A           (         rect.asm):00034                         LBSR    T_RECTF
                      (         rect.asm):00035         
149A A663             (         rect.asm):00036                         LDA     3,S             ; bottom edge, if a different row
149C A161             (         rect.asm):00037                         CMPA    1,S
149E 2F30             (         rect.asm):00038                         BLE     RC_X
14A0 A662             (         rect.asm):00039                         LDA     2,S
14A2 E663             (         rect.asm):00040                         LDB     3,S
14A4 1F01             (         rect.asm):00041                         TFR     D,X             ; X = x1:y1
14A6 A6E4             (         rect.asm):00042                         LDA     ,S              ; A,B = x0,y1
14A8 170029           (         rect.asm):00043                         LBSR    T_RECTF
                      (         rect.asm):00044         
14AB A663             (         rect.asm):00045                         LDA     3,S             ; sides, only if there is a gap
14AD 4A               (         rect.asm):00046                         DECA                    ;  between top and bottom
14AE A161             (         rect.asm):00047                         CMPA    1,S             ;  (y1-1 > y0; no overflow, as
14B0 2F1E             (         rect.asm):00048                         BLE     RC_X            ;  y1 > y0 here)
14B2 A6E4             (         rect.asm):00049                         LDA     ,S              ; left side
14B4 E663             (         rect.asm):00050                         LDB     3,S
14B6 5A               (         rect.asm):00051                         DECB
14B7 1F01             (         rect.asm):00052                         TFR     D,X             ; X = x0:y1-1
14B9 E661             (         rect.asm):00053                         LDB     1,S
14BB 5C               (         rect.asm):00054                         INCB                    ; A,B = x0,y0+1
14BC 170015           (         rect.asm):00055                         LBSR    T_RECTF
                      (         rect.asm):00056         
14BF A662             (         rect.asm):00057                         LDA     2,S             ; right side, if a different column
14C1 A1E4             (         rect.asm):00058                         CMPA    ,S
14C3 2F0B             (         rect.asm):00059                         BLE     RC_X
14C5 E663             (         rect.asm):00060                         LDB     3,S
14C7 5A               (         rect.asm):00061                         DECB
14C8 1F01             (         rect.asm):00062                         TFR     D,X             ; X = x1:y1-1
14CA E661             (         rect.asm):00063                         LDB     1,S
14CC 5C               (         rect.asm):00064                         INCB                    ; A,B = x1,y0+1
14CD 170004           (         rect.asm):00065                         LBSR    T_RECTF
14D0 3264             (         rect.asm):00066         RC_X            LEAS    4,S             ; drop the copy
14D2 35F6             (         rect.asm):00067                         PULS    D,X,Y,U,PC
                      (         rect.asm):00068         
                      (         rect.asm):00069         ; ---------------------------------------------------------------------------
                      (         rect.asm):00070         ; T_RECTF - filled rectangle
                      (         rect.asm):00071         ;   Entry: A = x0, B = y0, X = x1:y1 (signed), DP = $00
                      (         rect.asm):00072         ;   Exit:  all registers preserved
                      (         rect.asm):00073         ;
                      (         rect.asm):00074         ;   Works a cell row (three sixel rows) at a time. In each cell row the
                      (         rect.asm):00075         ;   rectangle covers sixel rows top..bottom of every cell, which gives a
                      (         rect.asm):00076         ;   mask for the cell's left pixels (F_ML) and right pixels (F_MR). Along
                      (         rect.asm):00077         ;   the row:
                      (         rect.asm):00078         ;     - if x0 is odd, the first cell gets only its right pixels
                      (         rect.asm):00079         ;     - the cells in between get both: F_ML | F_MR, applied as one run
                      (         rect.asm):00080         ;     - if x1 is even, the last cell gets only its left pixels
                      (         rect.asm):00081         ;     - if the whole width falls in one cell, that cell gets whichever of
                      (         rect.asm):00082         ;       its pixels are inside
                      (         rect.asm):00083         ;   Only the first and last cell rows can be partial vertically (top > 0
                      (         rect.asm):00084         ;   or bottom < 2); every row in between covers all three sixel rows, so
                      (         rect.asm):00085         ;   its masks are constants and need no lookup.
                      (         rect.asm):00086         ; ---------------------------------------------------------------------------
14D4 3476             (         rect.asm):00087         T_RECTF         PSHS    D,X,Y,U
14D6 17012E           (         rect.asm):00088                         LBSR    R_SORT
                      (         rect.asm):00089         
                      (         rect.asm):00090         ; Nothing to do if the rectangle is entirely off one side of the screen
14D9 961A             (         rect.asm):00091                         LDA     <R_X1
14DB 102B0119         (         rect.asm):00092                         LBMI    RF_X            ; right edge left of the screen
14DF 961B             (         rect.asm):00093                         LDA     <R_Y1
14E1 102B0113         (         rect.asm):00094                         LBMI    RF_X            ; bottom edge above the screen
14E5 9618             (         rect.asm):00095                         LDA     <R_X0
14E7 814D             (         rect.asm):00096                         CMPA    #XMAX
14E9 102E010B         (         rect.asm):00097                         LBGT    RF_X            ; left edge right of the screen
14ED 9619             (         rect.asm):00098                         LDA     <R_Y0
14EF 8147             (         rect.asm):00099                         CMPA    #YMAX
14F1 102E0103         (         rect.asm):00100                         LBGT    RF_X            ; top edge below the screen
                      (         rect.asm):00101         
                      (         rect.asm):00102         ; Clip by clamping the edges to the screen
14F5 9618             (         rect.asm):00103                         LDA     <R_X0
14F7 2A02             (         rect.asm):00104                         BPL     RF_1
14F9 0F18             (         rect.asm):00105                         CLR     <R_X0
14FB 9619             (         rect.asm):00106         RF_1            LDA     <R_Y0
14FD 2A02             (         rect.asm):00107                         BPL     RF_2
14FF 0F19             (         rect.asm):00108                         CLR     <R_Y0
1501 961A             (         rect.asm):00109         RF_2            LDA     <R_X1
1503 814D             (         rect.asm):00110                         CMPA    #XMAX
1505 2F04             (         rect.asm):00111                         BLE     RF_3
1507 864D             (         rect.asm):00112                         LDA     #XMAX
1509 971A             (         rect.asm):00113                         STA     <R_X1
150B 961B             (         rect.asm):00114         RF_3            LDA     <R_Y1
150D 8147             (         rect.asm):00115                         CMPA    #YMAX
150F 2F04             (         rect.asm):00116                         BLE     RF_4
1511 8647             (         rect.asm):00117                         LDA     #YMAX
1513 971B             (         rect.asm):00118                         STA     <R_Y1
                      (         rect.asm):00119         
                      (         rect.asm):00120         ; Work out the column plan once: it is the same for every row
1515 9618             (         rect.asm):00121         RF_4            LDA     <R_X0           ; first cell = x0/2, and is x0 odd?
1517 44               (         rect.asm):00122                         LSRA
1518 971C             (         rect.asm):00123                         STA     <F_CX0
151A 8600             (         rect.asm):00124                         LDA     #0              ; (not CLRA: that would clear carry)
151C 49               (         rect.asm):00125                         ROLA                    ; carry (x0 odd) -> bit 0
151D 971E             (         rect.asm):00126                         STA     <F_PL
151F 961A             (         rect.asm):00127                         LDA     <R_X1           ; last cell = x1/2, and is x1 even?
1521 44               (         rect.asm):00128                         LSRA
1522 971D             (         rect.asm):00129                         STA     <F_CX1
1524 8600             (         rect.asm):00130                         LDA     #0              ; keep carry (x1 odd)
1526 49               (         rect.asm):00131                         ROLA
1527 8801             (         rect.asm):00132                         EORA    #1              ; 1 if x1 even
1529 971F             (         rect.asm):00133                         STA     <F_PR
152B 0F20             (         rect.asm):00134                         CLR     <F_SGL
152D 961C             (         rect.asm):00135                         LDA     <F_CX0
152F 911D             (         rect.asm):00136                         CMPA    <F_CX1
1531 2604             (         rect.asm):00137                         BNE     RF_5
1533 0C20             (         rect.asm):00138                         INC     <F_SGL          ; one cell wide
1535 200F             (         rect.asm):00139                         BRA     RF_6
1537 961C             (         rect.asm):00140         RF_5            LDA     <F_CX0          ; full-width run: from the first cell
1539 9B1E             (         rect.asm):00141                         ADDA    <F_PL           ;  (or the one after, if partial)
153B 9721             (         rect.asm):00142                         STA     <F_RS
153D 961D             (         rect.asm):00143                         LDA     <F_CX1          ;  to the last (or the one before)
153F 901F             (         rect.asm):00144                         SUBA    <F_PR
1541 9021             (         rect.asm):00145                         SUBA    <F_RS
1543 4C               (         rect.asm):00146                         INCA
1544 9722             (         rect.asm):00147                         STA     <F_RN           ; number of cells, may be 0
                      (         rect.asm):00148         
                      (         rect.asm):00149         ; Find the first and last cell rows, and where y0 and y1 fall within them
1546 D619             (         rect.asm):00150         RF_6            LDB     <R_Y0
1548 1700D9           (         rect.asm):00151                         LBSR    PT_ENTRY        ; U -> PTAB entry for y0
154B ECC4             (         rect.asm):00152                         LDD     ,U
154D D300             (         rect.asm):00153                         ADDD    <W_BUF
154F DD28             (         rect.asm):00154                         STD     <F_ROW          ; first cell row (column 1)
1551 A642             (         rect.asm):00155                         LDA     2,U
1553 1700DA           (         rect.asm):00156                         LBSR    SUBROW
1556 9723             (         rect.asm):00157                         STA     <F_TOP          ; y0 mod 3
1558 D61B             (         rect.asm):00158                         LDB     <R_Y1
155A 1700C7           (         rect.asm):00159                         LBSR    PT_ENTRY
155D ECC4             (         rect.asm):00160                         LDD     ,U
155F D300             (         rect.asm):00161                         ADDD    <W_BUF
1561 DD2A             (         rect.asm):00162                         STD     <F_LAST         ; last cell row
1563 A642             (         rect.asm):00163                         LDA     2,U
1565 1700C8           (         rect.asm):00164                         LBSR    SUBROW
1568 9724             (         rect.asm):00165                         STA     <F_BOTL         ; y1 mod 3
                      (         rect.asm):00166         
                      (         rect.asm):00167         ; One cell row per pass
156A 9E28             (         rect.asm):00168         RF_ROW          LDX     <F_ROW          ; is this the last cell row?
156C 9C2A             (         rect.asm):00169                         CMPX    <F_LAST
156E 2712             (         rect.asm):00170                         BEQ     RF_LASTR
1570 0D23             (         rect.asm):00171                         TST     <F_TOP          ; a middle row: all three sixel rows
1572 260A             (         rect.asm):00172                         BNE     RF_FIRST        ;  are covered, so the masks are
1574 8615             (         rect.asm):00173                         LDA     #$15            ;  constants (left pixels 1+4+16,
1576 9725             (         rect.asm):00174                         STA     <F_ML           ;  right pixels 2+8+64) - no need
1578 864A             (         rect.asm):00175                         LDA     #$4A            ;  to look them up
157A 9726             (         rect.asm):00176                         STA     <F_MR
157C 201F             (         rect.asm):00177                         BRA     RF_COLS
157E C602             (         rect.asm):00178         RF_FIRST        LDB     #2              ; first row (starts part-way down):
1580 2002             (         rect.asm):00179                         BRA     RF_7            ;  sixel rows top..2
1582 D624             (         rect.asm):00180         RF_LASTR        LDB     <F_BOTL         ; last row: sixel rows top..y1 mod 3
1584 9623             (         rect.asm):00181         RF_7            LDA     <F_TOP          ; index = top*3 + bottom
1586 3404             (         rect.asm):00182                         PSHS    B
1588 C603             (         rect.asm):00183                         LDB     #3
158A 3D               (         rect.asm):00184                         MUL                     ; B = top*3 (A is 0)
158B EBE0             (         rect.asm):00185                         ADDB    ,S+
158D 338D0498         (         rect.asm):00186                         LEAU    LTAB,PCR        ; masks for this cell row
1591 A6C5             (         rect.asm):00187                         LDA     B,U
1593 9725             (         rect.asm):00188                         STA     <F_ML
1595 338D0499         (         rect.asm):00189                         LEAU    RTAB,PCR
1599 A6C5             (         rect.asm):00190                         LDA     B,U
159B 9726             (         rect.asm):00191                         STA     <F_MR
                      (         rect.asm):00192         
159D 0D20             (         rect.asm):00193         RF_COLS         TST     <F_SGL          ; one cell wide?
159F 2718             (         rect.asm):00194                         BEQ     RF_MULTI
15A1 4F               (         rect.asm):00195                         CLRA                    ; its left pixels count if x0 even,
15A2 0D1E             (         rect.asm):00196                         TST     <F_PL           ;  its right pixels if x1 odd
15A4 2602             (         rect.asm):00197                         BNE     RF_8
15A6 9A25             (         rect.asm):00198                         ORA     <F_ML
15A8 0D1F             (         rect.asm):00199         RF_8            TST     <F_PR
15AA 2602             (         rect.asm):00200                         BNE     RF_9
15AC 9A26             (         rect.asm):00201                         ORA     <F_MR
15AE 9E28             (         rect.asm):00202         RF_9            LDX     <F_ROW
15B0 D61C             (         rect.asm):00203                         LDB     <F_CX0
15B2 3A               (         rect.asm):00204                         ABX
15B3 C601             (         rect.asm):00205                         LDB     #1
15B5 8D43             (         rect.asm):00206                         BSR     FILLSEG
