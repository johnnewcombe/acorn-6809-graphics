229B 9711             (         dash.asm):00320                         STA     <D_X1           ; offset of the cell in the row
229D D722             (         dash.asm):00321                         STB     <D_E2           ;  (and which mask)
229F D610             (         dash.asm):00322         DVT_LOOP         LDB     <D_Y            ; on screen?
22A1 C147             (         dash.asm):00323                         CMPB    #YMAX
22A3 2212             (         dash.asm):00324                         BHI     DVT_SKIP
22A5 ECC4             (         dash.asm):00325                         LDD     ,U              ; X -> the cell
22A7 D300             (         dash.asm):00326                         ADDD    <W_BUF
22A9 1F01             (         dash.asm):00327                         TFR     D,X
22AB D611             (         dash.asm):00328                         LDB     <D_X1
22AD 3A               (         dash.asm):00329                         ABX
22AE D622             (         dash.asm):00330                         LDB     <D_E2           ; its mask
22B0 A6C5             (         dash.asm):00331                         LDA     B,U
22B2 17FE9D           (         dash.asm):00332                         LBSR    DOP
22B5 2003             (         dash.asm):00333                         BRA     DVT_STEP
