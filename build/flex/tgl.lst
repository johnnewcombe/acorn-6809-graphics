                      (         rect.asm):00264         ;   Entry: A = x0, B = y0, X = x1:y1 (signed)    Exit: A, B corrupted
                      (         rect.asm):00265         ; ---------------------------------------------------------------------------
162E DD18             (         rect.asm):00266         R_SORT          STD     <R_X0
1630 9F1A             (         rect.asm):00267                         STX     <R_X1
1632 9618             (         rect.asm):00268                         LDA     <R_X0
1634 911A             (         rect.asm):00269                         CMPA    <R_X1
1636 2F06             (         rect.asm):00270                         BLE     RS_1
