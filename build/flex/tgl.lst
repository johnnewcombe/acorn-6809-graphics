2289 9B13             (         dash.asm):00305                         ADDA    <D_SX
228B 970F             (         dash.asm):00306                         STA     <D_X
228D 20F1             (         dash.asm):00307                         BRA     DHZ_OFF
228F 39               (         dash.asm):00308         DHZ_X            RTS
                      (         dash.asm):00309         
                      (         dash.asm):00310         ; DVT - vertical: x is fixed, so its offset in the row (D_X1, no longer
