                      (      src/tgl.asm):00100                         INCLUDE "flip.asm"
                      (         flip.asm):00001         ; ---------------------------------------------------------------------------
                      (         flip.asm):00002         ; T_FLIPH - flip the picture left-to-right, as an animated card turn
                      (         flip.asm):00003         ;   Entry: A = frame length in 50Hz ticks (1-3: 2 is about 0.65 seconds in
                      (         flip.asm):00004         ;          all, 3 about 1 second), DP = $00
                      (         flip.asm):00005         ;   Exit:  all registers preserved. The buffer now holds the mirror image,
                      (         flip.asm):00006         ;          and the screen shows it.
                      (         flip.asm):00007         ;   Uses about 90 bytes of stack.
                      (         flip.asm):00008         ;
                      (         flip.asm):00009         ;   Animates whatever is in the off-screen buffer: the picture narrows
                      (         flip.asm):00010         ;   towards the centre line, goes edge-on, and opens out again mirror
                      (         flip.asm):00011         ;   reversed, like a card turning over. It runs for 15 frames drawn
                      (         flip.asm):00012         ;   straight onto the screen, each paced by TGL_PACE (so a NOPACE build
                      (         flip.asm):00013         ;   runs it as fast as it can), then the buffer is mirrored for real and
                      (         flip.asm):00014         ;   blitted. Row colours (column 0) are left as they are.
                      (         flip.asm):00015         ;
                      (         flip.asm):00016         ;   Each frame, the width follows a cosine curve (the way a turning card
                      (         flip.asm):00017         ;   looks), so screen pixel column X shows source column
                      (         flip.asm):00018         ;       38.5 + (X - 38.5) * s,   s = 1 / cos(angle)
                      (         flip.asm):00019         ;   with s < 0 in the second half giving the mirror image. FL_MAP works
                      (         flip.asm):00020         ;   this out for all 78 columns into a table on the stack, stepping out
                      (         flip.asm):00021         ;   from the centre by s each column (no division). FL_DRAW then builds
                      (         flip.asm):00022         ;   each screen cell from its two source pixels using four lookup tables -
                      (         flip.asm):00023         ;   left pixel to left, right to left, left to right, right to right - in
                      (         flip.asm):00024         ;   a row loop whose offsets are patched in for each column.
                      (         flip.asm):00025         ;
                      (         flip.asm):00026         ;   Workspace borrowed from routines that never run at the same time:
     001A             (         flip.asm):00027         FL_TICKS        EQU     R_X1            ; frame length (for TGL_PACE)
     001B             (         flip.asm):00028         FL_K            EQU     R_Y1            ; frame number, 1-15
     000F             (         flip.asm):00029         FL_S            EQU     I_U0            ; 2  this frame's s (8.8 fixed point)
     0011             (         flip.asm):00030         FL_O            EQU     I_V0            ; 2  distance from the centre, source
     0013             (         flip.asm):00031         FL_J            EQU     I_E             ; column counter
     0014             (         flip.asm):00032         FL_COL          EQU     I_SGN           ; screen cell column, 0-38
     0015             (         flip.asm):00033         FL_CNT          EQU     I_DU            ; row counter
     001D             (         flip.asm):00034         FL_PL           EQU     F_CX1           ; source pixel for a cell's left half
     001E             (         flip.asm):00035         FL_PR           EQU     F_PL            ;  ... and its right half
     0028             (         flip.asm):00036         FL_SRC          EQU     F_ROW           ; 2  address of the column map
                      (         flip.asm):00037         ; ---------------------------------------------------------------------------
1C9D 3476             (         flip.asm):00038         T_FLIPH         PSHS    D,X,Y,U
1C9F 971A             (         flip.asm):00039                         STA     <FL_TICKS
1CA1 32E8B2           (         flip.asm):00040                         LEAS    -78,S           ; the column map: 78 bytes of stack
1CA4 10DF28           (         flip.asm):00041                         STS     <FL_SRC
1CA7 9E00             (         flip.asm):00042                         LDX     <W_BUF          ; row colour codes onto the screen
1CA9 CEE400           (         flip.asm):00043                         LDU     #VDU_BASE       ;  (column 0 never changes)
1CAC C618             (         flip.asm):00044                         LDB     #ROWS
1CAE A684             (         flip.asm):00045         FL_C0           LDA     ,X
1CB0 A7C4             (         flip.asm):00046                         STA     ,U
1CB2 308828           (         flip.asm):00047                         LEAX    COLS,X
1CB5 33C828           (         flip.asm):00048                         LEAU    COLS,U
1CB8 5A               (         flip.asm):00049                         DECB
1CB9 26F3             (         flip.asm):00050                         BNE     FL_C0
1CBB 8601             (         flip.asm):00051                         LDA     #1
1CBD 971B             (         flip.asm):00052                         STA     <FL_K
1CBF 308D01A2         (         flip.asm):00053         FL_FRAME        LEAX    FL_STAB-2,PCR   ; s for this frame
1CC3 D61B             (         flip.asm):00054                         LDB     <FL_K
1CC5 58               (         flip.asm):00055                         ASLB
1CC6 3A               (         flip.asm):00056                         ABX
1CC7 EC84             (         flip.asm):00057                         LDD     ,X
1CC9 DD0F             (         flip.asm):00058                         STD     <FL_S
1CCB 17001B           (         flip.asm):00059                         LBSR    FL_MAP          ; which source column for each column
1CCE 170074           (         flip.asm):00060                         LBSR    FL_DRAW         ; draw the frame on the screen
1CD1 961A             (         flip.asm):00061                         LDA     <FL_TICKS       ; and pace it
1CD3 17FC2C           (         flip.asm):00062                         LBSR    T_PACE
1CD6 0C1B             (         flip.asm):00063                         INC     <FL_K
1CD8 961B             (         flip.asm):00064                         LDA     <FL_K
1CDA 8110             (         flip.asm):00065                         CMPA    #16
1CDC 25E1             (         flip.asm):00066                         BLO     FL_FRAME
1CDE 17013F           (         flip.asm):00067                         LBSR    FL_MIRROR       ; the buffer becomes the mirror image
1CE1 32E84E           (         flip.asm):00068                         LEAS    78,S
1CE4 17F67A           (         flip.asm):00069                         LBSR    T_BLIT          ; and the screen shows it
1CE7 35F6             (         flip.asm):00070                         PULS    D,X,Y,U,PC
                      (         flip.asm):00071         
                      (         flip.asm):00072         ; ---------------------------------------------------------------------------
                      (         flip.asm):00073         ; FL_MAP - fill the column map: for each screen pixel column X (0-77), the
                      (         flip.asm):00074         ;   source pixel column it shows, or $FF for none (beyond the picture).
                      (         flip.asm):00075         ;   Works out from the centre: at distance j + 0.5 the source is at
                      (         flip.asm):00076         ;   38.5 +/- o with o = (j + 0.5) * s, so o starts at s/2 and grows by s
                      (         flip.asm):00077         ;   each column. Rounded to the nearest column: source = (39*256 +/- o) / 256
                      (         flip.asm):00078         ;   in 8.8 fixed point. Stops once o is beyond the picture's edge.
                      (         flip.asm):00079         ; ---------------------------------------------------------------------------
1CE9 9E28             (         flip.asm):00080         FL_MAP          LDX     <FL_SRC         ; start with every column blank
1CEB 86FF             (         flip.asm):00081                         LDA     #$FF
1CED C64E             (         flip.asm):00082                         LDB     #78
1CEF A780             (         flip.asm):00083         FM_CLR          STA     ,X+
1CF1 5A               (         flip.asm):00084                         DECB
1CF2 26FB             (         flip.asm):00085                         BNE     FM_CLR
1CF4 DC0F             (         flip.asm):00086                         LDD     <FL_S           ; o = s / 2
1CF6 47               (         flip.asm):00087                         ASRA
1CF7 56               (         flip.asm):00088                         RORB
1CF8 DD11             (         flip.asm):00089                         STD     <FL_O
1CFA 0F13             (         flip.asm):00090                         CLR     <FL_J
1CFC DC11             (         flip.asm):00091         FM_LOOP         LDD     <FL_O           ; |o| beyond the picture? stop
1CFE 2A05             (         flip.asm):00092                         BPL     FM_1
1D00 43               (         flip.asm):00093                         COMA
1D01 53               (         flip.asm):00094                         COMB
1D02 C30001           (         flip.asm):00095                         ADDD    #1
1D05 10832800         (         flip.asm):00096         FM_1            CMPD    #40*256
1D09 2239             (         flip.asm):00097                         BHI     FM_X
1D0B CC2700           (         flip.asm):00098                         LDD     #39*256         ; right side: X = 39 + j shows
1D0E D311             (         flip.asm):00099                         ADDD    <FL_O           ;  39*256 + o
1D10 2B0E             (         flip.asm):00100                         BMI     FM_2            ;  (off the left of the picture)
1D12 10834E00         (         flip.asm):00101                         CMPD    #78*256
1D16 2C08             (         flip.asm):00102                         BGE     FM_2            ;  (off the right)
1D18 9E28             (         flip.asm):00103                         LDX     <FL_SRC         ; A = source column
1D1A D613             (         flip.asm):00104                         LDB     <FL_J
1D1C 3A               (         flip.asm):00105                         ABX
1D1D A78827           (         flip.asm):00106                         STA     39,X
1D20 CC2700           (         flip.asm):00107         FM_2            LDD     #39*256         ; left side: X = 38 - j shows
1D23 9311             (         flip.asm):00108                         SUBD    <FL_O           ;  39*256 - o
1D25 2B0F             (         flip.asm):00109                         BMI     FM_3
1D27 10834E00         (         flip.asm):00110                         CMPD    #78*256
1D2B 2C09             (         flip.asm):00111                         BGE     FM_3
1D2D 9E28             (         flip.asm):00112                         LDX     <FL_SRC
1D2F C626             (         flip.asm):00113                         LDB     #38
1D31 D013             (         flip.asm):00114                         SUBB    <FL_J
1D33 3A               (         flip.asm):00115                         ABX
1D34 A784             (         flip.asm):00116                         STA     ,X
1D36 DC11             (         flip.asm):00117         FM_3            LDD     <FL_O           ; next column out
1D38 D30F             (         flip.asm):00118                         ADDD    <FL_S
1D3A DD11             (         flip.asm):00119                         STD     <FL_O
1D3C 0C13             (         flip.asm):00120                         INC     <FL_J
1D3E 9613             (         flip.asm):00121                         LDA     <FL_J
1D40 8127             (         flip.asm):00122                         CMPA    #39
1D42 25B8             (         flip.asm):00123                         BLO     FM_LOOP
1D44 39               (         flip.asm):00124         FM_X            RTS
                      (         flip.asm):00125         
                      (         flip.asm):00126         ; ---------------------------------------------------------------------------
                      (         flip.asm):00127         ; FL_DRAW - draw one frame onto the screen from the buffer and column map
                      (         flip.asm):00128         ;   For each screen cell column: its left pixel shows source pixel PL and
                      (         flip.asm):00129         ;   its right pixel source pixel PR. Source pixel p is the left (p even) or
                      (         flip.asm):00130         ;   right (p odd) pixel of source cell p/2, so the left half of each screen
                      (         flip.asm):00131         ;   cell is LLT[byte] or RLT[byte] of that source cell (U points at the
                      (         flip.asm):00132         ;   table) and the right half LRT[byte] or RRT[byte] (Y). A blank half uses
                      (         flip.asm):00133         ;   a table of constants instead (all $20 on the left, all 0 on the right).
                      (         flip.asm):00134         ;   The cell offsets and screen offsets are patched into a row loop that
                      (         flip.asm):00135         ;   does three rows per pass; columns with both halves blank just get
                      (         flip.asm):00136         ;   spaces.
                      (         flip.asm):00137         ; ---------------------------------------------------------------------------
1D45 0F14             (         flip.asm):00138         FL_DRAW         CLR     <FL_COL
1D47 9E28             (         flip.asm):00139         FD_COL          LDX     <FL_SRC         ; PL, PR for this cell column
1D49 D614             (         flip.asm):00140                         LDB     <FL_COL
1D4B 58               (         flip.asm):00141                         ASLB
1D4C 3A               (         flip.asm):00142                         ABX
1D4D EC84             (         flip.asm):00143                         LDD     ,X
1D4F DD1D             (         flip.asm):00144                         STD     <FL_PL
1D51 CCE400           (         flip.asm):00145                         LDD     #VDU_BASE       ; screen offset from the buffer row:
1D54 9300             (         flip.asm):00146                         SUBD    <W_BUF          ;  VDU_BASE + column - W_BUF (it can
1D56 DB14             (         flip.asm):00147                         ADDB    <FL_COL         ;  wrap round 64K, which is fine)
1D58 8900             (         flip.asm):00148                         ADCA    #0
1D5A 9E00             (         flip.asm):00149                         LDX     <W_BUF          ; X -> column 1 of buffer row 0
1D5C 3001             (         flip.asm):00150                         LEAX    1,X
1D5E DE1D             (         flip.asm):00151                         LDU     <FL_PL          ; both halves blank: spaces
1D60 1183FFFF         (         flip.asm):00152                         CMPU    #$FFFF
1D64 102700A2         (         flip.asm):00153                         LBEQ    FD_BLANK
1D68 ED8D006E         (         flip.asm):00154                         STD     FG_D0+2,PCR     ; screen offsets for the 3 rows
1D6C C30028           (         flip.asm):00155                         ADDD    #COLS
1D6F ED8D0075         (         flip.asm):00156                         STD     FG_D1+2,PCR
1D73 C30028           (         flip.asm):00157                         ADDD    #COLS
1D76 ED8D007C         (         flip.asm):00158                         STD     FG_D2+2,PCR
                      (         flip.asm):00159         
1D7A 961D             (         flip.asm):00160                         LDA     <FL_PL          ; left half
1D7C 81FF             (         flip.asm):00161                         CMPA    #$FF
1D7E 2607             (         flip.asm):00162                         BNE     FD_L1
1D80 338D00E1         (         flip.asm):00163                         LEAU    FL_K20-$20,PCR  ; blank: a constant $20
1D84 4F               (         flip.asm):00164                         CLRA                    ;  (any cell will do)
1D85 200B             (         flip.asm):00165                         BRA     FD_L2
1D87 44               (         flip.asm):00166         FD_L1           LSRA                    ; A = source cell, carry = right pixel
1D88 338D0199         (         flip.asm):00167                         LEAU    FL_LLT-$20,PCR  ; source left pixel -> left (LEA
1D8C 2404             (         flip.asm):00168                         BCC     FD_L2           ;  leaves the carry)
1D8E 338D01F3         (         flip.asm):00169                         LEAU    FL_RLT-$20,PCR  ; source right pixel -> left
1D92 A78D003A         (         flip.asm):00170         FD_L2           STA     FG_L0+2,PCR     ; patch the source offsets for the
1D96 8B28             (         flip.asm):00171                         ADDA    #COLS           ;  3 rows
1D98 A78D0042         (         flip.asm):00172                         STA     FG_L1+2,PCR
1D9C 8B28             (         flip.asm):00173                         ADDA    #COLS
1D9E A78D004A         (         flip.asm):00174                         STA     FG_L2+2,PCR
                      (         flip.asm):00175         
