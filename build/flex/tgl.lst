                      (         flip.asm):00133         ; ---------------------------------------------------------------------------
                      (         flip.asm):00134         ; FL_DRAW - draw one frame onto the screen from the buffer and column map
                      (         flip.asm):00135         ;   For each screen cell column: its left pixel shows source pixel PL and
                      (         flip.asm):00136         ;   its right pixel source pixel PR. Source pixel p is the left (p even) or
                      (         flip.asm):00137         ;   right (p odd) pixel of source cell p/2, so the left half of each screen
                      (         flip.asm):00138         ;   cell is LLT[byte] or RLT[byte] of that source cell (U points at the
                      (         flip.asm):00139         ;   table) and the right half LRT[byte] or RRT[byte] (Y). A blank half uses
                      (         flip.asm):00140         ;   a table of constants instead (all $20 on the left, all 0 on the right).
                      (         flip.asm):00141         ;   The cell offsets and screen offsets are patched into a row loop that
                      (         flip.asm):00142         ;   does three rows per pass; columns with both halves blank just get
                      (         flip.asm):00143         ;   spaces.
                      (         flip.asm):00144         ; ---------------------------------------------------------------------------
1D58 0F14             (         flip.asm):00145         FL_DRAW         CLR     <FL_COL
1D5A 9E28             (         flip.asm):00146         FD_COL          LDX     <FL_SRC         ; PL, PR for this cell column
1D5C D614             (         flip.asm):00147                         LDB     <FL_COL
1D5E 58               (         flip.asm):00148                         ASLB
1D5F 3A               (         flip.asm):00149                         ABX
1D60 EC84             (         flip.asm):00150                         LDD     ,X
1D62 DD1D             (         flip.asm):00151                         STD     <FL_PL
1D64 CCE400           (         flip.asm):00152                         LDD     #VDU_BASE       ; screen offset from the buffer row:
1D67 9300             (         flip.asm):00153                         SUBD    <W_BUF          ;  VDU_BASE + column - W_BUF (it can
1D69 DB14             (         flip.asm):00154                         ADDB    <FL_COL         ;  wrap round 64K, which is fine)
1D6B 8900             (         flip.asm):00155                         ADCA    #0
1D6D 9E00             (         flip.asm):00156                         LDX     <W_BUF          ; X -> first pixel column of buffer
1D6F 3001             (         flip.asm):00157                         LEAX    COL1,X          ;  row 0
1D71 DE1D             (         flip.asm):00158                         LDU     <FL_PL          ; both halves blank: spaces
1D73 1183FFFF         (         flip.asm):00159                         CMPU    #$FFFF
1D77 102700A2         (         flip.asm):00160                         LBEQ    FD_BLANK
1D7B ED8D006E         (         flip.asm):00161                         STD     FG_D0+2,PCR     ; screen offsets for the 3 rows
1D7F C30028           (         flip.asm):00162                         ADDD    #COLS
1D82 ED8D0075         (         flip.asm):00163                         STD     FG_D1+2,PCR
1D86 C30028           (         flip.asm):00164                         ADDD    #COLS
1D89 ED8D007C         (         flip.asm):00165                         STD     FG_D2+2,PCR
                      (         flip.asm):00166         
1D8D 961D             (         flip.asm):00167                         LDA     <FL_PL          ; left half
1D8F 81FF             (         flip.asm):00168                         CMPA    #$FF
1D91 2607             (         flip.asm):00169                         BNE     FD_L1
1D93 338D00E1         (         flip.asm):00170                         LEAU    FL_K20-$20,PCR  ; blank: a constant $20
1D97 4F               (         flip.asm):00171                         CLRA                    ;  (any cell will do)
1D98 200B             (         flip.asm):00172                         BRA     FD_L2
1D9A 44               (         flip.asm):00173         FD_L1           LSRA                    ; A = source cell, carry = right pixel
1D9B 338D0199         (         flip.asm):00174                         LEAU    FL_LLT-$20,PCR  ; source left pixel -> left (LEA
1D9F 2404             (         flip.asm):00175                         BCC     FD_L2           ;  leaves the carry)
