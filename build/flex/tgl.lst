1674 2618             (       circle.asm):00103                         BNE     RD_TWO
1676 962C             (       circle.asm):00104                         LDA     <C_CX           ; one span: left end ...
1678 9033             (       circle.asm):00105                         SUBA    <C_HC
167A 2802             (       circle.asm):00106                         BVC     RD_1
167C 8680             (       circle.asm):00107                         LDA     #-128
167E 3402             (       circle.asm):00108         RD_1            PSHS    A
1680 962C             (       circle.asm):00109                         LDA     <C_CX           ; ... right end
1682 9B33             (       circle.asm):00110                         ADDA    <C_HC
