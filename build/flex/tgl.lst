176D 2041             (       circle.asm):00223                         BRA     HS_X
                      (       circle.asm):00224         
176F 0D1E             (       circle.asm):00225         HS_MULTI        TST     <F_PL           ; partial first cell: right pixel
1771 270E             (       circle.asm):00226                         BEQ     HS_5
1773 3410             (       circle.asm):00227                         PSHS    X
1775 D61C             (       circle.asm):00228                         LDB     <F_CX0
1777 3A               (       circle.asm):00229                         ABX
1778 9626             (       circle.asm):00230                         LDA     <F_MR
177A C601             (       circle.asm):00231                         LDB     #1
177C 17FE7B           (       circle.asm):00232                         LBSR    FILLSEG
177F 3510             (       circle.asm):00233                         PULS    X
1781 961C             (       circle.asm):00234         HS_5            LDA     <F_CX0          ; whole cells: from the first (or the
1783 9B1E             (       circle.asm):00235                         ADDA    <F_PL           ;  one after) to the last (or the
1785 9721             (       circle.asm):00236                         STA     <F_RS           ;  one before)
1787 961D             (       circle.asm):00237                         LDA     <F_CX1
1789 901F             (       circle.asm):00238                         SUBA    <F_PR
178B 9021             (       circle.asm):00239                         SUBA    <F_RS
178D 4C               (       circle.asm):00240                         INCA
178E 2712             (       circle.asm):00241                         BEQ     HS_6            ; none
1790 9722             (       circle.asm):00242                         STA     <F_RN
1792 3410             (       circle.asm):00243                         PSHS    X
1794 D621             (       circle.asm):00244                         LDB     <F_RS
1796 3A               (       circle.asm):00245                         ABX
1797 9625             (       circle.asm):00246                         LDA     <F_ML
1799 9A26             (       circle.asm):00247                         ORA     <F_MR
179B D622             (       circle.asm):00248                         LDB     <F_RN
179D 17FE5A           (       circle.asm):00249                         LBSR    FILLSEG
17A0 3510             (       circle.asm):00250                         PULS    X
17A2 0D1F             (       circle.asm):00251         HS_6            TST     <F_PR           ; partial last cell: left pixel
17A4 270A             (       circle.asm):00252                         BEQ     HS_X
17A6 D61D             (       circle.asm):00253                         LDB     <F_CX1
17A8 3A               (       circle.asm):00254                         ABX
17A9 9625             (       circle.asm):00255                         LDA     <F_ML
17AB C601             (       circle.asm):00256                         LDB     #1
17AD 17FE4A           (       circle.asm):00257                         LBSR    FILLSEG
17B0 3586             (       circle.asm):00258         HS_X            PULS    A,B,PC
                      (       circle.asm):00259         
                      (       circle.asm):00260         ; ---------------------------------------------------------------------------
                      (       circle.asm):00261         ; NEXTX - move on to the next row: update f and x, return the next row's
                      (       circle.asm):00262         ;   scaled half-width in A. (C_ROW still holds the current row offset y.)
                      (       circle.asm):00263         ; ---------------------------------------------------------------------------
17B2 D62F             (       circle.asm):00264         NEXTX           LDB     <C_ROW          ; f = f + 2y + 1
17B4 4F               (       circle.asm):00265                         CLRA
17B5 58               (       circle.asm):00266                         ASLB
17B6 49               (       circle.asm):00267                         ROLA
17B7 C30001           (       circle.asm):00268                         ADDD    #1
17BA D331             (       circle.asm):00269                         ADDD    <C_F
17BC DD31             (       circle.asm):00270                         STD     <C_F
17BE DC31             (       circle.asm):00271         NX_LOOP         LDD     <C_F            ; while f > 0 (and x > 0) ...
17C0 2F18             (       circle.asm):00272                         BLE     NX_DONE
17C2 0D30             (       circle.asm):00273                         TST     <C_X
17C4 2714             (       circle.asm):00274                         BEQ     NX_DONE
17C6 D630             (       circle.asm):00275                         LDB     <C_X            ; ... f = f - (2x - 1)
17C8 4F               (       circle.asm):00276                         CLRA
17C9 58               (       circle.asm):00277                         ASLB
17CA 49               (       circle.asm):00278                         ROLA
17CB 830001           (       circle.asm):00279                         SUBD    #1
17CE 3406             (       circle.asm):00280                         PSHS    D
17D0 DC31             (       circle.asm):00281                         LDD     <C_F
17D2 A3E1             (       circle.asm):00282                         SUBD    ,S++
17D4 DD31             (       circle.asm):00283                         STD     <C_F
17D6 0A30             (       circle.asm):00284                         DEC     <C_X            ; ... x = x - 1
17D8 20E4             (       circle.asm):00285                         BRA     NX_LOOP
17DA 9630             (       circle.asm):00286         NX_DONE         LDA     <C_X
                      (       circle.asm):00287                         ; fall into SCALEX
                      (       circle.asm):00288         
                      (       circle.asm):00289         ; ---------------------------------------------------------------------------
                      (       circle.asm):00290         ; SCALEX - aspect correction: A = (A * 13 + 8) / 16, rounded
                      (       circle.asm):00291         ;   Entry: A = 0-127   Exit: A = 0-103. B corrupted.
                      (       circle.asm):00292         ; ---------------------------------------------------------------------------
17DC C60D             (       circle.asm):00293         SCALEX          LDB     #13
17DE 3D               (       circle.asm):00294                         MUL                     ; D = x * 13
17DF C30008           (       circle.asm):00295                         ADDD    #8              ; round
17E2 44               (       circle.asm):00296                         LSRA                    ; divide by 16
17E3 56               (       circle.asm):00297                         RORB
17E4 44               (       circle.asm):00298                         LSRA
17E5 56               (       circle.asm):00299                         RORB
17E6 44               (       circle.asm):00300                         LSRA
17E7 56               (       circle.asm):00301                         RORB
17E8 44               (       circle.asm):00302                         LSRA
17E9 56               (       circle.asm):00303                         RORB
17EA 1F98             (       circle.asm):00304                         TFR     B,A
17EC 39               (       circle.asm):00305                         RTS
                      (       circle.asm):00306         
                      (       circle.asm):00307         ; ---------------------------------------------------------------------------
                      (       circle.asm):00308         ; CI_SETUP - store the centre and radius (radius clamped to 0-127)
                      (       circle.asm):00309         ; ---------------------------------------------------------------------------
17ED 972C             (       circle.asm):00310         CI_SETUP        STA     <C_CX
17EF D72D             (       circle.asm):00311                         STB     <C_CY
17F1 1F10             (       circle.asm):00312                         TFR     X,D             ; radius is X; anything over 127
17F3 4D               (       circle.asm):00313                         TSTA                    ;  becomes 127
17F4 2603             (       circle.asm):00314                         BNE     CS_BIG
17F6 5D               (       circle.asm):00315                         TSTB
17F7 2A02             (       circle.asm):00316                         BPL     CS_OK
17F9 C67F             (       circle.asm):00317         CS_BIG          LDB     #127
17FB D72E             (       circle.asm):00318         CS_OK           STB     <C_R
17FD 39               (       circle.asm):00319                         RTS
                      (      src/tgl.asm):00092                         INCLUDE "text.asm"
                      (         text.asm):00001         ; ---------------------------------------------------------------------------
                      (         text.asm):00002         ; Status row text
                      (         text.asm):00003         ;   The status row is screen row 24, below the 24 rows of graphics. The
                      (         text.asm):00004         ;   blit never touches it, so text written there stays put while the
                      (         text.asm):00005         ;   graphics above it change. Text is written straight to the screen (not
                      (         text.asm):00006         ;   the off-screen buffer), so it appears immediately.
                      (         text.asm):00007         ;
                      (         text.asm):00008         ;   Strings are zero-terminated and may contain teletext control codes to
                      (         text.asm):00009         ;   colour the text that follows them on the row, e.g. $81 red, $82 green,
                      (         text.asm):00010         ;   $83 yellow, $84 blue, $85 magenta, $86 cyan, $87 white ($01-$07 work
                      (         text.asm):00011         ;   too: the SAA5050 ignores the top bit). Each control code takes up one
                      (         text.asm):00012         ;   character position and shows as a space. Text starts white at the
                      (         text.asm):00013         ;   left of the row.
                      (         text.asm):00014         ; ---------------------------------------------------------------------------
                      (         text.asm):00015         
     E7C0             (         text.asm):00016         STATUS          EQU     VDU_BASE+STATUS_ROW*COLS        ; first byte of row 24
                      (         text.asm):00017         
                      (         text.asm):00018         ; ---------------------------------------------------------------------------
                      (         text.asm):00019         ; T_TEXT - write a string to the status row
                      (         text.asm):00020         ;   Entry: A = column (0-39), X -> zero-terminated string, DP = $00
                      (         text.asm):00021         ;   Exit:  all registers preserved
                      (         text.asm):00022         ;   Stops at the right-hand edge rather than wrapping. A column beyond 39
                      (         text.asm):00023         ;   writes nothing.
                      (         text.asm):00024         ; ---------------------------------------------------------------------------
17FE 3456             (         text.asm):00025         T_TEXT          PSHS    D,X,U
1800 8127             (         text.asm):00026                         CMPA    #COLS-1         ; column off the end of the row?
1802 2212             (         text.asm):00027                         BHI     TX_X
1804 CEE7C0           (         text.asm):00028                         LDU     #STATUS         ; U -> screen position
1807 33C6             (         text.asm):00029                         LEAU    A,U             ;  (A is 0-39, so the add is safe)
1809 1F89             (         text.asm):00030                         TFR     A,B             ; B = column, to stop at the edge
180B A680             (         text.asm):00031         TX_LOOP         LDA     ,X+             ; next character
180D 2707             (         text.asm):00032                         BEQ     TX_X            ; zero: end of string
180F A7C0             (         text.asm):00033                         STA     ,U+
1811 5C               (         text.asm):00034                         INCB
1812 C128             (         text.asm):00035                         CMPB    #COLS           ; reached the right-hand edge?
1814 25F5             (         text.asm):00036                         BLO     TX_LOOP
1816 35D6             (         text.asm):00037         TX_X            PULS    D,X,U,PC
                      (         text.asm):00038         
                      (         text.asm):00039         ; ---------------------------------------------------------------------------
                      (         text.asm):00040         ; T_TCLR - clear the status row to spaces
                      (         text.asm):00041         ;   Entry: DP = $00    Exit: all registers preserved
                      (         text.asm):00042         ; ---------------------------------------------------------------------------
1818 3416             (         text.asm):00043         T_TCLR          PSHS    D,X
181A 8EE7C0           (         text.asm):00044                         LDX     #STATUS
181D CC2020           (         text.asm):00045                         LDD     #$2020          ; two spaces at a time
1820 ED81             (         text.asm):00046         TC_LOOP         STD     ,X++
1822 8CE7E8           (         text.asm):00047                         CMPX    #STATUS+COLS
1825 25F9             (         text.asm):00048                         BLO     TC_LOOP
1827 3596             (         text.asm):00049                         PULS    D,X,PC
                      (         text.asm):00050         
                      (         text.asm):00051         ; ---------------------------------------------------------------------------
                      (         text.asm):00052         ; T_TNUM - write a number to the status row
                      (         text.asm):00053         ;   Entry: A = column (0-39), X = value (0-65535, unsigned), DP = $00
                      (         text.asm):00054         ;   Exit:  all registers preserved
                      (         text.asm):00055         ;   Always five characters, right-aligned with leading spaces, so a value
                      (         text.asm):00056         ;   that shrinks (e.g. from 100 to 99) leaves no stray digits behind.
                      (         text.asm):00057         ;
                      (         text.asm):00058         ;   Each digit is found by counting how many times the matching power of
                      (         text.asm):00059         ;   ten can be subtracted (10000, 1000, 100, 10); what is left is the last
                      (         text.asm):00060         ;   digit. Leading zeros become spaces; the last digit is always shown.
                      (         text.asm):00061         ; ---------------------------------------------------------------------------
1829 3476             (         text.asm):00062         T_TNUM          PSHS    D,X,Y,U
182B 1F10             (         text.asm):00063                         TFR     X,D             ; D = value
182D 338D0045         (         text.asm):00064                         LEAU    POW10,PCR       ; U -> 10000, 1000, 100, 10
1831 108E0038         (         text.asm):00065                         LDY     #T_BUF          ; Y -> where the characters go
1835 0F3F             (         text.asm):00066                         CLR     <T_LEAD         ; no non-zero digit yet
1837 0F3E             (         text.asm):00067         TN_DIGIT        CLR     <T_DIG
1839 10A3C4           (         text.asm):00068         TN_SUB          CMPD    ,U              ; can this power be subtracted?
183C 2506             (         text.asm):00069                         BLO     TN_PUT          ;  (unsigned compare)
183E A3C4             (         text.asm):00070                         SUBD    ,U
1840 0C3E             (         text.asm):00071                         INC     <T_DIG
1842 20F5             (         text.asm):00072                         BRA     TN_SUB
1844 3406             (         text.asm):00073         TN_PUT          PSHS    D               ; keep the remainder
1846 963E             (         text.asm):00074                         LDA     <T_DIG
1848 2608             (         text.asm):00075                         BNE     TN_NZ           ; a zero before any other digit
184A 0D3F             (         text.asm):00076                         TST     <T_LEAD         ;  is a leading zero: a space
184C 2606             (         text.asm):00077                         BNE     TN_CH
184E 8620             (         text.asm):00078                         LDA     #' '
1850 2004             (         text.asm):00079                         BRA     TN_ST
1852 0C3F             (         text.asm):00080         TN_NZ           INC     <T_LEAD
1854 8B30             (         text.asm):00081         TN_CH           ADDA    #'0'
1856 A7A0             (         text.asm):00082         TN_ST           STA     ,Y+
1858 3506             (         text.asm):00083                         PULS    D
185A 3342             (         text.asm):00084                         LEAU    2,U             ; next power of ten
185C 308D001E         (         text.asm):00085                         LEAX    POW10E,PCR
1860 3410             (         text.asm):00086                         PSHS    X
1862 11A3E1           (         text.asm):00087                         CMPU    ,S++            ; done all four powers?
1865 25D0             (         text.asm):00088                         BLO     TN_DIGIT
1867 CB30             (         text.asm):00089                         ADDB    #'0'            ; the last digit, always shown
1869 E7A0             (         text.asm):00090                         STB     ,Y+
186B 6FA4             (         text.asm):00091                         CLR     ,Y              ; end of string
186D A6E4             (         text.asm):00092                         LDA     ,S              ; column (caller's A, on the stack)
186F 8E0038           (         text.asm):00093                         LDX     #T_BUF
1872 8D8A             (         text.asm):00094                         BSR     T_TEXT
1874 35F6             (         text.asm):00095                         PULS    D,X,Y,U,PC
                      (         text.asm):00096         
1876 271003E80064000A (         text.asm):00097         POW10           FDB     10000,1000,100,10
187E                  (         text.asm):00098         POW10E
                      (      src/tgl.asm):00093                         INCLUDE "colour.asm"
                      (       colour.asm):00001         ; ---------------------------------------------------------------------------
                      (       colour.asm):00002         ; T_COLOUR - set the graphics colour of a band of rows
                      (       colour.asm):00003         ;   Entry: A = first row, B = last row (0-23, cell rows: row r covers
                      (       colour.asm):00004         ;          pixel rows y = 3r to 3r+2), X = colour (1 red, 2 green,
                      (       colour.asm):00005         ;          3 yellow, 4 blue, 5 magenta, 6 cyan, 7 white; only the low
                      (       colour.asm):00006         ;          3 bits are used, and 0 counts as white), DP = $00
                      (       colour.asm):00007         ;   Exit:  all registers preserved
                      (       colour.asm):00008         ;
                      (       colour.asm):00009         ;   Teletext colours a row by the control code at its start: $91-$97 mean
                      (       colour.asm):00010         ;   "graphics in red ... white from here on". The library keeps column 0
                      (       colour.asm):00011         ;   of every buffer row for that code, so changing a row's colour costs no
                      (       colour.asm):00012         ;   pixels and no drawing time. The new code is written into the buffer
                      (       colour.asm):00013         ;   straight away (it shows at the next blit) and remembered in ROWCOL, so
                      (       colour.asm):00014         ;   TGL_CLS keeps it.
                      (       colour.asm):00015         ;   A first row beyond 23 does nothing; a last row beyond 23 counts as 23;
                      (       colour.asm):00016         ;   if first > last nothing changes.
                      (       colour.asm):00017         ; ---------------------------------------------------------------------------
187E 3456             (       colour.asm):00018         T_COLOUR        PSHS    D,X,U
1880 8117             (       colour.asm):00019                         CMPA    #ROWS-1         ; first row off the bottom?
1882 2238             (       colour.asm):00020                         BHI     CO_X
1884 C117             (       colour.asm):00021                         CMPB    #ROWS-1         ; clamp the last row
1886 2302             (       colour.asm):00022                         BLS     CO_1
1888 C617             (       colour.asm):00023                         LDB     #ROWS-1
188A 9740             (       colour.asm):00024         CO_1            STA     <K_FIRST
188C D741             (       colour.asm):00025                         STB     <K_LAST
188E 9141             (       colour.asm):00026                         CMPA    <K_LAST         ; empty band?
1890 222A             (       colour.asm):00027                         BHI     CO_X
1892 1F10             (       colour.asm):00028                         TFR     X,D             ; B = colour
1894 C407             (       colour.asm):00029                         ANDB    #7
1896 2602             (       colour.asm):00030                         BNE     CO_2
1898 C607             (       colour.asm):00031                         LDB     #7              ; 0 counts as white
189A CA90             (       colour.asm):00032         CO_2            ORB     #$90            ; $91-$97: graphics colour codes
189C D742             (       colour.asm):00033                         STB     <K_CODE
                      (       colour.asm):00034         
189E 9640             (       colour.asm):00035                         LDA     <K_FIRST        ; U -> ROWCOL entry for the first row
18A0 CE0043           (       colour.asm):00036                         LDU     #ROWCOL
18A3 33C6             (       colour.asm):00037                         LEAU    A,U
18A5 C628             (       colour.asm):00038                         LDB     #COLS           ; X -> column 0 of that buffer row
18A7 3D               (       colour.asm):00039                         MUL                     ;  (first row * 40)
18A8 D300             (       colour.asm):00040                         ADDD    <W_BUF
18AA 1F01             (       colour.asm):00041                         TFR     D,X
18AC D640             (       colour.asm):00042                         LDB     <K_FIRST        ; B counts rows
18AE 9642             (       colour.asm):00043         CO_LOOP         LDA     <K_CODE
18B0 A7C0             (       colour.asm):00044                         STA     ,U+             ; remember it ...
18B2 A784             (       colour.asm):00045                         STA     ,X              ; ... and put it in the buffer
18B4 308828           (       colour.asm):00046                         LEAX    COLS,X          ; next buffer row
18B7 D141             (       colour.asm):00047                         CMPB    <K_LAST         ; was that the last row? (carry set
18B9 5C               (       colour.asm):00048                         INCB                    ;  if not; INCB leaves the carry
18BA 25F2             (       colour.asm):00049                         BLO     CO_LOOP         ;  alone, so BLO still sees it)
18BC 35D6             (       colour.asm):00050         CO_X            PULS    D,X,U,PC
                      (      src/tgl.asm):00094                         INCLUDE "system.asm"
                      (       system.asm):00001         ; ---------------------------------------------------------------------------
                      (       system.asm):00002         ; System services: restoring the display, reading the keyboard, exiting.
                      (       system.asm):00003         ; These go through the monitor's RAM vectors (target/*.inc), so they work
                      (       system.asm):00004         ; whichever monitor version is fitted.
                      (       system.asm):00005         ; ---------------------------------------------------------------------------
                      (       system.asm):00006         
                      (       system.asm):00007         ; ---------------------------------------------------------------------------
                      (       system.asm):00008         ; T_DONE - give the display back to the monitor / FLEX
                      (       system.asm):00009         ;   Sends a form feed through the monitor's console output vector. The
                      (       system.asm):00010         ;   monitor's form-feed handler (CRTCI) re-detects the 6845 type, reloads
                      (       system.asm):00011         ;   all its registers (restoring the cursor and start address), resets the
                      (       system.asm):00012         ;   driver's row, column and scroll position, homes the cursor and clears
                      (       system.asm):00013         ;   the screen.
                      (       system.asm):00014         ;   Entry: any DP              Exit: all registers preserved
                      (       system.asm):00015         ; ---------------------------------------------------------------------------
18BE 3402             (       system.asm):00016         T_DONE          PSHS    A
18C0 860C             (       system.asm):00017                         LDA     #$0C            ; form feed
18C2 AD9FE365         (       system.asm):00018                         JSR     [MON_COPADR]
18C6 3582             (       system.asm):00019                         PULS    A,PC
                      (       system.asm):00020         
                      (       system.asm):00021         ; ---------------------------------------------------------------------------
                      (       system.asm):00022         ; T_INKEY - check for a key without waiting
                      (       system.asm):00023         ;   The monitor's IRQ handler buffers keypresses; a key is waiting when the
                      (       system.asm):00024         ;   buffer's tail and static head differ. Needs IRQs enabled.
                      (       system.asm):00025         ;   Entry: any DP
                      (       system.asm):00026         ;   Exit:  Z set, A = 0 if no key; Z clear, A = key if there was one.
                      (       system.asm):00027         ;          Other registers preserved.
                      (       system.asm):00028         ; ---------------------------------------------------------------------------
18C8 3410             (       system.asm):00029         T_INKEY         PSHS    X
18CA BEE38B           (       system.asm):00030                         LDX     MON_TAIL
18CD BCE387           (       system.asm):00031                         CMPX    MON_HEADST
18D0 2708             (       system.asm):00032                         BEQ     IK_NONE
18D2 AD9FE367         (       system.asm):00033                         JSR     [MON_CINADR]    ; returns at once: a key is waiting
18D6 1CFB             (       system.asm):00034                         ANDCC   #$FB            ; Z clear: key in A
18D8 3590             (       system.asm):00035                         PULS    X,PC
18DA 4F               (       system.asm):00036         IK_NONE         CLRA                    ; Z set (PULS leaves flags alone)
18DB 3590             (       system.asm):00037                         PULS    X,PC
                      (       system.asm):00038         
                      (       system.asm):00039         ; ---------------------------------------------------------------------------
                      (       system.asm):00040         ; T_EXIT - restore the display and return to the operating system
                      (       system.asm):00041         ;   FLEX machine: FLEX warm start. Standard System 3: SWI into the monitor
                      (       system.asm):00042         ;   (it shows the registers and stays in the monitor; proceeding just
                      (       system.asm):00043         ;   re-executes the SWI).
                      (       system.asm):00044         ;   Does not return.
                      (       system.asm):00045         ; ---------------------------------------------------------------------------
18DD 8DDF             (       system.asm):00046         T_EXIT          BSR     T_DONE
                      (       system.asm):00047                         IFDEF   TARGET_FLEX
18DF 7ECD03           (       system.asm):00048                         JMP     FLEX_WARMS
                      (       system.asm):00049                         ELSE
                      (       system.asm):00050                         SWI
                      (       system.asm):00051                         ENDC
                      (      src/tgl.asm):00095                         INCLUDE "tables.asm"
                      (       tables.asm):00001         ; ---------------------------------------------------------------------------
                      (       tables.asm):00002         ; Lookup tables - always referenced with ,PCR
                      (       tables.asm):00003         ;
                      (       tables.asm):00004         ; PTAB: one 4-byte entry per pixel row y (0-71):
                      (       tables.asm):00005         ;   +0,+1  offset of column 1 of the cell row within the buffer: (y/3)*40+1
                      (       tables.asm):00006         ;   +2     sixel mask for an even x (left pixel)
                      (       tables.asm):00007         ;   +3     sixel mask for an odd x (right pixel)
                      (       tables.asm):00008         ; Sixel bits: top row 0/1, middle row 2/3, bottom row 4/6 (bit 5 always set)
                      (       tables.asm):00009         ; ---------------------------------------------------------------------------
18E2                  (       tables.asm):00010         PTAB
18E2 00010102         (       tables.asm):00011                         FCB     $00,$01,$01,$02     ; y=0
18E6 00010408         (       tables.asm):00012                         FCB     $00,$01,$04,$08     ; y=1
18EA 00011040         (       tables.asm):00013                         FCB     $00,$01,$10,$40     ; y=2
18EE 00290102         (       tables.asm):00014                         FCB     $00,$29,$01,$02     ; y=3
18F2 00290408         (       tables.asm):00015                         FCB     $00,$29,$04,$08     ; y=4
18F6 00291040         (       tables.asm):00016                         FCB     $00,$29,$10,$40     ; y=5
18FA 00510102         (       tables.asm):00017                         FCB     $00,$51,$01,$02     ; y=6
18FE 00510408         (       tables.asm):00018                         FCB     $00,$51,$04,$08     ; y=7
1902 00511040         (       tables.asm):00019                         FCB     $00,$51,$10,$40     ; y=8
1906 00790102         (       tables.asm):00020                         FCB     $00,$79,$01,$02     ; y=9
190A 00790408         (       tables.asm):00021                         FCB     $00,$79,$04,$08     ; y=10
190E 00791040         (       tables.asm):00022                         FCB     $00,$79,$10,$40     ; y=11
