                      (      src/tgl.asm):00087                         INCLUDE "circle.asm"
                      (       circle.asm):00001         ; ---------------------------------------------------------------------------
                      (       circle.asm):00002         ; Circles - outlined and filled, corrected for the pixel shape
                      (       circle.asm):00003         ;   Entry: A = centre x, B = centre y (signed, -128..127),
                      (       circle.asm):00004         ;          X = radius in vertical pixels (0-127; larger values count as 127)
                      (       circle.asm):00005         ;          DP = $00
                      (       circle.asm):00006         ;   Exit:  all registers preserved
                      (       circle.asm):00007         ;   Both clip to the screen and use the current plot mode.
                      (       circle.asm):00008         ;
                      (       circle.asm):00009         ;   Teletext pixels are about 1.2 times wider than they are tall, so a
                      (       circle.asm):00010         ;   shape that is round in pixels looks squashed. Every half-width is
                      (       circle.asm):00011         ;   therefore scaled by 13/16 (0.81), the same correction the cube demo's
                      (       circle.asm):00012         ;   projection uses, so circles look round on screen.
                      (       circle.asm):00013         ;
                      (       circle.asm):00014         ;   The circle is worked out a row at a time, from the centre row outwards.
                      (       circle.asm):00015         ;   For row offset y, the unscaled half-width x is the largest x with
                      (       circle.asm):00016         ;   x^2 + y^2 <= r^2 + r (the midpoint rule, which rounds to the nearest
                      (       circle.asm):00017         ;   pixel). Moving to the next row only ever shrinks x, and the test can be
                      (       circle.asm):00018         ;   kept up to date with additions alone:
                      (       circle.asm):00019         ;       f = x^2 + y^2 - r^2 - r       (start: x = r, y = 0, so f = -r)
                      (       circle.asm):00020         ;       next row:     f = f + 2y + 1, then y = y + 1
                      (       circle.asm):00021         ;       while f > 0:  f = f - (2x - 1), x = x - 1
                      (       circle.asm):00022         ;
                      (       circle.asm):00023         ;   Outline: each row draws the run of pixels from just beyond the next
                      (       circle.asm):00024         ;   row's edge out to this row's edge (at least one pixel), on both sides,
                      (       circle.asm):00025         ;   for the rows above and below the centre. That joins the rows into an
                      (       circle.asm):00026         ;   unbroken outline and draws every pixel exactly once, so XOR works.
                      (       circle.asm):00027         ;   Filled: each row draws one span from edge to edge.
                      (       circle.asm):00028         ;   Runs and spans are drawn by HSPAN, a lean one-row fill.
                      (       circle.asm):00029         ; ---------------------------------------------------------------------------
                      (       circle.asm):00030         
1601 3476             (       circle.asm):00031         T_CIRC          PSHS    D,X,Y,U
1603 1701AA           (       circle.asm):00032                         LBSR    CI_SETUP
1606 0F37             (       circle.asm):00033                         CLR     <C_FILL         ; outline
1608 2009             (       circle.asm):00034                         BRA     CI_RUN
                      (       circle.asm):00035         
160A 3476             (       circle.asm):00036         T_CIRCF         PSHS    D,X,Y,U
160C 1701A1           (       circle.asm):00037                         LBSR    CI_SETUP
160F 8601             (       circle.asm):00038                         LDA     #1              ; filled
1611 9737             (       circle.asm):00039                         STA     <C_FILL
                      (       circle.asm):00040         
1613 0F2F             (       circle.asm):00041         CI_RUN          CLR     <C_ROW          ; start at the centre row
1615 D62E             (       circle.asm):00042                         LDB     <C_R            ; x = r
1617 D730             (       circle.asm):00043                         STB     <C_X
1619 4F               (       circle.asm):00044                         CLRA                    ; f = -r
161A 43               (       circle.asm):00045                         COMA                    ;  (negate D: complement, add 1)
161B 53               (       circle.asm):00046                         COMB
161C C30001           (       circle.asm):00047                         ADDD    #1
161F DD31             (       circle.asm):00048                         STD     <C_F
1621 9630             (       circle.asm):00049                         LDA     <C_X            ; half-width of the centre row
1623 170179           (       circle.asm):00050                         LBSR    SCALEX
1626 9733             (       circle.asm):00051                         STA     <C_HC
                      (       circle.asm):00052         
1628 962F             (       circle.asm):00053         CI_LOOP         LDA     <C_ROW          ; on the outermost row there is no
162A 912E             (       circle.asm):00054                         CMPA    <C_R            ;  next row: draw it edge to edge
162C 2710             (       circle.asm):00055                         BEQ     CI_TOP
162E 170144           (       circle.asm):00056                         LBSR    NEXTX           ; next row's half-width
1631 9734             (       circle.asm):00057                         STA     <C_HN
1633 4C               (       circle.asm):00058                         INCA                    ; this row's run starts just beyond
1634 9133             (       circle.asm):00059                         CMPA    <C_HC           ;  the next row's edge, but never
1636 2302             (       circle.asm):00060                         BLS     CI_S1           ;  past this row's own edge
1638 9633             (       circle.asm):00061                         LDA     <C_HC
163A 9735             (       circle.asm):00062         CI_S1           STA     <C_ST
163C 2002             (       circle.asm):00063                         BRA     CI_DRAW
163E 0F35             (       circle.asm):00064         CI_TOP          CLR     <C_ST           ; start 0 = one span, edge to edge
                      (       circle.asm):00065         
1640 0D37             (       circle.asm):00066         CI_DRAW         TST     <C_FILL         ; filled circles always draw the
1642 2702             (       circle.asm):00067                         BEQ     CI_ROWS         ;  full span
1644 0F35             (       circle.asm):00068                         CLR     <C_ST
                      (       circle.asm):00069         
1646 962D             (       circle.asm):00070         CI_ROWS         LDA     <C_CY           ; the row below the centre (screen y
1648 9B2F             (       circle.asm):00071                         ADDA    <C_ROW          ;  grows downwards). Saturate rather
164A 2802             (       circle.asm):00072                         BVC     CI_Y1           ;  than wrap: a row that far out is
164C 867F             (       circle.asm):00073                         LDA     #127            ;  off screen and gets clipped anyway
164E 9736             (       circle.asm):00074         CI_Y1           STA     <C_Y
1650 8D20             (       circle.asm):00075                         BSR     CI_ROWDRAW
1652 0D2F             (       circle.asm):00076                         TST     <C_ROW          ; the row above, except for the
1654 270C             (       circle.asm):00077                         BEQ     CI_NEXT         ;  centre row itself
1656 962D             (       circle.asm):00078                         LDA     <C_CY
1658 902F             (       circle.asm):00079                         SUBA    <C_ROW
165A 2802             (       circle.asm):00080                         BVC     CI_Y2
165C 8680             (       circle.asm):00081                         LDA     #-128
165E 9736             (       circle.asm):00082         CI_Y2           STA     <C_Y
1660 8D10             (       circle.asm):00083                         BSR     CI_ROWDRAW
                      (       circle.asm):00084         
1662 962F             (       circle.asm):00085         CI_NEXT         LDA     <C_ROW          ; done the outermost row?
1664 912E             (       circle.asm):00086                         CMPA    <C_R
1666 2708             (       circle.asm):00087                         BEQ     CI_END
1668 0C2F             (       circle.asm):00088                         INC     <C_ROW
166A 9634             (       circle.asm):00089                         LDA     <C_HN           ; next row's half-width becomes
166C 9733             (       circle.asm):00090                         STA     <C_HC           ;  this row's
166E 20B8             (       circle.asm):00091                         BRA     CI_LOOP
