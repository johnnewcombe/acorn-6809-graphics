                      (       tables.asm):00007         ;   +3     sixel mask for an odd x (right pixel)
                      (       tables.asm):00008         ; Sixel bits: top row 0/1, middle row 2/3, bottom row 4/6 (bit 5 always set)
                      (       tables.asm):00009         ; ---------------------------------------------------------------------------
