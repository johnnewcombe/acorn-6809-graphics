                      (         rect.asm):00264         ;   Entry: A = x0, B = y0, X = x1:y1 (signed)    Exit: A, B corrupted
                      (         rect.asm):00265         ; ---------------------------------------------------------------------------
1618 DD18             (         rect.asm):00266         R_SORT          STD     <R_X0
161A 9F1A             (         rect.asm):00267                         STX     <R_X1
161C 9618             (         rect.asm):00268                         LDA     <R_X0
161E 911A             (         rect.asm):00269                         CMPA    <R_X1
1620 2F06             (         rect.asm):00270                         BLE     RS_1
1622 D61A             (         rect.asm):00271                         LDB     <R_X1           ; swap the x coordinates
1624 D718             (         rect.asm):00272                         STB     <R_X0
1626 971A             (         rect.asm):00273                         STA     <R_X1
1628 9619             (         rect.asm):00274         RS_1            LDA     <R_Y0
162A 911B             (         rect.asm):00275                         CMPA    <R_Y1
162C 2F06             (         rect.asm):00276                         BLE     RS_2
