                      (         clip.asm):00085         ; LC_CLIP - move a point onto the first edge in its outcode
                      (         clip.asm):00086         ;   Entry: A = outcode of the point being moved
                      (         clip.asm):00087         ;   Exit:  A = new x, B = new y
