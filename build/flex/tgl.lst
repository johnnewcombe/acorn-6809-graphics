168F 0D2F             (       circle.asm):00076                         TST     <C_ROW          ; the row above, except for the
1691 270C             (       circle.asm):00077                         BEQ     CI_NEXT         ;  centre row itself
1693 962D             (       circle.asm):00078                         LDA     <C_CY
1695 902F             (       circle.asm):00079                         SUBA    <C_ROW
1697 2802             (       circle.asm):00080                         BVC     CI_Y2
1699 8680             (       circle.asm):00081                         LDA     #-128
169B 9736             (       circle.asm):00082         CI_Y2           STA     <C_Y
169D 8D10             (       circle.asm):00083                         BSR     CI_ROWDRAW
                      (       circle.asm):00084         
169F 962F             (       circle.asm):00085         CI_NEXT         LDA     <C_ROW          ; done the outermost row?
16A1 912E             (       circle.asm):00086                         CMPA    <C_R
16A3 2708             (       circle.asm):00087                         BEQ     CI_END
16A5 0C2F             (       circle.asm):00088                         INC     <C_ROW
16A7 9634             (       circle.asm):00089                         LDA     <C_HN           ; next row's half-width becomes
16A9 9733             (       circle.asm):00090                         STA     <C_HC           ;  this row's
16AB 20B8             (       circle.asm):00091                         BRA     CI_LOOP
16AD 35F6             (       circle.asm):00092         CI_END          PULS    D,X,Y,U,PC
                      (       circle.asm):00093         
                      (       circle.asm):00094         ; ---------------------------------------------------------------------------
                      (       circle.asm):00095         ; CI_ROWDRAW - draw one row (screen y in C_Y)
                      (       circle.asm):00096         ;   C_ST = 0: one span from cx - half-width to cx + half-width.
                      (       circle.asm):00097         ;   C_ST > 0: two runs, cx + C_ST .. cx + half-width on the right and its
                      (       circle.asm):00098         ;   mirror image on the left.
                      (       circle.asm):00099         ;   Screen x values saturate at -128 / 127 instead of wrapping; anything
                      (       circle.asm):00100         ;   that far out is off screen and clipped anyway.
                      (       circle.asm):00101         ; ---------------------------------------------------------------------------
16AF 0D35             (       circle.asm):00102         CI_ROWDRAW      TST     <C_ST
16B1 2618             (       circle.asm):00103                         BNE     RD_TWO
16B3 962C             (       circle.asm):00104                         LDA     <C_CX           ; one span: left end ...
16B5 9033             (       circle.asm):00105                         SUBA    <C_HC
16B7 2802             (       circle.asm):00106                         BVC     RD_1
16B9 8680             (       circle.asm):00107                         LDA     #-128
16BB 3402             (       circle.asm):00108         RD_1            PSHS    A
16BD 962C             (       circle.asm):00109                         LDA     <C_CX           ; ... right end
16BF 9B33             (       circle.asm):00110                         ADDA    <C_HC
16C1 2802             (       circle.asm):00111                         BVC     RD_2
16C3 867F             (       circle.asm):00112                         LDA     #127
16C5 1F89             (       circle.asm):00113         RD_2            TFR     A,B
16C7 3502             (       circle.asm):00114                         PULS    A
16C9 202E             (       circle.asm):00115                         BRA     DRUN
                      (       circle.asm):00116         
16CB 962C             (       circle.asm):00117         RD_TWO          LDA     <C_CX           ; right-hand run: cx + start ...
16CD 9B35             (       circle.asm):00118                         ADDA    <C_ST
16CF 2802             (       circle.asm):00119                         BVC     RD_3
16D1 867F             (       circle.asm):00120                         LDA     #127
16D3 3402             (       circle.asm):00121         RD_3            PSHS    A
16D5 962C             (       circle.asm):00122                         LDA     <C_CX           ; ... to cx + half-width
16D7 9B33             (       circle.asm):00123                         ADDA    <C_HC
16D9 2802             (       circle.asm):00124                         BVC     RD_4
16DB 867F             (       circle.asm):00125                         LDA     #127
16DD 1F89             (       circle.asm):00126         RD_4            TFR     A,B
16DF 3502             (       circle.asm):00127                         PULS    A
16E1 8D16             (       circle.asm):00128                         BSR     DRUN
16E3 962C             (       circle.asm):00129                         LDA     <C_CX           ; left-hand run: cx - half-width ...
16E5 9033             (       circle.asm):00130                         SUBA    <C_HC
16E7 2802             (       circle.asm):00131                         BVC     RD_5
16E9 8680             (       circle.asm):00132                         LDA     #-128
16EB 3402             (       circle.asm):00133         RD_5            PSHS    A
16ED 962C             (       circle.asm):00134                         LDA     <C_CX           ; ... to cx - start
16EF 9035             (       circle.asm):00135                         SUBA    <C_ST
16F1 2802             (       circle.asm):00136                         BVC     RD_6
16F3 8680             (       circle.asm):00137                         LDA     #-128
16F5 1F89             (       circle.asm):00138         RD_6            TFR     A,B
16F7 3502             (       circle.asm):00139                         PULS    A
                      (       circle.asm):00140                         ; fall into DRUN
                      (       circle.asm):00141         
                      (       circle.asm):00142         ; ---------------------------------------------------------------------------
                      (       circle.asm):00143         ; DRUN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00144         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00145         ;   A single pixel (most of an outline) goes to the clipped plot, which is
                      (       circle.asm):00146         ;   cheaper; anything longer goes to HSPAN.
                      (       circle.asm):00147         ; ---------------------------------------------------------------------------
16F9 3404             (       circle.asm):00148         DRUN            PSHS    B
16FB A1E0             (       circle.asm):00149                         CMPA    ,S+
16FD 2605             (       circle.asm):00150                         BNE     HSPAN
16FF D636             (       circle.asm):00151                         LDB     <C_Y            ; one pixel: A,B = x,y
1701 16FC7B           (       circle.asm):00152                         LBRA    T_PLOTC
                      (       circle.asm):00153         
                      (       circle.asm):00154         ; ---------------------------------------------------------------------------
                      (       circle.asm):00155         ; HSPAN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00156         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00157         ;   Exit:  A, B, X, U corrupted
                      (       circle.asm):00158         ;
                      (       circle.asm):00159         ;   A lean, single-row version of the rectangle fill. The row's left and
                      (       circle.asm):00160         ;   right pixel masks come straight from PTAB, so there is no sorting, no
                      (       circle.asm):00161         ;   multiply and no mask lookup: clip, find the cells, then
                      (       circle.asm):00162         ;     - if the run starts on a right-hand pixel, that cell gets only its
                      (       circle.asm):00163         ;       right pixel
                      (       circle.asm):00164         ;     - whole cells in between get both pixels, via the shared FILLSEG loop
                      (       circle.asm):00165         ;     - if the run ends on a left-hand pixel, that cell gets only its left
                      (       circle.asm):00166         ;   (or, when the run lies within one cell, whichever of its pixels count).
                      (       circle.asm):00167         ; ---------------------------------------------------------------------------
1704 3406             (       circle.asm):00168         HSPAN           PSHS    A,B             ; 0,S = left x, 1,S = right x
1706 D636             (       circle.asm):00169                         LDB     <C_Y            ; row off screen? (unsigned compare
1708 C147             (       circle.asm):00170                         CMPB    #YMAX           ;  catches negative rows too)
170A 102200A2         (       circle.asm):00171                         LBHI    HS_X
170E A661             (       circle.asm):00172                         LDA     1,S             ; run entirely left of the screen?
1710 102B009C         (       circle.asm):00173                         LBMI    HS_X
1714 A6E4             (       circle.asm):00174                         LDA     ,S              ; entirely right of it?
1716 814D             (       circle.asm):00175                         CMPA    #XMAX
1718 102E0094         (       circle.asm):00176                         LBGT    HS_X
171C 4D               (       circle.asm):00177                         TSTA                    ; clip the left end
171D 2A02             (       circle.asm):00178                         BPL     HS_1
171F 6FE4             (       circle.asm):00179                         CLR     ,S
1721 A661             (       circle.asm):00180         HS_1            LDA     1,S             ; clip the right end
1723 814D             (       circle.asm):00181                         CMPA    #XMAX
1725 2F04             (       circle.asm):00182                         BLE     HS_2
1727 864D             (       circle.asm):00183                         LDA     #XMAX
1729 A761             (       circle.asm):00184                         STA     1,S
                      (       circle.asm):00185         
172B 17FEF6           (       circle.asm):00186         HS_2            LBSR    PT_ENTRY        ; U -> PTAB entry for this row (B = y)
172E ECC4             (       circle.asm):00187                         LDD     ,U              ; X -> first cell of the cell row
1730 D300             (       circle.asm):00188                         ADDD    <W_BUF
1732 1F01             (       circle.asm):00189                         TFR     D,X
1734 A642             (       circle.asm):00190                         LDA     2,U             ; this sixel row's masks
1736 9725             (       circle.asm):00191                         STA     <F_ML
1738 A643             (       circle.asm):00192                         LDA     3,U
173A 9726             (       circle.asm):00193                         STA     <F_MR
                      (       circle.asm):00194         
173C A6E4             (       circle.asm):00195                         LDA     ,S              ; first cell, and does the run start
173E 44               (       circle.asm):00196                         LSRA                    ;  on its right pixel (x odd)?
173F 971C             (       circle.asm):00197                         STA     <F_CX0
1741 8600             (       circle.asm):00198                         LDA     #0              ; (not CLRA: keep the carry)
1743 49               (       circle.asm):00199                         ROLA
1744 971E             (       circle.asm):00200                         STA     <F_PL
