1485 960F             (         clip.asm):00166                         LDA     <I_U0
1487 3404             (         clip.asm):00167                         PSHS    B
1489 0D14             (         clip.asm):00168                         TST     <I_SGN
148B 2603             (         clip.asm):00169                         BNE     IS_4
