                      (         rect.asm):00245         ; FILLSEG - apply a mask to a run of cells
                      (         rect.asm):00246         ;   Entry: X -> first cell, B = number of cells (1 or more), A = mask
                      (         rect.asm):00247         ;   Exit:  X -> cell after the run. A, B corrupted.
                      (         rect.asm):00248         ;   T_SETMODE patches the pre-op (NOP, or COMA for CLEAR) and the operation
                      (         rect.asm):00249         ;   (ORA / ANDA / EORA), so the loop never tests the mode. About 19 cycles
                      (         rect.asm):00250         ;   per cell, i.e. roughly 3 cycles per pixel.
                      (         rect.asm):00251         ; ---------------------------------------------------------------------------
15AB                  (         rect.asm):00252         FILLSEG
15AB 12               (         rect.asm):00253         FS_PRE          NOP                     ; patched: NOP or COMA
15AC 9727             (         rect.asm):00254                         STA     <W_FM
15AE A684             (         rect.asm):00255         FS_LOOP         LDA     ,X
15B0 9A27             (         rect.asm):00256         FS_OP           ORA     <W_FM           ; patched: ORA / ANDA / EORA <W_FM
15B2 A780             (         rect.asm):00257                         STA     ,X+
15B4 5A               (         rect.asm):00258                         DECB
15B5 26F7             (         rect.asm):00259                         BNE     FS_LOOP
15B7 39               (         rect.asm):00260                         RTS
                      (         rect.asm):00261         
                      (         rect.asm):00262         ; ---------------------------------------------------------------------------
                      (         rect.asm):00263         ; R_SORT - store the corners in R_X0..R_Y1 with R_X0 <= R_X1, R_Y0 <= R_Y1
                      (         rect.asm):00264         ;   Entry: A = x0, B = y0, X = x1:y1 (signed)    Exit: A, B corrupted
                      (         rect.asm):00265         ; ---------------------------------------------------------------------------
15B8 DD18             (         rect.asm):00266         R_SORT          STD     <R_X0
15BA 9F1A             (         rect.asm):00267                         STX     <R_X1
15BC 9618             (         rect.asm):00268                         LDA     <R_X0
15BE 911A             (         rect.asm):00269                         CMPA    <R_X1
15C0 2F06             (         rect.asm):00270                         BLE     RS_1
15C2 D61A             (         rect.asm):00271                         LDB     <R_X1           ; swap the x coordinates
15C4 D718             (         rect.asm):00272                         STB     <R_X0
15C6 971A             (         rect.asm):00273                         STA     <R_X1
15C8 9619             (         rect.asm):00274         RS_1            LDA     <R_Y0
15CA 911B             (         rect.asm):00275                         CMPA    <R_Y1
15CC 2F06             (         rect.asm):00276                         BLE     RS_2
15CE D61B             (         rect.asm):00277                         LDB     <R_Y1           ; swap the y coordinates
15D0 D719             (         rect.asm):00278                         STB     <R_Y0
15D2 971B             (         rect.asm):00279                         STA     <R_Y1
15D4 39               (         rect.asm):00280         RS_2            RTS
                      (         rect.asm):00281         
                      (         rect.asm):00282         ; ---------------------------------------------------------------------------
                      (         rect.asm):00283         ; PT_ENTRY - Entry: B = y (0-71)   Exit: U -> PTAB entry. A, B corrupted
                      (         rect.asm):00284         ; ---------------------------------------------------------------------------
15D5 338D003A         (         rect.asm):00285         PT_ENTRY        LEAU    PTAB,PCR
15D9 4F               (         rect.asm):00286                         CLRA
15DA 58               (         rect.asm):00287                         ASLB                    ; D = y * 4
15DB 49               (         rect.asm):00288                         ROLA
15DC 58               (         rect.asm):00289                         ASLB
15DD 49               (         rect.asm):00290                         ROLA
15DE 33CB             (         rect.asm):00291                         LEAU    D,U
15E0 39               (         rect.asm):00292                         RTS
                      (         rect.asm):00293         
                      (         rect.asm):00294         ; ---------------------------------------------------------------------------
                      (         rect.asm):00295         ; SUBROW - which sixel row a left-pixel mask is on
                      (         rect.asm):00296         ;   Entry: A = left-pixel mask from PTAB (1, 4 or 16)   Exit: A = 0, 1 or 2
                      (         rect.asm):00297         ; ---------------------------------------------------------------------------
15E1 8104             (         rect.asm):00298         SUBROW          CMPA    #4
15E3 2508             (         rect.asm):00299                         BLO     SR_0
15E5 2703             (         rect.asm):00300                         BEQ     SR_1
15E7 8602             (         rect.asm):00301                         LDA     #2
15E9 39               (         rect.asm):00302                         RTS
15EA 8601             (         rect.asm):00303         SR_1            LDA     #1
15EC 39               (         rect.asm):00304                         RTS
15ED 4F               (         rect.asm):00305         SR_0            CLRA
15EE 39               (         rect.asm):00306                         RTS
                      (      src/tgl.asm):00076                         INCLUDE "system.asm"
                      (       system.asm):00001         ; ---------------------------------------------------------------------------
                      (       system.asm):00002         ; System services: restoring the display, reading the keyboard, exiting.
                      (       system.asm):00003         ; These go through the monitor's RAM vectors (target/*.inc), so they work
                      (       system.asm):00004         ; whichever monitor version is fitted.
                      (       system.asm):00005         ; ---------------------------------------------------------------------------
                      (       system.asm):00006         
                      (       system.asm):00007         ; ---------------------------------------------------------------------------
                      (       system.asm):00008         ; T_DONE - give the display back to the monitor / FLEX
                      (       system.asm):00009         ;   Sends a form feed through the monitor's console output vector. The
                      (       system.asm):00010         ;   monitor's form-feed handler (CRTCI) re-detects the 6845 type, reloads
                      (       system.asm):00011         ;   all its registers (restoring the cursor and start address), resets the
                      (       system.asm):00012         ;   driver's row, column and scroll position, homes the cursor and clears
                      (       system.asm):00013         ;   the screen.
                      (       system.asm):00014         ;   Entry: any DP              Exit: all registers preserved
                      (       system.asm):00015         ; ---------------------------------------------------------------------------
15EF 3402             (       system.asm):00016         T_DONE          PSHS    A
15F1 860C             (       system.asm):00017                         LDA     #$0C            ; form feed
15F3 AD9FE365         (       system.asm):00018                         JSR     [MON_COPADR]
15F7 3582             (       system.asm):00019                         PULS    A,PC
                      (       system.asm):00020         
                      (       system.asm):00021         ; ---------------------------------------------------------------------------
                      (       system.asm):00022         ; T_INKEY - check for a key without waiting
                      (       system.asm):00023         ;   The monitor's IRQ handler buffers keypresses; a key is waiting when the
                      (       system.asm):00024         ;   buffer's tail and static head differ. Needs IRQs enabled.
                      (       system.asm):00025         ;   Entry: any DP
                      (       system.asm):00026         ;   Exit:  Z set, A = 0 if no key; Z clear, A = key if there was one.
                      (       system.asm):00027         ;          Other registers preserved.
                      (       system.asm):00028         ; ---------------------------------------------------------------------------
15F9 3410             (       system.asm):00029         T_INKEY         PSHS    X
15FB BEE38B           (       system.asm):00030                         LDX     MON_TAIL
15FE BCE387           (       system.asm):00031                         CMPX    MON_HEADST
1601 2708             (       system.asm):00032                         BEQ     IK_NONE
1603 AD9FE367         (       system.asm):00033                         JSR     [MON_CINADR]    ; returns at once: a key is waiting
1607 1CFB             (       system.asm):00034                         ANDCC   #$FB            ; Z clear: key in A
1609 3590             (       system.asm):00035                         PULS    X,PC
160B 4F               (       system.asm):00036         IK_NONE         CLRA                    ; Z set (PULS leaves flags alone)
160C 3590             (       system.asm):00037                         PULS    X,PC
                      (       system.asm):00038         
                      (       system.asm):00039         ; ---------------------------------------------------------------------------
                      (       system.asm):00040         ; T_EXIT - restore the display and return to the operating system
                      (       system.asm):00041         ;   FLEX machine: FLEX warm start. Standard System 3: SWI into the monitor
                      (       system.asm):00042         ;   (it shows the registers and stays in the monitor; proceeding just
                      (       system.asm):00043         ;   re-executes the SWI).
                      (       system.asm):00044         ;   Does not return.
                      (       system.asm):00045         ; ---------------------------------------------------------------------------
160E 8DDF             (       system.asm):00046         T_EXIT          BSR     T_DONE
                      (       system.asm):00047                         IFDEF   TARGET_FLEX
1610 7ECD03           (       system.asm):00048                         JMP     FLEX_WARMS
                      (       system.asm):00049                         ELSE
                      (       system.asm):00050                         SWI
                      (       system.asm):00051                         ENDC
