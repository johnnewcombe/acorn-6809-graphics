223A DC20             (         dash.asm):00263                         LDD     <D_ERR
223C D31C             (         dash.asm):00264                         ADDD    <D_DX
223E DD20             (         dash.asm):00265                         STD     <D_ERR
2240 9610             (         dash.asm):00266                         LDA     <D_Y
2242 9B14             (         dash.asm):00267                         ADDA    <D_SY
2244 9710             (         dash.asm):00268                         STA     <D_Y
2246 3344             (         dash.asm):00269                         LEAU    4,U             ; U follows y down ...
2248 0D14             (         dash.asm):00270                         TST     <D_SY
224A 2AA0             (         dash.asm):00271                         BPL     DL_LOOP
224C 3358             (         dash.asm):00272                         LEAU    -8,U            ; ... or up
224E 209C             (         dash.asm):00273                         BRA     DL_LOOP
2250 39               (         dash.asm):00274         DL_X            RTS
                      (         dash.asm):00275         
                      (         dash.asm):00276         ; DHZ - horizontal: y is fixed, so the row's address (Y) is worked out once
                      (         dash.asm):00277         ;   and each pixel just steps x. If the row is off screen, every pixel is.
2251 D610             (         dash.asm):00278         DHZ             LDB     <D_Y
2253 C147             (         dash.asm):00279                         CMPB    #YMAX
2255 2229             (         dash.asm):00280                         BHI     DHZ_OFF
2257 ECC4             (         dash.asm):00281                         LDD     ,U              ; Y -> column 1 of the row
2259 D300             (         dash.asm):00282                         ADDD    <W_BUF
225B 1F02             (         dash.asm):00283                         TFR     D,Y
225D 960F             (         dash.asm):00284         DHZ_LOOP         LDA     <D_X            ; on screen?
225F 814D             (         dash.asm):00285                         CMPA    #XMAX
2261 220E             (         dash.asm):00286                         BHI     DHZ_SKIP
2263 44               (         dash.asm):00287                         LSRA                    ; X -> the cell, carry = right pixel
2264 30A6             (         dash.asm):00288                         LEAX    A,Y             ;  (LEA leaves the carry)
2266 A642             (         dash.asm):00289                         LDA     2,U             ; its mask
2268 2402             (         dash.asm):00290                         BCC     DHZ_ON
226A A643             (         dash.asm):00291                         LDA     3,U
226C 17FEE3           (         dash.asm):00292         DHZ_ON           LBSR    DOP
226F 2003             (         dash.asm):00293                         BRA     DHZ_STEP
2271 17FEF0           (         dash.asm):00294         DHZ_SKIP         LBSR    ADV1
2274 960F             (         dash.asm):00295         DHZ_STEP         LDA     <D_X            ; reached the end?
2276 9111             (         dash.asm):00296                         CMPA    <D_X1
2278 2715             (         dash.asm):00297                         BEQ     DHZ_X
227A 9B13             (         dash.asm):00298                         ADDA    <D_SX
227C 970F             (         dash.asm):00299                         STA     <D_X
227E 20DD             (         dash.asm):00300                         BRA     DHZ_LOOP
2280 17FEE1           (         dash.asm):00301         DHZ_OFF          LBSR    ADV1            ; row off screen: just move on, one
2283 960F             (         dash.asm):00302                         LDA     <D_X            ;  pixel at a time
2285 9111             (         dash.asm):00303                         CMPA    <D_X1
