                      (      src/tgl.asm):00106                         INCLUDE "flip.asm"
                      (         flip.asm):00001         ; ---------------------------------------------------------------------------
                      (         flip.asm):00002         ; T_FLIPH - flip the picture left-to-right, as an animated card turn
                      (         flip.asm):00003         ;   Entry: A = frame length in 50Hz ticks (1-3: 2 is about 0.65 seconds in
                      (         flip.asm):00004         ;          all, 3 about 1 second), DP = $00
                      (         flip.asm):00005         ;   Exit:  all registers preserved. The buffer now holds the mirror image,
                      (         flip.asm):00006         ;          and the screen shows it.
                      (         flip.asm):00007         ;   Uses about 90 bytes of stack.
                      (         flip.asm):00008         ;
                      (         flip.asm):00009         ;   Animates whatever is in the off-screen buffer: the picture narrows
                      (         flip.asm):00010         ;   towards the centre line, goes edge-on, and opens out again mirror
                      (         flip.asm):00011         ;   reversed, like a card turning over. It runs for 15 frames drawn
                      (         flip.asm):00012         ;   straight onto the screen, each paced by TGL_PACE (so a NOPACE build
                      (         flip.asm):00013         ;   runs it as fast as it can), then the buffer is mirrored for real and
                      (         flip.asm):00014         ;   blitted. Row colours (column 0) are left as they are.
                      (         flip.asm):00015         ;
                      (         flip.asm):00016         ;   Each frame, the width follows a cosine curve (the way a turning card
                      (         flip.asm):00017         ;   looks), so screen pixel column X shows source column
                      (         flip.asm):00018         ;       c + (X - c) * s,   s = 1 / cos(angle)
                      (         flip.asm):00019         ;   where c is the centre: 38.5 (or 37.5 in a separated build, 76 pixels
                      (         flip.asm):00020         ;   wide). CELLS, COL1 and XMAX (consts.inc) give the geometry.
                      (         flip.asm):00021         ;   with s < 0 in the second half giving the mirror image. FL_MAP works
                      (         flip.asm):00022         ;   this out for all 78 columns into a table on the stack, stepping out
                      (         flip.asm):00023         ;   from the centre by s each column (no division). FL_DRAW then builds
                      (         flip.asm):00024         ;   each screen cell from its two source pixels using four lookup tables -
                      (         flip.asm):00025         ;   left pixel to left, right to left, left to right, right to right - in
                      (         flip.asm):00026         ;   a row loop whose offsets are patched in for each column.
                      (         flip.asm):00027         ;
                      (         flip.asm):00028         ;   Workspace borrowed from routines that never run at the same time:
     001A             (         flip.asm):00029         FL_TICKS        EQU     R_X1            ; frame length (for TGL_PACE)
     001B             (         flip.asm):00030         FL_K            EQU     R_Y1            ; frame number, 1-15
     000F             (         flip.asm):00031         FL_S            EQU     I_U0            ; 2  this frame's s (8.8 fixed point)
     0011             (         flip.asm):00032         FL_O            EQU     I_V0            ; 2  distance from the centre, source
     0013             (         flip.asm):00033         FL_J            EQU     I_E             ; column counter
     0014             (         flip.asm):00034         FL_COL          EQU     I_SGN           ; screen cell column, 0 .. CELLS-1
     0015             (         flip.asm):00035         FL_CNT          EQU     I_DU            ; row counter
     001D             (         flip.asm):00036         FL_PL           EQU     F_CX1           ; source pixel for a cell's left half
     001E             (         flip.asm):00037         FL_PR           EQU     F_PL            ;  ... and its right half
     0028             (         flip.asm):00038         FL_SRC          EQU     F_ROW           ; 2  address of the column map
                      (         flip.asm):00039         ; ---------------------------------------------------------------------------
1CB0 3476             (         flip.asm):00040         T_FLIPH         PSHS    D,X,Y,U
1CB2 971A             (         flip.asm):00041                         STA     <FL_TICKS
1CB4 32E8B2           (         flip.asm):00042                         LEAS    -78,S           ; the column map: 78 bytes of stack
1CB7 10DF28           (         flip.asm):00043                         STS     <FL_SRC
1CBA 9E00             (         flip.asm):00044                         LDX     <W_BUF          ; row control codes onto the screen
1CBC CEE400           (         flip.asm):00045                         LDU     #VDU_BASE       ;  (columns before COL1 never change)
1CBF C618             (         flip.asm):00046                         LDB     #ROWS
1CC1 A684             (         flip.asm):00047         FL_C0           LDA     ,X
1CC3 A7C4             (         flip.asm):00048                         STA     ,U
                      (         flip.asm):00049                         IFDEF   TGL_SEPARATED
                      (         flip.asm):00050                         LDA     1,X
                      (         flip.asm):00051                         STA     1,U
                      (         flip.asm):00052                         ENDC
1CC5 308828           (         flip.asm):00053                         LEAX    COLS,X
1CC8 33C828           (         flip.asm):00054                         LEAU    COLS,U
1CCB 5A               (         flip.asm):00055                         DECB
1CCC 26F3             (         flip.asm):00056                         BNE     FL_C0
1CCE 8601             (         flip.asm):00057                         LDA     #1
1CD0 971B             (         flip.asm):00058                         STA     <FL_K
1CD2 308D01A2         (         flip.asm):00059         FL_FRAME        LEAX    FL_STAB-2,PCR   ; s for this frame
1CD6 D61B             (         flip.asm):00060                         LDB     <FL_K
1CD8 58               (         flip.asm):00061                         ASLB
1CD9 3A               (         flip.asm):00062                         ABX
1CDA EC84             (         flip.asm):00063                         LDD     ,X
1CDC DD0F             (         flip.asm):00064                         STD     <FL_S
1CDE 17001B           (         flip.asm):00065                         LBSR    FL_MAP          ; which source column for each column
1CE1 170074           (         flip.asm):00066                         LBSR    FL_DRAW         ; draw the frame on the screen
1CE4 961A             (         flip.asm):00067                         LDA     <FL_TICKS       ; and pace it
1CE6 17FC2C           (         flip.asm):00068                         LBSR    T_PACE
1CE9 0C1B             (         flip.asm):00069                         INC     <FL_K
1CEB 961B             (         flip.asm):00070                         LDA     <FL_K
1CED 8110             (         flip.asm):00071                         CMPA    #16
1CEF 25E1             (         flip.asm):00072                         BLO     FL_FRAME
1CF1 17013F           (         flip.asm):00073                         LBSR    FL_MIRROR       ; the buffer becomes the mirror image
1CF4 32E84E           (         flip.asm):00074                         LEAS    78,S
1CF7 17F67A           (         flip.asm):00075                         LBSR    T_BLIT          ; and the screen shows it
1CFA 35F6             (         flip.asm):00076                         PULS    D,X,Y,U,PC
                      (         flip.asm):00077         
                      (         flip.asm):00078         ; ---------------------------------------------------------------------------
                      (         flip.asm):00079         ; FL_MAP - fill the column map: for each screen pixel column X (0-XMAX),
                      (         flip.asm):00080         ;   the source pixel column it shows, or $FF for none (beyond the picture).
                      (         flip.asm):00081         ;   Works out from the centre c (= CELLS - 0.5): at distance j + 0.5 the
                      (         flip.asm):00082         ;   source is at c +/- o with o = (j + 0.5) * s, so o starts at s/2 and
                      (         flip.asm):00083         ;   grows by s each column. Rounded to the nearest column:
                      (         flip.asm):00084         ;   source = (CELLS*256 +/- o) / 256 in 8.8 fixed point. Stops once o is
                      (         flip.asm):00085         ;   beyond the picture's edge.
                      (         flip.asm):00086         ; ---------------------------------------------------------------------------
1CFC 9E28             (         flip.asm):00087         FL_MAP          LDX     <FL_SRC         ; start with every column blank
1CFE 86FF             (         flip.asm):00088                         LDA     #$FF
1D00 C64E             (         flip.asm):00089                         LDB     #2*CELLS
1D02 A780             (         flip.asm):00090         FM_CLR          STA     ,X+
1D04 5A               (         flip.asm):00091                         DECB
1D05 26FB             (         flip.asm):00092                         BNE     FM_CLR
1D07 DC0F             (         flip.asm):00093                         LDD     <FL_S           ; o = s / 2
1D09 47               (         flip.asm):00094                         ASRA
1D0A 56               (         flip.asm):00095                         RORB
1D0B DD11             (         flip.asm):00096                         STD     <FL_O
1D0D 0F13             (         flip.asm):00097                         CLR     <FL_J
1D0F DC11             (         flip.asm):00098         FM_LOOP         LDD     <FL_O           ; |o| beyond the picture? stop
1D11 2A05             (         flip.asm):00099                         BPL     FM_1
1D13 43               (         flip.asm):00100                         COMA
1D14 53               (         flip.asm):00101                         COMB
1D15 C30001           (         flip.asm):00102                         ADDD    #1
1D18 10832800         (         flip.asm):00103         FM_1            CMPD    #(CELLS+1)*256
1D1C 2239             (         flip.asm):00104                         BHI     FM_X
1D1E CC2700           (         flip.asm):00105                         LDD     #CELLS*256      ; right side: X = CELLS + j shows
1D21 D311             (         flip.asm):00106                         ADDD    <FL_O           ;  CELLS*256 + o
1D23 2B0E             (         flip.asm):00107                         BMI     FM_2            ;  (off the left of the picture)
1D25 10834E00         (         flip.asm):00108                         CMPD    #2*CELLS*256
1D29 2C08             (         flip.asm):00109                         BGE     FM_2            ;  (off the right)
1D2B 9E28             (         flip.asm):00110                         LDX     <FL_SRC         ; A = source column
1D2D D613             (         flip.asm):00111                         LDB     <FL_J
1D2F 3A               (         flip.asm):00112                         ABX
1D30 A78827           (         flip.asm):00113                         STA     CELLS,X
1D33 CC2700           (         flip.asm):00114         FM_2            LDD     #CELLS*256      ; left side: X = CELLS - 1 - j shows
1D36 9311             (         flip.asm):00115                         SUBD    <FL_O           ;  CELLS*256 - o
1D38 2B0F             (         flip.asm):00116                         BMI     FM_3
1D3A 10834E00         (         flip.asm):00117                         CMPD    #2*CELLS*256
1D3E 2C09             (         flip.asm):00118                         BGE     FM_3
1D40 9E28             (         flip.asm):00119                         LDX     <FL_SRC
1D42 C626             (         flip.asm):00120                         LDB     #CELLS-1
1D44 D013             (         flip.asm):00121                         SUBB    <FL_J
1D46 3A               (         flip.asm):00122                         ABX
1D47 A784             (         flip.asm):00123                         STA     ,X
1D49 DC11             (         flip.asm):00124         FM_3            LDD     <FL_O           ; next column out
1D4B D30F             (         flip.asm):00125                         ADDD    <FL_S
1D4D DD11             (         flip.asm):00126                         STD     <FL_O
1D4F 0C13             (         flip.asm):00127                         INC     <FL_J
1D51 9613             (         flip.asm):00128                         LDA     <FL_J
