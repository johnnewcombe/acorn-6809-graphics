22C2 9710             (         dash.asm):00339                         STA     <D_Y
22C4 3344             (         dash.asm):00340                         LEAU    4,U             ; U follows y down ...
22C6 0D14             (         dash.asm):00341                         TST     <D_SY
22C8 2AD5             (         dash.asm):00342                         BPL     DVT_LOOP
