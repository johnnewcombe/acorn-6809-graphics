                      (      src/tgl.asm):00086                         INCLUDE "rect.asm"
                      (         rect.asm):00001         ; ---------------------------------------------------------------------------
                      (         rect.asm):00002         ; Rectangles - outlined and filled
                      (         rect.asm):00003         ;   Both take two opposite corners in the same registers as TGL_LINEC:
                      (         rect.asm):00004         ;   A = x0, B = y0, X = x1 (high byte) : y1 (low byte). Coordinates are
                      (         rect.asm):00005         ;   signed (-128..127), the corners can be in any order, and anything off
                      (         rect.asm):00006         ;   screen is clipped. Both use the current plot mode.
                      (         rect.asm):00007         ; ---------------------------------------------------------------------------
                      (         rect.asm):00008         
                      (         rect.asm):00009         ; ---------------------------------------------------------------------------
                      (         rect.asm):00010         ; T_RECT - outlined rectangle
                      (         rect.asm):00011         ;   Entry: A = x0, B = y0, X = x1:y1 (signed), DP = $00
                      (         rect.asm):00012         ;   Exit:  all registers preserved
                      (         rect.asm):00013         ;
                      (         rect.asm):00014         ;   Drawn as up to four thin filled rectangles that never overlap, so every
                      (         rect.asm):00015         ;   pixel is drawn exactly once (XOR mode can then remove the rectangle
                      (         rect.asm):00016         ;   again), and the fill's cell-at-a-time speed and clipping come for free:
                      (         rect.asm):00017         ;     top     (x0,y0)   - (x1,y0)
                      (         rect.asm):00018         ;     bottom  (x0,y1)   - (x1,y1)     only if y1 > y0
                      (         rect.asm):00019         ;     left    (x0,y0+1) - (x0,y1-1)   only if y1 - y0 >= 2
                      (         rect.asm):00020         ;     right   (x1,y0+1) - (x1,y1-1)   likewise, and only if x1 > x0
                      (         rect.asm):00021         ;   T_RECTF reuses the R_ variables, so the sorted corners are kept on the
                      (         rect.asm):00022         ;   stack: 0,S = x0, 1,S = y0, 2,S = x1, 3,S = y1.
                      (         rect.asm):00023         ; ---------------------------------------------------------------------------
1447 3476             (         rect.asm):00024         T_RECT          PSHS    D,X,Y,U
1449 17017E           (         rect.asm):00025                         LBSR    R_SORT          ; corners sorted into R_X0..R_Y1
144C DC18             (         rect.asm):00026                         LDD     <R_X0           ; keep a copy on the stack
144E 9E1A             (         rect.asm):00027                         LDX     <R_X1
1450 3416             (         rect.asm):00028                         PSHS    D,X
                      (         rect.asm):00029         
1452 A662             (         rect.asm):00030                         LDA     2,S             ; top edge
1454 E661             (         rect.asm):00031                         LDB     1,S
1456 1F01             (         rect.asm):00032                         TFR     D,X             ; X = x1:y0
1458 A6E4             (         rect.asm):00033                         LDA     ,S              ; A,B = x0,y0
145A 17003A           (         rect.asm):00034                         LBSR    T_RECTF
                      (         rect.asm):00035         
145D A663             (         rect.asm):00036                         LDA     3,S             ; bottom edge, if a different row
145F A161             (         rect.asm):00037                         CMPA    1,S
1461 2F30             (         rect.asm):00038                         BLE     RC_X
1463 A662             (         rect.asm):00039                         LDA     2,S
1465 E663             (         rect.asm):00040                         LDB     3,S
1467 1F01             (         rect.asm):00041                         TFR     D,X             ; X = x1:y1
1469 A6E4             (         rect.asm):00042                         LDA     ,S              ; A,B = x0,y1
146B 170029           (         rect.asm):00043                         LBSR    T_RECTF
                      (         rect.asm):00044         
146E A663             (         rect.asm):00045                         LDA     3,S             ; sides, only if there is a gap
1470 4A               (         rect.asm):00046                         DECA                    ;  between top and bottom
1471 A161             (         rect.asm):00047                         CMPA    1,S             ;  (y1-1 > y0; no overflow, as
1473 2F1E             (         rect.asm):00048                         BLE     RC_X            ;  y1 > y0 here)
1475 A6E4             (         rect.asm):00049                         LDA     ,S              ; left side
1477 E663             (         rect.asm):00050                         LDB     3,S
1479 5A               (         rect.asm):00051                         DECB
147A 1F01             (         rect.asm):00052                         TFR     D,X             ; X = x0:y1-1
147C E661             (         rect.asm):00053                         LDB     1,S
147E 5C               (         rect.asm):00054                         INCB                    ; A,B = x0,y0+1
147F 170015           (         rect.asm):00055                         LBSR    T_RECTF
                      (         rect.asm):00056         
1482 A662             (         rect.asm):00057                         LDA     2,S             ; right side, if a different column
1484 A1E4             (         rect.asm):00058                         CMPA    ,S
1486 2F0B             (         rect.asm):00059                         BLE     RC_X
1488 E663             (         rect.asm):00060                         LDB     3,S
148A 5A               (         rect.asm):00061                         DECB
148B 1F01             (         rect.asm):00062                         TFR     D,X             ; X = x1:y1-1
148D E661             (         rect.asm):00063                         LDB     1,S
148F 5C               (         rect.asm):00064                         INCB                    ; A,B = x1,y0+1
1490 170004           (         rect.asm):00065                         LBSR    T_RECTF
1493 3264             (         rect.asm):00066         RC_X            LEAS    4,S             ; drop the copy
1495 35F6             (         rect.asm):00067                         PULS    D,X,Y,U,PC
                      (         rect.asm):00068         
                      (         rect.asm):00069         ; ---------------------------------------------------------------------------
                      (         rect.asm):00070         ; T_RECTF - filled rectangle
                      (         rect.asm):00071         ;   Entry: A = x0, B = y0, X = x1:y1 (signed), DP = $00
                      (         rect.asm):00072         ;   Exit:  all registers preserved
                      (         rect.asm):00073         ;
                      (         rect.asm):00074         ;   Works a cell row (three sixel rows) at a time. In each cell row the
                      (         rect.asm):00075         ;   rectangle covers sixel rows top..bottom of every cell, which gives a
                      (         rect.asm):00076         ;   mask for the cell's left pixels (F_ML) and right pixels (F_MR). Along
                      (         rect.asm):00077         ;   the row:
                      (         rect.asm):00078         ;     - if x0 is odd, the first cell gets only its right pixels
                      (         rect.asm):00079         ;     - the cells in between get both: F_ML | F_MR, applied as one run
                      (         rect.asm):00080         ;     - if x1 is even, the last cell gets only its left pixels
                      (         rect.asm):00081         ;     - if the whole width falls in one cell, that cell gets whichever of
                      (         rect.asm):00082         ;       its pixels are inside
                      (         rect.asm):00083         ;   Only the first and last cell rows can be partial vertically (top > 0
                      (         rect.asm):00084         ;   or bottom < 2); every row in between covers all three sixel rows, so
                      (         rect.asm):00085         ;   its masks are constants and need no lookup.
                      (         rect.asm):00086         ; ---------------------------------------------------------------------------
1497 3476             (         rect.asm):00087         T_RECTF         PSHS    D,X,Y,U
1499 17012E           (         rect.asm):00088                         LBSR    R_SORT
                      (         rect.asm):00089         
                      (         rect.asm):00090         ; Nothing to do if the rectangle is entirely off one side of the screen
149C 961A             (         rect.asm):00091                         LDA     <R_X1
149E 102B0119         (         rect.asm):00092                         LBMI    RF_X            ; right edge left of the screen
14A2 961B             (         rect.asm):00093                         LDA     <R_Y1
14A4 102B0113         (         rect.asm):00094                         LBMI    RF_X            ; bottom edge above the screen
14A8 9618             (         rect.asm):00095                         LDA     <R_X0
14AA 814D             (         rect.asm):00096                         CMPA    #XMAX
14AC 102E010B         (         rect.asm):00097                         LBGT    RF_X            ; left edge right of the screen
14B0 9619             (         rect.asm):00098                         LDA     <R_Y0
14B2 8147             (         rect.asm):00099                         CMPA    #YMAX
14B4 102E0103         (         rect.asm):00100                         LBGT    RF_X            ; top edge below the screen
                      (         rect.asm):00101         
                      (         rect.asm):00102         ; Clip by clamping the edges to the screen
14B8 9618             (         rect.asm):00103                         LDA     <R_X0
14BA 2A02             (         rect.asm):00104                         BPL     RF_1
14BC 0F18             (         rect.asm):00105                         CLR     <R_X0
14BE 9619             (         rect.asm):00106         RF_1            LDA     <R_Y0
14C0 2A02             (         rect.asm):00107                         BPL     RF_2
14C2 0F19             (         rect.asm):00108                         CLR     <R_Y0
14C4 961A             (         rect.asm):00109         RF_2            LDA     <R_X1
14C6 814D             (         rect.asm):00110                         CMPA    #XMAX
14C8 2F04             (         rect.asm):00111                         BLE     RF_3
14CA 864D             (         rect.asm):00112                         LDA     #XMAX
14CC 971A             (         rect.asm):00113                         STA     <R_X1
14CE 961B             (         rect.asm):00114         RF_3            LDA     <R_Y1
14D0 8147             (         rect.asm):00115                         CMPA    #YMAX
14D2 2F04             (         rect.asm):00116                         BLE     RF_4
14D4 8647             (         rect.asm):00117                         LDA     #YMAX
14D6 971B             (         rect.asm):00118                         STA     <R_Y1
                      (         rect.asm):00119         
                      (         rect.asm):00120         ; Work out the column plan once: it is the same for every row
14D8 9618             (         rect.asm):00121         RF_4            LDA     <R_X0           ; first cell = x0/2, and is x0 odd?
14DA 44               (         rect.asm):00122                         LSRA
14DB 971C             (         rect.asm):00123                         STA     <F_CX0
14DD 8600             (         rect.asm):00124                         LDA     #0              ; (not CLRA: that would clear carry)
14DF 49               (         rect.asm):00125                         ROLA                    ; carry (x0 odd) -> bit 0
14E0 971E             (         rect.asm):00126                         STA     <F_PL
14E2 961A             (         rect.asm):00127                         LDA     <R_X1           ; last cell = x1/2, and is x1 even?
14E4 44               (         rect.asm):00128                         LSRA
14E5 971D             (         rect.asm):00129                         STA     <F_CX1
14E7 8600             (         rect.asm):00130                         LDA     #0              ; keep carry (x1 odd)
14E9 49               (         rect.asm):00131                         ROLA
14EA 8801             (         rect.asm):00132                         EORA    #1              ; 1 if x1 even
14EC 971F             (         rect.asm):00133                         STA     <F_PR
14EE 0F20             (         rect.asm):00134                         CLR     <F_SGL
14F0 961C             (         rect.asm):00135                         LDA     <F_CX0
14F2 911D             (         rect.asm):00136                         CMPA    <F_CX1
14F4 2604             (         rect.asm):00137                         BNE     RF_5
14F6 0C20             (         rect.asm):00138                         INC     <F_SGL          ; one cell wide
14F8 200F             (         rect.asm):00139                         BRA     RF_6
14FA 961C             (         rect.asm):00140         RF_5            LDA     <F_CX0          ; full-width run: from the first cell
14FC 9B1E             (         rect.asm):00141                         ADDA    <F_PL           ;  (or the one after, if partial)
14FE 9721             (         rect.asm):00142                         STA     <F_RS
1500 961D             (         rect.asm):00143                         LDA     <F_CX1          ;  to the last (or the one before)
1502 901F             (         rect.asm):00144                         SUBA    <F_PR
1504 9021             (         rect.asm):00145                         SUBA    <F_RS
1506 4C               (         rect.asm):00146                         INCA
1507 9722             (         rect.asm):00147                         STA     <F_RN           ; number of cells, may be 0
                      (         rect.asm):00148         
                      (         rect.asm):00149         ; Find the first and last cell rows, and where y0 and y1 fall within them
1509 D619             (         rect.asm):00150         RF_6            LDB     <R_Y0
150B 1700D9           (         rect.asm):00151                         LBSR    PT_ENTRY        ; U -> PTAB entry for y0
150E ECC4             (         rect.asm):00152                         LDD     ,U
1510 D300             (         rect.asm):00153                         ADDD    <W_BUF
1512 DD28             (         rect.asm):00154                         STD     <F_ROW          ; first cell row (column 1)
1514 A642             (         rect.asm):00155                         LDA     2,U
1516 1700DA           (         rect.asm):00156                         LBSR    SUBROW
1519 9723             (         rect.asm):00157                         STA     <F_TOP          ; y0 mod 3
151B D61B             (         rect.asm):00158                         LDB     <R_Y1
151D 1700C7           (         rect.asm):00159                         LBSR    PT_ENTRY
1520 ECC4             (         rect.asm):00160                         LDD     ,U
1522 D300             (         rect.asm):00161                         ADDD    <W_BUF
1524 DD2A             (         rect.asm):00162                         STD     <F_LAST         ; last cell row
1526 A642             (         rect.asm):00163                         LDA     2,U
1528 1700C8           (         rect.asm):00164                         LBSR    SUBROW
152B 9724             (         rect.asm):00165                         STA     <F_BOTL         ; y1 mod 3
                      (         rect.asm):00166         
                      (         rect.asm):00167         ; One cell row per pass
152D 9E28             (         rect.asm):00168         RF_ROW          LDX     <F_ROW          ; is this the last cell row?
152F 9C2A             (         rect.asm):00169                         CMPX    <F_LAST
1531 2712             (         rect.asm):00170                         BEQ     RF_LASTR
1533 0D23             (         rect.asm):00171                         TST     <F_TOP          ; a middle row: all three sixel rows
1535 260A             (         rect.asm):00172                         BNE     RF_FIRST        ;  are covered, so the masks are
1537 8615             (         rect.asm):00173                         LDA     #$15            ;  constants (left pixels 1+4+16,
1539 9725             (         rect.asm):00174                         STA     <F_ML           ;  right pixels 2+8+64) - no need
153B 864A             (         rect.asm):00175                         LDA     #$4A            ;  to look them up
153D 9726             (         rect.asm):00176                         STA     <F_MR
153F 201F             (         rect.asm):00177                         BRA     RF_COLS
1541 C602             (         rect.asm):00178         RF_FIRST        LDB     #2              ; first row (starts part-way down):
1543 2002             (         rect.asm):00179                         BRA     RF_7            ;  sixel rows top..2
1545 D624             (         rect.asm):00180         RF_LASTR        LDB     <F_BOTL         ; last row: sixel rows top..y1 mod 3
1547 9623             (         rect.asm):00181         RF_7            LDA     <F_TOP          ; index = top*3 + bottom
1549 3404             (         rect.asm):00182                         PSHS    B
154B C603             (         rect.asm):00183                         LDB     #3
154D 3D               (         rect.asm):00184                         MUL                     ; B = top*3 (A is 0)
154E EBE0             (         rect.asm):00185                         ADDB    ,S+
1550 338D0458         (         rect.asm):00186                         LEAU    LTAB,PCR        ; masks for this cell row
1554 A6C5             (         rect.asm):00187                         LDA     B,U
1556 9725             (         rect.asm):00188                         STA     <F_ML
1558 338D0459         (         rect.asm):00189                         LEAU    RTAB,PCR
155C A6C5             (         rect.asm):00190                         LDA     B,U
155E 9726             (         rect.asm):00191                         STA     <F_MR
                      (         rect.asm):00192         
1560 0D20             (         rect.asm):00193         RF_COLS         TST     <F_SGL          ; one cell wide?
1562 2718             (         rect.asm):00194                         BEQ     RF_MULTI
1564 4F               (         rect.asm):00195                         CLRA                    ; its left pixels count if x0 even,
1565 0D1E             (         rect.asm):00196                         TST     <F_PL           ;  its right pixels if x1 odd
1567 2602             (         rect.asm):00197                         BNE     RF_8
1569 9A25             (         rect.asm):00198                         ORA     <F_ML
156B 0D1F             (         rect.asm):00199         RF_8            TST     <F_PR
156D 2602             (         rect.asm):00200                         BNE     RF_9
156F 9A26             (         rect.asm):00201                         ORA     <F_MR
1571 9E28             (         rect.asm):00202         RF_9            LDX     <F_ROW
1573 D61C             (         rect.asm):00203                         LDB     <F_CX0
