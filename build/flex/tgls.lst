                      (         flip.asm):00238         ; FL_MIRROR - mirror the buffer left-to-right in place: in each row, swap
                      (         flip.asm):00239         ;   the pixel cells in pairs from the outside in (1-19 with 39-21, or in a
                      (         flip.asm):00240         ;   separated build 2-20 with 39-21), mirroring each (its left and right
                      (         flip.asm):00241         ;   pixels swapped), and mirror the middle cell, if there is one (cell 20)
                      (         flip.asm):00242         ; ---------------------------------------------------------------------------
