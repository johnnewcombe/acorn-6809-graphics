1BE7 913B             (       CW_ROWBITS):00011                         CMPA    <S_B+0
1BE9 2202             (       CW_ROWBITS):00012                         BHI     CR0_D
1BEB DA2F             (       CW_ROWBITS):00013                         ORB     <S_MR+0
1BED 4A               (       CW_ROWBITS):00014         CR0_D            DECA
1BEE                  (       CW_ROWBITS):00015         CR0_N
                      (      polygon.asm):00434                         CW_ROWBITS 1,CR1
