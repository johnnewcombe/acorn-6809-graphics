                      (       circle.asm):00287         ; ---------------------------------------------------------------------------
                      (       circle.asm):00288         ; NEXTX - move on to the next row: update f and x, return the next row's
                      (       circle.asm):00289         ;   scaled half-width in A. (C_ROW still holds the current row offset y.)
                      (       circle.asm):00290         ; ---------------------------------------------------------------------------
1866 D62F             (       circle.asm):00291         NEXTX           LDB     <C_ROW          ; f = f + 2y + 1
1868 4F               (       circle.asm):00292                         CLRA
1869 58               (       circle.asm):00293                         ASLB
186A 49               (       circle.asm):00294                         ROLA
186B C30001           (       circle.asm):00295                         ADDD    #1
186E D331             (       circle.asm):00296                         ADDD    <C_F
1870 DD31             (       circle.asm):00297                         STD     <C_F
1872 DC31             (       circle.asm):00298         NX_LOOP         LDD     <C_F            ; while f > 0 (and x > 0) ...
1874 2F18             (       circle.asm):00299                         BLE     NX_DONE
1876 0D30             (       circle.asm):00300                         TST     <C_X
1878 2714             (       circle.asm):00301                         BEQ     NX_DONE
187A D630             (       circle.asm):00302                         LDB     <C_X            ; ... f = f - (2x - 1)
187C 4F               (       circle.asm):00303                         CLRA
187D 58               (       circle.asm):00304                         ASLB
187E 49               (       circle.asm):00305                         ROLA
187F 830001           (       circle.asm):00306                         SUBD    #1
1882 3406             (       circle.asm):00307                         PSHS    D
1884 DC31             (       circle.asm):00308                         LDD     <C_F
1886 A3E1             (       circle.asm):00309                         SUBD    ,S++
1888 DD31             (       circle.asm):00310                         STD     <C_F
188A 0A30             (       circle.asm):00311                         DEC     <C_X            ; ... x = x - 1
188C 20E4             (       circle.asm):00312                         BRA     NX_LOOP
188E 9630             (       circle.asm):00313         NX_DONE         LDA     <C_X
                      (       circle.asm):00314                         ; fall into SCALEX
                      (       circle.asm):00315         
                      (       circle.asm):00316         ; ---------------------------------------------------------------------------
                      (       circle.asm):00317         ; SCALEX - aspect correction: A = (A * 13 + 8) / 16, rounded
