1E4A AAA5             (         flip.asm):00205                         ORA     B,Y             ;  table ...
1E4C A7890000         (         flip.asm):00206         FG_D0           STA     >0,X            ; ... onto the screen
1E50 E68828           (         flip.asm):00207         FG_L1           LDB     <COLS,X         ; row 1
1E53 A6C5             (         flip.asm):00208                         LDA     B,U
1E55 E68828           (         flip.asm):00209         FG_R1           LDB     <COLS,X
1E58 AAA5             (         flip.asm):00210                         ORA     B,Y
1E5A A7890028         (         flip.asm):00211         FG_D1           STA     >COLS,X
1E5E E68850           (         flip.asm):00212         FG_L2           LDB     <2*COLS,X       ; row 2
1E61 A6C5             (         flip.asm):00213                         LDA     B,U
