                      (      src/tgl.asm):00101                         INCLUDE "circle.asm"
                      (       circle.asm):00001         ; ---------------------------------------------------------------------------
                      (       circle.asm):00002         ; Circles - outlined and filled, corrected for the pixel shape
                      (       circle.asm):00003         ;   Entry: A = centre x, B = centre y (signed, -128..127),
                      (       circle.asm):00004         ;          X = radius in vertical pixels (0-127; larger values count as 127)
                      (       circle.asm):00005         ;          DP = $00
                      (       circle.asm):00006         ;   Exit:  all registers preserved
                      (       circle.asm):00007         ;   Both clip to the screen and use the current plot mode.
                      (       circle.asm):00008         ;
                      (       circle.asm):00009         ;   Teletext pixels are about 1.2 times wider than they are tall, so a
                      (       circle.asm):00010         ;   shape that is round in pixels looks squashed. Every half-width is
                      (       circle.asm):00011         ;   therefore scaled by 13/16 (0.81), the same correction the cube demo's
                      (       circle.asm):00012         ;   projection uses, so circles look round on screen.
                      (       circle.asm):00013         ;
                      (       circle.asm):00014         ;   The circle is worked out a row at a time, from the centre row outwards.
                      (       circle.asm):00015         ;   For row offset y, the unscaled half-width x is the largest x with
                      (       circle.asm):00016         ;   x^2 + y^2 <= r^2 + r (the midpoint rule, which rounds to the nearest
                      (       circle.asm):00017         ;   pixel). Moving to the next row only ever shrinks x, and the test can be
                      (       circle.asm):00018         ;   kept up to date with additions alone:
                      (       circle.asm):00019         ;       f = x^2 + y^2 - r^2 - r       (start: x = r, y = 0, so f = -r)
                      (       circle.asm):00020         ;       next row:     f = f + 2y + 1, then y = y + 1
                      (       circle.asm):00021         ;       while f > 0:  f = f - (2x - 1), x = x - 1
                      (       circle.asm):00022         ;
                      (       circle.asm):00023         ;   Outline: each row draws the run of pixels from just beyond the next
                      (       circle.asm):00024         ;   row's edge out to this row's edge (at least one pixel), on both sides,
                      (       circle.asm):00025         ;   for the rows above and below the centre. That joins the rows into an
                      (       circle.asm):00026         ;   unbroken outline and draws every pixel exactly once, so XOR works.
                      (       circle.asm):00027         ;   Filled: each row draws one span from edge to edge.
                      (       circle.asm):00028         ;   Runs and spans are drawn by HSPAN, a lean one-row fill.
                      (       circle.asm):00029         ; ---------------------------------------------------------------------------
                      (       circle.asm):00030         
16C2 3476             (       circle.asm):00031         T_CIRC          PSHS    D,X,Y,U
16C4 1701DA           (       circle.asm):00032                         LBSR    CI_SETUP
16C7 0F37             (       circle.asm):00033                         CLR     <C_FILL         ; outline
16C9 860F             (       circle.asm):00034                         LDA     #$0F            ; outlines are always solid
16CB 975C             (       circle.asm):00035                         STA     <H_PAT
16CD 200D             (       circle.asm):00036                         BRA     CI_RUN
                      (       circle.asm):00037         
16CF 3476             (       circle.asm):00038         T_CIRCF         PSHS    D,X,Y,U
16D1 1701CD           (       circle.asm):00039                         LBSR    CI_SETUP
16D4 8601             (       circle.asm):00040                         LDA     #1              ; filled
16D6 9737             (       circle.asm):00041                         STA     <C_FILL
16D8 965D             (       circle.asm):00042                         LDA     <U_PAT          ; filled circles use the fill pattern
16DA 975C             (       circle.asm):00043                         STA     <H_PAT
                      (       circle.asm):00044         
16DC 0F2F             (       circle.asm):00045         CI_RUN          CLR     <C_ROW          ; start at the centre row
16DE D62E             (       circle.asm):00046                         LDB     <C_R            ; x = r
16E0 D730             (       circle.asm):00047                         STB     <C_X
16E2 4F               (       circle.asm):00048                         CLRA                    ; f = -r
16E3 43               (       circle.asm):00049                         COMA                    ;  (negate D: complement, add 1)
16E4 53               (       circle.asm):00050                         COMB
16E5 C30001           (       circle.asm):00051                         ADDD    #1
16E8 DD31             (       circle.asm):00052                         STD     <C_F
16EA 9630             (       circle.asm):00053                         LDA     <C_X            ; half-width of the centre row
16EC 1701A1           (       circle.asm):00054                         LBSR    SCALEX
16EF 9733             (       circle.asm):00055                         STA     <C_HC
                      (       circle.asm):00056         
16F1 962F             (       circle.asm):00057         CI_LOOP         LDA     <C_ROW          ; on the outermost row there is no
16F3 912E             (       circle.asm):00058                         CMPA    <C_R            ;  next row: draw it edge to edge
16F5 2710             (       circle.asm):00059                         BEQ     CI_TOP
16F7 17016C           (       circle.asm):00060                         LBSR    NEXTX           ; next row's half-width
16FA 9734             (       circle.asm):00061                         STA     <C_HN
16FC 4C               (       circle.asm):00062                         INCA                    ; this row's run starts just beyond
16FD 9133             (       circle.asm):00063                         CMPA    <C_HC           ;  the next row's edge, but never
16FF 2302             (       circle.asm):00064                         BLS     CI_S1           ;  past this row's own edge
1701 9633             (       circle.asm):00065                         LDA     <C_HC
1703 9735             (       circle.asm):00066         CI_S1           STA     <C_ST
1705 2002             (       circle.asm):00067                         BRA     CI_DRAW
1707 0F35             (       circle.asm):00068         CI_TOP          CLR     <C_ST           ; start 0 = one span, edge to edge
                      (       circle.asm):00069         
1709 0D37             (       circle.asm):00070         CI_DRAW         TST     <C_FILL         ; filled circles always draw the
170B 2702             (       circle.asm):00071                         BEQ     CI_ROWS         ;  full span
170D 0F35             (       circle.asm):00072                         CLR     <C_ST
                      (       circle.asm):00073         
170F 962D             (       circle.asm):00074         CI_ROWS         LDA     <C_CY           ; the row below the centre (screen y
1711 9B2F             (       circle.asm):00075                         ADDA    <C_ROW          ;  grows downwards). Saturate rather
1713 2802             (       circle.asm):00076                         BVC     CI_Y1           ;  than wrap: a row that far out is
1715 867F             (       circle.asm):00077                         LDA     #127            ;  off screen and gets clipped anyway
1717 9736             (       circle.asm):00078         CI_Y1           STA     <C_Y
1719 8D20             (       circle.asm):00079                         BSR     CI_ROWDRAW
171B 0D2F             (       circle.asm):00080                         TST     <C_ROW          ; the row above, except for the
171D 270C             (       circle.asm):00081                         BEQ     CI_NEXT         ;  centre row itself
171F 962D             (       circle.asm):00082                         LDA     <C_CY
1721 902F             (       circle.asm):00083                         SUBA    <C_ROW
1723 2802             (       circle.asm):00084                         BVC     CI_Y2
1725 8680             (       circle.asm):00085                         LDA     #-128
1727 9736             (       circle.asm):00086         CI_Y2           STA     <C_Y
1729 8D10             (       circle.asm):00087                         BSR     CI_ROWDRAW
                      (       circle.asm):00088         
172B 962F             (       circle.asm):00089         CI_NEXT         LDA     <C_ROW          ; done the outermost row?
172D 912E             (       circle.asm):00090                         CMPA    <C_R
172F 2708             (       circle.asm):00091                         BEQ     CI_END
1731 0C2F             (       circle.asm):00092                         INC     <C_ROW
1733 9634             (       circle.asm):00093                         LDA     <C_HN           ; next row's half-width becomes
1735 9733             (       circle.asm):00094                         STA     <C_HC           ;  this row's
1737 20B8             (       circle.asm):00095                         BRA     CI_LOOP
1739 35F6             (       circle.asm):00096         CI_END          PULS    D,X,Y,U,PC
                      (       circle.asm):00097         
                      (       circle.asm):00098         ; ---------------------------------------------------------------------------
                      (       circle.asm):00099         ; CI_ROWDRAW - draw one row (screen y in C_Y)
                      (       circle.asm):00100         ;   C_ST = 0: one span from cx - half-width to cx + half-width.
                      (       circle.asm):00101         ;   C_ST > 0: two runs, cx + C_ST .. cx + half-width on the right and its
                      (       circle.asm):00102         ;   mirror image on the left.
                      (       circle.asm):00103         ;   Screen x values saturate at -128 / 127 instead of wrapping; anything
                      (       circle.asm):00104         ;   that far out is off screen and clipped anyway.
                      (       circle.asm):00105         ; ---------------------------------------------------------------------------
173B 0D35             (       circle.asm):00106         CI_ROWDRAW      TST     <C_ST
173D 2618             (       circle.asm):00107                         BNE     RD_TWO
173F 962C             (       circle.asm):00108                         LDA     <C_CX           ; one span: left end ...
1741 9033             (       circle.asm):00109                         SUBA    <C_HC
1743 2802             (       circle.asm):00110                         BVC     RD_1
1745 8680             (       circle.asm):00111                         LDA     #-128
1747 3402             (       circle.asm):00112         RD_1            PSHS    A
1749 962C             (       circle.asm):00113                         LDA     <C_CX           ; ... right end
174B 9B33             (       circle.asm):00114                         ADDA    <C_HC
174D 2802             (       circle.asm):00115                         BVC     RD_2
