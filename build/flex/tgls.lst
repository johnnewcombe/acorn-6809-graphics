1753 3502             (       circle.asm):00118                         PULS    A
1755 202E             (       circle.asm):00119                         BRA     DRUN
                      (       circle.asm):00120         
1757 962C             (       circle.asm):00121         RD_TWO          LDA     <C_CX           ; right-hand run: cx + start ...
1759 9B35             (       circle.asm):00122                         ADDA    <C_ST
175B 2802             (       circle.asm):00123                         BVC     RD_3
175D 867F             (       circle.asm):00124                         LDA     #127
175F 3402             (       circle.asm):00125         RD_3            PSHS    A
1761 962C             (       circle.asm):00126                         LDA     <C_CX           ; ... to cx + half-width
1763 9B33             (       circle.asm):00127                         ADDA    <C_HC
1765 2802             (       circle.asm):00128                         BVC     RD_4
1767 867F             (       circle.asm):00129                         LDA     #127
1769 1F89             (       circle.asm):00130         RD_4            TFR     A,B
176B 3502             (       circle.asm):00131                         PULS    A
176D 8D16             (       circle.asm):00132                         BSR     DRUN
176F 962C             (       circle.asm):00133                         LDA     <C_CX           ; left-hand run: cx - half-width ...
1771 9033             (       circle.asm):00134                         SUBA    <C_HC
1773 2802             (       circle.asm):00135                         BVC     RD_5
1775 8680             (       circle.asm):00136                         LDA     #-128
1777 3402             (       circle.asm):00137         RD_5            PSHS    A
1779 962C             (       circle.asm):00138                         LDA     <C_CX           ; ... to cx - start
177B 9035             (       circle.asm):00139                         SUBA    <C_ST
177D 2802             (       circle.asm):00140                         BVC     RD_6
177F 8680             (       circle.asm):00141                         LDA     #-128
1781 1F89             (       circle.asm):00142         RD_6            TFR     A,B
