                      (      src/tgl.asm):00106                         INCLUDE "flip.asm"
                      (         flip.asm):00001         ; ---------------------------------------------------------------------------
                      (         flip.asm):00002         ; T_FLIPH - flip the picture left-to-right, as an animated card turn
                      (         flip.asm):00003         ;   Entry: A = frame length in 50Hz ticks (1-3: 2 is about 0.65 seconds in
                      (         flip.asm):00004         ;          all, 3 about 1 second), DP = $00
                      (         flip.asm):00005         ;   Exit:  all registers preserved. The buffer now holds the mirror image,
                      (         flip.asm):00006         ;          and the screen shows it.
                      (         flip.asm):00007         ;   Uses about 90 bytes of stack.
                      (         flip.asm):00008         ;
                      (         flip.asm):00009         ;   Animates whatever is in the off-screen buffer: the picture narrows
                      (         flip.asm):00010         ;   towards the centre line, goes edge-on, and opens out again mirror
                      (         flip.asm):00011         ;   reversed, like a card turning over. It runs for 15 frames drawn
                      (         flip.asm):00012         ;   straight onto the screen, each paced by TGL_PACE (so a NOPACE build
                      (         flip.asm):00013         ;   runs it as fast as it can), then the buffer is mirrored for real and
                      (         flip.asm):00014         ;   blitted. Row colours (column 0) are left as they are.
                      (         flip.asm):00015         ;
                      (         flip.asm):00016         ;   Each frame, the width follows a cosine curve (the way a turning card
                      (         flip.asm):00017         ;   looks), so screen pixel column X shows source column
                      (         flip.asm):00018         ;       c + (X - c) * s,   s = 1 / cos(angle)
                      (         flip.asm):00019         ;   where c is the centre: 38.5 (or 37.5 in a separated build, 76 pixels
                      (         flip.asm):00020         ;   wide). CELLS, COL1 and XMAX (consts.inc) give the geometry.
                      (         flip.asm):00021         ;   with s < 0 in the second half giving the mirror image. FL_MAP works
                      (         flip.asm):00022         ;   this out for all 78 columns into a table on the stack, stepping out
                      (         flip.asm):00023         ;   from the centre by s each column (no division). FL_DRAW then builds
                      (         flip.asm):00024         ;   each screen cell from its two source pixels using four lookup tables -
                      (         flip.asm):00025         ;   left pixel to left, right to left, left to right, right to right - in
                      (         flip.asm):00026         ;   a row loop whose offsets are patched in for each column.
                      (         flip.asm):00027         ;
                      (         flip.asm):00028         ;   Workspace borrowed from routines that never run at the same time:
     001A             (         flip.asm):00029         FL_TICKS        EQU     R_X1            ; frame length (for TGL_PACE)
     001B             (         flip.asm):00030         FL_K            EQU     R_Y1            ; frame number, 1-15
     000F             (         flip.asm):00031         FL_S            EQU     I_U0            ; 2  this frame's s (8.8 fixed point)
     0011             (         flip.asm):00032         FL_O            EQU     I_V0            ; 2  distance from the centre, source
     0013             (         flip.asm):00033         FL_J            EQU     I_E             ; column counter
     0014             (         flip.asm):00034         FL_COL          EQU     I_SGN           ; screen cell column, 0 .. CELLS-1
     0015             (         flip.asm):00035         FL_CNT          EQU     I_DU            ; row counter
     001D             (         flip.asm):00036         FL_PL           EQU     F_CX1           ; source pixel for a cell's left half
     001E             (         flip.asm):00037         FL_PR           EQU     F_PL            ;  ... and its right half
     0028             (         flip.asm):00038         FL_SRC          EQU     F_ROW           ; 2  address of the column map
                      (         flip.asm):00039         ; ---------------------------------------------------------------------------
1D0D 3476             (         flip.asm):00040         T_FLIPH         PSHS    D,X,Y,U
1D0F 971A             (         flip.asm):00041                         STA     <FL_TICKS
1D11 32E8B2           (         flip.asm):00042                         LEAS    -78,S           ; the column map: 78 bytes of stack
1D14 10DF28           (         flip.asm):00043                         STS     <FL_SRC
1D17 9E00             (         flip.asm):00044                         LDX     <W_BUF          ; row control codes onto the screen
1D19 CEE400           (         flip.asm):00045                         LDU     #VDU_BASE       ;  (columns before COL1 never change)
1D1C C618             (         flip.asm):00046                         LDB     #ROWS
1D1E A684             (         flip.asm):00047         FL_C0           LDA     ,X
1D20 A7C4             (         flip.asm):00048                         STA     ,U
                      (         flip.asm):00049                         IFDEF   TGL_SEPARATED
1D22 A601             (         flip.asm):00050                         LDA     1,X
1D24 A741             (         flip.asm):00051                         STA     1,U
                      (         flip.asm):00052                         ENDC
1D26 308828           (         flip.asm):00053                         LEAX    COLS,X
1D29 33C828           (         flip.asm):00054                         LEAU    COLS,U
1D2C 5A               (         flip.asm):00055                         DECB
1D2D 26EF             (         flip.asm):00056                         BNE     FL_C0
1D2F 8601             (         flip.asm):00057                         LDA     #1
1D31 971B             (         flip.asm):00058                         STA     <FL_K
1D33 308D019C         (         flip.asm):00059         FL_FRAME        LEAX    FL_STAB-2,PCR   ; s for this frame
1D37 D61B             (         flip.asm):00060                         LDB     <FL_K
1D39 58               (         flip.asm):00061                         ASLB
1D3A 3A               (         flip.asm):00062                         ABX
1D3B EC84             (         flip.asm):00063                         LDD     ,X
1D3D DD0F             (         flip.asm):00064                         STD     <FL_S
1D3F 17001B           (         flip.asm):00065                         LBSR    FL_MAP          ; which source column for each column
1D42 170074           (         flip.asm):00066                         LBSR    FL_DRAW         ; draw the frame on the screen
1D45 961A             (         flip.asm):00067                         LDA     <FL_TICKS       ; and pace it
1D47 17FC28           (         flip.asm):00068                         LBSR    T_PACE
1D4A 0C1B             (         flip.asm):00069                         INC     <FL_K
1D4C 961B             (         flip.asm):00070                         LDA     <FL_K
1D4E 8110             (         flip.asm):00071                         CMPA    #16
1D50 25E1             (         flip.asm):00072                         BLO     FL_FRAME
1D52 17013F           (         flip.asm):00073                         LBSR    FL_MIRROR       ; the buffer becomes the mirror image
1D55 32E84E           (         flip.asm):00074                         LEAS    78,S
1D58 17F676           (         flip.asm):00075                         LBSR    T_BLIT          ; and the screen shows it
1D5B 35F6             (         flip.asm):00076                         PULS    D,X,Y,U,PC
                      (         flip.asm):00077         
                      (         flip.asm):00078         ; ---------------------------------------------------------------------------
                      (         flip.asm):00079         ; FL_MAP - fill the column map: for each screen pixel column X (0-XMAX),
                      (         flip.asm):00080         ;   the source pixel column it shows, or $FF for none (beyond the picture).
                      (         flip.asm):00081         ;   Works out from the centre c (= CELLS - 0.5): at distance j + 0.5 the
                      (         flip.asm):00082         ;   source is at c +/- o with o = (j + 0.5) * s, so o starts at s/2 and
                      (         flip.asm):00083         ;   grows by s each column. Rounded to the nearest column:
                      (         flip.asm):00084         ;   source = (CELLS*256 +/- o) / 256 in 8.8 fixed point. Stops once o is
                      (         flip.asm):00085         ;   beyond the picture's edge.
                      (         flip.asm):00086         ; ---------------------------------------------------------------------------
1D5D 9E28             (         flip.asm):00087         FL_MAP          LDX     <FL_SRC         ; start with every column blank
1D5F 86FF             (         flip.asm):00088                         LDA     #$FF
1D61 C64C             (         flip.asm):00089                         LDB     #2*CELLS
1D63 A780             (         flip.asm):00090         FM_CLR          STA     ,X+
1D65 5A               (         flip.asm):00091                         DECB
1D66 26FB             (         flip.asm):00092                         BNE     FM_CLR
1D68 DC0F             (         flip.asm):00093                         LDD     <FL_S           ; o = s / 2
1D6A 47               (         flip.asm):00094                         ASRA
1D6B 56               (         flip.asm):00095                         RORB
1D6C DD11             (         flip.asm):00096                         STD     <FL_O
1D6E 0F13             (         flip.asm):00097                         CLR     <FL_J
1D70 DC11             (         flip.asm):00098         FM_LOOP         LDD     <FL_O           ; |o| beyond the picture? stop
1D72 2A05             (         flip.asm):00099                         BPL     FM_1
1D74 43               (         flip.asm):00100                         COMA
1D75 53               (         flip.asm):00101                         COMB
1D76 C30001           (         flip.asm):00102                         ADDD    #1
1D79 10832700         (         flip.asm):00103         FM_1            CMPD    #(CELLS+1)*256
1D7D 2239             (         flip.asm):00104                         BHI     FM_X
1D7F CC2600           (         flip.asm):00105                         LDD     #CELLS*256      ; right side: X = CELLS + j shows
1D82 D311             (         flip.asm):00106                         ADDD    <FL_O           ;  CELLS*256 + o
1D84 2B0E             (         flip.asm):00107                         BMI     FM_2            ;  (off the left of the picture)
1D86 10834C00         (         flip.asm):00108                         CMPD    #2*CELLS*256
1D8A 2C08             (         flip.asm):00109                         BGE     FM_2            ;  (off the right)
1D8C 9E28             (         flip.asm):00110                         LDX     <FL_SRC         ; A = source column
1D8E D613             (         flip.asm):00111                         LDB     <FL_J
1D90 3A               (         flip.asm):00112                         ABX
1D91 A78826           (         flip.asm):00113                         STA     CELLS,X
1D94 CC2600           (         flip.asm):00114         FM_2            LDD     #CELLS*256      ; left side: X = CELLS - 1 - j shows
1D97 9311             (         flip.asm):00115                         SUBD    <FL_O           ;  CELLS*256 - o
1D99 2B0F             (         flip.asm):00116                         BMI     FM_3
