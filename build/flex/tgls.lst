                      (       circle.asm):00146         ; ---------------------------------------------------------------------------
                      (       circle.asm):00147         ; DRUN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00148         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00149         ;   A single pixel (most of an outline) goes to the clipped plot, which is
                      (       circle.asm):00150         ;   cheaper; anything longer, or anything patterned, goes to HSPAN.
                      (       circle.asm):00151         ; ---------------------------------------------------------------------------
1785 3404             (       circle.asm):00152         DRUN            PSHS    B
1787 A1E0             (       circle.asm):00153                         CMPA    ,S+
1789 260F             (       circle.asm):00154                         BNE     HSPAN
178B 3404             (       circle.asm):00155                         PSHS    B               ; patterned: HSPAN applies the pattern
178D D65C             (       circle.asm):00156                         LDB     <H_PAT          ;  (keep B, the run's right end;
178F C10F             (       circle.asm):00157                         CMPB    #$0F            ;  PULS leaves the flags alone)
1791 3504             (       circle.asm):00158                         PULS    B
1793 2605             (       circle.asm):00159                         BNE     HSPAN
1795 D636             (       circle.asm):00160                         LDB     <C_Y            ; one solid pixel: A,B = x,y
1797 16FC69           (       circle.asm):00161                         LBRA    T_PLOTC
                      (       circle.asm):00162         
                      (       circle.asm):00163         ; ---------------------------------------------------------------------------
                      (       circle.asm):00164         ; HSPAN - draw a horizontal run of pixels on row C_Y
                      (       circle.asm):00165         ;   Entry: A = left x, B = right x (signed, A <= B)
                      (       circle.asm):00166         ;   Exit:  A, B, X, U corrupted
                      (       circle.asm):00167         ;
                      (       circle.asm):00168         ;   A lean, single-row version of the rectangle fill, which also applies
                      (       circle.asm):00169         ;   the fill pattern in H_PAT (15 = solid). Used by the circles and the
                      (       circle.asm):00170         ;   polygon fill; the caller sets H_PAT. The row's left and
                      (       circle.asm):00171         ;   right pixel masks come straight from PTAB, so there is no sorting, no
                      (       circle.asm):00172         ;   multiply and no mask lookup: clip, find the cells, then
                      (       circle.asm):00173         ;     - if the run starts on a right-hand pixel, that cell gets only its
                      (       circle.asm):00174         ;       right pixel
                      (       circle.asm):00175         ;     - whole cells in between get both pixels, via the shared FILLSEG loop
                      (       circle.asm):00176         ;     - if the run ends on a left-hand pixel, that cell gets only its left
                      (       circle.asm):00177         ;   (or, when the run lies within one cell, whichever of its pixels count).
                      (       circle.asm):00178         ; ---------------------------------------------------------------------------
179A 3406             (       circle.asm):00179         HSPAN           PSHS    A,B             ; 0,S = left x, 1,S = right x
179C D636             (       circle.asm):00180                         LDB     <C_Y            ; row off screen? (unsigned compare
179E C147             (       circle.asm):00181                         CMPB    #YMAX           ;  catches negative rows too)
17A0 102200C0         (       circle.asm):00182                         LBHI    HS_X
17A4 A661             (       circle.asm):00183                         LDA     1,S             ; run entirely left of the screen?
17A6 102B00BA         (       circle.asm):00184                         LBMI    HS_X
17AA A6E4             (       circle.asm):00185                         LDA     ,S              ; entirely right of it?
17AC 814B             (       circle.asm):00186                         CMPA    #XMAX
17AE 102E00B2         (       circle.asm):00187                         LBGT    HS_X
17B2 4D               (       circle.asm):00188                         TSTA                    ; clip the left end
17B3 2A02             (       circle.asm):00189                         BPL     HS_1
17B5 6FE4             (       circle.asm):00190                         CLR     ,S
17B7 A661             (       circle.asm):00191         HS_1            LDA     1,S             ; clip the right end
17B9 814B             (       circle.asm):00192                         CMPA    #XMAX
17BB 2F04             (       circle.asm):00193                         BLE     HS_2
17BD 864B             (       circle.asm):00194                         LDA     #XMAX
17BF A761             (       circle.asm):00195                         STA     1,S
                      (       circle.asm):00196         
17C1 17FEE4           (       circle.asm):00197         HS_2            LBSR    PT_ENTRY        ; U -> PTAB entry for this row (B = y)
17C4 ECC4             (       circle.asm):00198                         LDD     ,U              ; X -> first cell of the cell row
17C6 D300             (       circle.asm):00199                         ADDD    <W_BUF
17C8 1F01             (       circle.asm):00200                         TFR     D,X
17CA A642             (       circle.asm):00201                         LDA     2,U             ; this sixel row's masks
17CC 9725             (       circle.asm):00202                         STA     <F_ML
17CE A643             (       circle.asm):00203                         LDA     3,U
17D0 9726             (       circle.asm):00204                         STA     <F_MR
                      (       circle.asm):00205         
17D2 D65C             (       circle.asm):00206                         LDB     <H_PAT          ; apply the fill pattern: odd rows use
17D4 9636             (       circle.asm):00207                         LDA     <C_Y            ;  bits 2-3, even rows bits 0-1;
17D6 8501             (       circle.asm):00208                         BITA    #1              ;  the low bit is for left (even x)
