                      (         dash.asm):00354         ; ---------------------------------------------------------------------------
                      (         dash.asm):00355         ; T_RECTD - dashed rectangle outline ("marching ants")
                      (         dash.asm):00356         ;   Entry: A = x0, B = y0, X = x1:y1 (signed, any opposite corners),
                      (         dash.asm):00357         ;          DP = $00
                      (         dash.asm):00358         ;   Exit:  all registers preserved
                      (         dash.asm):00359         ;   Drawn clockwise from the top-left corner, with the pattern carrying on
                      (         dash.asm):00360         ;   round the corners, and every pixel drawn once (as TGL_RECT):
                      (         dash.asm):00361         ;     top     (x0,y0)   -> (x1,y0)
                      (         dash.asm):00362         ;     right   (x1,y0+1) -> (x1,y1)       if y1 > y0
                      (         dash.asm):00363         ;     bottom  (x1-1,y1) -> (x0,y1)       if y1 > y0 and x1 > x0
                      (         dash.asm):00364         ;     left    (x0,y1-1) -> (x0,y0+1)     if x1 > x0 and y1 - y0 >= 2
                      (         dash.asm):00365         ; ---------------------------------------------------------------------------
2339 3476             (         dash.asm):00366         T_RECTD         PSHS    D,X,Y,U
233B 17F34D           (         dash.asm):00367                         LBSR    R_SORT          ; R_X0 <= R_X1, R_Y0 <= R_Y1
233E 17FE17           (         dash.asm):00368                         LBSR    DSETUP
