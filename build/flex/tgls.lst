22D1 9111             (         dash.asm):00296                         CMPA    <D_X1
22D3 2715             (         dash.asm):00297                         BEQ     DHZ_X
22D5 9B13             (         dash.asm):00298                         ADDA    <D_SX
22D7 970F             (         dash.asm):00299                         STA     <D_X
22D9 20DD             (         dash.asm):00300                         BRA     DHZ_LOOP
