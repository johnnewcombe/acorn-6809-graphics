2297 D31C             (         dash.asm):00264                         ADDD    <D_DX
2299 DD20             (         dash.asm):00265                         STD     <D_ERR
229B 9610             (         dash.asm):00266                         LDA     <D_Y
229D 9B14             (         dash.asm):00267                         ADDA    <D_SY
229F 9710             (         dash.asm):00268                         STA     <D_Y
22A1 3344             (         dash.asm):00269                         LEAU    4,U             ; U follows y down ...
22A3 0D14             (         dash.asm):00270                         TST     <D_SY
22A5 2AA0             (         dash.asm):00271                         BPL     DL_LOOP
22A7 3358             (         dash.asm):00272                         LEAU    -8,U            ; ... or up
22A9 209C             (         dash.asm):00273                         BRA     DL_LOOP
22AB 39               (         dash.asm):00274         DL_X            RTS
                      (         dash.asm):00275         
                      (         dash.asm):00276         ; DHZ - horizontal: y is fixed, so the row's address (Y) is worked out once
                      (         dash.asm):00277         ;   and each pixel just steps x. If the row is off screen, every pixel is.
22AC D610             (         dash.asm):00278         DHZ             LDB     <D_Y
22AE C147             (         dash.asm):00279                         CMPB    #YMAX
22B0 2229             (         dash.asm):00280                         BHI     DHZ_OFF
22B2 ECC4             (         dash.asm):00281                         LDD     ,U              ; Y -> column 1 of the row
22B4 D300             (         dash.asm):00282                         ADDD    <W_BUF
22B6 1F02             (         dash.asm):00283                         TFR     D,Y
22B8 960F             (         dash.asm):00284         DHZ_LOOP         LDA     <D_X            ; on screen?
22BA 814B             (         dash.asm):00285                         CMPA    #XMAX
22BC 220E             (         dash.asm):00286                         BHI     DHZ_SKIP
22BE 44               (         dash.asm):00287                         LSRA                    ; X -> the cell, carry = right pixel
22BF 30A6             (         dash.asm):00288                         LEAX    A,Y             ;  (LEA leaves the carry)
22C1 A642             (         dash.asm):00289                         LDA     2,U             ; its mask
22C3 2402             (         dash.asm):00290                         BCC     DHZ_ON
22C5 A643             (         dash.asm):00291                         LDA     3,U
22C7 17FEE3           (         dash.asm):00292         DHZ_ON           LBSR    DOP
22CA 2003             (         dash.asm):00293                         BRA     DHZ_STEP
22CC 17FEF0           (         dash.asm):00294         DHZ_SKIP         LBSR    ADV1
