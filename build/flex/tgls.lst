14FA 2504             (         clip.asm):00185                         BCS     DV_SUB
14FC 9116             (         clip.asm):00186                         CMPA    <I_DV
14FE 2503             (         clip.asm):00187                         BLO     DV_NEXT
1500 9016             (         clip.asm):00188         DV_SUB          SUBA    <I_DV
1502 5C               (         clip.asm):00189                         INCB
1503 0A17             (         clip.asm):00190         DV_NEXT         DEC     <I_CNT
