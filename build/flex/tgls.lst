                      (         clip.asm):00123         ; ---------------------------------------------------------------------------
                      (         clip.asm):00124         ; ISECT - A = u0 + (u1-u0) * (e-v0) / (v1-v0)
                      (         clip.asm):00125         ;   Rounded to the nearest pixel, which keeps trimmed lines closer to the
                      (         clip.asm):00126         ;   path the unclipped line would take (never more than one pixel off).
                      (         clip.asm):00127         ;   Worked in sign and magnitude: each difference is at most 255, and
                      (         clip.asm):00128         ;   |e-v0| <= |v1-v0| because the edge lies between the endpoints, so the
                      (         clip.asm):00129         ;   product fits 16 bits and the quotient fits 8. The result lies between
                      (         clip.asm):00130         ;   u0 and u1, so plain 8-bit addition gives the right signed value.
                      (         clip.asm):00131         ;   B corrupted.
                      (         clip.asm):00132         ; ---------------------------------------------------------------------------
14A5 0F14             (         clip.asm):00133         ISECT           CLR     <I_SGN
14A7 9610             (         clip.asm):00134                         LDA     <I_U1           ; |u1-u0|
14A9 900F             (         clip.asm):00135                         SUBA    <I_U0
14AB D610             (         clip.asm):00136                         LDB     <I_U1
14AD D10F             (         clip.asm):00137                         CMPB    <I_U0
14AF 2C03             (         clip.asm):00138                         BGE     IS_1
14B1 40               (         clip.asm):00139                         NEGA
14B2 0314             (         clip.asm):00140                         COM     <I_SGN
14B4 9715             (         clip.asm):00141         IS_1            STA     <I_DU
14B6 9613             (         clip.asm):00142                         LDA     <I_E            ; |e-v0|
14B8 9011             (         clip.asm):00143                         SUBA    <I_V0
14BA D613             (         clip.asm):00144                         LDB     <I_E
14BC D111             (         clip.asm):00145                         CMPB    <I_V0
14BE 2C03             (         clip.asm):00146                         BGE     IS_2
14C0 40               (         clip.asm):00147                         NEGA
14C1 0314             (         clip.asm):00148                         COM     <I_SGN
14C3 D615             (         clip.asm):00149         IS_2            LDB     <I_DU
14C5 3D               (         clip.asm):00150                         MUL                     ; D = |u1-u0| * |e-v0|
14C6 3406             (         clip.asm):00151                         PSHS    D
14C8 9612             (         clip.asm):00152                         LDA     <I_V1           ; |v1-v0|
14CA 9011             (         clip.asm):00153                         SUBA    <I_V0
14CC D612             (         clip.asm):00154                         LDB     <I_V1
14CE D111             (         clip.asm):00155                         CMPB    <I_V0
14D0 2C03             (         clip.asm):00156                         BGE     IS_3
14D2 40               (         clip.asm):00157                         NEGA
14D3 0314             (         clip.asm):00158                         COM     <I_SGN
14D5 9716             (         clip.asm):00159         IS_3            STA     <I_DV
14D7 44               (         clip.asm):00160                         LSRA                    ; round: add |v1-v0|/2 before dividing
14D8 9717             (         clip.asm):00161                         STA     <I_CNT          ;  (I_CNT as a temporary; DIV8 resets it)
14DA 3506             (         clip.asm):00162                         PULS    D
14DC DB17             (         clip.asm):00163                         ADDB    <I_CNT
14DE 8900             (         clip.asm):00164                         ADCA    #0
14E0 8D0E             (         clip.asm):00165                         BSR     DIV8            ; B = rounded quotient
14E2 960F             (         clip.asm):00166                         LDA     <I_U0
14E4 3404             (         clip.asm):00167                         PSHS    B
14E6 0D14             (         clip.asm):00168                         TST     <I_SGN
14E8 2603             (         clip.asm):00169                         BNE     IS_4
14EA ABE0             (         clip.asm):00170                         ADDA    ,S+
14EC 39               (         clip.asm):00171                         RTS
14ED A0E0             (         clip.asm):00172         IS_4            SUBA    ,S+
14EF 39               (         clip.asm):00173                         RTS
