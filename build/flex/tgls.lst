                      (         flip.asm):00133         ; ---------------------------------------------------------------------------
                      (         flip.asm):00134         ; FL_DRAW - draw one frame onto the screen from the buffer and column map
                      (         flip.asm):00135         ;   For each screen cell column: its left pixel shows source pixel PL and
                      (         flip.asm):00136         ;   its right pixel source pixel PR. Source pixel p is the left (p even) or
                      (         flip.asm):00137         ;   right (p odd) pixel of source cell p/2, so the left half of each screen
                      (         flip.asm):00138         ;   cell is LLT[byte] or RLT[byte] of that source cell (U points at the
                      (         flip.asm):00139         ;   table) and the right half LRT[byte] or RRT[byte] (Y). A blank half uses
                      (         flip.asm):00140         ;   a table of constants instead (all $20 on the left, all 0 on the right).
                      (         flip.asm):00141         ;   The cell offsets and screen offsets are patched into a row loop that
                      (         flip.asm):00142         ;   does three rows per pass; columns with both halves blank just get
                      (         flip.asm):00143         ;   spaces.
                      (         flip.asm):00144         ; ---------------------------------------------------------------------------
1DB9 0F14             (         flip.asm):00145         FL_DRAW         CLR     <FL_COL
1DBB 9E28             (         flip.asm):00146         FD_COL          LDX     <FL_SRC         ; PL, PR for this cell column
1DBD D614             (         flip.asm):00147                         LDB     <FL_COL
1DBF 58               (         flip.asm):00148                         ASLB
1DC0 3A               (         flip.asm):00149                         ABX
1DC1 EC84             (         flip.asm):00150                         LDD     ,X
1DC3 DD1D             (         flip.asm):00151                         STD     <FL_PL
1DC5 CCE400           (         flip.asm):00152                         LDD     #VDU_BASE       ; screen offset from the buffer row:
1DC8 9300             (         flip.asm):00153                         SUBD    <W_BUF          ;  VDU_BASE + column - W_BUF (it can
1DCA DB14             (         flip.asm):00154                         ADDB    <FL_COL         ;  wrap round 64K, which is fine)
1DCC 8900             (         flip.asm):00155                         ADCA    #0
1DCE 9E00             (         flip.asm):00156                         LDX     <W_BUF          ; X -> first pixel column of buffer
1DD0 3002             (         flip.asm):00157                         LEAX    COL1,X          ;  row 0
1DD2 DE1D             (         flip.asm):00158                         LDU     <FL_PL          ; both halves blank: spaces
1DD4 1183FFFF         (         flip.asm):00159                         CMPU    #$FFFF
1DD8 102700A2         (         flip.asm):00160                         LBEQ    FD_BLANK
1DDC ED8D006E         (         flip.asm):00161                         STD     FG_D0+2,PCR     ; screen offsets for the 3 rows
1DE0 C30028           (         flip.asm):00162                         ADDD    #COLS
1DE3 ED8D0075         (         flip.asm):00163                         STD     FG_D1+2,PCR
1DE7 C30028           (         flip.asm):00164                         ADDD    #COLS
1DEA ED8D007C         (         flip.asm):00165                         STD     FG_D2+2,PCR
                      (         flip.asm):00166         
1DEE 961D             (         flip.asm):00167                         LDA     <FL_PL          ; left half
1DF0 81FF             (         flip.asm):00168                         CMPA    #$FF
1DF2 2607             (         flip.asm):00169                         BNE     FD_L1
1DF4 338D00DB         (         flip.asm):00170                         LEAU    FL_K20-$20,PCR  ; blank: a constant $20
1DF8 4F               (         flip.asm):00171                         CLRA                    ;  (any cell will do)
1DF9 200B             (         flip.asm):00172                         BRA     FD_L2
1DFB 44               (         flip.asm):00173         FD_L1           LSRA                    ; A = source cell, carry = right pixel
1DFC 338D0193         (         flip.asm):00174                         LEAU    FL_LLT-$20,PCR  ; source left pixel -> left (LEA
1E00 2404             (         flip.asm):00175                         BCC     FD_L2           ;  leaves the carry)
1E02 338D01ED         (         flip.asm):00176                         LEAU    FL_RLT-$20,PCR  ; source right pixel -> left
1E06 A78D003A         (         flip.asm):00177         FD_L2           STA     FG_L0+2,PCR     ; patch the source offsets for the
1E0A 8B28             (         flip.asm):00178                         ADDA    #COLS           ;  3 rows
1E0C A78D0042         (         flip.asm):00179                         STA     FG_L1+2,PCR
1E10 8B28             (         flip.asm):00180                         ADDA    #COLS
1E12 A78D004A         (         flip.asm):00181                         STA     FG_L2+2,PCR
                      (         flip.asm):00182         
1E16 961E             (         flip.asm):00183                         LDA     <FL_PR          ; right half
1E18 81FF             (         flip.asm):00184                         CMPA    #$FF
1E1A 2607             (         flip.asm):00185                         BNE     FD_R1
1E1C 318D0113         (         flip.asm):00186                         LEAY    FL_K00-$20,PCR  ; blank: a constant 0
1E20 4F               (         flip.asm):00187                         CLRA
1E21 200B             (         flip.asm):00188                         BRA     FD_R2
1E23 44               (         flip.asm):00189         FD_R1           LSRA
1E24 318D022B         (         flip.asm):00190                         LEAY    FL_LRT-$20,PCR  ; source left pixel -> right
1E28 2404             (         flip.asm):00191                         BCC     FD_R2
1E2A 318D0285         (         flip.asm):00192                         LEAY    FL_RRT-$20,PCR  ; source right pixel -> right
1E2E A78D0017         (         flip.asm):00193         FD_R2           STA     FG_R0+2,PCR
