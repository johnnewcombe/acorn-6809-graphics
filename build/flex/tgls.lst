1825 270E             (       circle.asm):00253                         BEQ     HS_5
1827 3410             (       circle.asm):00254                         PSHS    X
1829 D61C             (       circle.asm):00255                         LDB     <F_CX0
182B 3A               (       circle.asm):00256                         ABX
182C 9626             (       circle.asm):00257                         LDA     <F_MR
182E C601             (       circle.asm):00258                         LDB     #1
1830 17FE4B           (       circle.asm):00259                         LBSR    FILLSEG
