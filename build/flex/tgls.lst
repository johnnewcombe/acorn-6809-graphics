2300 ECC4             (         dash.asm):00325                         LDD     ,U              ; X -> the cell
2302 D300             (         dash.asm):00326                         ADDD    <W_BUF
2304 1F01             (         dash.asm):00327                         TFR     D,X
2306 D611             (         dash.asm):00328                         LDB     <D_X1
2308 3A               (         dash.asm):00329                         ABX
2309 D622             (         dash.asm):00330                         LDB     <D_E2           ; its mask
230B A6C5             (         dash.asm):00331                         LDA     B,U
230D 17FE9D           (         dash.asm):00332                         LBSR    DOP
2310 2003             (         dash.asm):00333                         BRA     DVT_STEP
