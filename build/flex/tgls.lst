                      (       tables.asm):00002         ; Lookup tables - always referenced with ,PCR
                      (       tables.asm):00003         ;
                      (       tables.asm):00004         ; PTAB: one 4-byte entry per pixel row y (0-71):
                      (       tables.asm):00005         ;   +0,+1  offset of the first pixel column (COL1: 1, or 2 in a separated
                      (       tables.asm):00006         ;          build) of the cell row within the buffer: (y/3)*40+COL1
                      (       tables.asm):00007         ;   +2     sixel mask for an even x (left pixel)
                      (       tables.asm):00008         ;   +3     sixel mask for an odd x (right pixel)
                      (       tables.asm):00009         ; Sixel bits: top row 0/1, middle row 2/3, bottom row 4/6 (bit 5 always set)
                      (       tables.asm):00010         ; ---------------------------------------------------------------------------
