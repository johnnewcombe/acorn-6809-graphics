1858 270A             (       circle.asm):00279                         BEQ     HS_X
185A D61D             (       circle.asm):00280                         LDB     <F_CX1
185C 3A               (       circle.asm):00281                         ABX
185D 9625             (       circle.asm):00282                         LDA     <F_ML
185F C601             (       circle.asm):00283                         LDB     #1
1861 17FE1A           (       circle.asm):00284                         LBSR    FILLSEG
