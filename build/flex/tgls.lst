17FC 44               (       circle.asm):00229                         LSRA                    ;  on its left pixel (x even)?
17FD 971D             (       circle.asm):00230                         STA     <F_CX1
17FF 8600             (       circle.asm):00231                         LDA     #0
1801 49               (       circle.asm):00232                         ROLA
1802 8801             (       circle.asm):00233                         EORA    #1
1804 971F             (       circle.asm):00234                         STA     <F_PR
                      (       circle.asm):00235         
1806 961C             (       circle.asm):00236                         LDA     <F_CX0          ; all within one cell?
1808 911D             (       circle.asm):00237                         CMPA    <F_CX1
