1E40 9715             (         flip.asm):00200                         STA     <FL_CNT
1E42                  (         flip.asm):00201         FG_LOOP
1E42 E68800           (         flip.asm):00202         FG_L0           LDB     <0,X            ; row 0: left half from its table ...
1E45 A6C5             (         flip.asm):00203                         LDA     B,U
