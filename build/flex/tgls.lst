                      (       circle.asm):00319         ; ---------------------------------------------------------------------------
1890 C60D             (       circle.asm):00320         SCALEX          LDB     #13
1892 3D               (       circle.asm):00321                         MUL                     ; D = x * 13
1893 C30008           (       circle.asm):00322                         ADDD    #8              ; round
1896 44               (       circle.asm):00323                         LSRA                    ; divide by 16
1897 56               (       circle.asm):00324                         RORB
1898 44               (       circle.asm):00325                         LSRA
1899 56               (       circle.asm):00326                         RORB
189A 44               (       circle.asm):00327                         LSRA
189B 56               (       circle.asm):00328                         RORB
189C 44               (       circle.asm):00329                         LSRA
189D 56               (       circle.asm):00330                         RORB
189E 1F98             (       circle.asm):00331                         TFR     B,A
18A0 39               (       circle.asm):00332                         RTS
                      (       circle.asm):00333         
                      (       circle.asm):00334         ; ---------------------------------------------------------------------------
                      (       circle.asm):00335         ; CI_SETUP - store the centre and radius (radius clamped to 0-127)
                      (       circle.asm):00336         ; ---------------------------------------------------------------------------
18A1 972C             (       circle.asm):00337         CI_SETUP        STA     <C_CX
18A3 D72D             (       circle.asm):00338                         STB     <C_CY
18A5 1F10             (       circle.asm):00339                         TFR     X,D             ; radius is X; anything over 127
18A7 4D               (       circle.asm):00340                         TSTA                    ;  becomes 127
18A8 2603             (       circle.asm):00341                         BNE     CS_BIG
18AA 5D               (       circle.asm):00342                         TSTB
18AB 2A02             (       circle.asm):00343                         BPL     CS_OK
18AD C67F             (       circle.asm):00344         CS_BIG          LDB     #127
18AF D72E             (       circle.asm):00345         CS_OK           STB     <C_R
18B1 39               (       circle.asm):00346                         RTS
                      (      src/tgl.asm):00102                         INCLUDE "text.asm"
                      (         text.asm):00001         ; ---------------------------------------------------------------------------
                      (         text.asm):00002         ; Status row text
                      (         text.asm):00003         ;   The status row is screen row 24, below the 24 rows of graphics. The
                      (         text.asm):00004         ;   blit never touches it, so text written there stays put while the
                      (         text.asm):00005         ;   graphics above it change. Text is written straight to the screen (not
                      (         text.asm):00006         ;   the off-screen buffer), so it appears immediately.
                      (         text.asm):00007         ;
                      (         text.asm):00008         ;   Strings are zero-terminated and may contain teletext control codes to
                      (         text.asm):00009         ;   colour the text that follows them on the row, e.g. $81 red, $82 green,
                      (         text.asm):00010         ;   $83 yellow, $84 blue, $85 magenta, $86 cyan, $87 white ($01-$07 work
                      (         text.asm):00011         ;   too: the SAA5050 ignores the top bit). Each control code takes up one
                      (         text.asm):00012         ;   character position and shows as a space. Text starts white at the
                      (         text.asm):00013         ;   left of the row.
                      (         text.asm):00014         ; ---------------------------------------------------------------------------
                      (         text.asm):00015         
     E7C0             (         text.asm):00016         STATUS          EQU     VDU_BASE+STATUS_ROW*COLS        ; first byte of row 24
                      (         text.asm):00017         
                      (         text.asm):00018         ; ---------------------------------------------------------------------------
                      (         text.asm):00019         ; T_TEXT - write a string to the status row
                      (         text.asm):00020         ;   Entry: A = column (0-39), X -> zero-terminated string, DP = $00
                      (         text.asm):00021         ;   Exit:  all registers preserved
                      (         text.asm):00022         ;   Stops at the right-hand edge rather than wrapping. A column beyond 39
                      (         text.asm):00023         ;   writes nothing.
                      (         text.asm):00024         ; ---------------------------------------------------------------------------
18B2 3456             (         text.asm):00025         T_TEXT          PSHS    D,X,U
18B4 8127             (         text.asm):00026                         CMPA    #COLS-1         ; column off the end of the row?
18B6 2212             (         text.asm):00027                         BHI     TX_X
18B8 CEE7C0           (         text.asm):00028                         LDU     #STATUS         ; U -> screen position
18BB 33C6             (         text.asm):00029                         LEAU    A,U             ;  (A is 0-39, so the add is safe)
18BD 1F89             (         text.asm):00030                         TFR     A,B             ; B = column, to stop at the edge
18BF A680             (         text.asm):00031         TX_LOOP         LDA     ,X+             ; next character
18C1 2707             (         text.asm):00032                         BEQ     TX_X            ; zero: end of string
18C3 A7C0             (         text.asm):00033                         STA     ,U+
18C5 5C               (         text.asm):00034                         INCB
18C6 C128             (         text.asm):00035                         CMPB    #COLS           ; reached the right-hand edge?
18C8 25F5             (         text.asm):00036                         BLO     TX_LOOP
18CA 35D6             (         text.asm):00037         TX_X            PULS    D,X,U,PC
                      (         text.asm):00038         
                      (         text.asm):00039         ; ---------------------------------------------------------------------------
                      (         text.asm):00040         ; T_TCLR - clear the status row to spaces
                      (         text.asm):00041         ;   Entry: DP = $00    Exit: all registers preserved
                      (         text.asm):00042         ; ---------------------------------------------------------------------------
18CC 3416             (         text.asm):00043         T_TCLR          PSHS    D,X
18CE 8EE7C0           (         text.asm):00044                         LDX     #STATUS
18D1 CC2020           (         text.asm):00045                         LDD     #$2020          ; two spaces at a time
18D4 ED81             (         text.asm):00046         TC_LOOP         STD     ,X++
18D6 8CE7E8           (         text.asm):00047                         CMPX    #STATUS+COLS
18D9 25F9             (         text.asm):00048                         BLO     TC_LOOP
18DB 3596             (         text.asm):00049                         PULS    D,X,PC
                      (         text.asm):00050         
                      (         text.asm):00051         ; ---------------------------------------------------------------------------
                      (         text.asm):00052         ; T_TNUM - write a number to the status row
                      (         text.asm):00053         ;   Entry: A = column (0-39), X = value (0-65535, unsigned), DP = $00
                      (         text.asm):00054         ;   Exit:  all registers preserved
                      (         text.asm):00055         ;   Always five characters, right-aligned with leading spaces, so a value
                      (         text.asm):00056         ;   that shrinks (e.g. from 100 to 99) leaves no stray digits behind.
                      (         text.asm):00057         ;
                      (         text.asm):00058         ;   Each digit is found by counting how many times the matching power of
                      (         text.asm):00059         ;   ten can be subtracted (10000, 1000, 100, 10); what is left is the last
                      (         text.asm):00060         ;   digit. Leading zeros become spaces; the last digit is always shown.
                      (         text.asm):00061         ; ---------------------------------------------------------------------------
18DD 3476             (         text.asm):00062         T_TNUM          PSHS    D,X,Y,U
18DF 1F10             (         text.asm):00063                         TFR     X,D             ; D = value
18E1 338D0045         (         text.asm):00064                         LEAU    POW10,PCR       ; U -> 10000, 1000, 100, 10
18E5 108E0038         (         text.asm):00065                         LDY     #T_BUF          ; Y -> where the characters go
18E9 0F3F             (         text.asm):00066                         CLR     <T_LEAD         ; no non-zero digit yet
18EB 0F3E             (         text.asm):00067         TN_DIGIT        CLR     <T_DIG
18ED 10A3C4           (         text.asm):00068         TN_SUB          CMPD    ,U              ; can this power be subtracted?
18F0 2506             (         text.asm):00069                         BLO     TN_PUT          ;  (unsigned compare)
18F2 A3C4             (         text.asm):00070                         SUBD    ,U
18F4 0C3E             (         text.asm):00071                         INC     <T_DIG
18F6 20F5             (         text.asm):00072                         BRA     TN_SUB
18F8 3406             (         text.asm):00073         TN_PUT          PSHS    D               ; keep the remainder
18FA 963E             (         text.asm):00074                         LDA     <T_DIG
18FC 2608             (         text.asm):00075                         BNE     TN_NZ           ; a zero before any other digit
18FE 0D3F             (         text.asm):00076                         TST     <T_LEAD         ;  is a leading zero: a space
1900 2606             (         text.asm):00077                         BNE     TN_CH
1902 8620             (         text.asm):00078                         LDA     #' '
1904 2004             (         text.asm):00079                         BRA     TN_ST
1906 0C3F             (         text.asm):00080         TN_NZ           INC     <T_LEAD
1908 8B30             (         text.asm):00081         TN_CH           ADDA    #'0'
190A A7A0             (         text.asm):00082         TN_ST           STA     ,Y+
190C 3506             (         text.asm):00083                         PULS    D
190E 3342             (         text.asm):00084                         LEAU    2,U             ; next power of ten
1910 308D001E         (         text.asm):00085                         LEAX    POW10E,PCR
1914 3410             (         text.asm):00086                         PSHS    X
1916 11A3E1           (         text.asm):00087                         CMPU    ,S++            ; done all four powers?
1919 25D0             (         text.asm):00088                         BLO     TN_DIGIT
191B CB30             (         text.asm):00089                         ADDB    #'0'            ; the last digit, always shown
191D E7A0             (         text.asm):00090                         STB     ,Y+
191F 6FA4             (         text.asm):00091                         CLR     ,Y              ; end of string
1921 A6E4             (         text.asm):00092                         LDA     ,S              ; column (caller's A, on the stack)
1923 8E0038           (         text.asm):00093                         LDX     #T_BUF
1926 8D8A             (         text.asm):00094                         BSR     T_TEXT
1928 35F6             (         text.asm):00095                         PULS    D,X,Y,U,PC
                      (         text.asm):00096         
192A 271003E80064000A (         text.asm):00097         POW10           FDB     10000,1000,100,10
1932                  (         text.asm):00098         POW10E
                      (      src/tgl.asm):00103                         INCLUDE "colour.asm"
                      (       colour.asm):00001         ; ---------------------------------------------------------------------------
                      (       colour.asm):00002         ; T_COLOUR - set the graphics colour of a band of rows
                      (       colour.asm):00003         ;   Entry: A = first row, B = last row (0-23, cell rows: row r covers
                      (       colour.asm):00004         ;          pixel rows y = 3r to 3r+2), X = colour (1 red, 2 green,
                      (       colour.asm):00005         ;          3 yellow, 4 blue, 5 magenta, 6 cyan, 7 white; only the low
                      (       colour.asm):00006         ;          3 bits are used, and 0 counts as white), DP = $00
                      (       colour.asm):00007         ;   Exit:  all registers preserved
                      (       colour.asm):00008         ;
                      (       colour.asm):00009         ;   Teletext colours a row by the control code at its start: $91-$97 mean
                      (       colour.asm):00010         ;   "graphics in red ... white from here on". The library keeps column 0
                      (       colour.asm):00011         ;   of every buffer row for that code, so changing a row's colour costs no
                      (       colour.asm):00012         ;   pixels and no drawing time. The new code is written into the buffer
                      (       colour.asm):00013         ;   straight away (it shows at the next blit) and remembered in ROWCOL, so
                      (       colour.asm):00014         ;   TGL_CLS keeps it.
                      (       colour.asm):00015         ;   A first row beyond 23 does nothing; a last row beyond 23 counts as 23;
                      (       colour.asm):00016         ;   if first > last nothing changes.
                      (       colour.asm):00017         ; ---------------------------------------------------------------------------
1932 3456             (       colour.asm):00018         T_COLOUR        PSHS    D,X,U
1934 8117             (       colour.asm):00019                         CMPA    #ROWS-1         ; first row off the bottom?
1936 2238             (       colour.asm):00020                         BHI     CO_X
1938 C117             (       colour.asm):00021                         CMPB    #ROWS-1         ; clamp the last row
193A 2302             (       colour.asm):00022                         BLS     CO_1
193C C617             (       colour.asm):00023                         LDB     #ROWS-1
193E 9740             (       colour.asm):00024         CO_1            STA     <K_FIRST
1940 D741             (       colour.asm):00025                         STB     <K_LAST
1942 9141             (       colour.asm):00026                         CMPA    <K_LAST         ; empty band?
1944 222A             (       colour.asm):00027                         BHI     CO_X
1946 1F10             (       colour.asm):00028                         TFR     X,D             ; B = colour
1948 C407             (       colour.asm):00029                         ANDB    #7
194A 2602             (       colour.asm):00030                         BNE     CO_2
194C C607             (       colour.asm):00031                         LDB     #7              ; 0 counts as white
194E CA90             (       colour.asm):00032         CO_2            ORB     #$90            ; $91-$97: graphics colour codes
1950 D742             (       colour.asm):00033                         STB     <K_CODE
                      (       colour.asm):00034         
1952 9640             (       colour.asm):00035                         LDA     <K_FIRST        ; U -> ROWCOL entry for the first row
1954 CE0043           (       colour.asm):00036                         LDU     #ROWCOL
1957 33C6             (       colour.asm):00037                         LEAU    A,U
1959 C628             (       colour.asm):00038                         LDB     #COLS           ; X -> column 0 of that buffer row
195B 3D               (       colour.asm):00039                         MUL                     ;  (first row * 40)
195C D300             (       colour.asm):00040                         ADDD    <W_BUF
195E 1F01             (       colour.asm):00041                         TFR     D,X
1960 D640             (       colour.asm):00042                         LDB     <K_FIRST        ; B counts rows
1962 9642             (       colour.asm):00043         CO_LOOP         LDA     <K_CODE
1964 A7C0             (       colour.asm):00044                         STA     ,U+             ; remember it ...
1966 A784             (       colour.asm):00045                         STA     ,X              ; ... and put it in the buffer
1968 308828           (       colour.asm):00046                         LEAX    COLS,X          ; next buffer row
196B D141             (       colour.asm):00047                         CMPB    <K_LAST         ; was that the last row? (carry set
196D 5C               (       colour.asm):00048                         INCB                    ;  if not; INCB leaves the carry
196E 25F2             (       colour.asm):00049                         BLO     CO_LOOP         ;  alone, so BLO still sees it)
1970 35D6             (       colour.asm):00050         CO_X            PULS    D,X,U,PC
                      (      src/tgl.asm):00104                         INCLUDE "pace.asm"
                      (         pace.asm):00001         ; ---------------------------------------------------------------------------
                      (         pace.asm):00002         ; T_PACE - keep a steady frame rate
                      (         pace.asm):00003         ;   Entry: A = frame length in 50Hz ticks: 1 = 50 fps, 2 = 25 fps,
                      (         pace.asm):00004         ;          3 = about 17 fps (0 counts as 1, more than 3 counts as 3)
                      (         pace.asm):00005         ;          DP = $00
                      (         pace.asm):00006         ;   Exit:  all registers preserved
                      (         pace.asm):00007         ;
                      (         pace.asm):00008         ;   Call once per frame, just before TGL_BLIT. It waits until the frame
                      (         pace.asm):00009         ;   period started by the previous call has run out, then starts the next
                      (         pace.asm):00010         ;   one, so every frame takes the same time however much was drawn. If a
                      (         pace.asm):00011         ;   frame took longer than its period it carries straight on, so the frame
                      (         pace.asm):00012         ;   rate falls gracefully rather than stalling. The first call after
                      (         pace.asm):00013         ;   TGL_INIT starts timing without waiting.
                      (         pace.asm):00014         ;
                      (         pace.asm):00015         ;   The period is timed with Timer 2 of the main VIA, in one-shot mode:
                      (         pace.asm):00016         ;   writing its high byte loads the count and starts it, and IFR bit 5 sets
                      (         pace.asm):00017         ;   when it reaches zero. Only the flag is polled - the timer's interrupt is
                      (         pace.asm):00018         ;   never enabled - and nothing else in the library touches the VIA. A
                      (         pace.asm):00019         ;   program that needs Timer 2 for itself simply doesn't call TGL_PACE, or
                      (         pace.asm):00020         ;   builds the library with NOPACE=1, which reduces this routine to RTS.
                      (         pace.asm):00021         ;
                      (         pace.asm):00022         ;   Timer 2's longest count is 65535 clocks (65ms at 1MHz), which is why
                      (         pace.asm):00023         ;   periods stop at three ticks (60ms).
                      (         pace.asm):00024         ;
                      (         pace.asm):00025         ;   This keeps animation smooth and even, but cannot stop tearing: the
                      (         pace.asm):00026         ;   timer is not locked to the display, as the 6845's vertical sync is not
                      (         pace.asm):00027         ;   connected to anything the CPU can read.
                      (         pace.asm):00028         ; ---------------------------------------------------------------------------
                      (         pace.asm):00029                         IFDEF   TGL_NOPACE
1972                  (         pace.asm):00030         T_PACE          RTS                     ; NOPACE build: does nothing
                      (         pace.asm):00031                         ELSE
                      (         pace.asm):00032         
1972 3416             (         pace.asm):00033         T_PACE          PSHS    D,X
1974 4D               (         pace.asm):00034                         TSTA                    ; ticks: 0 counts as 1 ...
1975 2601             (         pace.asm):00035                         BNE     PA_1
1977 4C               (         pace.asm):00036                         INCA
1978 8103             (         pace.asm):00037         PA_1            CMPA    #3              ; ... more than 3 counts as 3
197A 2302             (         pace.asm):00038                         BLS     PA_2
197C 8603             (         pace.asm):00039                         LDA     #3
197E 8EE980           (         pace.asm):00040         PA_2            LDX     #VIA_BASE
1981 0D5B             (         pace.asm):00041                         TST     <P_RUN          ; a period running? wait for it to
1983 2706             (         pace.asm):00042                         BEQ     PA_START        ;  finish (first call: no waiting)
1985 E60D             (         pace.asm):00043         PA_WAIT         LDB     VIA_IFR,X
1987 C520             (         pace.asm):00044                         BITB    #T2_FLAG
1989 27FA             (         pace.asm):00045                         BEQ     PA_WAIT
                      (         pace.asm):00046         
198B E60B             (         pace.asm):00047         PA_START        LDB     VIA_ACR,X       ; make sure Timer 2 is a one-shot
198D C4DF             (         pace.asm):00048                         ANDB    #~ACR_T2COUNT&$FF   ;  timer, leaving the rest of the
198F E70B             (         pace.asm):00049                         STB     VIA_ACR,X       ;  ACR alone
1991 308D000E         (         pace.asm):00050                         LEAX    PA_TAB-2,PCR    ; X -> period for A ticks (2 bytes
1995 48               (         pace.asm):00051                         ASLA                    ;  each, A = 1-3)
1996 EC86             (         pace.asm):00052                         LDD     A,X
1998 8EE980           (         pace.asm):00053                         LDX     #VIA_BASE
199B E708             (         pace.asm):00054                         STB     VIA_T2L,X       ; low byte into the latch ...
199D A709             (         pace.asm):00055                         STA     VIA_T2H,X       ; ... high byte starts the count and
                      (         pace.asm):00056                                                 ;  clears the timed-out flag
199F 8601             (         pace.asm):00057                         LDA     #1
19A1 975B             (         pace.asm):00058                         STA     <P_RUN
19A3 3596             (         pace.asm):00059                         PULS    D,X,PC
                      (         pace.asm):00060         
19A5 4E209C40EA60     (         pace.asm):00061         PA_TAB          FDB     TICK,2*TICK,3*TICK
                      (         pace.asm):00062                         ENDC
                      (      src/tgl.asm):00105                         INCLUDE "polygon.asm"
                      (      polygon.asm):00001         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00002         ; Filled convex polygons, and fill patterns
                      (      polygon.asm):00003         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00004         
                      (      polygon.asm):00005         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00006         ; T_SETPAT - choose the fill pattern for TGL_POLYF and TGL_CIRCF
                      (      polygon.asm):00007         ;   Entry: A = pattern (only the low 4 bits are used), DP = $00
                      (      polygon.asm):00008         ;   Exit:  all registers preserved
                      (      polygon.asm):00009         ;   The pattern is a 2x2 block of pixels repeated across the screen:
                      (      polygon.asm):00010         ;     bit 0 = even x, even y    bit 1 = odd x, even y
                      (      polygon.asm):00011         ;     bit 2 = even x, odd y     bit 3 = odd x, odd y
                      (      polygon.asm):00012         ;   15 is solid, 9 a checkerboard, 0 draws nothing. Outlines, lines,
                      (      polygon.asm):00013         ;   plots and rectangles are not affected.
                      (      polygon.asm):00014         ; ---------------------------------------------------------------------------
19AB 3402             (      polygon.asm):00015         T_SETPAT        PSHS    A
19AD 840F             (      polygon.asm):00016                         ANDA    #$0F
19AF 975D             (      polygon.asm):00017                         STA     <U_PAT
19B1 3582             (      polygon.asm):00018                         PULS    A,PC
                      (      polygon.asm):00019         
                      (      polygon.asm):00020         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00021         ; T_POLYF - filled convex polygon
                      (      polygon.asm):00022         ;   Entry: X -> corner count n (3 or more), then n pairs x, y (signed bytes,
                      (      polygon.asm):00023         ;          -128..127), in either winding order. DP = $00
                      (      polygon.asm):00024         ;   Exit:  all registers preserved
                      (      polygon.asm):00025         ;   Clips to the screen; uses the current plot mode and fill pattern.
                      (      polygon.asm):00026         ;   The polygon must be convex (every corner pointing outwards); anything
                      (      polygon.asm):00027         ;   else gives an odd-looking but harmless result.
                      (      polygon.asm):00028         ;
                      (      polygon.asm):00029         ;   Fill rule: a pixel is filled when its top-left corner is inside the
                      (      polygon.asm):00030         ;   polygon, i.e. the polygon includes its top and left edges but not its
                      (      polygon.asm):00031         ;   bottom and right ones. Polygons that share an edge therefore neither
                      (      polygon.asm):00032         ;   overlap nor leave a gap, so faces fit together exactly and XOR works
                      (      polygon.asm):00033         ;   across shared edges. (A square from (0,0) to (10,10) fills 10 x 10
                      (      polygon.asm):00034         ;   pixels.)
                      (      polygon.asm):00035         ;
                      (      polygon.asm):00036         ;   How it works: the fill sweeps down a row at a time from the top corner.
                      (      polygon.asm):00037         ;   Two edge walkers set off from the top corner, one going forwards round
                      (      polygon.asm):00038         ;   the corner list and one going backwards; for a convex polygon one runs
                      (      polygon.asm):00039         ;   down the left side and one down the right. Each walker tracks where its
                      (      polygon.asm):00040         ;   edge crosses the current row as a whole part q and a remainder r (the
                      (      polygon.asm):00041         ;   crossing is exactly q + r/dy), so it needs one division when it starts
                      (      polygon.asm):00042         ;   an edge and only additions after that, with no rounding drift. On each
                      (      polygon.asm):00043         ;   row the span runs from the smaller crossing (rounded up) to just before
                      (      polygon.asm):00044         ;   the larger.
                      (      polygon.asm):00045         ;
                      (      polygon.asm):00046         ;   Spans are not drawn a pixel row at a time, which would write every
                      (      polygon.asm):00047         ;   character cell three times. The three spans of a character row are
                      (      polygon.asm):00048         ;   collected first, then CELLROW writes each cell once: the cells all
                      (      polygon.asm):00049         ;   three rows cover completely get one combined mask in a single fast run,
                      (      polygon.asm):00050         ;   and the few cells at the ends get a mask built from exactly the pixels
                      (      polygon.asm):00051         ;   the spans cover.
                      (      polygon.asm):00052         ;
                      (      polygon.asm):00053         ;   Edge walker layout (at CHA and CHB):
     0000             (      polygon.asm):00054         CH_CUR          EQU     0               ; corner the current edge starts at
     0001             (      polygon.asm):00055         CH_NXT          EQU     1               ; corner it ends at
     0002             (      polygon.asm):00056         CH_YB           EQU     2               ; y of the end corner
     0003             (      polygon.asm):00057         CH_Q            EQU     3               ; 2  crossing: whole part (signed)
     0005             (      polygon.asm):00058         CH_QD           EQU     5               ; 2  added to q each row
     0007             (      polygon.asm):00059         CH_R            EQU     7               ; 1  crossing: remainder, 0..dy-1
     0008             (      polygon.asm):00060         CH_RD           EQU     8               ; 1  added to r each row
     0009             (      polygon.asm):00061         CH_DY           EQU     9               ; 1  edge height
     000A             (      polygon.asm):00062         CH_DIR          EQU     10              ; 1  +1 forwards, -1 backwards
                      (      polygon.asm):00063         ; Temporaries borrowed from the clipping code:
     000F             (      polygon.asm):00064         P_XC            EQU     I_U0            ; corner x/y while setting up an edge
     0010             (      polygon.asm):00065         P_XN            EQU     I_U1
     0011             (      polygon.asm):00066         P_YC            EQU     I_V0
     0012             (      polygon.asm):00067         P_YN            EQU     I_V1
     0013             (      polygon.asm):00068         P_CNT           EQU     I_E             ; guard count while skipping
     0018             (      polygon.asm):00069         P_CA            EQU     R_X0            ; the two crossings on this row
     0019             (      polygon.asm):00070         P_CB            EQU     R_Y0
                      (      polygon.asm):00071         ; Character-row compositor (CELLROW) temporaries, also borrowed:
     0038             (      polygon.asm):00072         S_A             EQU     T_BUF           ; 3  left end of each pixel row's span
     003B             (      polygon.asm):00073         S_B             EQU     T_BUF+3         ; 3  right end (S_A + 3)
     003E             (      polygon.asm):00074         S_P             EQU     T_DIG           ; 3  span present? (S_A + 6: T_DIG,
                      (      polygon.asm):00075                                                 ;    T_LEAD, K_FIRST)
     002C             (      polygon.asm):00076         S_ML            EQU     C_CX            ; 3  left-pixel mask of each pixel row
     002F             (      polygon.asm):00077         S_MR            EQU     C_CX+3          ; 3  right-pixel mask (S_ML + 3)
     0032             (      polygon.asm):00078         P_MODD          EQU     C_CX+6          ; 6  pattern masks for odd character
                      (      polygon.asm):00079                                                 ;    rows (C_F+1 .. C_FILL)
     001C             (      polygon.asm):00080         CR_C0           EQU     F_CX0           ; first cell all three rows cover
     001D             (      polygon.asm):00081         CR_C1           EQU     F_CX1           ; last cell all three rows cover
     001E             (      polygon.asm):00082         CR_CMIN         EQU     F_PL            ; first cell any row touches
     001F             (      polygon.asm):00083         CR_CMAX         EQU     F_PR            ; last cell any row touches
     0021             (      polygon.asm):00084         CR_C            EQU     F_RS            ; cell being worked on
     0022             (      polygon.asm):00085         CR_END          EQU     F_RN            ; last cell of the current range
     0023             (      polygon.asm):00086         CR_IDX          EQU     F_TOP           ; character row number
     0024             (      polygon.asm):00087         CR_S            EQU     F_BOTL          ; pixel row within it, $FF = none yet
     0028             (      polygon.asm):00088         CR_ROW          EQU     F_ROW           ; 2  address of the character row
                      (      polygon.asm):00089         ; ---------------------------------------------------------------------------
19B3 3476             (      polygon.asm):00090         T_POLYF         PSHS    D,X,Y,U
19B5 9F5E             (      polygon.asm):00091                         STX     <P_PTR
19B7 A684             (      polygon.asm):00092                         LDA     ,X              ; fewer than 3 corners: nothing
19B9 9760             (      polygon.asm):00093                         STA     <P_N
19BB 8103             (      polygon.asm):00094                         CMPA    #3
19BD 102500E0         (      polygon.asm):00095                         LBLO    PF_X
19C1 965D             (      polygon.asm):00096                         LDA     <U_PAT          ; polygons use the fill pattern
19C3 975C             (      polygon.asm):00097                         STA     <H_PAT
19C5 1700DB           (      polygon.asm):00098                         LBSR    PF_MASKS        ; work out its masks once
                      (      polygon.asm):00099         
                      (      polygon.asm):00100         ; Find the top corner (smallest y) and the bottom y
19C8 867F             (      polygon.asm):00101                         LDA     #127
19CA 9762             (      polygon.asm):00102                         STA     <P_Y
19CC 8680             (      polygon.asm):00103                         LDA     #-128
19CE 9761             (      polygon.asm):00104                         STA     <P_YMAX
19D0 5F               (      polygon.asm):00105                         CLRB                    ; B = corner index
19D1 3404             (      polygon.asm):00106         PF_FIND         PSHS    B
19D3 170266           (      polygon.asm):00107                         LBSR    VTX             ; A,B = x,y of corner B
19D6 D162             (      polygon.asm):00108                         CMPB    <P_Y            ; higher than the top so far?
19D8 2C06             (      polygon.asm):00109                         BGE     PF_F1
19DA D762             (      polygon.asm):00110                         STB     <P_Y
19DC A6E4             (      polygon.asm):00111                         LDA     ,S
19DE 9763             (      polygon.asm):00112                         STA     <P_TOP
19E0 D161             (      polygon.asm):00113         PF_F1           CMPB    <P_YMAX         ; lower than the bottom so far?
19E2 2F02             (      polygon.asm):00114                         BLE     PF_F2
19E4 D761             (      polygon.asm):00115                         STB     <P_YMAX
19E6 3504             (      polygon.asm):00116         PF_F2           PULS    B
19E8 5C               (      polygon.asm):00117                         INCB
19E9 D160             (      polygon.asm):00118                         CMPB    <P_N
19EB 25E4             (      polygon.asm):00119                         BLO     PF_FIND
                      (      polygon.asm):00120         
                      (      polygon.asm):00121         ; Start both edge walkers at the top corner
19ED CE0064           (      polygon.asm):00122                         LDU     #CHA
19F0 9663             (      polygon.asm):00123                         LDA     <P_TOP
19F2 A7C4             (      polygon.asm):00124                         STA     CH_CUR,U
19F4 8601             (      polygon.asm):00125                         LDA     #1              ; forwards round the list
19F6 A74A             (      polygon.asm):00126                         STA     CH_DIR,U
19F8 170259           (      polygon.asm):00127                         LBSR    CH_SETUP
19FB CE006F           (      polygon.asm):00128                         LDU     #CHB
19FE 9663             (      polygon.asm):00129                         LDA     <P_TOP
1A00 A7C4             (      polygon.asm):00130                         STA     CH_CUR,U
1A02 86FF             (      polygon.asm):00131                         LDA     #-1             ; backwards
1A04 A74A             (      polygon.asm):00132                         STA     CH_DIR,U
1A06 17024B           (      polygon.asm):00133                         LBSR    CH_SETUP
1A09 86FF             (      polygon.asm):00134                         LDA     #$FF            ; no character row started yet
1A0B 9724             (      polygon.asm):00135                         STA     <CR_S
                      (      polygon.asm):00136         
                      (      polygon.asm):00137         ; One pixel row per pass, from the top corner down to (not including) the
                      (      polygon.asm):00138         ; bottom corner
1A0D 9662             (      polygon.asm):00139         PF_ROW          LDA     <P_Y
1A0F 9161             (      polygon.asm):00140                         CMPA    <P_YMAX         ; reached the bottom corner?
1A11 102C0083         (      polygon.asm):00141                         LBGE    PF_END
1A15 8147             (      polygon.asm):00142                         CMPA    #YMAX           ; gone off the bottom of the screen?
1A17 102E007D         (      polygon.asm):00143                         LBGT    PF_END
1A1B CE0064           (      polygon.asm):00144                         LDU     #CHA            ; move each walker on to its next
1A1E 170224           (      polygon.asm):00145                         LBSR    CH_CHECK        ;  edge if this one has ended
1A21 CE006F           (      polygon.asm):00146                         LDU     #CHB
1A24 17021E           (      polygon.asm):00147                         LBSR    CH_CHECK
1A27 CE0064           (      polygon.asm):00148                         LDU     #CHA            ; the two crossings, rounded up
1A2A 1702B2           (      polygon.asm):00149                         LBSR    CH_CEIL
1A2D D718             (      polygon.asm):00150                         STB     <P_CA
1A2F CE006F           (      polygon.asm):00151                         LDU     #CHB
1A32 1702AA           (      polygon.asm):00152                         LBSR    CH_CEIL
1A35 D719             (      polygon.asm):00153                         STB     <P_CB
1A37 9662             (      polygon.asm):00154                         LDA     <P_Y            ; rows above the screen: just step
1A39 102B004A         (      polygon.asm):00155                         LBMI    PF_STEP
1A3D 9624             (      polygon.asm):00156                         LDA     <CR_S           ; first row on screen: start the
1A3F 81FF             (      polygon.asm):00157                         CMPA    #$FF            ;  character row it falls in
1A41 2603             (      polygon.asm):00158                         BNE     PF_HAVE
1A43 1700AE           (      polygon.asm):00159                         LBSR    CR_START
1A46 9618             (      polygon.asm):00160         PF_HAVE         LDA     <P_CA           ; span from the smaller crossing ...
1A48 D619             (      polygon.asm):00161                         LDB     <P_CB
1A4A 3404             (      polygon.asm):00162                         PSHS    B
1A4C A1E0             (      polygon.asm):00163                         CMPA    ,S+
1A4E 2727             (      polygon.asm):00164                         BEQ     PF_NEXTS        ; equal: nothing on this row
1A50 2D02             (      polygon.asm):00165                         BLT     PF_1
1A52 1E89             (      polygon.asm):00166                         EXG     A,B             ; A = smaller, B = larger
1A54 5A               (      polygon.asm):00167         PF_1            DECB                    ; ... to just before the larger (no
1A55 4D               (      polygon.asm):00168                         TSTA                    ;  overflow: larger > smaller)
1A56 2A01             (      polygon.asm):00169                         BPL     PF_2            ; clip to the screen: left end ...
1A58 4F               (      polygon.asm):00170                         CLRA
1A59 C14B             (      polygon.asm):00171         PF_2            CMPB    #XMAX           ; ... right end
1A5B 2F02             (      polygon.asm):00172                         BLE     PF_3
1A5D C64B             (      polygon.asm):00173                         LDB     #XMAX
1A5F 3404             (      polygon.asm):00174         PF_3            PSHS    B               ; anything left on screen?
1A61 A1E0             (      polygon.asm):00175                         CMPA    ,S+
1A63 2E12             (      polygon.asm):00176                         BGT     PF_NEXTS
1A65 8E0038           (      polygon.asm):00177                         LDX     #S_A            ; keep it as this pixel row's span:
1A68 3404             (      polygon.asm):00178                         PSHS    B               ;  X -> S_A[s]
1A6A D624             (      polygon.asm):00179                         LDB     <CR_S
1A6C 3A               (      polygon.asm):00180                         ABX
1A6D 3504             (      polygon.asm):00181                         PULS    B
1A6F A784             (      polygon.asm):00182                         STA     ,X              ;  S_A[s] = left
1A71 E703             (      polygon.asm):00183                         STB     3,X             ;  S_B[s] = right
1A73 8601             (      polygon.asm):00184                         LDA     #1
1A75 A706             (      polygon.asm):00185                         STA     6,X             ;  S_P[s] = present
1A77 9624             (      polygon.asm):00186         PF_NEXTS        LDA     <CR_S           ; next pixel row; after the third,
1A79 4C               (      polygon.asm):00187                         INCA                    ;  write the character row and move
1A7A 8103             (      polygon.asm):00188                         CMPA    #3              ;  on to the next one
1A7C 2507             (      polygon.asm):00189                         BLO     PF_4
1A7E 17009F           (      polygon.asm):00190                         LBSR    CELLROW
1A81 17008C           (      polygon.asm):00191                         LBSR    CR_NEXT
1A84 4F               (      polygon.asm):00192                         CLRA
1A85 9724             (      polygon.asm):00193         PF_4            STA     <CR_S
1A87 CE0064           (      polygon.asm):00194         PF_STEP         LDU     #CHA            ; both walkers down a row
1A8A 17025C           (      polygon.asm):00195                         LBSR    CH_STEP
1A8D CE006F           (      polygon.asm):00196                         LDU     #CHB
1A90 170256           (      polygon.asm):00197                         LBSR    CH_STEP
1A93 0C62             (      polygon.asm):00198                         INC     <P_Y
1A95 16FF75           (      polygon.asm):00199                         LBRA    PF_ROW
1A98 9624             (      polygon.asm):00200         PF_END          LDA     <CR_S           ; write the last, partly collected,
1A9A 81FF             (      polygon.asm):00201                         CMPA    #$FF            ;  character row (if any)
1A9C 2703             (      polygon.asm):00202                         BEQ     PF_X
1A9E 17007F           (      polygon.asm):00203                         LBSR    CELLROW
1AA1 35F6             (      polygon.asm):00204         PF_X            PULS    D,X,Y,U,PC
                      (      polygon.asm):00205         
                      (      polygon.asm):00206         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00207         ; PF_MASKS - work out the pattern's masks for even and odd character rows
                      (      polygon.asm):00208         ;   Pixel row s of character row r is screen row 3r + s, which is odd when
                      (      polygon.asm):00209         ;   r + s is odd. The pattern uses bits 0-1 on even screen rows and bits
                      (      polygon.asm):00210         ;   2-3 on odd ones (left pixel, right pixel). For each kind of character
                      (      polygon.asm):00211         ;   row this gives 3 left-pixel masks then 3 right-pixel masks.
                      (      polygon.asm):00212         ; ---------------------------------------------------------------------------
1AA3 CE007A           (      polygon.asm):00213         PF_MASKS        LDU     #P_MEVEN        ; even character rows: screen rows
1AA6 965C             (      polygon.asm):00214                         LDA     <H_PAT          ;  even, odd, even
1AA8 8D23             (      polygon.asm):00215                         BSR     PM_ROW0
1AAA 965C             (      polygon.asm):00216                         LDA     <H_PAT
1AAC 44               (      polygon.asm):00217                         LSRA
1AAD 44               (      polygon.asm):00218                         LSRA
1AAE 8D19             (      polygon.asm):00219                         BSR     PM_ROW1
1AB0 965C             (      polygon.asm):00220                         LDA     <H_PAT
1AB2 8D11             (      polygon.asm):00221                         BSR     PM_ROW2
1AB4 CE0032           (      polygon.asm):00222                         LDU     #P_MODD         ; odd character rows: odd, even, odd
1AB7 965C             (      polygon.asm):00223                         LDA     <H_PAT
1AB9 44               (      polygon.asm):00224                         LSRA
1ABA 44               (      polygon.asm):00225                         LSRA
1ABB 8D10             (      polygon.asm):00226                         BSR     PM_ROW0
1ABD 965C             (      polygon.asm):00227                         LDA     <H_PAT
1ABF 8D08             (      polygon.asm):00228                         BSR     PM_ROW1
1AC1 965C             (      polygon.asm):00229                         LDA     <H_PAT
1AC3 44               (      polygon.asm):00230                         LSRA
1AC4 44               (      polygon.asm):00231                         LSRA
                      (      polygon.asm):00232                         ; fall into PM_ROW2
                      (      polygon.asm):00233         
                      (      polygon.asm):00234         ; PM_ROWn - Entry: A = pattern bits for the screen row (bit 0 left, bit 1
                      (      polygon.asm):00235         ;   right), U -> mask set. Sets that pixel row's left and right masks.
1AC5 C602             (      polygon.asm):00236         PM_ROW2         LDB     #2
1AC7 2005             (      polygon.asm):00237                         BRA     PM_ROW
1AC9 C601             (      polygon.asm):00238         PM_ROW1         LDB     #1
1ACB 2001             (      polygon.asm):00239                         BRA     PM_ROW
1ACD 5F               (      polygon.asm):00240         PM_ROW0         CLRB
1ACE 3440             (      polygon.asm):00241         PM_ROW          PSHS    U
1AD0 33C5             (      polygon.asm):00242                         LEAU    B,U             ; U -> left mask for pixel row B
1AD2 308D0160         (      polygon.asm):00243                         LEAX    CW_LBIT,PCR
1AD6 6FC4             (      polygon.asm):00244                         CLR     ,U
1AD8 8501             (      polygon.asm):00245                         BITA    #1              ; left pixels allowed?
1ADA 2708             (      polygon.asm):00246                         BEQ     PM_1
1ADC 3402             (      polygon.asm):00247                         PSHS    A
1ADE A685             (      polygon.asm):00248                         LDA     B,X
1AE0 A7C4             (      polygon.asm):00249                         STA     ,U
1AE2 3502             (      polygon.asm):00250                         PULS    A
1AE4 6F43             (      polygon.asm):00251         PM_1            CLR     3,U
1AE6 8502             (      polygon.asm):00252                         BITA    #2              ; right pixels allowed?
1AE8 2708             (      polygon.asm):00253                         BEQ     PM_2
1AEA 308D014B         (      polygon.asm):00254                         LEAX    CW_RBIT,PCR
1AEE A685             (      polygon.asm):00255                         LDA     B,X
1AF0 A743             (      polygon.asm):00256                         STA     3,U
1AF2 35C0             (      polygon.asm):00257         PM_2            PULS    U,PC
                      (      polygon.asm):00258         
                      (      polygon.asm):00259         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00260         ; CR_START - start collecting at pixel row P_Y (on screen): work out which
                      (      polygon.asm):00261         ;   character row it is in, and where, and that row's address
                      (      polygon.asm):00262         ; ---------------------------------------------------------------------------
1AF4 9662             (      polygon.asm):00263         CR_START        LDA     <P_Y            ; character row = y / 3 and pixel
1AF6 5F               (      polygon.asm):00264                         CLRB                    ;  row within it = y mod 3, by
1AF7 8103             (      polygon.asm):00265         CS3_LOOP        CMPA    #3              ;  repeated subtraction (y <= 71)
1AF9 2505             (      polygon.asm):00266                         BLO     CS3_DONE
1AFB 8003             (      polygon.asm):00267                         SUBA    #3
1AFD 5C               (      polygon.asm):00268                         INCB
1AFE 20F7             (      polygon.asm):00269                         BRA     CS3_LOOP
1B00 9724             (      polygon.asm):00270         CS3_DONE        STA     <CR_S
1B02 D723             (      polygon.asm):00271                         STB     <CR_IDX
1B04 8628             (      polygon.asm):00272                         LDA     #COLS           ; address = buffer + COL1 + row * 40
1B06 3D               (      polygon.asm):00273                         MUL
1B07 D300             (      polygon.asm):00274                         ADDD    <W_BUF
1B09 C30002           (      polygon.asm):00275                         ADDD    #COL1
1B0C DD28             (      polygon.asm):00276                         STD     <CR_ROW
1B0E 2009             (      polygon.asm):00277                         BRA     CR_CLEAR
                      (      polygon.asm):00278         
                      (      polygon.asm):00279         ; CR_NEXT - move on to the next character row down
1B10 0C23             (      polygon.asm):00280         CR_NEXT         INC     <CR_IDX
1B12 DC28             (      polygon.asm):00281                         LDD     <CR_ROW
1B14 C30028           (      polygon.asm):00282                         ADDD    #COLS
1B17 DD28             (      polygon.asm):00283                         STD     <CR_ROW
                      (      polygon.asm):00284                         ; fall into CR_CLEAR
                      (      polygon.asm):00285         
                      (      polygon.asm):00286         ; CR_CLEAR - no spans collected yet in this character row
1B19 0F3E             (      polygon.asm):00287         CR_CLEAR        CLR     <S_P
1B1B 0F3F             (      polygon.asm):00288                         CLR     <S_P+1
1B1D 0F40             (      polygon.asm):00289                         CLR     <S_P+2
1B1F 39               (      polygon.asm):00290                         RTS
                      (      polygon.asm):00291         
                      (      polygon.asm):00292         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00293         ; CELLROW - write one character row from up to three collected spans
                      (      polygon.asm):00294         ;   S_P[s], S_A[s], S_B[s] (s = pixel row 0-2): is there a span on that
                      (      polygon.asm):00295         ;   pixel row, and its ends (clipped to 0-77, left <= right). Each cell is
                      (      polygon.asm):00296         ;   written once, through FILLSEG so the plot mode applies, with exactly
                      (      polygon.asm):00297         ;   the pixels the spans cover, filtered by the fill pattern.
                      (      polygon.asm):00298         ; ---------------------------------------------------------------------------
1B20 963E             (      polygon.asm):00299         CELLROW         LDA     <S_P            ; nothing collected: nothing to do
1B22 9A3F             (      polygon.asm):00300                         ORA     <S_P+1
1B24 9A40             (      polygon.asm):00301                         ORA     <S_P+2
1B26 1027010B         (      polygon.asm):00302                         LBEQ    CW_X
                      (      polygon.asm):00303         
                      (      polygon.asm):00304         ; This character row's masks: the even or odd set worked out by PF_MASKS
1B2A 8E007A           (      polygon.asm):00305                         LDX     #P_MEVEN        ; even character row
1B2D 9623             (      polygon.asm):00306                         LDA     <CR_IDX
1B2F 8501             (      polygon.asm):00307                         BITA    #1
1B31 2703             (      polygon.asm):00308                         BEQ     CW_M1
1B33 8E0032           (      polygon.asm):00309                         LDX     #P_MODD         ; odd character row
1B36 EC84             (      polygon.asm):00310         CW_M1           LDD     ,X              ; copy the 6 masks into S_ML/S_MR
1B38 DD2C             (      polygon.asm):00311                         STD     <S_ML
1B3A EC02             (      polygon.asm):00312                         LDD     2,X
1B3C DD2E             (      polygon.asm):00313                         STD     <S_ML+2
1B3E EC04             (      polygon.asm):00314                         LDD     4,X
1B40 DD30             (      polygon.asm):00315                         STD     <S_ML+4
                      (      polygon.asm):00316         
                      (      polygon.asm):00317         ; The cells any span touches: CR_CMIN to CR_CMAX
1B42 86FF             (      polygon.asm):00318                         LDA     #$FF
1B44 971E             (      polygon.asm):00319                         STA     <CR_CMIN
1B46 0F1F             (      polygon.asm):00320                         CLR     <CR_CMAX
1B48 5F               (      polygon.asm):00321                         CLRB
1B49 8E0038           (      polygon.asm):00322         CW_RNG          LDX     #S_A
1B4C 3A               (      polygon.asm):00323                         ABX
1B4D 6D06             (      polygon.asm):00324                         TST     6,X             ; S_P[s]
1B4F 2712             (      polygon.asm):00325                         BEQ     CW_RN
1B51 A684             (      polygon.asm):00326                         LDA     ,X              ; first cell this span touches
1B53 44               (      polygon.asm):00327                         LSRA
1B54 911E             (      polygon.asm):00328                         CMPA    <CR_CMIN
1B56 2402             (      polygon.asm):00329                         BHS     CW_R1
1B58 971E             (      polygon.asm):00330                         STA     <CR_CMIN
1B5A A603             (      polygon.asm):00331         CW_R1           LDA     3,X             ; last cell it touches
1B5C 44               (      polygon.asm):00332                         LSRA
1B5D 911F             (      polygon.asm):00333                         CMPA    <CR_CMAX
1B5F 2302             (      polygon.asm):00334                         BLS     CW_RN
1B61 971F             (      polygon.asm):00335                         STA     <CR_CMAX
1B63 5C               (      polygon.asm):00336         CW_RN           INCB
1B64 C103             (      polygon.asm):00337                         CMPB    #3
1B66 25E1             (      polygon.asm):00338                         BLO     CW_RNG
                      (      polygon.asm):00339         
                      (      polygon.asm):00340         ; If all three pixel rows have a span, the cells all three cover completely
                      (      polygon.asm):00341         ; (both pixels): CR_C0 to CR_C1
1B68 963E             (      polygon.asm):00342                         LDA     <S_P
1B6A 943F             (      polygon.asm):00343                         ANDA    <S_P+1
1B6C 9440             (      polygon.asm):00344                         ANDA    <S_P+2
1B6E 2754             (      polygon.asm):00345                         BEQ     CW_NOFULL
1B70 0F1C             (      polygon.asm):00346                         CLR     <CR_C0
1B72 867F             (      polygon.asm):00347                         LDA     #127
1B74 971D             (      polygon.asm):00348                         STA     <CR_C1
1B76 5F               (      polygon.asm):00349                         CLRB
1B77 8E0038           (      polygon.asm):00350         CW_FR           LDX     #S_A
1B7A 3A               (      polygon.asm):00351                         ABX
1B7B A684             (      polygon.asm):00352                         LDA     ,X              ; first cell this span covers
1B7D 4C               (      polygon.asm):00353                         INCA                    ;  completely: (left + 1) / 2
1B7E 44               (      polygon.asm):00354                         LSRA
1B7F 911C             (      polygon.asm):00355                         CMPA    <CR_C0          ; keep the largest
1B81 2302             (      polygon.asm):00356                         BLS     CW_F1
1B83 971C             (      polygon.asm):00357                         STA     <CR_C0
1B85 A603             (      polygon.asm):00358         CW_F1           LDA     3,X             ; last cell it covers completely:
1B87 4C               (      polygon.asm):00359                         INCA                    ;  (right + 1) / 2 - 1, which can
1B88 44               (      polygon.asm):00360                         LSRA                    ;  be -1 (none)
1B89 4A               (      polygon.asm):00361                         DECA
1B8A 911D             (      polygon.asm):00362                         CMPA    <CR_C1          ; keep the smallest (signed)
1B8C 2C02             (      polygon.asm):00363                         BGE     CW_F2
1B8E 971D             (      polygon.asm):00364                         STA     <CR_C1
1B90 5C               (      polygon.asm):00365         CW_F2           INCB
1B91 C103             (      polygon.asm):00366                         CMPB    #3
1B93 25E2             (      polygon.asm):00367                         BLO     CW_FR
1B95 961C             (      polygon.asm):00368                         LDA     <CR_C0          ; any fully covered cells?
1B97 911D             (      polygon.asm):00369                         CMPA    <CR_C1
1B99 2E29             (      polygon.asm):00370                         BGT     CW_NOFULL
                      (      polygon.asm):00371         
                      (      polygon.asm):00372         ; Fully covered cells: one combined mask, one run
1B9B 962C             (      polygon.asm):00373                         LDA     <S_ML
1B9D 9A2D             (      polygon.asm):00374                         ORA     <S_ML+1
1B9F 9A2E             (      polygon.asm):00375                         ORA     <S_ML+2
1BA1 9A2F             (      polygon.asm):00376                         ORA     <S_MR
1BA3 9A30             (      polygon.asm):00377                         ORA     <S_MR+1
1BA5 9A31             (      polygon.asm):00378                         ORA     <S_MR+2
1BA7 270D             (      polygon.asm):00379                         BEQ     CW_EDGES        ; pattern leaves nothing to draw
1BA9 9E28             (      polygon.asm):00380                         LDX     <CR_ROW
1BAB D61C             (      polygon.asm):00381                         LDB     <CR_C0
1BAD 3A               (      polygon.asm):00382                         ABX
1BAE D61D             (      polygon.asm):00383                         LDB     <CR_C1
1BB0 D01C             (      polygon.asm):00384                         SUBB    <CR_C0
1BB2 5C               (      polygon.asm):00385                         INCB
1BB3 17FAC8           (      polygon.asm):00386                         LBSR    FILLSEG
1BB6 961E             (      polygon.asm):00387         CW_EDGES        LDA     <CR_CMIN        ; cells before them ...
1BB8 D61C             (      polygon.asm):00388                         LDB     <CR_C0
1BBA 5A               (      polygon.asm):00389                         DECB
1BBB 8D0B             (      polygon.asm):00390                         BSR     CW_CELLS
1BBD 961D             (      polygon.asm):00391                         LDA     <CR_C1          ; ... and after them
1BBF 4C               (      polygon.asm):00392                         INCA
1BC0 D61F             (      polygon.asm):00393                         LDB     <CR_CMAX
1BC2 2004             (      polygon.asm):00394                         BRA     CW_CELLS
                      (      polygon.asm):00395         
1BC4 961E             (      polygon.asm):00396         CW_NOFULL       LDA     <CR_CMIN        ; no fully covered cells: build every
1BC6 D61F             (      polygon.asm):00397                         LDB     <CR_CMAX        ;  cell's mask
                      (      polygon.asm):00398                         ; fall into CW_CELLS
                      (      polygon.asm):00399         
                      (      polygon.asm):00400         ; ---------------------------------------------------------------------------
                      (      polygon.asm):00401         ; CW_CELLS - write cells A to B (signed; nothing if A > B), each with a mask
                      (      polygon.asm):00402         ;   built from the spans: a cell's left pixel (x = 2c) is included on pixel
                      (      polygon.asm):00403         ;   row s if S_A[s] <= x <= S_B[s], and its right pixel (x + 1) likewise.
                      (      polygon.asm):00404         ;   The three pixel rows are written out in full (CW_ROWBITS, a macro) with
                      (      polygon.asm):00405         ;   direct addressing, building the mask in B, as this is the slowest part
                      (      polygon.asm):00406         ;   of the fill for shapes with slanted edges.
                      (      polygon.asm):00407         ; ---------------------------------------------------------------------------
1BC8                  (      polygon.asm):00408         CW_ROWBITS      MACRO
                      (      polygon.asm):00409                         TST     <S_P+\1         ; a span on pixel row \1?
                      (      polygon.asm):00410                         BEQ     \2_N
                      (      polygon.asm):00411                         CMPA    <S_A+\1         ; left pixel within it?
                      (      polygon.asm):00412                         BLO     \2_R
                      (      polygon.asm):00413                         CMPA    <S_B+\1
                      (      polygon.asm):00414                         BHI     \2_R
                      (      polygon.asm):00415                         ORB     <S_ML+\1
1BC8                  (      polygon.asm):00416         \2_R            INCA                    ; right pixel within it?
                      (      polygon.asm):00417                         CMPA    <S_A+\1
                      (      polygon.asm):00418                         BLO     \2_D
                      (      polygon.asm):00419                         CMPA    <S_B+\1
                      (      polygon.asm):00420                         BHI     \2_D
                      (      polygon.asm):00421                         ORB     <S_MR+\1
1BC8                  (      polygon.asm):00422         \2_D            DECA
1BC8                  (      polygon.asm):00423         \2_N
                      (      polygon.asm):00424                         ENDM
                      (      polygon.asm):00425         
1BC8 9721             (      polygon.asm):00426         CW_CELLS        STA     <CR_C
1BCA D722             (      polygon.asm):00427                         STB     <CR_END
1BCC 9621             (      polygon.asm):00428         CC_LOOP         LDA     <CR_C
1BCE 9122             (      polygon.asm):00429                         CMPA    <CR_END
1BD0 2E63             (      polygon.asm):00430                         BGT     CW_X
1BD2 48               (      polygon.asm):00431                         ASLA                    ; A = x of the cell's left pixel
1BD3 5F               (      polygon.asm):00432                         CLRB                    ; B = mask
                      (      polygon.asm):00433                         CW_ROWBITS 0,CR0
