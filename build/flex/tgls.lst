                      (         rect.asm):00264         ;   Entry: A = x0, B = y0, X = x1:y1 (signed)    Exit: A, B corrupted
                      (         rect.asm):00265         ; ---------------------------------------------------------------------------
168B DD18             (         rect.asm):00266         R_SORT          STD     <R_X0
168D 9F1A             (         rect.asm):00267                         STX     <R_X1
168F 9618             (         rect.asm):00268                         LDA     <R_X0
