                      (      src/tgl.asm):00107                         INCLUDE "dash.asm"
                      (         dash.asm):00001         ; ---------------------------------------------------------------------------
                      (         dash.asm):00002         ; Dashed lines and rectangles ("marching ants")
                      (         dash.asm):00003         ;
                      (         dash.asm):00004         ;   A dash pattern of 1-8 pixels repeats along the line. Pixels where the
                      (         dash.asm):00005         ;   pattern bit is 1 are drawn in the current plot mode; pixels where it is
                      (         dash.asm):00006         ;   0 (the gaps) get the opposite: cleared in SET mode, set in CLEAR mode,
                      (         dash.asm):00007         ;   and left alone in XOR mode (so XOR ants can run over a picture without
                      (         dash.asm):00008         ;   harming it).
                      (         dash.asm):00009         ;
                      (         dash.asm):00010         ;   The pattern runs from the start point given towards the end point (for
                      (         dash.asm):00011         ;   a rectangle, clockwise from the top-left corner). Adding 1 to the phase
                      (         dash.asm):00012         ;   each frame moves the dashes forward one pixel, so they appear to march.
                      (         dash.asm):00013         ;
                      (         dash.asm):00014         ;   Both drawing routines take signed coordinates (-128..127) and clip a
                      (         dash.asm):00015         ;   pixel at a time, so the pattern stays anchored to the true start point
                      (         dash.asm):00016         ;   even when part of the shape is off screen. They use a plain line loop
                      (         dash.asm):00017         ;   of their own (TGL_LINE's fast loops are untouched).
                      (         dash.asm):00018         ; ---------------------------------------------------------------------------
                      (         dash.asm):00019         
                      (         dash.asm):00020         ; The dash settings live here in the library (it is RAM-resident), as the
                      (         dash.asm):00021         ; page-zero workspace is full. Set by TGL_SETDASH; TGL_INIT sets the default.
2133 03               (         dash.asm):00022         DASH_PAT        FCB     %011            ; pattern: bit 0 is the first pixel
2134 03               (         dash.asm):00023         DASH_LEN        FCB     3               ; pattern length, 1-8
2135 00               (         dash.asm):00024         DASH_PH         FCB     0               ; phase, 0 .. length-1
                      (         dash.asm):00025         
                      (         dash.asm):00026         ; Workspace borrowed from routines that never run at the same time
     000F             (         dash.asm):00027         D_X             EQU     I_U0            ; current pixel
     0010             (         dash.asm):00028         D_Y             EQU     I_U1
     0011             (         dash.asm):00029         D_X1            EQU     I_V0            ; end point
     0012             (         dash.asm):00030         D_Y1            EQU     I_V1
     0013             (         dash.asm):00031         D_SX            EQU     I_E             ; x step, +1 or -1
     0014             (         dash.asm):00032         D_SY            EQU     I_SGN           ; y step
     001C             (         dash.asm):00033         D_DX            EQU     F_CX0           ; 2  |dx|
     001E             (         dash.asm):00034         D_DY            EQU     F_PL            ; 2  -|dy|
     0020             (         dash.asm):00035         D_ERR           EQU     F_SGL           ; 2  error term
     0022             (         dash.asm):00036         D_E2            EQU     F_RN            ; 2  error term * 2
     0024             (         dash.asm):00037         D_PATC          EQU     F_BOTL          ; the pattern, copied here for speed
     0025             (         dash.asm):00038         D_LENC          EQU     F_ML            ; its length
     0026             (         dash.asm):00039         D_BIT           EQU     F_MR            ; this pixel's bit in the pattern
     0027             (         dash.asm):00040         D_CNT           EQU     W_FM            ; pixels left in this repeat
                      (         dash.asm):00041         
                      (         dash.asm):00042         ; ---------------------------------------------------------------------------
                      (         dash.asm):00043         ; T_SETDASH - set the dash pattern
                      (         dash.asm):00044         ;   Entry: A = pattern (bit 0 = first pixel of each repeat; 1 = drawn,
                      (         dash.asm):00045         ;          0 = gap), B = length in pixels (1-8; 0 or more than 8 means 8),
                      (         dash.asm):00046         ;          X = phase (low byte, taken modulo the length), DP = $00
                      (         dash.asm):00047         ;   Exit:  all registers preserved
                      (         dash.asm):00048         ; ---------------------------------------------------------------------------
2136 3416             (         dash.asm):00049         T_SETDASH       PSHS    D,X
2138 A78CF8           (         dash.asm):00050                         STA     DASH_PAT,PCR
213B 5D               (         dash.asm):00051                         TSTB                    ; length: 0 or over 8 means 8
213C 2704             (         dash.asm):00052                         BEQ     SD_8
213E C108             (         dash.asm):00053                         CMPB    #8
2140 2302             (         dash.asm):00054                         BLS     SD_1
2142 C608             (         dash.asm):00055         SD_8            LDB     #8
2144 E78CED           (         dash.asm):00056         SD_1            STB     DASH_LEN,PCR
2147 1F10             (         dash.asm):00057                         TFR     X,D             ; phase mod length (B = phase)
2149 E18CE8           (         dash.asm):00058         SD_MOD          CMPB    DASH_LEN,PCR
214C 2505             (         dash.asm):00059                         BLO     SD_2
214E E08CE3           (         dash.asm):00060                         SUBB    DASH_LEN,PCR
2151 20F6             (         dash.asm):00061                         BRA     SD_MOD
2153 E78CDF           (         dash.asm):00062         SD_2            STB     DASH_PH,PCR
2156 3596             (         dash.asm):00063                         PULS    D,X,PC
                      (         dash.asm):00064         
                      (         dash.asm):00065         ; ---------------------------------------------------------------------------
                      (         dash.asm):00066         ; DSETUP - get ready to draw dashes:
                      (         dash.asm):00067         ;   - copy the pattern and length into page zero
                      (         dash.asm):00068         ;   - the first pixel is (length - phase) mod length into the pattern (so
                      (         dash.asm):00069         ;     moving the phase on moves the dashes forward): D_BIT is that
                      (         dash.asm):00070         ;     position's bit, D_CNT the pixels left before the pattern repeats
                      (         dash.asm):00071         ;   - patch the operations for drawn pixels and gaps into DOP: drawn
                      (         dash.asm):00072         ;     pixels use the current mode; gaps use SET <-> CLEAR swapped, and in
                      (         dash.asm):00073         ;     XOR mode are left alone (LDA ,X then STA ,X)
                      (         dash.asm):00074         ; ---------------------------------------------------------------------------
2158 A68CD8           (         dash.asm):00075         DSETUP          LDA     DASH_PAT,PCR
215B 9724             (         dash.asm):00076                         STA     <D_PATC
215D A68CD4           (         dash.asm):00077                         LDA     DASH_LEN,PCR
2160 9725             (         dash.asm):00078                         STA     <D_LENC
2162 A08CD0           (         dash.asm):00079                         SUBA    DASH_PH,PCR     ; start position = length - phase
2165 9125             (         dash.asm):00080                         CMPA    <D_LENC         ;  (phase 0: position 0)
2167 2501             (         dash.asm):00081                         BLO     DSU_1
2169 4F               (         dash.asm):00082                         CLRA
216A 3402             (         dash.asm):00083         DSU_1           PSHS    A
216C D625             (         dash.asm):00084                         LDB     <D_LENC         ; pixels left in this repeat
216E E0E4             (         dash.asm):00085                         SUBB    ,S
2170 D727             (         dash.asm):00086                         STB     <D_CNT
2172 308D005C         (         dash.asm):00087                         LEAX    DP_BITS,PCR     ; that position's bit
2176 3504             (         dash.asm):00088                         PULS    B
2178 A685             (         dash.asm):00089                         LDA     B,X
217A 9726             (         dash.asm):00090                         STA     <D_BIT
217C D605             (         dash.asm):00091                         LDB     <W_MODE         ; drawn pixels: the current mode
217E 308D001F         (         dash.asm):00092                         LEAX    DS_OPS,PCR
2182 58               (         dash.asm):00093                         ASLB
2183 3A               (         dash.asm):00094                         ABX
2184 EC84             (         dash.asm):00095                         LDD     ,X
2186 A78D0029         (         dash.asm):00096                         STA     DON_PRE,PCR
218A E78D0026         (         dash.asm):00097                         STB     DON_OP,PCR
218E D605             (         dash.asm):00098                         LDB     <W_MODE         ; gaps: the opposite
2190 308D0013         (         dash.asm):00099                         LEAX    DS_GAPS,PCR
2194 58               (         dash.asm):00100                         ASLB
2195 3A               (         dash.asm):00101                         ABX
2196 EC84             (         dash.asm):00102                         LDD     ,X
2198 A78D001E         (         dash.asm):00103                         STA     DOF_PRE,PCR
219C E78D001B         (         dash.asm):00104                         STB     DOF_OP,PCR
21A0 39               (         dash.asm):00105                         RTS
                      (         dash.asm):00106         
                      (         dash.asm):00107         ; pre-op byte and operation opcode (indexed ,X) for each mode
21A1 12AA             (         dash.asm):00108         DS_OPS          FCB     $12,$AA         ; SET:   NOP,  ORA  ,X
21A3 43A4             (         dash.asm):00109                         FCB     $43,$A4         ; CLEAR: COMA, ANDA ,X
21A5 12A8             (         dash.asm):00110                         FCB     $12,$A8         ; XOR:   NOP,  EORA ,X
21A7 43A4             (         dash.asm):00111         DS_GAPS         FCB     $43,$A4         ; SET's gaps are cleared
21A9 12AA             (         dash.asm):00112                         FCB     $12,$AA         ; CLEAR's gaps are set
21AB 12A6             (         dash.asm):00113                         FCB     $12,$A6         ; XOR's gaps: LDA ,X (no change)
                      (         dash.asm):00114         
                      (         dash.asm):00115         ; ---------------------------------------------------------------------------
                      (         dash.asm):00116         ; DOP - apply one dashed pixel and move on in the pattern
                      (         dash.asm):00117         ;   Entry: A = the pixel's mask, X -> its cell   Exit: A, B corrupted
                      (         dash.asm):00118         ; ---------------------------------------------------------------------------
21AD D624             (         dash.asm):00119         DOP             LDB     <D_PATC         ; drawn or gap?
21AF D426             (         dash.asm):00120                         ANDB    <D_BIT
21B1 2707             (         dash.asm):00121                         BEQ     DOF_PRE
21B3 12               (         dash.asm):00122         DON_PRE         NOP                     ; patched: drawn pixels' operation
21B4 AA84             (         dash.asm):00123         DON_OP          ORA     ,X
21B6 A784             (         dash.asm):00124                         STA     ,X
21B8 2005             (         dash.asm):00125                         BRA     ADV1
21BA 12               (         dash.asm):00126         DOF_PRE         NOP                     ; patched: gaps' operation
21BB AA84             (         dash.asm):00127         DOF_OP          ORA     ,X
21BD A784             (         dash.asm):00128                         STA     ,X
                      (         dash.asm):00129                         ; fall into ADV1
                      (         dash.asm):00130         
                      (         dash.asm):00131         ; ADV1 - move on one pixel in the pattern (A, B kept)
21BF 0826             (         dash.asm):00132         ADV1            ASL     <D_BIT
21C1 0A27             (         dash.asm):00133                         DEC     <D_CNT
21C3 260C             (         dash.asm):00134                         BNE     AD_X
21C5 3402             (         dash.asm):00135                         PSHS    A
21C7 9625             (         dash.asm):00136                         LDA     <D_LENC         ; start the pattern again
21C9 9727             (         dash.asm):00137                         STA     <D_CNT
21CB 8601             (         dash.asm):00138                         LDA     #1
21CD 9726             (         dash.asm):00139                         STA     <D_BIT
21CF 3502             (         dash.asm):00140                         PULS    A
21D1 39               (         dash.asm):00141         AD_X            RTS
                      (         dash.asm):00142         
21D2 0102040810204080 (         dash.asm):00143         DP_BITS         FCB     1,2,4,8,16,32,64,128
                      (         dash.asm):00144         
                      (         dash.asm):00145         ; ---------------------------------------------------------------------------
                      (         dash.asm):00146         ; T_LINED - dashed line
                      (         dash.asm):00147         ;   Entry: A = x0, B = y0, X = x1 (high byte) : y1 (low byte), all signed,
                      (         dash.asm):00148         ;          DP = $00
                      (         dash.asm):00149         ;   Exit:  all registers preserved
                      (         dash.asm):00150         ; ---------------------------------------------------------------------------
21DA 3476             (         dash.asm):00151         T_LINED         PSHS    D,X,Y,U
21DC DD0F             (         dash.asm):00152                         STD     <D_X
21DE 9F11             (         dash.asm):00153                         STX     <D_X1
21E0 17FF75           (         dash.asm):00154                         LBSR    DSETUP
21E3 8D02             (         dash.asm):00155                         BSR     DLINE
21E5 35F6             (         dash.asm):00156                         PULS    D,X,Y,U,PC
                      (         dash.asm):00157         
                      (         dash.asm):00158         ; ---------------------------------------------------------------------------
                      (         dash.asm):00159         ; DLINE - the dashed line from (D_X,D_Y) to (D_X1,D_Y1), carrying on in the
                      (         dash.asm):00160         ;   pattern from wherever it is (and leaving it after the last pixel)
                      (         dash.asm):00161         ;
                      (         dash.asm):00162         ;   A standard all-directions Bresenham loop, in 16 bits as dx and dy can
                      (         dash.asm):00163         ;   each be up to 255:
                      (         dash.asm):00164         ;       err = dx - dy;  each pixel: e2 = 2*err;
                      (         dash.asm):00165         ;       if e2 >= -dy, err -= dy and step x;  if e2 <= dx, err += dx and
                      (         dash.asm):00166         ;       step y
                      (         dash.asm):00167         ;   U follows y through the row table PTAB (4 bytes a row), so a pixel's
                      (         dash.asm):00168         ;   cell and mask need no lookup: U is only used when y is on screen, but
                      (         dash.asm):00169         ;   is kept in step (PTAB + 4y) even when it isn't. Off-screen pixels are
                      (         dash.asm):00170         ;   skipped, but still move the pattern on.
                      (         dash.asm):00171         ; ---------------------------------------------------------------------------
21E7 8601             (         dash.asm):00172         DLINE           LDA     #1              ; x step and |dx|
21E9 9713             (         dash.asm):00173                         STA     <D_SX
21EB D611             (         dash.asm):00174                         LDB     <D_X1
21ED 1D               (         dash.asm):00175                         SEX
21EE 3406             (         dash.asm):00176                         PSHS    D
21F0 D60F             (         dash.asm):00177                         LDB     <D_X
21F2 1D               (         dash.asm):00178                         SEX
21F3 3406             (         dash.asm):00179                         PSHS    D
21F5 EC62             (         dash.asm):00180                         LDD     2,S             ; dx = x1 - x0
21F7 A3E1             (         dash.asm):00181                         SUBD    ,S++
21F9 3262             (         dash.asm):00182                         LEAS    2,S
21FB 2A07             (         dash.asm):00183                         BPL     DL_1
21FD 0013             (         dash.asm):00184                         NEG     <D_SX           ; going left
21FF 43               (         dash.asm):00185                         COMA
2200 53               (         dash.asm):00186                         COMB
2201 C30001           (         dash.asm):00187                         ADDD    #1
2204 DD1C             (         dash.asm):00188         DL_1            STD     <D_DX
2206 8601             (         dash.asm):00189                         LDA     #1              ; y step and -|dy|
2208 9714             (         dash.asm):00190                         STA     <D_SY
220A D612             (         dash.asm):00191                         LDB     <D_Y1
220C 1D               (         dash.asm):00192                         SEX
220D 3406             (         dash.asm):00193                         PSHS    D
220F D610             (         dash.asm):00194                         LDB     <D_Y
2211 1D               (         dash.asm):00195                         SEX
2212 3406             (         dash.asm):00196                         PSHS    D
2214 EC62             (         dash.asm):00197                         LDD     2,S             ; dy = y1 - y0
2216 A3E1             (         dash.asm):00198                         SUBD    ,S++
2218 3262             (         dash.asm):00199                         LEAS    2,S
221A 2A07             (         dash.asm):00200                         BPL     DL_2
221C 0014             (         dash.asm):00201                         NEG     <D_SY           ; going up
221E 43               (         dash.asm):00202                         COMA
221F 53               (         dash.asm):00203                         COMB
2220 C30001           (         dash.asm):00204                         ADDD    #1
2223 43               (         dash.asm):00205         DL_2            COMA                    ; keep -|dy|
2224 53               (         dash.asm):00206                         COMB
2225 C30001           (         dash.asm):00207                         ADDD    #1
2228 DD1E             (         dash.asm):00208                         STD     <D_DY
222A D31C             (         dash.asm):00209                         ADDD    <D_DX           ; err = dx + (-|dy|)
222C DD20             (         dash.asm):00210                         STD     <D_ERR
222E D610             (         dash.asm):00211                         LDB     <D_Y            ; U = PTAB + 4 * y (y signed)
2230 1D               (         dash.asm):00212                         SEX
2231 58               (         dash.asm):00213                         ASLB
2232 49               (         dash.asm):00214                         ROLA
2233 58               (         dash.asm):00215                         ASLB
2234 49               (         dash.asm):00216                         ROLA
2235 338D017D         (         dash.asm):00217                         LEAU    PTAB,PCR
2239 33CB             (         dash.asm):00218                         LEAU    D,U
223B DC1E             (         dash.asm):00219                         LDD     <D_DY           ; horizontal? (no y change)
223D 1027006B         (         dash.asm):00220                         LBEQ    DHZ
2241 DC1C             (         dash.asm):00221                         LDD     <D_DX           ; vertical? (no x change)
2243 102700A4         (         dash.asm):00222                         LBEQ    DVT
                      (         dash.asm):00223         
2247 960F             (         dash.asm):00224         DL_LOOP         LDA     <D_X            ; this pixel: on screen?
2249 814B             (         dash.asm):00225                         CMPA    #XMAX           ;  (unsigned compares catch
224B 221B             (         dash.asm):00226                         BHI     DL_OFF          ;  negatives too)
224D D610             (         dash.asm):00227                         LDB     <D_Y
224F C147             (         dash.asm):00228                         CMPB    #YMAX
2251 2215             (         dash.asm):00229                         BHI     DL_OFF
2253 ECC4             (         dash.asm):00230                         LDD     ,U              ; X -> its cell
2255 D300             (         dash.asm):00231                         ADDD    <W_BUF
2257 1F01             (         dash.asm):00232                         TFR     D,X
2259 D60F             (         dash.asm):00233                         LDB     <D_X
225B 54               (         dash.asm):00234                         LSRB                    ; carry = right pixel
225C 3A               (         dash.asm):00235                         ABX                     ;  (ABX leaves the carry)
225D A642             (         dash.asm):00236                         LDA     2,U             ; its mask
225F 2402             (         dash.asm):00237                         BCC     DL_ON
2261 A643             (         dash.asm):00238                         LDA     3,U
2263 17FF47           (         dash.asm):00239         DL_ON           LBSR    DOP
2266 2003             (         dash.asm):00240                         BRA     DL_STEP
2268 17FF54           (         dash.asm):00241         DL_OFF          LBSR    ADV1            ; off screen: just move on
226B 960F             (         dash.asm):00242         DL_STEP         LDA     <D_X            ; reached the end?
226D 9111             (         dash.asm):00243                         CMPA    <D_X1
226F 2606             (         dash.asm):00244                         BNE     DL_3
2271 9610             (         dash.asm):00245                         LDA     <D_Y
2273 9112             (         dash.asm):00246                         CMPA    <D_Y1
2275 2734             (         dash.asm):00247                         BEQ     DL_X
2277 DC20             (         dash.asm):00248         DL_3            LDD     <D_ERR          ; e2 = 2 * err
2279 58               (         dash.asm):00249                         ASLB
227A 49               (         dash.asm):00250                         ROLA
227B DD22             (         dash.asm):00251                         STD     <D_E2
227D 10931E           (         dash.asm):00252                         CMPD    <D_DY           ; e2 >= -|dy|: step x
2280 2D0C             (         dash.asm):00253                         BLT     DL_4
2282 DC20             (         dash.asm):00254                         LDD     <D_ERR
2284 D31E             (         dash.asm):00255                         ADDD    <D_DY
2286 DD20             (         dash.asm):00256                         STD     <D_ERR
2288 960F             (         dash.asm):00257                         LDA     <D_X
228A 9B13             (         dash.asm):00258                         ADDA    <D_SX
228C 970F             (         dash.asm):00259                         STA     <D_X
