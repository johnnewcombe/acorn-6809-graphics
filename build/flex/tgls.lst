17DA 54               (       circle.asm):00210                         LSRB
17DB 54               (       circle.asm):00211                         LSRB
17DC C501             (       circle.asm):00212         HS_P1           BITB    #1
17DE 2602             (       circle.asm):00213                         BNE     HS_P2
17E0 0F25             (       circle.asm):00214                         CLR     <F_ML
17E2 C502             (       circle.asm):00215         HS_P2           BITB    #2
17E4 2602             (       circle.asm):00216                         BNE     HS_P3
17E6 0F26             (       circle.asm):00217                         CLR     <F_MR
17E8 9625             (       circle.asm):00218         HS_P3           LDA     <F_ML           ; nothing left to draw on this row?
17EA 9A26             (       circle.asm):00219                         ORA     <F_MR
17EC 10270074         (       circle.asm):00220                         LBEQ    HS_X
                      (       circle.asm):00221         
17F0 A6E4             (       circle.asm):00222                         LDA     ,S              ; first cell, and does the run start
17F2 44               (       circle.asm):00223                         LSRA                    ;  on its right pixel (x odd)?
17F3 971C             (       circle.asm):00224                         STA     <F_CX0
17F5 8600             (       circle.asm):00225                         LDA     #0              ; (not CLRA: keep the carry)
17F7 49               (       circle.asm):00226                         ROLA
17F8 971E             (       circle.asm):00227                         STA     <F_PL
