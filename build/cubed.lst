                      (   demo/cubed.asm):00001         ; ===========================================================================
                      (   demo/cubed.asm):00002         ; Die demo for the teletext graphics library
                      (   demo/cubed.asm):00003         ;
                      (   demo/cubed.asm):00004         ;   The tumbling, zooming cube from cube.asm, drawn as a die: white faces
                      (   demo/cubed.asm):00005         ;   with black spots and black edges. The spots are points on the cube's
                      (   demo/cubed.asm):00006         ;   surface, so they turn, tilt and bunch up with the faces in perspective.
                      (   demo/cubed.asm):00007         ;   Opposite faces add up to seven, as on a real die. Press any key to exit.
                      (   demo/cubed.asm):00008         ;
                      (   demo/cubed.asm):00009         ;   Loading: tgl.bin at $1000, cubed.bin at $2000. Run from START ($2000).
                      (   demo/cubed.asm):00010         ;
                      (   demo/cubed.asm):00011         ;   Shares its code with cube.asm (see there for the list): the face
                      (   demo/cubed.asm):00012         ;   filling is in cube_fill.asm, the rest in cube_core.asm. The spots are
                      (   demo/cubed.asm):00013         ;   here.
                      (   demo/cubed.asm):00014         ;
                      (   demo/cubed.asm):00015         ;   Each frame is as cube.asm's, except that after working out which faces
                      (   demo/cubed.asm):00016         ;   can be seen: FILLS fills the visible faces white, then in CLEAR mode
                      (   demo/cubed.asm):00017         ;   (so they come out black) PIPS cuts out each face's spots and EDGES
                      (   demo/cubed.asm):00018         ;   draws the edges, which keeps neighbouring white faces distinct.
                      (   demo/cubed.asm):00019         ;
                      (   demo/cubed.asm):00020         ;   Spots. Each spot's centre is a point on the cube's surface: on the +x
                      (   demo/cubed.asm):00021         ;   face, for example, a corner spot is at (S, S/2, -S/2). The rotated
                      (   demo/cubed.asm):00022         ;   position of any point is a sum of the per-axis terms TX/TY/TZ scaled by
                      (   demo/cubed.asm):00023         ;   the point's coordinates, and here those are only S, S/2, 0, -S/2 and
                      (   demo/cubed.asm):00024         ;   -S - so a spot's rotated position needs only the terms, the terms
                      (   demo/cubed.asm):00025         ;   halved (HX/HY/HZ), and additions. It is then projected exactly like a
                      (   demo/cubed.asm):00026         ;   corner, so spots sit correctly in perspective. Each spot is drawn as a
                      (   demo/cubed.asm):00027         ;   small square of clipped plots, 1, 2 or 3 pixels across depending on
                      (   demo/cubed.asm):00028         ;   the zoom.
                      (   demo/cubed.asm):00029         ;
                      (   demo/cubed.asm):00030         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      (   demo/cubed.asm):00031         ; ===========================================================================
                      (   demo/cubed.asm):00032                         INCLUDE "cube_defs.inc"
                      (    cube_defs.inc):00001         ; ===========================================================================
                      (    cube_defs.inc):00002         ; cube_defs.inc - settings and variables shared by the cube demos
                      (    cube_defs.inc):00003         ;   (cube.asm, cubep.asm, cubed.asm). Included at the top of each.
                      (    cube_defs.inc):00004         ; ===========================================================================
                      (    cube_defs.inc):00005         
                      (    cube_defs.inc):00006         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00007         ; Library entry points (see tgl_api.inc)
                      (    cube_defs.inc):00008         ; ---------------------------------------------------------------------------
     1000             (    cube_defs.inc):00009         TGL_BASE        EQU     $1000
                      (    cube_defs.inc):00010                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
     1039             (      tgl_api.inc):00028         TGL_COLOUR      EQU     TGL_BASE+57     ; row colour: A,B = first,last row, X = colour
     103C             (      tgl_api.inc):00029         TGL_PACE        EQU     TGL_BASE+60     ; steady frame rate: A = 50Hz ticks (1-3)
     103F             (      tgl_api.inc):00030         TGL_POLYF       EQU     TGL_BASE+63     ; filled convex polygon: X -> n, x0,y0, ...
     1042             (      tgl_api.inc):00031         TGL_SETPAT      EQU     TGL_BASE+66     ; fill pattern: A = 0-15 (2x2 pixels)
                      (      tgl_api.inc):00032         
     03C0             (      tgl_api.inc):00033         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00034         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00035         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00036         TGL_MODE_XOR    EQU     2
                      (      tgl_api.inc):00037         
                      (      tgl_api.inc):00038         ; Colours for TGL_COLOUR
     0001             (      tgl_api.inc):00039         TGL_RED         EQU     1
     0002             (      tgl_api.inc):00040         TGL_GREEN       EQU     2
     0003             (      tgl_api.inc):00041         TGL_YELLOW      EQU     3
     0004             (      tgl_api.inc):00042         TGL_BLUE        EQU     4
     0005             (      tgl_api.inc):00043         TGL_MAGENTA     EQU     5
     0006             (      tgl_api.inc):00044         TGL_CYAN        EQU     6
     0007             (      tgl_api.inc):00045         TGL_WHITE       EQU     7
                      (      tgl_api.inc):00046         
                      (      tgl_api.inc):00047         ; Fill patterns for TGL_SETPAT: a 2x2 block of pixels repeated across the
                      (      tgl_api.inc):00048         ; screen. Bit 0: even x, even y; bit 1: odd x, even y; bit 2: even x,
                      (      tgl_api.inc):00049         ; odd y; bit 3: odd x, odd y.
     0000             (      tgl_api.inc):00050         TGL_PAT_EMPTY   EQU     0
     0001             (      tgl_api.inc):00051         TGL_PAT_25      EQU     %0001           ; one pixel in four
     0009             (      tgl_api.inc):00052         TGL_PAT_50      EQU     %1001           ; checkerboard
     000B             (      tgl_api.inc):00053         TGL_PAT_75      EQU     %1011           ; three pixels in four
     000F             (      tgl_api.inc):00054         TGL_PAT_SOLID   EQU     %1111
     0003             (      tgl_api.inc):00055         TGL_PAT_HLINES  EQU     %0011           ; horizontal stripes
     0005             (      tgl_api.inc):00056         TGL_PAT_VLINES  EQU     %0101           ; vertical stripes
                      (    cube_defs.inc):00011         
                      (    cube_defs.inc):00012         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00013         ; Memory
                      (    cube_defs.inc):00014         ; ---------------------------------------------------------------------------
     3000             (    cube_defs.inc):00015         BUFFER          EQU     $3000           ; off-screen buffer (960 bytes)
     0200             (    cube_defs.inc):00016         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    cube_defs.inc):00017         
                      (    cube_defs.inc):00018         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00019         ; Settings you can change
                      (    cube_defs.inc):00020         ; ---------------------------------------------------------------------------
     0015             (    cube_defs.inc):00021         SIZE_MID        EQU     21              ; middle of the zoom range; the half
                      (    cube_defs.inc):00022                                                 ;  edge length pulses 5..36 around it
     0027             (    cube_defs.inc):00023         CX              EQU     39              ; screen position of the cube's centre
     0024             (    cube_defs.inc):00024         CY              EQU     36
     0002             (    cube_defs.inc):00025         STEP_A          EQU     2               ; rotation speed about x (per frame,
     0003             (    cube_defs.inc):00026         STEP_B          EQU     3               ;  and about y; 256 = a full turn)
     0001             (    cube_defs.inc):00027         STEP_Z          EQU     1               ; zoom speed (256 steps per in-and-out)
                      (    cube_defs.inc):00028         
                      (    cube_defs.inc):00029         ; ---------------------------------------------------------------------------
                      (    cube_defs.inc):00030         ; Variables, in page zero so they can use fast direct addressing.
                      (    cube_defs.inc):00031         ; The library's own workspace is $00-$7F, so these start at $80.
                      (    cube_defs.inc):00032         ; ---------------------------------------------------------------------------
     0080             (    cube_defs.inc):00033         ANG_A           EQU     $80             ; rotation angle about x (0-255)
     0081             (    cube_defs.inc):00034         ANG_B           EQU     $81             ; rotation angle about y (0-255)
     0082             (    cube_defs.inc):00035         SA              EQU     $82             ; sin(ANG_A)   (127 = 1.0)
     0083             (    cube_defs.inc):00036         CA              EQU     $83             ; cos(ANG_A)
     0084             (    cube_defs.inc):00037         SB              EQU     $84             ; sin(ANG_B)
     0085             (    cube_defs.inc):00038         CB              EQU     $85             ; cos(ANG_B)
     0086             (    cube_defs.inc):00039         TX              EQU     $86             ; 3 bytes: terms for rotated x
     0089             (    cube_defs.inc):00040         TY              EQU     $89             ; 3 bytes: terms for rotated y
     008C             (    cube_defs.inc):00041         TZ              EQU     $8C             ; 3 bytes: terms for rotated z
     008F             (    cube_defs.inc):00042         VI              EQU     $8F             ; corner number being worked on (0-7)
     0090             (    cube_defs.inc):00043         VX              EQU     $90             ; that corner's rotated x
     0091             (    cube_defs.inc):00044         ZI              EQU     $91             ; its depth, as an index into RXTAB/RYTAB
     0092             (    cube_defs.inc):00045         EC              EQU     $92             ; edges left to draw
     0093             (    cube_defs.inc):00046         FRAMES          EQU     $93             ; frame counter (test builds only)
     0094             (    cube_defs.inc):00047         SIZE            EQU     $94             ; this frame's half edge length (S)
     0095             (    cube_defs.inc):00048         ZOOM            EQU     $95             ; zoom phase (0-255, like an angle)
     0096             (    cube_defs.inc):00049         EX              EQU     $96             ; the viewer's eye, in cube
     0097             (    cube_defs.inc):00050         EY              EQU     $97             ;  coordinates
     0098             (    cube_defs.inc):00051         EZ              EQU     $98
     0099             (    cube_defs.inc):00052         WIRE            EQU     $99             ; 0: skip hidden edges, else draw all
     00A0             (    cube_defs.inc):00053         PX              EQU     $A0             ; 8 bytes: screen x of corners 0-7
     00A8             (    cube_defs.inc):00054         PY              EQU     $A8             ; 8 bytes: screen y of corners 0-7.
                      (    cube_defs.inc):00055                                                 ;  PY is exactly PX+8, so if X points
                      (    cube_defs.inc):00056                                                 ;  at a corner's PX entry, its PY is
                      (    cube_defs.inc):00057                                                 ;  at 8,X
     00B0             (    cube_defs.inc):00058         VIS             EQU     $B0             ; 6 bytes: per face, $FF if visible.
                      (    cube_defs.inc):00059                                                 ;  Faces: 0 +x, 1 -x, 2 +y, 3 -y,
                      (    cube_defs.inc):00060                                                 ;  4 +z, 5 -z
     00B8             (    cube_defs.inc):00061         POLY            EQU     $B8             ; 9 bytes: corner list for TGL_POLYF
                      (    cube_defs.inc):00062                                                 ;  (count, then 4 x,y pairs)
     00C2             (    cube_defs.inc):00063         FACEN           EQU     $C2             ; face being filled or spotted
                      (    cube_defs.inc):00064         ; (the die demo uses $C6-$DB for its own variables)
                      (   demo/cubed.asm):00033         
     0003             (   demo/cubed.asm):00034         PACE_TICKS      EQU     3               ; frame length in 50Hz ticks: 3 =
                      (   demo/cubed.asm):00035                                                 ;  about 17 frames per second
                      (   demo/cubed.asm):00036         
                      (   demo/cubed.asm):00037         ; Variables for the spots (cube_defs.inc uses $80-$C2)
     00C6             (   demo/cubed.asm):00038         HX              EQU     TX+$40          ; the terms halved: HX = TX / 2 etc.
     00C9             (   demo/cubed.asm):00039         HY              EQU     TY+$40          ;  ($C6-$CE; kept $40 above the terms
     00CC             (   demo/cubed.asm):00040         HZ              EQU     TZ+$40          ;  so one index register reaches both)
     00D0             (   demo/cubed.asm):00041         PA              EQU     $D0             ; spotting a face: its axis (0-2) ...
     00D1             (   demo/cubed.asm):00042         PB              EQU     $D1             ;  ... and its two in-face axes
     00D2             (   demo/cubed.asm):00043         PC              EQU     $D2
     00D3             (   demo/cubed.asm):00044         PS              EQU     $D3             ;  +1 for the + face, -1 for the -
     00D4             (   demo/cubed.asm):00045         PPB             EQU     $D4             ; spot position along PB: -1, 0, +1
     00D5             (   demo/cubed.asm):00046         PPC             EQU     $D5             ;  ... and along PC (in halves of S)
     00D6             (   demo/cubed.asm):00047         PIPN            EQU     $D6             ; spots left on this face
     00D7             (   demo/cubed.asm):00048         PIPP            EQU     $D7             ; 2  pointer to the next spot
     00D9             (   demo/cubed.asm):00049         PIPSZ           EQU     $D9             ; spot size in pixels (1-3)
     00DA             (   demo/cubed.asm):00050         PCX             EQU     $DA             ; spot centre on screen
     00DB             (   demo/cubed.asm):00051         PCY             EQU     $DB
                      (   demo/cubed.asm):00052         
                      (   demo/cubed.asm):00053                         ORG     $2000
                      (   demo/cubed.asm):00054         
                      (   demo/cubed.asm):00055         ; ---------------------------------------------------------------------------
                      (   demo/cubed.asm):00056         ; Set up
                      (   demo/cubed.asm):00057         ; ---------------------------------------------------------------------------
2000 10CE0200         (   demo/cubed.asm):00058         START           LDS     #STACK_TOP
2004 4F               (   demo/cubed.asm):00059                         CLRA                    ; DP = $00: the library (and our
2005 1F8B             (   demo/cubed.asm):00060                         TFR     A,DP            ;  variables) use direct addressing
     00               (   demo/cubed.asm):00061                         SETDP   $00             ;  in page zero
2007 1CEF             (   demo/cubed.asm):00062                         ANDCC   #$EF            ; enable IRQs: the keyboard is read
                      (   demo/cubed.asm):00063                                                 ;  under interrupt
2009 BD1000           (   demo/cubed.asm):00064                         JSR     TGL_INIT        ; reset CRTC start, hide cursor
200C 8E3000           (   demo/cubed.asm):00065                         LDX     #BUFFER         ; draw into our buffer at $3000
200F BD1003           (   demo/cubed.asm):00066                         JSR     TGL_SETBUF
2012 0F80             (   demo/cubed.asm):00067                         CLR     <ANG_A          ; start square-on, mid zoom
2014 0F81             (   demo/cubed.asm):00068                         CLR     <ANG_B
2016 0F93             (   demo/cubed.asm):00069                         CLR     <FRAMES
2018 0F95             (   demo/cubed.asm):00070                         CLR     <ZOOM
201A 0F99             (   demo/cubed.asm):00071                         CLR     <WIRE           ; edges of hidden faces are skipped
201C 4F               (   demo/cubed.asm):00072                         CLRA                    ; status row title
201D 8E21D0           (   demo/cubed.asm):00073                         LDX     #TITLE
2020 BD1030           (   demo/cubed.asm):00074                         JSR     TGL_TEXT
                      (   demo/cubed.asm):00075         
                      (   demo/cubed.asm):00076         ; ---------------------------------------------------------------------------
                      (   demo/cubed.asm):00077         ; Main loop: one pass per frame
                      (   demo/cubed.asm):00078         ; ---------------------------------------------------------------------------
2023 BD1006           (   demo/cubed.asm):00079         FRAME           JSR     TGL_CLS
2026 8600             (   demo/cubed.asm):00080                         LDA     #TGL_MODE_SET   ; faces in white ...
2028 BD1009           (   demo/cubed.asm):00081                         JSR     TGL_SETMODE
202B 17021B           (   demo/cubed.asm):00082                         LBSR    ZOOMSZ
202E 170229           (   demo/cubed.asm):00083                         LBSR    MATRIX
2031 17030B           (   demo/cubed.asm):00084                         LBSR    CORNERS
2034 1702C3           (   demo/cubed.asm):00085                         LBSR    FACES
2037 1701A9           (   demo/cubed.asm):00086                         LBSR    FILLS           ; fill the visible faces white
203A 8601             (   demo/cubed.asm):00087                         LDA     #TGL_MODE_CLEAR ; ... spots and edges in black
203C BD1009           (   demo/cubed.asm):00088                         JSR     TGL_SETMODE
203F 170029           (   demo/cubed.asm):00089                         LBSR    PIPS            ; cut out the spots
2042 170374           (   demo/cubed.asm):00090                         LBSR    EDGES           ; and the edges
2045 8603             (   demo/cubed.asm):00091                         LDA     #PACE_TICKS
2047 BD103C           (   demo/cubed.asm):00092                         JSR     TGL_PACE
204A BD1012           (   demo/cubed.asm):00093                         JSR     TGL_BLIT
                      (   demo/cubed.asm):00094         
                      (   demo/cubed.asm):00095         ; Advance the angles and zoom phase. Being bytes, they wrap from 255 back
                      (   demo/cubed.asm):00096         ; to 0 by themselves, which is exactly one full turn.
204D 9680             (   demo/cubed.asm):00097                         LDA     <ANG_A
204F 8B02             (   demo/cubed.asm):00098                         ADDA    #STEP_A
2051 9780             (   demo/cubed.asm):00099                         STA     <ANG_A
2053 9681             (   demo/cubed.asm):00100                         LDA     <ANG_B
2055 8B03             (   demo/cubed.asm):00101                         ADDA    #STEP_B
2057 9781             (   demo/cubed.asm):00102                         STA     <ANG_B
2059 9695             (   demo/cubed.asm):00103                         LDA     <ZOOM
205B 8B01             (   demo/cubed.asm):00104                         ADDA    #STEP_Z
205D 9795             (   demo/cubed.asm):00105                         STA     <ZOOM
                      (   demo/cubed.asm):00106         
205F BD101E           (   demo/cubed.asm):00107                         JSR     TGL_INKEY       ; any key exits
2062 1026EFBB         (   demo/cubed.asm):00108                         LBNE    TGL_EXIT
                      (   demo/cubed.asm):00109         ; Test builds stop after TESTFRAMES frames so the emulator can inspect
                      (   demo/cubed.asm):00110         ; the result. Normal builds skip this.
                      (   demo/cubed.asm):00111                         IFDEF   TESTFRAMES
                      (   demo/cubed.asm):00112                         INC     <FRAMES
                      (   demo/cubed.asm):00113                         LDA     <FRAMES
                      (   demo/cubed.asm):00114                         CMPA    #TESTFRAMES
                      (   demo/cubed.asm):00115                         BEQ     DONE
                      (   demo/cubed.asm):00116                         ENDC
2066 16FFBA           (   demo/cubed.asm):00117                         LBRA    FRAME
2069 20FE             (   demo/cubed.asm):00118         DONE            BRA     DONE
                      (   demo/cubed.asm):00119         
                      (   demo/cubed.asm):00120         ; ---------------------------------------------------------------------------
                      (   demo/cubed.asm):00121         ; PIPS - cut out the spots on each visible face (plot mode is CLEAR)
                      (   demo/cubed.asm):00122         ; ---------------------------------------------------------------------------
206B 8E0086           (   demo/cubed.asm):00123         PIPS            LDX     #TX             ; halve the nine terms: HX = TX/2 ...
206E C609             (   demo/cubed.asm):00124                         LDB     #9
2070 A684             (   demo/cubed.asm):00125         PP_HALF         LDA     ,X
2072 47               (   demo/cubed.asm):00126                         ASRA                    ;  (ASR keeps the sign)
2073 A78840           (   demo/cubed.asm):00127                         STA     $40,X
2076 3001             (   demo/cubed.asm):00128                         LEAX    1,X
2078 5A               (   demo/cubed.asm):00129                         DECB
2079 26F5             (   demo/cubed.asm):00130                         BNE     PP_HALF
207B 8601             (   demo/cubed.asm):00131                         LDA     #1              ; spot size from the zoom: 1, 2 or 3
207D D694             (   demo/cubed.asm):00132                         LDB     <SIZE           ;  pixels across
207F C10E             (   demo/cubed.asm):00133                         CMPB    #14
2081 2506             (   demo/cubed.asm):00134                         BLO     PP_SZ
2083 4C               (   demo/cubed.asm):00135                         INCA
2084 C11A             (   demo/cubed.asm):00136                         CMPB    #26
2086 2501             (   demo/cubed.asm):00137                         BLO     PP_SZ
2088 4C               (   demo/cubed.asm):00138                         INCA
2089 97D9             (   demo/cubed.asm):00139         PP_SZ           STA     <PIPSZ
208B 318D00F3         (   demo/cubed.asm):00140                         LEAY    PIPTAB,PCR      ; Y -> this face's spots
208F 0FC2             (   demo/cubed.asm):00141                         CLR     <FACEN
2091 8E00B0           (   demo/cubed.asm):00142         PP_FACE         LDX     #VIS            ; skip faces that can't be seen
2094 D6C2             (   demo/cubed.asm):00143                         LDB     <FACEN
2096 3A               (   demo/cubed.asm):00144                         ABX
2097 6D84             (   demo/cubed.asm):00145                         TST     ,X
2099 272A             (   demo/cubed.asm):00146                         BEQ     PP_NEXTF
209B 308D00CB         (   demo/cubed.asm):00147                         LEAX    FACEAX,PCR      ; the face's axes and sign
209F D6C2             (   demo/cubed.asm):00148                         LDB     <FACEN
20A1 58               (   demo/cubed.asm):00149                         ASLB
20A2 58               (   demo/cubed.asm):00150                         ASLB
20A3 3A               (   demo/cubed.asm):00151                         ABX
