                      (   demo/cubed.asm):00297                         INCLUDE "cube_fill.asm"
                      (    cube_fill.asm):00001         ; ===========================================================================
                      (    cube_fill.asm):00002         ; cube_fill.asm - fill the cube's visible faces (used by cubep.asm and
                      (    cube_fill.asm):00003         ;   cubed.asm). FILLS sets each face's pattern from the demo's FACEPAT
                      (    cube_fill.asm):00004         ;   table, so the demo must provide one.
                      (    cube_fill.asm):00005         ; ===========================================================================
                      (    cube_fill.asm):00006         
                      (    cube_fill.asm):00007         ; ---------------------------------------------------------------------------
                      (    cube_fill.asm):00008         ; FILLS - fill each visible face with its pattern
                      (    cube_fill.asm):00009         ;   For each visible face: select its pattern from the demo's FACEPAT
                      (    cube_fill.asm):00010         ;   table, copy its four corners' screen positions into the POLY corner
                      (    cube_fill.asm):00011         ;   list, and fill it with TGL_POLYF. FACETAB gives each face's corners in
                      (    cube_fill.asm):00012         ;   order round the face. Visible faces never overlap on a convex shape,
                      (    cube_fill.asm):00013         ;   so they can be filled in any order.
                      (    cube_fill.asm):00014         ; ---------------------------------------------------------------------------
21E3 318D004A         (    cube_fill.asm):00015         FILLS           LEAY    FACETAB,PCR
21E7 0FC2             (    cube_fill.asm):00016                         CLR     <FACEN
21E9 8E00B0           (    cube_fill.asm):00017         FL_LOOP         LDX     #VIS            ; skip faces that can't be seen
21EC D6C2             (    cube_fill.asm):00018                         LDB     <FACEN
21EE 3A               (    cube_fill.asm):00019                         ABX
21EF 6D84             (    cube_fill.asm):00020                         TST     ,X
21F1 2728             (    cube_fill.asm):00021                         BEQ     FL_NEXT
21F3 308DFF6D         (    cube_fill.asm):00022                         LEAX    FACEPAT,PCR     ; this face's pattern
21F7 D6C2             (    cube_fill.asm):00023                         LDB     <FACEN
21F9 A685             (    cube_fill.asm):00024                         LDA     B,X
21FB BD1042           (    cube_fill.asm):00025                         JSR     TGL_SETPAT
21FE 8604             (    cube_fill.asm):00026                         LDA     #4              ; corner list: 4 corners ...
2200 97B8             (    cube_fill.asm):00027                         STA     <POLY
2202 CE00B9           (    cube_fill.asm):00028                         LDU     #POLY+1
2205 E6A4             (    cube_fill.asm):00029                         LDB     ,Y              ; ... each copied from PX, PY
2207 8D1D             (    cube_fill.asm):00030                         BSR     FL_CORNER
2209 E621             (    cube_fill.asm):00031                         LDB     1,Y
220B 8D19             (    cube_fill.asm):00032                         BSR     FL_CORNER
220D E622             (    cube_fill.asm):00033                         LDB     2,Y
220F 8D15             (    cube_fill.asm):00034                         BSR     FL_CORNER
2211 E623             (    cube_fill.asm):00035                         LDB     3,Y
2213 8D11             (    cube_fill.asm):00036                         BSR     FL_CORNER
2215 8E00B8           (    cube_fill.asm):00037                         LDX     #POLY
2218 BD103F           (    cube_fill.asm):00038                         JSR     TGL_POLYF
221B 3124             (    cube_fill.asm):00039         FL_NEXT         LEAY    4,Y             ; next face
221D 0CC2             (    cube_fill.asm):00040                         INC     <FACEN
221F 96C2             (    cube_fill.asm):00041                         LDA     <FACEN
2221 8106             (    cube_fill.asm):00042                         CMPA    #6
2223 25C4             (    cube_fill.asm):00043                         BLO     FL_LOOP
2225 39               (    cube_fill.asm):00044                         RTS
                      (    cube_fill.asm):00045         
                      (    cube_fill.asm):00046         ; FL_CORNER - Entry: B = corner number, U -> next slot in POLY.
                      (    cube_fill.asm):00047         ;   Stores that corner's screen x, y; U += 2.
2226 8E00A0           (    cube_fill.asm):00048         FL_CORNER       LDX     #PX
2229 3A               (    cube_fill.asm):00049                         ABX
222A A684             (    cube_fill.asm):00050                         LDA     ,X              ; x
222C E608             (    cube_fill.asm):00051                         LDB     8,X             ; y (PY = PX + 8)
222E EDC1             (    cube_fill.asm):00052                         STD     ,U++
2230 39               (    cube_fill.asm):00053                         RTS
                      (    cube_fill.asm):00054         
                      (    cube_fill.asm):00055         ; The six faces' corners, in order round each face (for TGL_POLYF):
                      (    cube_fill.asm):00056         ; the four corners sharing the face's bit, going round.
2231 01030705         (    cube_fill.asm):00057         FACETAB         FCB     1,3,7,5                 ; +x (bit 0 set)
2235 00020604         (    cube_fill.asm):00058                         FCB     0,2,6,4                 ; -x (bit 0 clear)
2239 02030706         (    cube_fill.asm):00059                         FCB     2,3,7,6                 ; +y (bit 1 set)
223D 00010504         (    cube_fill.asm):00060                         FCB     0,1,5,4                 ; -y (bit 1 clear)
2241 04050706         (    cube_fill.asm):00061                         FCB     4,5,7,6                 ; +z (bit 2 set)
2245 00010302         (    cube_fill.asm):00062                         FCB     0,1,3,2                 ; -z (bit 2 clear)
                      (    cube_fill.asm):00063         
                      (   demo/cubed.asm):00298                         INCLUDE "cube_core.asm"
                      (    cube_core.asm):00001         ; ===========================================================================
                      (    cube_core.asm):00002         ; cube_core.asm - the routines and tables shared by the cube demos
                      (    cube_core.asm):00003         ;   (cube.asm, cubep.asm, cubed.asm): zoom, rotation, projection, which
                      (    cube_core.asm):00004         ;   faces can be seen, and the edges. Included after each demo's own code.
                      (    cube_core.asm):00005         ;
                      (    cube_core.asm):00006         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00007         ; The maths, and how it is kept cheap on an 8-bit CPU
                      (    cube_core.asm):00008         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00009         ;
                      (    cube_core.asm):00010         ;   Fixed point. Sines and cosines are stored as signed bytes where 127
                      (    cube_core.asm):00011         ;   stands for 1.0 (so 64 is about 0.5, -127 is -1.0). Multiplying two such
                      (    cube_core.asm):00012         ;   numbers gives a result 128 times too big, so products are divided by
                      (    cube_core.asm):00013         ;   128 afterwards (see MULS7).
                      (    cube_core.asm):00014         ;
                      (    cube_core.asm):00015         ;   Angles. A full circle is 256 steps instead of 360 degrees, so an angle
                      (    cube_core.asm):00016         ;   fits in one byte and wraps round by itself when it overflows. A quarter
                      (    cube_core.asm):00017         ;   turn is 64 steps, which gives cos(a) = sin(a + 64): one sine table
                      (    cube_core.asm):00018         ;   serves for both.
                      (    cube_core.asm):00019         ;
                      (    cube_core.asm):00020         ;   Rotation. The cube is centred on the origin, so its corners are every
                      (    cube_core.asm):00021         ;   combination of (+S or -S, +S or -S, +S or -S), where S is half the edge
                      (    cube_core.asm):00022         ;   length. Rotating a point means multiplying it by a 3x3 matrix:
                      (    cube_core.asm):00023         ;
                      (    cube_core.asm):00024         ;       rotated x = m00*x + m01*y + m02*z      (and similarly for y, z)
                      (    cube_core.asm):00025         ;
                      (    cube_core.asm):00026         ;   With every coordinate being +S or -S, each product is just +/-(m * S).
                      (    cube_core.asm):00027         ;   So once per frame we work out the nine values m*S (the "terms" TX, TY,
                      (    cube_core.asm):00028         ;   TZ), and then every rotated corner coordinate is three of those terms
                      (    cube_core.asm):00029         ;   added or subtracted according to the corner's signs. That's 8 multiplies
                      (    cube_core.asm):00030         ;   per frame for the whole cube, instead of 9 per corner.
                      (    cube_core.asm):00031         ;
                      (    cube_core.asm):00032         ;   Perspective. Further-away points should be drawn closer to the centre:
                      (    cube_core.asm):00033         ;
                      (    cube_core.asm):00034         ;       screen x = centre + x * F / (distance + z)
                      (    cube_core.asm):00035         ;
                      (    cube_core.asm):00036         ;   Dividing is slow on a 6809, so the value F / (distance + z), suitably
                      (    cube_core.asm):00037         ;   scaled, is precomputed for every possible z and stored in a table
                      (    cube_core.asm):00038         ;   (RXTAB, RYTAB). Projecting is then one table lookup and one MUL.
                      (    cube_core.asm):00039         ;   The x table uses a smaller F than the y table because teletext pixels
                      (    cube_core.asm):00040         ;   are wider than they are tall; this keeps the cube looking square.
                      (    cube_core.asm):00041         ;
                      (    cube_core.asm):00042         ;   Hidden faces. A face is visible when it points back towards the viewer.
                      (    cube_core.asm):00043         ;   Rather than rotate the faces, FACES works out where the viewer's eye
                      (    cube_core.asm):00044         ;   is in the cube's own coordinates (as the ship demo does). The cube's
                      (    cube_core.asm):00045         ;   faces are the six sides of a box, so the test is then trivial: the +x
                      (    cube_core.asm):00046         ;   face is visible when the eye's x is beyond +S, the -x face when it is
                      (    cube_core.asm):00047         ;   below -S, and likewise for y and z. The eye sits 100 units in front of
                      (    cube_core.asm):00048         ;   the viewer's screen, the distance the projection tables assume; in
                      (    cube_core.asm):00049         ;   cube coordinates it is -100 * (z row of the rotation matrix).
                      (    cube_core.asm):00050         ;   Each edge borders two faces and is drawn if either is visible.
                      (    cube_core.asm):00051         ;
                      (    cube_core.asm):00052         ;   Corner numbering. Corners are numbered 0-7. Bit 0 of the number says
                      (    cube_core.asm):00053         ;   whether the corner's x is +S (bit set) or -S (bit clear); bit 1 does
                      (    cube_core.asm):00054         ;   the same for y and bit 2 for z. Two corners are joined by an edge when
                      (    cube_core.asm):00055         ;   their numbers differ in exactly one bit (see EDGETAB).
                      (    cube_core.asm):00056         ; ===========================================================================
                      (    cube_core.asm):00057         
                      (    cube_core.asm):00058         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00059         ; ZOOMSZ - set SIZE from the zoom phase
                      (    cube_core.asm):00060         ;
                      (    cube_core.asm):00061         ;   SIZE = SIZE_MID + sin(ZOOM)/8, which swings smoothly between 5 and 36
                      (    cube_core.asm):00062         ;   as ZOOM goes round. From about 26 upwards the cube overhangs the screen
                      (    cube_core.asm):00063         ;   and TGL_LINEC clips it. Don't go above 36: beyond that the depth no
                      (    cube_core.asm):00064         ;   longer fits the projection tables (-64..63), and projected points no
                      (    cube_core.asm):00065         ;   longer fit the signed -128..127 that TGL_LINEC accepts.
                      (    cube_core.asm):00066         ; ---------------------------------------------------------------------------
2249 308D01DC         (    cube_core.asm):00067         ZOOMSZ          LEAX    SINTAB,PCR      ; X -> sine table
224D D695             (    cube_core.asm):00068                         LDB     <ZOOM           ; X -> sin(ZOOM). ABX adds B as an
224F 3A               (    cube_core.asm):00069                         ABX                     ;  UNSIGNED byte (0-255). "LDA B,X"
                      (    cube_core.asm):00070                                                 ;  would treat B as signed and read
                      (    cube_core.asm):00071                                                 ;  before the table for B >= 128
2250 A684             (    cube_core.asm):00072                         LDA     ,X              ; A = sin(ZOOM), -127..127
2252 47               (    cube_core.asm):00073                         ASRA                    ; divide by 8. ASR keeps the sign bit,
2253 47               (    cube_core.asm):00074                         ASRA                    ;  so negative numbers stay negative:
2254 47               (    cube_core.asm):00075                         ASRA                    ;  -127..127 becomes -16..15
2255 8B15             (    cube_core.asm):00076                         ADDA    #SIZE_MID       ; 5..36
2257 9794             (    cube_core.asm):00077                         STA     <SIZE
2259 39               (    cube_core.asm):00078                         RTS
                      (    cube_core.asm):00079         
                      (    cube_core.asm):00080         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00081         ; MATRIX - work out this frame's nine terms
                      (    cube_core.asm):00082         ;
                      (    cube_core.asm):00083         ;   The cube is turned first about the y axis (angle B), then about the x
                      (    cube_core.asm):00084         ;   axis (angle A). Multiplying those two rotations together gives this
                      (    cube_core.asm):00085         ;   matrix (each entry scaled so 127 = 1.0):
                      (    cube_core.asm):00086         ;
                      (    cube_core.asm):00087         ;               x part      y part     z part
                      (    cube_core.asm):00088         ;     row x: [  cb,         0,         sb       ]
                      (    cube_core.asm):00089         ;     row y: [  sb*sa,      ca,       -cb*sa    ]
                      (    cube_core.asm):00090         ;     row z: [ -sb*ca,      sa,        cb*ca    ]
                      (    cube_core.asm):00091         ;
                      (    cube_core.asm):00092         ;   Each entry is then multiplied by SIZE to give the terms, e.g.
                      (    cube_core.asm):00093         ;   TX = [ cb*S, 0, sb*S ]. Two-factor entries like sb*sa need two
                      (    cube_core.asm):00094         ;   multiplies: first sb*sa, then that result * S.
                      (    cube_core.asm):00095         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00096         
                      (    cube_core.asm):00097         ; Look up the four sines and cosines. Each lookup: X -> table, add the
                      (    cube_core.asm):00098         ; angle (unsigned, via ABX), read the byte. cos uses angle + 64.
225A 308D01CB         (    cube_core.asm):00099         MATRIX          LEAX    SINTAB,PCR      ; SA = sin(ANG_A)
225E D680             (    cube_core.asm):00100                         LDB     <ANG_A
2260 3A               (    cube_core.asm):00101                         ABX
2261 A684             (    cube_core.asm):00102                         LDA     ,X
2263 9782             (    cube_core.asm):00103                         STA     <SA
2265 308D01C0         (    cube_core.asm):00104                         LEAX    SINTAB,PCR      ; CA = cos(ANG_A) = sin(ANG_A + 64)
2269 D680             (    cube_core.asm):00105                         LDB     <ANG_A
226B CB40             (    cube_core.asm):00106                         ADDB    #64             ; (wraps round past 255 correctly)
226D 3A               (    cube_core.asm):00107                         ABX
226E A684             (    cube_core.asm):00108                         LDA     ,X
2270 9783             (    cube_core.asm):00109                         STA     <CA
2272 308D01B3         (    cube_core.asm):00110                         LEAX    SINTAB,PCR      ; SB = sin(ANG_B)
2276 D681             (    cube_core.asm):00111                         LDB     <ANG_B
2278 3A               (    cube_core.asm):00112                         ABX
2279 A684             (    cube_core.asm):00113                         LDA     ,X
227B 9784             (    cube_core.asm):00114                         STA     <SB
227D 308D01A8         (    cube_core.asm):00115                         LEAX    SINTAB,PCR      ; CB = cos(ANG_B)
2281 D681             (    cube_core.asm):00116                         LDB     <ANG_B
2283 CB40             (    cube_core.asm):00117                         ADDB    #64
2285 3A               (    cube_core.asm):00118                         ABX
2286 A684             (    cube_core.asm):00119                         LDA     ,X
2288 9785             (    cube_core.asm):00120                         STA     <CB
                      (    cube_core.asm):00121         
                      (    cube_core.asm):00122         ; Row x: TX = S * [ cb, 0, sb ]
228A 9685             (    cube_core.asm):00123                         LDA     <CB             ; TX+0 = cb * S
228C D694             (    cube_core.asm):00124                         LDB     <SIZE
228E 8D4F             (    cube_core.asm):00125                         BSR     MULS7
2290 9786             (    cube_core.asm):00126                         STA     <TX
2292 0F87             (    cube_core.asm):00127                         CLR     <TX+1           ; TX+1 = 0 (this entry is always 0)
2294 9684             (    cube_core.asm):00128                         LDA     <SB             ; TX+2 = sb * S
2296 D694             (    cube_core.asm):00129                         LDB     <SIZE
2298 8D45             (    cube_core.asm):00130                         BSR     MULS7
229A 9788             (    cube_core.asm):00131                         STA     <TX+2
                      (    cube_core.asm):00132         
                      (    cube_core.asm):00133         ; Row y: TY = S * [ sb*sa, ca, -cb*sa ]
229C 9684             (    cube_core.asm):00134                         LDA     <SB             ; TY+0 = (sb * sa) * S
229E D682             (    cube_core.asm):00135                         LDB     <SA
22A0 8D3D             (    cube_core.asm):00136                         BSR     MULS7           ;  A = sb * sa
22A2 D694             (    cube_core.asm):00137                         LDB     <SIZE
22A4 8D39             (    cube_core.asm):00138                         BSR     MULS7           ;  A = that * S
22A6 9789             (    cube_core.asm):00139                         STA     <TY
22A8 9683             (    cube_core.asm):00140                         LDA     <CA             ; TY+1 = ca * S
22AA D694             (    cube_core.asm):00141                         LDB     <SIZE
22AC 8D31             (    cube_core.asm):00142                         BSR     MULS7
22AE 978A             (    cube_core.asm):00143                         STA     <TY+1
22B0 9685             (    cube_core.asm):00144                         LDA     <CB             ; TY+2 = -(cb * sa) * S
22B2 D682             (    cube_core.asm):00145                         LDB     <SA
22B4 8D29             (    cube_core.asm):00146                         BSR     MULS7
22B6 40               (    cube_core.asm):00147                         NEGA
22B7 D694             (    cube_core.asm):00148                         LDB     <SIZE
22B9 8D24             (    cube_core.asm):00149                         BSR     MULS7
22BB 978B             (    cube_core.asm):00150                         STA     <TY+2
                      (    cube_core.asm):00151         
                      (    cube_core.asm):00152         ; Row z: TZ = S * [ -sb*ca, sa, cb*ca ]
22BD 9684             (    cube_core.asm):00153                         LDA     <SB             ; TZ+0 = -(sb * ca) * S
22BF D683             (    cube_core.asm):00154                         LDB     <CA
22C1 8D1C             (    cube_core.asm):00155                         BSR     MULS7
22C3 40               (    cube_core.asm):00156                         NEGA
22C4 D694             (    cube_core.asm):00157                         LDB     <SIZE
22C6 8D17             (    cube_core.asm):00158                         BSR     MULS7
22C8 978C             (    cube_core.asm):00159                         STA     <TZ
22CA 9682             (    cube_core.asm):00160                         LDA     <SA             ; TZ+1 = sa * S
22CC D694             (    cube_core.asm):00161                         LDB     <SIZE
22CE 8D0F             (    cube_core.asm):00162                         BSR     MULS7
22D0 978D             (    cube_core.asm):00163                         STA     <TZ+1
22D2 9685             (    cube_core.asm):00164                         LDA     <CB             ; TZ+2 = (cb * ca) * S
22D4 D683             (    cube_core.asm):00165                         LDB     <CA
22D6 8D07             (    cube_core.asm):00166                         BSR     MULS7
22D8 D694             (    cube_core.asm):00167                         LDB     <SIZE
22DA 8D03             (    cube_core.asm):00168                         BSR     MULS7
22DC 978E             (    cube_core.asm):00169                         STA     <TZ+2
22DE 39               (    cube_core.asm):00170                         RTS
                      (    cube_core.asm):00171         
                      (    cube_core.asm):00172         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00173         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    cube_core.asm):00174         ;   Entry: A, B signed (-127..127)
                      (    cube_core.asm):00175         ;   Exit:  A = result. B corrupted.
                      (    cube_core.asm):00176         ;
                      (    cube_core.asm):00177         ;   The 6809's MUL only does unsigned A * B -> D. So: remember the signs,
                      (    cube_core.asm):00178         ;   multiply the sizes (absolute values), then put the sign back.
                      (    cube_core.asm):00179         ;   The result's sign is negative when exactly one input is negative,
                      (    cube_core.asm):00180         ;   which is what the top bit of (A EOR B) tells us.
                      (    cube_core.asm):00181         ;
                      (    cube_core.asm):00182         ;   Dividing D by 128: shifting D left once (ASLB then ROLA, which carries
                      (    cube_core.asm):00183         ;   B's top bit into A) gives D * 2, and the high byte of D * 2 is D / 128.
                      (    cube_core.asm):00184         ;   So after the shift the answer is simply in A.
                      (    cube_core.asm):00185         ; ---------------------------------------------------------------------------
22DF 3406             (    cube_core.asm):00186         MULS7           PSHS    D               ; save the originals: 0,S = A, 1,S = B
22E1 4D               (    cube_core.asm):00187                         TSTA                    ; make A positive
22E2 2A01             (    cube_core.asm):00188                         BPL     MS_1
22E4 40               (    cube_core.asm):00189                         NEGA
22E5 5D               (    cube_core.asm):00190         MS_1            TSTB                    ; make B positive
22E6 2A01             (    cube_core.asm):00191                         BPL     MS_2
22E8 50               (    cube_core.asm):00192                         NEGB
22E9 3D               (    cube_core.asm):00193         MS_2            MUL                     ; D = |A| * |B|
22EA 58               (    cube_core.asm):00194                         ASLB                    ; D * 2 ...
22EB 49               (    cube_core.asm):00195                         ROLA                    ; ... so A = D / 128
22EC 3402             (    cube_core.asm):00196                         PSHS    A               ; keep the result. The originals are
                      (    cube_core.asm):00197                                                 ;  now at 1,S (A) and 2,S (B)
22EE A661             (    cube_core.asm):00198                         LDA     1,S             ; sign of result = top bit of A EOR B
22F0 A862             (    cube_core.asm):00199                         EORA    2,S             ;  (sets N flag)
22F2 3502             (    cube_core.asm):00200                         PULS    A               ; result back in A. PULS doesn't
                      (    cube_core.asm):00201                                                 ;  change the flags, so N survives
22F4 2A01             (    cube_core.asm):00202                         BPL     MS_3            ; positive: done
22F6 40               (    cube_core.asm):00203                         NEGA                    ; negative: negate the result
22F7 3262             (    cube_core.asm):00204         MS_3            LEAS    2,S             ; discard the saved originals
22F9 39               (    cube_core.asm):00205                         RTS
                      (    cube_core.asm):00206         
                      (    cube_core.asm):00207         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00208         ; FACES - which of the six faces point towards the viewer
                      (    cube_core.asm):00209         ;
                      (    cube_core.asm):00210         ;   The eye in cube coordinates is -100 * (z row of the rotation matrix),
                      (    cube_core.asm):00211         ;   using the unscaled matrix entries (127 = 1.0) from MATRIX:
                      (    cube_core.asm):00212         ;       z row = [ -sb*ca, sa, cb*ca ]
                      (    cube_core.asm):00213         ;   Multiplying by -101 and dividing by 128 (MULS7) gives -100 * row / 127.
                      (    cube_core.asm):00214         ;   Then, for each axis, the + face is visible if the eye is beyond +S and
                      (    cube_core.asm):00215         ;   the - face if it is beyond -S.
                      (    cube_core.asm):00216         ; ---------------------------------------------------------------------------
22FA 9684             (    cube_core.asm):00217         FACES           LDA     <SB             ; EX = -100 * (-sb*ca)
22FC D683             (    cube_core.asm):00218                         LDB     <CA
22FE 17FFDE           (    cube_core.asm):00219                         LBSR    MULS7
2301 40               (    cube_core.asm):00220                         NEGA
2302 C69B             (    cube_core.asm):00221                         LDB     #-101
2304 17FFD8           (    cube_core.asm):00222                         LBSR    MULS7
2307 9796             (    cube_core.asm):00223                         STA     <EX
2309 9682             (    cube_core.asm):00224                         LDA     <SA             ; EY = -100 * sa
230B C69B             (    cube_core.asm):00225                         LDB     #-101
230D 17FFCF           (    cube_core.asm):00226                         LBSR    MULS7
2310 9797             (    cube_core.asm):00227                         STA     <EY
2312 9685             (    cube_core.asm):00228                         LDA     <CB             ; EZ = -100 * (cb*ca)
2314 D683             (    cube_core.asm):00229                         LDB     <CA
2316 17FFC6           (    cube_core.asm):00230                         LBSR    MULS7
2319 C69B             (    cube_core.asm):00231                         LDB     #-101
231B 17FFC1           (    cube_core.asm):00232                         LBSR    MULS7
231E 9798             (    cube_core.asm):00233                         STA     <EZ
2320 CE00B0           (    cube_core.asm):00234                         LDU     #VIS            ; set VIS for the six faces
2323 9696             (    cube_core.asm):00235                         LDA     <EX
2325 8D06             (    cube_core.asm):00236                         BSR     FACEPAIR        ;  +x, -x
2327 9697             (    cube_core.asm):00237                         LDA     <EY
2329 8D02             (    cube_core.asm):00238                         BSR     FACEPAIR        ;  +y, -y
232B 9698             (    cube_core.asm):00239                         LDA     <EZ
                      (    cube_core.asm):00240                         ; fall into FACEPAIR    ;  +z, -z
                      (    cube_core.asm):00241         
                      (    cube_core.asm):00242         ; FACEPAIR - Entry: A = one coordinate of the eye, U -> VIS slot for the
                      (    cube_core.asm):00243         ;   + face. Sets that slot and the next ($FF visible, 0 hidden), U += 2.
232D 5F               (    cube_core.asm):00244         FACEPAIR        CLRB                    ; + face: visible if eye > S
232E 9194             (    cube_core.asm):00245                         CMPA    <SIZE           ;  (signed compare)
2330 2F01             (    cube_core.asm):00246                         BLE     FP_1
2332 5A               (    cube_core.asm):00247                         DECB                    ;  B = $FF
2333 E7C0             (    cube_core.asm):00248         FP_1            STB     ,U+
2335 5F               (    cube_core.asm):00249                         CLRB                    ; - face: visible if eye < -S,
2336 40               (    cube_core.asm):00250                         NEGA                    ;  i.e. -eye > S (the eye stays
2337 9194             (    cube_core.asm):00251                         CMPA    <SIZE           ;  within +/-101, so NEGA can't
2339 2F01             (    cube_core.asm):00252                         BLE     FP_2            ;  overflow)
233B 5A               (    cube_core.asm):00253                         DECB
233C E7C0             (    cube_core.asm):00254         FP_2            STB     ,U+
233E 39               (    cube_core.asm):00255                         RTS
                      (    cube_core.asm):00256         
                      (    cube_core.asm):00257         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00258         ; CORNERS - rotate and project all 8 corners into PX/PY
                      (    cube_core.asm):00259         ;
                      (    cube_core.asm):00260         ;   For each corner number VI (0-7):
                      (    cube_core.asm):00261         ;     rotated x = signed sum of the TX terms       (VSUM)
                      (    cube_core.asm):00262         ;     rotated z = signed sum of the TZ terms, turned into a table index
                      (    cube_core.asm):00263         ;     rotated y = signed sum of the TY terms
                      (    cube_core.asm):00264         ;     screen y  = CY + y * RYTAB[z] / 128         (PMUL)
                      (    cube_core.asm):00265         ;     screen x  = CX + x * RXTAB[z] / 128
                      (    cube_core.asm):00266         ; ---------------------------------------------------------------------------
233F 0F8F             (    cube_core.asm):00267         CORNERS         CLR     <VI             ; start with corner 0
2341 D68F             (    cube_core.asm):00268         CN_LOOP         LDB     <VI             ; B = corner number, used by VSUM
2343 CE0086           (    cube_core.asm):00269                         LDU     #TX             ;  to pick + or - for each term
2346 8D45             (    cube_core.asm):00270                         BSR     VSUM
2348 9790             (    cube_core.asm):00271                         STA     <VX             ; rotated x
234A CE008C           (    cube_core.asm):00272                         LDU     #TZ             ; (B is preserved by VSUM)
234D 8D3E             (    cube_core.asm):00273                         BSR     VSUM            ; rotated z, range about -60..60
234F 8B40             (    cube_core.asm):00274                         ADDA    #64             ; shift to 0..127 to index the tables
2351 9791             (    cube_core.asm):00275                         STA     <ZI
2353 CE0089           (    cube_core.asm):00276                         LDU     #TY
2356 8D35             (    cube_core.asm):00277                         BSR     VSUM            ; rotated y, left in A
                      (    cube_core.asm):00278         
                      (    cube_core.asm):00279         ; screen y = CY + y * RYTAB[z] / 128
2358 308D024D         (    cube_core.asm):00280                         LEAX    RYTAB,PCR       ; B = RYTAB[ZI]
235C D691             (    cube_core.asm):00281                         LDB     <ZI
235E 3A               (    cube_core.asm):00282                         ABX
235F E684             (    cube_core.asm):00283                         LDB     ,X
2361 8D49             (    cube_core.asm):00284                         BSR     PMUL            ; A = y * RYTAB[z] / 128
2363 8B24             (    cube_core.asm):00285                         ADDA    #CY
2365 8E00A8           (    cube_core.asm):00286                         LDX     #PY             ; store at PY + VI
2368 D68F             (    cube_core.asm):00287                         LDB     <VI
236A 3A               (    cube_core.asm):00288                         ABX
236B A784             (    cube_core.asm):00289                         STA     ,X
                      (    cube_core.asm):00290         
                      (    cube_core.asm):00291         ; screen x = CX + x * RXTAB[z] / 128
236D 308D01B8         (    cube_core.asm):00292                         LEAX    RXTAB,PCR       ; B = RXTAB[ZI]
2371 D691             (    cube_core.asm):00293                         LDB     <ZI
2373 3A               (    cube_core.asm):00294                         ABX
2374 E684             (    cube_core.asm):00295                         LDB     ,X
2376 9690             (    cube_core.asm):00296                         LDA     <VX             ; A = rotated x
2378 8D32             (    cube_core.asm):00297                         BSR     PMUL
237A 8B27             (    cube_core.asm):00298                         ADDA    #CX
237C 8E00A0           (    cube_core.asm):00299                         LDX     #PX             ; store at PX + VI
237F D68F             (    cube_core.asm):00300                         LDB     <VI
2381 3A               (    cube_core.asm):00301                         ABX
2382 A784             (    cube_core.asm):00302                         STA     ,X
                      (    cube_core.asm):00303         
2384 0C8F             (    cube_core.asm):00304                         INC     <VI             ; next corner, until all 8 done
2386 968F             (    cube_core.asm):00305                         LDA     <VI
2388 8108             (    cube_core.asm):00306                         CMPA    #8
238A 26B5             (    cube_core.asm):00307                         BNE     CN_LOOP
238C 39               (    cube_core.asm):00308                         RTS
                      (    cube_core.asm):00309         
                      (    cube_core.asm):00310         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00311         ; VSUM - one rotated coordinate of one corner
                      (    cube_core.asm):00312         ;   Entry: U -> the three terms for this coordinate (TX, TY or TZ)
                      (    cube_core.asm):00313         ;          B = corner number: bit 0 set means x = +S, clear means x = -S;
                      (    cube_core.asm):00314         ;              bit 1 likewise for y, bit 2 for z
                      (    cube_core.asm):00315         ;   Exit:  A = term0 * (+/-1) + term1 * (+/-1) + term2 * (+/-1)
                      (    cube_core.asm):00316         ;          B preserved (so the caller can reuse it for the next coordinate)
                      (    cube_core.asm):00317         ; ---------------------------------------------------------------------------
238D 4F               (    cube_core.asm):00318         VSUM            CLRA                    ; running total
238E C501             (    cube_core.asm):00319                         BITB    #1              ; x sign: add or subtract term 0
2390 2704             (    cube_core.asm):00320                         BEQ     VS_1
2392 ABC4             (    cube_core.asm):00321                         ADDA    ,U
2394 2002             (    cube_core.asm):00322                         BRA     VS_2
2396 A0C4             (    cube_core.asm):00323         VS_1            SUBA    ,U
2398 C502             (    cube_core.asm):00324         VS_2            BITB    #2              ; y sign: term 1
239A 2704             (    cube_core.asm):00325                         BEQ     VS_3
239C AB41             (    cube_core.asm):00326                         ADDA    1,U
239E 2002             (    cube_core.asm):00327                         BRA     VS_4
23A0 A041             (    cube_core.asm):00328         VS_3            SUBA    1,U
23A2 C504             (    cube_core.asm):00329         VS_4            BITB    #4              ; z sign: term 2
23A4 2703             (    cube_core.asm):00330                         BEQ     VS_5
23A6 AB42             (    cube_core.asm):00331                         ADDA    2,U
23A8 39               (    cube_core.asm):00332                         RTS
23A9 A042             (    cube_core.asm):00333         VS_5            SUBA    2,U
23AB 39               (    cube_core.asm):00334                         RTS
                      (    cube_core.asm):00335         
                      (    cube_core.asm):00336         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00337         ; PMUL - projection multiply: A = (A * B) / 128
                      (    cube_core.asm):00338         ;   Entry: A = coordinate (signed), B = scale from RXTAB/RYTAB (unsigned)
                      (    cube_core.asm):00339         ;   Exit:  A = result. B corrupted.
                      (    cube_core.asm):00340         ;
                      (    cube_core.asm):00341         ;   Like MULS7, but only A can be negative, so: make A positive, MUL,
                      (    cube_core.asm):00342         ;   divide by 128 the same way (ASLB/ROLA leaves D/128 in A), and negate
                      (    cube_core.asm):00343         ;   the answer if A was negative.
                      (    cube_core.asm):00344         ; ---------------------------------------------------------------------------
23AC 4D               (    cube_core.asm):00345         PMUL            TSTA
23AD 2A06             (    cube_core.asm):00346                         BPL     PM_1
23AF 40               (    cube_core.asm):00347                         NEGA                    ; negative coordinate:
23B0 3D               (    cube_core.asm):00348                         MUL                     ;  |A| * B
23B1 58               (    cube_core.asm):00349                         ASLB                    ;  / 128
23B2 49               (    cube_core.asm):00350                         ROLA
23B3 40               (    cube_core.asm):00351                         NEGA                    ;  and make it negative again
23B4 39               (    cube_core.asm):00352                         RTS
23B5 3D               (    cube_core.asm):00353         PM_1            MUL                     ; positive coordinate: A * B
23B6 58               (    cube_core.asm):00354                         ASLB                    ;  / 128
23B7 49               (    cube_core.asm):00355                         ROLA
23B8 39               (    cube_core.asm):00356                         RTS
                      (    cube_core.asm):00357         
                      (    cube_core.asm):00358         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00359         ; EDGES - draw the 12 edges
                      (    cube_core.asm):00360         ;
                      (    cube_core.asm):00361         ;   EDGETAB lists the 12 edges as pairs of corner numbers. For each pair,
                      (    cube_core.asm):00362         ;   look up both corners' screen positions in PX/PY and draw a line.
                      (    cube_core.asm):00363         ;   TGL_LINEC (the clipped line) is used because, when the cube is zoomed
                      (    cube_core.asm):00364         ;   right in, some corners land off the screen.
                      (    cube_core.asm):00365         ;
                      (    cube_core.asm):00366         ;   Y walks through EDGETAB four bytes at a time: 0,Y is the start corner,
                      (    cube_core.asm):00367         ;   1,Y the end corner, and 2,Y and 3,Y the two faces the edge borders.
                      (    cube_core.asm):00368         ;   Unless WIRE is set (draw every edge), an edge is skipped if both its
                      (    cube_core.asm):00369         ;   faces are hidden. Edges use the current plot mode.
                      (    cube_core.asm):00370         ; ---------------------------------------------------------------------------
23B9 318D003C         (    cube_core.asm):00371         EDGES           LEAY    EDGETAB,PCR
23BD 860C             (    cube_core.asm):00372                         LDA     #12             ; 12 edges to draw
23BF 9792             (    cube_core.asm):00373                         STA     <EC
23C1 0D99             (    cube_core.asm):00374         ED_LOOP         TST     <WIRE           ; wireframe: draw every edge
23C3 2612             (    cube_core.asm):00375                         BNE     ED_DRAW
23C5 8E00B0           (    cube_core.asm):00376                         LDX     #VIS            ; skip the edge unless one of its
23C8 E622             (    cube_core.asm):00377                         LDB     2,Y             ;  faces is visible
23CA 3A               (    cube_core.asm):00378                         ABX
23CB A684             (    cube_core.asm):00379                         LDA     ,X
23CD 8E00B0           (    cube_core.asm):00380                         LDX     #VIS
23D0 E623             (    cube_core.asm):00381                         LDB     3,Y
23D2 3A               (    cube_core.asm):00382                         ABX
23D3 AA84             (    cube_core.asm):00383                         ORA     ,X
23D5 271B             (    cube_core.asm):00384                         BEQ     ED_NEXT
23D7 8E00A0           (    cube_core.asm):00385         ED_DRAW         LDX     #PX             ; end corner's position -> U
23DA E621             (    cube_core.asm):00386                         LDB     1,Y             ;  X -> PX + end corner
23DC 3A               (    cube_core.asm):00387                         ABX
23DD A684             (    cube_core.asm):00388                         LDA     ,X              ;  A = its x
23DF E608             (    cube_core.asm):00389                         LDB     8,X             ;  B = its y (PY = PX + 8)
23E1 1F03             (    cube_core.asm):00390                         TFR     D,U             ;  park x1:y1 in U for now
23E3 8E00A0           (    cube_core.asm):00391                         LDX     #PX             ; start corner's position -> A, B
23E6 E6A4             (    cube_core.asm):00392                         LDB     ,Y
23E8 3A               (    cube_core.asm):00393                         ABX
23E9 A684             (    cube_core.asm):00394                         LDA     ,X              ;  A = x0
23EB E608             (    cube_core.asm):00395                         LDB     8,X             ;  B = y0
23ED 1F31             (    cube_core.asm):00396                         TFR     U,X             ; X = x1:y1, the packed end point
23EF BD1018           (    cube_core.asm):00397                         JSR     TGL_LINEC
23F2 3124             (    cube_core.asm):00398         ED_NEXT         LEAY    4,Y             ; next edge
23F4 0A92             (    cube_core.asm):00399                         DEC     <EC
23F6 26C9             (    cube_core.asm):00400                         BNE     ED_LOOP
23F8 39               (    cube_core.asm):00401                         RTS
                      (    cube_core.asm):00402         
                      (    cube_core.asm):00403         ; ---------------------------------------------------------------------------
                      (    cube_core.asm):00404         ; The 12 edges: start corner, end corner, and the two faces the edge
                      (    cube_core.asm):00405         ; borders (0 +x, 1 -x, 2 +y, 3 -y, 4 +z, 5 -z). The two corners differ in
                      (    cube_core.asm):00406         ; one bit, so the edge runs along that axis; its faces come from the other
                      (    cube_core.asm):00407         ; two bits (bit set: the + face, clear: the - face).
                      (    cube_core.asm):00408         ; ---------------------------------------------------------------------------
23F9                  (    cube_core.asm):00409         EDGETAB
23F9 00010305         (    cube_core.asm):00410                         FCB     0,1,3,5         ; along x: faces -y, -z
23FD 02030205         (    cube_core.asm):00411                         FCB     2,3,2,5         ; along x: faces +y, -z
2401 04050304         (    cube_core.asm):00412                         FCB     4,5,3,4         ; along x: faces -y, +z
2405 06070204         (    cube_core.asm):00413                         FCB     6,7,2,4         ; along x: faces +y, +z
2409 00020105         (    cube_core.asm):00414                         FCB     0,2,1,5         ; along y: faces -x, -z
240D 01030005         (    cube_core.asm):00415                         FCB     1,3,0,5         ; along y: faces +x, -z
2411 04060104         (    cube_core.asm):00416                         FCB     4,6,1,4         ; along y: faces -x, +z
2415 05070004         (    cube_core.asm):00417                         FCB     5,7,0,4         ; along y: faces +x, +z
2419 00040103         (    cube_core.asm):00418                         FCB     0,4,1,3         ; along z: faces -x, -y
241D 01050003         (    cube_core.asm):00419                         FCB     1,5,0,3         ; along z: faces +x, -y
2421 02060102         (    cube_core.asm):00420                         FCB     2,6,1,2         ; along z: faces -x, +y
2425 03070002         (    cube_core.asm):00421                         FCB     3,7,0,2         ; along z: faces +x, +y
