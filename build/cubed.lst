                      (   demo/cubed.asm):00176         ; PIPPOS - screen position of a spot centre
                      (   demo/cubed.asm):00177         ;   The point is S along the face's axis PA (signed by PS), plus PPB and
                      (   demo/cubed.asm):00178         ;   PPC halves of S along the in-face axes PB and PC. Each rotated
                      (   demo/cubed.asm):00179         ;   coordinate is then PS*T[PA] + PPB*H[PB] + PPC*H[PC], using that row's
                      (   demo/cubed.asm):00180         ;   terms T and halved terms H (PROWV). Projected as in CORNERS.
                      (   demo/cubed.asm):00181         ;   Exit: A = screen x, B = screen y (signed)
                      (   demo/cubed.asm):00182         ; ---------------------------------------------------------------------------
20D2 8E0086           (   demo/cubed.asm):00183         PIPPOS          LDX     #TX             ; rotated x
20D5 8D32             (   demo/cubed.asm):00184                         BSR     PROWV
20D7 9790             (   demo/cubed.asm):00185                         STA     <VX
20D9 8E008C           (   demo/cubed.asm):00186                         LDX     #TZ             ; rotated z -> depth table index
20DC 8D2B             (   demo/cubed.asm):00187                         BSR     PROWV
20DE 8B40             (   demo/cubed.asm):00188                         ADDA    #64
20E0 9791             (   demo/cubed.asm):00189                         STA     <ZI
20E2 8E0089           (   demo/cubed.asm):00190                         LDX     #TY             ; rotated y
20E5 8D22             (   demo/cubed.asm):00191                         BSR     PROWV
20E7 308D04BE         (   demo/cubed.asm):00192                         LEAX    RYTAB,PCR       ; screen y = CY + y * RY[z] / 128
20EB D691             (   demo/cubed.asm):00193                         LDB     <ZI
20ED 3A               (   demo/cubed.asm):00194                         ABX
20EE E684             (   demo/cubed.asm):00195                         LDB     ,X
20F0 1702B9           (   demo/cubed.asm):00196                         LBSR    PMUL
20F3 8B24             (   demo/cubed.asm):00197                         ADDA    #CY
20F5 3402             (   demo/cubed.asm):00198                         PSHS    A
20F7 308D042E         (   demo/cubed.asm):00199                         LEAX    RXTAB,PCR       ; screen x = CX + x * RX[z] / 128
20FB D691             (   demo/cubed.asm):00200                         LDB     <ZI
20FD 3A               (   demo/cubed.asm):00201                         ABX
20FE E684             (   demo/cubed.asm):00202                         LDB     ,X
2100 9690             (   demo/cubed.asm):00203                         LDA     <VX
2102 1702A7           (   demo/cubed.asm):00204                         LBSR    PMUL
2105 8B27             (   demo/cubed.asm):00205                         ADDA    #CX
2107 3584             (   demo/cubed.asm):00206                         PULS    B,PC
                      (   demo/cubed.asm):00207         
                      (   demo/cubed.asm):00208         ; PROWV - one rotated coordinate of the spot. Entry: X -> a row's terms
                      (   demo/cubed.asm):00209         ;   (TX, TY or TZ); its halved terms are at $40,X. Exit: A.
2109 D6D0             (   demo/cubed.asm):00210         PROWV           LDB     <PA             ; PS * T[PA]
210B A685             (   demo/cubed.asm):00211                         LDA     B,X
210D 0DD3             (   demo/cubed.asm):00212                         TST     <PS
210F 2A01             (   demo/cubed.asm):00213                         BPL     PV_1
2111 40               (   demo/cubed.asm):00214                         NEGA
2112 338840           (   demo/cubed.asm):00215         PV_1            LEAU    $40,X           ; U -> the halved terms
2115 D6D1             (   demo/cubed.asm):00216                         LDB     <PB             ; + PPB * H[PB]
2117 0DD4             (   demo/cubed.asm):00217                         TST     <PPB
2119 2708             (   demo/cubed.asm):00218                         BEQ     PV_3
211B 2B04             (   demo/cubed.asm):00219                         BMI     PV_2
211D ABC5             (   demo/cubed.asm):00220                         ADDA    B,U
211F 2002             (   demo/cubed.asm):00221                         BRA     PV_3
2121 A0C5             (   demo/cubed.asm):00222         PV_2            SUBA    B,U
2123 D6D2             (   demo/cubed.asm):00223         PV_3            LDB     <PC             ; + PPC * H[PC]
2125 0DD5             (   demo/cubed.asm):00224                         TST     <PPC
2127 2707             (   demo/cubed.asm):00225                         BEQ     PV_5
2129 2B03             (   demo/cubed.asm):00226                         BMI     PV_4
212B ABC5             (   demo/cubed.asm):00227                         ADDA    B,U
212D 39               (   demo/cubed.asm):00228                         RTS
212E A0C5             (   demo/cubed.asm):00229         PV_4            SUBA    B,U
2130 39               (   demo/cubed.asm):00230         PV_5            RTS
                      (   demo/cubed.asm):00231         
