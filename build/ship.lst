                      (    demo/ship.asm):00001         ; ===========================================================================
                      (    demo/ship.asm):00002         ; Spaceship demo for the teletext graphics library
                      (    demo/ship.asm):00003         ;
                      (    demo/ship.asm):00004         ;   An original ship design (the "Kestrel" courier, defined in
                      (    demo/ship.asm):00005         ;   tools/gen_ship_model.py) tumbles slowly in perspective, drawn as a
                      (    demo/ship.asm):00006         ;   wireframe with hidden lines removed, so it looks solid.
                      (    demo/ship.asm):00007         ;   Press any key to exit.
                      (    demo/ship.asm):00008         ;
                      (    demo/ship.asm):00009         ;   Loading: tgl.bin at $1000 (TGL_BASE below), ship.bin at $2000 (its ORG).
                      (    demo/ship.asm):00010         ;   Run from START ($2000). Works with either machine's library build.
                      (    demo/ship.asm):00011         ;
                      (    demo/ship.asm):00012         ;   Each frame:
                      (    demo/ship.asm):00013         ;     1. clear the off-screen buffer                       (TGL_CLS)
                      (    demo/ship.asm):00014         ;     2. build the rotation matrix for this frame          (MATRIX)
                      (    demo/ship.asm):00015         ;     3. rotate every corner and project it to the screen  (CORNERS)
                      (    demo/ship.asm):00016         ;     4. decide which faces point towards the viewer       (FACES)
                      (    demo/ship.asm):00017         ;     5. draw the edges that border a visible face         (EDGES)
                      (    demo/ship.asm):00018         ;     6. copy the buffer to the screen                     (TGL_BLIT)
                      (    demo/ship.asm):00019         ;
                      (    demo/ship.asm):00020         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00021         ; How it differs from the cube demo
                      (    demo/ship.asm):00022         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00023         ;
                      (    demo/ship.asm):00024         ;   General rotation. The cube's corners were all (+/-S, +/-S, +/-S), which
                      (    demo/ship.asm):00025         ;   allowed a shortcut. A ship's corners can be anywhere, so each one is
                      (    demo/ship.asm):00026         ;   multiplied by the full 3x3 rotation matrix:
                      (    demo/ship.asm):00027         ;
                      (    demo/ship.asm):00028         ;       rotated x = (mx0*x + mx1*y + mx2*z) / 128     (likewise y and z)
                      (    demo/ship.asm):00029         ;
                      (    demo/ship.asm):00030         ;   That's nine signed multiplies per corner (SMUL16), summed in 16 bits.
                      (    demo/ship.asm):00031         ;   The division by 128 is rounded rather than truncated, which matters for
                      (    demo/ship.asm):00032         ;   the hidden-line test below.
                      (    demo/ship.asm):00033         ;
                      (    demo/ship.asm):00034         ;   Hidden-line removal. The hull is convex, so each face is either wholly
                      (    demo/ship.asm):00035         ;   visible or wholly hidden. A face is visible when it points back towards
                      (    demo/ship.asm):00036         ;   the viewer:
                      (    demo/ship.asm):00037         ;
                      (    demo/ship.asm):00038         ;       visible if  n . (P - eye) < 0
                      (    demo/ship.asm):00039         ;
                      (    demo/ship.asm):00040         ;   where n is the face's outward normal (the direction it faces), P is any
                      (    demo/ship.asm):00041         ;   corner on the face, and the eye sits 100 units in front of the ship (the
                      (    demo/ship.asm):00042         ;   viewing distance the projection tables assume).
                      (    demo/ship.asm):00043         ;
                      (    demo/ship.asm):00044         ;   Rather than rotate every face to meet the viewer, the demo turns the
                      (    demo/ship.asm):00045         ;   viewer's position into the ship's own coordinates, once per frame. Then
                      (    demo/ship.asm):00046         ;   n and P never change, so n . P is precomputed by the generator (C), and
                      (    demo/ship.asm):00047         ;   each face costs just three multiplies:  visible if C - n . eye < 0.
                      (    demo/ship.asm):00048         ;
                      (    demo/ship.asm):00049         ;   Working this out in 3D, before projection, is far more reliable than
                      (    demo/ship.asm):00050         ;   testing a face's corners on screen, where small faces are only a few
                      (    demo/ship.asm):00051         ;   pixels across.
                      (    demo/ship.asm):00052         ;
                      (    demo/ship.asm):00053         ;   An edge is drawn if either face it borders is visible. Decal lines
                      (    demo/ship.asm):00054         ;   (engine outlines, cockpit window) belong to a single face and vanish
                      (    demo/ship.asm):00055         ;   with it.
                      (    demo/ship.asm):00056         ;
                      (    demo/ship.asm):00057         ;   The model data (corners, faces with normals, edges) is generated into
                      (    demo/ship.asm):00058         ;   ship_model.asm by tools/gen_ship_model.py, which also checks the design
                      (    demo/ship.asm):00059         ;   is convex and fits the projection tables.
                      (    demo/ship.asm):00060         ;
                      (    demo/ship.asm):00061         ;   Build with -D TESTFRAMES=n to stop after n frames (emulator tests).
                      (    demo/ship.asm):00062         ; ===========================================================================
                      (    demo/ship.asm):00063         
     1000             (    demo/ship.asm):00064         TGL_BASE        EQU     $1000
                      (    demo/ship.asm):00065                         INCLUDE "tgl_api.inc"
                      (      tgl_api.inc):00001         ; ---------------------------------------------------------------------------
                      (      tgl_api.inc):00002         ; Acorn System 3 Teletext Graphics Library - caller interface
                      (      tgl_api.inc):00003         ;
                      (      tgl_api.inc):00004         ; Define TGL_BASE as the address the library binary is loaded at, then
                      (      tgl_api.inc):00005         ; INCLUDE this file. Entry points are fixed offsets from the load address.
                      (      tgl_api.inc):00006         ;
                      (      tgl_api.inc):00007         ; All routines: enter with DP = $00. Registers are preserved unless stated.
                      (      tgl_api.inc):00008         ; ---------------------------------------------------------------------------
     1000             (      tgl_api.inc):00009         TGL_INIT        EQU     TGL_BASE+0      ; initialise; buffer = end of library
     1003             (      tgl_api.inc):00010         TGL_SETBUF      EQU     TGL_BASE+3      ; X = off-screen buffer address
     1006             (      tgl_api.inc):00011         TGL_CLS         EQU     TGL_BASE+6      ; clear buffer to blank graphics
     1009             (      tgl_api.inc):00012         TGL_SETMODE     EQU     TGL_BASE+9      ; A = plot mode (TGL_MODE_xxx)
     100C             (      tgl_api.inc):00013         TGL_PLOT        EQU     TGL_BASE+12     ; A = x (0-77), B = y (0-71)
     100F             (      tgl_api.inc):00014         TGL_LINE        EQU     TGL_BASE+15     ; A,B = x0,y0  X = x1:y1 (hi:lo)
     1012             (      tgl_api.inc):00015         TGL_BLIT        EQU     TGL_BASE+18     ; copy buffer to screen rows 0-23
     1015             (      tgl_api.inc):00016         TGL_PLOTC       EQU     TGL_BASE+21     ; clipped plot: A,B = signed x,y
     1018             (      tgl_api.inc):00017         TGL_LINEC       EQU     TGL_BASE+24     ; clipped line: signed coordinates
     101B             (      tgl_api.inc):00018         TGL_DONE        EQU     TGL_BASE+27     ; restore text display (clears screen)
     101E             (      tgl_api.inc):00019         TGL_INKEY       EQU     TGL_BASE+30     ; key waiting? Z set: none; else A = key
     1021             (      tgl_api.inc):00020         TGL_EXIT        EQU     TGL_BASE+33     ; restore display, back to FLEX/monitor
     1024             (      tgl_api.inc):00021         TGL_RECT        EQU     TGL_BASE+36     ; outline rectangle: corners as TGL_LINEC
     1027             (      tgl_api.inc):00022         TGL_RECTF       EQU     TGL_BASE+39     ; filled rectangle: corners as TGL_LINEC
     102A             (      tgl_api.inc):00023         TGL_CIRC        EQU     TGL_BASE+42     ; outline circle: A,B = centre, X = radius
     102D             (      tgl_api.inc):00024         TGL_CIRCF       EQU     TGL_BASE+45     ; filled circle: A,B = centre, X = radius
     1030             (      tgl_api.inc):00025         TGL_TEXT        EQU     TGL_BASE+48     ; status row text: A = column, X -> string
     1033             (      tgl_api.inc):00026         TGL_TCLR        EQU     TGL_BASE+51     ; clear the status row
     1036             (      tgl_api.inc):00027         TGL_TNUM        EQU     TGL_BASE+54     ; status row number: A = column, X = value
                      (      tgl_api.inc):00028         
     03C0             (      tgl_api.inc):00029         TGL_BUFSIZE     EQU     960
     0000             (      tgl_api.inc):00030         TGL_MODE_SET    EQU     0
     0001             (      tgl_api.inc):00031         TGL_MODE_CLEAR  EQU     1
     0002             (      tgl_api.inc):00032         TGL_MODE_XOR    EQU     2
                      (    demo/ship.asm):00066         
                      (    demo/ship.asm):00067         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00068         ; Memory
                      (    demo/ship.asm):00069         ; ---------------------------------------------------------------------------
     3000             (    demo/ship.asm):00070         BUFFER          EQU     $3000           ; off-screen buffer (960 bytes)
     0200             (    demo/ship.asm):00071         STACK_TOP       EQU     $0200           ; stack $0100-$01FF
                      (    demo/ship.asm):00072         
                      (    demo/ship.asm):00073         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00074         ; Settings you can change
                      (    demo/ship.asm):00075         ; ---------------------------------------------------------------------------
     0027             (    demo/ship.asm):00076         CX              EQU     39              ; screen position of the ship's centre
     0024             (    demo/ship.asm):00077         CY              EQU     36
     0001             (    demo/ship.asm):00078         STEP_A          EQU     1               ; rotation speed about x (pitch)
     0002             (    demo/ship.asm):00079         STEP_B          EQU     2               ; rotation speed about y (yaw)
     0065             (    demo/ship.asm):00080         EYE_K           EQU     101             ; viewing distance, scaled by 128/127
                      (    demo/ship.asm):00081                                                 ;  (101 * 127/128 = 100, matching the
                      (    demo/ship.asm):00082                                                 ;  projection tables)
                      (    demo/ship.asm):00083         
                      (    demo/ship.asm):00084         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00085         ; Variables in page zero (the library uses $00-$17)
                      (    demo/ship.asm):00086         ; ---------------------------------------------------------------------------
     0080             (    demo/ship.asm):00087         ANG_A           EQU     $80             ; pitch angle (0-255 = full turn)
     0081             (    demo/ship.asm):00088         ANG_B           EQU     $81             ; yaw angle
     0082             (    demo/ship.asm):00089         SA              EQU     $82             ; sin/cos of the angles (127 = 1.0)
     0083             (    demo/ship.asm):00090         CA              EQU     $83
     0084             (    demo/ship.asm):00091         SB              EQU     $84
     0085             (    demo/ship.asm):00092         CB              EQU     $85
     0086             (    demo/ship.asm):00093         MROWX           EQU     $86             ; rotation matrix, row x (3 bytes)
     0089             (    demo/ship.asm):00094         MROWY           EQU     $89             ;  row y (3 bytes)
     008C             (    demo/ship.asm):00095         MROWZ           EQU     $8C             ;  row z (3 bytes)
     008F             (    demo/ship.asm):00096         VEC             EQU     $8F             ; vector being rotated (3 bytes)
     0092             (    demo/ship.asm):00097         ACC             EQU     $92             ; 16-bit running sum
     0094             (    demo/ship.asm):00098         MT_A            EQU     $94             ; SMUL16's saved inputs
     0095             (    demo/ship.asm):00099         MT_B            EQU     $95
     0096             (    demo/ship.asm):00100         VI              EQU     $96             ; corner number being worked on
     0097             (    demo/ship.asm):00101         ZI              EQU     $97             ; its depth, as a projection table index
     0098             (    demo/ship.asm):00102         FI              EQU     $98             ; face number being worked on
     0099             (    demo/ship.asm):00103         EC              EQU     $99             ; edges left to draw
     009A             (    demo/ship.asm):00104         FRAMES          EQU     $9A             ; frame counter (test builds)
     009B             (    demo/ship.asm):00105         EX              EQU     $9B             ; the eye, in ship coordinates
     009C             (    demo/ship.asm):00106         EY              EQU     $9C
     009D             (    demo/ship.asm):00107         EZ              EQU     $9D
     009E             (    demo/ship.asm):00108         TMPX            EQU     $9E             ; rotated x of the current corner
     00A0             (    demo/ship.asm):00109         PX              EQU     $A0             ; screen x of corners (32 bytes)
     00C0             (    demo/ship.asm):00110         PY              EQU     $C0             ; screen y of corners: PX+32, so if X
                      (    demo/ship.asm):00111                                                 ;  points at PX+n, the y is at 32,X
     00E0             (    demo/ship.asm):00112         VIS             EQU     $E0             ; per face: $FF visible, 0 hidden
                      (    demo/ship.asm):00113                                                 ;  (16 bytes)
                      (    demo/ship.asm):00114         
                      (    demo/ship.asm):00115                         ORG     $2000
                      (    demo/ship.asm):00116         
                      (    demo/ship.asm):00117         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00118         ; Set up
                      (    demo/ship.asm):00119         ; ---------------------------------------------------------------------------
2000 10CE0200         (    demo/ship.asm):00120         START           LDS     #STACK_TOP
2004 4F               (    demo/ship.asm):00121                         CLRA                    ; DP = $00 for the library and for
2005 1F8B             (    demo/ship.asm):00122                         TFR     A,DP            ;  our page-zero variables
     00               (    demo/ship.asm):00123                         SETDP   $00
2007 1CEF             (    demo/ship.asm):00124                         ANDCC   #$EF            ; IRQs on (keyboard)
2009 BD1000           (    demo/ship.asm):00125                         JSR     TGL_INIT
200C 8E3000           (    demo/ship.asm):00126                         LDX     #BUFFER
200F BD1003           (    demo/ship.asm):00127                         JSR     TGL_SETBUF
2012 0F80             (    demo/ship.asm):00128                         CLR     <ANG_A
2014 0F81             (    demo/ship.asm):00129                         CLR     <ANG_B
2016 0F9A             (    demo/ship.asm):00130                         CLR     <FRAMES
                      (    demo/ship.asm):00131         
                      (    demo/ship.asm):00132         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00133         ; Main loop
                      (    demo/ship.asm):00134         ; ---------------------------------------------------------------------------
2018 BD1006           (    demo/ship.asm):00135         FRAME           JSR     TGL_CLS
201B 170023           (    demo/ship.asm):00136                         LBSR    MATRIX
201E 170089           (    demo/ship.asm):00137                         LBSR    CORNERS
2021 1700EA           (    demo/ship.asm):00138                         LBSR    FACES
2024 17014C           (    demo/ship.asm):00139                         LBSR    EDGES
2027 BD1012           (    demo/ship.asm):00140                         JSR     TGL_BLIT
202A 9680             (    demo/ship.asm):00141                         LDA     <ANG_A          ; advance the angles (they wrap from
202C 8B01             (    demo/ship.asm):00142                         ADDA    #STEP_A         ;  255 to 0 by themselves)
202E 9780             (    demo/ship.asm):00143                         STA     <ANG_A
2030 9681             (    demo/ship.asm):00144                         LDA     <ANG_B
2032 8B02             (    demo/ship.asm):00145                         ADDA    #STEP_B
2034 9781             (    demo/ship.asm):00146                         STA     <ANG_B
2036 BD101E           (    demo/ship.asm):00147                         JSR     TGL_INKEY       ; any key exits
2039 1026EFE4         (    demo/ship.asm):00148                         LBNE    TGL_EXIT
                      (    demo/ship.asm):00149                         IFDEF   TESTFRAMES
                      (    demo/ship.asm):00150                         INC     <FRAMES
                      (    demo/ship.asm):00151                         LDA     <FRAMES
                      (    demo/ship.asm):00152                         CMPA    #TESTFRAMES
                      (    demo/ship.asm):00153                         BEQ     DONE
                      (    demo/ship.asm):00154                         ENDC
203D 20D9             (    demo/ship.asm):00155                         BRA     FRAME
203F 20FE             (    demo/ship.asm):00156         DONE            BRA     DONE
                      (    demo/ship.asm):00157         
                      (    demo/ship.asm):00158         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00159         ; MATRIX - rotation about y (yaw, angle B) then x (pitch, angle A)
                      (    demo/ship.asm):00160         ;
                      (    demo/ship.asm):00161         ;   The same matrix as the cube demo (see cube.asm for the derivation),
                      (    demo/ship.asm):00162         ;   stored row by row so ROWDOT can walk along a row:
                      (    demo/ship.asm):00163         ;
                      (    demo/ship.asm):00164         ;     MROWX: [  cb,      0,    sb     ]
                      (    demo/ship.asm):00165         ;     MROWY: [  sb*sa,   ca,  -cb*sa  ]
                      (    demo/ship.asm):00166         ;     MROWZ: [ -sb*ca,   sa,   cb*ca  ]
                      (    demo/ship.asm):00167         ; ---------------------------------------------------------------------------
2041 308D02FE         (    demo/ship.asm):00168         MATRIX          LEAX    SINTAB,PCR      ; SA = sin(ANG_A)
2045 D680             (    demo/ship.asm):00169                         LDB     <ANG_A          ;  (ABX: unsigned index 0-255)
2047 3A               (    demo/ship.asm):00170                         ABX
2048 A684             (    demo/ship.asm):00171                         LDA     ,X
204A 9782             (    demo/ship.asm):00172                         STA     <SA
204C 308D02F3         (    demo/ship.asm):00173                         LEAX    SINTAB,PCR      ; CA = cos(ANG_A) = sin(ANG_A + 64)
2050 D680             (    demo/ship.asm):00174                         LDB     <ANG_A
2052 CB40             (    demo/ship.asm):00175                         ADDB    #64
2054 3A               (    demo/ship.asm):00176                         ABX
2055 A684             (    demo/ship.asm):00177                         LDA     ,X
2057 9783             (    demo/ship.asm):00178                         STA     <CA
2059 308D02E6         (    demo/ship.asm):00179                         LEAX    SINTAB,PCR      ; SB = sin(ANG_B)
205D D681             (    demo/ship.asm):00180                         LDB     <ANG_B
205F 3A               (    demo/ship.asm):00181                         ABX
2060 A684             (    demo/ship.asm):00182                         LDA     ,X
2062 9784             (    demo/ship.asm):00183                         STA     <SB
2064 308D02DB         (    demo/ship.asm):00184                         LEAX    SINTAB,PCR      ; CB = cos(ANG_B)
2068 D681             (    demo/ship.asm):00185                         LDB     <ANG_B
206A CB40             (    demo/ship.asm):00186                         ADDB    #64
206C 3A               (    demo/ship.asm):00187                         ABX
206D A684             (    demo/ship.asm):00188                         LDA     ,X
206F 9785             (    demo/ship.asm):00189                         STA     <CB
                      (    demo/ship.asm):00190         
2071 9685             (    demo/ship.asm):00191                         LDA     <CB             ; row x
2073 9786             (    demo/ship.asm):00192                         STA     <MROWX
2075 0F87             (    demo/ship.asm):00193                         CLR     <MROWX+1
2077 9684             (    demo/ship.asm):00194                         LDA     <SB
2079 9788             (    demo/ship.asm):00195                         STA     <MROWX+2
                      (    demo/ship.asm):00196         
207B 9684             (    demo/ship.asm):00197                         LDA     <SB             ; row y
207D D682             (    demo/ship.asm):00198                         LDB     <SA
207F 170190           (    demo/ship.asm):00199                         LBSR    MULS7           ;  sb*sa
2082 9789             (    demo/ship.asm):00200                         STA     <MROWY
2084 9683             (    demo/ship.asm):00201                         LDA     <CA
2086 978A             (    demo/ship.asm):00202                         STA     <MROWY+1
2088 9685             (    demo/ship.asm):00203                         LDA     <CB
208A D682             (    demo/ship.asm):00204                         LDB     <SA
208C 170183           (    demo/ship.asm):00205                         LBSR    MULS7           ;  -cb*sa
208F 40               (    demo/ship.asm):00206                         NEGA
2090 978B             (    demo/ship.asm):00207                         STA     <MROWY+2
                      (    demo/ship.asm):00208         
2092 9684             (    demo/ship.asm):00209                         LDA     <SB             ; row z
2094 D683             (    demo/ship.asm):00210                         LDB     <CA
2096 170179           (    demo/ship.asm):00211                         LBSR    MULS7           ;  -sb*ca
2099 40               (    demo/ship.asm):00212                         NEGA
209A 978C             (    demo/ship.asm):00213                         STA     <MROWZ
209C 9682             (    demo/ship.asm):00214                         LDA     <SA
209E 978D             (    demo/ship.asm):00215                         STA     <MROWZ+1
20A0 9685             (    demo/ship.asm):00216                         LDA     <CB
20A2 D683             (    demo/ship.asm):00217                         LDB     <CA
20A4 17016B           (    demo/ship.asm):00218                         LBSR    MULS7           ;  cb*ca
20A7 978E             (    demo/ship.asm):00219                         STA     <MROWZ+2
20A9 39               (    demo/ship.asm):00220                         RTS
                      (    demo/ship.asm):00221         
                      (    demo/ship.asm):00222         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00223         ; CORNERS - rotate and project every corner
                      (    demo/ship.asm):00224         ;
                      (    demo/ship.asm):00225         ;   For each corner: copy it into VEC, take its dot product with each row
                      (    demo/ship.asm):00226         ;   of the matrix to get the rotated x, y and z, and project to screen as
                      (    demo/ship.asm):00227         ;   in the cube demo:
                      (    demo/ship.asm):00228         ;     screen x = CX + x * RXTAB[z+64] / 128
                      (    demo/ship.asm):00229         ;     screen y = CY + y * RYTAB[z+64] / 128
                      (    demo/ship.asm):00230         ; ---------------------------------------------------------------------------
20AA 318D0177         (    demo/ship.asm):00231         CORNERS         LEAY    SHIP_V,PCR      ; Y -> first corner's x, y, z
20AE 0F96             (    demo/ship.asm):00232                         CLR     <VI
20B0 ECA4             (    demo/ship.asm):00233         CN_LOOP         LDD     ,Y              ; copy the corner into VEC
20B2 DD8F             (    demo/ship.asm):00234                         STD     <VEC
20B4 A622             (    demo/ship.asm):00235                         LDA     2,Y
20B6 9791             (    demo/ship.asm):00236                         STA     <VEC+2
                      (    demo/ship.asm):00237         
20B8 CE0086           (    demo/ship.asm):00238                         LDU     #MROWX          ; rotated x
20BB 1700F5           (    demo/ship.asm):00239                         LBSR    ROWDOT
20BE 979E             (    demo/ship.asm):00240                         STA     <TMPX
20C0 CE008C           (    demo/ship.asm):00241                         LDU     #MROWZ          ; rotated z
20C3 1700ED           (    demo/ship.asm):00242                         LBSR    ROWDOT
20C6 8B40             (    demo/ship.asm):00243                         ADDA    #64             ; depth -> projection table index
20C8 9797             (    demo/ship.asm):00244                         STA     <ZI
20CA CE0089           (    demo/ship.asm):00245                         LDU     #MROWY          ; rotated y, left in A
20CD 1700E3           (    demo/ship.asm):00246                         LBSR    ROWDOT
                      (    demo/ship.asm):00247         
20D0 308D03EF         (    demo/ship.asm):00248                         LEAX    RYTAB,PCR       ; screen y (rotated y still in A)
20D4 D697             (    demo/ship.asm):00249                         LDB     <ZI
20D6 3A               (    demo/ship.asm):00250                         ABX
20D7 E684             (    demo/ship.asm):00251                         LDB     ,X
20D9 17013B           (    demo/ship.asm):00252                         LBSR    PMUL
20DC 8B24             (    demo/ship.asm):00253                         ADDA    #CY
20DE 8E00A0           (    demo/ship.asm):00254                         LDX     #PX             ; PY entry is at 32,X
20E1 D696             (    demo/ship.asm):00255                         LDB     <VI
20E3 3A               (    demo/ship.asm):00256                         ABX
20E4 A78820           (    demo/ship.asm):00257                         STA     32,X
                      (    demo/ship.asm):00258         
20E7 308D0358         (    demo/ship.asm):00259                         LEAX    RXTAB,PCR       ; screen x
20EB D697             (    demo/ship.asm):00260                         LDB     <ZI
20ED 3A               (    demo/ship.asm):00261                         ABX
20EE E684             (    demo/ship.asm):00262                         LDB     ,X
20F0 969E             (    demo/ship.asm):00263                         LDA     <TMPX
20F2 170122           (    demo/ship.asm):00264                         LBSR    PMUL
20F5 8B27             (    demo/ship.asm):00265                         ADDA    #CX
20F7 8E00A0           (    demo/ship.asm):00266                         LDX     #PX
20FA D696             (    demo/ship.asm):00267                         LDB     <VI
20FC 3A               (    demo/ship.asm):00268                         ABX
20FD A784             (    demo/ship.asm):00269                         STA     ,X
                      (    demo/ship.asm):00270         
20FF 3123             (    demo/ship.asm):00271                         LEAY    3,Y             ; next corner
2101 0C96             (    demo/ship.asm):00272                         INC     <VI
2103 9696             (    demo/ship.asm):00273                         LDA     <VI
