                      (    demo/ship.asm):00279         ; FACES - decide which faces point towards the viewer
                      (    demo/ship.asm):00280         ;
                      (    demo/ship.asm):00281         ;   First, the eye's position in ship coordinates. The eye is at (0, 0,
                      (    demo/ship.asm):00282         ;   -100) in viewer coordinates; turning that back into ship coordinates
                      (    demo/ship.asm):00283         ;   uses the matrix "the other way round" (its transpose), which for this
                      (    demo/ship.asm):00284         ;   point picks out the z row:  eye = -100 * MROWZ / 127.
                      (    demo/ship.asm):00285         ;
                      (    demo/ship.asm):00286         ;   Then for each face, with C = n . P precomputed by the generator:
                      (    demo/ship.asm):00287         ;
                      (    demo/ship.asm):00288         ;       d = C - (nx*EX + ny*EY + nz*EZ)       visible if d < 0
                      (    demo/ship.asm):00289         ; ---------------------------------------------------------------------------
290E 968C             (    demo/ship.asm):00290         FACES           LDA     <MROWZ          ; EX = MROWZ[0] * -EYE_K / 128
2910 170055           (    demo/ship.asm):00291                         LBSR    EYEC
2913 979B             (    demo/ship.asm):00292                         STA     <EX
2915 968D             (    demo/ship.asm):00293                         LDA     <MROWZ+1        ; EY
2917 17004E           (    demo/ship.asm):00294                         LBSR    EYEC
291A 979C             (    demo/ship.asm):00295                         STA     <EY
291C 968E             (    demo/ship.asm):00296                         LDA     <MROWZ+2        ; EZ
291E 170047           (    demo/ship.asm):00297                         LBSR    EYEC
2921 979D             (    demo/ship.asm):00298                         STA     <EZ
                      (    demo/ship.asm):00299         
2923 318D014A         (    demo/ship.asm):00300                         LEAY    SHIP_F,PCR      ; Y -> C (2 bytes), nx, ny, nz
2927 0F98             (    demo/ship.asm):00301                         CLR     <FI
2929 A622             (    demo/ship.asm):00302         FC_LOOP         LDA     2,Y             ; n . eye
292B D69B             (    demo/ship.asm):00303                         LDB     <EX
292D 1700D0           (    demo/ship.asm):00304                         LBSR    SMUL16
2930 DD92             (    demo/ship.asm):00305                         STD     <ACC
2932 A623             (    demo/ship.asm):00306                         LDA     3,Y
2934 D69C             (    demo/ship.asm):00307                         LDB     <EY
2936 1700C7           (    demo/ship.asm):00308                         LBSR    SMUL16
2939 D392             (    demo/ship.asm):00309                         ADDD    <ACC
293B DD92             (    demo/ship.asm):00310                         STD     <ACC
293D A624             (    demo/ship.asm):00311                         LDA     4,Y
293F D69D             (    demo/ship.asm):00312                         LDB     <EZ
2941 1700BC           (    demo/ship.asm):00313                         LBSR    SMUL16
2944 D392             (    demo/ship.asm):00314                         ADDD    <ACC
2946 DD92             (    demo/ship.asm):00315                         STD     <ACC
2948 ECA4             (    demo/ship.asm):00316                         LDD     ,Y              ; d = C - n . eye
294A 9392             (    demo/ship.asm):00317                         SUBD    <ACC            ; N flag = sign of d
294C 2B03             (    demo/ship.asm):00318                         BMI     FC_VIS          ; negative: facing the viewer
294E 4F               (    demo/ship.asm):00319                         CLRA                    ; hidden: VIS = 0
294F 2002             (    demo/ship.asm):00320                         BRA     FC_SET
2951 86FF             (    demo/ship.asm):00321         FC_VIS          LDA     #$FF            ; visible: VIS = $FF
2953 8E00E0           (    demo/ship.asm):00322         FC_SET          LDX     #VIS            ; store at VIS + face number
2956 D698             (    demo/ship.asm):00323                         LDB     <FI
2958 3A               (    demo/ship.asm):00324                         ABX
2959 A784             (    demo/ship.asm):00325                         STA     ,X
295B 3125             (    demo/ship.asm):00326                         LEAY    5,Y             ; next face
295D 0C98             (    demo/ship.asm):00327                         INC     <FI
295F 9698             (    demo/ship.asm):00328                         LDA     <FI
2961 A18D010B         (    demo/ship.asm):00329                         CMPA    SHIP_NF,PCR
2965 26C2             (    demo/ship.asm):00330                         BNE     FC_LOOP
2967 39               (    demo/ship.asm):00331                         RTS
                      (    demo/ship.asm):00332         
                      (    demo/ship.asm):00333         ; EYEC - one coordinate of the eye: A = (A * -EYE_K) / 128, rounded
2968 C69B             (    demo/ship.asm):00334         EYEC            LDB     #-EYE_K
296A 170093           (    demo/ship.asm):00335                         LBSR    SMUL16
296D C30040           (    demo/ship.asm):00336                         ADDD    #64             ; round
2970 58               (    demo/ship.asm):00337                         ASLB                    ; A = D / 128
2971 49               (    demo/ship.asm):00338                         ROLA
2972 39               (    demo/ship.asm):00339                         RTS
                      (    demo/ship.asm):00340         
                      (    demo/ship.asm):00341         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00342         ; EDGES - draw every edge that borders a visible face
                      (    demo/ship.asm):00343         ;   Each edge: corner, corner, face, face. The generator's range check keeps
                      (    demo/ship.asm):00344         ;   the ship on screen, so the faster unclipped TGL_LINE is safe here.
                      (    demo/ship.asm):00345         ; ---------------------------------------------------------------------------
2973 318D013C         (    demo/ship.asm):00346         EDGES           LEAY    SHIP_E,PCR
2977 A68D0137         (    demo/ship.asm):00347                         LDA     SHIP_NE,PCR
297B 9799             (    demo/ship.asm):00348                         STA     <EC
297D 8E00E0           (    demo/ship.asm):00349         ED_LOOP         LDX     #VIS            ; visible if either face is
2980 E622             (    demo/ship.asm):00350                         LDB     2,Y
2982 3A               (    demo/ship.asm):00351                         ABX
2983 A684             (    demo/ship.asm):00352                         LDA     ,X
2985 8E00E0           (    demo/ship.asm):00353                         LDX     #VIS
2988 E623             (    demo/ship.asm):00354                         LDB     3,Y
298A 3A               (    demo/ship.asm):00355                         ABX
298B AA84             (    demo/ship.asm):00356                         ORA     ,X
298D 271D             (    demo/ship.asm):00357                         BEQ     ED_NEXT
298F 8E00A0           (    demo/ship.asm):00358                         LDX     #PX             ; end corner -> U
2992 E621             (    demo/ship.asm):00359                         LDB     1,Y
2994 3A               (    demo/ship.asm):00360                         ABX
2995 A684             (    demo/ship.asm):00361                         LDA     ,X
2997 E68820           (    demo/ship.asm):00362                         LDB     32,X
299A 1F03             (    demo/ship.asm):00363                         TFR     D,U
299C 8E00A0           (    demo/ship.asm):00364                         LDX     #PX             ; start corner -> A, B
299F E6A4             (    demo/ship.asm):00365                         LDB     ,Y
29A1 3A               (    demo/ship.asm):00366                         ABX
29A2 A684             (    demo/ship.asm):00367                         LDA     ,X
29A4 E68820           (    demo/ship.asm):00368                         LDB     32,X
29A7 1F31             (    demo/ship.asm):00369                         TFR     U,X             ; X = x1:y1
29A9 BD100F           (    demo/ship.asm):00370                         JSR     TGL_LINE
29AC 3124             (    demo/ship.asm):00371         ED_NEXT         LEAY    4,Y
29AE 0A99             (    demo/ship.asm):00372                         DEC     <EC
29B0 26CB             (    demo/ship.asm):00373                         BNE     ED_LOOP
