                      (    demo/ship.asm):00279         ; FACES - decide which faces point towards the viewer
                      (    demo/ship.asm):00280         ;
                      (    demo/ship.asm):00281         ;   First, the eye's position in ship coordinates. The eye is at (0, 0,
                      (    demo/ship.asm):00282         ;   -100) in viewer coordinates; turning that back into ship coordinates
                      (    demo/ship.asm):00283         ;   uses the matrix "the other way round" (its transpose), which for this
                      (    demo/ship.asm):00284         ;   point picks out the z row:  eye = -100 * MROWZ / 127.
                      (    demo/ship.asm):00285         ;
                      (    demo/ship.asm):00286         ;   Then for each face, with C = n . P precomputed by the generator:
                      (    demo/ship.asm):00287         ;
                      (    demo/ship.asm):00288         ;       d = C - (nx*EX + ny*EY + nz*EZ)       visible if d < 0
                      (    demo/ship.asm):00289         ; ---------------------------------------------------------------------------
210E 968C             (    demo/ship.asm):00290         FACES           LDA     <MROWZ          ; EX = MROWZ[0] * -EYE_K / 128
2110 170055           (    demo/ship.asm):00291                         LBSR    EYEC
2113 979B             (    demo/ship.asm):00292                         STA     <EX
2115 968D             (    demo/ship.asm):00293                         LDA     <MROWZ+1        ; EY
2117 17004E           (    demo/ship.asm):00294                         LBSR    EYEC
211A 979C             (    demo/ship.asm):00295                         STA     <EY
211C 968E             (    demo/ship.asm):00296                         LDA     <MROWZ+2        ; EZ
211E 170047           (    demo/ship.asm):00297                         LBSR    EYEC
2121 979D             (    demo/ship.asm):00298                         STA     <EZ
                      (    demo/ship.asm):00299         
2123 318D014A         (    demo/ship.asm):00300                         LEAY    SHIP_F,PCR      ; Y -> C (2 bytes), nx, ny, nz
2127 0F98             (    demo/ship.asm):00301                         CLR     <FI
2129 A622             (    demo/ship.asm):00302         FC_LOOP         LDA     2,Y             ; n . eye
212B D69B             (    demo/ship.asm):00303                         LDB     <EX
212D 1700D0           (    demo/ship.asm):00304                         LBSR    SMUL16
2130 DD92             (    demo/ship.asm):00305                         STD     <ACC
2132 A623             (    demo/ship.asm):00306                         LDA     3,Y
2134 D69C             (    demo/ship.asm):00307                         LDB     <EY
2136 1700C7           (    demo/ship.asm):00308                         LBSR    SMUL16
2139 D392             (    demo/ship.asm):00309                         ADDD    <ACC
213B DD92             (    demo/ship.asm):00310                         STD     <ACC
213D A624             (    demo/ship.asm):00311                         LDA     4,Y
213F D69D             (    demo/ship.asm):00312                         LDB     <EZ
2141 1700BC           (    demo/ship.asm):00313                         LBSR    SMUL16
2144 D392             (    demo/ship.asm):00314                         ADDD    <ACC
2146 DD92             (    demo/ship.asm):00315                         STD     <ACC
2148 ECA4             (    demo/ship.asm):00316                         LDD     ,Y              ; d = C - n . eye
214A 9392             (    demo/ship.asm):00317                         SUBD    <ACC            ; N flag = sign of d
214C 2B03             (    demo/ship.asm):00318                         BMI     FC_VIS          ; negative: facing the viewer
214E 4F               (    demo/ship.asm):00319                         CLRA                    ; hidden: VIS = 0
214F 2002             (    demo/ship.asm):00320                         BRA     FC_SET
2151 86FF             (    demo/ship.asm):00321         FC_VIS          LDA     #$FF            ; visible: VIS = $FF
2153 8E00E0           (    demo/ship.asm):00322         FC_SET          LDX     #VIS            ; store at VIS + face number
2156 D698             (    demo/ship.asm):00323                         LDB     <FI
2158 3A               (    demo/ship.asm):00324                         ABX
2159 A784             (    demo/ship.asm):00325                         STA     ,X
215B 3125             (    demo/ship.asm):00326                         LEAY    5,Y             ; next face
215D 0C98             (    demo/ship.asm):00327                         INC     <FI
215F 9698             (    demo/ship.asm):00328                         LDA     <FI
2161 A18D010B         (    demo/ship.asm):00329                         CMPA    SHIP_NF,PCR
2165 26C2             (    demo/ship.asm):00330                         BNE     FC_LOOP
2167 39               (    demo/ship.asm):00331                         RTS
                      (    demo/ship.asm):00332         
                      (    demo/ship.asm):00333         ; EYEC - one coordinate of the eye: A = (A * -EYE_K) / 128, rounded
2168 C69B             (    demo/ship.asm):00334         EYEC            LDB     #-EYE_K
216A 170093           (    demo/ship.asm):00335                         LBSR    SMUL16
216D C30040           (    demo/ship.asm):00336                         ADDD    #64             ; round
2170 58               (    demo/ship.asm):00337                         ASLB                    ; A = D / 128
2171 49               (    demo/ship.asm):00338                         ROLA
2172 39               (    demo/ship.asm):00339                         RTS
                      (    demo/ship.asm):00340         
                      (    demo/ship.asm):00341         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00342         ; EDGES - draw every edge that borders a visible face
                      (    demo/ship.asm):00343         ;   Each edge: corner, corner, face, face. The generator's range check keeps
                      (    demo/ship.asm):00344         ;   the ship on screen, so the faster unclipped TGL_LINE is safe here.
                      (    demo/ship.asm):00345         ; ---------------------------------------------------------------------------
2173 318D013C         (    demo/ship.asm):00346         EDGES           LEAY    SHIP_E,PCR
2177 A68D0137         (    demo/ship.asm):00347                         LDA     SHIP_NE,PCR
217B 9799             (    demo/ship.asm):00348                         STA     <EC
217D 8E00E0           (    demo/ship.asm):00349         ED_LOOP         LDX     #VIS            ; visible if either face is
2180 E622             (    demo/ship.asm):00350                         LDB     2,Y
2182 3A               (    demo/ship.asm):00351                         ABX
2183 A684             (    demo/ship.asm):00352                         LDA     ,X
2185 8E00E0           (    demo/ship.asm):00353                         LDX     #VIS
2188 E623             (    demo/ship.asm):00354                         LDB     3,Y
218A 3A               (    demo/ship.asm):00355                         ABX
218B AA84             (    demo/ship.asm):00356                         ORA     ,X
218D 271D             (    demo/ship.asm):00357                         BEQ     ED_NEXT
218F 8E00A0           (    demo/ship.asm):00358                         LDX     #PX             ; end corner -> U
2192 E621             (    demo/ship.asm):00359                         LDB     1,Y
2194 3A               (    demo/ship.asm):00360                         ABX
2195 A684             (    demo/ship.asm):00361                         LDA     ,X
2197 E68820           (    demo/ship.asm):00362                         LDB     32,X
219A 1F03             (    demo/ship.asm):00363                         TFR     D,U
219C 8E00A0           (    demo/ship.asm):00364                         LDX     #PX             ; start corner -> A, B
219F E6A4             (    demo/ship.asm):00365                         LDB     ,Y
21A1 3A               (    demo/ship.asm):00366                         ABX
21A2 A684             (    demo/ship.asm):00367                         LDA     ,X
21A4 E68820           (    demo/ship.asm):00368                         LDB     32,X
21A7 1F31             (    demo/ship.asm):00369                         TFR     U,X             ; X = x1:y1
21A9 BD100F           (    demo/ship.asm):00370                         JSR     TGL_LINE
21AC 3124             (    demo/ship.asm):00371         ED_NEXT         LEAY    4,Y
21AE 0A99             (    demo/ship.asm):00372                         DEC     <EC
21B0 26CB             (    demo/ship.asm):00373                         BNE     ED_LOOP
21B2 39               (    demo/ship.asm):00374                         RTS
                      (    demo/ship.asm):00375         
                      (    demo/ship.asm):00376         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00377         ; SMULI - SMUL16 written out in place (a macro), for the inner loop
                      (    demo/ship.asm):00378         ;   Same as SMUL16 below but saves the call and return, about 12 cycles,
                      (    demo/ship.asm):00379         ;   which adds up over nine multiplies per corner. \1 makes the labels
                      (    demo/ship.asm):00380         ;   unique each time the macro is used.
                      (    demo/ship.asm):00381         ; ---------------------------------------------------------------------------
21B3                  (    demo/ship.asm):00382         SMULI           MACRO
                      (    demo/ship.asm):00383                         STA     <MT_A
                      (    demo/ship.asm):00384                         STB     <MT_B
                      (    demo/ship.asm):00385                         MUL
                      (    demo/ship.asm):00386                         TST     <MT_A
                      (    demo/ship.asm):00387                         BPL     \1_1
                      (    demo/ship.asm):00388                         SUBA    <MT_B
21B3                  (    demo/ship.asm):00389         \1_1            TST     <MT_B
                      (    demo/ship.asm):00390                         BPL     \1_2
                      (    demo/ship.asm):00391                         SUBA    <MT_A
21B3                  (    demo/ship.asm):00392         \1_2
                      (    demo/ship.asm):00393                         ENDM
                      (    demo/ship.asm):00394         
                      (    demo/ship.asm):00395         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00396         ; ROWDOT - one row of the matrix times VEC, rounded: A = (row . VEC) / 128
                      (    demo/ship.asm):00397         ;   Entry: U -> 3 matrix entries; VEC holds the vector
                      (    demo/ship.asm):00398         ;   Exit:  A = result (signed). B corrupted.
                      (    demo/ship.asm):00399         ;   Adding 64 before dividing by 128 rounds to nearest instead of always
                      (    demo/ship.asm):00400         ;   rounding down. ASLB/ROLA doubles D, leaving D/128 in A.
                      (    demo/ship.asm):00401         ; ---------------------------------------------------------------------------
21B3 A6C4             (    demo/ship.asm):00402         ROWDOT          LDA     ,U              ; row[0] * VEC[0]
21B5 D68F             (    demo/ship.asm):00403                         LDB     <VEC
                      (    demo/ship.asm):00404                         SMULI   RD1
21B7 9794             (            SMULI):00001                         STA     <MT_A
21B9 D795             (            SMULI):00002                         STB     <MT_B
21BB 3D               (            SMULI):00003                         MUL
21BC 0D94             (            SMULI):00004                         TST     <MT_A
21BE 2A02             (            SMULI):00005                         BPL     RD1_1
21C0 9095             (            SMULI):00006                         SUBA    <MT_B
21C2 0D95             (            SMULI):00007         RD1_1            TST     <MT_B
21C4 2A02             (            SMULI):00008                         BPL     RD1_2
21C6 9094             (            SMULI):00009                         SUBA    <MT_A
21C8                  (            SMULI):00010         RD1_2
21C8 DD92             (    demo/ship.asm):00405                         STD     <ACC
21CA A641             (    demo/ship.asm):00406                         LDA     1,U             ; + row[1] * VEC[1]
21CC D690             (    demo/ship.asm):00407                         LDB     <VEC+1
                      (    demo/ship.asm):00408                         SMULI   RD2
21CE 9794             (            SMULI):00001                         STA     <MT_A
21D0 D795             (            SMULI):00002                         STB     <MT_B
21D2 3D               (            SMULI):00003                         MUL
21D3 0D94             (            SMULI):00004                         TST     <MT_A
21D5 2A02             (            SMULI):00005                         BPL     RD2_1
21D7 9095             (            SMULI):00006                         SUBA    <MT_B
21D9 0D95             (            SMULI):00007         RD2_1            TST     <MT_B
21DB 2A02             (            SMULI):00008                         BPL     RD2_2
21DD 9094             (            SMULI):00009                         SUBA    <MT_A
21DF                  (            SMULI):00010         RD2_2
21DF D392             (    demo/ship.asm):00409                         ADDD    <ACC
21E1 DD92             (    demo/ship.asm):00410                         STD     <ACC
21E3 A642             (    demo/ship.asm):00411                         LDA     2,U             ; + row[2] * VEC[2]
21E5 D691             (    demo/ship.asm):00412                         LDB     <VEC+2
                      (    demo/ship.asm):00413                         SMULI   RD3
21E7 9794             (            SMULI):00001                         STA     <MT_A
21E9 D795             (            SMULI):00002                         STB     <MT_B
21EB 3D               (            SMULI):00003                         MUL
21EC 0D94             (            SMULI):00004                         TST     <MT_A
21EE 2A02             (            SMULI):00005                         BPL     RD3_1
21F0 9095             (            SMULI):00006                         SUBA    <MT_B
21F2 0D95             (            SMULI):00007         RD3_1            TST     <MT_B
21F4 2A02             (            SMULI):00008                         BPL     RD3_2
21F6 9094             (            SMULI):00009                         SUBA    <MT_A
21F8                  (            SMULI):00010         RD3_2
21F8 D392             (    demo/ship.asm):00414                         ADDD    <ACC
21FA C30040           (    demo/ship.asm):00415                         ADDD    #64             ; round
21FD 58               (    demo/ship.asm):00416                         ASLB                    ; A = D / 128
21FE 49               (    demo/ship.asm):00417                         ROLA
21FF 39               (    demo/ship.asm):00418                         RTS
                      (    demo/ship.asm):00419         
                      (    demo/ship.asm):00420         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00421         ; SMUL16 - full signed multiply: D = A * B
                      (    demo/ship.asm):00422         ;   Entry: A, B signed (-128..127)
                      (    demo/ship.asm):00423         ;   Exit:  D = 16-bit signed product
                      (    demo/ship.asm):00424         ;
                      (    demo/ship.asm):00425         ;   MUL treats both bytes as unsigned. A negative byte a is read as a + 256,
                      (    demo/ship.asm):00426         ;   so the unsigned product is too big by 256 * (the other byte) for each
                      (    demo/ship.asm):00427         ;   negative input. Subtracting the other byte from the high byte (A) for
                      (    demo/ship.asm):00428         ;   each negative input corrects it exactly - no sign juggling needed.
                      (    demo/ship.asm):00429         ; ---------------------------------------------------------------------------
2200 9794             (    demo/ship.asm):00430         SMUL16          STA     <MT_A           ; keep the original bytes
2202 D795             (    demo/ship.asm):00431                         STB     <MT_B
2204 3D               (    demo/ship.asm):00432                         MUL                     ; unsigned product
2205 0D94             (    demo/ship.asm):00433                         TST     <MT_A           ; first input negative?
2207 2A02             (    demo/ship.asm):00434                         BPL     SM_1
2209 9095             (    demo/ship.asm):00435                         SUBA    <MT_B           ;  then subtract 256 * second
220B 0D95             (    demo/ship.asm):00436         SM_1            TST     <MT_B           ; second input negative?
220D 2A02             (    demo/ship.asm):00437                         BPL     SM_2
220F 9094             (    demo/ship.asm):00438                         SUBA    <MT_A           ;  then subtract 256 * first
2211 39               (    demo/ship.asm):00439         SM_2            RTS
                      (    demo/ship.asm):00440         
                      (    demo/ship.asm):00441         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00442         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    demo/ship.asm):00443         ;   Full product from SMUL16, then ASLB/ROLA leaves D/128 in A (rounded
                      (    demo/ship.asm):00444         ;   down, which is all the matrix needs).
                      (    demo/ship.asm):00445         ; ---------------------------------------------------------------------------
2212 8DEC             (    demo/ship.asm):00446         MULS7           BSR     SMUL16
2214 58               (    demo/ship.asm):00447                         ASLB
2215 49               (    demo/ship.asm):00448                         ROLA
2216 39               (    demo/ship.asm):00449                         RTS
                      (    demo/ship.asm):00450         
                      (    demo/ship.asm):00451         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00452         ; PMUL - projection multiply: A = (A * B) / 128, A signed, B unsigned
                      (    demo/ship.asm):00453         ; ---------------------------------------------------------------------------
2217 4D               (    demo/ship.asm):00454         PMUL            TSTA
2218 2A06             (    demo/ship.asm):00455                         BPL     PM_1
221A 40               (    demo/ship.asm):00456                         NEGA
221B 3D               (    demo/ship.asm):00457                         MUL
221C 58               (    demo/ship.asm):00458                         ASLB
221D 49               (    demo/ship.asm):00459                         ROLA
221E 40               (    demo/ship.asm):00460                         NEGA
221F 39               (    demo/ship.asm):00461                         RTS
2220 3D               (    demo/ship.asm):00462         PM_1            MUL
2221 58               (    demo/ship.asm):00463                         ASLB
2222 49               (    demo/ship.asm):00464                         ROLA
2223 39               (    demo/ship.asm):00465                         RTS
                      (    demo/ship.asm):00466         
