                      (    demo/ship.asm):00376         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00377         ; SMULI - SMUL16 written out in place (a macro), for the inner loop
                      (    demo/ship.asm):00378         ;   Same as SMUL16 below but saves the call and return, about 12 cycles,
                      (    demo/ship.asm):00379         ;   which adds up over nine multiplies per corner. \1 makes the labels
                      (    demo/ship.asm):00380         ;   unique each time the macro is used.
                      (    demo/ship.asm):00381         ; ---------------------------------------------------------------------------
29B3                  (    demo/ship.asm):00382         SMULI           MACRO
                      (    demo/ship.asm):00383                         STA     <MT_A
                      (    demo/ship.asm):00384                         STB     <MT_B
                      (    demo/ship.asm):00385                         MUL
                      (    demo/ship.asm):00386                         TST     <MT_A
                      (    demo/ship.asm):00387                         BPL     \1_1
                      (    demo/ship.asm):00388                         SUBA    <MT_B
29B3                  (    demo/ship.asm):00389         \1_1            TST     <MT_B
                      (    demo/ship.asm):00390                         BPL     \1_2
                      (    demo/ship.asm):00391                         SUBA    <MT_A
29B3                  (    demo/ship.asm):00392         \1_2
                      (    demo/ship.asm):00393                         ENDM
                      (    demo/ship.asm):00394         
                      (    demo/ship.asm):00395         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00396         ; ROWDOT - one row of the matrix times VEC, rounded: A = (row . VEC) / 128
                      (    demo/ship.asm):00397         ;   Entry: U -> 3 matrix entries; VEC holds the vector
                      (    demo/ship.asm):00398         ;   Exit:  A = result (signed). B corrupted.
                      (    demo/ship.asm):00399         ;   Adding 64 before dividing by 128 rounds to nearest instead of always
                      (    demo/ship.asm):00400         ;   rounding down. ASLB/ROLA doubles D, leaving D/128 in A.
                      (    demo/ship.asm):00401         ; ---------------------------------------------------------------------------
29B3 A6C4             (    demo/ship.asm):00402         ROWDOT          LDA     ,U              ; row[0] * VEC[0]
29B5 D68F             (    demo/ship.asm):00403                         LDB     <VEC
                      (    demo/ship.asm):00404                         SMULI   RD1
29B7 9794             (            SMULI):00001                         STA     <MT_A
29B9 D795             (            SMULI):00002                         STB     <MT_B
29BB 3D               (            SMULI):00003                         MUL
29BC 0D94             (            SMULI):00004                         TST     <MT_A
29BE 2A02             (            SMULI):00005                         BPL     RD1_1
29C0 9095             (            SMULI):00006                         SUBA    <MT_B
29C2 0D95             (            SMULI):00007         RD1_1            TST     <MT_B
29C4 2A02             (            SMULI):00008                         BPL     RD1_2
29C6 9094             (            SMULI):00009                         SUBA    <MT_A
29C8                  (            SMULI):00010         RD1_2
29C8 DD92             (    demo/ship.asm):00405                         STD     <ACC
29CA A641             (    demo/ship.asm):00406                         LDA     1,U             ; + row[1] * VEC[1]
29CC D690             (    demo/ship.asm):00407                         LDB     <VEC+1
                      (    demo/ship.asm):00408                         SMULI   RD2
29CE 9794             (            SMULI):00001                         STA     <MT_A
29D0 D795             (            SMULI):00002                         STB     <MT_B
29D2 3D               (            SMULI):00003                         MUL
29D3 0D94             (            SMULI):00004                         TST     <MT_A
29D5 2A02             (            SMULI):00005                         BPL     RD2_1
29D7 9095             (            SMULI):00006                         SUBA    <MT_B
29D9 0D95             (            SMULI):00007         RD2_1            TST     <MT_B
29DB 2A02             (            SMULI):00008                         BPL     RD2_2
29DD 9094             (            SMULI):00009                         SUBA    <MT_A
29DF                  (            SMULI):00010         RD2_2
29DF D392             (    demo/ship.asm):00409                         ADDD    <ACC
29E1 DD92             (    demo/ship.asm):00410                         STD     <ACC
29E3 A642             (    demo/ship.asm):00411                         LDA     2,U             ; + row[2] * VEC[2]
29E5 D691             (    demo/ship.asm):00412                         LDB     <VEC+2
                      (    demo/ship.asm):00413                         SMULI   RD3
29E7 9794             (            SMULI):00001                         STA     <MT_A
29E9 D795             (            SMULI):00002                         STB     <MT_B
29EB 3D               (            SMULI):00003                         MUL
29EC 0D94             (            SMULI):00004                         TST     <MT_A
29EE 2A02             (            SMULI):00005                         BPL     RD3_1
29F0 9095             (            SMULI):00006                         SUBA    <MT_B
29F2 0D95             (            SMULI):00007         RD3_1            TST     <MT_B
29F4 2A02             (            SMULI):00008                         BPL     RD3_2
29F6 9094             (            SMULI):00009                         SUBA    <MT_A
29F8                  (            SMULI):00010         RD3_2
29F8 D392             (    demo/ship.asm):00414                         ADDD    <ACC
29FA C30040           (    demo/ship.asm):00415                         ADDD    #64             ; round
29FD 58               (    demo/ship.asm):00416                         ASLB                    ; A = D / 128
29FE 49               (    demo/ship.asm):00417                         ROLA
29FF 39               (    demo/ship.asm):00418                         RTS
                      (    demo/ship.asm):00419         
                      (    demo/ship.asm):00420         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00421         ; SMUL16 - full signed multiply: D = A * B
                      (    demo/ship.asm):00422         ;   Entry: A, B signed (-128..127)
                      (    demo/ship.asm):00423         ;   Exit:  D = 16-bit signed product
                      (    demo/ship.asm):00424         ;
                      (    demo/ship.asm):00425         ;   MUL treats both bytes as unsigned. A negative byte a is read as a + 256,
                      (    demo/ship.asm):00426         ;   so the unsigned product is too big by 256 * (the other byte) for each
                      (    demo/ship.asm):00427         ;   negative input. Subtracting the other byte from the high byte (A) for
                      (    demo/ship.asm):00428         ;   each negative input corrects it exactly - no sign juggling needed.
                      (    demo/ship.asm):00429         ; ---------------------------------------------------------------------------
2A00 9794             (    demo/ship.asm):00430         SMUL16          STA     <MT_A           ; keep the original bytes
2A02 D795             (    demo/ship.asm):00431                         STB     <MT_B
2A04 3D               (    demo/ship.asm):00432                         MUL                     ; unsigned product
2A05 0D94             (    demo/ship.asm):00433                         TST     <MT_A           ; first input negative?
2A07 2A02             (    demo/ship.asm):00434                         BPL     SM_1
2A09 9095             (    demo/ship.asm):00435                         SUBA    <MT_B           ;  then subtract 256 * second
2A0B 0D95             (    demo/ship.asm):00436         SM_1            TST     <MT_B           ; second input negative?
2A0D 2A02             (    demo/ship.asm):00437                         BPL     SM_2
2A0F 9094             (    demo/ship.asm):00438                         SUBA    <MT_A           ;  then subtract 256 * first
2A11 39               (    demo/ship.asm):00439         SM_2            RTS
                      (    demo/ship.asm):00440         
                      (    demo/ship.asm):00441         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00442         ; MULS7 - signed multiply, scaled: A = (A * B) / 128
                      (    demo/ship.asm):00443         ;   Full product from SMUL16, then ASLB/ROLA leaves D/128 in A (rounded
                      (    demo/ship.asm):00444         ;   down, which is all the matrix needs).
                      (    demo/ship.asm):00445         ; ---------------------------------------------------------------------------
2A12 8DEC             (    demo/ship.asm):00446         MULS7           BSR     SMUL16
2A14 58               (    demo/ship.asm):00447                         ASLB
2A15 49               (    demo/ship.asm):00448                         ROLA
2A16 39               (    demo/ship.asm):00449                         RTS
                      (    demo/ship.asm):00450         
                      (    demo/ship.asm):00451         ; ---------------------------------------------------------------------------
                      (    demo/ship.asm):00452         ; PMUL - projection multiply: A = (A * B) / 128, A signed, B unsigned
                      (    demo/ship.asm):00453         ; ---------------------------------------------------------------------------
2A17 4D               (    demo/ship.asm):00454         PMUL            TSTA
2A18 2A06             (    demo/ship.asm):00455                         BPL     PM_1
2A1A 40               (    demo/ship.asm):00456                         NEGA
2A1B 3D               (    demo/ship.asm):00457                         MUL
2A1C 58               (    demo/ship.asm):00458                         ASLB
2A1D 49               (    demo/ship.asm):00459                         ROLA
2A1E 40               (    demo/ship.asm):00460                         NEGA
2A1F 39               (    demo/ship.asm):00461                         RTS
2A20 3D               (    demo/ship.asm):00462         PM_1            MUL
2A21 58               (    demo/ship.asm):00463                         ASLB
2A22 49               (    demo/ship.asm):00464                         ROLA
2A23 39               (    demo/ship.asm):00465                         RTS
                      (    demo/ship.asm):00466         
                      (    demo/ship.asm):00467         ; Ship model (generated) and the sine/projection tables shared with the cube
                      (    demo/ship.asm):00468                         INCLUDE "ship_model.asm"
                      (   ship_model.asm):00001         ; Ship model: KESTREL - generated by tools/gen_ship_model.py, do not edit
                      (   ship_model.asm):00002         ;
                      (   ship_model.asm):00003         ; SHIP_NV / SHIP_V : corners, 3 signed bytes each: x, y, z
                      (   ship_model.asm):00004         ; SHIP_NF / SHIP_F : faces, 5 bytes each: C (16 bits), then the face's
                      (   ship_model.asm):00005         ;                    outward normal nx, ny, nz (length 127 = 1.0).
                      (   ship_model.asm):00006         ;                    C = n . P for a corner P on the face, precomputed
                      (   ship_model.asm):00007         ;                    so the demo's visibility test is just
                      (   ship_model.asm):00008         ;                    C - n . eye < 0, with the eye in ship coordinates.
                      (   ship_model.asm):00009         ; SHIP_NE / SHIP_E : edges, 4 bytes each: corner, corner, face, face.
                      (   ship_model.asm):00010         ;                    Drawn if either face is visible. Decal lines name
                      (   ship_model.asm):00011         ;                    the same face twice.
                      (   ship_model.asm):00012         
2A24 19               (   ship_model.asm):00013         SHIP_NV         FCB     25
